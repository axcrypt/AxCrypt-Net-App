@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Services.Interface

@inject ProcessIndicatorService ProcessIndicatorService

@code {
    protected override void OnInitialized()
    {
        ProcessIndicatorService.OnProcessIndicatorVisibilityChanged += UpdateIndicatorVisibility;
    }

    private void UpdateIndicatorVisibility(bool isVisible)
    {
        IsVisible = isVisible;
        Title = ProcessIndicatorService.Title;
        Message = ProcessIndicatorService.Message;
        StateHasChanged(); // Refresh UI
    }

    private void ClosePopup()
    {
        ProcessIndicatorService.Hide();
    }

    public bool IsVisible { get; set; }

    public string? Title { get; set; }

    public string? Message { get; set; }
}

@if (IsVisible)
{
    @* <div class="modalDialog" style="display: block;">
        <div class="secrets-loading-content">
            <h2>@Title</h2>
            <div class="loading-content">
                <img src="" alt="Loading..." />
