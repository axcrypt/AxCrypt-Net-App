@using AxCrypt.Api.Model
@using AxCrypt.App.Desktop.ViewModels.Home
@using AxCrypt.Core.UI
@using AxCrypt.Content

@inject ActionsViewModel? homeActionModel

<div class="mre-act-sec">
    @if (homeActionModel!.SubscriptionLevel != SubscriptionLevel.Free)
    {
        <div style="display:block;">
            <h3 class="fle-nme fnt-sze">Cloud services</h3>
            <div style="display: flex;">
                @foreach (KnownFolder? knownFolder in homeActionModel?.KnownFoldersViewModel?.KnownFolders!)
                {
                    <div>
                        <button @onclick="() => homeActionModel.OnCloudServiceButtonClick(knownFolder)"
                                class="assets-box"
                                style="background-color:@(knownFolder.Enabled ? _ENABLEDTOOLSTRIPBACKCOLOR : homeActionModel.DisabledBackColor)">
                            <img class="icon @homeActionModel.GetIconClass(knownFolder.DisplayName)" src="" alt="@knownFolder.DisplayName" />
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    <div class="medium-9" style="display:block;">
        <h3 class="fle-nme fnt-sze">More actions</h3>
        <div style="display: flex; gap: 2%;">
            @if (homeActionModel.SubscriptionLevel != SubscriptionLevel.Free)
            {
                <div class="mre-actn-box" @onclick="(e)=> homeActionModel.RandomRenameAsync(e)" title="@Texts.AnonymousRenameToolTip">
                    <img class="ico-eye-sml" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.AnonymousRenameMenuText</span>
                </div>
                <div class="mre-actn-box" @onclick="(e)=> homeActionModel.SecureWipeFiles(e)" title="@Texts.FeaturesFileWipeDescription">
                    <img class="ico-dlt" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.SecureDeleteToolStripMenuItemText</span>
                </div>
                <div class="mre-actn-box" @onclick="(e)=> homeActionModel.EncryptionUpgrade(e)" title="@Texts.UpgradeLegacyFilesMenuToolTip">
                    <img class="ico-apikey" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                </div>
                @* <div class="mre-actn-box fade-clr" style="border:dotted;">
            <span class="text-size text-style">Add action to the Home</span>
            </div> *@
            }
            else
            {
                <div class="mre-actn-box atn-bgclr" @onclick="homeActionModel.AlwaysOfflineForFreeUser" title="@Texts.AlwaysOfflineToolTip">
                    <img class="ico-offln" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.AlwaysOffline</span>
                </div>
                <div class="mre-actn-box atn-bgclr" @onclick="(e)=>homeActionModel.InviteUser(e)" title="@Texts.InviteUserToolStripMenuItemText">
                    <img class="ico-invtfrd" src="" alt="hand-img" />
                    <span class="text-size text-style">Invite friend</span>
                </div>
                <div class="mre-actn-box atn-bgclr" @onclick="()=> homeActionModel.UpgradeDialog()">
                    <img class="ico-apikey" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                </div>
            }
        </div>
    </div>
</div>


@code {
    public const string _ENABLEDTOOLSTRIPBACKCOLOR = "#FFFFFF";

    protected override void OnInitialized()
    {
        homeActionModel!.OnUpdateViewState += UpdateState;
        base.OnInitialized();
    }
  
    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}