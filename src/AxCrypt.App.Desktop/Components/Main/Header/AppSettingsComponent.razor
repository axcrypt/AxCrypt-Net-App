@if (AppSettingsViewModel.ShowVersion)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div tyle="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                        @if (string.Compare(AppSettingsViewModel.LatestVersion, AppSettingsViewModel.CurrentVersion) > 0)
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">A new version is available!</span>

                            <br />
                            @* <span class="text-center font-bold" style="font-size: 15px;"> Latest Version : @LatestVersion </span> *@
                        }
                        else
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">You are up to date!</span>
                        }
                    </div>
                </div>
                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    @if (string.Compare(AppSettingsViewModel.LatestVersion, AppSettingsViewModel.CurrentVersion) > 0)
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> RedirectToDownload()">Update</button>
                    }
                    else
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> AppSettingsViewModel.CloseSuccessPopup()">@Texts.ButtonOkText</button>
                    }
                    <button class="button font-medium success btn-large" @onclick="()=>AppSettingsViewModel.CloseSuccessPopup()">@Texts.ButtonCloseText</button>
                </div>
            </div>
        </div>
    </div>
}

@if (AppSettingsViewModel.ShowOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
                <div class="input-group">
                    <label for="restApiUrl">Rest Api Url:</label>
                    <input type="text" id="restApiUrl" class="form-control email-img" @bind="@AppSettingsViewModel.RestApiBaseUrl" />
                </div>
                <div class="input-group">
                    <label for="timeout">@Texts.DialogDebugOptionsRestApiTimeoutPrompt</label>
                    <input type="text" id="timeout" class="form-control email-img" @bind="@AppSettingsViewModel.TimeoutTimeSpan" />
                </div>

                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <button class="button font-medium success btn-large" @onclick="(e)=> AppSettingsViewModel.SetOptionsToolStripMenuItem_Click(e)">@Texts.ButtonOkText</button>
                    <button class="button font-medium success btn-large" @onclick="AppSettingsViewModel.CloseOptions">@Texts.ButtonCloseText</button>
                </div>
            </div>
        </div>
    </div>
}

@if (AppSettingsViewModel.ShowManageAxCryptID)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <label for="title">@Texts.DebugManageAccountToolStripMenuItemText</label>
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
            </div>
            <div>
                <label for="userEmail">@AppSettingsViewModel.EmailLabel</label>
            </div>
            <div class="input-group">
                <div>
                    <textarea id="timeout" style="position:center;" class="form-control email-img" rows="4" cols="60" readonly>Timestamp: @AppSettingsViewModel.CreatedTime </textarea>
                </div>
            </div>
            <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                <button class="button font-medium success btn-large" @onclick="(e)=>AppSettingsViewModel.ChangePassphraseButton_Click(e)">Change Password</button>
                <button class="button font-medium success btn-large" @onclick="AppSettingsViewModel.CloseManageAxCryptID">@Texts.ButtonCloseText</button>
            </div>
        </div>
    </div>
}

@if (AppSettingsViewModel.AdvancedOptionsViewModel.ShowAdvancedOptions)
{
    <div id="modal-dialog6" class="modalDialog">
        <div style="text-align: left;">
            <div class="modal-header text-center" style="display:block; font-weight:600;">
                <span>Advanced Option</span>
            </div>
            <div class="modal-body">
                <div style="padding-bottom: 15px;">
                    <label>Application Config Path</label><br />
                    <input type="path" @bind="AppSettingsViewModel.AdvancedOptionsViewModel.AppConfigPath" style="width:100%;" />
                </div>
                <label>Temp File Path</label>
                <div class="center-column">
                    <input type="path" @bind="AppSettingsViewModel.AdvancedOptionsViewModel.TempConfigPath" @oninput="(e)=> AppSettingsViewModel.AdvancedOptionsViewModel.BrowseButton_click(e)" style="width:75%;" />
                    <button class="button font-medium success btn-small" @onclick="(e)=> AppSettingsViewModel.AdvancedOptionsViewModel.BrowseButton_click(e)">Browse</button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-small" @onclick="(e)=> AppSettingsViewModel.AdvancedOptionsViewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
                <button class="btn-small font-medium button cancel" @onclick="(e)=> AppSettingsViewModel.AdvancedOptionsViewModel.CancelButton_Click(e)">@Texts.ButtonCancelText</button>
            </div>
            @if (!string.IsNullOrEmpty(AppSettingsViewModel.AdvancedOptionsViewModel.ErrorMessage))
            {
                <div class="error-message"> @AppSettingsViewModel.AdvancedOptionsViewModel.ErrorMessage</div>
            }
        </div>
    </div>
}

<style>
    .input-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .input-group label {
            min-width: 120px;
            margin-right: 10px;
        }

        .input-group input {
            flex-grow: 1;
        }

    .popup {
        position: absolute;
        left: -150px; /* Adjust as per your requirement */
        top: 0;
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 8px;
        z-index: 1000;
        width: 200px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        pointer-events: none; /* Prevent interfering with hover logic */
    }
</style>

@code {
    protected override void OnInitialized()
    {
        AppSettingsViewModel.Initialized();
        AppSettingsViewModel.AdvancedOptionsViewModel.Initialize();
        AppSettingsViewModel.OnUpdateViewState += UpdatePageState;

        base.OnInitialized();
    }

    private void RedirectToDownload()
    {
        navigation.NavigateTo(AppSettingsViewModel.DownloadVersion!.ToString());
        AppSettingsViewModel.ShowVersion = false;
    }

    [Parameter]
    public EventCallback CloseSettingsPopup { get; set; }

    public string hoveredElement { get; set; } = string.Empty;
    public bool isHovered { get; set; }

    public void ShowPopup(string element)
    {
        isHovered = true;
        hoveredElement = element;
    }

    private void HidePopup()
    {
        isHovered = false;
        hoveredElement = string.Empty;
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
