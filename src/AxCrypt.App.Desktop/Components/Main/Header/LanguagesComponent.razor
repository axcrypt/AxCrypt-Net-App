@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.Core

@inject AppLocalizationOptions? localizationOptions
@inject NavigationManager navigationManager
@inject TopMenuViewModel ViewModel

<div class="language-selector">
    <div class="dropdown">
        @if (!ViewModel.LogOnViewModel.IsLoggedOn)
        {
            <button class="dropbtn font-high active" id="lang-dropdown-action-btn" style="min-width: 54px; gap: 7px;" title="Select language">
                @ViewModel.SelectedLanguage
                <img class="drp-dwn down" id="lang-action-btn-arw" style="width:7px; margin:0px;" src="" alt="dropdown-img" />
            </button>
        }
        else
        {
            <button class="dropbtn font-high active" id="lang-dropdown-action-btn">
                <img class="flag-icon" src="@ViewModel.SelectedLanguageImageUrl" alt="flag-icon" style="padding-right: 10px;" />
                @ViewModel.SelectedLanguageDisplayName
                <img class="drp-dwn down" id="lang-action-btn-arw" src="" alt="dropdown-img" />
            </button>
        }

        <div class="language-dropdown" style="display: none" id="lang-dropdown-popup">
            @foreach (CultureOption culture in localizationOptions.SupportedCultures)
            {
                <div class="dropdown-item-container">
                    <NavLink class="language-item font-high" @onclick="() => ChangeLanguage(culture.Name, culture.ImageUrl, culture.DisplayName)">
                        @if (!ViewModel.LogOnViewModel.IsLoggedOn)
                        {
                            <span title="@culture.DisplayName">@culture.Name</span>
                        }
                        else
                        {
                            <img class="flag-icon" src="@culture.ImageUrl" alt="@culture.DisplayName" />
                            <span>@culture.DisplayName</span>
                        }

                        @if (culture.Name == ViewModel.SelectedLanguage)
                        {
                            <img class="tick-icon" src="" alt="tick" />
                        }
                    </NavLink>
                </div>
            }
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        string currentCulture = Resolve.UserSettings.CultureName;
        CultureOption cultureOption = localizationOptions?.SupportedCultures.FirstOrDefault(c => c.Name == currentCulture)!;

        if (cultureOption != null)
        {
            ViewModel.SelectedLanguage = cultureOption.Name;
            ViewModel.SelectedLanguageImageUrl = cultureOption.ImageUrl!;
            ViewModel.SelectedLanguageDisplayName = cultureOption.DisplayName!;
        }

        ViewModel.LogOnViewModel.OnUIStateChanged += UpdatePageState;
    }

    public void ChangeLanguage(string cultureName, string imageUrl, string displayName)
    {
        ViewModel.SelectedLanguage = cultureName;
        ViewModel.SelectedLanguageImageUrl = imageUrl;
        ViewModel.SelectedLanguageDisplayName = displayName!;

        if (!ViewModel.LogOnViewModel.IsLoggedOn)
        {
            ViewModel.SelectedLanguageDisplayName = cultureName!;
        }

        ViewModel.SetLanguageAsync(cultureName);

        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}