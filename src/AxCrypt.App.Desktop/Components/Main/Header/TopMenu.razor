@using AxCrypt.App.Desktop.Data
@using AxCrypt.App.Desktop.Services
@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Desktop.ViewModels.Notification
@using AxCrypt.App.Shared.Models
@using AxCrypt.Core
@using Microsoft.JSInterop

@inject AppLocalizationOptions? localizationOptions
@inject NavigationManager navigationManager
@inject UserNotificationService notificationService
@inject TopMenuViewModel ViewModel
@inject IJSRuntime JSRuntime

<div class="top-menu">
    <div class="language-selector padding">
        <div class="dropdown">
            <button class="dropbtn font-high active" id="lang-dropdown-action-btn">
                <img class="flag-icon" src="@ViewModel.TopMenuModel.SelectedLanguageImageUrl" alt="flag-icon" style="padding-right: 10px;" />
                @ViewModel.TopMenuModel.SelectedLanguageDisplayName
                <img class="drp-dwn down" id="lang-action-btn-arw" src="" alt="dropdown-img" />
            </button>
            <div class="language-dropdown" style="display: none" id="lang-dropdown-popup">
                @foreach (CultureOption culture in localizationOptions.SupportedCultures)
                {
                    <div class="dropdown-item-container">
                        <NavLink class="language-item font-high" @onclick="() => ChangeLanguage(culture.Name, culture.ImageUrl)">
                            <img class="flag-icon" src="@culture.ImageUrl" alt="@culture.DisplayName" />
                            @culture.DisplayName
                            @if (culture.Name == ViewModel.TopMenuModel.SelectedLanguage)
                            {
                                <img class="tick-icon" src="" alt="tick" />
                            }
                        </NavLink>
                    </div>
                }
            </div>
        </div>
    </div>

    <NavLink id="settings-dropdown-click-action">
        <img class="sttng-icon padding" src="/images/default/IcoExtrFtr.svg" alt="settings-icon" />
    </NavLink>

    <NavLink id="notification-dropdown-click-action">
        <div id="notification-dropdown-click-action">
            <a id="notification-bell">
                <span class="notification-badge">
                    @notificationService.NotificationModel.Notifications.Count()
                </span>
            </a>
            <img class="notif-icon padding" src="/images/default/IcoNtfctns.svg" alt="notify-icon" />
        </div>
    </NavLink>
    <NavLink class="update-btn padding" @onclick="ViewModel.CheckAxCryptVersionAsync">Update</NavLink>
    <NavLink class="mb-prfle" id="accounts-dropdown-click-action">
        <span class="" id="accounts-dropdown-click-action">
            @(string.IsNullOrEmpty(ViewModel.TopMenuModel.UserEmail) ? "N/A" : ViewModel.TopMenuModel.UserEmail.Substring(0, Math.Min(2, ViewModel.TopMenuModel.UserEmail.Length)).ToUpper())
        </span>
    </NavLink>
</div>

<AxCrypt.App.Desktop.Components.Main.Header.AppSettingsComponent />
<AxCrypt.App.Desktop.Components.Main.Header.NotificationPopup />
<AxCrypt.App.Desktop.Components.Main.Header.ProfileOptionComponent />

@code {
    protected override async Task OnInitializedAsync()
    {
        string currentCulture = Resolve.UserSettings.CultureName;
        CultureOption cultureOption = localizationOptions?.SupportedCultures.FirstOrDefault(c => c.Name == currentCulture)!;

        if (cultureOption != null)
        {
            ViewModel.TopMenuModel.SelectedLanguage = cultureOption.Name;
            ViewModel.TopMenuModel.SelectedLanguageImageUrl = cultureOption.ImageUrl!;
            ViewModel.TopMenuModel.SelectedLanguageDisplayName = cultureOption.DisplayName!;
        }

        ViewModel.Initialize();
        await notificationService.LoadNotificationListAsync();
        ViewModel.LogOnViewModel.OnSubscriptionChanged += UpdatePageState;
        ViewModel.LogOnViewModel.OnUIStateChanged += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            ViewModel.Initialize();
        }

        try
        {
            ViewModel.TopMenuModel.IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);
            ViewModel.TopMenuModel.IsLargeScreen = await Utility.IsLargeScreenAsync(JSRuntime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
        }
    }

    public void ChangeLanguage(string cultureName, string imageUrl)
    {
        ViewModel.TopMenuModel.SelectedLanguage = cultureName;
        ViewModel.TopMenuModel.SelectedLanguageImageUrl = imageUrl;
        ViewModel.TopMenuModel.SelectedLanguageDisplayName = localizationOptions?.SupportedCultures.FirstOrDefault(c => c.Name == cultureName)?.DisplayName!;
        ViewModel.SetLanguageAsync(cultureName);
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}