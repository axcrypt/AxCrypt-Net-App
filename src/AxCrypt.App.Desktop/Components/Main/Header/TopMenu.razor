@using AxCrypt.App.Desktop.Data
@using AxCrypt.App.Desktop.Services
@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.Core
@using Microsoft.JSInterop

@inject UserNotificationService notificationService
@inject TopMenuViewModel ViewModel
@inject IJSRuntime JSRuntime

<div class="top-menu">
    <AxCrypt.App.Desktop.Components.Main.Header.LanguagesComponent />

    <NavLink id="settings-dropdown-click-action" class="app-top-menu">
        <img class="sttng-icon padding" src="/images/default/IcoExtrFtr.svg" alt="settings-icon" />
    </NavLink>

    <NavLink id="notification-dropdown-click-action" class="app-top-menu">
        <span class="notification-badge">
            @notificationService.NotificationModel.Notifications.Count()
        </span>
        <img class="notif-icon padding" src="/images/default/IcoNtfctns.svg" alt="notify-icon" />
    </NavLink>
    <NavLink class="update-btn" @onclick="ViewModel.CheckAxCryptVersionAsync" title="@ViewModel.VersionHoverText">Update</NavLink>
    <NavLink class="mb-prfle" id="accounts-dropdown-click-action">
        <img style="max-width:30px;width:30px;height:30px !important;" src="@SubscriptionIcon()" alt="subs-level icon" />
    </NavLink>
</div>

<AxCrypt.App.Desktop.Components.Main.Header.AppSettingsComponent />
<AxCrypt.App.Desktop.Components.Main.Header.NotificationPopup />
<AxCrypt.App.Desktop.Components.Main.Header.ProfileOptionComponent />

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.Initialize();
        await notificationService.LoadNotificationListAsync();
        ViewModel.LogOnViewModel.OnSubscriptionChanged += UpdatePageState;
        notificationService.OnUpdateViewState += UpdatePageState;
        ViewModel.LogOnViewModel.OnUIStateChanged += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            ViewModel.IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);
            ViewModel.IsLargeScreen = await Utility.IsLargeScreenAsync(JSRuntime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
    }

    private string SubscriptionIcon()
    {
        string subscriptionLevel = ViewModel.LogOnViewModel.SubscriptionLevel.ToString();
        switch (subscriptionLevel)
        {
            case "PasswordManager":
                return "/images/PasswordManager/icoPM.svg";

            case "Premium":
                return "/images/Premium/IcoPrm.svg";

            case "Business":
                return "/images/Business/IcoBus.svg";

            default:
                return "/images/free/IcoVwr.svg";

        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}