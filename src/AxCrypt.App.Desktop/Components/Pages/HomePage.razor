@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject RecentFilesViewModel RecentFilesViewModel
@inject IJSRuntime JSRuntime

@{
    int MaxAvatarsToShow = 4;
}

<div class="home-index">
    <div class="hm-page-title head-sec">
        <h1 class="fle-nme">@Texts.WelcomeBackTitle</h1>
        <img class="home-title" src="" alt="hand-img" />
    </div>

    <AxCrypt.App.Desktop.Components.Home.ActionsComponent />
    <AxCrypt.App.Desktop.Components.Home.SubActionsComponent />
    <AxCrypt.App.Desktop.Components.Home.RecentFilesComponent />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RecentFilesViewModel.OnUpdateViewState += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
        try
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            //IsLoading = false;
        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}