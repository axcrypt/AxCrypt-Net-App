@page "/debuglog"
@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.Services
@using AxCrypt.Core
@using AxCrypt.Core.Extensions
@using Microsoft.Extensions.Logging
@using System.Globalization
@using static AxCrypt.Abstractions.TypeResolve

@inject LogViewModel LogService

<div style="padding:8px;">
    <span style="text-align:center;font-weight:600;">Debug Log Viewer</span>
    <button @onclick="ExportLogs" style="float: right; margin:1px 5px 1px 0px;" class="button font-medium success btn-small">Export</button>
    <button style="float: right;margin:1px 5px 1px 0px;" class="button" @onclick="ClearLogs">Clear Logs</button>
</div>

<div class="log-content" @onclick:stopPropagation id="logger_log_section">
    @foreach (string log in LogService.Logs)
    {
        <div style="align-content:flex-start">@log</div>
    }
</div>
<style>
    .log-content {
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        height: 95vh;
        max-height: 95vh;
        width: 100vw;
        max-width: 100vw;
        overflow-y: scroll;
    }
</style>

@code {
    string DebugFileName = $"DebugLogs_{DateTime.Now:yyyyMMdd_HHmmss}.txt";
    
    [Inject] 
    IJSRuntime? JS { get; set; }

    protected override void OnInitialized()
    {
        LogService.OnUpdateViewState += UpdateState;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    private async Task ExportLogs()
    {
        string logs = string.Join(Environment.NewLine, LogService.Logs);
        string fileName = DebugFileName;

        using MemoryStream stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(logs));
        using DotNetStreamReference streamRef = new DotNetStreamReference(stream);
        await JS!.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    private async Task ClearLogs()
    {
        await JS.InvokeVoidAsync("clearLoggerView");
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}

<script type="text/javascript">
    var AppendMessageOnLogger = (logText) => {
        var appendHtml = document.createElement("pre");
        appendHtml.textContent = logText;

        var loggerSectionElement = document.getElementById("logger_log_section");
        if (loggerSectionElement !== undefined && loggerSectionElement !== null) {
            loggerSectionElement.appendChild(appendHtml);
        }
    };

    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? 'log.txt';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    };

    window.clearLoggerView = () => {
        const loggerSectionElement = document.getElementById("logger_log_section");
        if (loggerSectionElement) {
            loggerSectionElement.innerHTML = ""; // Clears all logs from the DOM
        }
    };
</script>