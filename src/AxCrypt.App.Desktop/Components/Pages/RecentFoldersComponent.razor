    {
        <div class="text-center" style="padding-top: 20px;">
            <span class="empty-view-heading">Let`s start our journey!</span><br />
            <span>Add and secure your first folder.</span><br />
            <img class="empty-rcnt-fld-img" alt="default folder img" />
        </div>
    }
    else
    {
        @foreach (string folder in RecentFoldersViewModel.RecentFoldersList)
        {
            string folderWithoutTrailingSlash = folder.TrimEnd('\\');
            <div class="rcnt-fld-bx fld-dflt-cl" @ondblclick="(arg) => RecentFoldersViewModel.HandleDoubleClick(arg, folder)"
                 @oncontextmenu="e => RecentFoldersViewModel.SecuredContextMenu(e, folder)">
                <img class="fldr-img" src="" /><br /><label>@Path.GetFileName(folderWithoutTrailingSlash)</label>
            </div>
        }
    }
