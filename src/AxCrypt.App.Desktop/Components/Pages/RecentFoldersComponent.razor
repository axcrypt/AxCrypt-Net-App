        RecentFoldersViewModel.LogOnViewModel.OnUIStateChanged += UpdateStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //await RecentFoldersViewModel.InitializeAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void UpdateRecentFoldersList(bool updateFolders)
    {
        InvokeAsync(() =>
        {
