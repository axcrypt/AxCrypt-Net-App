@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Desktop.ViewModels.SecuredMessenger
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

@inject ManageSecMsgrViewModel SecMsgrViewModel

@* @{
    int messageCount = SecMsgrViewModel.Messenger.Messages.Count();
} *@
<div class="secured-messenger">
    <div class="row">
        <div class="medium-12 columns" style="margin:0 auto;">
            <NavLink href="messagelist">
                <img class=" left go-back-arrow" src="" alt="go-back-img" />
            </NavLink>
            <h2 class="page-title">@Texts.SecuredMessengerLinkLabel</h2>
        </div>
    </div>

    <div class="row">
        <div class="medium-12 columns filter-tab-wrapper" id="sec-msg-search-section">
            <EditForm Model="SecMsgrViewModel.Messenger" OnValidSubmit="SearchList" id="search-msg-form">
                <input type="hidden" name="SecMessengerFilterTab" @bind="SecMsgrViewModel.Messenger.SecMessengerFilterTab" id="sec-messenger-filter-tab" />
                <InputText @bind-Value="SecMsgrViewModel.Messenger.Keyword"
                id="messenger-keyword"
                placeholder=@Texts.PromptXecretsSearchText
                class="search-box columns"
                tabindex="1"
                style="width: 98%;" />

                <img class="filter-trigger" src="" alt="filter-image" title="Filters" @onclick="ToggleFilterPopup" />
                <div class="filter-popup hide-model-popup" style="@GetFilterPopupStyle()">
                    <label>From</label>
                    <InputText @bind-Value="SecMsgrViewModel.Messenger.UserName"
                    placeholder="@Texts.BusinessSubscriptionEmailPlaceholder"
                    type="email"
                    style="width: 50%;"
                    name="from"
                    id="" />
                    <br />
                    <label>To</label>
                    <InputText @bind-Value="SecMsgrViewModel.Messenger.ReceiverName"
                    placeholder="@Texts.BusinessSubscriptionEmailPlaceholder"
                    type="email"
                    style="width: 50%;"
                    name="to"
                    id="" />
                    <div>
                        <label>Date from</label>
                        <InputDate @bind-Value="SecMsgrViewModel.Messenger.StartDate" style="width: 23%;" name="date-from" />
                        <span class="font-high" style="padding: 10px;">to</span>
                        <InputDate @bind-Value="SecMsgrViewModel.Messenger.EndDate" style="width: 23%;" name="date-to" />

                    </div>
                    <div style="display: flex; float: right; padding-top: 20px;">
                        <button type="reset" class="button border btn-large font-medium" style="margin-right: 30px;">@Texts.ClearAllText</button>
                        <button type="submit" class="button success btn-large font-medium" @onclick="ApplyFilters">@Texts.ApplyLabel</button>
                    </div>
                </div>
                <button type="submit" id="message-search-btn" class="button success msg-search-btn" title="@Texts.SearchText"></button>
                <div class="searched-filters">
                    @foreach (FilterItem filter in appliedFilters)
                    {
                        <div class="filter-items">
                            <label>@filter.Label</label>
                            <div class="slct-filt-box">
                                <span>@filter.Value</span>
                            </div>
                        </div>
                    }
                </div>

            </EditForm>

        </div>
        <div class="medium-12 columns">
            <div id="All" class="tabcontent">
                <div class="row">
                    <div class="tab-sec medium-9 columns">
                        <div id="tab-header">
                            <a class="sub-head-link unread-text @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Inbox ? "active" : "")"
                            @onclick="() => SetActiveTab(SecureMsgrFilterTab.Inbox)" id="inbox-tab">
                                Inbox @* <span id="inbox-message-count">(@(SecuredMessengerModel.SecMessengerFilterTab == SecureMsgrFilterTab.Inbox ? messageCount : ""))</span> *@
                            </a>
                            <hr style="display:none;" class="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Inbox ? "tab-selected" : "")">
                        </div>
                        <div id="tab-header">
                            <a class="sub-head-link @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Sent ? "active" : "")"
                            @onclick="() => SetActiveTab(SecureMsgrFilterTab.Sent)" id="sent-tab">
                                Sent @* <span id="sent-message-count">(@(SecuredMessengerModel.SecMessengerFilterTab == SecureMsgrFilterTab.Sent ? messageCount : ""))</span> *@
                            </a>
                            <hr style="display:none;" class="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Sent ? "tab-selected" : "")">
                        </div>
                        <div id="tab-header">
                            <a class="sub-head-link unread-text @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Unread ? "active" : "")"
                            @onclick="() => SetActiveTab(SecureMsgrFilterTab.Unread)" id="unread-tab">
                                Unread @* <span id="unread-message-count">(@(SecuredMessengerModel.SecMessengerFilterTab == SecureMsgrFilterTab.Unread ? messageCount : ""))</span> *@
                            </a>
                            <hr style="display:none;" class="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Unread ? "tab-selected" : "")">
                        </div>
                    </div>
                </div>
            </div>
            <div id="search-message-list" class="parent-container">
                <AxCrypt.App.Desktop.Components.Shared.ProcessIndicatorComponent />

                <AxCrypt.App.Desktop.Components.SecuredMessenger.Body />
            </div>
        </div>
    </div>
</div>

@code {
    private SecureMsgrFilterTab activeTab = SecureMsgrFilterTab.Inbox;

    protected override void OnInitialized()
    {
        SecMsgrViewModel.OnUpdateViewState += UpdatePageState;
        SecMsgrViewModel.NewSecMsgrViewModel.OnTabUpdateViewState += async (SecureMsgrFilterTab selectedtab) => await UpdateTabState(selectedtab);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (New<AxCrypt.Common.AxCryptOnlineState>().IsOffline)
        {
            await New<Core.UI.IPopup>().ShowAsync(Core.UI.PopupButtons.Ok, Texts.MessageErrorTitle, Texts.NoInternetErrorMessage);
        }

        if (firstRender)
        {
            await SetActiveTab(activeTab);
        }
    }

    private async Task SetActiveTab(SecureMsgrFilterTab securedMessengerFilterTab)
    {
        activeTab = securedMessengerFilterTab;
        await SecMsgrViewModel.SetSelectedTabActive(securedMessengerFilterTab);
    }

    private async Task SearchList()
    {
        using (ProcessIndicator progress = new ProcessIndicator())
        {
            SecMsgrViewModel.Messenger.Messages = new List<Core.SecuredMessenger.SecuredMessage>();
            SecMsgrViewModel.UpdateViewState();

            await SecMsgrViewModel.SearchList(SecMsgrViewModel.Messenger, activeTab);
            SecMsgrViewModel.UpdateViewState();
        }
    }

    private bool showFilterPopup = false;

    private void ToggleFilterPopup()
    {
        showFilterPopup = !showFilterPopup;
    }

    private string GetFilterPopupStyle() => showFilterPopup ? "display: block;" : "display: none;";

    private List<FilterItem> appliedFilters = new();

    private void ApplyFilters()
    {
        appliedFilters.Clear();

        if (!string.IsNullOrWhiteSpace(SecMsgrViewModel.Messenger.UserName))
        {
            appliedFilters.Add(new FilterItem("From", SecMsgrViewModel.Messenger.UserName));
        }

        if (!string.IsNullOrWhiteSpace(SecMsgrViewModel.Messenger.ReceiverName))
        {
            appliedFilters.Add(new FilterItem("To", SecMsgrViewModel.Messenger.ReceiverName));
        }

        if (SecMsgrViewModel.Messenger.StartDate != DateTime.MinValue)
        {
            appliedFilters.Add(new FilterItem("Date from", SecMsgrViewModel.Messenger.StartDate.ToShortDateString()));
        }

        if (SecMsgrViewModel.Messenger.EndDate != DateTime.MinValue)
        {
            appliedFilters.Add(new FilterItem("to", SecMsgrViewModel.Messenger.EndDate.ToShortDateString()));
        }

        showFilterPopup = false;
    }

    private class FilterItem
    {
        public string Label { get; set; }
        public string Value { get; set; }

        public FilterItem(string label, string value)
        {
            Label = label;
            Value = value;
        }
    }

    private async Task UpdateTabState(SecureMsgrFilterTab securedMessengerFilterTab)
    {
        if (securedMessengerFilterTab != SecureMsgrFilterTab.None && activeTab != securedMessengerFilterTab)
        {
            await SetActiveTab(securedMessengerFilterTab);
        }

        await InvokeAsync(() =>
        {
            SecMsgrViewModel.SelectedMessageId = Guid.Empty;
            StateHasChanged(); // Refresh UI
        });
    }
    
    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            SecMsgrViewModel.SelectedMessageId = Guid.Empty;
            StateHasChanged(); // Refresh UI
        });
    }
}