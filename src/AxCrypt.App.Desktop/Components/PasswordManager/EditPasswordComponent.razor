@using AxCrypt.App.Desktop.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel

@inject IJSRuntime js

<div style="width: 100%;" class="page-max-height parent-container">
    <div class="page-heading">
        <h3 style="background-position:center;" class="password-creation">
            @Texts.EditPasswordTitle
        </h3>
    </div>
    <AxCrypt.App.Desktop.Components.Shared.ProcessIndicatorComponent />
    <EditForm Model="@secretService.CurrentSecret.Password" OnValidSubmit="SavePassword">
        <DataAnnotationsValidator />
        <ul class="clean-up sub-head-clr" style=" list-style:none">
            <li>
                <label for="Password_Url">@Texts.PasswordUrlPrompt:</label><br />
                <input style="color:#494949 !important;" @bind-value="@secretService.CurrentSecret.Password.Url" type="text">
                <ValidationMessage For="@(() => secretService.CurrentSecret.Password.Url)" />
            </li>
            <li>
                <label for="Password_SecretDesc">@Texts.DescriptionLabel:</label><br />
                <textarea id="pwd-desc-inp" style="color:#494949 !important;" maxlength="100000" @bind="@secretService.CurrentSecret.Password.SecretDesc"></textarea>
                <ValidationMessage For="@(() => secretService.CurrentSecret.Password.SecretDesc)" />
            </li>
            <li class="list-row">
                <div class="list-width">
                    <label for="Password_Username">@Texts.UserNamePrompt:</label><br />
                    <input id="pwd-username-inp" style="color:#494949 !important;" maxlength="100000" type="text" @bind-value="@secretService.CurrentSecret.Password.Username">
                    <ValidationMessage For="@(() => secretService.CurrentSecret.Password.Username)" />
                </div>
                <div class="list-width">
                    <label for="password_secretvalue">@Texts.SecurityPasswordText:</label><br />
                    <div style="display:flex; position: relative;">
                        <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                        <input class="passwordInput" style="color:#494949 !important;" maxlength="1000" type="text" @bind-value="@secretService.CurrentSecret.Password.SecretValue" />
                        <div style="right: 0px;" id="suggest-new-password-actn-btn-dsktp" title="@Texts.ButtonSuggestText" @onclick="SuggestPasswordAsync">
                            <img class="suggest-password" src="" alt="suggest-img">
                        </div>
                        <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 46px; cursor: pointer;" class="copy-to-clipbrd" @onclick="CopyToClipboard">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>

                        <ValidationMessage For="@(() => secretService.CurrentSecret.Password.SecretValue)" />
                    </div>
                </div>
            </li>
            <li>
                <div class="btn-sec-new-edit">
                    <button type="submit" class="button btn-extra-small success">@Texts.ButtonSaveText</button>
                    <NavLink href="viewpassword">
                        <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                    </NavLink>
                </div>
            </li>
        </ul>
    </EditForm>
</div>
@code {
    protected override void OnInitialized()
    {
        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }
    }

    private async Task OnAfterRenderAsync()
    {
        await js.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        editSecretViewModel.Secret = secretService.CurrentSecret;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success("Your new password entry has been Updated!.");
            navigationManager.NavigateTo("/viewpassword");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret.Password.SecretDesc = args?.Value?.ToString();
    }

    private async Task CopyToClipboard()
    {
        string password = secretService.CurrentSecret!.Password.SecretValue;
        await js.InvokeVoidAsync("copyToClipboard", password);
    }

    public async Task SuggestPasswordAsync()
    {
        secretService.CurrentSecret!.Password.SecretValue = await SecretsApiHelper.SuggestPasswordAsync();
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}