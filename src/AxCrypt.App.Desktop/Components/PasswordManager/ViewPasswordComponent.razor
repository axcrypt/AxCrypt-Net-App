@using AxCrypt.App.Desktop.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Maui.Controls
@using static AxCrypt.Abstractions.TypeResolve

@inject IStatusAlertService StatusAlertService
@inject NavigationManager navigation
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject IJSRuntime js

<div class="page-max-height">
    <div class="page-heading">
        <h3 style="background-position:center;" class="password-creation">
            @Texts.ViewPasswordTitle
        </h3>
    </div>
    <div class="row">
        <ul class="clean-up" style=" list-style:none">
            <li>
                <label for="Password_Url">@Texts.PasswordUrlPrompt</label><br />
                <input id="pwd-url-inp" type="text" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Password.Url" readonly="readonly">
            </li>
            <li>
                <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                <textarea id="pwd-desc-inp" style="color:#494949 !important; background-color:#E2E2E2" maxlength="100000" @bind="@secretService.CurrentSecret.Password.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea>
            </li>
            <li class="list-row">
                <div class="list-width">
                    <label for="Password_Username">@Texts.UserNamePrompt</label><br />
                    <input id="pwd-username-inp" style="color:#494949 !important; background-color:#E2E2E2" maxlength="100000" type="text" @bind="@secretService.CurrentSecret.Password.Username" readonly="readonly">
                </div>
                <div class="list-width">
                    <label for="password_secretvalue">@Texts.PassphrasePrompt</label><br />
                    <div style="display:flex; position: relative;">
                        <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                        <input id="passwordInput" style="color:#494949 !important; background-color:#E2E2E2" maxlength="1000" type="text" value="@viewSecretViewModel.GetValue(isPasswordVisible,secretService.CurrentSecret.Password.SecretValue)" readonly="readonly" @onclick="() => VisibleReadOnlySecret(true)">
                        <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="CopyToClipboard">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>
                    </div>
                </div>
            </li>
            @if (secretService.CurrentSecret.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail)
            {

                <li class="list-row">
                    <div class="list-width">
                        <label for="Card_ExpirationDate">Owner Email:</label>
                        <input id="card-exp-date-inp" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.OwnerEmail" type="text" readonly="readonly">
                    </div>
                </li>
            }
            <span id="copiedMessage" style="display:none; color: green; font-weight: bold;">Copied!</span>
            <li>
                <div class="center-column" style="gap: 20px;">
                    <div>
                        <NavLink href="passwordManager">
                            <input type="submit" class="button cancel btn-extra-small" value="Back" />
                        </NavLink>
                    </div>
                    <div>
                        @if (viewSecretViewModel.HasPaidSubscription)
                        {
                            <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                        }
                        @if (viewSecretViewModel.HasPaidSubscription && secretService.CurrentSecret.OwnerEmail == viewSecretViewModel.UserEmail)
                        {
                            <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="NavigateToEdit" style="margin-left:20px;" />
                        }
                    </div>
                </div>
            </li>
        </ul>
        @if (!string.IsNullOrEmpty(shareSecretViewModel!.ErrorMessage))
        {
            <div class="error-message">@shareSecretViewModel.ErrorMessage</div>
        }
        @if (!IsSharedView)
        {
            <div onclick="toggleClass()" class="sharetext-arrow">
                <div class="sharewith-row" id="sharewith-expnd-collps">
                    <span class="url-text">@Texts.PromptSharedWith</span>
                    <img id="rotateImg" class="share-box share-image" src="/images/Vector.svg" alt="">
                </div>
            </div>
            <div id="container" class="container">
                @if (viewSecretViewModel.HasBusinessSubscription)
                {
                    <p class="bus-info">
                        Add users or Groups with whom you want to share this secret. If you
                        don`t know about our <b>Group Feature</b> yet, <a style="color:#FFC50D;text-decoration:underline;" @onclick="viewSecretViewModel.GoToLearmoreLink">learn more</a> and create your
                        first one by the link <a style="color:#FFC50D;text-decoration:underline;" @onclick="viewSecretViewModel.GoToCreateGroupLink">Create a Group!</a>
                    </p>
                }
                else
                {
                    <p>Add recipients to the list of people who you want to share this secret with</p>
                }
                <form id="temp-add-share-user" @onsubmit="ApplyShare">
                    <div class="sharewith-box" style="padding: 20px; ">
                        <div style="margin:auto; justify-content:flex-start; flex-wrap:wrap; justify-content:space-around; width:100% " class="row">
                            <div class="small-7 columns">
                                <input type="text" id="new-member-email" name="memberEmail" placeholder="someone@email.example" @onclick="showSyncPopup" @oninput="shareSecretViewModel.OnEmailInput" @bind="@shareSecretViewModel.SecretSharingUserEmail" @onkeydown="HandleKeyDown" style="width: 100%; height: 40px; border-radius:5px ">
                                @if (shareSecretViewModel.ShowUserSuggestion && shareSecretViewModel.SuggestedUnSharedUsers.Any())
                                {
                                    <ul class="share-suggestion-list hide-popup-modal">
                                        @foreach (SecretSharedUserViewModel suggestion in shareSecretViewModel.SuggestedUnSharedUsers)
                                        {
                                            <li @onclick="() => shareSecretViewModel.OnItemTapped(suggestion)" style="margin-top: 5px;">
                                                @if (!string.IsNullOrEmpty(suggestion.GroupName))
                                                {
                                                    <span>@suggestion.DisplayText</span>
                                                    <img src="images/business/IcoGrp.svg" alt="Group Icon" style="float: right;margin: 4px 10px;" />
                                                }
                                                else
                                                {
                                                    <span>@suggestion.UserEmail</span>
                                                    <img class="contact-icon" src="" alt="Individual Icon" style="float: right;margin: 4px 10px;" />
                                                }
                                                <hr style="margin:0.5rem 0;" />
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="small-3">
                                <select style="height: 35px; border-radius:5px" id="shareVisibilityOptions" name="Visibility" title="Visibility" @bind="shareSecretViewModel.VisibilityType">
                                    @foreach (SecretShareVisibility visibility in Enum.GetValues(typeof(SecretShareVisibility)))
                                    {
                                        <option value="@visibility">@visibility</option>
                                    }
                                </select>
                            </div>
                            <div class="small-2 columns">
                                <input style=" margin-top:4%; max-width: 90px; width: 80%;float: right;" id="Add-Share-Users" type="button" class="button active btn-small" @onclick="shareSecretViewModel.AddUserToSharedListAsync" value="Add" />
                            </div>
                        </div>
                        <div class="" style="position: relative; display: flow;">
                            <h3 class="select-files font-bold">Added users with access (<span id="userCount">@shareSecretViewModel.ShareSecretUserList?.Count()</span>)</h3>
                            @if (shareSecretViewModel.ShareSecretUserList!.Any())
                            {
                                <div class="file-box-desktop scroll-container" id="sharedUserList" style="margin-bottom:0px; margin-right:5px;">
                                    @foreach (SecretSharedUserViewModel user in shareSecretViewModel.ShareSecretUserList!)
                                    {
                                        <dl>
                                            <dd class="list-bgrnd">
                                                <img class="@user.ImageSource" style="float: left;width: 25px;margin-top: 5px;max-width: 35px;" src="@SharedUserImageSource(user.ImageSource)" alt="img">
                                                <div style="display:inline-block; ">
                                                    <span class="shared-text">@user.DisplayText</span><br />
                                                    <span style="padding-left:8px; display: block;" class="share-visibility">@user.Visibility</span>
                                                </div>
                                                <img class="menu-image" src="/images/Group160.svg" alt="img" @onclick="() => shareSecretViewModel.UpdatedSelectedUser(user)">
                                                <hr style="width:100%;">
                                            </dd>
                                        </dl>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="file-box-desktop file-box-empty scroll-container" id="sharedUserList" style="margin-right:0px; margin-right:5px;"></div>
                            }
                            @if (shareSecretViewModel.CanContextMenuOpened)
                            {
                                <div class="hide-model-popup context-menu">
                                    <dl>
                                        <dd>
                                            <img class="unshare-icon" src="/images/IcoUnShare.svg" alt="" />
                                            <span @onclick="shareSecretViewModel.RemoveSelectedSharedUser">@Texts.UnSharePromptText</span>
                                        </dd>
                                    </dl>
                                </div>
                            }
                        </div>
                    </div>
                    <div style="margin-left: 0px !important;">
                        <input type="button" class="button success btn-extra-small" @onclick="ApplyShare" value="Apply" />
                    </div>
                </form>
            </div>
        }
    </div>
</div>
@code {
    bool IsSharedView { get; set; }
    bool isPasswordVisible = false;
    ShareSecretViewModel? shareSecretViewModel;

    protected override void OnInitialized()
    {
        viewSecretViewModel.UserEmail = Core.Resolve.KnownIdentities.DefaultEncryptionIdentity.UserEmail.Address;

        if (secretService.CurrentSecret == null)
        {
            navigation.NavigateTo("/error");
        }

        viewSecretViewModel.Secret = secretService.CurrentSecret!;
        IsSharedView = secretService.CurrentSecret?.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail;
        shareSecretViewModel = new ShareSecretViewModel(secretService);
        if (IsSharedView)
        {
            Task.Run(async () => await viewSecretViewModel.UpdateSecretByVisibility());
        }
        shareSecretViewModel.OnUpdateViewState += UpdateStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("toggleClass");

            await js.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "passwordInput");
        }
    }

    private async Task DeleteSecret()
    {
        PopupButtons selectedButton = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, "Alert!", "Are you sure want to delete this secret.", Common.DoNotShowAgainOptions.None);
        bool isConfirmed = selectedButton == PopupButtons.Ok;

        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
        ShowDeleteStatus(deleted);

        navigation.NavigateTo("/passwordManager");
    }

    private void ShowDeleteStatus(bool deleted)
    {
        if (deleted)
        {
            StatusAlertService.Success("Your secret has been deleted!");
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret!.Password.SecretDesc = args?.Value?.ToString();
    }

    private void NavigateToEdit()
    {
        SecretViewModel secret = secretService.CurrentSecret!;
        if (secret != null)
        {
            string url = secret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Password => $"/editpassword"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigation.NavigateTo(url);
            }
        }
    }

    private async Task CopyToClipboard()
    {
        string password = secretService.CurrentSecret!.Password.SecretValue;
        await js.InvokeVoidAsync("copyToClipboard", password);
    }

    private async Task ApplyShare()
    {
        bool isShared = false;
        if (shareSecretViewModel!.EnableApplyButton)
        {
            isShared = await shareSecretViewModel.ApplyShareSecret();
        }

        if (isShared)
        {
            StatusAlertService.Success(Texts.ShareSecretSuccess);
            shareSecretViewModel!.EnableApplyButton = false;
        }
    }

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "passwordInput" && isPasswordVisible)
        {
            isPasswordVisible = false;
        }
        StateHasChanged();
    }

    private void VisibleReadOnlySecret(bool isVisible)
    {
        isPasswordVisible = isVisible;
        StateHasChanged();
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(shareSecretViewModel!.SecretSharingUserEmail))
        {
            shareSecretViewModel.AddUserToSharedListAsync();
        }

        return;
    }

    string SharedUserImageSource(string imageSource)
    {
        return imageSource == "contact-icon" ? "" : "/images/default/AxCrypt_Icon.svg";
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}