@using AxCrypt.App.Desktop.ViewModels.Main
@using AxCrypt.Content

@inject AdvancedOptionsViewModel viewModel

@if (IsVisible)
{   
    <div id="modal-dialog6" class="modalDialog">
        <div style="text-align: left;">
            <div class="modal-header text-center" style="display:block; font-weight:600;">
                <span>Advanced Option</span>
            </div>
            <div class="modal-body">
                <div style="padding-bottom: 15px;">
                    <label>Application Config Path</label><br />
                    <input type="path" @bind="viewModel.AppConfigPath" style="width:100%;" />
                </div>
                <label>Temp File Path</label>
                <div class="center-column">
                    <input type="path" @bind="viewModel.TempConfigPath" @oninput="(e)=> viewModel.BrowseButton_click(e)" style="width:75%;" />
                    <button class="button font-medium success btn-small" @onclick="(e)=> viewModel.BrowseButton_click(e)">Browse</button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-small" @onclick="(e)=> viewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
                <button class="btn-small font-medium button cancel" @onclick="(e)=> viewModel.CancelButton_Click(e)">@Texts.ButtonCancelText</button>
            </div>
            @if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
            {
                <div class="error-message"> @viewModel.ErrorMessage</div>
            }
        </div>
    </div>
}
@code {
    private bool IsVisible { get; set; }

    protected override void OnInitialized()
    {
        viewModel.Initialize();
        viewModel.OnUpdateViewState += UpdateState;
        viewModel.LogOnViewModel.AdvancedOptionsDialog.OnDialogVisibilityChanged += UpdateAdvancedOptionsState;
        base.OnInitialized();
    }

    void UpdateAdvancedOptionsState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
