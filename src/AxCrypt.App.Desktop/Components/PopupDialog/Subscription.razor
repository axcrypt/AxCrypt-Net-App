@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

<div class="free-sugtn">
    <div class="dwnld-sec">
        <img class="gglplay-img " src="" alt="hand-img" @onclick="DownloadAndroidApp" />
        <img class="appstre-img" src="" alt="hand-img" @onclick="DownloadiOsApp" />
    </div>
    <div class="features">
        <div class="subs-feat" style="background-color: #48772C; margin-bottom:10px;">
            <div class="sub-head-sec">
                <span style="font-size: 20px; font-weight: 400;">@Texts.PremiumAccountLabel</span>
                <img class="title-img"
                     src="/images/default/IcoPremium.svg"
                     alt="Premium Badge Icon" />
                <span class="text-center" style="font-weight: 700; font-size: 12px; padding:0 5px;">@Texts.ForIndividualsLabel</span>
            </div>
            <table class="feat-tab" style="width: 96%; margin: 0px 15px;">
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoAPIKey16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListAES256</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoScrdFldr16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListSecuredFolders</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoShrKs16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListKeySharing</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoCld16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListCloudStorage</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoMblEncrptn16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListMobileApps</td>
                </tr>
            </table>
            <div class="text-center" style="margin-top:10px;">
                <NavLink class="text-size grn-clr whte-bg" @onclick="OpenPremiumPage" style="text-decoration:none; padding: 10px 31px;border-radius: 8px;">
                    @Texts.LearnMoreLinkLabel
                </NavLink>
            </div>
        </div>
        <div class="subs-feat" style="background-color: #000;">
            <div class="sub-head-sec">
                <span style="font-size: 20px; font-weight: 400;">@Texts.BusinessAccountLabel</span>
                <img class="title-img"
                     src="/images/default/IcoBusiness.svg"
                     alt="Premium Badge Icon" />
                <span class="text-center" style="font-weight: 700; font-size: 12px; padding:0 5px;">@Texts.ForOrganisationsLabel</span>
            </div>
            <table class="feat-tab" style="width: 96%; margin: 0px 15px;">
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoPrfsnlUs16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListProfessionalUse</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoBusSprt16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListBusinessPrioritySupport</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoBusAdm16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListBusinessAdmin</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoMstrKey16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.MasterKeyTitle</td>
                </tr>
                <tr>
                    <td>
                        <img class="featured-img"
                             src="/images/default/IcoMblEncrptn16px.svg"
                             alt="img" />
                    </td>
                    <td class="feature-item">@Texts.PricingFeatureListMobileApps</td>
                </tr>
            </table>
            <div class="text-center" style="margin-top:10px;">
                <NavLink class="text-size grn-clr whte-bg" @onclick="OpenBusinessPage" style="text-decoration:none; padding: 10px 31px;border-radius: 8px;">
                    @Texts.LearnMoreLinkLabel
                </NavLink>
            </div>
        </div>
    </div>
</div>

@code{
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    public void OpenBusinessPage()
    {
        Core.BrowseUtility.RedirectTo("https://www.axcrypt.net/business/");
    }

    public void OpenPremiumPage()
    {
        Core.BrowseUtility.RedirectTo("https://www.axcrypt.net/premium/");
    }

    public void DownloadAndroidApp()
    {
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://play.google.com/store/apps/details?id=net.axcrypt.axcrypt2x"));
    }

    public void DownloadiOsApp()
    {
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://apps.apple.com/us/app/axcrypt/id1157695909"));
    }
}