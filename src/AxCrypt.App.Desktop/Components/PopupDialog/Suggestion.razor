@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.Content

@inject SuggestionViewModel viewModel

<div class="suggestion">
    <div class="sugg-popup @(viewModel.showSugPopup ? "active" : "")" @onclick="viewModel.TogglePopup" id="popup-part">
        <span @onclick="viewModel.DownloadMobileAppLink">Do you have our <bold class="text-style">Mobile Application ?</bold></span>
        <img class="close-img" @onclick="viewModel.ClosePopup" style="right: -10px; top: -10px;" />
        <div class="dwnld-sec" style="margin: 18px 0px 20px;">
            <img class="appstre-img" src="" alt="hand-img" @onclick="viewModel.DownloadiOsApp" />
            <img class="gglplay-img " src="" alt="hand-img" @onclick="viewModel.DownloadAndroidApp" />
        </div>
        <div>
            <span> Have you tried our <bold class="text-style">Password Generator?</bold></span><br />
            <img class="pwdgnrt-img" src="" alt="hand-img" /><br />
            <button class="button learn-btn sub-lvl-clr" @onclick="viewModel.PasswordGeneratorLink" style="margin-right: 20px;">
                <span>@Texts.TryNowLabel</span>
            </button>
            <button class="button learn-btn" @onclick="viewModel.LearnMore">
                <span>@Texts.LearnMoreLinkLabel</span>
            </button>
        </div>
    </div>
</div>
@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}