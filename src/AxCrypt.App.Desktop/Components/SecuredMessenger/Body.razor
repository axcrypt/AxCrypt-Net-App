@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Desktop.ViewModels.SecuredMessenger
@using AxCrypt.Content;
@using AxCrypt.Core.SecuredMessenger

@inject IJSRuntime jsRuntime

<div class="row">
    <div class="top-design no-margin">
        <NavLink href="messagelist">
            <img class="sldr-img-wht" src="" alt="go-back-icon" />
        </NavLink>
        <div style="float:right;">
            <input type="button" id="delete-button" class="dlt-img-wht" value="" onclick="window.multiAction('MultiActionDelete')" style="background-color: transparent; border: none;" />
        </div>
    </div>

    <div class="top-design-press no-margin">
        <input type="checkbox" class="multi-chckbx" title="Select All" />
        <span style="padding-right: 5%;">Select all</span>
        <div class="slct-press-actions">
            <img class="multi-dlt" src="" alt="delete-img" onclick="multiAction('delete')" />
            <img class="multi-read" src="" alt="read-img" onclick="multiAction('read')" />
            <img class="multi-unread" src="" alt="unread-img" onclick="multiAction('unread')" />
        </div>
        <NavLink href="messagelist" style="float: right;"><img class="ico-close" src="" alt="close-img" /></NavLink>
    </div>

    <div class="medium-5 all-msg" style="padding: 0;">
        <div class="center-column">
            <button class="button fnt-high" style="text-align: left; height: 44px;">
                <input type="checkbox" class="multi-chckbx" title="Select All" />
                <span class="mutli-slct-btn">Inbox</span>
                <div class="slct-actions">
                    <img class="select-option" src="/images/default/IcoSelect.svg" alt="delete-img" title="Select" />
                    <img class="multi-dlt" src="" alt="delete-img" title="Delete" onclick="window.multiAction('MultiActionDelete')" />
                    @if (Model.Messenger.SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent)
                    {
                        <img class="multi-read" src="" alt="read-img" title="Read" onclick="window.multiAction('MultiActionRead')" />
                        <img class="multi-unread" src="" alt="unread-img" title="Unread" onclick="window.multiAction('MultiActionUnread')" />
                    }
                </div>
            </button>
            <button class="button success new-btn fnt-small" id="create-new-message">
                New Message
            </button>
        </div>
        <div id="all-message-list" class="message-list-section">
            <AxCrypt.App.Desktop.Components.SecuredMessenger.MessagesList Model="@Model" />
        </div>
        <a href="javascript:void(0);" id="load-more-btn" onclick="EnableLoadMore()" class="loadMoreActionlnk"> Load More </a>
    </div>
    <div class="medium-7 columns flex-direction" style="padding:2px 8px; height:auto; max-height:520px; overflow-y:scroll;">
        @if (Model?.Messenger.Messages.Any() == true)
        {
            <div class="text-center empty-sec">
                <span class="fnt-medium">Select an item to read</span><br />
                <span class="fnt-medium grey-clr">No items selected</span><br />
                <img class="inbox-img" src="" alt="inbox-img" />
            </div>
        }
        <div>
            <div class="view-section messager-loading" id="messenger-loading-section">
                <span>Loading...</span>
            </div>
            <div class="new-section" id="new-message-section">
                <AxCrypt.App.Desktop.Components.SecuredMessenger.New />
            </div>
            <div id="viewer-messenger-section">
                <AxCrypt.App.Desktop.Components.SecuredMessenger.View Model="@Model" />
            </div>
        </div>
    </div>
</div>

<EditForm Model="Model.Messenger" id="delete-form">
    <input type="hidden" id="ids-input-dlt" name="messengerId" value="" />
    <input type="hidden" id="sec-messenger-filter-tab" name="SecMessengerFilterTab" @bind="Model.Messenger.SecMessengerFilterTab" />
</EditForm>

<EditForm Model="Model.Messenger" id="read-form">
    <input type="hidden" id="ids-input-read" name="messengerId" value="" />
</EditForm>

<EditForm Model="Model.Messenger" id="unread-form">
    <input type="hidden" id="ids-input-unread" name="messengerId" value="" />
</EditForm>

<EditForm Model="Model" id="loadmore-button-click">
    <input type="hidden" id="pagenumber-id-hidden" name="pageNumber" value="@Model.Messenger.PageNumber" />
    <input type="hidden" id="sec-messenger-filter-tab" name="secMessengerFilterTab" value="@Model.Messenger.SecMessengerFilterTab" />
</EditForm>

@code {
    [Parameter]
    public SecuredMessengerListViewModel? Model { get; set; }

    protected override void OnParametersSet()
    {
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("SemScript");
            await jsRuntime.InvokeVoidAsync("setDotNetHelper", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task MultiActionDelete(string[] checkedIds)
    {
        await PerformAction(checkedIds, "delete");
    }

    [JSInvokable]
    public async Task MultiActionRead(string[] checkedIds)
    {
        await PerformAction(checkedIds, "read");
    }

    [JSInvokable]
    public async Task MultiActionUnread(string[] checkedIds)
    {
        await PerformAction(checkedIds, "unread");
    }

    private async Task PerformAction(string[] checkedIds, string actionType)
    {
        if (checkedIds == null || checkedIds.Length == 0)
        {
            Console.WriteLine("No messages selected.");
            return;
        }

        string messengerId = string.Join(",", checkedIds);

        switch (actionType)
        {
            case "delete":
                await Model.DeleteSelection(messengerId, Model.Messenger.SecMessengerFilterTab);
                break;
            case "read":
                await Model.Read(messengerId);
                break;
            case "unread":
                await Model.Unread(messengerId);
                break;
        }

        StateHasChanged();
    }
}