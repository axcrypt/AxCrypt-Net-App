@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Desktop.ViewModels.SecuredMessenger
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content;
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Api.Extension

@inject ViewSecMsgrViewModel ManageSecMgrViewModel
@inject SecuredMessengerListViewModel Model


@{
    string activeClass = ManageSecMgrViewModel.AnySelected ? "active-btn" : "";
}

<div class="row">
    <div class="medium-5 all-msg" style="padding: 0;">
        <div class="center-column">
            <button class="button fnt-high" style="text-align: left; height: 44px;">
                @if (ManageSecMgrViewModel.isMultiCheckboxVisible || ManageSecMgrViewModel.AnySelected)
                {
                    <input type="checkbox" class="multi-chckbx" title="Select All" checked="@ManageSecMgrViewModel.SelectAllMessages" bind-checked="@ManageSecMgrViewModel.SelectAllMessages" @onchange="ManageSecMgrViewModel.ToggleAllMessages" />
                }
                <span class="mutli-slct-btn">@TabTitleText</span>
                <div class="slct-actions @activeClass">

                    <img class="select-option" src="/images/default/IcoSelect.svg" alt="delete-img" title="Select" @onclick="@ManageSecMgrViewModel.ToggleMultiCheckbox" />
                    <img class="multi-dlt" src="" alt="Delete" title="Delete" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("delete"))" />
                    @if (Model.Messenger.SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent)
                    {
                        <img class="multi-read" src="" alt="Mark Read" title="Read" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("read"))" />
                        <img class="multi-unread" src="" alt="Mark Unread" title="Unread" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("unread"))" />
                    }
                </div>
            </button>
            <button class="button success new-btn fnt-small" id="create-new-message" @onclick="()=>{ ManageSecMgrViewModel.Messenger = new SecuredMessengerModel(); ManageSecMgrViewModel.ComposeNewMessage(); }">
                New Message
            </button>
        </div>
        <div id="all-message-list" class="message-list-section">
            <AxCrypt.App.Desktop.Components.SecuredMessenger.MessagesList Messages="@ManageSecMgrViewModel.Messages" SecMessengerFilterTab="@SecMessengerFilterTab" />
        </div>
        <a href="javascript:void(0);" id="load-more-btn" @onclick="()=>EnableLoadMoreAction(Model.Messenger.PageNumber)" class="loadMoreActionlnk"> Load More </a>
    </div>
    <div class="medium-7 columns flex-direction" style="padding:2px 8px; height:auto; max-height:520px; overflow-y:auto;">
        @if ((ManageSecMgrViewModel.Messenger == null || !ManageSecMgrViewModel.Messenger.Messages.Any()) && !ManageSecMgrViewModel.ShowLoadingWheel && !ManageSecMgrViewModel.NewSecMsgrViewModel.IsVisible)
        {
            <div class="text-center empty-sec">
                <span class="fnt-medium deflt-txt-clr">Select an item to read</span><br />
                <span class="fnt-medium grey-clr">No items selected</span><br />
                <img class="inbox-img" src="" alt="inbox-img" />
            </div>
        }
        <div>
            @if (ManageSecMgrViewModel.ShowLoadingWheel)
            {
                <div class="view-section messager-loading" id="messenger-loading-section">
                    <span>@Texts.LoadingText</span>
                </div>
            }
            <AxCrypt.App.Desktop.Components.SecuredMessenger.New />
            <div id="viewer-messenger-section">
                <AxCrypt.App.Desktop.Components.SecuredMessenger.View Model="@Model" />
            </div>
        </div>
    </div>
</div>

<EditForm Model="Model" id="loadmore-button-click">
    <input type="hidden" id="pagenumber-id-hidden" name="pageNumber" value="@Model.Messenger.PageNumber" />
    <input type="hidden" id="sec-messenger-filter-tab" name="secMessengerFilterTab" value="@Model.Messenger.SecMessengerFilterTab" />
</EditForm>

@code {
    [Parameter]
    public SecureMsgrFilterTab SecMessengerFilterTab { get; set; }

    protected override void OnInitialized()
    {
        Model.OnUpdateViewState += UpdateState;
        ManageSecMgrViewModel.OnUpdateViewState += UpdateState;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || Model.Messenger.SecMessengerFilterTab != SecMessengerFilterTab)
        {
            await Model.GetMessagesList(SecMessengerFilterTab);
            ManageSecMgrViewModel.Messages = Model.Messenger.Messages.ToList();
            ManageSecMgrViewModel.Messenger.SecMessengerFilterTab = SecMessengerFilterTab;
        }
    }

    private string TabTitleText
    {
        get
        {
            switch (SecMessengerFilterTab)
            {
                case SecureMsgrFilterTab.Inbox:
                    return "Inbox";
                case SecureMsgrFilterTab.Sent:
                    return "Sent";
                case SecureMsgrFilterTab.Unread:
                    return "Unread";
                default:
                    return "";
            }
        }
    }

    public async Task<bool> EnableLoadMoreAction(int pageNumberCount)
    {
        pageNumberCount += 1;
        SecuredMessengerModel messengerModel = await Model.LoadMore(pageNumberCount, Model.Messenger.SecMessengerFilterTab);
        if (Model.Messenger.Messages != null && messengerModel != null && messengerModel!.Messages.Any())
        {
            ManageSecMgrViewModel.Messages = Model.Messenger.Messages.Concat(messengerModel!.Messages).ToList();
            UpdateState();
            return true;
        }
        return false;
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}