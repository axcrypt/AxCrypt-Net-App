@using AxCrypt.Core.SecuredMessenger;
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger;

@inject ManageSecMsgrViewModel ManageSecMgrViewModel

<div class="row">
    <div class="medium-12 columns">
        <div class="inbox-section no-margin" id="load-message-list">
            @if (ManageSecMgrViewModel.Messenger.Messages == null || !ManageSecMgrViewModel.Messenger.Messages.Any())
            {
                <label class="center-column" id="noMoreNewMessagesText" style="margin: 10% 20%;">(No messages found.)</label>
            }
            else
            {
                @foreach (SecuredMessage messenger in ManageSecMgrViewModel.Messenger.Messages)
                {
                    <AxCrypt.App.Desktop.Components.SecuredMessenger.Messages Model="@messenger" SecMessengerFilterTab="@ManageSecMgrViewModel.Messenger.SecMessengerFilterTab" />
                }
            }
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ManageSecMgrViewModel.Messenger.Messages = new List<SecuredMessage>();
        ManageSecMgrViewModel.Messenger.ChildMessages = new List<SecuredMessage>();
        ManageSecMgrViewModel.OnUpdateViewState += UpdatePageState;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

    }

    void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
