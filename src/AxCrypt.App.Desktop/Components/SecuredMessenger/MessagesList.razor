@using AxCrypt.Core.SecuredMessenger;

<div class="row">
    <div class="medium-12 columns">
        <div class="inbox-section no-margin" id="load-message-list">
            @if (Messages == null || !Messages.Any())
            {
                <label class="center-column" id="noMoreNewMessagesText" style="margin: 10% 20%;">(No messages found.)</label>
            }
            else
            {
                @foreach (SecuredMessage messenger in Messages)
                {
                    <AxCrypt.App.Desktop.Components.SecuredMessenger.Messages Model="@messenger" SecMessengerFilterTab="@SecMessengerFilterTab" />
                }
            }
        </div>
    </div>
</div>

@code {

    [Parameter]
    public IEnumerable<SecuredMessage>? Messages { get; set; }

    [Parameter]
    public AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab SecMessengerFilterTab { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}