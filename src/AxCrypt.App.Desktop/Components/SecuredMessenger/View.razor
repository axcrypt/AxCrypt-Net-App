@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Desktop.Data
@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Desktop.ViewModels.SecuredMessenger
@using AxCrypt.Content;
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve;

@inject ViewSecMsgrViewModel ViewSecMsgrViewModel
@inject IStatusAlertService StatusAlertService;
@inject IJSRuntime jsRuntime

@if (ViewSecMsgrViewModel.Messenger != null && ViewSecMsgrViewModel.Messenger.Messages != null)
{
    int replyIndex = 0; string LatestMessageStyle = "";
    @foreach (SecuredMessage messenger in ViewSecMsgrViewModel.Messenger.Messages)
    {
        LatestMessageStyle = "display:none;";
        if (!string.IsNullOrEmpty(messenger.Message.TheMessage))
        {
            LatestMessageStyle = "display:block;";
        }

        Guid parentId = messenger.ParentId == Guid.Empty ? messenger.Id : messenger.ParentId;

        string messageFrom = messenger.Message.Username;
        IEnumerable<string> messageToList = messenger.Message.ReceiverList.Select(re => re.User);
        string messageToListText = string.Join(", ", messageToList);

        string senderShortCode = messageFrom.Substring(0, 2).ToUpper();
        IList<string> replyUserList = new List<string>();
        if (Model.Messenger.SecMessengerFilterTab == AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent || messageFrom == currentUser)
        {
            senderShortCode = messageToListText.Substring(0, 2).ToUpper();
            replyUserList = new List<string> { messageFrom };
        }
        else
        {
            replyUserList = messageToList.Where(re => !re.Equals(currentUser)).ToList();
            if (!replyUserList.Any(ru => ru == messageFrom))
            {
                replyUserList.Add(messageFrom);
            }
        }

        string replyMesssageReceivers = string.Join(", ", replyUserList);

        <div id="view-message-box">
            <img class="rpl-img-wht" src="" alt="rply-icons" id="reply-icon2" data-id="@messenger.Id" onclick="replyMessage(this, '@parentId', '@messenger.Id', '@replyMesssageReceivers')" />            <div class="view-section" id="expand-view-sec">
                <table>
                    <tbody onclick="window.OnMessageAction(event, '@messenger.Id','@parentId', '@replyMesssageReceivers')" style="cursor:pointer;">
                        <tr>
                            <td> <div class="acc-prfl fnt-small">@senderShortCode</div></td>
                            <td style="line-height: normal; max-width: 235px; padding-left: 5px;">
                                <div style="display: flex; align-items: center; gap: 5px ">
                                    <label>From:</label>
                                    <span class="email-txt-ovflw">@messenger.Message.Username</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 5px">
                                    <label>To:</label>
                                    <span class="" style="font-size: 12px; word-wrap:unset; padding-left:18px;">
                                        @string.Join(", ", messageToList.Take(Utility.MaxReceiversToDisplay))

                                        @if (messageToList.Count() > Utility.MaxReceiversToDisplay)
                                        {
                                            <span class="fnt-medium" style="padding-left: 10px;">+@(messageToList.Count() - Utility.MaxReceiversToDisplay) others</span>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="right-align" style="vertical-align: top;">
                                <input type="button" class="rply-icon" id="reply-button-@messenger.Id"
                                       data-id="@messenger.Id"
                                       onclick="window.OnMessageAction(event, '@messenger.Id', '@messenger.ParentId', '@replyUserList')"
                                       value="Reply" name="reply-button" />

                                <input type="button" name="delete-button" class="dlt-icon" value="Delete"
                                       data-id="@messenger.Id"
                                       onclick="window.OnMessageAction(event, '@messenger.Id')"
                                       style="background-color: transparent; border: none;" /> <br />

                                <label class="right-align grey-clr" style="font-size: 12px; font-weight: 600; padding-top: 5px;">@Utility.ToDateString(messenger.CreatedUtc)</label>
                            </td>
                        </tr>
                        <tr>
                            <td class="visiblity-text fnt-small" colspan="2">
                                @if (messenger.Message.VisibleUntil != DateTime.MaxValue)
                                {
                                    <span>Visible until:</span>
                                    <span class="">@Utility.ToDateString(messenger.Message.VisibleUntil)</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-msg message-content" id="secured-messenger-view-@messenger.Id" style="@LatestMessageStyle">
                    @if (messenger.Message.TheMessage != null)
                    {
                        <textarea name="encryptedMessage" id="secured-mess-body" maxlength="100000" @bind="messenger.Message.TheMessage" readonly autofocus></textarea>
                    }
                </div>
                <div class="text-msg message-content messager-loading" style="display:none;" id="messenger-view-loading-section-@messenger.Id">
                    <span>Loading...</span>
                </div>
            </div>
        </div>

        replyIndex++;
    }
}

<EditForm Model="ViewSecMsgrViewModel" id="message-delete-form">
    <input type="hidden" id="messenger-id-hidden" name="messengerId" value="" />
    <input type="hidden" id="messenger-parentid-hidden" name="parentId" value="" />
    <input type="hidden" id="sec-messenger-filter-tab" name="SecMessengerFilterTab" @bind="Model.Messenger.SecMessengerFilterTab" />
</EditForm>

<EditForm Model="Model" id="new-message-form">
    @* this form is used for validating the data - not used to submit/send messages *@
    <input type="hidden" id="parent-message-id-new-message-hidden" name="parentMsgrId" />
    <input type="hidden" id="message-id-new-message-hidden" name="messengerId" value="Guid.Empty" />
    <input type="hidden" id="message-reply-users-hidden" name="replyUsers" value="Guid.Empty" />
</EditForm>

<EditForm Model="@ViewSecMsgrViewModel" id="view-selected-msg-form">
    <input type="hidden" id="message-id-view-message-hidden" name="id" />
</EditForm>

@code {

    string currentUser = New<KnownIdentities>().DefaultEncryptionIdentity.UserEmail.Address.ToString();

    [Parameter]
    public Guid messageId { get; set; }

    [Parameter]
    public SecuredMessengerListViewModel? Model { get; set; }


    protected override void OnInitialized()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await jsRuntime.InvokeVoidAsync("SemScript");
                await jsRuntime.InvokeVoidAsync("setDotNetHelperView", DotNetObjectReference.Create(this));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    [JSInvokable]
    public async Task FetchMessageDetails(Guid messageId)
    {
        if (messageId == Guid.Empty)
        {
            return;
        }

        await ViewSecMsgrViewModel.ViewMessage(messageId, Model.Messenger.SecMessengerFilterTab);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task DeleteMessage(Guid messageId, Guid parentId)
    {
        if (messageId == Guid.Empty)
        {
            Console.WriteLine("Message ID is empty.");
            return;
        }

        bool isDeleted = await ViewSecMsgrViewModel.Delete(messageId, parentId, Model.Messenger.SecMessengerFilterTab);
        if (isDeleted)
        {
            StatusAlertService.Success(@Texts.DeletionSuccess);
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            StatusAlertService.Error(@Texts.DeletionFailed);
        }
    }

    [JSInvokable]
    public async Task<SecuredMessage> ViewMessageById(Guid messageId)
    {
        if (messageId == Guid.Empty)
        {
            Console.WriteLine("Message ID is empty.");
            return new SecuredMessage();
        }

        SecuredMessage message = await ViewSecMsgrViewModel.ViewMessageById(messageId);
        if (message == null)
        {
            Console.WriteLine($"No message found for ID: {messageId}");
            return new SecuredMessage();
        }

        Console.WriteLine($"Message found: {message}");
        return message;
    }
}
