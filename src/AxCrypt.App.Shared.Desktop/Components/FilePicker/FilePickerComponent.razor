@using AxCrypt.App.Shared.Desktop.ViewModels.FileBrowser
@using AxCrypt.App.Shared.UI.ViewModels
@using AxCrypt.App.Shared.Utility
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.ViewModels.FileBrowser
@using AxCrypt.Content

@inject DesktopFilePickerViewModel ViewModel
@inject IJSRuntime JS

<style>
    .file-action-progress-bar {
        position: absolute;
        z-index: 1000;
        display: flex;
        width: 100%;
        justify-content: center;
        background: conic-gradient(from 10.99deg at 98.18% 128.62%, #fffee8 0deg, rgba(200, 199, 180, .8) 353.48deg, #f5fff0 360deg);
        height: 89%;
        align-items: center;
    }

    .tab-container {
        display: flex;
        margin: 0px 15px;
        align-items: center;
        border: 3px solid #48772C;
        width: fit-content;
        border-radius: 5px;
    }

    .tab-label {
        font-size: 16px;
        cursor: pointer;
        padding: 5px 25px;
        border-radius: 4px;
    }

    .active-tab {
        border: 3px solid #48772C;
        font-weight: 600;
        color: white;
        background-color: #48772C;
    }

</style>

@if (ViewModel.IsVisible)
{
    <div class="file-picker-modalDialog">
        <div @onclick="async () => await HideContextMenu()">
            <div class="file-picker-header" style="margin:1rem;">
                <div class="close-img" @onclick="CloseWindow"></div>
                <div class="file-picker-title">
                    <div class="center-title">
                        <img class="@ViewModel.SelectedProviderImage" alt="cloud-storage-icon" />
                        <label for="title" title="@ViewModel.PageTitle">
                            @ViewModel.PageTitle
                        </label>
                    </div>

                    <div class="search-box">
                        <input id="searchKeyword"
                               name="searchKeyword"
                               type="text"
                               @bind="ViewModel.SearchQuery"
                               placeholder="Search files"
                               style="margin-bottom: 5px;"
                               @oninput="async (eargs) => await OnSearchChanged(eargs)" />

                        <div class="search-btn" @onclick="() => OnSearchClick()">
                            <img src="/images/default/IcoSearchWht.svg" alt="search-icon" />
                        </div>

                        @if (ViewModel.IsSearchResultVisible)
                        {
                            <label>
                                Search result
                                <span style="color: #0078d4;text-decoration: underline;cursor: pointer;padding: 0px 10px;display: inline-block;"
                                      @onclick="() => ClearResult()">Clear result</span>
                            </label>
                        }

                    </div>
                </div>
            </div>
            <div class="file-picker-modal-body" style="position:relative">
                @if (ViewModel.ShowProgressBar)
                {
                    <div class="file-action-progress-bar">
                        <div class="loading-content">
                            <img src="/images/default/Loading_560x560.gif" alt="Loading..." />
                            <span style="color:black ">@AxCrypt.Content.Texts.ProgressIndicatorWaitMessage</span>
                        </div>
                    </div>
                }

                <div class="content-area">
                    <div class="tab-container">
                        <span class="tab-label @((ViewModel.selectedTab == "all" ? "active-tab" : ""))" @onclick='async () => await GetSelectedFileList("all")'>
                            All files
                        </span>

                        <label class="tab-label @((ViewModel.selectedTab == "sharedWithMe" ? "active-tab" : ""))" @onclick='async () => await GetSelectedFileList("sharedWithMe")'>
                            Shared with me
                        </label>

                        @if (ViewModel.SelectedCloudProvider != Core.IO.FileProvider.OneDrive)
                        {
                            <label class="tab-label @((ViewModel.selectedTab == "sharedByMe" ? "active-tab" : ""))" @onclick='async () => await GetSelectedFileList("sharedByMe")'>
                                Shared by me
                            </label>
                        }

                    </div>
                    <div class="file-picker-dir-content find-fle-nme" @oncontextmenu="(e) => ShowContextMenu(e)" id="user_files_section" @onclick="async () => await HideContextMenu()">
                        <div class="header-bar" @onclick:stopPropagation @oncontextmenu:preventDefault>
                            <div class="div-file-header">
                                @if (isListView)
                                {
                                    <span>
                                        <input type="checkbox" checked="@selectAll" id="multiplefile" @onclick="() => SelectAllFile()" />
                                        @Texts.NameLabel
                                    </span>

                                    <span>@Texts.FindPathTitle</span>
                                }
                                else
                                {
                                    <span>
                                        <input type="checkbox" checked="@selectAll" id="multiplefile" @onclick="() => SelectAllFile()" />
                                        @Texts.SelectAllFilesLabelText
                                    </span>
                                }
                            </div>

                            <div class="display-type">
                                <img src="/images/default/IcoList.svg"
                                     class="@((isListView ? "selected" : ""))"
                                     @onclick="() => SetView(true)"
                                     alt="List View" />

                                <img src="/images/default/IcoGrid.svg"
                                     class="@((!isListView ? "selected" : ""))"
                                     @onclick="() => SetView(false)"
                                     alt="Grid View" />
                            </div>
                        </div>

                        <div class="files-section @(isListView ? "list-view" : "grid-view")">
                            @if (ViewModel.Files.Count > 0)
                            {
                                @if (isListView)
                                {
                                    <ul class="file-list">
                                        @foreach (FilePickerItemViewModel file in ViewModel.Files)
                                        {
                                            string ParentPath = file.ParentPath + "/" + file.FileName;
                                            <li class="file-list-item @(file.IsSelected ? "select-item" : "")" @onclick="() => OnCheckboxChanged(file)" @ondblclick="() => OnFolderClicked(file)">
                                                <div class="file-details fle-exton-img">
                                                    @{
                                                        if (!file.IsFolder)
                                                        {
                                                            <input id="@file.FileID" type="checkbox" checked="@file.IsSelected" class="fileitem-chk-box" />
                                                        }
                                                    }
                                                    <img alt="File Icon" class="list-file-icon  @(file.IsFolder == true ? "Icon-folder" : ViewModel.GetFileTypeIcon(file.FileName))" />
                                                    <span class="file-name">
                                                        @((MarkupString)HighlightMatch(file.FileName))
                                                    </span>
                                                    <span class="file-path">
                                                        @((MarkupString)HighlightMatch(ParentPath))
                                                    </span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="file-grid">
                                        @foreach (FilePickerItemViewModel file in ViewModel.Files)
                                        {
                                            string ParentPath = file.ParentPath + "/" + file.FileName;
                                            <div class="file-grid-item @(file.IsSelected ? "select-item" : "") fle-exton-img" @onclick="() => OnCheckboxChanged(file)" @ondblclick="() => OnFolderClicked(file)">
                                                <img alt="File Icon" class="grid-file-icon @(file.IsFolder == true ? "Icon-folder" : ViewModel.GetFileTypeIcon(file.FileName))" />
                                                <span class="file-name-grid">@((MarkupString)HighlightMatch(file.FileName))</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="file-notfound">
                                    <span>@Texts.NoFilesFoundText </span>
                                    <img src="/images/default/filenotfound.svg" />
                                </div>
                            }

                            @if (isContextMenuVisible)
                            {
                                <div class="context-menu-action" style="position: fixed; top: @(contextMenuY)px;left: @(contextMenuX)px;">
                                    <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.Encrypt)">@Texts.EncryptToolStripMenuItemText</span>
                                    <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.Decrypt)">@Texts.DecryptToolStripMenuItemText</span>
                                    <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.ShareKey)">@Texts.ShareKeysToolStripMenuItemText</span>
                                    <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.OpenSecured)">@Texts.OpenEncryptedToolStripMenuItemText</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="filepicker-action-container">
                        <div class="filepicker-dropdown-action">
                            @if (ViewModel.MultiSelectEnabled)
                            {
                                <div class="round-btn" @onclick="() => ShowActionContextMenu()" title="Manage selected file(s)">
                                    <img class="action-btn" alt="action button" />
                                </div>

                                @if (isActionContextMenuVisible)
                                {
                                    <div class="filepicker-dropdown-menu-action context-menu-action">
                                        <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.Encrypt)">@Texts.EncryptToolStripMenuItemText</span>
                                        <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.Decrypt)">@Texts.DecryptToolStripMenuItemText</span>
                                        <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.ShareKey)">@Texts.ShareKeysToolStripMenuItemText</span>
                                        <span class="menu-item" @onclick="async () => await UpdateFileOperation(FileOperationOption.OpenSecured)">@Texts.OpenEncryptedToolStripMenuItemText</span>
                                        <span class="menu-item" @onclick="async () => await ClearSelection()">Clear Selected</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="round-btn" @onclick="async () => await ViewModel.AddFiles()" title="Add file(s)">
                                    <img class="add-btn" alt="add button" />
                                </div>
                            }
                        </div>
                    </div>
                </div>


                <div class="file-picker-filepath">
                    <nav class="breadcrumb">
                        @if (!ViewModel.IsSearchResultVisible & ViewModel.selectedTab == "all")
                        {
                            <span class="breadcrumb-part" title="@ViewModel.PageTitle" @onclick="@(async () => await ViewModel.NavigateBackToPath("root"))">
                                @ViewModel.PageTitle
                            </span>

                            @if (ViewModel.OpenedFoldersList.Count > 4)
                            {
                                <span class="breadcrumb-part">
                                    .../
                                </span>
                            }

                            @foreach (FolderItem folder in ViewModel.OpenedFoldersList.TakeLast(4))
                            {
                                <span class="separator"><img class="icon-next-arrow" /><img class="icon-dltfold" /> </span>
                                <span class="breadcrumb-part" title="@folder.DirectoryName" @onclick="async () => await ViewModel.NavigateBackToPath(folder.FileID)">
                                    @folder.DirectoryName
                                </span>
                            }
                        }
                    </nav>

                    <button class="Close-btn" @onclick="CloseWindow">
                        @Texts.WixFailureCloseButton
                    </button>
                </div>
            </div>

        </div>
    </div>

    <script>
        window.scrollToFirstMatch = function () {
            const el = document.getElementById("firstMatch");
            if (el) {
                el.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        };
    </script>
}

@code {
    private bool isListView { get; set; } = true;
    private bool isContextMenuVisible { get; set; } = false;
    private bool isActionContextMenuVisible { get; set; } = false;
    private bool selectAll { get; set; } = false;
    private double contextMenuX { get; set; }
    private double contextMenuY { get; set; }

    protected override void OnInitialized()
    {
        ViewModel.OnUpdateViewState += async () => await UpdateUIState();
        base.OnInitialized();
    }

    private void CloseWindow()
    {
        ViewModel.IsVisible = false;
    }

    private async Task GetSelectedFileList(string selectedTab)
    {
        switch (selectedTab)
        {
            case "all":
                await ViewModel.NavigateBackToPath("root");
                ViewModel.selectedTab = selectedTab;
                break;

            case "sharedWithMe":
                await ViewModel.GetSharedWithFileListAsync();
                ViewModel.selectedTab = selectedTab;
                break;

            case "sharedByMe":
                await ViewModel.GetSharedByFileListAsync();
                ViewModel.selectedTab = selectedTab;
                break;
        }
    }

    private string HighlightMatch(string input)
    {
        if (string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
            return System.Net.WebUtility.HtmlEncode(input);

        string pattern = System.Text.RegularExpressions.Regex.Escape(ViewModel.SearchQuery);
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        int matchCount = 0;
        string highlighted = regex.Replace(System.Net.WebUtility.HtmlEncode(input), match =>
        {
            matchCount++;
            string spanId = matchCount == 1 ? "id='firstMatch'" : "";
            return $"<span class=\"highlight\" {spanId}>{match.Value}</span>";
        });

        return highlighted;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        ViewModel.SearchQuery = e.Value?.ToString() ?? "";
        await Task.Yield();
        await JS.InvokeVoidAsync("scrollToFirstMatch");
    }

    private async Task OnSearchClick()
    {
        ViewModel.IsSearchResultVisible = true;
        await ViewModel.SearchAsync(ViewModel.SearchQuery);
    }

    private async Task ClearResult()
    {
        ViewModel.IsSearchResultVisible = false;
        await ViewModel.NavigateBackToPath("root");
        ViewModel.SearchQuery = "";
    }

    private void SetView(bool listView)
    {
        if (ViewModel.Files.Count <= 0)
            return;

        isListView = listView;
        isContextMenuVisible = false;
        isActionContextMenuVisible = false;
    }

    private void OnCheckboxChanged(FilePickerItemViewModel file)
    {
        if (file.IsFolder)
            return;

        file.IsSelected = !file.IsSelected;
        if (file.IsSelected)
        {
            ViewModel.SelectedFiles.Add(file);
        }
        else
        {
            ViewModel.SelectedFiles.Remove(file);
        }

        ViewModel.MultiSelectEnabled = ViewModel.SelectedFiles.Any();
        if (!ViewModel.SelectedFiles.Any())
        {
            isContextMenuVisible = false;
            isActionContextMenuVisible = false;
        }

        selectAll = ViewModel.SelectedFiles.Where(f => !f.IsSelected).Any();
    }

    private async Task ShowContextMenu(MouseEventArgs e)
    {
        if (!ViewModel.SelectedFiles.Any())
            return;

        contextMenuX = e.PageX;
        contextMenuY = e.PageY;
        isContextMenuVisible = true;
        await UpdateUIState();
    }

    private async Task ShowActionContextMenu()
    {
        if (!ViewModel.SelectedFiles.Any())
            return;

        isActionContextMenuVisible = !isActionContextMenuVisible;
        await UpdateUIState();
    }

    private async Task SelectAllFile()
    {
        selectAll = !selectAll;
        ViewModel.MultiSelectEnabled = true;
        ViewModel.SelectedFiles.Clear();
        foreach (FilePickerItemViewModel file in ViewModel.Files.Where(f => !f.IsFolder))
        {
            file.IsSelected = selectAll;
            ViewModel.SelectedFiles.Add(file);
        }

        isContextMenuVisible = false;
        isActionContextMenuVisible = false;
        await UpdateUIState();
    }

    private async Task ClearSelection()
    {
        foreach (FilePickerItemViewModel file in ViewModel.Files)
        {
            file.IsSelected = false;
        }

        isContextMenuVisible = false;
        isActionContextMenuVisible = false;
        ViewModel.SelectedFiles.Clear();
        ViewModel.MultiSelectEnabled = ViewModel.SelectedFiles.Any();
        await UpdateUIState();
    }

    private async Task HideContextMenu()
    {
        isContextMenuVisible = false;
        await UpdateUIState();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            JS.InvokeVoidAsync("document.addEventListener", "click", EventCallback.Factory.Create<MouseEventArgs>(this, HideContextMenu));
        }
    }

    async Task UpdateUIState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task UpdateFileOperation(FileOperationOption operation)
    {
        ViewModel.SelectedFileOperation = operation;
        isContextMenuVisible = false;
        isActionContextMenuVisible = false;
        selectAll = false;
        await OnDoneClicked();
    }

    private async Task OnDoneClicked()
    {
        await ViewModel.ProcessSelectedFileItemActionAsync();
        await UpdateUIState();
    }

    private async Task OnFolderClicked(FilePickerItemViewModel file)
    {
        if (!file.IsFolder)
        {
            return;
        }

        await ViewModel.ProcessSelectedFile(file);
    }
}