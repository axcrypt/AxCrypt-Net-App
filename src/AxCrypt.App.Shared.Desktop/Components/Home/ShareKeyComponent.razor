@implements IDisposable
@using AxCrypt.Api.Model
@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content
@using Microsoft.AspNetCore.Components.Web

@inject ShareKeyViewModel ShareKeyViewModel
@inject IJSRuntime JSRuntime

@*
    ShareKeyComponent — completely rebuilt with the .skd-* (share-key
    dialog) design system. Replaces the previous popup that mixed
    centered text, floated images and scattered SCSS overrides.

    New structure:
      ┌────────────────────────────────────────────────────┐
      │ [icon] Share access                          [×]    │  header
      │ short context copy                                  │
      │ ─────────────────────────────────────────────────── │
      │ [optional Business "create groups" banner]          │
      │ [optional file chip strip — what's being shared]    │
      │                                                     │
      │ Add recipients                                      │
      │ [   email input                          ] [Add]    │
      │     ↓ live suggestions popover                      │
      │                                                     │
      │ Shared with (N)                                     │
      │ [avatar] alice@…                  ⋯ (remove menu)   │
      │ [avatar] bob@…                    ⋯                 │
      │ ─────────────────────────────────────────────────── │
      │                              [Cancel]   [Apply]     │
      └────────────────────────────────────────────────────┘

    All existing ViewModel hooks preserved — only markup + classes
    changed.
*@

@if (IsVisible)
{
    int extraFileCount = (ShareKeyViewModel.SelectedFilesOrFolders?.Count() ?? 0) - MaxFilesToShow;

    <div class="skd-backdrop" @onclick="Close">
        <div class="skd-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="skd-title"
             @onclick="HideContextMenu"
             @onclick:stopPropagation>

            @* ── Header ─────────────────────────────────────── *@
            <header class="skd-header">
                <div class="skd-header-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="7.5" cy="15.5" r="3.5" />
                        <path d="M10 13l10-10" />
                        <path d="M17 6l3 3" />
                        <path d="M14 9l3 3" />
                    </svg>
                </div>
                <div class="skd-header-text">
                    <h2 id="skd-title" class="skd-title">@Texts.ShareAccessTitle</h2>
                    <p class="skd-sub">
                        @if (ShareKeyViewModel.SubscriptionLevel == SubscriptionLevel.Business)
                        {
                            <span>Share access individually, or use Groups for whole teams.</span>
                        }
                        else
                        {
                            @Texts.ShareKeyInformationText
                        }
                    </p>
                </div>
                <button type="button" class="skd-close" @onclick="Close" aria-label="Close">×</button>
            </header>

            @* ── Business banner — quick path to Groups ────── *@
            @if (ShareKeyViewModel.SubscriptionLevel == SubscriptionLevel.Business)
            {
                <div class="skd-biz-banner" role="note">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="7" r="3" />
                        <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                        <circle cx="17" cy="6" r="2" />
                        <path d="M21 21v-2a4 4 0 00-3-3.86" />
                    </svg>
                    <span class="skd-biz-banner-text">
                        @Texts.GroupInfoText
                        <strong>@Texts.GroupFeatureText</strong>
                        @Texts.YetText
                        <button type="button" class="skd-link" @onclick="ShareKeyViewModel.GoToLearmoreLink">@Texts.LearnMoreLinkLabel</button>
                        @Texts.GroupInfoText1
                        <button type="button" class="skd-link" @onclick="ShareKeyViewModel.GoToCreateGroupLink">@Texts.CreateGroupInfoTexts</button>
                    </span>
                </div>
            }

            <div class="skd-body">

                @* ── Selected files chip strip — each chip has its own
                       × so the user can drop a file from the selection
                       without re-opening the picker. Empty selection
                       auto-closes the whole dialog (see VM). ──────── *@
                @if (ShareKeyViewModel.SelectedFilesOrFolders != null && ShareKeyViewModel.SelectedFilesOrFolders.Any())
                {
                    <div class="skd-files" aria-label="Selected files">
                        @foreach (string file in ShareKeyViewModel.SelectedFilesOrFolders.Take(MaxFilesToShow))
                        {
                            string selectedFileName = GetIconForFile(file);
                            string filePath = file;
                            <div class="skd-file-chip" title="@selectedFileName">
                                <span class="skd-file-chip-icon @Icon" aria-hidden="true"></span>
                                <span class="skd-file-chip-name">@selectedFileName</span>
                                <button type="button"
                                        class="skd-file-chip-remove"
                                        title="Remove file"
                                        aria-label="Remove file"
                                        @onclick="() => ShareKeyViewModel.RemoveSelectedFile(filePath)"
                                        @onclick:stopPropagation>
                                    ×
                                </button>
                            </div>
                        }
                        @if (extraFileCount > 0)
                        {
                            <div class="skd-file-chip skd-file-chip--more" title="@($"+{extraFileCount} more")">
                                +@extraFileCount
                            </div>
                        }
                    </div>
                }

                @* ── Add recipient row ──────────────────────── *@
                <section class="skd-section">
                    <label class="skd-label" for="skd-input">@Texts.AddUserPromptText</label>

                    @if (!string.IsNullOrEmpty(ShareKeyViewModel.ErrorMessage))
                    {
                        <div class="skd-error" role="alert">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8"  x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            <span>@ShareKeyViewModel.ErrorMessage</span>
                        </div>
                    }

                    <form class="skd-add-row" @onsubmit="async () => await ShareKeyViewModel.AddShareKeyUser()">
                        <div class="skd-input-wrap">
                            <svg class="skd-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" />
                                <polyline points="22 6 12 13 2 6" />
                            </svg>
                            <input id="skd-input"
                                   type="text"
                                   class="skd-input"
                                   autocomplete="off"
                                   placeholder="someone@example.com"
                                   @ref="inputRef"
                                   @bind="ShareKeyViewModel.KeySharingUserEmail"
                                   @oninput="SuggestUsers"
                                   @onfocus="ShowSuggestions"
                                   @onkeydown="HandleKeyDown" />

                            @* Inline suggestion popover. Anchored to the
                               input via absolute positioning so it never
                               pushes the layout below. *@
                            @if (ShareKeyViewModel.ShowUserSuggestion
                                 && ShareKeyViewModel.SuggestedUnSharedUsers?.Any() == true)
                            {
                                <ul class="skd-suggestions" id="share-key-suggestion-popup" role="listbox">
                                    @foreach (ShareKeyUser suggestion in ShareKeyViewModel.SuggestedUnSharedUsers)
                                    {
                                        bool isGroup = !string.IsNullOrEmpty(suggestion.GroupName);
                                        string label = isGroup ? suggestion.GroupName! : (suggestion.UserEmail ?? "");
                                        <li class="skd-suggestion"
                                            role="option"
                                            @onclick="() => ShareKeyViewModel.SelectSuggestion(suggestion.GroupName ?? string.Empty, suggestion.UserEmail!)">
                                            <span class="skd-suggestion-avatar @(isGroup ? "skd-suggestion-avatar--group" : "")">
                                                @if (isGroup)
                                                {
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <circle cx="9" cy="7" r="3" />
                                                        <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                                                        <circle cx="17" cy="6" r="2" />
                                                        <path d="M21 21v-2a4 4 0 00-3-3.86" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    @InitialOf(label)
                                                }
                                            </span>
                                            <span class="skd-suggestion-text">@label</span>
                                            @if (isGroup)
                                            {
                                                <span class="skd-suggestion-tag">Group</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <button type="submit"
                                class="skd-btn skd-btn--primary"
                                disabled="@ShareKeyViewModel.DisableAddUserButton">
                            @Texts.AddPromptText
                        </button>
                    </form>
                </section>

                @* ── Shared-with list ──────────────────────── *@
                <section class="skd-section">
                    <div class="skd-list-head">
                        <h3 class="skd-list-title">
                            @string.Format(Texts.SharedKeyUserListTitle,
                                ShareKeyViewModel.ShareKeyUserList?.Count ?? 0)
                        </h3>
                    </div>

                    @if (ShareKeyViewModel.ShareKeyUserList != null && ShareKeyViewModel.ShareKeyUserList.Any())
                    {
                        <ul class="skd-recipient-list" id="sharedUserList">
                            @foreach (ShareKeyUser user in ShareKeyViewModel.ShareKeyUserList!)
                            {
                                string displayName = GetUserDisplayName(user);
                                <li class="skd-recipient">
                                    <span class="skd-recipient-avatar" aria-hidden="true">
                                        @InitialOf(displayName)
                                    </span>
                                    <span class="skd-recipient-name">@displayName</span>
                                    <button type="button"
                                            class="skd-recipient-menu-btn"
                                            aria-label="Recipient options"
                                            @onclick="(e) => ShowContextMenu(e, user.UserEmail!)"
                                            @onclick:stopPropagation>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <circle cx="5"  cy="12" r="1.6" />
                                            <circle cx="12" cy="12" r="1.6" />
                                            <circle cx="19" cy="12" r="1.6" />
                                        </svg>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="skd-empty">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.6"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="8" r="4" />
                                <path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1" />
                            </svg>
                            <p class="skd-empty-title">No one yet</p>
                            <p class="skd-empty-sub">Add an email above to share access.</p>
                        </div>
                    }

                    @* Floating context menu — only one open at a time. *@
                    @if (ShareKeyViewModel.ContextMenu)
                    {
                        <div class="skd-context-menu"
                             style="top: @(posY); left: @(posX);"
                             role="menu">
                            <button type="button" class="skd-context-item" role="menuitem"
                                    @onclick="ShareKeyViewModel.RefreshShare">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="23 4 23 10 17 10" />
                                    <polyline points="1 20 1 14 7 14" />
                                    <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                                </svg>
                                <span>@Texts.RefreshPromptText</span>
                            </button>
                            <button type="button" class="skd-context-item skd-context-item--danger" role="menuitem"
                                    @onclick="() => ShareKeyViewModel.RemoveSharedKey()">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6l-1.5 14a2 2 0 01-2 2H8.5a2 2 0 01-2-2L5 6" />
                                    <path d="M10 11v6M14 11v6" />
                                    <path d="M9 6V4a2 2 0 012-2h2a2 2 0 012 2v2" />
                                </svg>
                                <span>@Texts.UnSharePromptText</span>
                            </button>
                        </div>
                    }
                </section>
            </div>

            @* ── Footer ─────────────────────────────────────── *@
            <footer class="skd-footer">
                <button type="button" class="skd-btn skd-btn--ghost" @onclick="Close">
                    @Texts.ButtonCancelText
                </button>
                @if (ShareKeyViewModel.IsWideScreen)
                {
                    <button type="button" class="skd-btn skd-btn--primary"
                            @onclick="async () => await ShareKeyViewModel.ApplyShareKeys()">
                        @Texts.ApplyLabel
                    </button>
                }
            </footer>
        </div>
    </div>

    @* ── Secondary popups (kept as overlay on the modal) ──── *@
    @if (ShareKeyViewModel.SyncPopup)
    {
        <div class="skd-mini-backdrop" @onclick="ShareKeyViewModel.CloseSyncPopup">
            <div class="skd-mini-modal" @onclick:stopPropagation>
                <h3 class="skd-mini-title">@Texts.SyncContactsText</h3>
                <p class="skd-mini-text">@((MarkupString)string.Format(Texts.AccessYourContactsPhoneText))</p>
                <div class="skd-mini-actions">
                    <button type="button" class="skd-btn skd-btn--ghost" @onclick="ShareKeyViewModel.CloseSyncPopup">No, thanks</button>
                    <button type="button" class="skd-btn skd-btn--primary">Allow</button>
                </div>
            </div>
        </div>
    }

    @if (ShareKeyViewModel.WarngPopup)
    {
        <div class="skd-mini-backdrop" @onclick="ShareKeyViewModel.closeWarngPopup">
            <div class="skd-mini-modal" @onclick:stopPropagation>
                <h3 class="skd-mini-title">@Texts.OhnoText</h3>
                <p class="skd-mini-text">@((MarkupString)string.Format(@Texts.ShareNotEncryptedText))</p>
                <div class="skd-mini-actions" style="justify-content:center">
                    <button type="button" class="skd-btn skd-btn--primary"
                            @onclick="ShareKeyViewModel.closeWarngPopup">
                        @Texts.ButtonCloseText
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool IsVisible;
    private ElementReference inputRef;
    private const int MaxFilesToShow = 3;

    private string posX = "0px";
    private string posY = "0px";

    private string? Icon { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ShareKeyViewModel!.LogOnViewModel.ShareKeyDialog.OnDialogVisibilityChanged += UpdateShareKeyDialogStateChanged;
        ShareKeyViewModel.LogOnViewModel.OnUIStateChanged += UpdateStateChanged;
    }

    public void Dispose()
    {
        if (ShareKeyViewModel != null)
        {
            ShareKeyViewModel.LogOnViewModel.ShareKeyDialog.OnDialogVisibilityChanged -= UpdateShareKeyDialogStateChanged;
            ShareKeyViewModel.LogOnViewModel.OnUIStateChanged -= UpdateStateChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                ShareKeyViewModel!.IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error determining screen width: {ex.Message}");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    private void UpdateShareKeyDialogStateChanged(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    private void UpdateStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetUserDisplayName(ShareKeyUser user) =>
        user.GroupName ?? user.UserEmail!;

    /// <summary>Single capital letter for the avatar circle.</summary>
    private static string InitialOf(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "?" : text.Trim()[..1].ToUpperInvariant();

    private void Close()
    {
        ShareKeyViewModel!.KeySharingUserEmail = "";
        ShareKeyViewModel.SelectedFilesOrFolders = new List<string>();
        ShareKeyViewModel.CloseSyncPopup();
        ShareKeyViewModel.PageResult = DialogResult.Cancel;
        ShareKeyViewModel.LogOnViewModel.ShareKeyDialog.Close();
    }

    private string GetIconForFile(string file)
    {
        string fileName = File.Exists(file)
            ? Path.GetFileName(file)
            : Directory.Exists(file) ? new DirectoryInfo(file).FullName : string.Empty;

        if (ShareKeyViewModel.IsCloudFile)
        {
            fileName = file;
        }

        if (string.IsNullOrEmpty(fileName))
        {
            Icon = string.Empty;
            return string.Empty;
        }

        Icon = fileName.GetIcon();
        return fileName;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ShareKeyViewModel.KeySharingUserEmail))
        {
            ShareKeyViewModel.AddShareKeyUser();
        }
    }

    private async Task ShowSuggestions()
    {
        if (!string.IsNullOrEmpty(ShareKeyViewModel.KeySharingUserEmail))
        {
            ShareKeyViewModel.PerformSearchSuggestions(ShareKeyViewModel.KeySharingUserEmail);
        }
        else
        {
            ShareKeyViewModel.ShowUnSharedUsersSuggestionPopup();
        }

        await JSRuntime.InvokeVoidAsync("registerOutsideClick",
            inputRef, "share-key-suggestion-popup", DotNetObjectReference.Create(this));
    }

    private async Task SuggestUsers(ChangeEventArgs e)
    {
        await ShowSuggestions();
        ShareKeyViewModel.PerformSearchSuggestions(e.Value?.ToString()!.ToLower() ?? string.Empty);
    }

    [JSInvokable]
    public void HideSuggestions()
    {
        ShareKeyViewModel.HideUnSharedUsersSuggestionPopup();
        StateHasChanged();
    }

    private void ShowContextMenu(MouseEventArgs e, string email)
    {
        // Position the floating menu just under the kebab — clamp inside
        // viewport so it never spills off the right edge of the modal.
        posX = $"{Math.Max(e.ClientX - 140, 8)}px";
        posY = $"{e.ClientY + 6}px";
        ShareKeyViewModel.contextMenuPopup(email);
    }

    private void HideContextMenu()
    {
        if (ShareKeyViewModel.ContextMenu)
        {
            ShareKeyViewModel.ContextMenu = false;
        }
    }
}
