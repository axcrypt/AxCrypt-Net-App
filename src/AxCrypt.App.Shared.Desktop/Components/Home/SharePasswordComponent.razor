@implements IDisposable
@using AxCrypt.Api.Model
@using AxCrypt.App.Entitlement.Services
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.UI
@using Microsoft.AspNetCore.Components.Web
@using static AxCrypt.Abstractions.TypeResolve

@inject SecretService SecretService
@inject ViewSecretViewModel ViewSecretViewModel
@inject IStatusAlertService StatusAlertService
@inject IJSRuntime JSRuntime

@*
    SharePasswordComponent — inline "Share Secret" panel.

    Rendered directly inside the password manager view/edit flow
    (same host position as the old ShareSecretComponent) — no backdrop,
    no modal wrapper. The host controls whether to show this section;
    this component simply renders its content when mounted.

    Visually consistent with ShareKeyComponent via the .skd-* tokens,
    but laid out as a flat section rather than a floating dialog.
*@

@if (_vm != null && !_isSharedView)
{
    <div class="spd-panel">

        @* ── Header ─────────────────────────────────────── *@
        <div class="spd-panel-header">
            <div class="spd-panel-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
            </div>
            <div>
                <h3 class="spd-panel-title">@Texts.ShareAccessTitle</h3>
                @if (!string.IsNullOrEmpty(_vm.SharedSecretTitle))
                {
                    <p class="spd-panel-sub">@_vm.SharedSecretTitle</p>
                }
            </div>
        </div>

        @* ── Business banner ─────────────────────────────── *@
        @if (ViewSecretViewModel.HasBusinessSubscription)
        {
            <div class="skd-biz-banner spd-biz-banner" role="note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="7" r="3" />
                    <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                    <circle cx="17" cy="6" r="2" />
                    <path d="M21 21v-2a4 4 0 00-3-3.86" />
                </svg>
                <span class="skd-biz-banner-text">
                    @Texts.GroupInfoText <strong>@Texts.GroupFeatureText</strong> @Texts.YetText
                    <button type="button" class="skd-link" @onclick="ViewSecretViewModel.GoToLearmoreLink">@Texts.LearnMoreLinkLabel</button>
                    @Texts.GroupInfoText1
                    <button type="button" class="skd-link" @onclick="ViewSecretViewModel.GoToCreateGroupLink">@Texts.CreateGroupInfoTexts</button>
                </span>
            </div>
        }
        else
        {
            <p class="spd-info-text">@Texts.ShareSecretInformationText</p>
        }

        @* ── Error ───────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(_vm.ErrorMessage))
        {
            <div class="skd-error" role="alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span>@_vm.ErrorMessage</span>
            </div>
        }

        @* ── Add recipient ───────────────────────────────── *@
        <form class="spd-add-row" @onsubmit="AddUserAsync">
            <div class="skd-input-wrap spd-input-wrap">
                <svg class="skd-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" />
                    <polyline points="22 6 12 13 2 6" />
                </svg>
                <input id="spd-email-input"
                       type="text"
                       class="skd-input"
                       autocomplete="off"
                       placeholder="someone@example.com"
                       @ref="_inputRef"
                       @bind="_vm.SecretSharingUserEmail"
                       @oninput="SuggestUsersAsync"
                       @onfocus="ShowSuggestionsAsync"
                       @onkeydown="HandleKeyDownAsync"
                       disabled="@(!_vm.CanEnableNewShareSecretUserEntry)" />

                @if (_vm.ShowUserSuggestion && _vm.SuggestedUnSharedUsers?.Any() == true)
                {
                    <ul class="skd-suggestions" id="spd-suggestion-popup" role="listbox">
                        @foreach (SecretSharedUserViewModel suggestion in _vm.SuggestedUnSharedUsers)
                        {
                            bool isGroup = !string.IsNullOrEmpty(suggestion.GroupName);
                            string label = isGroup ? suggestion.GroupName! : (suggestion.UserEmail?.Address ?? "");
                            <li class="skd-suggestion"
                                role="option"
                                @onclick="() => _vm.SelectSuggestion(suggestion.GroupName ?? string.Empty, suggestion.UserEmail?.Address ?? string.Empty)">
                                <span class="skd-suggestion-avatar @(isGroup ? "skd-suggestion-avatar--group" : "")">
                                    @if (isGroup)
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="9" cy="7" r="3" />
                                            <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                                            <circle cx="17" cy="6" r="2" />
                                            <path d="M21 21v-2a4 4 0 00-3-3.86" />
                                        </svg>
                                    }
                                    else { @InitialOf(label) }
                                </span>
                                <span class="skd-suggestion-text">@label</span>
                                @if (isGroup) { <span class="skd-suggestion-tag">Group</span> }
                            </li>
                        }
                    </ul>
                }
            </div>

            @* Visibility picker *@
            <div class="spd-visibility-wrap">
                <select class="spd-visibility-select" @bind="_vm.VisibilityType" title="Access duration">
                    @foreach (string v in _vm.VisibilityTypeList ?? Enumerable.Empty<string>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
                <svg class="spd-select-caret" width="12" height="12" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>

            <button type="submit"
                    class="skd-btn skd-btn--primary"
                    disabled="@(!_vm.CanEnableAddShareSecret)">
                @Texts.AddPromptText
            </button>
        </form>

        @* ── Recipients list ─────────────────────────────── *@
        <div class="spd-list-head">
            <span class="skd-list-title">
                @Texts.AddedUsersAccessText (@(_vm.ShareSecretUserList?.Count ?? 0))
            </span>
        </div>

        @if (_vm.ShareSecretUserList != null && _vm.ShareSecretUserList.Any())
        {
            @* position:relative gives the absolute context-menu an anchor *@
            <div class="spd-list-wrap">
                <ul class="skd-recipient-list spd-recipient-list">
                    @foreach (SecretSharedUserViewModel user in _vm.ShareSecretUserList)
                    {
                        string display = string.IsNullOrEmpty(user.GroupName)
                            ? (user.UserEmail?.Address ?? "")
                            : user.GroupName;
                        bool isActive = _vm.CanContextMenuOpened
                                     && _vm.UserEmailForContextMenuAction == user.UserEmail;
                        <li class="skd-recipient spd-recipient @(isActive ? "spd-recipient--active" : "")">
                            <span class="skd-recipient-avatar" aria-hidden="true">@InitialOf(display)</span>
                            <span class="skd-recipient-name">@display</span>
                            <span class="spd-visibility-badge">@user.Visibility</span>
                            <button type="button"
                                    class="skd-recipient-menu-btn"
                                    aria-label="Recipient options"
                                    @onclick="() => _vm.UpdatedSelectedUser(user)"
                                    @onclick:stopPropagation>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="5"  cy="12" r="1.6" />
                                    <circle cx="12" cy="12" r="1.6" />
                                    <circle cx="19" cy="12" r="1.6" />
                                </svg>
                            </button>

                            @* Inline dropdown — only shown for the active row *@
                            @if (isActive)
                            {
                                <div class="spd-row-menu" role="menu" @onclick:stopPropagation>
                                    <button type="button"
                                            class="skd-context-item skd-context-item--danger spd-row-menu-item"
                                            role="menuitem"
                                            @onclick="_vm.RemoveSelectedSharedUser">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1.5 14a2 2 0 01-2 2H8.5a2 2 0 01-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4a2 2 0 012-2h2a2 2 0 012 2v2" />
                                        </svg>
                                        <span>@Texts.UnSharePromptText</span>
                                    </button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="skd-empty spd-empty">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
                <p class="skd-empty-title">No one yet</p>
                <p class="skd-empty-sub">Add an email above to share access.</p>
            </div>
        }

        @* ── Apply ───────────────────────────────────────── *@
        <div class="spd-apply-row">
            <button type="button"
                    class="skd-btn skd-btn--primary @(_isApplying ? "spd-btn--loading" : "")"
                    disabled="@(!_vm.EnableApplyButton || _isApplying)"
                    @onclick="ApplyAsync">
                @if (_isApplying)
                {
                    <span class="spd-spinner" aria-hidden="true"></span>
                    <span>Applying…</span>
                }
                else
                {
                    @Texts.ApplyLabel
                }
            </button>
        </div>

    </div>
}

<style>
    /* ── Panel shell ─────────────────────────────────────── */
    .spd-panel {
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.25rem;
        background: #fff;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* ── Header ──────────────────────────────────────────── */
    .spd-panel-header { display: flex; align-items: flex-start; gap: 10px; }
    .spd-panel-icon {
        width: 36px; height: 36px; border-radius: 8px;
        background: #fef3c7; color: #d97706;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .spd-panel-title { font-size: 0.95rem; font-weight: 700; color: #111; margin: 0; }
    .spd-panel-sub   { font-size: 0.78rem; color: #6b7280; margin: 2px 0 0; }

    /* ── Business banner ─────────────────────────────────── */
    .spd-biz-banner { margin: 0; }
    .spd-info-text  { font-size: 0.82rem; color: #6b7280; margin: 0; }

    /* ── Add row ─────────────────────────────────────────── */
    .spd-add-row    { display: flex; gap: 8px; align-items: flex-start; flex-wrap: wrap; }
    .spd-input-wrap { flex: 1; min-width: 160px; }

    /* ── Visibility select ───────────────────────────────── */
    .spd-visibility-wrap {
        position: relative; display: inline-flex; align-items: center; flex-shrink: 0;
    }
    .spd-visibility-select {
        appearance: none; -webkit-appearance: none;
        height: 38px; padding: 0 2rem 0 0.75rem;
        border: 1.5px solid #d1d5db; border-radius: 8px;
        background: #fff; font-size: 0.82rem; color: #374151;
        cursor: pointer; outline: none; transition: border-color 0.2s;
    }
    .spd-visibility-select:focus { border-color: #16a34a; }
    .spd-select-caret { position: absolute; right: 8px; pointer-events: none; color: #9ca3af; }

    /* ── List header ─────────────────────────────────────── */
    .spd-list-head { display: flex; align-items: center; justify-content: space-between; }

    /* ── Recipient list wrapper ──────────────────────────── */
    .spd-list-wrap { position: relative; }

    /* Override the base 3-column grid to 4 columns:
       avatar | name | visibility-badge | kebab              */
    .spd-recipient-list .spd-recipient {
        display: grid;
        grid-template-columns: 36px 1fr auto 32px;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        position: relative;   /* anchor for the inline row-menu */
    }

    /* Visibility badge — sits in its own grid column, no margin tricks */
    .spd-visibility-badge {
        font-size: 0.7rem; font-weight: 600;
        background: #f3f4f6; color: #6b7280;
        border-radius: 20px; padding: 2px 8px;
        white-space: nowrap; justify-self: end;
    }

    /* Highlight the active (menu-open) row */
    .spd-recipient--active { background: #fafafa; }

    /* ── Inline row dropdown ─────────────────────────────── */
    /* Spans the full 4-column grid (grid-column: 1 / -1) so it appears
       as a full-width sub-row directly under the active recipient,
       without breaking the list layout or requiring position:absolute. */
    .spd-row-menu {
        grid-column: 1 / -1;
        border-top: 1px solid #f3f4f6;
        padding-top: 4px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .spd-row-menu-item {
        width: 100%;
        border-radius: 6px;
        font-size: 12.5px;
        padding: 6px 10px;
    }

    /* ── Empty state ─────────────────────────────────────── */
    .spd-empty { padding: 0.75rem 0; }

    /* ── Apply row ───────────────────────────────────────── */
    .spd-apply-row { display: flex; justify-content: flex-end; }

    /* ── Spinner ─────────────────────────────────────────── */
    .spd-btn--loading { opacity: 0.8; pointer-events: none; }
    .spd-spinner {
        width: 13px; height: 13px;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: #fff; border-radius: 50%;
        animation: spd-spin 0.7s linear infinite;
        display: inline-block;
    }
    @@keyframes spd-spin { to { transform: rotate(360deg); } }
</style>

@code {
    private ShareSecretViewModel? _vm;
    private ElementReference _inputRef;
    private bool _isSharedView;
    private bool _isApplying;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _vm = new ShareSecretViewModel(SecretService);
        _vm.OnUpdateViewState += OnViewModelChanged;

        // Read-only view: the secret was shared WITH this user (not by them).
        // Match the same guard the original ShareSecretComponent used.
        _isSharedView = SecretService.CurrentSecret?.SharedWith != null
                     && SecretService.CurrentSecret.OwnerEmail != ViewSecretViewModel.UserEmail;
    }

    public void Dispose()
    {
        if (_vm != null)
            _vm.OnUpdateViewState -= OnViewModelChanged;
    }

    private void OnViewModelChanged() => InvokeAsync(StateHasChanged);

    // ── Add / Apply ──────────────────────────────────────────────────
    private async Task AddUserAsync() => await _vm!.AddUserToSharedListAsync();

    private async Task ApplyAsync()
    {
        if (_isApplying) return;
        _isApplying = true;
        try
        {
            bool ok = await _vm!.ApplyShareSecret();
            if (ok)
            {
                await New<UserEntitlementService>()
                    .InsertUserUsageCount(LimitedCapability.ShareSecret,
                                          New<AccountStatusViewModel>().SubscriptionLevel);
                StatusAlertService.Success(Texts.ShareSecretSuccess);
                _vm.EnableApplyButton = false;
            }
        }
        finally
        {
            _isApplying = false;
        }
    }

    // ── Suggestions ──────────────────────────────────────────────────
    private async Task ShowSuggestionsAsync()
    {
        if (!string.IsNullOrEmpty(_vm!.SecretSharingUserEmail))
            _vm.PerformSearch(_vm.SecretSharingUserEmail);
        else
            _vm.ShowUnSharedUsersSuggestionPopup();

        await JSRuntime.InvokeVoidAsync("registerOutsideClick",
            _inputRef, "spd-suggestion-popup", DotNetObjectReference.Create(this));
    }

    private async Task SuggestUsersAsync(ChangeEventArgs e)
    {
        await ShowSuggestionsAsync();
        _vm!.PerformSearch(e.Value?.ToString()?.ToLower() ?? string.Empty);
    }

    [JSInvokable]
    public void HideSuggestions()
    {
        _vm!.HideUnSharedUsersSuggestionPopup();
        StateHasChanged();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_vm!.SecretSharingUserEmail))
            await _vm.AddUserToSharedListAsync();
    }

    // ── Helpers ──────────────────────────────────────────────────────
    private static string InitialOf(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "?" : text.Trim()[..1].ToUpperInvariant();
}
