@using AxCrypt.Api.Model
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Providers
@using AxCrypt.App.Shared.Services
@using AxCrypt.Core.UI
@using AxCrypt.Content

@inject SubActionViewModel? subActionModel
@inject NavigationManager Navigation
@inject FileDropService FileDropService

<div class="mre-act-sec">
    @if (subActionModel!.EnableVault)
    {
        <div id="help-vault" style="display:block;">
            <h3 class="fle-nme fnt-sze">@Texts.VaultText</h3>
            <div title="@Texts.VaultText">
                <button @onclick="ValidateVaultNavigation"
                        class="vlt-action-btn">
                    <img class="vlt-icon" alt="Vault" />
                </button>
            </div>
        </div>
    }
    @if (subActionModel!.EnableCloudServices)
    {
        <div id="help-cloud-services" style="display:block;">
            <h3 class="fle-nme fnt-sze">@Texts.CloudServicesText</h3>
            <div style="display: flex;">
                @foreach (FileProviderItem provider in subActionModel.FileProviderViewModel.EncryptableFileProviders)
                {
                    <div title="@provider.Name">
                        <button @onclick="() => subActionModel.FileProviderViewModel.SubActionSelectProvider(provider)"
                                class="assets-box"
                                style="background-color:@(_ENABLEDTOOLSTRIPBACKCOLOR)">
                            <img class="@provider.Image" style="width:32px;height:32px;" src="" alt="@provider.Name" title="@provider.Name" />
                        </button>
                    </div>
                }

                <AxCrypt.App.Shared.Desktop.Components.FilePicker.FilePickerComponent />
            </div>
        </div>
    }
    <div class="medium-7" style="display:block;">
        <h3 class="fle-nme fnt-sze">@Texts.MoreActionsText</h3>
        <div style="display: flex; gap: 2%;">
            @if (subActionModel.EnableRandomRename)
            {
                <div id="help-anymous-rename" class="mre-actn-box" @onclick="(e)=> subActionModel.RandomRenameAsync(e)" title="@Texts.AnonymousRenameToolTip">
                    <img class="ico-eye-sml" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.AnonymousRenameMenuText</span>
                </div>
            }
            else
            {
                <div class="mre-actn-box atn-bgclr" @onclick="subActionModel.AlwaysOfflineForFreeUser" title="@Texts.AlwaysOfflineToolTip">
                    <img class="ico-offln" src="" alt="hand-img" />
                    <span class="text-size text-style">@subActionModel.SetInternetStateText()</span>
                </div>
            }

            @if (subActionModel.EnableSecureWipeFiles)
            {
                <div id="help-secure-dlt" class="mre-actn-box" @onclick="(e)=> subActionModel.SecureWipeFiles(e)" title="@Texts.FeaturesFileWipeDescription">
                    <img class="ico-dlt" src="" alt="secured-delete-img" />
                    <span class="text-size text-style">@Texts.SecureDeleteToolStripMenuItemText</span>
                </div>

                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.ConfirmWipeDialog />
            }
            else
            {
                <div id="help-secure-dlt" class="mre-actn-box atn-bgclr paid-plan-required" style="background-color: #D9D9D9 !important;" @onclick="() => subActionModel.UpgradeDialog()">
                    <img class="ico-dlt" src="" alt="secured-delete-img" style="filter: brightness(2);" />
                    <span class="text-size text-style" style="color: white !important;">@Texts.SecureDeleteToolStripMenuItemText</span>
                    <img class="nav-subs-upg" src="" alt="paid_required_img" style="padding-right:0px !important;" />
                </div>
            }

            @if (subActionModel.EnableEncryptionUpgrade)
            {
                <div id="help-upgrade-files" class="mre-actn-box" @onclick="(e)=> subActionModel.EncryptionUpgrade(e)" title="@Texts.UpgradeLegacyFilesMenuToolTip">
                    <img class="ico-apikey" src="" alt="upgrade-enc-img" />
                    <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                </div>
            }
            else
            {
                <div id="help-upgrade-files" class="mre-actn-box atn-bgclr paid-plan-required" style="background-color: #D9D9D9 !important;" @onclick="() => subActionModel.UpgradeDialog()">
                    <img class="ico-apikey" src="" alt="upgrade-enc-img" style="filter: brightness(2);" />
                    <span class="text-size text-style" style="color: white !important;">@Texts.UpgradeLegacyFilesMenuItemText</span>
                    <img class="nav-subs-upg" src="" alt="paid_required_img" style="padding-right:0px !important;" />
                </div>
            }
            @* <div class="mre-actn-box fade-clr" style="border:dotted;">
            <span class="text-size text-style">Add action to the Home</span>
            </div> *@
        </div>
    </div>
</div>


@code {
    public const string _ENABLEDTOOLSTRIPBACKCOLOR = "#FFFFFF";

    protected override void OnInitialized()
    {
        new SubActionViewModel();
        subActionModel!.OnUpdateViewState += UpdateState;
        base.OnInitialized();
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private async Task ValidateVaultNavigation()
    {
        bool isValid = await subActionModel.ValidateVaultPath();
        if (isValid)
        {
            FileDropService.CurrentPage = "/vault";
            Navigation.NavigateTo("/vault");
        }
    }
}