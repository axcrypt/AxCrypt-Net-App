@using AxCrypt.Api.Model
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.Core.UI
@using AxCrypt.Content

@inject SubActionViewModel? subActionModel

<div class="mre-act-sec">
    @if (subActionModel!.EnableCloudServices)
    {
        <div style="display:block;">
            <h3 class="fle-nme fnt-sze">Cloud services</h3>
            <div style="display: flex;">
                @foreach (KnownFolder? knownFolder in subActionModel?.KnownFoldersViewModel?.KnownFolders!)
                {
                    <div title="@knownFolder.DisplayName">
                        <button @onclick="() => subActionModel.OnCloudServiceButtonClick(knownFolder)"
                                class="assets-box"
                                style="background-color:@(knownFolder.Enabled ? _ENABLEDTOOLSTRIPBACKCOLOR : subActionModel.DisabledBackColor)">
                            <img class="icon @subActionModel.GetIconClass(knownFolder.My.FullName)" style="width:32px;height:32px;" src="" alt="@knownFolder.DisplayName" />
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    <div class="medium-9" style="display:block;">
        <h3 class="fle-nme fnt-sze">More actions</h3>
        <div style="display: flex; gap: 2%;">
               @if (subActionModel.EnableRandomRename)
               {
                  <div class="mre-actn-box" @onclick="(e)=> subActionModel.RandomRenameAsync(e)" title="@Texts.AnonymousRenameToolTip">
                    <img class="ico-eye-sml" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.AnonymousRenameMenuText</span>
                  </div>
               }
               else
               {
                   <div class="mre-actn-box atn-bgclr" @onclick="subActionModel.AlwaysOfflineForFreeUser" title="@Texts.AlwaysOfflineToolTip">
                     <img class="ico-offln" src="" alt="hand-img" />
                     <span class="text-size text-style">@Texts.AlwaysOffline</span>
                  </div>
                }

                @if(subActionModel.EnableSecureWipeFiles)
                {
                    <div class="mre-actn-box" @onclick="(e)=> subActionModel.SecureWipeFiles(e)" title="@Texts.FeaturesFileWipeDescription">
                         <img class="ico-dlt" src="" alt="hand-img" />
                         <span class="text-size text-style">@Texts.SecureDeleteToolStripMenuItemText</span>
                    </div>
                }
                else
                {
                   <div class="mre-actn-box atn-bgclr" @onclick="(e)=>subActionModel.InviteUser(e)" title="@Texts.InviteUserToolStripMenuItemText">
                     <img class="ico-invtfrd" src="" alt="hand-img" />
                     <span class="text-size text-style">Invite friend</span>
                   </div>
                }

                @if(subActionModel.EnableEncryptionUpgrade)
                {
                  <div class="mre-actn-box" @onclick="(e)=> subActionModel.EncryptionUpgrade(e)" title="@Texts.UpgradeLegacyFilesMenuToolTip">
                    <img class="ico-apikey" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                  </div>
                }
                else
                {
                  <div class="mre-actn-box atn-bgclr" @onclick="()=> subActionModel.UpgradeDialog()">
                     <img class="ico-apikey" src="" alt="hand-img" />
                     <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                  </div>
                }
               @* <div class="mre-actn-box fade-clr" style="border:dotted;">
            <span class="text-size text-style">Add action to the Home</span>
            </div> *@
        </div>
    </div>
</div>


@code {
    public const string _ENABLEDTOOLSTRIPBACKCOLOR = "#FFFFFF";

    protected override void OnInitialized()
    {
        new SubActionViewModel();
        subActionModel!.OnUpdateViewState += UpdateState;
        base.OnInitialized();
    }
  
    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}