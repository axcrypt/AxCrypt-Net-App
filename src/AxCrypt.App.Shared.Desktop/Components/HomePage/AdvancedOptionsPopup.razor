@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content
@using Dropbox.Api.Files
@using SecureApp.Models

@inject NavigationManager Navigation
@inject VaultSettingsViewModel VaultSettingsViewModel
@inject UserService userService
@inject PaidFeaturegateService paidFeaturegateService
@inject AppSettingsViewModel AppSettingsViewModel
@inject AxCrypt.App.Shared.ViewModels.LogOnViewModel LogOnViewModel
@implements IDisposable

<div class="adv-backdrop" @onclick="HandleBackdropClick">
    <div class="adv-panel" @onclick:stopPropagation>

        <!-- ── Header ── -->
        <div class="adv-header">
            <button class="adv-back-btn" @onclick="OnClose" title="Back to Settings">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <div class="adv-header-text">
                <h2 class="adv-title">@Texts.AdvancedOptionsTitle</h2>
                <p class="adv-subtitle">@Texts.AdvancedOptionsSubTitle</p>
            </div>
        </div>

        <!-- ── Scrollable body ── -->
        <div class="adv-body">

            <!-- ── SECTION: Configuration nav items ── -->
            <div class="adv-section-label">@Texts.AdvancedOptionsConfiguration</div>

            @foreach (AdvancedNavItem nav in NavItems)
            {
                bool locked = IsLocked(nav.IsPaid);
                <button class="adv-nav-row @(locked ? "adv-nav-row--locked" : "")"
                        @onclick="async () => await OnNavClick(nav)">
                    <div class="adv-nav-icon" style="background:@nav.IconBg">
                        @((MarkupString)nav.IconSvg)
                    </div>
                    <div class="adv-nav-body">
                        <span class="adv-nav-label">@nav.Label</span>
                        <span class="adv-nav-desc">@nav.Description</span>
                    </div>
                    @if (locked)
                    {
                        <span class="nav-lock-icon" title="Locked — click to upgrade" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                        </span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" class="adv-nav-arrow">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    }
                </button>
            }

            <!-- Divider -->
            <div class="adv-divider"></div>

            <!-- ── SECTION: Diagnostics toggles ── -->
            <div class="adv-section-label">@((MarkupString)Texts.AdvancedDiagnosticsText)</div>

            @foreach (AdvancedToggleItem tog in DiagnosticToggles)
            {
                bool togLocked = IsLocked(tog.IsPaid);
                <div class="adv-toggle-row @(tog.IsOn && !togLocked ? "adv-toggle-row--on" : "") @(togLocked ? "adv-toggle-row--locked" : "")"
                     @onclick="() => OnToggleRowClick(tog)">
                    <div class="adv-row-icon" style="background:@tog.IconBg">
                        @((MarkupString)tog.IconSvg)
                    </div>
                    <div class="adv-row-body">
                        <span class="adv-row-label">@tog.Label</span>
                        <span class="adv-row-desc">@tog.Description</span>
                    </div>
                    @if (togLocked)
                    {
                        <span class="nav-lock-icon" title="Locked — click to upgrade" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                        </span>
                    }
                    else
                    {
                        <button class="adv-toggle @(tog.IsOn ? "adv-toggle--on" : "") @(togLocked ? "adv-toggle--locked" : "")"
                            @onclick:stopPropagation="!togLocked"
                            @onclick="() => { if (!togLocked) { ToggleItem(tog); InvokeAsync(StateHasChanged); } }"
                            title="@(togLocked ? "Locked — click to upgrade" : (tog.IsOn ? "Turn off" : "Turn on"))"
                            aria-pressed="@tog.IsOn.ToString().ToLower()">
                            <span class="adv-toggle-knob"></span>
                            <span class="adv-toggle-label" aria-hidden="true" title="@(tog.IsOn ? Texts.ONText : Texts.OFFText)">@(tog.IsOn ? "I" : "O")</span>
                        </button>
                    }
                </div>

                @if (tog.ShowWarning && tog.IsOn && !togLocked)
                {
                    <div class="adv-warning-callout">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        <span>@Texts.AdvancedDebugWarningText</span>
                    </div>
                }
            }
        </div>

        <!-- ── Footer ── -->
        <div class="adv-footer">
            <span class="adv-footer-hint">@Texts.AdvancedFooterHintText</span>
            <button class="adv-done-btn" @onclick="OnClose">@Texts.DoneTitle</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // The toggle rows render off AppSettingsViewModel.EnableUserActivity /
        // EnableFindFiles / EnableDebugPopup. Those getters read straight
        // from UserSettings and the toggle methods broadcast UIStateChanged
        // — listen for it so the ON/OFF state and any dependent rows
        // re-paint immediately after a flip.
        LogOnViewModel.OnUIStateChanged += OnAppUiStateChanged;
    }

    private void OnAppUiStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LogOnViewModel.OnUIStateChanged -= OnAppUiStateChanged;
    }

    private void HandleBackdropClick() => OnClose.InvokeAsync();
    private void ToggleItem(AdvancedToggleItem navItem)
    {
        navItem.IsOn = !navItem.IsOn;
        if (navItem.Id == "activity-logs")
        {
            AppSettingsViewModel.ToggleUserActivity();
            return;
        }
        if (navItem.Id == "find-files")
        {
            AppSettingsViewModel.ToggleFindFiles();
            return;
        }
        if (navItem.Id == "debug-mode")
        {
            AppSettingsViewModel.ToggleDebug();
            return;
        }
    }

    // Single source of truth for the lock decision — same shape as
    // the Quick Action gate. A row is locked when it's flagged paid
    // AND the user is on the free tier. App Configuration stays open
    // regardless of tier (no IsPaid flag in its catalog entry).
    private bool IsLocked(bool isPaid) => isPaid && userService.IsFreeTier;

    private async Task OnNavClick(AdvancedNavItem nav)
    {
        if (IsLocked(nav.IsPaid))
        {
            await OnClose.InvokeAsync();
            paidFeaturegateService.ShowPaidGate(nav.Label, nav.Description, nav.PaidPerks);
            return;
        }

        if (nav.Id == "vault-settings")
        {
            AxCServiceProvider.GetService<VaultSettingsViewModel>().VaultSettingsDialog.Show();
            return;
        }
        if (nav.Id == "app-config")
        {
            AxCServiceProviderExtension.LogOnViewModel!.AdvancedOptionsDialog.Show();
            return;
        }

        await Task.CompletedTask;
    }

    /// <summary>Toggle row click — paid rows redirect to the gate; others toggle as usual.</summary>
    private void OnToggleRowClick(AdvancedToggleItem tog)
    {
        if (IsLocked(tog.IsPaid))
        {
            OnClose.InvokeAsync();
            paidFeaturegateService.ShowPaidGate(tog.Label, tog.Description, tog.PaidPerks);
            return;
        }

        ToggleItem(tog);
    }

    // ── Configuration nav items ────────────────────────────────
    private List<AdvancedNavItem> NavItems = new()
    {
        new()
        {
            Id = "app-config", Label = Texts.AppConfigurationText, Route = "/settings/app",
            Description = Texts.AppConfigurationDescription,
            IconBg = "#f5f3ff",
            IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#7c3aed' stroke-width='2'>
                <circle cx='12' cy='12' r='3'/>
                <path d='M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2'/>
            </svg>"
        },
        new()
        {
            Id = "vault-settings", Label = Texts.VaultSettingsTitle, Route = "/settings/vault",
            Description = Texts.VaultSettingsDescription,
            IconBg = "#fff7ed",
            IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#d97706' stroke-width='2'>
                <rect x='3' y='11' width='18' height='11' rx='2'/>
                <path d='M7 11V7a5 5 0 0110 0v4'/>
                <circle cx='12' cy='16' r='1' fill='#d97706'/>
            </svg>",
            // Vault is a paid feature — free users see the lock badge
            // and clicking the row opens the paid-gate popup.
            IsPaid = true,
            PaidPerks = new[]
            {
                Texts.SecureEncryptedVaultPopup,
                Texts.AutolockOnInactivityPopup,
                Texts.ScheduledVaultBackupsPopup,
                Texts.UnlimitedVaultEntriesPopup,
            },
        },
    };

    // ── Diagnostics toggle items ───────────────────────────────
    // Both rows are paid features — free users see a lock badge.

    private List<AdvancedToggleItem> DiagnosticToggles
    {
        get
        {
            return ListDiagnosticToggles();
        }
    }

    private List<AdvancedToggleItem> ListDiagnosticToggles()
    {
        return new List<AdvancedToggleItem>()
        {
            new() {
                Id = "activity-logs", Label = Texts.UserActivitiesText, IsOn = AppSettingsViewModel.EnableUserActivity,
                Description = Texts.UserActivitiesDescription,
                IconBg = "#dbeafe",
                IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#2563eb' stroke-width='2'>
                    <path d='M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2'/>
                    <circle cx='12' cy='7' r='4'/>
                </svg>",
                // IsPaid = true,
                // PaidPerks = new[]
                // {
                //     "Full audit trail of file operations",
                //     "Search and filter activity by date / type",
                //     "Export logs for compliance",
                //     "Forensic-grade encryption events",
                // },
            },
            new() {
                Id = "find-files", Label = Texts.FindFileFeatureTitle, IsOn = AppSettingsViewModel.EnableFindFiles,
                Description = Texts.FindFilesFeatureDescription,
                IconBg = "#dbeafe",
                IconSvg = @"<img src='' class='ico-findencpt-files' width='18' height='18' title='ico-findencpt-files' style='object-fit:contain;' alt='find files ico'>",
                IsPaid = true,
                PaidPerks = new[]
                {
                    Texts.FindEncryptedFilesQuicklyPopup,
                    Texts.ViewAndManageFileReferencesPopup,
                    Texts.RenameDeleteOrDecryptFilesPopup,
                    Texts.UnlockAdvancedFileManagementPopup
                },
            },
            new() {
                Id = "debug-mode", Label = Texts.DebugModeTitle, IsOn = AppSettingsViewModel.EnableDebugPopup, ShowWarning = true,
                Description = Texts.DebugModeDescription,
                IconBg = "#f5f3ff",
                IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#7c3aed' stroke-width='2'>
                    <polyline points='16 18 22 12 16 6'/>
                    <polyline points='8 6 2 12 8 18'/>
                </svg>",
                // IsPaid = true,
                // PaidPerks = new[]
                // {
                //     "Verbose runtime logging",
                //     "Crash report capture",
                //     "Priority support attaches logs automatically",
                // },
            },
        };
    }
}
