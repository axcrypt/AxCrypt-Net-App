@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.FileBrowser
@using AxCrypt.App.Shared.Providers
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.Content

@inject UserService userService
@inject CloudDriveViewModel cloudDriveViewModel
@inject PaidFeaturegateService paidFeaturegateService
@inject NavigationManager Navigation

<!-- Cloud Drives — compact home-card summary, "Manage" opens the dedicated CloudManagerPopup. -->
<section class="card">
    <div class="card-hdr">
        <h2 class="section-title">@Texts.CloudServicesText</h2>
        @if (userService.IsFreeTier)
        {
            <span class="pro-pill" @onclick="ShowUpgradePopup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg></span>
        }
        else
        {
            <button class="cd-manage-link" @onclick="OpenManager" title="Open Cloud Manager">
                @Texts.BusinessSubscriptionManageMenu
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </button>
        }
    </div>

    <div class="cloud-body @(userService.IsFreeTier ? "blurred" : "")">
        @foreach (FileProviderItem provider in cloudDriveViewModel!.FileProviderViewModel.EncryptableFileProviders)
        {
            bool isConnected = cloudDriveViewModel.IsConnected(provider);
            <div class="drive-row">
                <img class="drive-icon @provider.Image" src="" alt="@provider.Name" title="@provider.Name" />
                <div class="drive-info">
                    <span class="drive-name">@provider.Name</span>

                    @if (isConnected)
                    {
                        <span class="connected-badge">@Texts.CloudServicesConnectedText</span>
                    }
                </div>

                @{
                    string cloudDriveActionLabel = isConnected ? Texts.CloudServicesManageFilesText : Texts.CloudServicesConnectText;
                }

                <button class="connect-btn" @onclick="async () => await OnRowAction(provider)">@cloudDriveActionLabel</button>
            </div>
        }
    </div>

    @* <AxCrypt.App.Shared.Desktop.Components.FilePicker.FilePickerComponent /> *@

    <AxCrypt.App.Shared.Desktop.Components.HomePage.CloudManagerPopup
        IsOpen="@_managerOpen"
        OnClose="CloseManager" />
</section>

@code {
    protected override void OnInitialized()
    {
        cloudDriveViewModel.FileProviderViewModel.OnUpdateViewState += async () => await InvokeAsync(StateHasChanged);
        base.OnInitialized();
    }

    private bool _managerOpen;
    private void OpenManager()  => _managerOpen = true;
    private void CloseManager() => _managerOpen = false;

    // Delegate row action to ViewModel; navigate when it returns a route.
    private async Task OnRowAction(FileProviderItem provider)
    {
        string? route = await cloudDriveViewModel.HandleRowActionAsync(provider);
        if (route != null)
        {
            Navigation.NavigateTo(route);
        }
    }

    // Delegate upgrade popup to ViewModel.
    private void ShowUpgradePopup() => cloudDriveViewModel.ShowUpgradePopup();
}

<style>
    /* "Manage" link in the card header — small chevron pill matching
       the existing card-hdr typography. Self-contained so the card
       picks up the link without an SCSS rebuild. */
    .cd-manage-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: transparent;
        border: none;
        font-size: 12px;
        font-weight: 600;
        color: #48772C;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 6px;
        transition: background .12s;
    }
    .cd-manage-link:hover { background: rgba(72,119,44,.10); }

    html[data-theme="dark"] .cd-manage-link        { color: #b8e89a; }
    html[data-theme="dark"] .cd-manage-link:hover  { background: rgba(127,204,92,.14); }
</style>