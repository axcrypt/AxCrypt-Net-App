@using AxCrypt.App.Shared.Desktop.ViewModels.FileBrowser
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Providers
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content

@inject SubActionViewModel? subActionModel

@inject CloudDriveViewModel cloudDrive
@inject UserService userService
@inject NavigationManager Navigation
@inject DesktopFilePickerViewModel filePickerViewModel

@if (IsOpen)
{
    <div class="cm-scrim" @onclick="Close">
        <div class="cm-card" @onclick:stopPropagation role="dialog" aria-modal="true" aria-labelledby="cm-title">

            <header class="cm-head">
                <div class="cm-head-text">
                    <h2 id="cm-title" class="cm-title">@Texts.CloudServicesText</h2>
                    <p class="cm-sub">@((MarkupString)Texts.CloudServicesSubTitle)</p>
                </div>
                <button class="cm-x" type="button" @onclick="Close" aria-label="Close">×</button>
            </header>

            <div class="cm-body">
                @if (subActionModel?.FileProviderViewModel.EncryptableFileProviders is { } providers && providers.Any())
                {
                    @foreach (FileProviderItem provider in providers)
                    {
                        bool isConnected = cloudDrive.IsConnected(provider);
                        <article class="cm-provider @(isConnected ? "cm-provider--linked" : "")">
                            <div class="cm-prov-icon">
                                <img class="@provider.Image" src="" alt="@provider.Name" />
                            </div>

                            <div class="cm-prov-body">
                                <div class="cm-prov-name-row">
                                    <span class="cm-prov-name">@provider.Name</span>
                                    @if (isConnected)
                                    {
                                        <span class="cm-status cm-status--ok">
                                            <span class="cm-status-dot" aria-hidden="true"></span>
                                            @Texts.CloudServicesConnectedText
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cm-status cm-status--off">@Texts.CloudServicesNotConnectedText</span>
                                    }
                                </div>
                                <p class="cm-prov-help">@HelpFor(provider)</p>
                            </div>

                            <div class="cm-prov-actions">
                                @if (isConnected)
                                {
                                    <button type="button"
                                            class="cm-btn cm-btn--primary"
                                            @onclick="() => OnBrowse(provider)">
                                        @Texts.BrowseFilesText
                                    </button>
                                    <button type="button"
                                            class="cm-btn cm-btn--ghost"
                                            title="Sign out of this account"
                                            @onclick="() => OnDisconnect(provider)">
                                        @Texts.CloudServicesDisconnectText
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="cm-btn cm-btn--primary"
                                            @onclick="() => OnConnect(provider)">
                                        @Texts.CloudServicesConnectText
                                    </button>
                                }
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="cm-empty">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.6">
                            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
                        </svg>
                        <p>@Texts.NoCloudServicesText</p>
                    </div>
                }
            </div>

            <footer class="cm-foot">
                <span class="cm-foot-hint">@Texts.CloudServicesFooter</span>
                <button type="button" class="cm-btn cm-btn--ghost" @onclick="Close">@Texts.DoneTitle</button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    private static string HelpFor(FileProviderItem provider)
    {
        return provider.Value switch
        {
            AxCrypt.Core.IO.FileProvider.GoogleDrive
                => Texts.CloudServicesGoogleDriveHelpText,
            AxCrypt.Core.IO.FileProvider.DropBox
                => Texts.CloudServicesDropBoxHelpText,
            AxCrypt.Core.IO.FileProvider.OneDrive
                => Texts.CloudServicesOneDriveHelpText,
            AxCrypt.Core.IO.FileProvider.PhoneBrowser
                => Texts.CloudServicesPhoneBrowserHelpText,
            AxCrypt.Core.IO.FileProvider.Local
                => Texts.CloudServicesLocalHelpText,
            _ => Texts.CloudServicesLocalHelpText1,
        };
    }

    private async Task OnConnect(FileProviderItem provider)
    {
        await subActionModel!.FileProviderViewModel.SubActionSelectProvider(provider);
        filePickerViewModel.IsVisible = false;
        await Close();

        if (cloudDrive.IsConnected(provider))
        {
            Navigation.NavigateTo("/cloudbrowser");
        }
    }

    private async Task OnBrowse(FileProviderItem provider)
    {
        await subActionModel!.FileProviderViewModel.SubActionSelectProvider(provider);
        filePickerViewModel.IsVisible = false;
        await Close();

        if (cloudDrive.IsConnected(provider))
        {
            Navigation.NavigateTo("/cloudbrowser");
        }
    }

    private async Task OnDisconnect(FileProviderItem provider)
    {
        cloudDrive.DisconnetCloudService(provider);
        await InvokeAsync(StateHasChanged);
    }
}

