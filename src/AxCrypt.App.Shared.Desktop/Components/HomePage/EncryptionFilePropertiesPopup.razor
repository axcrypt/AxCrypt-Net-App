@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.Content
@using SecureApp.Models

@inject AppSettingsViewModel appSettingsViewModel
@inject PopupService popupService
@inject PaidFeaturegateService paidFeaturegateService
@inject AppSettingsViewModel SettingsViewModel

<div class="efp-backdrop" @onclick="HandleBackdropClick">
    <div class="efp-panel" @onclick:stopPropagation>

        <!-- ── Header ── -->
        <div class="efp-header">
            <button class="efp-back-btn" @onclick="OnClose" title="Back to Settings">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>
            <div class="efp-header-text">
                <h2 class="efp-title">@Texts.FilePropertiesToolStripMenuItemText</h2>
                <p class="efp-subtitle">@Texts.FilePropertiesSubTitle</p>
            </div>
        </div>

        <!-- ── Info callout ── -->
        <div class="efp-callout efp-callout--blue">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>@((MarkupString)Texts.FilePropertiesInfoText)</span>
        </div>

        <!-- ── Scrollable body ── -->
        <div class="efp-body">

            <!-- Section: Sortable Columns -->
            <div class="efp-section-label">@Texts.FilePropertiesSortableColumns</div>

            @foreach (FilePropertyItem item in ColumnItems)
            {
                bool locked = !item.IsEnable;
                <div class="efp-row @(item.IsToggled ? "efp-row--on" : "") @(locked ? "sm-toggle-row--locked" : "")"
                     @onclick="() => ToggleItem(item)">
                    <div class="efp-row-icon nam-icon-bg">
                        @((MarkupString)item.IconSvg)
                    </div>
                    <div class="efp-row-body">
                        <span class="efp-row-label">@item.Label</span>
                        <span class="efp-row-desc">@item.Description</span>
                    </div>
                    @if (item.IsEnable)
                    {
                        <button class="efp-toggle @(item.IsToggled ? "efp-toggle--on" : "")"
                                @onclick:stopPropagation="true"
                                @onclick="async () => { await item.OnClickFunc(); }">
@*                                 title="@(item.IsToggled ? "Turn off" : "Turn on")">
 *@                            <span class="efp-toggle-knob"></span>
                            <span class="efp-toggle-label">@(item.IsToggled? Texts.ONText: Texts.OFFText)</span>
                        </button>
                    }
                    else
                    {
                        <span class="nav-lock-icon" title="Locked — click to upgrade" aria-hidden="true">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                        </span>
                    }
                </div>
            }

         @*    <!-- Section: Security & Identity -->
            <div class="efp-section-label efp-section-label--spaced">Security &amp; Identity</div>

            @foreach (var item in SecurityItems)
            {
                <div class="efp-row @(item.IsToggled ? "efp-row--on" : "")"
                     @onclick="() => ToggleItem(item)">
                    <div class="efp-row-icon" style="background:@item.IconBg">
                        @((MarkupString)item.IconSvg)
                    </div>
                    <div class="efp-row-body">
                        <span class="efp-row-label">@item.Label</span>
                        <span class="efp-row-desc">@item.Description</span>
                    </div>
                    <button class="efp-toggle @(item.IsToggled ? "efp-toggle--on" : "")"
                            @onclick:stopPropagation
                            @onclick="() => ToggleItem(item)"
                            title="@(item.IsToggled ? "Turn off" : "Turn on")">
                        <span class="efp-toggle-knob"></span>
                        <span class="efp-toggle-label">@(item.IsToggled ? "ON" : "OFF")</span>
                    </button>
                </div>
            } *@
        </div>

        <!-- ── Footer ── -->
        <div class="efp-footer">
            <span class="efp-footer-hint">
                @EnabledCount of @AllItems.Count properties enabled
            </span>
            <button class="efp-done-btn" @onclick="OnClose">@Texts.DoneTitle</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen  { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<FilePropertyItem> _items
    {
        get {
            return GetInitializeData();
        }
    }
    private void HandleBackdropClick() => OnClose.InvokeAsync();
    private void ToggleItem(FilePropertyItem item) 
    {
        if (item.IsEnable)
        {
            // Toggle is the click target — nothing to do at the row level.
            return;
        }

        popupService.CloseAllPopups();
        OnClose.InvokeAsync();
        paidFeaturegateService.ShowPaidGate(item.Label, item.Description, item.PaidPerks);
    }

    private void OnAppUiStateChanged() => InvokeAsync(StateHasChanged);

    private List<FilePropertyItem> AllItems => ColumnItems.Concat(SecurityItems).ToList();
    private int EnabledCount => AllItems.Count(i => i.IsToggled);

    private IEnumerable<FilePropertyItem> ColumnItems   => _items.Where(i => i.Section == "columns");
    private IEnumerable<FilePropertyItem> SecurityItems => _items.Where(i => i.Section == "security");

    protected override void OnInitialized()
    {
        appSettingsViewModel.OnUpdateViewState += OnAppUiStateChanged;
    }

    private List<FilePropertyItem> GetInitializeData()
    {
        return new()
        {
            // ── Sortable columns ─────────────────────────────────────────
            new()
            {
                Id = "date-modified", Label = Texts.FilePropertiesDateModifiedToolStripMenuItem, Section = "columns", IsToggled = appSettingsViewModel.IsDateModifiedOn, IsEnable = appSettingsViewModel.EnableEncryptionFileProperties,
                Description = Texts.FilePropertiesDescription,
                OnClickFunc = async () => await appSettingsViewModel.FilePropertiesDateModifiedAsync(),
                IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#2563eb' stroke-width='2'>
                    <rect x='3' y='4' width='18' height='18' rx='2'/>
                    <line x1='16' y1='2' x2='16' y2='6'/>
                    <line x1='8' y1='2' x2='8' y2='6'/>
                    <line x1='3' y1='10' x2='21' y2='10'/>
                </svg>",
                PaidPerks = new[] { Texts.PreserveOriginalModifiedDatePopup, Texts.AvoidVisibleEncryptionPopup, Texts.ExtraPrivacyProtectionPopup, Texts.UnlockAdvancedFileSecurityPopup }
            },
            new()
            {
                Id = "file-name", Label =Texts.FilePropertiesOriginalFileNameTitle, Section = "columns", IsToggled = appSettingsViewModel.IsFileNameOn, IsEnable = appSettingsViewModel.EnableRestoreRename,
                Description = Texts.FilePropertiesOriginalFileNameDescription,
                OnClickFunc = async () => await appSettingsViewModel.FilePropertiesFileNameAsync(),
                IconSvg = @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#16a34a' stroke-width='2'>
                    <path d='M12 20h9'/>
                    <path d='M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z'/>
                </svg>",
                PaidPerks = new[] { Texts.HideOriginalFileNamesPopup, Texts.GenerateSecureRandomFileNamesPopup, Texts.AddExtraPrivacyProtectionPopup, Texts.UnlockAdvancedEncryptionFeaturesPopup }
            },
        };
    }
}
