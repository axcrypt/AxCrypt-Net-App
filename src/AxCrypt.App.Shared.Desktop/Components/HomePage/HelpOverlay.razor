        new() { TabId="shortcuts", Title="Collapse the sidebar", Description="Click the ← button at the top of the sidebar to collapse it for more screen space. Hover icons to see labels.", IconBg="#eff6ff", IconSvg="<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#3b82f6' stroke-width='2'><polyline points='15 18 9 12 15 6'/></svg>", Shortcut="Ctrl+B" },
