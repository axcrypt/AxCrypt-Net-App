        new() { TabId="start", Title="Set up your Vault", Description="The Vault keeps all encrypted files in one secure folder. Enable auto-encryption so new files are protected the moment you save them.", IconBg="#f5f3ff", IconSvg="<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#8b5cf6' stroke-width='2'><path d='M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z'/></svg>", Shortcut="Pro only" },
        new() { TabId="start", Title="Share a file securely", Description="Use 'Share Securely' to generate a one-time share key. The recipient can only open the file with that key, and you can revoke access at any time.", IconBg="#dcfce7", IconSvg="<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#22c55e' stroke-width='2'><circle cx='18' cy='5' r='3'/><circle cx='6' cy='12' r='3'/><circle cx='18' cy='19' r='3'/><line x1='8.59' y1='13.51' x2='15.42' y2='17.49'/></svg>", Shortcut="Pro only" },
