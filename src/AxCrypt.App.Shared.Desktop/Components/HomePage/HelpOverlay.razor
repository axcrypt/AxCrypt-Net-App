@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.Content

@inject NavigationManager Navigation
@inject PopupService popupService
@inject PaidFeaturegateService paidFeaturegateService
@inject NavPageService NavPageService

<!-- Help Overlay -->
@if (popupService.HelpOverlayOpen)
{
    <div class="help-overlay" @onclick:stopPropagation>
        <div class="help-header">
            <div class="help-title-row">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                <h2>@Texts.HelpOverlayTitle</h2>
            </div>
            <button class="help-close" @onclick="() => popupService.HelpOverlayOpen = false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
        </div>
        <div class="help-tabs">
            @foreach (var tab in HelpTabs)
            {
                <button class="help-tab @(ActiveHelpTab == tab.Id ? "help-tab--active" : "")"
                        @onclick="() => ActiveHelpTab = tab.Id">
                    @tab.Label
                </button>
            }
        </div>
        <div class="help-content">
            @foreach (var item in HelpItems.Where(h => h.TabId == ActiveHelpTab))
            {
                <div class="help-item">
                    <div class="help-item-icon" style="background:@item.IconBg">@((MarkupString)item.IconSvg)</div>
                    <div class="help-item-body">
                        <span class="help-item-title">@item.Title</span>
                        <span class="help-item-desc">@item.Description</span>
                        @if (!string.IsNullOrEmpty(item.Shortcut))
                        {
                            <kbd class="help-kbd">@item.Shortcut</kbd>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

