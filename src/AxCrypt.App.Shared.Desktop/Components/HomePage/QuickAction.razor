@implements IDisposable
@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content

@inject ActionsViewModel homeActionModel
@inject UserService userService
@inject PaidFeaturegateService paidFeaturegateService
@inject IFeatureUsageProvider usage

<section class="card">
    <div class="card-header-row">
        <h2 class="section-title">@Texts.QuickActionsTitle</h2>
        <span class="card-header-hint">@Texts.QuickActionsSubTitle</span>
    </div>

    <AxCrypt.App.Shared.Desktop.Components.HomePage.CleanupActionRow IsCleanUpRequired=@homeActionModel!.AreFilesPending ActionFor="Files"/>

    <div class="quick-actions-grid">
        @foreach (QuickActionItem qa in QuickActionCatalog.Items)
        {
            <QuickActionTile Item="qa"
                             IsLocked="homeActionModel.IsLockedFor(qa, userService, usage)"
                             OnInvoke="OnQuickAction" />
        }
    </div>
</section>

<AxCrypt.App.Shared.Desktop.Components.PopupDialog.ConfirmWipeDialog />
<AxCrypt.App.Shared.Desktop.Components.Home.ShareKeyComponent />

@code {
    private Action? _onActionModelUpdate;
    private Action? _onUsageChange;

    protected override void OnInitialized()
    {
        _onActionModelUpdate = () => InvokeAsync(StateHasChanged);
        _onUsageChange       = () => InvokeAsync(StateHasChanged);

        homeActionModel!.OnUpdateViewState += _onActionModelUpdate;
        usage.OnChange += _onUsageChange;
    }

    public void Dispose()
    {
        if (_onActionModelUpdate != null)
            homeActionModel.OnUpdateViewState -= _onActionModelUpdate;
        if (_onUsageChange != null)
            usage.OnChange -= _onUsageChange;
    }

    // Delegate entirely to ViewModel; force repaint so tile states update immediately.
    private async Task OnQuickAction(QuickActionItem qa)
    {
        await homeActionModel.HandleQuickActionAsync(qa, userService, usage, paidFeaturegateService);
        await InvokeAsync(StateHasChanged);
    }
}
