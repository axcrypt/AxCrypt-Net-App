@using AxCrypt.App.Shared.Desktop.Models

@*
    Single Quick Action tile. Pure presentational — the parent
    (QuickAction.razor) decides whether it's locked and what to
    do on click. Kept as a small component so the grid template
    stays a one-liner and the locked / unlocked rendering doesn't
    duplicate markup.
*@

<button class="qa-btn @(IsLocked ? "disabled" : "")"
        type="button"
        @onclick="HandleClick">
    @if (IsLocked)
    {
        <div class="qa-paid-badge" title="Paid feature — click to upgrade">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0110 0v4" />
            </svg>
        </div>
    }
    <div class="qa-icon-wrap">
        <div class="qa-icon">
            <img src="@Item.SvgIcon" alt="@Item.Label" />
        </div>
    </div>
    <span class="qa-label">@Item.Label</span>
    <span class="qa-desc">@Item.Description</span>
</button>

@code {
    /// <summary>The action this tile represents.</summary>
    [Parameter, EditorRequired] public QuickActionItem Item { get; set; } = default!;

    /// <summary>True when the user's plan can't perform this action.</summary>
    [Parameter] public bool IsLocked { get; set; }

    /// <summary>Handler the parent registers for the click.</summary>
    [Parameter, EditorRequired] public EventCallback<QuickActionItem> OnInvoke { get; set; }

    private Task HandleClick() => OnInvoke.InvokeAsync(Item);
}
