@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content

@inject NavigationManager Navigation
@inject QuickSecureActionViewModel quickSecureVm
@inject UserService userService
@inject IFeatureUsageProvider usage

<!-- CTA -->
<div class="cta-wrapper">
    <button class="cta-btn" @onclick="ToggleNewActionMenu">
        @PlusSvg New Secure Action
        <span class="cta-chevron @(NewActionMenuOpen ? "cta-chevron--open" : "")">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                <polyline points="18 15 12 9 6 15" />
            </svg>
        </span>
    </button>

    @if (NewActionMenuOpen)
    {
        <div class="new-action-menu">
            <div class="nam-header">@Texts.QuickSecureActionHeader</div>
            @foreach (NewActionGroup grp in quickSecureVm.GetNewActionGroups())
            {
                @foreach (NewActionItem item in grp.Items)
                {
                    @if (item.IsEnable)
                    {
                        bool isLocked = quickSecureVm.IsLockedFor(item, userService, usage);
                        <button class="nam-item @(isLocked ? "nam-item--locked" : "")"
                                @onclick="async (e) => await OnNewAction(e, item)">
                            <span class="nam-icon nam-icon-bg">
                                @((MarkupString)item.IconSvg)
                            </span>
                            <div class="nam-text">
                                <span class="nam-label">@item.Label</span>
                                <span class="nam-desc">@item.Description</span>
                            </div>
                            @if (isLocked)
                            {
                                <span class="nam-lock-badge" title="Paid feature — click to upgrade">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0110 0v4" />
                                    </svg>
                                </span>
                            }
                            else
                            {
                                <svg class="nam-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            }
                        </button>
                    }
                }
            }
        </div>
        <div class="nam-backdrop" @onclick="CloseMenu"></div>
    }
</div>

@code {
    private bool NewActionMenuOpen { get; set; } = false;

    private void ToggleNewActionMenu() => NewActionMenuOpen = !NewActionMenuOpen;
    private void CloseMenu() => NewActionMenuOpen = false;

    // Delegate dispatch to ViewModel; navigate when a route is returned.
    private async Task OnNewAction(EventArgs e, NewActionItem item)
    {
        NewActionMenuOpen = false;
        string? route = await quickSecureVm.HandleNewActionAsync(e, item, userService, usage);
        if (route != null)
            Navigation.NavigateTo(route);
    }

    // ── UI-only SVG helper ─────────────────────────────────────
    private RenderFragment PlusSvg => @<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>;
}