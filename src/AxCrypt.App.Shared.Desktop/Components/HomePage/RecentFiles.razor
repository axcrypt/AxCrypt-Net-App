@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content
@using Microsoft.AspNetCore.Components.Web

@inject NavigationManager Navigation
@inject PopupService popupService
@inject PaidFeaturegateService paidFeaturegateService
@inject RecentFilesViewModel recentFilesViewModel
@inject ActionsViewModel homeActionModel
@inject FileDropService FileDropService

@implements IDisposable

<section class="card recent-files-card @(DropZoneActive ? "recent-files-card--dropping" : "")">
    @if (DropZoneActive)
    {
        <div class="rf-drop-hint">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
            <span>@Texts.RecentFilesDropFiles</span>
        </div>
    }
    <div class="card-header-row">
        <h2 class="section-title">@Texts.RecentFilesTabPageText</h2>
        <span class="card-header-hint">@Texts.RecentFilesSubTitle</span>
    </div>

    @if (recentFilesViewModel.IsHideRecentFiles)
    {
        <div class="files-table row-sec">
            <p style="padding: 20px 30px;"><span class="grey-clr">@Texts.HideRecentFilesListTabToolTipText</span></p>
        </div>
    }
    else
    {
        @* ── Filter tabs ─────────────────────────────────────────── *@
        <div class="filter-tabs">
            @foreach ((string id, string label) in FilterTabs)
            {
                int count = CountFor(id);
                <button class="tab @(ActiveTab == id ? "tab--active" : "")"
                        @onclick="() => SetTab(id)">
                    @label
                    @if (count > 0)
                    {
                        <span class="tab-count">@count</span>
                    }
                </button>
            }
        </div>

        @* ── Bulk-action bar (only when 1+ rows are checked) ────── *@
        @if (SelectedCount > 0)
        {
            <div class="rf-bulk-bar" role="toolbar" aria-label="Bulk actions">
                <span class="rf-bulk-count">@SelectedCount selected</span>
                <div class="rf-bulk-actions">
                    <button class="rf-bulk-btn" disabled="@_guard.IsProcessing" @onclick="BulkOpen" title="Open selected files">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        @Texts.McInfMenuOpen
                    </button>
                    <button class="rf-bulk-btn" disabled="@_guard.IsProcessing" @onclick="BulkShareKey" title="Share key for selected files">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
                        @Texts.ShareKeysToolStripMenuItemText
                    </button>
                    <button class="rf-bulk-btn" disabled="@_guard.IsProcessing" @onclick="BulkCleanUp" title="Re-encrypt and close selected files">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M9 6v14a2 2 0 002 2h2a2 2 0 002-2V6M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2" /></svg>
                        @Texts.CleanUpPromptText
                    </button>
                    <button class="rf-bulk-btn rf-bulk-btn--danger" disabled="@_guard.IsProcessing" @onclick="BulkRemove" title="Remove selected from list">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" /></svg>
                        @Texts.RemoveText
                    </button>
                    <button class="rf-bulk-btn rf-bulk-btn--ghost" @onclick="ClearSelection" title="Clear selection">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                        @Texts.ClearButtonText
                    </button>
                </div>
            </div>
        }

        @* ── Files table ─────────────────────────────────────────── *@
        <div class="files-table">
            <div class="trow trow--header">
                <div class="tcol tcol-check">
                    <input type="checkbox"
                           checked="@recentFilesViewModel.SelectAllChecked"
                           @onchange="async (e) => await OnToggleAll(e)"
                           title="Select all" />
                </div>
                <div class="tcol tcol-name">@Texts.NameLabel</div>
                <div class="tcol tcol-status">@Texts.ColumnStatusHeader</div>
                <div class="tcol tcol-date">@Texts.LastModifiedTimeColumnHeaderText</div>
                <div class="tcol tcol-size">@Texts.FileSizeColumnHeaderText</div>
                <div class="tcol tcol-act"></div>
            </div>

            @if (!DisplayedFiles.Any())
            {
                <div class="rf-empty">
                    <img class="empty-rcnt-fle-img" alt="No files yet" />
                    <span class="rf-empty-title">@EmptyTitle</span>
                    <span class="rf-empty-sub">@EmptySub</span>
                </div>
            }
            else
            {
                @* Scrollable body — caps at ~5 rows then enables internal scroll. *@
                <div class="files-table-body">
                @foreach (FileDetails f in DisplayedFiles)
                {
                    string statusKey = StatusKey(f);
                    @* Selection is checkbox-only — single-clicking the row
                       no longer toggles selection. Double-click opens, the
                       right-click opens the context menu without changing
                       the checkbox state. *@
                    <div class="trow @(f.IsChecked ? "trow--selected" : "")"
                         @ondblclick="async (e) => await OnRowDoubleClick(e, f)"
                         @oncontextmenu:preventDefault="true"
                         @oncontextmenu="async (e) => await OnRowContextMenu(e, f)">

                        <div class="tcol tcol-check" @onclick:stopPropagation="true">
                            <input type="checkbox"
                                   checked="@f.IsChecked"
                                   @onchange="async (e) => await OnRowCheck((bool)(e.Value ?? false), f)" />
                        </div>

                        <div class="tcol tcol-name">
                            <span class="file-icon @StatusIconClass(statusKey)">
                                <span class="file-icon-ext">@ExtLabel(f)</span>
                            </span>
                            <div class="file-text">
                                <span class="file-name" title="@f.FileName">@f.FileName</span>
                                <span class="file-meta" title="@f.FilePath">@f.FilePath</span>
                            </div>
                        </div>

                        <div class="tcol tcol-status">
                            <span class="badge badge--@BadgeSlug(statusKey)">@StatusLabel(statusKey)</span>
                        </div>

                        <div class="tcol tcol-date">@f.LastModifiedDate</div>
                        <div class="tcol tcol-size">@f.FileSize</div>

                        <div class="tcol tcol-act" @onclick:stopPropagation="true">
                            <button class="icon-btn-sm" title="Open" disabled="@_guard.IsProcessing" @onclick="async (e) => await OpenFile(f)">@EyeSvg</button>
                            <button class="icon-btn-sm" title="More actions" @onclick="async (e) => await OnDotsMenu(e, f)">@DotsSvg</button>
                        </div>
                    </div>
                }
                </div>
            }
        </div>
    }
</section>

<AxCrypt.App.Shared.Desktop.Components.HomePage.RecentFilesContextMenu />

@code {
    // ═══════════════════════════════════════════
    //  Filter tabs
    // ═══════════════════════════════════════════
    private static readonly (string Id, string Label)[] FilterTabs =
    {
        ("All",    "All"),
        ("Opened", "Opened"),
        ("Shared", "Shared"),
    };

    private string ActiveTab { get; set; } = "All";

    private bool DropZoneActive { get; set; }

    // Re-entrancy guard — prevents double-click from launching two concurrent file operations.
    private readonly OperationGuard _guard = new();

    // FileDropService.OnFilesDropped is event Action<IList<string>> —
    // match the signature and fire-and-forget the async handler so the
    // Action contract holds. HandleDroppedFiles awaits its own UI
    // marshalling so the discarded Task is safe.
    private Action<IList<string>>? _onFilesDropped;

    protected override async Task OnInitializedAsync()
    {
        recentFilesViewModel.OnInitialized();
        recentFilesViewModel.OnUpdateViewState += UpdatePageState;

        // Also refresh when any QuickAction operation (encrypt / open / decrypt /
        // share-key) completes. The ViewModel property-change chain that drives
        // recentFilesViewModel can arrive one render tick after homeActionModel
        // fires its own update — subscribing here ensures both components repaint
        // in the same cycle so the file list never lags a QuickAction.
        homeActionModel.OnUpdateViewState += UpdatePageState;

        FileDropService.ResetOnDropped();
        _onFilesDropped = (files) => _ = HandleDroppedFiles(files);
        FileDropService.OnFilesDropped    += _onFilesDropped;
        FileDropService.OnFilesDraggedOver += HandleDraggedOverFiles;
        FileDropService.OnFilesDragLeave  += HandleDragLeave;

        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        // VM is a singleton — unhook so the next mount doesn't stack
        // up duplicate handlers (one ActiveFile change → N redraws).
        recentFilesViewModel.OnUpdateViewState -= UpdatePageState;
        homeActionModel.OnUpdateViewState      -= UpdatePageState;

        // Unsubscribe FileDropService events.  Without this, each navigation
        // back to the home page adds another copy of each handler, causing
        // N concurrent file-encrypt calls on the next drop.
        if (_onFilesDropped != null) { FileDropService.OnFilesDropped -= _onFilesDropped; _onFilesDropped = null; }
        FileDropService.OnFilesDraggedOver -= HandleDraggedOverFiles;
        FileDropService.OnFilesDragLeave  -= HandleDragLeave;
    }

    private void UpdatePageState()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Force the component to re-render now (used after user
    /// interactions so the new state is reflected immediately rather
    /// than on the next external refresh).</summary>
    private Task RefreshNow() => InvokeAsync(StateHasChanged);

    private void SetTab(string id) => ActiveTab = id;

    // ── Status derivation ─────────────────────────────────────
    //  Priority (most specific wins):
    //   Opened     → file is currently decrypted (CleanUpNeeded == true)
    //   MasterKey  → a business master key is applied (IsMasterKeyShared)
    //   Shared     → external key-share recipients (IsKeyShared / SharedWith)
    //   Encrypted  → default at-rest encrypted state
    //
    //  MasterKey only shows up for files whose owner is on a business
    //  plan — free/premium files never set IsMasterKeyShared.
    // ──────────────────────────────────────────────────────────
    private static string StatusKey(FileDetails f)
    {
        if (f.CleanUpNeeded) return "Opened";
        if (f.IsMasterKeyShared) return "MasterKey";
        if (f.IsKeyShared || (f.SharedWith != null && f.SharedWith.Count > 0)) return "Shared";
        return "Encrypted";
    }

    private static string StatusLabel(string key) => key switch
    {
        "Opened"    => "Opened",
        "MasterKey" => "Master key",
        "Shared"    => "Key shared",
        _           => "Encrypted",
    };

    private static string StatusIconClass(string key) => key switch
    {
        "Opened"    => "file-icon--opened",
        "MasterKey" => "file-icon--master-key",
        "Shared"    => "file-icon--shared",
        _           => "file-icon--enc",
    };

    // CSS class slug for the status badge — must match the lowercase /
    // kebab-case names declared in HomeNew/FilesTable.scss. Previously
    // the Razor used `badge--@statusKey` which produced PascalCase
    // class names like "badge--Opened" — none of the CSS rules
    // matched, so the badge had no background/foreground tint.
    private static string BadgeSlug(string key) => key switch
    {
        "Opened"    => "opened",
        "MasterKey" => "master-key",
        "Shared"    => "shared",
        _           => "enc",
    };

    private static string ExtLabel(FileDetails f)
    {
        string ext = (f.FileExtension ?? "").TrimStart('.').ToUpperInvariant();
        if (string.IsNullOrEmpty(ext)) return "FILE";
        return ext.Length > 4 ? ext.Substring(0, 4) : ext;
    }

    private IEnumerable<FileDetails> DisplayedFiles =>
        ActiveTab switch
        {
            "Opened" => recentFilesViewModel.RecentFilesList.Where(f => StatusKey(f) == "Opened"),
            "Shared" => recentFilesViewModel.RecentFilesList.Where(f => StatusKey(f) == "Shared"),
            _        => recentFilesViewModel.RecentFilesList,
        };

    private int CountFor(string tab) => tab switch
    {
        "All"    => recentFilesViewModel.RecentFilesList?.Count() ?? 0,
        "Opened" => recentFilesViewModel.RecentFilesList?.Count(f => StatusKey(f) == "Opened") ?? 0,
        "Shared" => recentFilesViewModel.RecentFilesList?.Count(f => StatusKey(f) == "Shared") ?? 0,
        _        => 0,
    };

    private int SelectedCount =>
        recentFilesViewModel.RecentFilesList?.Count(f => f.IsChecked) ?? 0;

    private string EmptyTitle => ActiveTab switch
    {
        "Opened" => Texts.RecentFilesNoFilesCurrentlyOpen,
        "Shared" => Texts.RecentFilesNoSharedFilesYet,
        _        => Texts.LetsStartOurJourneyText,
    };

    private string EmptySub => ActiveTab switch
    {
        "Opened" => Texts.RecentFilesYouOpenWillAppear,
        "Shared" => Texts.RecentFilesShareSomeone,
        _        => Texts.AddAndSecureYourFirstFileText,
    };

    // ═══════════════════════════════════════════
    //  Selection wiring
    //  Every interaction triggers an immediate re-render — the VM also
    //  fires OnUpdateViewState, but that may arrive a tick later than
    //  the click. Calling RefreshNow() guarantees the row's selected
    //  style and the bulk-action bar appear without any perceptible lag.
    // ═══════════════════════════════════════════
    private async Task OnToggleAll(ChangeEventArgs e)
    {
        recentFilesViewModel.SelectAllFiles(e);
        await RefreshNow();
    }

    private async Task OnRowCheck(bool isChecked, FileDetails f)
    {
        recentFilesViewModel.HandleFileClick(isChecked, f.FilePath);
        await RefreshNow();
    }

    // ═══════════════════════════════════════════
    //  Row interactions
    //  • Single click  → nothing (selection is checkbox-only)
    //  • Checkbox      → toggle that row (shows the bulk-action bar)
    //  • Double click  → open the file
    //  • Eye button    → open the file (alias of double-click)
    //  • Right click   → context menu, without touching the selection
    //  • ⋮ dots button → context menu, without touching the selection
    // ═══════════════════════════════════════════
    private async Task OnRowDoubleClick(MouseEventArgs e, FileDetails f)
    {
        await _guard.RunAsync(
            () => recentFilesViewModel.OpenSecuredMouseDoubleClick(new MouseEventArgs { Type = "dblclick" }, f.FilePath),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    private async Task OnRowContextMenu(MouseEventArgs e, FileDetails f)
    {
        // Right-click only sets the context-menu target — never the checkbox.
        recentFilesViewModel.OpenContextMenuForFile(f.FilePath);
        popupService.ContextMenuX = e.ClientX;
        popupService.ContextMenuY = e.ClientY;
        popupService.ToggleRecentFilesContextMenu();
        await RefreshNow();
    }

    private async Task OnDotsMenu(MouseEventArgs e, FileDetails f)
    {
        // ⋮ dots button: same as right-click — context menu, no selection change.
        recentFilesViewModel.OpenContextMenuForFile(f.FilePath);
        popupService.ContextMenuX = e.ClientX;
        popupService.ContextMenuY = e.ClientY;
        popupService.ToggleRecentFilesContextMenu();
        await RefreshNow();
    }

    private async Task OpenFile(FileDetails f)
    {
        // Eye-icon equivalent of double-click.
        await _guard.RunAsync(
            () => recentFilesViewModel.OpenSecuredMouseDoubleClick(new MouseEventArgs { Type = "dblclick" }, f.FilePath),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    private async Task ClearSelection()
    {
        recentFilesViewModel.ClearSelection();
        await RefreshNow();
    }

    // ═══════════════════════════════════════════
    //  Bulk-action handlers (selected rows)
    // ═══════════════════════════════════════════
    private async Task BulkOpen()
    {
        await _guard.RunAsync(
            () => recentFilesViewModel.OnContextMenuAction(EventArgs.Empty, SecuredFilesContextMenu.OpenSecured),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    private async Task BulkShareKey()
    {
        await _guard.RunAsync(
            () => recentFilesViewModel.OnContextMenuAction(EventArgs.Empty, SecuredFilesContextMenu.ShareKey),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    private async Task BulkCleanUp()
    {
        await _guard.RunAsync(
            () => homeActionModel.CleanAndRemoveOpenFilesButton_Click(EventArgs.Empty),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    private async Task BulkRemove()
    {
        await _guard.RunAsync(
            () => recentFilesViewModel.OnContextMenuAction(EventArgs.Empty, SecuredFilesContextMenu.RemoveFromListButKeepSecured),
            () => InvokeAsync(StateHasChanged));
        await RefreshNow();
    }

    // ═══════════════════════════════════════════
    //  Drop zone
    //
    //  FileDropService raises these from the JS interop / drag-drop
    //  pipeline thread, not the renderer SC. Marshal every UI-bound
    //  mutation (DropZoneActive flips the drop-zone class) onto the
    //  Blazor dispatcher first so the renderer can't read a torn flag
    //  or throw "current thread is not associated with the Dispatcher"
    //  on the StateHasChanged.
    // ═══════════════════════════════════════════
    private async Task HandleDroppedFiles(IList<string> files)
    {
        await InvokeAsync(() =>
        {
            DropZoneActive = false;
            StateHasChanged();
        });

        await recentFilesViewModel.EncryptDroppedFiles(files);
    }

    private void HandleDraggedOverFiles()
    {
        // Fire-and-forget the marshal — Action signature can't be made
        // async. UpdatePageState's job is already absorbed into the
        // InvokeAsync body, so it's no longer called separately.
        _ = InvokeAsync(() =>
        {
            DropZoneActive = true;
            StateHasChanged();
        });
    }

    private void HandleDragLeave()
    {
        _ = InvokeAsync(() =>
        {
            DropZoneActive = false;
            StateHasChanged();
        });
    }

    // ═══════════════════════════════════════════
    //  Inline SVGs
    // ═══════════════════════════════════════════
    private RenderFragment EyeSvg => @<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>;
    private RenderFragment DotsSvg => @<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="12" cy="19" r="1" /></svg>;
}
