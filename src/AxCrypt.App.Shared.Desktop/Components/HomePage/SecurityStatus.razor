@using AxCrypt.Api.Model
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Services

@inject NavigationManager Navigation
@inject UserService userService

@*
    Security Status — adapts to the user's subscription tier.

    Free      → 2 always-on assurances + 1 encouragement (set recovery)
                + 1 locked upsell (master-key recovery is business-only).
    Premium   → All free items + unlimited encryption, key-share, anonymous
                rename, optional 2FA encouragement.
    Business  → All premium items + master-key recovery, group sharing,
                audit log, compliance.

    The row state drives icon + tint:
      Active  → green check (feature working)
      Warning → amber dot (action recommended)
      Locked  → grey lock badge (feature exists in a higher tier)
*@

<section class="card security-status-card">
    <div class="card-header-row">
        <h2 class="section-title">Security Status</h2>
        <span class="sec-tier-pill sec-tier-pill--@TierClass" title="Your current plan">@TierLabel</span>
    </div>

    @foreach (SecurityItem s in SecurityItems)
    {
        bool clickable = !string.IsNullOrEmpty(s.ActionRoute);
        <div class="security-row security-row--@StateClass(s.State) @(clickable ? "security-row--clickable" : "")"
             @onclick="() => { if (clickable) { OpenAction(s); } }">
            <span class="sec-check">@StateIcon(s.State)</span>
            <div class="sec-info">
                <span class="sec-title">@s.Title</span>
                <span class="sec-desc">@s.Description</span>
            </div>
            @if (!string.IsNullOrEmpty(s.ActionLabel))
            {
                <button type="button" class="sec-action-btn" @onclick="() => OpenAction(s)" @onclick:stopPropagation>@s.ActionLabel</button>
            }
            else
            {
                <span class="sec-tick">@StateBadge(s.State)</span>
            }
        </div>
    }
</section>

@code {
    private List<SecurityItem> SecurityItems => BuildItems(userService.SubscriptionLevel);

    // ── Tier identification ────────────────────────────────────
    private bool IsBusiness => userService.SubscriptionLevel == SubscriptionLevel.Business;
    private bool IsPremium  => userService.SubscriptionLevel == SubscriptionLevel.Premium
                            || userService.SubscriptionLevel == SubscriptionLevel.PasswordManager;
    private bool IsFree     => userService.IsFreeTier;

    private string TierLabel =>
        IsBusiness ? "Business" :
        IsPremium  ? "Premium"  : "Free";

    private string TierClass =>
        IsBusiness ? "business" :
        IsPremium  ? "premium"  : "free";

    // ── Item composition ───────────────────────────────────────
    //  Each tier shows 3–4 rows so the card stays compact next to
    //  the Vault status. We pick the highest-signal items per tier:
    //    Free     → safety baseline + 1 nudge + 1 upsell
    //    Premium  → safety baseline + premium hallmark + 1 nudge
    //    Business → safety baseline + the two business hallmarks
    // ──────────────────────────────────────────────────────────
    // Multi-factor authentication is set up on the AxCrypt account
    // website, so this row opens that page (deep-linked to the MFA
    // section) in the user's external browser — see OpenAction.
    private const string MfaSetupUrl = "https://account.axcrypt.net/en/Security#mfa-expnd-collps";

    private static SecurityItem MfaItem() => new()
    {
        Title = "Multi-factor authentication",
        Description = "Add an additional factor on top of your password for sign-in.",
        State = SecurityItemState.Warning,
        ActionRoute = MfaSetupUrl,
        ActionLabel = "Set up",
    };

    private static List<SecurityItem> BuildItems(SubscriptionLevel level)
    {
        bool business = level == SubscriptionLevel.Business;
        bool premium  = level == SubscriptionLevel.Premium || level == SubscriptionLevel.PasswordManager;

        if (business)
        {
            return new()
            {
                new() { Title = "Unlimited AES-256 encryption & key sharing",
                        Description = "No daily caps — plus share keys with trusted recipients.",
                        State = SecurityItemState.Active },
                new() { Title = "Master Key recovery",
                        Description = "Your organization can recover files if a member loses access.",
                        State = SecurityItemState.Active },
                new() { Title = "Group key sharing",
                        Description = "Share access by team or role — managed centrally.",
                        State = SecurityItemState.Active },
                MfaItem(),
            };
        }

        if (premium)
        {
            return new()
            {
                new() { Title = "Unlimited AES-256 encryption & key sharing",
                        Description = "No daily caps — plus share keys with trusted recipients.",
                        State = SecurityItemState.Active },
                new() { Title = "Anonymous file names",
                        Description = "Encrypted files keep no trace of the original name on disk.",
                        State = SecurityItemState.Active },
                MfaItem(),
            };
        }

        // Free
        return new()
        {
            new() { Title = "2 encryptions per month",
                    Description = "Free plan includes up to 2 file encryptions per month.",
                    State = SecurityItemState.Active },

            new() { Title = "Unlimited encryption & key sharing",
                    Description = "No daily limits, key sharing, anonymous rename.",
                    State = SecurityItemState.Locked,
                    ActionRoute = "/upgradePage",
                    ActionLabel = "Upgrade" },
            new() { Title = "Secure Delete",
                    Description = "Permanently wipe files with multi-pass overwriting.",
                    State = SecurityItemState.Locked,
                    ActionRoute = "/upgradePage",
                    ActionLabel = "Upgrade" },
        };
    }

    // Routes a security-row action. An http(s) ActionRoute opens in the
    // user's external browser (e.g. MFA setup on the account website);
    // anything else is treated as an in-app route.
    private void OpenAction(SecurityItem s)
    {
        if (string.IsNullOrEmpty(s.ActionRoute))
        {
            return;
        }

        if (s.ActionRoute.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            AxCrypt.Core.BrowseUtility.RedirectTo(s.ActionRoute);
        }
        else
        {
            Navigation.NavigateTo(s.ActionRoute);
        }
    }

    // ── Render helpers ─────────────────────────────────────────
    private string StateClass(SecurityItemState s) => s switch
    {
        SecurityItemState.Warning => "warn",
        SecurityItemState.Locked  => "lock",
        _                         => "ok",
    };

    private RenderFragment StateIcon(SecurityItemState s) => s switch
    {
        SecurityItemState.Warning => GreenWarn,
        SecurityItemState.Locked  => GreenLock,
        _                         => GreenCheckSvg,
    };

    private RenderFragment StateBadge(SecurityItemState s) => s switch
    {
        SecurityItemState.Warning => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>,
        SecurityItemState.Locked  => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>,
        _                         => GreenTickSvg,
    };

    private RenderFragment GreenTickSvg => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12" stroke="#22c55e" stroke-width="2.5" /></svg>;
    private RenderFragment GreenCheckSvg => @<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#22c55e" /><polyline points="8 12 11 15 16 9" stroke="white" stroke-width="2" fill="none" /></svg>;
    private RenderFragment GreenWarn => @<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#f59e0b" /><line x1="12" y1="8" x2="12" y2="13" stroke="white" stroke-width="2.4" stroke-linecap="round" /><line x1="12" y1="16" x2="12.01" y2="16" stroke="white" stroke-width="2.4" stroke-linecap="round" /></svg>;
    private RenderFragment GreenLock => @<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#9ca3af" /><rect x="8" y="11" width="8" height="6" rx="1" fill="white" /><path d="M10 11V9a2 2 0 014 0v2" stroke="white" stroke-width="1.6" fill="none" /></svg>;

    protected override void OnInitialized()
    {
        userService.OnChange += () => InvokeAsync(StateHasChanged);
    }
}
