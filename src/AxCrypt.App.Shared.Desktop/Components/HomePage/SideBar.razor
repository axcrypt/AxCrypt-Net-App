@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content
@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.Models

@inject LogOnViewModel LogOnViewModel
@inject NavigationManager navigationManager
@inject AppSettingsViewModel AppSettingsViewModel
@inject UserService userService
@inject PopupService popupService
@inject NavPageService navPageService
@inject FileDropService FileDropService
@inject ProfileViewModel profileViewModel
@inject PaidFeaturegateService paidFeaturegateService
@inject IJSRuntime JSRuntime

<!-- ═══════════════════════ SIDEBAR ═══════════════════════ -->
<aside class="sidebar">
    <!-- Brand + Toggle -->
    <div class="brand">
        <div class="brand-icon">
            <img src="images/default/AxCrypt_Icon.svg" width="32" height="32" />
        </div>
        <span class="brand-name">AxCrypt</span>
        <button class="toggle-btn" @onclick="@Utility.ToggleMainMenu" title="@(Utility.IsMainMenuHidden ? "Expand" : "Collapse") sidebar">
            @CollapseIcon
        </button>
    </div>

    <!-- Collapsed: icon-only toggle pill -->
    <button class="toggle-btn-collapsed" @onclick="@Utility.ToggleMainMenu" title="Expand sidebar">
        @ExpandIcon
    </button>

    <nav class="nav-links">
        @foreach (NavPage navPage in navPageService.SideMenuNavPages!)
        {
            bool isPaidFeatureFreeUser = navPage.IsPaid && userService.IsFreeTier;
            string cssStyleClass = isPaidFeatureFreeUser ? "nav-item nav-item--locked " + GetClassByActiveTab(navPage.Href) : "nav-item";
            string menuNavLink = isPaidFeatureFreeUser ? "javascript:void(0);" : navPage.Href;
            <NavLink href="@menuNavLink" class="@(cssStyleClass)"
                     ActiveClass="nav-item--active" Match="@navPage.Match"
                     @onclick="() => OnClickNavMenu(navPage)">
                <span class="nav-icon @navPage.StyleClass" alt="@navPage.StyleClass"></span>
                <span class="nav-label">@navPage.Label</span>
                @if (isPaidFeatureFreeUser)
                {
                    <span class="nav-lock-icon" title="Locked! Upgrade to unlock">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                    </span>
                }
            </NavLink>
        }
    </nav>

    @* Sidebar always shows the file-encryption quota for free users. *@
    <AxCrypt.App.Shared.Desktop.Components.Shared.FreePlanLimitBar Feature="AxCrypt.App.Entitlement.Contracts.FeatureKey.FileEncryption" />

    <div class="sidebar-footer">
        <AxCrypt.App.Shared.Desktop.Components.HomePage.UserProfile />

        @if (userService.IsFreeTier)
        {
            <NavLink class="upgrade-btn" href="/upgradePage">
                @ClockIcon
                <span class="upgrade-label">@Texts.UpgradeText</span>
            </NavLink>
        }
        else
        {
            <button class="upgrade-btn">
                <span class="nav-icon nav-home-ico" alt="subscription-ico"></span>
                <span class="upgrade-label">@userService.SubscriptionLevel.ToString()</span>
            </button>
        }
    </div>
</aside>

@code {
    private string TabActive = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await profileViewModel!.InitializeAsync();

        FileDropService.CurrentPage = navigationManager.Uri.Replace(navigationManager.BaseUri, "/");

        navigationManager.LocationChanged += OnLocationChanged;
        popupService.OnChange += UpdatePageState;
    }

    private void OnLocationChanged(object? obj, LocationChangedEventArgs args)
    {
        UpdateActiveTabByNavigation();
        UpdatePageState();
    }

    string[] SecretNavUrls = new[]
    {
        "/editpassword",
        "/editnote",
        "/editcard",
        "/viewcard",
        "/viewnote",
        "/viewpassword",
        "/AddCard",
        "/AddNote",
        "/AddPassword"
    };

    private void UpdateActiveTabByNavigation()
    {
        TabActive = "";
        if (SecretNavUrls.Contains(navigationManager.Uri.Replace(navigationManager.BaseUri, "/")))
        {
            TabActive = "passwordManager";
            return;
        }

        FileDropService.CurrentPage = navigationManager.Uri.Replace(navigationManager.BaseUri, "/");
    }

    private string GetClassByActiveTab(string activeTab)
    {
        return TabActive == activeTab.Replace("/", "") ? "nav-item--active" : "";
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private void OnClickNavMenu(NavPage navPage)
    {
        if (navPage.IsPaid && userService.IsFreeTier)
        {
            switch (navPage.Href)
            {
                case "/vault":
                    paidFeaturegateService.ShowPaidGate(Texts.VaultText, Texts.QuickSecureActionEncryptedVaults, new[] { Texts.QuickSecureActionSecureEncryptedVaults, Texts.QuickSecureActionProtectImportantFiles, Texts.QuickSecureActionAdvancedVaultSecurity, Texts.QuickSecureActionUnlockPremium });
                    break;

                case "/textencryption":
                    paidFeaturegateService.ShowPaidGate(Texts.TextEncryptionLinkLabel, Texts.TextEncryptionAdvancedProtectionFeatures, new[] { Texts.EncryptUnlimitedText, Texts.AdvancedEncryptionAlgorithms, Texts.QuickSecureActionSensitiveInformation, Texts.PriorityCustomerSupport });
                    break;

                case "/securedfolders":
                    paidFeaturegateService.ShowPaidGate(Texts.WatchedFoldersTabPageText, Texts.QuickSecureActionAutomaticallyMonitor, new[] { Texts.QuickSecureActionAutomaticallyEncrypt, Texts.QuickSecureActionMonitorMultiple, Texts.QuickSecureActionProtectSensitive, Texts.QuickSecureActionUnlockAdvanced });
                    break;
                default:
                    break;
            }
            //AxCServiceProviderExtension.UpgradeSubscriptionViewModel!.ShowUpgradeDialog();
            return;
        }

        navPageService.SetActivePage(navPage);
    }

    void UpdateUIState(bool result)
    {
        if (!result)
        {
            TabActive = "";
            UpdateActiveTabByNavigation();
        }

        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    // ── SVG icon helpers (inline markup strings) ───────────────
    private RenderFragment HomeIcon => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>;
    private RenderFragment FilesIcon => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>;
    private RenderFragment VaultIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoVlt.svg" width="24" height="24" /></svg>;
    private RenderFragment LockIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoScrts.svg" width="24" height="24" /></svg>;
    private RenderFragment SecuredMessangerIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoScrdMssngr.svg" width="24" height="24" /></svg>;
    private RenderFragment TextEncryptionIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoTxtEncrypt.svg" width="24" height="24" /></svg>;
    private RenderFragment ToolsIcon => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2" /></svg>;
    private RenderFragment ActivityIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoFileLgng.svg" width="24" height="24" /></svg>;
    private RenderFragment FeedbackIcon => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>;
    private RenderFragment SupportIcon => @<svg width="16" height="16" viewBox="0 0 24 24"><image href="images/default/IcoSupport.svg" width="24" height="24" /></svg>;
    private RenderFragment ClockIcon => @<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>;
    // Collapse / Expand chevron icons
    private RenderFragment CollapseIcon => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6" /></svg>;
    private RenderFragment ExpandIcon => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>;
}