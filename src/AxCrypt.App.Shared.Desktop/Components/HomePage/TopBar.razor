@implements IDisposable
@using AxCrypt.App.Shared.Desktop.Components.PopupDialog
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.Core

@inject NavigationManager Navigation
@inject AppSettingsViewModel SettingsViewModel
@inject TopMenuViewModel TopMenuViewModel
@inject IJSRuntime JSRuntime
@inject AppLocalizationOptions? localizationOptions
@inject PopupService popupService
@inject NavPageService navPageService
@inject PaidFeaturegateService paidFeaturegateService
@inject UserService userService

<!-- Top Bar -->
<header class="topbar">
    <div class="topbar-left">
        <h1 class="nav-page-title">@navPageService.CurrentPage.Title</h1>
    </div>
    <div class="topbar-right">
        <!-- Update pill (only when a newer version is available) -->
        @if (TopMenuViewModel.ShowUpdate)
        {
            string variantClass = TopMenuViewModel.IsMandatoryUpdate ? "update-pill--mandatory" : "update-pill--normal";
            string titleText = TopMenuViewModel.IsMandatoryUpdate
            ? "Required security update — install now"
            : (TopMenuViewModel.VersionHoverText ?? Texts.ClickToDownloadText);

            <button class="update-pill @variantClass"
                    title="@titleText"
                    @onclick="OnUpdateClick">
                @if (TopMenuViewModel.IsMandatoryUpdate)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span class="update-pill-label">@Texts.UpdateRequiredText</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="8 12 12 16 16 12" />
                        <line x1="12" y1="3" x2="12" y2="16" />
                        <path d="M5 19h14" />
                    </svg>
                    <span class="update-pill-label">@Texts.UpdateAvailableTitle</span>
                }
                @if (!string.IsNullOrEmpty(TopMenuViewModel.AvailableVersionLabel))
                {
                    <span class="update-pill-version">@TopMenuViewModel.AvailableVersionLabel</span>
                }
            </button>
        }

        <!-- Global Search -->
        <AxCrypt.App.Shared.Desktop.Components.HomePage.GlobalSearchComponent />

        <!-- Help Button -->
        @* <button class="icon-btn" @onclick=" () => { popupService.HelpOverlayOpen = true; navPageService.UpdateViewState(); }" title="Help & Get Started">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
        </button> *@

        <button class="icon-btn notif-bell-btn"
                title="@Texts.PromptNotificationsText"
                aria-label="@Texts.PromptNotificationsText"
                @onclick='() => { popupService.CloseAllPopups(); Navigation.NavigateTo("/notification"); navPageService.SetActivePage("/notification"); }'>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" />
            </svg>
        </button>

        <!-- Settings gear button + popup -->
        <div class="settings-wrapper">
            <button class="icon-btn @(popupService.SettingsMenuOpen ? "icon-btn--active" : "")"
                    @onclick="popupService.ToggleSettingsMenu" title="Settings">
                <img src="images/default/IcoExtrFtrs1.svg" alt="settings gear img" />
            </button>

            @if (popupService.SettingsMenuOpen)
            {
                <div class="settings-menu" @onclick:stopPropagation>
                    <!-- Header -->
                    <div class="sm-header">
                        <span class="sm-title">@Texts.SettingsPageTitle</span>
                        <button class="sm-close" @onclick="popupService.CloseAllPopups">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                        </button>
                    </div>

                    <!-- Language -->
                    <div class="sm-section">
                        <div class="sm-section-label">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="2" y1="12" x2="22" y2="12" />
                                <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
                            </svg>
                            @Texts.OptionsLanguageToolStripMenuItemText
                        </div>
                        <div class="sm-select-wrap">
                            <select class="sm-select"
                                    value="@SettingsViewModel.SelectedLanguage"
                                    @onchange="async (e) => await OnLanguageChangedAsync(e)">
                                @foreach (CultureOption culture in localizationOptions!.SupportedCultures)
                                {
                                    <option value="@culture.Name">@culture.DisplayName</option>
                                }
                            </select>
                            <svg class="sm-select-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </div>
                    </div>

                    <div class="sm-divider"></div>

                    <!-- Inactivity Sign Out -->
                    <div class="sm-section">
                        <div class="sm-section-label">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            @Texts.IdleSignOutToolStripMenuItemText

                            @if (!SettingsViewModel.EnableInActivitySignOut)
                            {
                                <span class="nav-lock-icon" title="Locked! Upgrade to unlock" @onclick="ShowUpgradePopup">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                                </span>
                            }

                        </div>
                        @if (SettingsViewModel.EnableInActivitySignOut)
                        {
                            <div class="sm-radio-group">
                                @foreach (int opt in SettingsViewModel.InactivityTimeoutOptions)
                                {
                                    <label class="sm-radio-item @(SettingsViewModel.InactivitySignOut == opt ? "sm-radio-item--active" : "")">
                                        <input type="radio" name="inactivity" value="@opt"
                                               checked="@(SettingsViewModel.InactivitySignOut == opt)"
                                               @onchange="async (e) => await SettingsViewModel.OnInactivityContextMenu(opt, e)" />
                                        <span class="sm-radio-dot"></span>
                                        @opt mins
                                    </label>
                                }
                            </div>
                        }
                    </div>

                    <div class="sm-divider"></div>

                    <!-- Toggles -->
                    <div class="sm-section">
                        <div class="sm-section-label">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                            </svg>
                            @((MarkupString)Texts.TopBarPrivacySecurity)
                        </div>
                        @foreach (SettingToggle tog in SettingToggles)
                        {
                            bool locked = !tog.IsEnable;
                            <div class="sm-toggle-row settings-menu-item-container @(locked ? "sm-toggle-row--locked" : "")"
                                 @onclick="() => OnSettingToggleRowClick(tog)"
                                 role="@(locked ? "button" : "")"
                                 tabindex="@(locked ? 0 : -1)">
                                <img class="@tog.ImageClass" alt="@tog.ImageClass" />
                                <div class="sm-toggle-info">
                                    <span class="sm-toggle-label">@tog.Label</span>
                                    <span class="sm-toggle-desc">@tog.Description</span>
                                </div>
                                @if (tog.IsEnable)
                                {
                                    <button class="toggle-switch @(tog.IsOn ? "toggle-switch--on" : "")"
                                            @onclick:stopPropagation="true"
                                            @onclick="async () => { await tog.OnClickFunc(); await RefreshComponentAsync(); }">
                                        <span class="toggle-thumb"></span>
                                    </button>
                                }
                                else
                                {
                                    <span class="nav-lock-icon" title="Locked — click to upgrade" aria-hidden="true">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="sm-divider"></div>

                    <button class="sm-advanced-btn" @onclick="OpenPopup">
                        <img src="" class="encrp-file-property" />
                        @Texts.FilePropertiesToolStripMenuItemText
                        <svg class="sm-adv-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>

                    <!-- Advanced Settings link -->
                    <button class="sm-advanced-btn" @onclick="OpenAdvancedPopup">
                        <img src="" class="Ico-advsd-setts" />
                        @Texts.AdvancedSettingsText
                        <svg class="sm-adv-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
    <div class="topbar-subtitle">
        <p class="page-subtitle">@navPageService.CurrentPage.Subtitle</p>
    </div>
</header>

@* ── Popups hoisted outside <header> so position:fixed backdrops
       are not trapped inside the settings-menu's overflow/transform
       containing block. ────────────────────────────────────────── *@
@if (_encOpen)
{
    <EncryptionFilePropertiesPopup IsOpen="@_encOpen" OnClose="ClosePopup" />
}
@if (_advOpen)
{
    <AdvancedOptionsPopup IsOpen="@_advOpen" OnClose="CloseAdvancedPopup" />
}

<AxCrypt.App.Shared.Desktop.Components.HomePage.HelpOverlay />
<AxCrypt.App.Shared.Desktop.Components.PopupDialog.AppConfigurationDialog />
<AxCrypt.App.Shared.Desktop.Components.PopupDialog.VaultSettingsPopup />

<AxCrypt.App.Shared.Desktop.Components.Shared.ProgressBar />
<AxCrypt.App.Shared.Desktop.Components.HomePage.BatchOperationToast />

@* Global error popup — subscribes to ErrorReportService and surfaces any
   exception routed through it (platform UnhandledException handlers and
   inline catch blocks both call ErrorReports.Report). Mounted here so
   it survives page navigation and stays available to every screen. *@
<AxCrypt.App.Shared.Desktop.Components.Shared.ErrorReportPopup />

@code {

    private List<SettingToggle> SettingToggles => BuildSettingToggles();

    private List<SettingToggle> BuildSettingToggles() => new()
    {
        new() { Label=Texts.OptionsHideRecentFilesToolStripMenuItemText, Description=Texts.OptionsHideRecentFilesDescription, IsEnable=true, IsOn=SettingsViewModel.HideRecentFiles, ImageClass = "stngs-menu-icon IcoEye", OnClickFunc = ()=> { SettingsViewModel.ToggleHideRecentFiles(); return Task.CompletedTask; } },
        new() { Label=Texts.AlwaysOffline, Description=Texts.AlwaysOfflineDescription, IsEnable=true, IsOn=SettingsViewModel.AlwaysOffline, ImageClass = "stngs-menu-icon IcoOffln", OnClickFunc = ()=> { SettingsViewModel.ToggleAlwaysOffline(null!); return Task.CompletedTask; }  },
        new() { Label=Texts.OptionsConvertMenuItemText, Description=Texts.OptionsConvertMenuItemDescription, IsEnable=SettingsViewModel.EnableAutoUpgrade,  IsOn=SettingsViewModel.AutoUpgradeToAES256, ImageClass = "stngs-menu-icon Ico256",
                PaidPerks=new[]{Texts.AutoUpgradeFilesAES256,Texts.BackgroundEncryptionMigrationPopup,Texts.OneLatestStandardPopup},
                OnClickFunc = async ()=> await SettingsViewModel.ToggleEncryptionUpgradeMode() },
        new() { Label=Texts.OptionsIncludeSubfoldersToolStripMenuItemText, Description=Texts.OptionsIncludeSubfoldersDescription, IsEnable=SettingsViewModel.EnableIncludeSubfolders, IsOn=SettingsViewModel.IncludeSubfolders, ImageClass = "stngs-menu-icon IcoIncldFldrs24px",
                PaidPerks=new[]{ Texts.EncryptFilesAllSubFoldersPopup, Texts.BatchEncryptMultiplePopup, Texts.KeepFolderStructurePopup, Texts.UnlockAdvancedFolderPopup },
                OnClickFunc = async ()=> await SettingsViewModel.ToggleIncludeSubfolders(null!) },
        new() { Label=SettingsViewModel.DarkTheme ? Texts.SwitchToLightActionText : Texts.SwitchToDarkActionText, Description=Texts.SwitchToDarkActionDescription, IsEnable=true, IsOn=SettingsViewModel.DarkTheme, ImageClass = "stngs-menu-icon IcoDkMd", OnClickFunc = async ()=> await ToggleTheme() },
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        navPageService.OnUpdateViewState += async () => await RefreshComponentAsync();
        popupService.OnChange += async () => await RefreshComponentAsync();
        // Re-render whenever AppSettingsViewModel pushes state (e.g. after
        // password confirmation for AES-256 upgrade or Include Subfolders).
        _onSettingsUpdate = () => _ = RefreshComponentAsync();
        SettingsViewModel.OnUpdateViewState += _onSettingsUpdate;

        SettingsViewModel.Initialized();

        string currentCulture = Resolve.UserSettings.CultureName;
        CultureOption cultureOption = localizationOptions?.SupportedCultures.FirstOrDefault(c => c.Name == currentCulture)!;

        if (cultureOption != null)
        {
            SettingsViewModel.SelectedLanguage = cultureOption.Name;
            SettingsViewModel.SelectedLanguageImageUrl = cultureOption.ImageUrl!;
            SettingsViewModel.SelectedLanguageDisplayName = cultureOption.DisplayName!;
        }

        // Wire up the update-availability indicator. Push state changes
        // (ShowUpdate / IsMandatoryUpdate / VersionHoverText) into a re-render.
        TopMenuViewModel.Initialize();
        TopMenuViewModel.BindPropertyChanged(nameof(TopMenuViewModel.ShowUpdate), async (bool _) => await RefreshComponentAsync());
        TopMenuViewModel.BindPropertyChanged(nameof(TopMenuViewModel.IsMandatoryUpdate), async (bool _) => await RefreshComponentAsync());
    }

    private string SearchQuery { get; set; } = string.Empty;

    private async Task ToggleTheme()
    {
        SettingsViewModel.SwitchDarkMode();
        string savedTheme = SettingsViewModel.DarkTheme ? "dark" : "light";
        await JSRuntime.InvokeVoidAsync("setTheme", savedTheme);
        // Re-render so the toggle label and IsOn state update immediately.
        await RefreshComponentAsync();
    }

    private async Task ChangeLanguageAsync(CultureOption culture)
    {
        SettingsViewModel.SelectedLanguage = culture.Name;
        SettingsViewModel.SelectedLanguageImageUrl = culture.ImageUrl!;
        SettingsViewModel.SelectedLanguageDisplayName = culture.DisplayName!;

        SettingsViewModel.SetLanguageAsync(culture.Name!);

        await JSRuntime.InvokeVoidAsync("setHtmlLang", Core.Resolve.UserSettings.CultureName);

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>
    /// Settings popup row click. For enabled rows we no-op here (the
    /// inner toggle button handles its own click + stopPropagation).
    /// For locked rows we close the settings popup and surface the
    /// tier-targeted paid-gate popup, using the row's PaidPerks as
    /// the pitch copy. CTA in the popup navigates to /upgradePage.
    /// </summary>
    private void OnSettingToggleRowClick(SettingToggle tog)
    {
        if (tog.IsEnable)
        {
            // Toggle is the click target — nothing to do at the row level.
            return;
        }

        popupService.CloseAllPopups();
        paidFeaturegateService.ShowPaidGate(
            feature: tog.Label,
            desc: string.IsNullOrWhiteSpace(tog.Description)
                ? Texts.AvailablePremiumBusinessPlans
                : tog.Description,
            perks: tog.PaidPerks.Length > 0
                ? tog.PaidPerks
                : new[] { Texts.QuickActionUnlimitedFileEncryptions, Texts.SecureKeySharingPopup, Texts.PrioritySupportTitle });
    }

    /// <summary>Handles the language &lt;select&gt; onchange — resolves the
    /// picked culture and delegates to <see cref="ChangeLanguageAsync"/>.</summary>
    private async Task OnLanguageChangedAsync(ChangeEventArgs e)
    {
        string? cultureName = e.Value?.ToString();
        if (string.IsNullOrEmpty(cultureName) || localizationOptions == null)
        {
            return;
        }

        CultureOption? culture = localizationOptions.SupportedCultures
            .FirstOrDefault(c => c.Name == cultureName);
        if (culture == null)
        {
            return;
        }

        await ChangeLanguageAsync(culture);
    }

    private void OnUpdateClick()
    {
        // The "version available" popup is meant to surface ONLY at sign-in
        // (driven by MainViewModel.DownloadVersion → TopMenuViewModel.SetSoftwareStatus
        // → AvailableVersionDialog). Re-running CheckAxCryptVersionAsync here
        // would re-fire that popup every time the user clicks the topbar pill,
        // which is the exact behavior the user reported as unwanted.
        //
        // Since the pill is only rendered when ShowUpdate is true — i.e. we
        // already know an update is available — clicking it should go
        // straight to the download URL. Mirrors the redirect pattern used
        // in AxCrypt.Core/UI/Display.cs.
        Core.BrowseUtility.RedirectTo(Core.Resolve.UserSettings.UpdateUrl.ToString());
    }

    private void ShowUpgradePopup()
    {
        paidFeaturegateService.ShowPaidGate(Texts.IdleSignOutToolStripMenuItemText, Texts.ShowUpgradeAutoSignoutPendingPopup,
        new[]
        {
            Texts.ShowUpgradeAutoSignoutPopup,
            Texts.ShowUpgradeAutoEncryptOpenedPopup,
            Texts.ShowUpgradeProtectSensitivePopup,
            Texts.ShowUpgradeEnhancedSecurityPopup
        });
    }

    private Action? _onSettingsUpdate;

    public void Dispose()
    {
        if (_onSettingsUpdate != null)
        {
            SettingsViewModel.OnUpdateViewState -= _onSettingsUpdate;
            _onSettingsUpdate = null;
        }
    }

    private async Task RefreshComponentAsync()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private bool _encOpen = false;

    private void OpenPopup()
    {
        _encOpen = true;
    }

    private void ClosePopup()
    {
        _encOpen = false;
    }

    private bool _advOpen = false;

    private void OpenAdvancedPopup()
    {
        _advOpen = true;
    }

    private void CloseAdvancedPopup()
    {
        _advOpen = false;
    }

    // ── SVG icon helpers (inline markup strings) ───────────────
    private RenderFragment SearchSvg => @<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>;
    private RenderFragment GearSvg => @<svg width="18" height="18" viewBox="0 0 24 24"><images href="images/default/IcoExtrFtr.svg" /></svg>;
    private RenderFragment MicSvg => @<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" /><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" /></svg>;

}