                StyleClass="pm-Users-icon" },
        new() { Label=Texts.LogOffText, SubLabel="Sign out of this device — your files stay encrypted", Route="/logout", IsDanger=true,
                StyleClass="pm-SngOut-icon" },
        new() { Label=Texts.ExitToolStripMenuItemText, SubLabel="Close the AxCrypt app", Route="/exit", IsDanger=true,
                 StyleClass="pm-Lgng-icon" },
    };

    private async Task OnProfileMenuAction(ProfileMenuItem item)
    {
        popupService.CloseAllPopups();

        switch (item.Route)
        {
            case "/optionsclearallsettingsandexit":
                await profileViewModel!.ClearAllSettingsAndRestartAsync();
                break;

            case "/help":
                profileViewModel!.ViewHelpMenuItemClick();
                break;
            case "/subscriptiondetails":
                await OpenSubscriptiondetailsAsync();
                break;
            case "/manageaccount":
                profileViewModel!.RedirectToMyAxCryptIDPage();
                break;
            case "/logout":
                await profileViewModel!.SignOut();
                break;
            case "/exit":
                await profileViewModel!.ExitMenuItem_Click(null!);
                break;
            default:
                break;
        }

        // if (!string.IsNullOrEmpty(item.Route))
        //     navigationManager.NavigateTo(item.Route);
    }

    private async Task OpenSubscriptiondetailsAsync()
    {
        await JSRuntime.InvokeVoidAsync("triggerClick", "subscription-details-button-action");
    }
}