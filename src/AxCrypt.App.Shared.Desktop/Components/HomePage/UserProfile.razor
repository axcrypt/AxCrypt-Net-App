@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.App.Shared.Desktop.Data

@inject UserService userService
@inject PopupService popupService
@inject ProfileViewModel profileViewModel
@inject IJSRuntime JSRuntime

@implements IDisposable

@* ── Profile row (sidebar footer trigger) ──────────────────────── *@
<div class="user-row @(popupService.ProfileMenuOpen ? "user-row--active" : "")"
     role="button"
     tabindex="0"
     @onclick="ToggleMenu"
     @onkeydown="OnRowKeyDown">
    <div class="avatar" style="background:@userService.UserAvatarColor()">@userService.UserInitials()</div>
    <div class="user-details">
        <span class="user-name">@userService.UserEmail</span>
    </div>
    <span class="profile-chevron @(popupService.ProfileMenuOpen ? "profile-chevron--open" : "")" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="18 15 12 9 6 15" />
        </svg>
    </span>
</div>

@* ── Profile popup menu ─────────────────────────────────────────── *@
@if (popupService.ProfileMenuOpen)
{
    <div class="profile-menu" @onclick:stopPropagation>

        @* Header — avatar + email + plan badge *@
        <div class="profile-menu-header">
            <div class="pm-avatar" style="background:@userService.UserAvatarColor()">@userService.UserInitials()</div>
            <div class="pm-info">
                <span class="pm-name">@userService.UserEmail</span>
                <span class="pm-plan-badge">@userService.SubscriptionLevel</span>
            </div>
        </div>

        <div class="pm-divider"></div>

        @* Menu items *@
        @foreach (ProfileMenuItem item in ProfileMenuItems)
        {
            @if (item.IsDivider)
            {
                <div class="pm-divider"></div>
            }
            else
            {
                <button class="pm-item @(item.IsDanger ? "pm-item--danger" : "")"
                        @onclick="() => OnProfileMenuAction(item)">
                    <span class="pm-item-icon" aria-hidden="true">
                        @((MarkupString)item.IconSvg)
                    </span>
                    <div class="pm-item-text">
                        <span class="pm-item-label">@item.Label</span>
                        @if (!string.IsNullOrEmpty(item.SubLabel))
                        {
                            <span class="pm-item-sub">@item.SubLabel</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(item.Badge))
                    {
                        <span class="pm-item-badge">@item.Badge</span>
                    }
                </button>
            }
        }
    </div>

    @* Hidden trigger for the SubscriptionDetails JS interaction *@
    <button id="subscription-details-button-action" style="display:none;"></button>
}

<AxCrypt.App.Shared.Desktop.Components.HomePage.SubscriptionDetails />

@code {
    private const string EnterKey = "Enter";

    // ── Icons ──────────────────────────────────────────────────────
    // All 16×16 stroke icons — consistent weight (stroke-width 2),
    // inherit color so they adapt to both default and danger states.

    private const string IcoSettings =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<circle cx='12' cy='12' r='3'/>" +
        "<path d='M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M2 12h2M20 12h2M4.93 4.93l1.41 1.41M18.66 18.66l1.41 1.41M12 2v2M12 20v2'/>" +
        "</svg>";

    private const string IcoHelp =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<circle cx='12' cy='12' r='10'/>" +
        "<path d='M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3'/>" +
        "<line x1='12' y1='17' x2='12.01' y2='17'/>" +
        "</svg>";

    private const string IcoCreditCard =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<rect x='1' y='4' width='22' height='16' rx='2'/>" +
        "<line x1='1' y1='10' x2='23' y2='10'/>" +
        "</svg>";

    private const string IcoUser =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<path d='M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2'/>" +
        "<circle cx='12' cy='7' r='4'/>" +
        "</svg>";

    private const string IcoLogOut =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<path d='M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4'/>" +
        "<polyline points='16 17 21 12 16 7'/>" +
        "<line x1='21' y1='12' x2='9' y2='12'/>" +
        "</svg>";

    private const string IcoPower =
        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" +
        "<path d='M18.36 6.64a9 9 0 11-12.73 0'/>" +
        "<line x1='12' y1='2' x2='12' y2='12'/>" +
        "</svg>";

    // ── Menu items ─────────────────────────────────────────────────
    private List<ProfileMenuItem> ProfileMenuItems => new()
    {
        new() {
            Label    = Texts.OptionsClearAllSettingsAndExitToolStripMenuItemText,
            SubLabel = Texts.OptionsClearAllSettingsAndExitSubTitle,
            Route    = "/optionsclearallsettingsandexit",
            IconSvg  = IcoSettings,
        },
        new() {
            Label    = Texts.HelpToolStripMenuItemText,
            SubLabel = Texts.HelpToolSubTitle,
            Route    = "/help",
            IconSvg  = IcoHelp,
        },
        new() {
            Label    = Texts.SubscriptionDetailsTitle,
            SubLabel = Texts.SubscriptionDetailsSubTitle,
            Route    = "/subscriptiondetails",
            IconSvg  = IcoCreditCard,
        },
        new() {
            Label    = Texts.DebugManageAccountToolStripMenuItemText,
            SubLabel = Texts.DebugManageAccountSubTitle,
            Route    = "/manageaccount",
            IconSvg  = IcoUser,
        },
        new() { IsDivider = true },
        new() {
            Label    = Texts.LogOffText,
            SubLabel = Texts.LogOffSubTitle,
            Route    = "/logout",
            IconSvg  = IcoLogOut,
            IsDanger = true,
        },
        new() {
            Label    = Texts.ExitToolStripMenuItemText,
            SubLabel = Texts.ExitToolSubTitle,
            Route    = "/exit",
            IconSvg  = IcoPower,
            IsDanger = true,
        },
    };

    // ── Lifecycle ──────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await profileViewModel!.InitializeAsync();

        // Resumed-session fallback: if the user is already signed in by the
        // time this component mounts, pull the email from KnownIdentities so
        // the avatar and name render on first paint without waiting for a
        // property-changed callback from LogOnViewModel.
        try
        {
            string knownEmail = Resolve.KnownIdentities?.DefaultEncryptionIdentity?.UserEmail?.Address ?? string.Empty;
            if (string.IsNullOrWhiteSpace(userService.UserEmail) && !string.IsNullOrWhiteSpace(knownEmail))
                userService.InitializeData(profileViewModel.Account.SubscriptionLevel, knownEmail);
        }
        catch
        {
            // Identity not ready yet — UserService will fill in once
            // LogOnViewModel.LoggedOn fires its property-changed callback.
        }

        popupService.OnChange += UpdatePageState;
        userService.OnChange  += UpdatePageState;
    }

    public void Dispose()
    {
        popupService.OnChange -= UpdatePageState;
        userService.OnChange  -= UpdatePageState;
    }

    private void UpdatePageState() => InvokeAsync(StateHasChanged);

    // ── Interaction ────────────────────────────────────────────────
    private void ToggleMenu()
    {
        if (Utility.IsMainMenuHidden)
            Utility.ToggleMainMenu();
        popupService.ToggleProfileMenu();
    }

    private void OnRowKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == EnterKey)
            popupService.ToggleProfileMenu();
    }

    private async Task OnProfileMenuAction(ProfileMenuItem item)
    {
        popupService.CloseAllPopups();

        switch (item.Route)
        {
            case "/optionsclearallsettingsandexit":
                await profileViewModel!.ClearAllSettingsAndRestartAsync();
                break;
            case "/help":
                profileViewModel!.ViewHelpMenuItemClick();
                break;
            case "/subscriptiondetails":
                await JSRuntime.InvokeVoidAsync("triggerClick", "subscription-details-button-action");
                break;
            case "/manageaccount":
                profileViewModel!.RedirectToMyAxCryptIDPage();
                break;
            case "/logout":
                await profileViewModel!.SignOut();
                break;
            case "/exit":
                await profileViewModel!.ExitMenuItem_Click(null!);
                break;
        }
    }
}
