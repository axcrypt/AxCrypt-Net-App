@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content
@using AxCrypt.Core
@using static AxCrypt.Abstractions.TypeResolve

@inject UserService userService
@inject PopupService popupService
@inject ProfileViewModel profileViewModel
@inject IJSRuntime JSRuntime

@implements IDisposable

<!-- Clickable profile row -->
<div class="user-row @(popupService.ProfileMenuOpen ? "user-row--active" : "")"
        @onclick="popupService.ToggleProfileMenu" role="button" tabindex="0"
        @onkeydown="(e) => { if (e.Key == EnterText) popupService.ToggleProfileMenu(); }">
    <div class="avatar" style="background:@userService.UserAvatarColor()">@userService.UserInitials()</div>
    <div class="user-details">
        <span class="user-name">@userService.UserEmail</span>
        @* <span class="user-sub">@userService.UserEmail</span> *@
    </div>
    <span class="profile-chevron @(popupService.ProfileMenuOpen ? "profile-chevron--open" : "")">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="18 15 12 9 6 15" />
        </svg>
    </span>
</div>

<!-- Profile Popup Menu (anchored above footer) -->
@if (popupService.ProfileMenuOpen)
{
    <div class="profile-menu" @onclick:stopPropagation>
        <!-- Header -->
        <div class="profile-menu-header">
            <div class="pm-avatar" style="background:@userService.UserAvatarColor()">@userService.UserInitials()</div>
            <div class="pm-info">
                <span class="pm-name">@userService.UserEmail</span>
                @* <span class="pm-email">@userService.UserEmail</span> *@
                <span class="pm-plan-badge">@userService.SubscriptionLevel</span>
            </div>
        </div>
        <div class="pm-divider"></div>

        <!-- Menu Items -->
        @foreach (ProfileMenuItem item in ProfileMenuItems)
        {
            @if (item.IsDivider)
            {
                <div class="pm-divider"></div>
            }
            else
            {
                <button class="pm-item @(item.IsDanger ? "pm-item--danger" : "")"
                        @onclick="() => OnProfileMenuAction(item)">
                    <span class="pm-item-icon @item.StyleClass">@((MarkupString)item.IconSvg)</span>
                    <div class="pm-item-text">
                        <span class="pm-item-label">@item.Label</span>
                        @if (!string.IsNullOrEmpty(item.SubLabel))
                        {
                            <span class="pm-item-sub">@item.SubLabel</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(item.Badge))
                    {
                        <span class="pm-item-badge">@item.Badge</span>
                    }
                </button>
            }
        }
    </div>
    <button id="subscription-details-button-action" style="display:none;"></button>
}

<AxCrypt.App.Shared.Desktop.Components.HomePage.SubscriptionDetails />

@code {
    private string EnterText = "Enter";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await profileViewModel!.InitializeAsync();

        // Resumed-session fallback: if the user is already signed in by the
        // time this component mounts (LoggedOn was already true), the
        // LogOnViewModel binding that normally pushes data to UserService
        // never fires. Pull the email from the known identity here so the
        // avatar + name render on first paint — no click required.
        try
        {
            string knownEmail = Resolve.KnownIdentities?.DefaultEncryptionIdentity?.UserEmail?.Address ?? string.Empty;
            if (string.IsNullOrWhiteSpace(userService.UserEmail) && !string.IsNullOrWhiteSpace(knownEmail))
            {
                userService.InitializeData(profileViewModel.Account.SubscriptionLevel, knownEmail);
            }
        }
        catch
        {
            // Identity not ready yet — UserService will fill in once
            // LogOnViewModel.LoggedOn fires its property-changed callback.
        }

        // Re-render whenever the popup state OR the underlying user data
        // changes. The latter is the actual fix: UserService.Notify() now
        // fires from InitializeData so the email + initials show up live.
        popupService.OnChange += UpdatePageState;
        userService.OnChange += UpdatePageState;
    }

    public void Dispose()
    {
        popupService.OnChange -= UpdatePageState;
        userService.OnChange -= UpdatePageState;
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

