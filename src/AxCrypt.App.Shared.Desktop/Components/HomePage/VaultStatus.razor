@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content
@using AxCrypt.Core

@inject NavigationManager Navigation
@inject UserService userService
@inject PaidFeaturegateService paidFeaturegateService
@inject SubActionViewModel? subActionModel
@inject FileDropService FileDropService

<section class="card">
    <div class="card-hdr">
        <h2 class="section-title">Vault Status</h2>
        @if (userService.IsFreeTier)
        {
            <span class="pro-pill" @onclick="ShowUpgradePopup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg></span>
        }
    </div>

    <div class="vault-body @(userService.IsFreeTier ? "blurred" : "")">
        @* @if (subActionModel!.EnableVault) *@
        @if (string.IsNullOrEmpty(Resolve.UserSettings.VaultEncryptDataPath))
        {
            <div class="vault-row vault-row--path">
                <span class="vault-folder-ico">@FolderSvg</span>
                <span class="vault-path">Not configured</span>
                <span class="vault-chevron">@ChevronRightSvg</span>
            </div>
        }
        else
        {
            <div class="vault-row vault-row--path">
                <span class="vault-folder-ico">@FolderSvg</span>
                <span class="vault-path">@(Resolve.UserSettings.VaultEncryptDataPath ?? "")</span>
                <span class="vault-chevron">@ChevronRightSvg</span>
            </div>

            <div class="vault-row">
                <span class="vault-auto-ico">@ShieldSmSvg</span>
                <span>Auto-encryption is <strong>ON</strong></span>
            </div>

@*             <div class="vault-row">
                <span class="vault-count">@ProtectedCount</span>
                <span>Files protected – AES-256</span>
            </div> *@
        }
    </div>
    @if (userService.IsFreeTier)
    {
        <div class="locked-overlay" @onclick="ShowUpgradePopup">
            <div class="lo-title">Secure Vault is a paid feature</div>
            <div class="lo-desc">Unlock unlimited protected storage, and auto-encryption.</div>
            <button class="lo-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /></svg>Upgrade to unlock</button>
        </div>
    }
    else
    {
        string vaultActionLabel = string.IsNullOrEmpty(Resolve.UserSettings.VaultEncryptDataPath) ? "Setup Vault" : "Manage Vault";
        <button class="manage-btn" @onclick='ValidateVaultNavigation'>
            @vaultActionLabel @ChevronRightSvg
        </button>
    }
</section>

@code {
    private int ProtectedCount { get; set; } = 45;

    private RenderFragment ShieldSmSvg => @<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" /></svg>;
    private RenderFragment ChevronRightSvg => @<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>;
    private RenderFragment FolderSvg => @<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>;

    private void ShowUpgradePopup()
    {
        paidFeaturegateService.ShowPaidGate(Texts.VaultText, "Store and protect your sensitive files securely in encrypted vaults.", new[] { "Create secure encrypted vaults", "Protect important files and folders", "Access advanced vault security", "Unlock premium protection features" });
    }

    private async Task ValidateVaultNavigation()
    {
        bool isValid = await subActionModel!.ValidateVaultPath();
        if (isValid)
        {
            FileDropService.CurrentPage = "/vault";
            Navigation.NavigateTo("/vault");
        }
    }
}