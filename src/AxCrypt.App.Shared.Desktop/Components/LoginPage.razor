@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.UI.ViewModel

@inject IJSRuntime JSRuntime
@inject LogOnViewModel LogOnViewModel
@inject RegisterViewModel RegisterModel
@inject ProfileViewModel profileViewModel
@inject SwitchUserViewModel SwitchUserModel
@inject PopupService popupService

@inject NavigationManager navigationManager

@implements IDisposable

@if (LogOnViewModel.LogOnAccountModel != null)
{
    <section class="content">
        <article class="left-section" id="content-wrap">
            <h1 class="login-title hg-img">@Texts.WelcomeBackTitle</h1>
            <span class="sub-head">@Texts.LogInText</span>

            <EditForm Model="@LogOnViewModel.LogOnAccountModel" OnValidSubmit="ButtonLogIn_Click" class="signup-sec">
                @if (!string.IsNullOrEmpty(LogOnViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger">@LogOnViewModel.ErrorMessage</div>
                }
                <div style="display:flex;">
                    <div style="width:100%;">
                        <label>@Texts.EmailLabel</label>
                        @if (!LogOnViewModel.LogOnAccountModel.ReadOnlyUserEmail)
                        {
                            <input type="text" id="useremail-txtbox" @bind-value="LogOnViewModel.LogOnAccountModel.UserEmail"
                                   class="form-control email-img" placeholder=@Texts.TypeYourEmailPlaceHolderText tabindex="1" autocomplete="off" />
                        }
                        else
                        {
                            <input type="text" id="useremail-txtbox" @bind-value="LogOnViewModel.LogOnAccountModel.UserEmail"
                                   class="form-control email-img" tabindex="1" readonly="readonly" />
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail) || SwitchUserModel.UserProfilesList.Any(up => up.UserEmail != ""))
                {
                    <div style="width:100%;">
                        @* The popup itself (SwitchUserPopup) gates on
                           popupService.SwitchUserPopupOpen — so the click
                           needs to flip THAT flag. The previous call to
                           LogOnViewModel.ShowSwitchUserDialog toggled a
                           different state the popup wasn't watching, so
                           the link did nothing visible. *@
                        <a href="javascript:void(0)" class="nav-link grn-clr" style="float:right;" tabindex="3" @onclick="popupService.ToggleSwitchUserPopupOpen">@Texts.SwitchUserButtonText</a>
                    </div>
                }
                <div>
                    <label>@Texts.PassphrasePrompt</label>
                    <div style="position:relative; display:inline-block; width:100%;">
                        <i class="@PasswordIconClass" @onclick="TogglePassword"></i>
                        <input type="@PasswordInputType" id="password-txtbox"
                               @bind-value="LogOnViewModel.LogOnAccountModel.PasswordText" class="form-control pswd-img"
                               placeholder=@Texts.TypeYourPasswordPlaceHolderText tabindex="2" />
                    </div>
                </div>
                <br />

                <button class="button success grn-bg whte-clr" style="width:100%; margin: 20px 0px;"
                        tabindex="3">
                    @Texts.LogInText
                </button>
            </EditForm>

            <div class="lp-or">
                <hr class="lp-or-line" />
                <span class="lp-or-text">@Texts.OrText</span>
                <hr class="lp-or-line" />
            </div>
            <div id="OtherOptions-Section" style="text-align: center;border-radius: 4px;">
                <div class="dropdown" style="padding-bottom: 10px;">
                    <div class="action-buttons" style="display: inline-flex;">
                        @* Inline SVG chevron — rotates with the open state.
                           The old <img src=""> also carried id="lang-action-btn-arw",
                           which duplicated the LanguagesComponent's arrow id and
                           made homepopup.js toggle the wrong element. *@
                        <button type="button" class="lp-other-toggle" @onclick="ToggleDropdown">
                            @Texts.OtherLogOptions
                            <svg class="lp-other-arrow @(showDropdown ? "lp-other-arrow--open" : "")"
                                 width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <polyline points="18 15 12 9 6 15" />
                            </svg>
                        </button>
                    </div>
                    @if (showDropdown)
                    {
                        <div class="dropup-content hide-model-popup">
                            <a @onclick="async () => await InitiateImportAxCryptIdOnSignIn()"
                               style="padding: 8px;">@Texts.ImportMyPrivateKeyToolStripMenuItemText</a>
                            @if (LogOnViewModel.IsOffline)
                            {
                                <a @onclick="OpenCreateAxCryptIdOnSignIn" style="padding: 8px;">@Texts.TitleCreateAxCryptIdTitle</a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="signup-link">
                <div style="display:inline-flex; align-items:center;">
                    <span class="che-txt">@Texts.DontaccountText</span>
                    <NavLink class="nav-link grn-clr" @onclick="CreateNewAccountLabel_LinkClicked" tabindex="4">
                        <span>@Texts.PromptSignUp</span>
                    </NavLink>
                </div><br />
                <NavLink class="nav-link grn-clr" @onclick="ForgetPassword_ButtonClicked" tabindex="5">
                    <span>@Texts.PasswordResetShortLink?</span>
                </NavLink>
            </div>

            <div class="che-txt text-center" style="color:#494949; margin-top:20px;">
                @Texts.AgreeOurText <NavLink class="grn-clr" @onclick="RedirectToPrivacyPolicy">
                    @Texts.PrivacyPolicyLinkLabel
                </NavLink> @Texts.AndText
                <NavLink class="grn-clr" @onclick="RedirectToTermsOfUse">@Texts.TermsOfUseLinkLabel</NavLink>
            </div>

            @* Sign-in loader — a small card overlaid on top of the
               login form. The form stays mounted underneath (dimmed
               by the scrim) so there's no layout jump, and the loader
               is clearly scoped to the login action rather than
               floating disconnected at the page top. *@
            @if (_isSubmitting)
            {
                <div class="login-loader-overlay">
                    <div class="login-loader-card">
                        <AxCrypt.App.Shared.Desktop.Components.Shared.AxLoader
                            Mode="AxCrypt.App.Shared.Desktop.Components.Shared.LoaderMode.Body"
                            Message="@_statusMessage" />
                    </div>
                </div>
            }

        </article>
        <article class="right-section">
            <div class="signin-right-img">
                <div class="login-lang-drpdwn">
                    <AxCrypt.App.Shared.Desktop.Components.Main.Header.LanguagesComponent />
                </div>
            </div>
        </article>

        <AxCrypt.App.Shared.Desktop.Components.PopupDialog.SwitchUserPopup />
    </section>
}
@code {

    private bool isPasswordVisible = false;

    // Inline sign-in loader state. _isSubmitting swaps the form for the
    // AxLoader inside the login section; _statusMessage is the action
    // text shown under the wheel ("Validating…", "Signing you in…").
    private bool _isSubmitting = false;
    private string _statusMessage = string.Empty;

    private string PasswordInputType => isPasswordVisible ? "text" : "password";

    private string PasswordIconClass =>
    isPasswordVisible ? "fa-eye-slash" : "fa-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    private bool showDropdown = false;

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    public bool IsEmailReadOnly { get; set; }

    // Held in a field so it can be unsubscribed in Dispose — an
    // anonymous lambda passed straight to += can never be removed,
    // which leaks this component every time the sign-in page mounts.
    private Action? _onUpdateViewState;

    protected override async Task OnInitializedAsync()
    {
        _onUpdateViewState = async () => await RefreshComponentAsync();
        LogOnViewModel.OnUpdateViewState += _onUpdateViewState;
        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        if (_onUpdateViewState != null)
        {
            LogOnViewModel.OnUpdateViewState -= _onUpdateViewState;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string autoFocusField = string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail) ? "useremail-txtbox" :
            "password-txtbox";
            await JSRuntime.InvokeVoidAsync("loginFunctions.focusElement", autoFocusField);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ButtonLogIn_Click()
    {
        LogOnViewModel.PageResult = DialogResult.None;
        if (isPasswordVisible)
        {
            TogglePassword();
        }

        // Show the inline loader inside the login section (replaces the
        // form). No global ProcessIndicator — that's what used to float
        // the wheel over the whole page.
        _isSubmitting = true;
        _statusMessage = "Validating your details…";
        await RefreshComponentAsync();

        if (!await AdHocValidationDueToMonoLimitations())
        {
            // Validation failed — bring the form back so the user can
            // correct the email / password.
            _isSubmitting = false;
            await RefreshComponentAsync();
            return;
        }

        // Validation passed — keep the loader up through the actual
        // sign-in handshake. The page navigates away once sign-in
        // completes, so the loader naturally disappears with it.
        _statusMessage = "Signing you in…";
        await RefreshComponentAsync();

        LogOnViewModel.PageResult = DialogResult.OK;
    }

    private async Task RefreshComponentAsync()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private async Task<bool> AdHocValidationDueToMonoLimitations()
    {
        if (!AdHocValidateUserEmail())
        {
            return false;
        }

        if (!string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.EncryptedFileFullName))
        {
            return await AdHocValidatePassphraseForFile();
        }

        if (!await AdHocValidatePassphrase())
        {
            return false;
        }

        bool created = SwitchUserModel.AddNewUser(LogOnViewModel.LogOnAccountModel.UserEmail, LogOnViewModel.SubscriptionLevel.ToString());
        return true;
    }

    private bool AdHocValidateUserEmail()
    {
        LogOnViewModel.ErrorMessage = "";
        if (string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail))
        {
            LogOnViewModel.ErrorMessage = Texts.BadEmail;
            return false;
        }

        if (LogOnViewModel.LogOnAccountModel[nameof(AccountEmailViewModel.UserEmail)].Length > 0)
        {
            LogOnViewModel.ErrorMessage = Texts.BadEmail;
            return false;
        }

        return true;
    }

    private async Task<bool> AdHocValidatePassphrase()
    {
        LogOnViewModel.CurrentUserDevice = AxCrypt.App.Shared.Desktop.Data.Utility.GetCurrentDevice();
        LogOnViewModel.ErrorMessage = "";
        if (!await LogOnViewModel.LogOnAccountModel.ValidateItemAsync(nameof(LogOnViewModel.LogOnAccountModel.PasswordText)))
        {
            LogOnViewModel.ErrorMessage = Texts.WrongPassphrase;
            return false;
        }
        return true;
    }

    private async Task<bool> AdHocValidatePassphraseForFile()
    {
        LogOnViewModel.ErrorMessage = "";
        if (!await
        LogOnViewModel.LogOnAccountModel.ValidateItemAsync(nameof(LogOnViewModel.LogOnAccountModel.EncryptedFileFullName)))
        {
            LogOnViewModel.ErrorMessage = Texts.WrongPassphrase;
            return false;
        }
        return true;
    }

    private async Task InitiateImportAxCryptIdOnSignIn()
    {
        await profileViewModel.HandleImportAndExportKeys(KeyManagement.ImportAxCryptID);
        if (LogOnViewModel.IsLoggedOn)
        {
            LogOnViewModel.PageResult = DialogResult.OK;
        }
    }

    private void OpenCreateAxCryptIdOnSignIn()
    {
        LogOnViewModel.PageResult = DialogResult.Cancel;
        Task.Run(async () =>
        {
            await profileViewModel.HandleImportAndExportKeys(KeyManagement.CreateAxCryptID);

            if (!RegisterModel.ShowSignUp && !LogOnViewModel.IsVisible)
            {
                LogOnViewModel.PageResult = DialogResult.None;
                await LogOnViewModel.FileOperationViewModel.IdentityViewModel.AskForLogOnPassphrase.ExecuteAsync(LogOnIdentity.Empty);
            }

        });
    }

    private async Task CreateNewAccountLabel_LinkClicked(EventArgs e)
    {
        // Keep the legacy LoginPage in sync with LoginPageNew — instead of
        // bouncing the user out to the web signup, drive the in-app
        // RegisterPage. Account creation finishes locally; the existing
        // post-signup flow continues to the web for the payment step.
        string passphrase = LogOnViewModel.LogOnAccountModel?.PasswordText ?? string.Empty;
        AxCrypt.Core.UI.EmailAddress email = AxCrypt.Core.UI.EmailAddress.Empty;
        if (!string.IsNullOrWhiteSpace(LogOnViewModel.LogOnAccountModel?.UserEmail)
            && AxCrypt.Core.UI.EmailAddress.TryParse(LogOnViewModel.LogOnAccountModel!.UserEmail, out AxCrypt.Core.UI.EmailAddress parsed))
        {
            email = parsed;
        }

        LogOnViewModel.IsVisible = false;
        await RegisterModel.ShowDialog(passphrase, email);

        if (RegisterModel.DialogResult == DialogResult.Cancel)
        {
            LogOnViewModel.IsVisible = true;
        }
    }

    private void ForgetPassword_ButtonClicked(EventArgs e)
    {
        BrowseUtility.RedirectToAccountWebUrl(Texts.PasswordResetHyperLink);
    }

    private void RedirectToTermsOfUse(EventArgs e)
    {
        BrowseUtility.RedirectTo("https://axcrypt.net/information/terms-of-use/");
    }

    private void RedirectToPrivacyPolicy(EventArgs e)
    {
        BrowseUtility.RedirectTo("https://axcrypt.net/information/privacy-policy/");
    }
}

<style>
    /* Sign-in loader overlay — scoped to the login form column
       (.left-section is position:relative). A light scrim dims the
       form underneath; the card floats centred on top. No layout
       shift, form stays in the DOM. */
    .login-loader-overlay {
        position: absolute;
        inset: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.66);
        backdrop-filter: blur(2px);
        animation: login-loader-fade 0.14s ease-out;
    }

    @@keyframes login-loader-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .login-loader-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.16), 0 3px 10px rgba(0, 0, 0, 0.08);
        padding: 22px 30px;
        min-width: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    html[data-theme="dark"] .login-loader-overlay {
        background: rgba(15, 23, 42, 0.6);
    }

    html[data-theme="dark"] .login-loader-card {
        background: #1a1d23;
        border-color: #2a2e36;
    }

    /* "Or" divider between the sign-in form and the other-options
       menu. Replaces an inline-styled block that used negative
       margins and an invalid `padding-top: -4px`. */
    .lp-or {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 90%;
        margin: 16px 0;
    }

    .lp-or-line {
        flex: 1;
        border: none;
        border-top: 1px solid #d0d4d9;
        margin: 0;
    }

    .lp-or-text {
        font-size: 13px;
        color: #6b7280;
    }

    /* "Other sign-in options" toggle + chevron. */
    .lp-other-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 310px;
        color: #48772c;
        font-weight: 600;
        text-align: center;
        background: none;
        border: none;
        cursor: pointer;
    }

    .lp-other-arrow {
        transition: transform .18s ease;
    }

    .lp-other-arrow--open {
        transform: rotate(180deg);
    }

    html[data-theme="dark"] .lp-or-line {
        border-top-color: #2a2e36;
    }

    html[data-theme="dark"] .lp-or-text {
        color: #9ca3af;
    }
</style>

<script type="text/javascript">
    window.loginFunctions = {
        focusElement: function (id) {
            const element = document.getElementById(id);
            if (element) element.focus();
        }
    }
</script>