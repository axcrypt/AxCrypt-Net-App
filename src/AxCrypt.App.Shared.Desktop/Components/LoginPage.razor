@page "/login"
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.UI.ViewModel

@inject IJSRuntime JSRuntime
@inject LogOnViewModel LogOnViewModel
@inject RegisterViewModel RegisterModel
@inject ProfileViewModel profileViewModel
@inject SwitchUserViewModel SwitchUserModel
@inject PopupService popupService
@inject NavigationManager navigationManager

@using AxCrypt.App.Shared.Desktop.Components.Shared
@implements IDisposable

@if (LogOnViewModel.LogOnAccountModel != null)
{
    <section class="lp-shell">

        @* ── Brand panel (left) ─────────────────────────── *@
        <aside class="lp-brand">
            <div class="lp-brand-bg"></div>
            @* AxCrypt mark embedded into the panel background, bottom. *@
            <img class="lp-brand-key" src="images/axcryptIcon.png" alt="" aria-hidden="true" />

            <div class="lp-brand-inner">
                @* Full AxCrypt logo, top-left. *@
                <div class="lp-brand-mark">
                    <img class="lp-brand-logo-img" src="images/axcrypt_text.png" alt="AxCrypt" />
                </div>

                <h1 class="lp-brand-headline">
                    @Texts.YourFilesText<br />
                    @Texts.ProtectedEverywhereText<br />
                    <span class="lp-brand-emphasis">@Texts.AlwaysText</span>
                </h1>

                <p class="lp-brand-sub">
                    @Texts.VerifyMFABrandSubTitle
                </p>

                <ul class="lp-brand-pills" aria-label="Why AxCrypt">
                    <li>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @Texts.VerifyMFAWhyAxCryptLabel
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @Texts.VerifyMFASecureCloudStorage
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @Texts.VerifyMFAWorksAcrossDevices
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @((MarkupString)Texts.VerifyMFAOffline)
                    </li>
                </ul>
            </div>

            <div class="lp-brand-footer">© AxCrypt — File security made easy</div>
        </aside>

        @* ── Form panel (right) ─────────────────────────── *@
        <article class="lp-form" id="content-wrap">
            <div class="lp-topbar">
                <div class="login-lang-drpdwn lp-lang">
                    <AxCrypt.App.Shared.Desktop.Components.Shared.LanguagesComponent />
                </div>
            </div>

            <div class="lp-form-inner">

                <div class="lp-form-head">
                    <h2 class="lp-title">@Texts.WelcomeBackTitle</h2>
                    <p class="lp-sub">@Texts.LogInText to your account to continue.</p>
                </div>

                <EditForm Model="@LogOnViewModel.LogOnAccountModel" OnValidSubmit="ButtonLogIn_Click" class="lp-form-fields">

                        @if (!string.IsNullOrEmpty(LogOnViewModel.ErrorMessage))
                        {
                            <div class="lp-error" role="alert">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="8" x2="12" y2="12"/>
                                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                                <span>@LogOnViewModel.ErrorMessage</span>
                            </div>
                        }

                        @* Email row ───────────────────────────── *@
                        <div class="lp-field">
                            <div class="lp-field-head">
                                <label for="useremail-txtbox">@Texts.EmailLabel</label>
                                @if (!string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail)
                                     || SwitchUserModel.UserProfilesList.Any(up => up.UserEmail != ""))
                                {
                                    <button type="button"
                                            class="lp-link lp-link--mini"
                                            @onclick="popupService.ToggleSwitchUserPopupOpen"
                                            tabindex="3">
                                        @Texts.SwitchUserButtonText
                                    </button>
                                }
                            </div>
                            @if (!LogOnViewModel.LogOnAccountModel.ReadOnlyUserEmail)
                            {
                                <input type="email"
                                       id="useremail-txtbox"
                                       class="lp-input"
                                       @bind-value="LogOnViewModel.LogOnAccountModel.UserEmail"
                                       @bind-value:event="oninput"
                                       placeholder="@Texts.TypeYourEmailPlaceHolderText"
                                       autocomplete="email"
                                       tabindex="1" />
                            }
                            else
                            {
                                <input type="email"
                                       id="useremail-txtbox"
                                       class="lp-input lp-input--readonly"
                                       @bind-value="LogOnViewModel.LogOnAccountModel.UserEmail"
                                       readonly="readonly"
                                       tabindex="1" />
                            }
                        </div>

                        @* Password row (progressively revealed) ─── *@
                        @if (PasswordVisible)
                        {
                            <div class="lp-field lp-field--reveal">
                                <div class="lp-field-head">
                                    <label for="password-txtbox">@Texts.PassphrasePrompt</label>
                                    <NavLink class="lp-link lp-link--mini"
                                             @onclick="ForgetPassword_ButtonClicked"
                                             tabindex="5">
                                        @Texts.PasswordResetShortLink?
                                    </NavLink>
                                </div>
                                <div class="lp-input-wrap">
                                    <input type="@PasswordInputType"
                                           id="password-txtbox"
                                           class="lp-input lp-input--password"
                                           @bind-value="LogOnViewModel.LogOnAccountModel.PasswordText"
                                           placeholder="@Texts.TypeYourPasswordPlaceHolderText"
                                           autocomplete="current-password"
                                           tabindex="2" />
                                    <button type="button"
                                            class="lp-eye"
                                            tabindex="-1"
                                            aria-label="@(isPasswordVisible ? "Hide password" : "Show password")"
                                            @onclick="TogglePassword">
                                        @if (isPasswordVisible)
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24"/>
                                                <line x1="1" y1="1" x2="23" y2="23"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                        <button class="lp-submit @(_isSubmitting ? "lp-submit--loading" : "")"
                                tabindex="3"
                                disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="lp-submit-spinner" aria-hidden="true"></span>
                            <span>@Texts.SigningYouInText</span>
                            }
                            else
                            {
                                <span>@(PasswordVisible ? Texts.LogInText : "Continue")</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                    <polyline points="12 5 19 12 12 19"/>
                                </svg>
                            }
                        </button>
                    </EditForm>

                    @* Or-divider ─────────────────────────────── *@
                    <div class="lp-divider"><span>@Texts.OrText</span></div>

                    @* Other options dropdown ─────────────────── *@
                    <div class="lp-other">
                        <button type="button"
                                class="lp-other-toggle"
                                @onclick="ToggleDropdown"
                                aria-expanded="@showDropdown">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                            </svg>
                            @Texts.OtherLogOptions
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                 class="@(showDropdown ? "lp-other-arrow lp-other-arrow--open" : "lp-other-arrow")">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </button>

                        @if (showDropdown)
                        {
                            <div class="lp-other-menu">
                                <button type="button"
                                        class="lp-other-item"
                                        @onclick="async () => await InitiateImportAxCryptIdOnSignIn()">
                                    @Texts.ImportMyPrivateKeyToolStripMenuItemText
                                </button>
                                @if (LogOnViewModel.IsOffline)
                                {
                                    <button type="button"
                                            class="lp-other-item"
                                            @onclick="OpenCreateAxCryptIdOnSignIn">
                                        @Texts.TitleCreateAxCryptIdTitle
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* Sign-up footer ─────────────────────────── *@
                    <div class="lp-foot">
                        <span>@Texts.DontaccountText</span>
                        <NavLink class="lp-link" @onclick="CreateNewAccountLabel_LinkClicked" tabindex="4">
                            @Texts.PromptSignUp
                        </NavLink>
                    </div>

                    <p class="lp-legal">
                        @Texts.AgreeOurText
                        <NavLink class="lp-link lp-link--inline" @onclick="RedirectToPrivacyPolicy">
                            @Texts.PrivacyPolicyLinkLabel
                        </NavLink>
                        @Texts.AndText
                        <NavLink class="lp-link lp-link--inline" @onclick="RedirectToTermsOfUse">
                            @Texts.TermsOfUseLinkLabel
                        </NavLink>
                    </p>
            </div>
        </article>

        @* Sign-in loader — a centered popup card, not a full-page scrim. *@
        @if (_isSubmitting)
        {
            <div class="lp-login-popup">
                <div class="lp-login-popup-card">
                    <AxLoader Mode="LoaderMode.Body" Message="Signing you in…" />
                </div>
            </div>
        }

        <AxCrypt.App.Shared.Desktop.Components.PopupDialog.SwitchUserPopup />
    </section>
}

@code {
    private bool isPasswordVisible = false;
    private bool _isSubmitting = false;

    private string PasswordInputType => isPasswordVisible ? "text" : "password";

    /// <summary>
    /// Progressive disclosure: password field only renders once the email
    /// field has a plausible value (contains @@ and a dot). Until then,
    /// the submit button reads "Continue".
    /// </summary>
    private bool PasswordVisible
    {
        get
        {
            string? email = LogOnViewModel.LogOnAccountModel?.UserEmail;
            if (string.IsNullOrWhiteSpace(email)) return false;
            if (LogOnViewModel.LogOnAccountModel?.ReadOnlyUserEmail == true) return true;
            return email.Contains('@') && email.Contains('.');
        }
    }

    private void TogglePassword() => isPasswordVisible = !isPasswordVisible;

    private bool showDropdown = false;
    private void ToggleDropdown() => showDropdown = !showDropdown;

    public bool IsEmailReadOnly { get; set; }

    // Held in a field so Dispose can detach it — an anonymous lambda
    // passed straight to += can never be removed, which leaks this
    // component every time the sign-in screen mounts.
    private Action? _onUpdateViewState;

    protected override async Task OnInitializedAsync()
    {
        _onUpdateViewState = async () => await RefreshComponentAsync();
        LogOnViewModel.OnUpdateViewState += _onUpdateViewState;
        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        if (_onUpdateViewState != null)
        {
            LogOnViewModel.OnUpdateViewState -= _onUpdateViewState;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string autoFocusField = string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail) ? "useremail-txtbox" :
            "password-txtbox";
            await JSRuntime.InvokeVoidAsync("loginFunctions.focusElement", autoFocusField);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ButtonLogIn_Click()
    {
        LogOnViewModel.PageResult = DialogResult.None;
        if (isPasswordVisible)
        {
            TogglePassword();
        }

        _isSubmitting = true;
        await RefreshComponentAsync();

        try
        {
            // No global ProcessIndicator here — that painted the
            // full-page loader over the whole app. The wait is shown
            // by the centered .lp-login-popup card (driven by
            // _isSubmitting) instead.
            if (!await AdHocValidationDueToMonoLimitations())
            {
                _isSubmitting = false;
                await RefreshComponentAsync();
                return;
            }

            // Success — leave the popup loader up. This component is
            // about to unmount as the app hands off to the home
            // screen; clearing _isSubmitting here would flash a frame
            // of "no loader" before the post-sign-in loader appears.
            LogOnViewModel.PageResult = DialogResult.OK;
        }
        catch
        {
            _isSubmitting = false;
            await RefreshComponentAsync();
        }
    }

    private async Task RefreshComponentAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> AdHocValidationDueToMonoLimitations()
    {
        if (!AdHocValidateUserEmail()) return false;

        if (!string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.EncryptedFileFullName))
        {
            return await AdHocValidatePassphraseForFile();
        }

        if (!await AdHocValidatePassphrase()) return false;

        SwitchUserModel.AddNewUser(LogOnViewModel.LogOnAccountModel.UserEmail, LogOnViewModel.SubscriptionLevel.ToString());
        return true;
    }

    private bool AdHocValidateUserEmail()
    {
        LogOnViewModel.ErrorMessage = "";
        if (string.IsNullOrEmpty(LogOnViewModel.LogOnAccountModel.UserEmail))
        {
            LogOnViewModel.ErrorMessage = Texts.BadEmail;
            return false;
        }
        if (LogOnViewModel.LogOnAccountModel[nameof(AccountEmailViewModel.UserEmail)].Length > 0)
        {
            LogOnViewModel.ErrorMessage = Texts.BadEmail;
            return false;
        }
        return true;
    }

    private async Task<bool> AdHocValidatePassphrase()
    {
        LogOnViewModel.CurrentUserDevice = AxCrypt.App.Shared.Desktop.Data.Utility.GetCurrentDevice();
        LogOnViewModel.ErrorMessage = "";
        if (!await LogOnViewModel.LogOnAccountModel.ValidateItemAsync(nameof(LogOnViewModel.LogOnAccountModel.PasswordText)))
        {
            LogOnViewModel.ErrorMessage = Texts.WrongPassphrase;
            return false;
        }
        return true;
    }

    private async Task<bool> AdHocValidatePassphraseForFile()
    {
        LogOnViewModel.ErrorMessage = "";
        if (!await LogOnViewModel.LogOnAccountModel.ValidateItemAsync(nameof(LogOnViewModel.LogOnAccountModel.EncryptedFileFullName)))
        {
            LogOnViewModel.ErrorMessage = Texts.WrongPassphrase;
            return false;
        }
        return true;
    }

    private async Task InitiateImportAxCryptIdOnSignIn()
    {
        await profileViewModel.HandleImportAndExportKeys(KeyManagement.ImportAxCryptID);
        if (LogOnViewModel.IsLoggedOn)
        {
            LogOnViewModel.PageResult = DialogResult.OK;
        }
    }

    private void OpenCreateAxCryptIdOnSignIn()
    {
        LogOnViewModel.PageResult = DialogResult.Cancel;
        Task.Run(async () =>
        {
            await profileViewModel.HandleImportAndExportKeys(KeyManagement.CreateAxCryptID);
            if (!RegisterModel.ShowSignUp && !LogOnViewModel.IsVisible)
            {
                LogOnViewModel.PageResult = DialogResult.None;
                await LogOnViewModel.FileOperationViewModel.IdentityViewModel.AskForLogOnPassphrase.ExecuteAsync(LogOnIdentity.Empty);
            }
        });
    }

    // private async Task CreateNewAccountLabel_LinkClicked(EventArgs e)
    // {
    //     // Was: bounced the user out to the web signup page, which lost the
    //     // email they had already typed, opened a separate browser session,
    //     // and made completing first-run feel like two products. The
