@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.Content

@inject NavigationManager navigation

@inject AppSettingsViewModel AppSettingsViewModel

<div class="desk-stngs-popup manage-acc-sec model-popup font-medium" style="display:none;" id="settings-dropdown-popup">
    <span style="padding-left: 20px;" class="font-bold">@Texts.SettingsPageTitle</span>

    <div class="settings-menu-item-container">
        <NavLink class="nav-link center-column">
            <div>
                <img class="stngs-menu-icon IcoEye" alt="IcoEye" />
                <span class="grey-clr">@Texts.OptionsHideRecentFilesToolStripMenuItemText</span>
            </div>

            <div style="float:right; padding-left:15px;">
                <label class="toggle">
                    <input type="checkbox" @bind="AppSettingsViewModel.HideRecentFiles" @onclick="AppSettingsViewModel.ToggleHideRecentFiles" />
                    <span class="slider round">
                        @if (AppSettingsViewModel.HideRecentFiles)
                        {
                            <span class="on-off-text on-text">@Texts.ONText</span>
                            <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                        }
                        else
                        {
                            <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                            <span class="on-off-text off-text">@Texts.OFFText</span>
                        }
                    </span>
                </label>
            </div>
        </NavLink>
    </div>

    @if (AppSettingsViewModel.EnableAutoUpgrade)
    {
        <div class="settings-menu-item-container">
            <NavLink class="nav-link center-column">
                <div>
                    <img class="stngs-menu-icon Ico256" alt="Ico256" />
                    <span class="grey-clr">@Texts.OptionsConvertMenuItemText</span>
                </div>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="AppSettingsViewModel.AutoUpgradeToAES256" @onclick="async(e)=> await AppSettingsViewModel.ToggleEncryptionUpgradeMode()">
                        <span class="slider round">
                            @if (AppSettingsViewModel.AutoUpgradeToAES256)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@(()=> ShowPopup("autoupgrade"))' @onmouseout='@( () => HidePopup() )'>
            <NavLink class="nav-link center-column" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                <div>
                    @* <img class="stngs-menu-icon Ico256" alt="Ico256" /> *@
                    <span class="grey-clr subs-required">@Texts.OptionsConvertMenuItemText</span>
                </div>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="AppSettingsViewModel.AutoUpgradeToAES256" disabled="disabled">
                        <span class="slider round">
                            @if (AppSettingsViewModel.AutoUpgradeToAES256)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </NavLink>
            @if (isHovered && hoveredElement == "autoupgrade")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    @if (AppSettingsViewModel.EnableIncludeSubfolders)
    {
        <div class="settings-menu-item-container">
            <NavLink class="nav-link center-column">
                <div>
                    <img class="stngs-menu-icon IcoIncldFldrs24px" alt="IcoIncldFldrs24px" />
                    <span class="grey-clr">@Texts.OptionsIncludeSubfoldersToolStripMenuItemText</span>
                </div>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="AppSettingsViewModel.IncludeSubfolders" @onclick="async(e)=> AppSettingsViewModel.ToggleIncludeSubfolders(e)">
                        <span class="slider round">
                            @if (AppSettingsViewModel.IncludeSubfolders)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@(()=> ShowPopup("include"))' @onmouseout='@( () => HidePopup() )'>
            <NavLink class="nav-link center-column" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                <div>
                    @* <img class="stngs-menu-icon IcoIncldFldrs24px" alt="IcoIncldFldrs24px" /> *@
                    <span class="grey-clr subs-required">@Texts.OptionsIncludeSubfoldersToolStripMenuItemText</span>
                </div>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="AppSettingsViewModel.IncludeSubfolders" disabled="disabled" />
                        <span class="slider round">
                            @if (AppSettingsViewModel.IncludeSubfolders)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </NavLink>

            @if (isHovered && hoveredElement == "include")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    @if (AppSettingsViewModel.EnableInActivitySignOut)
    {
        <div class="settings-menu-item-container">
            <NavLink @attributes="AppSettingsViewModel.NavLinkAttributes1()" id="inactivity-signout-button-action">
                <img class="stngs-menu-icon Icoinactsign" alt="Icoinactsign" />
                <span>@Texts.IdleSignOutToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@(()=> ShowPopup("inactivity"))' @onmouseout='@( () => HidePopup() )'>
            <NavLink @attributes="AppSettingsViewModel.NavLinkAttributes1()" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                <div>
                    @*  <img class="stngs-menu-icon Icoinactsign" alt="Icoinactsign" /> *@
                    <span class="subs-required">@Texts.IdleSignOutToolStripMenuItemText</span>
                    <img class="next-arrow" />
                </div>
            </NavLink>
            @if (isHovered && hoveredElement == "inactivity")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    @if (AppSettingsViewModel.EnableRestoreRename)
    {
        <div class="settings-menu-item-container">
            <NavLink class="nav-link" @onclick="(e)=> AppSettingsViewModel.RestoreRename(e)">
                <img class="stngs-menu-icon IcoRstr" alt="IcoRstr" />
                <span>@Texts.RestoreAnonymousNamesMenuText</span>
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@( () => ShowPopup("rename") )' @onmouseout='@( () => HidePopup() )'>
            <NavLink class="nav-link" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                <div>
                    @*  <img class="stngs-menu-icon IcoRstr" alt="IcoRstr" /> *@
                    <span class="subs-required">@Texts.RestoreAnonymousNamesMenuText</span>
                </div>
            </NavLink>
            @if (isHovered && hoveredElement == "rename")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium"> @Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    <div class="settings-menu-item-container">
        <NavLink class="nav-link" @attributes="AppSettingsViewModel.NavLinkAttributes2()" id="advanced-options-button-action">
            <img class="stngs-menu-icon IcoAdvsSttns" alt="IcoAdvsSttns" />
            <span>@Texts.AdvancedSettingsText</span>
            <img class="next-arrow" />
        </NavLink>
    </div>

    <div class="settings-menu-item-container">
        <NavLink class="nav-link center-column">
            <div>
                <img class="stngs-menu-icon IcoOffln" alt="IcoOffln" />
                <span class="grey-clr">@Texts.AlwaysOffline</span>
            </div>
            <div style="float:right; padding-left:15px;">
                <label class="toggle">
                    <input type="checkbox" @bind="AppSettingsViewModel.AlwaysOffline" @onclick="(e)=> AppSettingsViewModel.ToggleAlwaysOffline(e)">
                    <span class="slider round">
                        @if (AppSettingsViewModel.AlwaysOffline)
                        {
                            <span class="on-off-text on-text">@Texts.ONText</span>
                            <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                        }
                        else
                        {
                            <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                            <span class="on-off-text off-text">@Texts.OFFText</span>
                        }
                    </span>
                </label>
            </div>
        </NavLink>
    </div>

    @if (AppSettingsViewModel.EnableEncryptionFileProperties)
    {
        <div class="settings-menu-item-container">
            <NavLink @attributes="AppSettingsViewModel.NavLinkAttributes3()" id="encryption-file-property-button-action">
                <img class="stngs-menu-icon IcoEncrptSttgs" alt="IcoEncrptSttgs" />
                <span>@Texts.FilePropertiesToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@( () => ShowPopup("encryptfileproperties") )' @onmouseout='@( () => HidePopup() )'>
            <NavLink @attributes="AppSettingsViewModel.NavLinkAttributes3()" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                @* <img class="stngs-menu-icon IcoEncrptSttgs" alt="IcoEncrptSttgs" /> *@
                <span class="subs-required">@Texts.FilePropertiesToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
            @if (isHovered && hoveredElement == "encryptfileproperties")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    @if (AppSettingsViewModel.EnableInviteFriend)
    {
        <div class="settings-menu-item-container">
            <NavLink class="nav-link" @onclick="(e)=> AppSettingsViewModel.InviteUser(e)">
                <img class="stngs-menu-icon IcoInvtFrnd" alt="IcoInvtFrnd" />
                <span>@Texts.InviteUserToolStripMenuItemText</span>
            </NavLink>
        </div>
    }
    else
    {
        <div class="settings-menu-item-container" @onmouseover='@( () => ShowPopup("invitefriend") )' @onmouseout='@( () => HidePopup() )'>
            <NavLink @attributes="AppSettingsViewModel.NavLinkAttributes3()" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                @*<img class="stngs-menu-icon IcoInvtFrnd" alt="IcoInvtFrnd" />*@
                <span class="subs-required">@Texts.InviteUserToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
            @if (isHovered && hoveredElement == "invitefriend")
            {
                <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                    <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                </div>
            }
        </div>
    }

    @if (AppSettingsViewModel.EnableDebugPopup)
    {
        <div class="settings-menu-item-container">
            <NavLink class="debug" @attributes="AppSettingsViewModel.NavLinkAttributes2()" id="debug-button-action">
                <img class="stngs-menu-icon IcoDbg" alt="IcoDbg" />
                <span>@Texts.DebugToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
        </div>
    }
</div>

<div class="model-popup sub-pop1" style="display:none;" id="inactivity-signout-side-popup">
    <div id="inactivity">
        <form id="inactivityForm">
            @foreach (int timeout in AppSettingsViewModel.InactivityTimeoutOptions)
            {
                <input type="radio" id="timeout-@timeout" name="inactivity" value="@timeout"
                       checked="@(timeout == AppSettingsViewModel.InactivitySignOut)"
                       @onclick="(e) => AppSettingsViewModel.OnInactivityContextMenu(timeout, e)" />
                <label for="timeout-@timeout">@((timeout == 0) ? "Disable" : $"{timeout} minutes")</label>
                <br />
            }
        </form>
    </div>
</div>

<div class="model-popup sub-pop1 encrypt-pop" style="display:none;" id="encryption-file-property-side-popup">
    <div id="date-modified-toggle">
        <dl>
            <dd class="center-column">
                <div>
                    <img class="" src="images/default/Icodate.svg" alt="date-img" />
                    <span class="font-medium grey-clr">
                        @Texts.FilePropertiesDateModifiedToolStripMenuItem
                    </span>
                </div>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="@AppSettingsViewModel.IsDateModifiedOn" @onclick="(e)=> AppSettingsViewModel.FilePropertiesDateModified(e)">

                        <span class="slider round">
                            @if (AppSettingsViewModel.IsDateModifiedOn)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </dd>
        </dl>
        <dl>
            <dd class="center-column">
                <img class="" src="images/default/IcoBtnEdit.svg" alt="btn-file-img" />
                <span class="font-medium grey-clr">
                    @Texts.FilePropertiesFileNameToolStripMenuItem
                </span>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="@AppSettingsViewModel.IsFileNameOn" @onclick="(e) => AppSettingsViewModel.FilePropertiesFileName(e)">

                        <span class="slider round">
                            @if (AppSettingsViewModel.IsFileNameOn)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </dd>
        </dl>
    </div>
</div>

<div class="model-popup sub-pop2 font-medium" style="display:none;" id="debug-side-popup">
    <div class="manage-acc-sec">
        <NavLink class="nav-link settings-menu-item-container" @onclick="AppSettingsViewModel.CheckAxCryptVersionAsync">
            <img class="stngs-menu-icon IcoChckVrsn" alt="IcoChckVrsn" />
            <span>@Texts.DebugCheckVersionNowToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="AppSettingsViewModel.OpenOptions">
            <img class="stngs-menu-icon IcoOptns" alt="IcoOptns" />
            <span>@Texts.DebugOptionsToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container"
                 @onclick="() => AppSettingsViewModel.OnOpenLogViewerClicked(Utility.LogType.Debug)">
            <img class="stngs-menu-icon IcoLgng" alt="IcoLgng" />
            <span>@Texts.DebugLoggingToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="AppSettingsViewModel.OpenManageAxCryptID">
            <img class="stngs-menu-icon IcoUsers" alt="IcoUsers" />
            <span>@Texts.DebugManageAccountToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="async ()=> AppSettingsViewModel.OpenBrokenFiles()">
            <img class="stngs-menu-icon IcoBrkFl" alt="IcoBrkFl" />
            <span>@Texts.TryBrokenFileToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="async ()=> AppSettingsViewModel.VerifyAxCryptFiles()">
            <img class="stngs-menu-icon IcoChckVer" alt="IcoChckVer" />
            <span>@Texts.VerifyFileToolStripMenuItem </span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="async ()=> AppSettingsViewModel.AxCryptFileFormatCheck()">
            <img class="stngs-menu-icon IcoChckFl" alt="IcoChckFl" />
            <span>@Texts.DebugFileFormatCheckToolStripMenuItemText</span>
        </NavLink>
        <NavLink class="nav-link settings-menu-item-container" @onclick="AppSettingsViewModel.OpenReportAsync">
            <img class="stngs-menu-icon IcoErrRprt" style="width:28px;height:28px;" alt="IcoErrRprt" />
            <span>@Texts.ReportSnapshotOpenMenuItem</span>
        </NavLink>
    </div>
</div>

@if (AppSettingsViewModel.ShowVersion)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div tyle="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                        @if (string.Compare(AppSettingsViewModel.LatestVersion, AppSettingsViewModel.CurrentVersion) > 0)
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">@Texts.NewVersionAvailableText</span>

                            <br />
                            @* <span class="text-center font-bold" style="font-size: 15px;"> Latest Version : @LatestVersion </span> *@
                        }
                        else
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">@Texts.UpToDateText</span>
                        }
                    </div>
                </div>
                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    @if (string.Compare(AppSettingsViewModel.LatestVersion, AppSettingsViewModel.CurrentVersion) > 0)
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> RedirectToDownload()">@Texts.UpdateText</button>
                    }
                    else
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> AppSettingsViewModel.CloseSuccessPopup()">@Texts.ButtonOkText</button>
                    }
                    <button class="button font-medium success btn-large" @onclick="()=>AppSettingsViewModel.CloseSuccessPopup()">@Texts.ButtonCloseText</button>
                </div>
            </div>
        </div>
    </div>
}

@if (AppSettingsViewModel.ShowOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
                @if (!string.IsNullOrEmpty(AppSettingsViewModel!.ErrorMessage))
                {
                    <div class="error-message">@AppSettingsViewModel.ErrorMessage</div>
                }
                <div class="input-group">
                    <label for="restApiUrl">@Texts.DialogDebugOptionsRestApiUrlPrompt</label>
                    <input type="text" id="restApiUrl" class="form-control" @bind="@AppSettingsViewModel.RestApiBaseUrlInput" style="text-indent: 0px;" />
                </div>
                <div class="input-group">
                    <label for="timeout">@Texts.DialogDebugOptionsRestApiTimeoutPrompt</label>
                    <input type="text" id="timeout" class="form-control" @bind="@AppSettingsViewModel.TimeoutInput" style="text-indent: 0px;" />
                </div>

                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <button class="button font-medium success btn-large" @onclick="(e)=> AppSettingsViewModel.SetOptionsToolStripMenuItem_Click(e)">@Texts.ButtonOkText</button>
                    <button class="button font-medium success btn-large" @onclick="AppSettingsViewModel.CloseOptions">@Texts.ButtonCloseText</button>
                </div>
            </div>
        </div>
    </div>
}

@if (AppSettingsViewModel.ShowManageAxCryptID)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <label for="title">@Texts.DebugManageAccountToolStripMenuItemText</label>
            <div class="modal-body">
                <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                <label for="userEmail">@AppSettingsViewModel.EmailLabel</label>
                <input type="text" id="timeout" class="form-control" readonly value="Timestamp: @AppSettingsViewModel.CreatedTime">
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-large" @onclick="(e)=>AppSettingsViewModel.ChangePassphraseButton_Click(e)" style="width: max-content; max-width: 165px;">
                    @Texts.ChangePassphraseDialogTitle
                </button>
                <button class="button font-medium success btn-large" @onclick="AppSettingsViewModel.CloseManageAxCryptID">@Texts.ButtonCloseText</button>
            </div>
        </div>
    </div>
}

<div class="model-popup sub-pop1 advanced-popup" style="display:none;" id="advanced-options-side-popup">
    <div id="toggle">
        <dl>
            <dd class="center-column" style="cursor:pointer">
                <div @onclick="(e)=> AppSettingsViewModel.ToggleAdvancedOption()">
                    <img class="" src="/images/default/IcoAdvsSttns.svg" alt="IcoAdvsSttns" />
                    <span class="font-medium grey-clr">@Texts.AppConfigurationText </span>
                </div>
            </dd>
        </dl>
        <dl>
            <dd class="center-column">
                <img class="" src="/images/default/IcoDbg.svg" alt="IcoDbg" style="margin-right:5px;" />
                <span class="font-medium grey-clr">
                    @Texts.DebugToolStripMenuItemText
                </span>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="@AppSettingsViewModel.EnableDebugPopup" @onclick="AppSettingsViewModel.ToggleDebug">

                        <span class="slider round">
                            @if (AppSettingsViewModel.EnableDebugPopup)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </dd>
        </dl>
        <dl>
            <dd class="center-column">
                <img class="" src="images/default/IcoFileLgng.svg" alt="IcoFileLgng" style="margin-right:5px;" />

                <span class="font-medium grey-clr">User Activity</span>
                <div style="float:right; padding-left:15px;">
                    <label class="toggle">
                        <input type="checkbox" @bind="@AppSettingsViewModel.EnableUserActivity" @onclick="AppSettingsViewModel.ToggleUserActivity">

                        <span class="slider round">
                            @if (AppSettingsViewModel.EnableUserActivity)
                            {
                                <span class="on-off-text on-text">@Texts.ONText</span>
                                <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                            }
                            else
                            {
                                <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                <span class="on-off-text off-text">@Texts.OFFText</span>
                            }
                        </span>
                    </label>
                </div>
            </dd>
        </dl>

        @if (AppSettingsViewModel.EnableFindFilesMenuOption)
        {
            <dl>
                <dd class="center-column">
                    <img class="" src="images/default/IcoFileLgng.svg" alt="IcoFileLgng" style="margin-right:5px;" />

                    <span class="font-medium grey-clr">@Texts.FindFileFeatureTitle</span>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@AppSettingsViewModel.EnableFindFiles" @onclick="AppSettingsViewModel.ToggleFindFiles">

                            <span class="slider round">
                                @if (AppSettingsViewModel.EnableFindFiles)
                                {
                                    <span class="on-off-text on-text">@Texts.ONText</span>
                                    <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                    <span class="on-off-text off-text">@Texts.OFFText</span>
                                }
                            </span>
                        </label>
                    </div>
                </dd>
            </dl>
        }
        else
        {
            <dl @onmouseover='@(() => ShowPopup("findfiles"))' @onmouseout='@(() => HidePopup())'>
                <dd class="center-column" @onclick="AppSettingsViewModel.ShowUpgradePopup">
                    <span class="font-medium grey-clr subs-required">@Texts.FindFileFeatureTitle</span>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@AppSettingsViewModel.EnableFindFiles" @onclick="AppSettingsViewModel.ToggleFindFiles" disabled="disabled">

                            <span class="slider round">
                                @if (AppSettingsViewModel.EnableFindFiles)
                                {
                                    <span class="on-off-text on-text">@Texts.ONText</span>
                                    <span class="on-off-text off-text" style="display:none;">@Texts.OFFText</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">@Texts.ONText</span>
                                    <span class="on-off-text off-text">@Texts.OFFText</span>
                                }
                            </span>
                        </label>
                    </div>

                    @if (isHovered && hoveredElement == "findfiles")
                    {
                        <div class="settings-menu-hover text-center popup" style="background-color:#fff;">
                            <span class="txt-clr font-medium">@Texts.PremiumFeatureToolTipText</span>
                        </div>
                    }
                </dd>
            </dl>
        }
    </div>
</div>

<style>
    .input-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .input-group label {
            min-width: 120px;
            margin-right: 10px;
        }

        .input-group input {
            flex-grow: 1;
        }

    .popup {
        position: absolute;
        left: -150px; /* Adjust as per your requirement */
        top: 0;
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 8px;
        z-index: 1000;
        width: 200px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        pointer-events: none; /* Prevent interfering with hover logic */
    }
</style>

@code {
    protected override void OnInitialized()
    {
        AppSettingsViewModel.Initialized();
        AppSettingsViewModel.OnUpdateViewState += UpdatePageState;

        base.OnInitialized();
    }

    private void RedirectToDownload()
    {
        navigation.NavigateTo(AppSettingsViewModel.DownloadVersion!.ToString());
        AppSettingsViewModel.ShowVersion = false;
    }

    [Parameter]
    public EventCallback CloseSettingsPopup { get; set; }

    public string hoveredElement { get; set; } = string.Empty;
    public bool isHovered { get; set; }

    public void ShowPopup(string element)
    {
        isHovered = true;
        hoveredElement = element;
    }

    private void HidePopup()
    {
        isHovered = false;
        hoveredElement = string.Empty;
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
