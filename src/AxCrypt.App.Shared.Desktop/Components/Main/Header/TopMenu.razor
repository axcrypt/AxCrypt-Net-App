@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.Core
@using AxCrypt.Core.UI
@using Microsoft.JSInterop
@using AxCrypt.Content

@using static AxCrypt.Abstractions.TypeResolve

@inject UserNotificationService notificationService
@inject TopMenuViewModel ViewModel
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="top-menu">
    <AxCrypt.App.Shared.Desktop.Components.Main.Header.LanguagesComponent />
    <NavLink class="app-top-menu" @onclick="ShowHelpOverlay" title="Show get-started tips">
        <img class="idea-icon padding" src="/images/IcoIdea.svg" alt="Idea-icon" />
    </NavLink>
    <NavLink id="settings-dropdown-click-action" class="app-top-menu" title="App settings">
        <img id="help-settings" class="sttng-icon padding" src="/images/default/IcoExtrFtr.svg" alt="settings-icon" />
    </NavLink>
    <NavLink id="notification-dropdown-click-action" class="app-top-menu" title="Recent notification(s)">
        <span class="notification-badge">
            @NotificationCount
        </span>
        <img class="notif-icon padding" src="/images/default/IcoNtfctns.svg" alt="notify-icon" />
    </NavLink>
    @{
        string UpdateAvailableStyle = ViewModel.ShowUpdate ? "update-btn" : "update-btn no-upd-avilbl";
    }
    <NavLink class="@UpdateAvailableStyle" @onclick="ViewModel.CheckAxCryptVersionAsync" title="@ViewModel.VersionHoverText">@Texts.UpdateText</NavLink>
    <NavLink class="mb-prfle" id="accounts-dropdown-click-action">
        <img id="help-profile" style="max-width:30px;width:30px;height:30px !important;" src="@SubscriptionIcon()" alt="subs-level icon" />
    </NavLink>
</div>

<AxCrypt.App.Shared.Desktop.Components.Main.Header.AppSettingsComponent />
<AxCrypt.App.Shared.Desktop.Components.Main.Header.NotificationPopup />
<AxCrypt.App.Shared.Desktop.Components.Main.Header.ProfileOptionComponent />

@code {
    int NotificationCount = 0;
    protected override async Task OnInitializedAsync()
    {
        ViewModel.Initialize();
        await notificationService.LoadNotificationListAsync();
        NotificationCount = notificationService.NotificationModel.Notifications.Count();
        ViewModel.LogOnViewModel.OnSubscriptionChanged += UpdatePageState;
        notificationService.OnUpdateViewState += UpdatePageState;
        ViewModel.LogOnViewModel.OnUIStateChanged += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private string SubscriptionIcon()
    {
        string subscriptionLevel = ViewModel.LogOnViewModel.SubscriptionLevel.ToString();
        switch (subscriptionLevel)
        {
            case "PasswordManager":
                return "/images/PasswordManager/icoPM.svg";

            case "Premium":
                return "/images/Premium/IcoPrm.svg";

            case "Business":
                return "/images/Business/IcoBus.svg";

            default:
                return "/images/free/IcoVwr.svg";

        }
    }

    private async Task ShowHelpOverlay()
    {
        string currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (currentPath != "" && currentPath != "/")
        {
            New<UserSettings>().HasSeenStartupHelp = false;
            Navigation.NavigateTo("/");
            return;
        }

        await JSRuntime.InvokeVoidAsync("startHomeHelp", ViewModel.LogOnViewModel.SubscriptionLevel.ToString().ToLower());
    }

    private void UpdatePageState()
    {
        NotificationCount = notificationService.NotificationModel.Notifications.Count();
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}