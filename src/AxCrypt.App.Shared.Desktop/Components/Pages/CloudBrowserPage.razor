@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.FileBrowser
@using AxCrypt.App.Shared.Desktop.Components.Shared
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.UI.ViewModels
@using AxCrypt.App.Shared.Utility
@using AxCrypt.App.Shared.ViewModels.FileBrowser
@using AxCrypt.Content
@using Microsoft.AspNetCore.Components.Web

@inject DesktopFilePickerViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime JS

@implements IDisposable

<div class="cbp-page">

    @* ── Header ──────────────────────────────── *@
    <header class="cbp-header">
        <button type="button" class="cbp-back" @onclick="GoBack" title="Back to cloud manager">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            <span>@Texts.PromptBackLinkText</span>
        </button>

        <div class="cbp-header-title">
            <img class="cbp-prov-icon @ViewModel.SelectedProviderImage" src="" alt="@ViewModel.PageTitle" />
            <div class="cbp-header-text">
                <h1 class="cbp-title">@ViewModel.PageTitle</h1>
                <p class="cbp-sub">Browse and manage files in your @ViewModel.PageTitle account.</p>
            </div>
        </div>
    </header>

    @* ── Toolbar: tabs + search ─────────────── *@
    <div class="cbp-toolbar">
        <nav class="cbp-tabs" role="tablist">
            <button type="button"
                    class="cbp-tab @(ViewModel.selectedTab == "all" ? "cbp-tab--active" : "")"
                    role="tab" aria-selected="@(ViewModel.selectedTab == "all")"
                    @onclick='async () => await ShowTab("all")'>
                @Texts.FileFilterFileTypeAllFiles
            </button>
            <button type="button"
                    class="cbp-tab @(ViewModel.selectedTab == "sharedWithMe" ? "cbp-tab--active" : "")"
                    role="tab" aria-selected="@(ViewModel.selectedTab == "sharedWithMe")"
                    @onclick='async () => await ShowTab("sharedWithMe")'>
                @Texts.SharedWithMeText
            </button>
            @if (ViewModel.SelectedCloudProvider != AxCrypt.Core.IO.FileProvider.OneDrive)
            {
                <button type="button"
                        class="cbp-tab @(ViewModel.selectedTab == "sharedByMe" ? "cbp-tab--active" : "")"
                        role="tab" aria-selected="@(ViewModel.selectedTab == "sharedByMe")"
                        @onclick='async () => await ShowTab("sharedByMe")'>
                    @Texts.SharedByMeText
                </button>
            }
        </nav>

        <div class="cbp-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input id="cbp-search-input"
                   type="text"
                   placeholder="Search files…"
                   @bind="ViewModel.SearchQuery"
                   @bind:event="oninput"
                   @onkeydown="OnSearchKeyDown" />
            @if (!string.IsNullOrEmpty(ViewModel.SearchQuery))
            {
                <button type="button" class="cbp-search-clear" @onclick="ClearSearch" title="Clear search">×</button>
            }
        </div>

        <div class="cbp-view-toggle" role="group" aria-label="View mode">
            <button type="button"
                    class="cbp-view-btn @(IsListView ? "cbp-view-btn--active" : "")"
                    @onclick="() => SetView(true)"
                    title="List view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                </svg>
            </button>
            <button type="button"
                    class="cbp-view-btn @(!IsListView ? "cbp-view-btn--active" : "")"
                    @onclick="() => SetView(false)"
                    title="Grid view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </button>
        </div>
    </div>

    @* ── Breadcrumb ──────────────────────────── *@
    @if (!ViewModel.IsSearchResultVisible && ViewModel.selectedTab == "all")
    {
        <nav class="cbp-breadcrumb" aria-label="Folder path">
            <button type="button" class="cbp-bc-item" @onclick="async () => await WithLoading(async () => await ViewModel.NavigateBackToPath())">
                @ViewModel.PageTitle
            </button>
            @foreach (FolderItem folder in ViewModel.OpenedFoldersList.TakeLast(4))
            {
                <span class="cbp-bc-sep" aria-hidden="true">/</span>
                <button type="button"
                        class="cbp-bc-item"
                        title="@folder.DirectoryName"
                        @onclick="async () => await WithLoading(async () => await ViewModel.NavigateBackToPath(folder.FileID))">
                    @folder.DirectoryName
                </button>
            }
        </nav>
    }

    @if (ViewModel.IsSearchResultVisible)
    {
        <div class="cbp-search-info">
            Search results for "<strong>@ViewModel.SearchQuery</strong>"
            <button type="button" class="cbp-link" @onclick="ClearSearch">@Texts.ClearButtonText</button>
        </div>
    }

    @* ── File list / grid ─────────────────────── *@
    <div class="cbp-files">
        @if (ViewModel.ShowProgressBar)
        {
            <AxLoader Mode="LoaderMode.Body" Message="Loading files…" />
        }
        else if (ViewModel.Files == null || ViewModel.Files.Count == 0)
        {
            <div class="cbp-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.4">
                    <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" />
                </svg>
                <p class="cbp-empty-title">@Texts.NoFilesFoundText</p>
                <p class="cbp-empty-sub">@Texts.FileListSubTitle</p>
                <button type="button" class="cbp-btn cbp-btn--primary" @onclick="async () => await ViewModel.AddFiles()">
                    @Texts.FileListButtonText
                </button>
            </div>
        }
        else if (IsListView)
        {
            <div class="cbp-list-wrap" role="table" aria-label="Cloud files">
                <div class="cbp-list-header" role="row">
                    <span class="cbp-col-check" aria-hidden="true"></span>
                    <span class="cbp-col-icon" aria-hidden="true"></span>
                    <span class="cbp-col-name" role="columnheader">@Texts.NameLabel</span>
                    <span class="cbp-col-size" role="columnheader">@Texts.FileSizeColumnHeaderText</span>
                    <span class="cbp-col-modified" role="columnheader">@Texts.LastModifiedTimeColumnHeaderText</span>
                    <span class="cbp-col-location" role="columnheader">Location</span>
                </div>
                <ul class="cbp-list" role="rowgroup">
                    @foreach (FilePickerItemViewModel file in ViewModel.Files)
                    {
                        string parentPath = DisplayCell(file.ParentPath);
                        <li class="cbp-row @(file.IsSelected ? "cbp-row--selected" : "")"
                            role="row"
                            @ondblclick="async () => await OnFolderClicked(file)"
                            @oncontextmenu="(e) => ShowContextMenu(e)"
                            @oncontextmenu:preventDefault="true">
                            @if (!file.IsFolder)
                            {
                                <input type="checkbox" class="cbp-row-check"
                                       checked="@file.IsSelected"
                                       @onchange="() => OnCheckboxChanged(file)" />
                            }
                            else
                            {
                                <span class="cbp-row-check cbp-row-check--hidden"></span>
                            }
                            <span class="cbp-row-icon" aria-hidden="true">@((MarkupString)FileIconSvg(file.IsFolder, file.FileName))</span>
                            <div class="cbp-row-body">
                                <span class="cbp-row-name">@((MarkupString)HighlightMatch(file.FileName))</span>
                            </div>
                            <span class="cbp-row-size">@DisplayCell(file.FileSize)</span>
                            <span class="cbp-row-modified">@DisplayCell(file.ModifiedTime)</span>
                            <span class="cbp-row-path">@((MarkupString)HighlightMatch(parentPath))</span>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="cbp-grid">
                @foreach (FilePickerItemViewModel file in ViewModel.Files)
                {
                    <button type="button"
                            class="cbp-tile @(file.IsSelected ? "cbp-tile--selected" : "")"
                            @onclick="() => OnCheckboxChanged(file)"
                            @ondblclick="async () => await OnFolderClicked(file)"
                            @oncontextmenu="(e) => ShowContextMenu(e)"
                            @oncontextmenu:preventDefault="true">
                        <span class="cbp-tile-icon" aria-hidden="true">@((MarkupString)FileIconSvg(file.IsFolder, file.FileName))</span>
                        <span class="cbp-tile-name">@((MarkupString)HighlightMatch(file.FileName))</span>
                    </button>
                }
            </div>
        }
    </div>

    @* ── Bottom action bar — visible when a selection exists ──── *@
    @if (ViewModel.MultiSelectEnabled && ViewModel.SelectedFiles.Any())
    {
        <div class="cbp-actionbar" role="region" aria-label="Bulk actions">
            <span class="cbp-actionbar-count">@ViewModel.SelectedFiles.Count selected</span>
            <button type="button" class="cbp-btn cbp-btn--ghost" @onclick="ClearSelection">@Texts.ClearButtonText</button>
            <span class="cbp-actionbar-spacer"></span>
            <button type="button" class="cbp-btn cbp-btn--ghost"
                    disabled="@_guard.IsProcessing"
                    @onclick="async () => await UpdateFileOperation(FileOperationOption.OpenSecured)">
                @Texts.OpenEncryptedToolStripMenuItemText
            </button>
            <button type="button" class="cbp-btn cbp-btn--ghost"
                    disabled="@_guard.IsProcessing"
                    @onclick="async () => await UpdateFileOperation(FileOperationOption.Decrypt)">
                @Texts.DecryptToolStripMenuItemText
            </button>
            <button type="button" class="cbp-btn cbp-btn--ghost"
                    disabled="@_guard.IsProcessing"
                    @onclick="async () => await UpdateFileOperation(FileOperationOption.ShareKey)">
                @Texts.ShareKeysToolStripMenuItemText
            </button>
            <button type="button" class="cbp-btn cbp-btn--primary"
                    disabled="@_guard.IsProcessing"
                    @onclick="async () => await UpdateFileOperation(FileOperationOption.Encrypt)">
                @Texts.EncryptToolStripMenuItemText
            </button>
        </div>
    }
    else
    {
        @* When nothing is selected, surface a single primary CTA so the
           page is never "empty hands" — adding files is the one action
           that doesn't require a selection. *@
        <div class="cbp-actionbar cbp-actionbar--idle">
            <span class="cbp-actionbar-hint">@Texts.CloudBrowserPageTips</span>
            <button type="button" class="cbp-btn cbp-btn--primary" @onclick="async () => await ViewModel.AddFiles()">
                @Texts.CloudBrowserPageTips1
            </button>
        </div>
    }
</div>

<AxCrypt.App.Shared.Desktop.Components.Home.ShareKeyComponent />

<script>
    window.cbpScrollToFirstMatch = function () {
        const el = document.getElementById("cbpFirstMatch");
        if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    };
</script>

@code {
    private bool IsListView { get; set; } = true;

    // Guard against re-entrant file operations (e.g. double-click on Share Key).
    // A second click while the first is awaiting ProcessSelectedFileItemActionAsync
    // causes concurrent downloads + dialog opens which deadlocks the app.
    private readonly OperationGuard _guard = new();

    protected override void OnInitialized()
    {
        ViewModel.OnUpdateViewState += UpdateUIState;
        base.OnInitialized();
    }

    public void Dispose()
    {
        ViewModel.OnUpdateViewState -= UpdateUIState;
    }

    private async void UpdateUIState()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void GoBack()
    {
        // Pop the popup-mode flag too so the legacy modal doesn't try to
        // reopen behind us, then route the user back to where they came
        // from (home Cloud Drives card).
        ViewModel.IsVisible = false;
        Navigation.NavigateTo("/");
    }

    private async Task ShowTab(string tabId)
    {
        // Surface the loader for every tab switch — the underlying provider
        // call (NavigateBackToPath / list shared) only flips ShowProgressBar
        // for selection-action paths, so it has to be toggled explicitly here
        // for every list refresh otherwise the page looks frozen on a slow
        // network.
        // Store the raw tabId key so the tab comparison in markup (== "all" etc.)
        // always matches — previously Texts.* values were stored here causing the
        // active-tab highlight to break after the first click.
        await WithLoading(async () =>
        {
            ViewModel.selectedTab = tabId;
            switch (tabId)
            {
                case "all":
                    await ViewModel.NavigateBackToPath("root");
                    break;
                case "sharedWithMe":
                    await ViewModel.GetSharedWithFileListAsync();
                    break;
                case "sharedByMe":
                    await ViewModel.GetSharedByFileListAsync();
                    break;
            }
        });
    }

    private async Task WithLoading(Func<Task> operation)
    {
        ViewModel.ShowProgressBar = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await operation();
        }
        catch (Exception ex)
        {
            // Hide the loader before showing the error so the popup isn't
            // covered by the blocking AxLoader scrim.
            ViewModel.ShowProgressBar = false;
            await InvokeAsync(StateHasChanged);
            AxCServiceProviderExtension.ErrorReportService?.Report(ex, "Cloud browser");
            return;
        }
        ViewModel.ShowProgressBar = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SetView(bool listView)
    {
        if (ViewModel.Files == null || ViewModel.Files.Count == 0)
        {
            return;
        }
        IsListView = listView;
    }

    private void OnCheckboxChanged(FilePickerItemViewModel file)
    {
        if (file.IsFolder)
        {
            return;
        }

        file.IsSelected = !file.IsSelected;
        if (file.IsSelected)
        {
            ViewModel.SelectedFiles.Add(file);
        }
        else
        {
            ViewModel.SelectedFiles.Remove(file);
        }
        ViewModel.MultiSelectEnabled = ViewModel.SelectedFiles.Any();
    }

    private async Task OnFolderClicked(FilePickerItemViewModel file)
    {
        if (!file.IsFolder)
        {
            return;
        }
        // Folder drill-in hits the cloud provider — keep the user informed
        // while the listing is fetched.
        await WithLoading(async () => await ViewModel.ProcessSelectedFile(file));
    }

    private void ShowContextMenu(MouseEventArgs e)
    {
        // Context-menu in the popup was deeply intertwined with the modal
        // surface. On the nav page, bulk operations live in the bottom
        // action bar — that's the canonical place to act on a selection.
        // Keep the handler so the existing event-binding doesn't error
        // out; explicit no-op for now.
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ViewModel.IsSearchResultVisible = true;
            await WithLoading(async () => await ViewModel.SearchAsync(ViewModel.SearchQuery));
        }
    }

    private async Task ClearSearch()
    {
        ViewModel.IsSearchResultVisible = false;
        ViewModel.SearchQuery = string.Empty;
        await WithLoading(async () => await ViewModel.NavigateBackToPath("root"));
    }

    private async Task ClearSelection()
    {
        foreach (FilePickerItemViewModel file in ViewModel.Files)
        {
            file.IsSelected = false;
        }
        ViewModel.SelectedFiles.Clear();
        ViewModel.MultiSelectEnabled = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateFileOperation(FileOperationOption operation)
    {
        await WithLoading(async () => await
        _guard.RunAsync(async () =>
        {
            ViewModel.SelectedFileOperation = operation;
            try
            {
                await ViewModel.ProcessSelectedFileItemActionAsync();
            }
            catch (Exception ex)
            {
                AxCServiceProviderExtension.ErrorReportService?.Report(ex, "Cloud browser action");
            }
        }, () => InvokeAsync(StateHasChanged)));
    }

    private string HighlightMatch(string input)
    {
        if (string.IsNullOrWhiteSpace(ViewModel.SearchQuery))
        {
            return System.Net.WebUtility.HtmlEncode(input);
        }
        string pattern = System.Text.RegularExpressions.Regex.Escape(ViewModel.SearchQuery);
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(
            pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return regex.Replace(System.Net.WebUtility.HtmlEncode(input),
            match => $"<mark class=\"cbp-hl\">{match.Value}</mark>");
    }

    private static string DisplayCell(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    /// <summary>
    /// Returns a crisp inline SVG icon for a file or folder.
    /// SVG avoids the blur that CSS background-image icons produce at
    /// non-integer scale factors (common in HiDPI / MAUI WebView).
    /// </summary>
    private static string FileIconSvg(bool isFolder, string fileName)
    {
        if (isFolder)
        {
            return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' " +
                   "stroke='#f59e0b' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" +
                   "<path d='M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z'/>" +
                   "</svg>";
        }

        string ext = System.IO.Path.GetExtension(fileName).ToLowerInvariant();

        // Encrypted AxCrypt file — use the official brand icon
        if (ext == ".axx")
        {
            return "<img src='/images/default/AxCrypt_Icon.svg' width='20' height='20' " +
                   "style='object-fit:contain;' alt='AxCrypt encrypted file' />";
        }

        // Image files
        if (ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".svg" or ".webp")
        {
            return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' " +
                   "stroke='#8b5cf6' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" +
                   "<rect x='3' y='3' width='18' height='18' rx='2'/>" +
                   "<circle cx='8.5' cy='8.5' r='1.5'/>" +
                   "<polyline points='21 15 16 10 5 21'/>" +
                   "</svg>";
        }

        // PDF
        if (ext == ".pdf")
        {
            return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' " +
                   "stroke='#ef4444' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" +
                   "<path d='M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z'/>" +
                   "<polyline points='14 2 14 8 20 8'/>" +
                   "<line x1='9' y1='15' x2='15' y2='15'/>" +
                   "<line x1='9' y1='12' x2='11' y2='12'/>" +
                   "</svg>";
        }

        // Generic file
        return "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' " +
               "stroke='#6b7280' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>" +
               "<path d='M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z'/>" +
               "<polyline points='14 2 14 8 20 8'/>" +
               "</svg>";
    }
}
