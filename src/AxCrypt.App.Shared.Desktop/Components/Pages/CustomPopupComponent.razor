@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.Common

@inject CustomPopupService PopupService

@code {
    protected override void OnInitialized()
    {
        PopupService.OnPopupVisibilityChanged += UpdatePopupVisibility;
    }

    private void UpdatePopupVisibility(bool isVisible)
    {
        IsVisible = isVisible;
        Title = PopupService.Title;
        Message = PopupService.Message;
        Buttons = PopupService.Buttons;
        DontShowAgainOptions = PopupService.DontShowAgainOptions;
        StateHasChanged(); // Refresh UI
    }

    private async Task ClosePopup()
    {
        PopupService.HidePopup();
    }

    public bool IsVisible { get; set; }

    public string? Title { get; set; }

    public string? Message { get; set; }

    public string[]? Buttons { get; set; }

    public DoNotShowAgainOptions? DontShowAgainOptions { get; set; }
}

