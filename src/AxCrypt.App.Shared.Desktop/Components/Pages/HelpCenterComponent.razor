@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject LogOnViewModel LogOnViewModel
@inject FileDropService FileDropService

<div class="tools-shell">
    <div class="tools-group">
        <div class="tools-grid">
            <button class="tool-card">
                <NavLink style="text-decoration: none;" href="/SupportIndex">
                    <div class="tc-header">
                        <span class="tc-icon" style="">
                            <img class="nav-suprt-ico" src="" alt="nav-support ico" />
                        </span>
                    </div>
                    <h4 class="tc-name">@Texts.SupportLinkLabel</h4>
                    <p class="tc-desc">Get help and answers.</p>
                </NavLink>
            </button>

            <button class="tool-card" @onclick="FeedbackPopup">
                <div class="tc-header">
                    <span class="tc-icon" style="">
                        <img class="nav-icon nav-feedbck-ico" src="" alt="nav-feedbck ico" />
                    </span>
                </div>
                <h4 class="tc-name">@Texts.NavigationPaneFeedback</h4>
                <p class="tc-desc">Share your thoughts.</p>
            </button>

            <button class="tool-card" @onclick="AboutPopup">
                <div class="tc-header">
                    <span class="tc-icon" style="">
                        <span class="nav-icon">@HomeIcon</span>
                    </span>
                </div>
                <h4 class="tc-name">@Texts.AboutUsLinkLabel</h4>
                <p class="tc-desc">App info and version details.</p>
            </button>
        </div>
    </div>
</div>

<AxCrypt.App.Shared.Desktop.Components.PopupDialog.Feedback />

@code {
    private RenderFragment HomeIcon => @<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
    </svg>;

string TabActive = "";

protected override void OnInitialized()
{
@* LogOnViewModel.AboutDialog.OnDialogVisibilityChanged += UpdateUIState;
        LogOnViewModel.FeedbackDialog.OnDialogVisibilityChanged += UpdateUIState; *@
base.OnInitialized();
    }

    private void FeedbackPopup()
{
    TabActive = "FeedbackPopup";
    FileDropService.CurrentPage = TabActive;
    LogOnViewModel.FeedbackDialog.Show();
}

private void AboutPopup()
{
    TabActive = "AboutPopup";
    FileDropService.CurrentPage = TabActive;
    LogOnViewModel.AboutDialog.Show();
}

}
