@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using Microsoft.JSInterop

@inject RecentFilesViewModel RecentFilesViewModel
@inject IJSRuntime JSRuntime

<div class="home-index">
    <div class="hm-page-title head-sec top-page-title-container">
        <h1 class="fle-nme" style="margin-bottom:0px;">@Texts.WelcomeBackTitle</h1>
        <img class="home-title" style="height:30px;" src="" alt="hand-img" />
    </div>

    <AxCrypt.App.Shared.Desktop.Components.Home.ActionsComponent />
    <AxCrypt.App.Shared.Desktop.Components.Home.SubActionsComponent />
    <AxCrypt.App.Shared.Desktop.Components.Home.RecentFilesComponent />
    <AxCrypt.App.Shared.Desktop.Components.Shared.CloudSyncProgressBar />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RecentFilesViewModel.OnUpdateViewState += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setHtmlLang", Core.Resolve.UserSettings.CultureName);
            await base.OnAfterRenderAsync(firstRender);
            if (!Core.Resolve.UserSettings.HasSeenStartupHelp)
            {
                await Task.Delay(2500);
                await JSRuntime.InvokeVoidAsync("startHomeHelp", RecentFilesViewModel.LogOnViewModel.SubscriptionLevel.ToString().ToLower());
                Core.Resolve.UserSettings.HasSeenStartupHelp = true;
            }
        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
<script>
    window.setHtmlLang = function (lang) {
        if (!lang) return;
        document.documentElement.setAttribute("lang", lang);
    };
</script>