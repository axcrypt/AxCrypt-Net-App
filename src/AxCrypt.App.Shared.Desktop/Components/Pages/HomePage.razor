@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using Microsoft.JSInterop

@using static AxCrypt.Abstractions.TypeResolve
@inject RecentFilesViewModel RecentFilesViewModel
@inject IJSRuntime JSRuntime

<div class="home-index">
    <div class="hm-page-title head-sec">
        <h1 class="fle-nme">@Texts.WelcomeBackTitle</h1>
        <img class="home-title" src="" alt="hand-img" />
    </div>

    <AxCrypt.App.Shared.Desktop.Components.Home.ActionsComponent />
    <AxCrypt.App.Shared.Desktop.Components.Home.SubActionsComponent />
    <AxCrypt.App.Shared.Desktop.Components.Home.RecentFilesComponent />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RecentFilesViewModel.OnUpdateViewState += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("setHtmlLang", New<Core.UI.UserSettings>().CultureName);
            await base.OnAfterRenderAsync(firstRender);
            if (!New<Core.UI.UserSettings>().HasSeenStartupHelp)
            {
                await Task.Delay(2500);
                await JSRuntime.InvokeVoidAsync("startHomeHelp");
                New<Core.UI.UserSettings>().HasSeenStartupHelp = true;
            }
        }
        try
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            //IsLoading = false;
        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
<script>
    window.setHtmlLang = function (lang) {
        if (!lang) return;
        document.documentElement.setAttribute("lang", lang);
    };
</script>