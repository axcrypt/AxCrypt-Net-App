@inject NavigationManager Navigation

<!-- Two-column content grid -->
<div style="display: grid;height: 100vh;gap: 16px;grid-template-rows: 0.85fr 0px;">
    <div class="content-grid">
        <!-- LEFT -->
        <div class="left-col">

            <!-- Quick Actions -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.QuickAction />

            <!-- Free plan limit bar for free users — file encryption quota. -->
            <AxCrypt.App.Shared.Desktop.Components.Shared.FreePlanLimitBar
                Feature="AxCrypt.App.Entitlement.Contracts.FeatureKey.FileEncryption" />

            <!-- Recent Files -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.RecentFiles />
        </div>

        <!-- RIGHT -->
        <div class="right-col">

            <!-- Vault Status -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.VaultStatus />


            <!-- Cloud Drives -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.CloudDrives />


            <!-- Security Status -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.SecurityStatus />


            <!-- CTA -->
            <AxCrypt.App.Shared.Desktop.Components.HomePage.QuickSecureAction />

        </div>
    </div>
    <div id="footer" style="padding: 16px;background-color: #ffffff;">
    </div>
</div>

@code {
    // ── State ──────────────────────────────────────────────────
    // ── Data ───────────────────────────────────────────────────

