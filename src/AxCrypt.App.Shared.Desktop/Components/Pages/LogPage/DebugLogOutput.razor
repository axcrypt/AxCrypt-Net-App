@page "/debuglog"
@implements IDisposable
@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Core
@using AxCrypt.Core.Extensions
@using Microsoft.Extensions.Logging
@using System.Globalization
@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

@inject LogViewModel LogService
@inject IStatusAlertService StatusAlertService

<div style="padding:8px;">
    <button @onclick="ExportLogs" style="float: right; margin:1px 5px 1px 0px;" class="button font-medium success btn-small">@Texts.PromptXecretsExport</button>
    <button style="float: right;margin:1px 5px 1px 0px;" class="button" @onclick="ClearLogs">@Texts.ClearLogsText</button>
</div>

<div class="log-content" @onclick:stopPropagation id="logger_log_section">
    @foreach (string log in LogService.Logs)
    {
        <div style="align-content:flex-start;">@log</div>
    }
</div>
<style>
    .log-content {
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        height: 95vh;
        max-height: 95vh;
        width: 100vw;
        max-width: 100vw;
        overflow-y: scroll;
    }
</style>

@code {
    string DebugFileName = $"DebugLogs_{DateTime.Now:yyyyMMdd_HHmmss}.txt";

    protected override void OnInitialized()
    {
        LogService.ClearLogs();
        LogService.OnUpdateViewState += UpdateState;
    }

    public void Dispose()
    {
        LogService.OnUpdateViewState -= UpdateState;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    private async Task ExportLogs()
    {
        if (LogService.Logs.Count == 0)
        {
            StatusAlertService.Error(Texts.NoLogToExportText);
            return;
        }

        try
        {
            string logs = string.Join(Environment.NewLine, LogService.Logs);
            string fileName = DebugFileName;

            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(logs);

            string downloadsFolderPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            string filePath = Path.Combine(downloadsFolderPath, fileName);

            int count = 1;
            while (File.Exists(filePath))
            {
                string tempFileName = $"DebugLogs_{DateTime.Now:yyyyMMdd_HHmmss}.{count}.txt";
                filePath = Path.Combine(downloadsFolderPath, tempFileName);
                count++;
            }

            await File.WriteAllBytesAsync(filePath, bytes);
            StatusAlertService.Success(Texts.ExportedSuccessfullyText);
        }

        catch (Exception ex)
        {
            await New<Core.UI.IPopup>().ShowAsync(Core.UI.PopupButtons.Ok, AxCrypt.Content.Texts.MessageErrorTitle, ex.Message);
            StatusAlertService.Error(Texts.FailedToExportText);
        }
    }

    private void ClearLogs()
    {
        if (LogService.Logs.Count == 0)
        {
            StatusAlertService.Error(Texts.NoLogToClearText);
            return;
        }

        LogService.ClearLogs();
        UpdateState();
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}