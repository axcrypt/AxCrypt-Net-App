@page "/useractivitylog"
@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Core
@using AxCrypt.Core.Extensions
@using AxCrypt.Core.UI.FileActivity
@using Microsoft.Extensions.Logging
@using System.Globalization
@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content

@inject IStatusAlertService StatusAlerService
@inject IJSRuntime JSRuntime

<div class="modalDialog fileActivity-window" style="display: block;">
    <div class="text-center" style="margin: auto;">
        <div class="modal-body">
            <div>
                <img class="" src="/images/default/sessfileact.svg" alt="default notification img" />
            </div>

            <div>
                <label for="title">User Activities</label>
            </div>

            <div class="search-box" style="margin: 10px 0;">
                <input id="searchKeyword" name="searchKeyword" type="text" @bind="SearchText" placeholder="Search logs..." @oninput="OnSearchChanged" />
            </div>

            <div class="log-content" @onclick:stopPropagation id="logger_log_section">
                @for (int i = 0; i < fileActivityLogs?.Count(); i++)
                {
                    string logItem = fileActivityLogs.ElementAt(i);
                    <div style="align-content:flex-start" @key="i" @onclick:stopPropagation>
                        @((MarkupString)HighlightMatch(logItem))
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button @onclick="ExportFileActivityLogs" style="float: right; margin:1px 5px 1px 0px; background-color: #48772C; color: white;" class="button font-medium success btn-small">Export</button>
                <button @onclick="Clear" style="float: right; margin:1px 5px 1px 0px; background-color: #48772C; color: white;" class="button font-medium success btn-small free-color">Clear</button>
                <button class="button font-medium success btn-large" @onclick="CloseLogWindow">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modalDialog.fileActivity-window > div {
        max-width: 100vw !important;
        max-height: 100vh !important;
        width: 100%;
        height: 100%;
        margin: 8% auto;
        padding-top: 0px;
        padding-left: 0px;
        padding-right: 0px;
        min-height: 30%;
        border: 1px solid #ccc;
        border-radius: 16px;
        box-sizing: border-box;
        text-decoration-color: #494949;
        overflow-y: auto;
    }

    .modal-body .label {
        font-weight: 700 !important;
        font-size: 20px !important;
        line-height: 100% !important;
        vertical-align: middle !important;
    }

    .log-content {
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        width: 100%;
        max-width: 100%;
        height: 440px;
        max-height: 450px;
        overflow-y: scroll;
        text-align: left;
    }

    .highlight {
        background-color: yellow;
        font-weight: bold;
    }

    .search-box input {
        border: 1px solid #ccc;
        border-radius: 4px;
        width: 592px;
        max-width: 592px;
        max-height: 32px;
    }
</style>

<script>
    window.scrollToFirstMatch = function () {
        const el = document.getElementById("firstMatch");
        if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    };
</script>

@code {
    string DebugFileName = $"FileActivityLogs_{DateTime.Now:yyyyMMdd_HHmmss}.txt";
    IEnumerable<string>? fileActivityLogs = new List<string>();
    FileActivityStore? Store;

    protected override void OnInitialized()
    {
        Store = New<FileActivityStore>();
        UpdateLog();
        Store!.OnUpdateViewState += UpdateState;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    void UpdateLog()
    {
        fileActivityLogs = Store?.GetFileActivityLogs();
    }

    private async Task ExportFileActivityLogs()
    {
        try
        {
            string originalFilePath = Resolve.WorkFolder.FileInfo.FileItemInfo("FileActivityLog.txt").FullName;
            string downloadsFolderPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
            string destinationFilePath = Path.Combine(downloadsFolderPath, DebugFileName);

            int count = 1;
            while (File.Exists(destinationFilePath))
            {
                DebugFileName = $"FileActivityLog_{DateTime.Now:yyyyMMdd_HHmmss}_{count}.txt";
                destinationFilePath = Path.Combine(downloadsFolderPath, DebugFileName);
                count++;
            }

            File.Copy(originalFilePath, destinationFilePath);
            StatusAlerService.Success("Exported successfully!");
        }
        catch (Exception ex)
        {
            await New<Core.UI.IPopup>().ShowAsync(Core.UI.PopupButtons.Ok, AxCrypt.Content.Texts.MessageErrorTitle, ex.Message);
            StatusAlerService.Error("Failed to export!");
        }
    }

    void Clear()
    {
        Store.Clear();
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task CloseLogWindow()
    {
        New<IDebugLoggingWindow>().CloseLogWindow(Utility.LogType.FileActivity);
    }

    private string SearchText = "";

    private string HighlightMatch(string input)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return System.Net.WebUtility.HtmlEncode(input);
        }

        string pattern = System.Text.RegularExpressions.Regex.Escape(SearchText);
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        int matchCount = 0;
        string highlighted = regex.Replace(System.Net.WebUtility.HtmlEncode(input), match =>
        {
            matchCount++;
            string spanId = matchCount == 1 ? "id='firstMatch'" : "";
            return $"<span class=\"highlight\" {spanId}>{match.Value}</span>";
        });

        return highlighted;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        await Task.Yield();
        await JSRuntime.InvokeVoidAsync("scrollToFirstMatch");
    }
}