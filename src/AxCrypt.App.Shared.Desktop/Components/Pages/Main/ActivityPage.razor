@using AxCrypt.App.Shared.Desktop.Models

@inject NavigationManager Navigation

<div class="activity-shell">
    <div class="act-header">
       @*  <div>
            <h1 class="act-title">Activity Logs</h1>
            <p class="act-sub">Full audit trail of all file operations, access events, and security actions</p>
        </div> *@
        <div class="act-header-actions">
            <select class="act-filter" @bind="FilterType">
                <option value="">All Events</option>
                <option value="encrypt">Encrypt</option>
                <option value="decrypt">Decrypt</option>
                <option value="share">Share</option>
                <option value="delete">Delete</option>
                <option value="login">Login</option>
            </select>
            <select class="act-filter" @bind="FilterPeriod">
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="all">All Time</option>
            </select>
            <button class="act-export-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export
            </button>
        </div>
    </div>

    <!-- Stats row -->
    <div class="act-stats">
        @foreach (var s in Stats)
        {
            <div class="act-stat">
                <span class="as-num">@s.Count</span>
                <span class="as-label">@s.Label</span>
            </div>
        }
    </div>

    <!-- Timeline -->
    <div class="act-timeline">
        @foreach (var grp in GroupedLogs)
        {
            <div class="act-date-group">
                <div class="act-date-label">@grp.Key</div>
                @foreach (var log in grp.Value)
                {
                    <div class="act-log-row">
                        <div class="alr-icon alr-icon--@log.Type">
                            @((MarkupString)log.IconSvg)
                        </div>
                        <div class="alr-body">
                            <span class="alr-action">@log.Action</span>
                            <span class="alr-file">@log.FileName</span>
                        </div>
                        <div class="alr-right">
                            <span class="alr-time">@log.Time</span>
                            <span class="alr-badge alr-badge--@log.Type">@log.Type</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string FilterType   { get; set; } = "";
    private string FilterPeriod { get; set; } = "week";

    private List<(int Count, string Label)> Stats = new()
    {
        (48, "Files Encrypted"), (12, "Files Decrypted"), (6, "Files Shared"), (3, "Files Deleted"), (2, "Login Events")
    };

    private List<ActivityLog> AllLogs = new()
    {
        new(){Action="Encrypted",     FileName="Project_Proposal.pdf",  Type="encrypt", Time="2:30 PM", Date="Today"},
        new(){Action="Encrypted",     FileName="Vacation_Photos.zip",   Type="encrypt", Time="11:20 AM",Date="Today"},
        new(){Action="Opened",        FileName="Financial_Report.xlsx", Type="decrypt", Time="9:15 AM", Date="Today"},
        new(){Action="Shared key for",FileName="Client_Records.enc",    Type="share",   Time="8:40 AM", Date="Today"},
        new(){Action="Encrypted",     FileName="Presentation.pptx",     Type="encrypt", Time="4:10 PM", Date="Yesterday"},
        new(){Action="Deleted",       FileName="old_draft.docx",        Type="delete",  Time="3:22 PM", Date="Yesterday"},
        new(){Action="Encrypted",     FileName="ideas.txt",             Type="encrypt", Time="2:05 PM", Date="Yesterday"},
        new(){Action="Logged in from",FileName="Windows 11 · Chrome",   Type="login",   Time="9:00 AM", Date="Yesterday"},
        new(){Action="Encrypted",     FileName="Contract_2025.pdf",     Type="encrypt", Time="11:30 AM",Date="May 20"},
        new(){Action="Shared key for",FileName="Team_Report.pdf",       Type="share",   Time="10:15 AM",Date="May 20"},
        new(){Action="Decrypted",     FileName="Invoice_Q1.pdf",        Type="decrypt", Time="3:45 PM", Date="May 19"},
    };

    private Dictionary<string, List<ActivityLog>> GroupedLogs
    {
        get
        {
            var filtered = string.IsNullOrEmpty(FilterType)
                ? AllLogs
                : AllLogs.Where(l => l.Type == FilterType).ToList();
            return filtered.GroupBy(l => l.Date).ToDictionary(g => g.Key, g => g.ToList());
        }
    }

    private class ActivityLog
    {
        public string Action   { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string Type     { get; set; } = string.Empty;
        public string Time     { get; set; } = string.Empty;
        public string Date     { get; set; } = string.Empty;
        public string IconSvg  => Type switch
        {
            "encrypt" => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#2563eb' stroke-width='2'><rect x='3' y='11' width='18' height='11' rx='2'/><path d='M7 11V7a5 5 0 0110 0v4'/></svg>",
            "decrypt" => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#16a34a' stroke-width='2'><rect x='3' y='11' width='18' height='11' rx='2'/><path d='M7 11V7a3 3 0 016 0v4'/><circle cx='12' cy='16' r='1' fill='#16a34a'/></svg>",
            "share"   => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#d97706' stroke-width='2'><circle cx='18' cy='5' r='3'/><circle cx='6' cy='12' r='3'/><circle cx='18' cy='19' r='3'/><line x1='8.59' y1='13.51' x2='15.42' y2='17.49'/></svg>",
            "delete"  => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#ef4444' stroke-width='2'><polyline points='3 6 5 6 21 6'/><path d='M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6'/></svg>",
            _         => "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#6b7280' stroke-width='2'><path d='M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>",
        };
    }
}
