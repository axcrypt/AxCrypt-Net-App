@inject NavigationManager Navigation

<div class="feedback-shell">
    <div class="fb-header">
        <h1 class="fb-title">Feedback</h1>
        <p class="fb-sub">Share your ideas, report bugs, or rate your experience. Your feedback directly shapes SecureApp.</p>
    </div>

    <!-- Quick rating -->
    <div class="fb-rating-card">
        <h3 class="fb-card-title">How is your experience with SecureApp?</h3>
        <div class="fb-emoji-row">
            @foreach (var r in Ratings)
            {
                <button class="fb-emoji-btn @(SelectedRating == r.Value ? "fb-emoji-btn--active" : "")"
                        @onclick="() => SelectedRating = r.Value" title="@r.Label">
                    <span class="fb-emoji">@r.Emoji</span>
                    <span class="fb-emoji-label">@r.Label</span>
                </button>
            }
        </div>
    </div>

    <!-- Feedback form -->
    <div class="fb-form-card">
        <div class="fb-type-tabs">
            @foreach (var t in new[]{"💡 Idea","🐛 Bug","⭐ Review","❓ Question"})
            {
                <button class="fb-type-tab @(FeedbackType==t?"fb-type-tab--active":"")"
                        @onclick="()=>FeedbackType=t">@t</button>
            }
        </div>
        <div class="fb-field">
            <label class="fb-label">Summary</label>
            <input type="text" class="fb-input" @bind="FeedbackTitle" placeholder="Brief description..." />
        </div>
        <div class="fb-field">
            <label class="fb-label">Details</label>
            <textarea class="fb-textarea" @bind="FeedbackBody" placeholder="Tell us more..."></textarea>
        </div>
        @if (!string.IsNullOrEmpty(SubmitStatus))
        {
            <div class="fb-success">✓ @SubmitStatus</div>
        }
        <button class="fb-submit-btn" @onclick="SubmitFeedback">
            Send Feedback
        </button>
    </div>

    <!-- Previous feedback -->
    <div class="fb-history">
        <h3 class="fb-hist-title">Your Previous Feedback</h3>
        @foreach (var f in PreviousFeedback)
        {
            <div class="fb-hist-row">
                <span class="fb-hist-type">@f.Type</span>
                <span class="fb-hist-title2">@f.Title</span>
                <span class="fb-hist-status fb-hist-status--@f.StatusKey">@f.Status</span>
                <span class="fb-hist-date">@f.Date</span>
            </div>
        }
    </div>
</div>

@code {
    private int    SelectedRating { get; set; } = 0;
    private string FeedbackType   { get; set; } = "💡 Idea";
    private string FeedbackTitle  { get; set; } = string.Empty;
    private string FeedbackBody   { get; set; } = string.Empty;
    private string SubmitStatus   { get; set; } = string.Empty;

    private List<(int Value, string Emoji, string Label)> Ratings = new()
    { (1,"😞","Poor"),(2,"😐","Okay"),(3,"🙂","Good"),(4,"😊","Great"),(5,"🤩","Excellent") };

    private async void SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(FeedbackTitle)) return;
        await Task.Delay(500);
        SubmitStatus = "Thanks for your feedback! We'll review it shortly.";
        FeedbackTitle = FeedbackBody = string.Empty;
    }

    private List<(string Type, string Title, string Status, string StatusKey, string Date)> PreviousFeedback = new()
    {
        ("💡 Idea","Add dark mode support","Under Review","review","May 15, 2025"),
        ("🐛 Bug","Drag & drop not working on macOS","Fixed","fixed","May 10, 2025"),
        ("⭐ Review","Great app, very intuitive","Seen","seen","April 28, 2025"),
    };
}
