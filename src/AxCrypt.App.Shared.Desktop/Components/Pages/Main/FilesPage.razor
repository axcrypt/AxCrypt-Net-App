@using AxCrypt.App.Shared.Desktop.Models
@inject NavigationManager Navigation

<div class="files-shell">
    <div class="files-header">
        @* <div>
            <h1 class="files-title">Files</h1>
            <p class="files-subtitle">All your encrypted files in one place — open, share, or manage them here</p>
        </div> *@
        <div class="files-header-actions">
            <div class="fh-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input @bind="SearchQ" @bind:event="oninput" placeholder="Search files..." class="fh-search-input" />
            </div>
            <select class="fh-sort-select" @bind="SortBy">
                <option value="date">Newest First</option>
                <option value="name">Name A–Z</option>
                <option value="size">Size</option>
                <option value="status">Status</option>
            </select>
            <button class="fh-btn" @onclick='() => Navigation.NavigateTo("/actions/encrypt")'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Encrypt New File
            </button>
        </div>
    </div>

    <!-- Stats bar -->
    <div class="files-stats">
        <div class="fstat"><span class="fstat-num">@AllFiles.Count</span><span class="fstat-label">Total Files</span></div>
        <div class="fstat"><span class="fstat-num">@AllFiles.Count(f=>f.Status=="Encrypted")</span><span class="fstat-label">Encrypted</span></div>
        <div class="fstat"><span class="fstat-num">@AllFiles.Count(f=>f.Status=="Opened")</span><span class="fstat-label">Opened</span></div>
        <div class="fstat"><span class="fstat-num">@AllFiles.Count(f=>f.Status=="Key Shared")</span><span class="fstat-label">Shared</span></div>
    </div>

    <!-- Filter tabs -->
    <div class="files-tabs">
        @foreach (var t in new[]{"All","Encrypted","Opened","Key Shared"})
        {
            <button class="ftab @(ActiveTab==t?"ftab--active":"")" @onclick="()=>ActiveTab=t">
                @t <span class="ftab-count">@(t=="All"?AllFiles.Count:AllFiles.Count(f=>f.Status==t))</span>
            </button>
        }
    </div>

    @if (!FilteredFiles.Any())
    {
        <div class="files-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p class="fe-title">@(ActiveTab=="All"?"No encrypted files yet":"No "+ActiveTab.ToLower()+" files")</p>
            <p class="fe-desc">@(ActiveTab=="All"?"Encrypt your first file to see it here.":"Files with this status will appear here.")</p>
            @if (ActiveTab=="All") {
                <button class="fe-cta" @onclick='()=>Navigation.NavigateTo("/actions/encrypt")'>Encrypt your first file</button>
            }
        </div>
    }
    else
    {
        <div class="files-grid-header">
            <div class="fg-col fg-check"><input type="checkbox" @onchange="ToggleAll" /></div>
            <div class="fg-col fg-name">Name</div>
            <div class="fg-col fg-status">Status</div>
            <div class="fg-col fg-date">Date Modified</div>
            <div class="fg-col fg-size">Size</div>
            <div class="fg-col fg-algo">Algorithm</div>
            <div class="fg-col fg-act"></div>
        </div>
        @foreach (var f in FilteredFiles)
        {
            <div class="files-row @(f.IsSelected?"files-row--sel":"")">
                <div class="fg-col fg-check"><input type="checkbox" checked="@f.IsSelected" @onchange="(e)=>f.IsSelected=(bool)(e.Value??false)" /></div>
                <div class="fg-col fg-name">
                    <span class="fr-icon" style="background:@f.IconColor">
                        <svg width="28" height="28" viewBox="0 0 28 28"><text x="2" y="18" font-size="8" font-weight="bold" fill="#3b82f6">@f.Name.Split('.').LastOrDefault()?.ToUpper()</text></svg>
                    </span>
                    <div class="fr-text">
                        <span class="fr-name">@f.Name</span>
                        <span class="fr-sub">@f.SubText</span>
                    </div>
                </div>
                <div class="fg-col fg-status"><span class="badge badge--@BadgeClass(f.Status)">@f.Status</span></div>
                <div class="fg-col fg-date">@f.Date</div>
                <div class="fg-col fg-size">@f.Size</div>
                <div class="fg-col fg-algo"><span class="algo-chip">AES-256</span></div>
                <div class="fg-col fg-act">
                    <button class="fr-btn" title="Open" @onclick='()=>Navigation.NavigateTo($"/files/{Uri.EscapeDataString(f.Name)}")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                    <button class="fr-btn" title="Share">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/></svg>
                    </button>
                    <button class="fr-btn fr-btn--danger" title="Delete">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    </button>
                </div>
            </div>
        }

        @if (SelectedFiles.Any())
        {
            <div class="bulk-bar">
                <span>@SelectedFiles.Count file(s) selected</span>
                <button class="bulk-btn">Decrypt All</button>
                <button class="bulk-btn">Share All</button>
                <button class="bulk-btn bulk-btn--danger">Delete Selected</button>
            </div>
        }
    }
</div>

@code {
    private string SearchQ  { get; set; } = string.Empty;
    private string ActiveTab { get; set; } = "All";
    private string SortBy    { get; set; } = "date";

    private List<FileItem> AllFiles = new()
    {
        new(){Name="Project_Proposal.pdf",SubText="Encrypted",Status="Encrypted",Date="Today, 2:30 PM",Size="25.4 MB",IconColor="#eff6ff",ExtLabel=""},
        new(){Name="Vacation_Photos.zip",SubText="Encrypted",Status="Encrypted",Date="Today, 11:20 AM",Size="45.8 MB",IconColor="#eef2ff",ExtLabel=""},
        new(){Name="Financial_Report.xlsx",SubText="Encrypted",Status="Opened",Date="Yesterday, 4:15 PM",Size="12.3 MB",IconColor="#f0fdf4",ExtLabel=""},
        new(){Name="Client_Records.enc",SubText="Encrypted",Status="Key Shared",Date="Yesterday, 3:40 PM",Size="8.7 MB",IconColor="#eff6ff",ExtLabel=""},
        new(){Name="Presentation.pptx",SubText="Encrypted",Status="Encrypted",Date="May 20, 2025",Size="30.1 MB",IconColor="#fff7ed",ExtLabel=""},
        new(){Name="ideas.txt",SubText="Encrypted",Status="Encrypted",Date="May 19, 2025",Size="2.1 MB",IconColor="#eff6ff",ExtLabel=""},
        new(){Name="Contract_2025.pdf",SubText="Encrypted",Status="Encrypted",Date="May 18, 2025",Size="1.4 MB",IconColor="#eff6ff",ExtLabel=""},
        new(){Name="Team_Photo.jpg",SubText="Encrypted",Status="Opened",Date="May 17, 2025",Size="4.8 MB",IconColor="#ecfdf5",ExtLabel=""},
    };

    private List<FileItem> SelectedFiles => AllFiles.Where(f=>f.IsSelected).ToList();

    private List<FileItem> FilteredFiles
    {
        get
        {
            var q = (ActiveTab=="All"?AllFiles:AllFiles.Where(f=>f.Status==ActiveTab)).ToList();
            if (!string.IsNullOrEmpty(SearchQ)) q=q.Where(f=>f.Name.Contains(SearchQ,StringComparison.OrdinalIgnoreCase)).ToList();
            return SortBy switch
            {
                "name" => q.OrderBy(f=>f.Name).ToList(),
                "size" => q.OrderByDescending(f=>f.Size).ToList(),
                "status"=> q.OrderBy(f=>f.Status).ToList(),
                _ => q
            };
        }
    }

    private static string BadgeClass(string s) => s switch{"Encrypted"=>"enc","Opened"=>"opened","Key Shared"=>"shared",_=>"enc"};
    private void ToggleAll(ChangeEventArgs e){var v=(bool)(e.Value??false);AllFiles.ForEach(f=>f.IsSelected=v);}
}
