@inject NavigationManager Navigation

<div class="support-shell">
    <div class="sup-header">
        <h1 class="sup-title">Support</h1>
        <p class="sup-sub">Get help, browse documentation, and contact the SecureApp team</p>
    </div>

    <!-- Search knowledge base -->
    <div class="sup-search-card">
        <h3>How can we help you?</h3>
        <div class="sup-search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" @bind="SearchQ" @bind:event="oninput" placeholder="Search help articles..." class="sup-search-input" />
        </div>
    </div>

    <!-- Quick help categories -->
    <div class="sup-categories">
        @foreach (var cat in Categories)
        {
            <button class="sup-cat-card" @onclick="() => ActiveCat = cat.Id">
                <div class="scc-icon" style="background:@cat.IconBg">@((MarkupString)cat.IconSvg)</div>
                <span class="scc-label">@cat.Label</span>
                <span class="scc-count">@cat.ArticleCount articles</span>
            </button>
        }
    </div>

    <!-- FAQ -->
    <div class="sup-faq">
        <h3 class="sup-faq-title">Frequently Asked Questions</h3>
        @foreach (var faq in FilteredFaqs)
        {
            <div class="faq-item @(ExpandedFaq == faq.Id ? "faq-item--open" : "")"
                 @onclick="() => ExpandedFaq = ExpandedFaq == faq.Id ? -1 : faq.Id">
                <div class="faq-q">
                    <span>@faq.Question</span>
                    <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>
                @if (ExpandedFaq == faq.Id)
                {
                    <div class="faq-a">@faq.Answer</div>
                }
            </div>
        }
    </div>

    <!-- Contact options -->
    <div class="sup-contact">
        <h3 class="sup-contact-title">Still need help?</h3>
        <div class="sup-contact-grid">
            <div class="sco-card">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <h4>Live Chat</h4>
                <p>Chat with us in real time</p>
                <button class="sco-btn sco-btn--blue">Start Chat</button>
            </div>
            <div class="sco-card">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <h4>Email Support</h4>
                <p>We reply within 24 hours</p>
                <button class="sco-btn">Send Email</button>
            </div>
            <div class="sco-card">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
                <h4>Documentation</h4>
                <p>Browse our full docs</p>
                <button class="sco-btn">Open Docs</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string SearchQ    { get; set; } = string.Empty;
    private int    ExpandedFaq{ get; set; } = -1;
    private string ActiveCat  { get; set; } = string.Empty;

    private List<(string Id, string Label, int ArticleCount, string IconBg, string IconSvg)> Categories = new()
    {
        ("start",    "Getting Started",    12, "#dbeafe", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#2563eb' stroke-width='2'><path d='M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z'/></svg>"),
        ("encrypt",  "Encryption & Keys",  18, "#dcfce7", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#16a34a' stroke-width='2'><rect x='3' y='11' width='18' height='11' rx='2'/><path d='M7 11V7a5 5 0 0110 0v4'/></svg>"),
        ("sharing",  "Sharing & Keys",      9, "#fef3c7", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#d97706' stroke-width='2'><circle cx='18' cy='5' r='3'/><circle cx='6' cy='12' r='3'/><circle cx='18' cy='19' r='3'/><line x1='8.59' y1='13.51' x2='15.42' y2='17.49'/></svg>"),
        ("account",  "Account & Billing",   7, "#f5f3ff", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#7c3aed' stroke-width='2'><path d='M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>"),
        ("mobile",   "Mobile Apps",          5, "#ecfdf5", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#059669' stroke-width='2'><rect x='5' y='2' width='14' height='20' rx='2'/><line x1='12' y1='18' x2='12.01' y2='18'/></svg>"),
        ("security", "Security & Privacy",  11, "#fff7ed", "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#ea580c' stroke-width='2'><path d='M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z'/></svg>"),
    };

    private record FaqItem(int Id, string Question, string Answer);

    private List<FaqItem> AllFaqs = new()
    {
        new(1, "Is my data sent to any server?", "No. All encryption and decryption happens entirely on your local device. SecureApp never transmits, stores, or has access to your unencrypted files or passwords."),
        new(2, "What happens if I forget my vault password?", "SecureApp cannot recover your vault password — this is by design, as it ensures only you can access your files. We recommend storing your password in a secure password manager."),
        new(3, "How is AES-256 different from AES-128?", "AES-256 uses a 256-bit key (vs 128-bit), making brute-force attacks computationally infeasible even with future hardware. Both are considered secure, but AES-256 provides an extra margin."),
        new(4, "Can I encrypt files on my phone?", "Yes — SecureApp is available on iOS and Android. All features including vault, sharing, and decryption work on mobile."),
        new(5, "How do share keys work?", "A share key is a one-time token that lets a specific recipient open a specific encrypted file. You can set an expiry date and revoke the key at any time — the recipient immediately loses access."),
        new(6, "How do I upgrade to Pro?", "Click 'Upgrade to Pro' in the sidebar or visit the Upgrade page. We accept all major credit cards and PayPal. Your features activate instantly after payment."),
    };

    private IEnumerable<FaqItem> FilteredFaqs => string.IsNullOrEmpty(SearchQ)
        ? AllFaqs
        : AllFaqs.Where(f => f.Question.Contains(SearchQ, StringComparison.OrdinalIgnoreCase) || f.Answer.Contains(SearchQ, StringComparison.OrdinalIgnoreCase));
}
