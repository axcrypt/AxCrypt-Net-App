@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Services
@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

@inject NavigationManager Navigation
@inject UserService userService

<div class="upgrade-shell">

    @* ── Hero ─────────────────────────────────────────────────── *@
    <div class="up-hero">
        @if (ShowPremiumOnly)
        {
            <div class="up-hero-badge up-hero-badge--premium">Re-activate Premium</div>
            <h1 class="up-hero-title">Welcome back to Premium</h1>
            <p class="up-hero-sub">Pick up where you left off — unlimited encryption, key sharing, and vault, all included.</p>
        }
        else if (ShowBusinessOnly)
        {
            <div class="up-hero-badge up-hero-badge--business">Re-activate Business</div>
            <h1 class="up-hero-title">Bring your team back to AxCrypt Business</h1>
            <p class="up-hero-sub">Master key recovery, group sharing, audit logs, and manage users — everything your organization had.</p>
        }
        else
        {
            <div class="up-hero-badge">Limited Time — 20% Off Annually</div>
            <h1 class="up-hero-title">Unlock encryption and more features of AxCrypt</h1>
            <p class="up-hero-sub">Military-grade encryption, unlimited files, secure sharing and vault — everything you need to protect what matters.</p>
        }
    </div>

    @* ── Plan grid ─────────────────────────────────────────────── *@
    <div class="up-plans up-plans--@PlanLayout">

        @* ══════════════════════════════════════════════════════
           ALL-THREE layout — three equal vertical cards
           ══════════════════════════════════════════════════════ *@
        @if (ShowAllPlans)
        {
            @* Free *@
            <div class="up-plan">
                <div class="up-plan-header">
                    <span class="up-plan-name">@Texts.LicenseFreeNameText</span>
                    <p class="up-plan-desc">Get started with basic encryption</p>
                </div>
                <ul class="up-features">
                    <li class="up-feat up-feat--ok">@CheckIcon Encrypt up to 2 files / month</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Share 1 key with 1 user</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.PricingFeatureListAES256</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Open encrypted files</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Add up to 10 passwords, 1 share</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secured Messenger — 10 messages, 1 contact</li>
                    <li class="up-feat up-feat--no">@CrossIcon Secure Vault</li>
                    <li class="up-feat up-feat--no">@CrossIcon Cloud Drive Encryption</li>
                </ul>
                <button class="up-plan-cta up-plan-cta--current">Current Plan</button>
            </div>

            @* Premium *@
            <div class="up-plan up-plan--pro">
                <div class="up-plan-header">
                    <span class="up-plan-name">@Texts.LicensePremiumNameText</span>
                    <p class="up-plan-desc">Everything you need for serious file security</p>
                </div>
                <ul class="up-features">
                    <li class="up-feat up-feat--ok">@CheckIcon <strong>Unlimited</strong>&nbsp;AES-256 encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secure Vault (unlimited)</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Cloud Drive Encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.GetStartedKeySharingHeading</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Batch encrypt / decrypt folders</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Password Manager</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secured Messenger</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Priority Support + live chat</li>
                </ul>
                <button class="up-plan-cta up-plan-cta--pro premium-btn" @onclick="OnPremiumUpgradeClick">
                    Upgrade to Premium Now →
                </button>
                <p class="up-refund">Cancel anytime</p>
            </div>

            @* Business *@
            <div class="up-plan up-plan--biz">
                <div class="up-plan-header">
                    <span class="up-plan-name">@Texts.LicenseBusinessNameText</span>
                    <p class="up-plan-desc">For teams that encrypt and share together</p>
                </div>
                <ul class="up-features">
                    <li class="up-feat up-feat--ok">@CheckIcon <strong>Everything</strong>&nbsp;from Premium</li>
                    <li class="up-feat-section">For your team</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Master Key recovery</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Group management — seats, roles, invites</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Group key access — shared encryption keys</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Shared team vault</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Central admin dashboard</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Multi factor authentication</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Role-based access control</li>
                    <li class="up-feat up-feat--ok">@CheckIcon HIPAA / GDPR / NIS 2 compliance</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.PricingFeatureListAccountManager</li>
                </ul>
                <button class="up-plan-cta up-plan-cta--pro business-btn" @onclick="OnBusinessUpgradeClick">
                    Upgrade to Business Now →
                </button>
                <p class="up-refund">Cancel anytime</p>
            </div>
        }

        @* ══════════════════════════════════════════════════════
           PREMIUM-ONLY — full-width horizontal card
           ══════════════════════════════════════════════════════ *@
        @if (ShowPremiumOnly)
        {
            <div class="up-plan up-plan--pro up-plan--wide">

                <div class="up-wide-header">
                    <div class="up-wide-header-text">
                        <span class="up-plan-name">@Texts.LicensePremiumNameText</span>
                        <p class="up-plan-desc">Everything you need for serious file security</p>
                    </div>
                    <div class="up-wide-header-cta">
                        <button class="up-plan-cta up-plan-cta--pro premium-btn" @onclick="OnPremiumUpgradeClick">
                            Upgrade to Premium Now →
                        </button>
                        <p class="up-refund">Cancel anytime</p>
                    </div>
                </div>

                <ul class="up-features up-features--grid">
                    <li class="up-feat up-feat--ok">@CheckIcon <strong>Unlimited</strong>&nbsp;AES-256 encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secure Vault (unlimited)</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Cloud Drive Encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.GetStartedKeySharingHeading</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Batch encrypt / decrypt folders</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Password Manager</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secured Messenger</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.PricingFeatureListMobileApps</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Priority Support + live chat</li>
                    <li class="up-feat up-feat--ok">@CheckIcon HIPAA / GDPR compliant</li>
                </ul>
            </div>
        }

        @* ══════════════════════════════════════════════════════
           BUSINESS-ONLY — full-width horizontal card with two
           sections: Premium features first, then team features
           ══════════════════════════════════════════════════════ *@
        @if (ShowBusinessOnly)
        {
            <div class="up-plan up-plan--biz up-plan--wide">

                <div class="up-wide-header">
                    <div class="up-wide-header-text">
                        <span class="up-plan-name">@Texts.LicenseBusinessNameText</span>
                        <p class="up-plan-desc">For teams that encrypt and share together</p>
                    </div>
                    <div class="up-wide-header-cta">
                        <button class="up-plan-cta up-plan-cta--pro business-btn" @onclick="OnBusinessUpgradeClick">
                            Upgrade to Business Now →
                        </button>
                        <p class="up-refund">Cancel anytime</p>
                    </div>
                </div>

                @* Premium features section *@
                <div class="up-wide-section-label">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z"/>
                    </svg>
                    Premium features included
                </div>
                <ul class="up-features up-features--grid">
                    <li class="up-feat up-feat--ok">@CheckIcon <strong>Unlimited</strong>&nbsp;AES-256 encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secure Vault (unlimited)</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Cloud Drive Encryption</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.GetStartedKeySharingHeading</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Batch encrypt / decrypt folders</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Password Manager</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Secured Messenger</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Priority Support + live chat</li>
                </ul>

                @* Business team features section *@
                <div class="up-wide-section-label up-wide-section-label--team">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="7" r="3"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>
                        <circle cx="17" cy="6" r="2"/><path d="M21 21v-2a4 4 0 00-3-3.86"/>
                    </svg>
                    Team &amp; admin features
                </div>
                <ul class="up-features up-features--grid">
                    <li class="up-feat up-feat--ok">@CheckIcon Master Key recovery</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Group management — seats, roles, invites</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Group key access — shared encryption keys</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Shared team vault</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Central admin dashboard</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Audit log — every encrypt, share &amp; access</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Multi factor authentication</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Role-based access control</li>
                    <li class="up-feat up-feat--ok">@CheckIcon HIPAA / GDPR / NIS 2 compliance</li>
                    <li class="up-feat up-feat--ok">@CheckIcon Per-seat invoicing &amp; PO support</li>
                    <li class="up-feat up-feat--ok">@CheckIcon @Texts.PricingFeatureListAccountManager</li>
                </ul>
            </div>
        }

    </div>

    @* ── Trust row ─────────────────────────────────────────────── *@
    <div class="up-trust">
        <div class="up-trust-item">🔒 <span>All encryption is <strong>local</strong> — we never see your files</span></div>
        <div class="up-trust-item">🛡️ <span><strong>AES-256</strong> military-grade standard</span></div>
        <div class="up-trust-item">↩️ <span>File security from <strong>Sweden</strong></span></div>
        <div class="up-trust-item">🌍 <span>Trusted by <strong>1,000,000+</strong> users worldwide</span></div>
    </div>
</div>

@code {
    private SignUpFrom Origin => userService.SignUpFrom;

    private bool ShowPremiumOnly  => Origin == SignUpFrom.Premium;
    private bool ShowBusinessOnly => Origin == SignUpFrom.Business;
    private bool ShowAllPlans     => Origin == SignUpFrom.None || Origin == SignUpFrom.Free;

    // "wide" for single-plan horizontal layout, "3" for full ladder
    private string PlanLayout => ShowAllPlans ? "3" : "wide";

    private static RenderFragment CheckIcon =>
        @<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#22c55e" />
            <polyline points="8 12 11 15 16 9" stroke="white" stroke-width="2" fill="none" />
        </svg>;

    private static RenderFragment CrossIcon =>
        @<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#e5e7eb" />
            <line x1="8" y1="12" x2="16" y2="12" stroke="white" stroke-width="2" />
        </svg>;

    private void OnPremiumUpgradeClick() =>
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://account.axcrypt.net/en/HomeUser/Login?eff=1&reqFrom=Premium"));

    private void OnBusinessUpgradeClick() =>
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://account.axcrypt.net/en/HomeUser/Login?eff=1&reqFrom=Business"));
}
