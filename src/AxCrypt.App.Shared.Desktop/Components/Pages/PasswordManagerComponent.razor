@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.Data
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Desktop.Components.PasswordManager
@using AxCrypt.App.Shared.Desktop.Components.Shared
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.Utility
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve

@inject SecretService secretService
@inject SecretsListViewModel secretsListViewModel
@inject NewSecretViewModel newSecretViewModel
@inject EditSecretViewModel editSecretViewModel
@inject ViewSecretViewModel viewSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IStatusAlertService StatusAlertService
@inject PaidFeaturegateService paidFeaturegateService

@*
    Password Manager — complete master-detail.

    Left  : search + type filter + list of every secret (Password /
            Card / Note). Free-tier quota bar at the top.
    Right : one of four modes, all inline (no route navigation):
              Empty  — nothing selected
              View   — read-only detail + Copy / Show / Open / Share.
                       Edit + Delete shown to paid users only.
              Edit   — editable fields (paid users only)
              Create — blank form for a chosen type. Free users may
                       create up to their plan cap; past it the
                       upgrade dialog is surfaced.

    Crash-safety: ViewSecretViewModel / EditSecretViewModel /
    NewSecretViewModel are now safe to inject at mount time — the
    shared base ManageSecretViewModel constructor was hardened to
    tolerate a null CurrentSecret / unresolved subscription state.
*@

<div class="pmx-shell">

    @* Free-tier quota — hides for paid plans. *@
    <AxCrypt.App.Shared.Desktop.Components.Shared.FreePlanLimitBar
        Feature="AxCrypt.App.Entitlement.Contracts.FeatureKey.PasswordEntry" />

    <div class="pmx-split">

        @* ═══════════ Left pane ═══════════ *@
        <aside class="pmx-list-pane">

            @* Top-level scope filter. "All" shows the user's own
               secrets; "Shared with me" lists the secrets other people
               have shared with this account — loaded from the dedicated
               shared data source by SecretsListViewModel.FilterSharedSecrets. *@
            <div class="pmx-scope" role="tablist">
                <button type="button" class="pmx-scope-tab @(!_scopeShared ? "pmx-scope-tab--active" : "")"
                        @onclick="() => SetScope(false)">All</button>
                <button type="button" class="pmx-scope-tab @(_scopeShared ? "pmx-scope-tab--active" : "")"
                        @onclick="() => SetScope(true)">Shared with me</button>

                @* Export / download lives at the end of the scope row —
                   a secondary, list-level action kept clear of the main
                   search + New toolbar. Only shown in the "All" scope:
                   export operates on the user's own secrets, not on the
                   "Shared with me" list. *@
                @if (!_scopeShared)
                {
                    <div class="pmx-export">
                        <button type="button" class="pmx-icon-btn" @onclick="ToggleExportMenu"
                                title="Export / download">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        </button>
                        @if (_showExportMenu)
                        {
                            <div class="pmx-menu-backdrop" @onclick="() => _showExportMenu = false"></div>
                            <div class="pmx-export-menu" role="menu">
                                <p class="pmx-export-head">Download all entries</p>
                                <button type="button" class="pmx-export-item" role="menuitem"
                                        @onclick='() => ExportAs("TXT")'>
                                    <span class="pmx-export-ext">.txt</span>
                                    <span>Plain text file</span>
                                </button>
                                <button type="button" class="pmx-export-item" role="menuitem"
                                        @onclick='() => ExportAs("XML")'>
                                    <span class="pmx-export-ext">.xml</span>
                                    <span>XML file</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Search + New on one row — the page title is already shown
               in the top bar, so it's intentionally not repeated here.
               That frees vertical space for more list rows. *@
            <div class="pmx-toolbar">
                <div class="pmx-search">
                    <svg class="pmx-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" class="pmx-search-input"
                           @bind="@secretsListViewModel.Keyword"
                           @oninput="secretsListViewModel.OnInputChanged"
                           placeholder="@Texts.SearchPasswordPlaceHolder" />
                </div>
                <button type="button" class="pmx-add-btn" @onclick="OnAddNewClick" title="Add new">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>New</span>
                </button>
            </div>

            <div class="pmx-tabs" role="tablist">
                <button type="button" class="pmx-tab @(_typeFilter == null ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(null)">All</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Password ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Password)">@Texts.PassphrasePrompt</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Note ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Note)">@Texts.NoteLabel</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Card ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Card)">@Texts.CardPrompt</button>
            </div>

            <div class="pmx-list-scroll">
                @* The list loader is suppressed while a create is saving —
                   that wait belongs to the detail pane (.pmx-save-overlay),
                   not the list, since the action happens in the form. *@
                @if (!_saving)
                {
                    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
                }

                @{
                    var rows = VisibleSecrets();
                }
                @if (!rows.Any())
                {
                    <div class="pmx-list-empty">
                        @if (_scopeShared)
                        {
                            <p class="pmx-list-empty-title">Nothing shared with you yet</p>
                            <p class="pmx-list-empty-sub">Passwords other people share with you will show up here.</p>
                        }
                        else
                        {
                            <p class="pmx-list-empty-title">@Texts.LetsStartOurJourneyText</p>
                            <p class="pmx-list-empty-sub">@Texts.AddFirstPasswordText</p>
                        }
                    </div>
                }
                else
                {
                    <ul class="pmx-list" role="list">
                        @foreach (SecretViewModel s in rows)
                        {
                            bool isSel = _selected?.SecretGuid == s.SecretGuid && _mode != PmMode.Create;
                            <li class="pmx-row @(isSel ? "pmx-row--selected" : "")"
                                tabindex="0" role="button"
                                @onclick="() => SelectSecret(s)"
                                @onkeydown="@(e => { if (e.Key == EnterKey) SelectSecret(s); })">
                                <span class="pmx-row-icon pmx-row-icon--@TypeKey(s.SecretType)">
                                    @TypeIcon(s.SecretType)
                                </span>
                                <span class="pmx-row-text">
                                    <span class="pmx-row-title">@DisplayTitle(s)</span>
                                    <span class="pmx-row-sub">@DisplaySubtitle(s)</span>
                                </span>
                                @if (s.SharedWith != null && s.SharedWith.Any())
                                {
                                    <span class="pmx-row-shared" title="Shared">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                                        </svg>
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </aside>

        @* ═══════════ Right pane ═══════════ *@
        <section class="pmx-detail-pane">
            @switch (_mode)
            {
                case PmMode.Empty:
                    <div class="pmx-detail-empty">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="pmx-detail-empty-icon">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <h3 class="pmx-detail-empty-title">Select an item to view</h3>
                        <p class="pmx-detail-empty-sub">Choose a password, card, or note on the left — or add a new one.</p>
                    </div>
                    break;

                case PmMode.View:
                    @RenderView()
                    break;

                case PmMode.Edit:
                    @RenderEdit()
                    break;

                case PmMode.Create:
                    @RenderCreate()
                    break;
            }

            @* Saving overlay — scoped to the detail pane so the spinner
               sits with the form being saved, not floating in the list. *@
            @if (_saving)
            {
                <div class="pmx-save-overlay">
                    <AxLoader Mode="LoaderMode.Body" Message="Saving…" />
                </div>
            }
        </section>
    </div>

    @* Add-new type picker (modal-ish popover) *@
    @if (_showTypePicker)
    {
        <div class="pmx-picker-backdrop" @onclick="() => _showTypePicker = false">
            <div class="pmx-picker" @onclick:stopPropagation>
                <button type="button" class="pmx-picker-close" title="@Texts.ButtonCancelText"
                        @onclick="() => _showTypePicker = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                        <line x1="6" y1="6" x2="18" y2="18"/>
                        <line x1="18" y1="6" x2="6" y2="18"/>
                    </svg>
                </button>
                <h3 class="pmx-picker-title">What would you like to add?</h3>
                <div class="pmx-picker-grid">
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Password)">
                        <span class="pmx-picker-icon pmx-row-icon--password">@TypeIcon(SecretType.Password)</span>
                        <span class="pmx-picker-label">@Texts.PassphrasePrompt</span>
                        <span class="pmx-picker-desc">Login with username + URL</span>
                    </button>
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Card)">
                        <span class="pmx-picker-icon pmx-row-icon--card">@TypeIcon(SecretType.Card)</span>
                        <span class="pmx-picker-label">@Texts.CardPrompt</span>
                        <span class="pmx-picker-desc">Card number, holder, CVV</span>
                    </button>
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Note)">
                        <span class="pmx-picker-icon pmx-row-icon--note">@TypeIcon(SecretType.Note)</span>
                        <span class="pmx-picker-label">@Texts.NoteLabel</span>
                        <span class="pmx-picker-desc">Free-form secure note</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string EnterKey = "Enter";

    private enum PmMode { Empty, View, Edit, Create }

    private PmMode _mode = PmMode.Empty;
    private SecretViewModel? _selected;
    private SecretType? _typeFilter;
    // Top-level scope: false = the user's own secrets ("All"),
    // true = secrets other people have shared with this user
    // ("Shared with me"). Drives which data source the list loads.
    private bool _scopeShared;
    private SecretType _createType = SecretType.Password;
    private bool _showTypePicker;
    private bool _showShare;
    private bool _showExportMenu;
    // True while a create is being saved — drives the detail-pane
    // overlay and suppresses the list loader for that wait.
    private bool _saving;

    // Edit working copies — never mutate the original until Save succeeds.
    private SecretPasswordViewModel? _ePwd;
    private SecretCardViewModel?     _eCard;
    private SecretNoteViewModel?     _eNote;

    // Show/hide for masked values.
    private bool _showValue;
    private bool _showCardNum;
    private bool _showCvv;

    // True when the user is on a genuine paid plan (edit + share).
    private bool IsPaid => viewSecretViewModel.HasPaidSubscription;

    protected override async Task OnInitializedAsync()
    {
        await secretsListViewModel.UpdateFreeUserSubscriptionAsync();

        // Re-query the genuine subscription state for the edit / share gate.
        try { viewSecretViewModel.InitializeUserSubscription(); } catch { }

        try
        {
            viewSecretViewModel.UserEmail =
                Resolve.KnownIdentities?.DefaultEncryptionIdentity?.UserEmail?.Address ?? string.Empty;
        }
        catch { viewSecretViewModel.UserEmail = string.Empty; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await secretsListViewModel.FindSecrets();
            await InvokeAsync(StateHasChanged);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // ── List ─────────────────────────────────────────────────
    private IEnumerable<SecretViewModel> VisibleSecrets()
    {
        // FilteredSecrets already holds the right data source for the
        // current scope (personal vs shared-with-me). The type tabs
        // just narrow that set further.
        IEnumerable<SecretViewModel> src = secretsListViewModel.FilteredSecrets ?? new();
        if (_typeFilter.HasValue)
        {
            src = src.Where(s => s.SecretType == _typeFilter.Value);
        }
        return src.ToList();
    }

    private void SetTypeFilter(SecretType? t)
    {
        _typeFilter = t;
        StateHasChanged();
    }

    // Top-level scope switch. "Shared with me" loads the secrets other
    // people have shared with this account from the dedicated data
    // source via the existing SecretsListViewModel.FilterSharedSecrets;
    // "All" loads the user's own secrets. Both are the legacy list
    // code paths — no new querying logic is introduced here.
    private async Task SetScope(bool shared)
    {
        if (_scopeShared == shared)
        {
            return;
        }

        _scopeShared = shared;
        // Export only lives in the "All" scope — drop any open menu state.
        _showExportMenu = false;

        // Switching the data source invalidates any open detail pane.
        _selected = null;
        ResetDetailFlags();
        _mode = PmMode.Empty;
        _typeFilter = null;

        if (shared)
        {
            await secretsListViewModel.FilterSharedSecrets(SecretFilterOption.Shared);
        }
        else
        {
            await secretsListViewModel.FilterSecretsBy(SecretFilterOption.All);
        }

        StateHasChanged();
    }

    // ── Export ───────────────────────────────────────────────
    private void ToggleExportMenu()
    {
        _showExportMenu = !_showExportMenu;
        StateHasChanged();
    }

    // Hands off to the existing view-model export, which writes the
    // chosen format ("TXT" / "XML") to the user's Downloads folder and
    // raises its own success / error status alert.
    private async Task ExportAs(string fileType)
    {
        _showExportMenu = false;
        await secretsListViewModel.ExportFile(fileType);
    }

    private void SelectSecret(SecretViewModel s)
    {
        _selected = s;
        secretService.SetCurrentSecret(s);
        viewSecretViewModel.Secret = s;
        ResetDetailFlags();
        _mode = PmMode.View;
        StateHasChanged();
    }

    private void ResetDetailFlags()
    {
        _showValue = _showCardNum = _showCvv = false;
        _showShare = false;
        _ePwd = null; _eCard = null; _eNote = null;
    }

    // ── Create ───────────────────────────────────────────────
    private async Task OnAddNewClick()
    {
        // Re-check the live secret count on every click. A free user may
        // have reached the 10-password cap earlier in this same session,
        // so a page-load-only check would let an 11th entry slip through.
        // CheckFreeUserSecretsCountasync refreshes the cached count and
        // CanAddNewSecret then lets paid plans through while enforcing the
        // free cap (ViewModelHelper.MaxAllowedSecretsCount = 10). Both
        // helpers already exist — no new limit logic is introduced here.
        try { await ViewModelHelper.CheckFreeUserSecretsCountasync(); }
        catch { /* offline / transient — fall back to the cached count */ }

        if (!ViewModelHelper.CanAddNewSecret())
        {
            ShowPasswordLimitGate();
            return;
        }

        _showTypePicker = true;
        StateHasChanged();
    }

    private void ShowPasswordLimitGate()
    {
        paidFeaturegateService.ShowPaidGate(
            "Password Manager",
            "You've reached the free password limit. Upgrade to keep adding unlimited passwords, cards, and secure notes.",
            new[] { "Unlimited password entries", "Save cards and secure notes", "Share secrets securely", Texts.PrioritySupportTitle });
    }

    private void BeginCreate(SecretType type)
    {
        _showTypePicker = false;
        _createType = type;
        _selected = null;
        ResetDetailFlags();

        // Fresh per-type models — NOT the shared static .Empty instances,
        // which would alias state across creates.
        secretService.SecretType = type;
        newSecretViewModel.Secret = new SecretViewModel(
            type,
            new SecretPasswordViewModel(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
            new SecretCardViewModel(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
            new SecretNoteViewModel(string.Empty, string.Empty),
            new List<SecretSharedUserViewModel>());
        newSecretViewModel.ErrorMessage = string.Empty;

        _mode = PmMode.Create;
        StateHasChanged();
    }

    private async Task SaveCreate()
    {
        // Show the wait in the detail pane (over the form) instead of
        // the list — see _saving usage in the markup.
        _saving = true;
        StateHasChanged();
        try
        {
            bool ok = await newSecretViewModel.SaveSecretAsync();
            if (ok)
            {
                StatusAlertService.Success(Texts.NewSecretSuccess);
                // A newly created secret is personal — return the list to
                // the "All" scope so the new entry is actually visible
                // (covers the case where it was created from the
                // "Shared with me" scope).
                _scopeShared = false;
                secretsListViewModel.SelectedSecretListFilter = SecretFilterOption.All;
                // Drop the cache so FindSecrets re-fetches and the new
                // entry shows immediately — without this, FindSecrets
                // returns the stale cached list and the new password
                // doesn't appear until the page is reloaded.
                secretsListViewModel.InvalidateCache();
                await secretsListViewModel.FindSecrets();
                _mode = PmMode.Empty;
                _selected = null;
            }
            else
            {
                // SaveSecretAsync sets ErrorMessage on failure (validation,
                // offline, etc.). Fall back to a generic line only if it's
                // somehow blank.
                StatusAlertService.Error(string.IsNullOrEmpty(newSecretViewModel.ErrorMessage)
                    ? "Couldn't save. Please check the fields and try again."
                    : newSecretViewModel.ErrorMessage);
            }
        }
        finally
        {
            _saving = false;
        }
        StateHasChanged();
    }

    private void CancelCreate()
    {
        _mode = _selected != null ? PmMode.View : PmMode.Empty;
        StateHasChanged();
    }

    // ── Edit ─────────────────────────────────────────────────
    private void StartEdit()
    {
        if (_selected == null || !IsPaid) return;
        switch (_selected.SecretType)
        {
            case SecretType.Password:
                var p = _selected.Password;
                _ePwd = new SecretPasswordViewModel(p.Title, p.Url, p.Username, p.SecretDesc, p.SecretValue);
                break;
            case SecretType.Card:
                var c = _selected.Card;
                _eCard = new SecretCardViewModel(c.CardNumber, c.SecretDesc ?? string.Empty, c.NameOnCard, c.SecurityCode, c.ExpirationDate);
                break;
            case SecretType.Note:
                var n = _selected.Note;
                _eNote = new SecretNoteViewModel(n.SecretDesc, n.Note);
                break;
        }
        _mode = PmMode.Edit;
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (_selected == null) return;

        var temp = new SecretViewModel(
            _selected.SecretType,
            _ePwd  ?? _selected.Password,
            _eCard ?? _selected.Card,
            _eNote ?? _selected.Note,
            _selected.SharedWith ?? new List<SecretSharedUserViewModel>());
        temp.SecretGuid = _selected.SecretGuid;

        editSecretViewModel.Secret = temp;
        bool ok = await editSecretViewModel.SaveSecretAsync();
        if (ok)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            // Reflect the change on the in-memory model + list.
            if (_ePwd  != null) _selected.Password = _ePwd;
            if (_eCard != null) _selected.Card     = _eCard;
            if (_eNote != null) _selected.Note     = _eNote;
            secretService.SetCurrentSecret(_selected);
            _mode = PmMode.View;
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _ePwd = null; _eCard = null; _eNote = null;
        _mode = PmMode.View;
        StateHasChanged();
    }

    // Closes the detail pane back to the empty state — clears the
    // selection so the corresponding list row also un-highlights.
    private void CloseDetail()
    {
        _selected = null;
        ResetDetailFlags();
        _mode = PmMode.Empty;
        StateHasChanged();
    }

    // ── Delete ───────────────────────────────────────────────
    private async Task DeleteSelected()
    {
        if (_selected == null || !IsPaid) return;

        PopupButtons answer = await New<IPopup>().ShowAsync(
            PopupButtons.OkCancel, Texts.AlertText, Texts.DeleteSecretText, AxCrypt.Common.DoNotShowAgainOptions.None);
        if (answer != PopupButtons.Ok) return;

        viewSecretViewModel.Secret = _selected;
        bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
        if (deleted)
        {
            StatusAlertService.Success(Texts.SecretDeletedText);
            // Drop the cache so the removed entry disappears at once.
            secretsListViewModel.InvalidateCache();
            await secretsListViewModel.FindSecrets();
            _selected = null;
            _mode = PmMode.Empty;
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }
        StateHasChanged();
    }

    // ── Open URL ─────────────────────────────────────────────
    private async Task OpenUrlAsync(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return;
        string normalized = url.StartsWith("http") ? url : "https://" + url;
        if (!Uri.TryCreate(normalized, UriKind.Absolute, out var uri)) return;
        try { await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(uri); } catch { }
    }

    // ── View render ──────────────────────────────────────────
    private RenderFragment RenderView() => __builder =>
    {
        var s = _selected!;
        bool sharedWithMe = IsSharedWithMe(s);
        <div class="pmx-detail">
            <header class="pmx-detail-head">
                <span class="pmx-detail-icon pmx-row-icon--@TypeKey(s.SecretType)">@TypeIcon(s.SecretType)</span>
                <div class="pmx-detail-titles">
                    <h2 class="pmx-detail-title">@DisplayTitle(s)</h2>
                    <span class="pmx-detail-sub">@DisplaySubtitle(s)</span>
                </div>
                <div class="pmx-detail-actions">
                    @* Edit / Delete only appear when (a) the user is paid AND
                       (b) the entry is OWNED by the current user. Entries
                       shared with the user are strictly read-only — the
                       owner is the only one allowed to change them. *@
                    @if (IsPaid && !sharedWithMe)
                    {
                        <button type="button" class="pmx-btn pmx-btn--ghost" @onclick="StartEdit">Edit</button>
                        <button type="button" class="pmx-btn pmx-btn--danger" @onclick="DeleteSelected">Delete</button>
                    }
                    else if (sharedWithMe)
                    {
                        <span class="pmx-readonly-pill" title="This entry was shared with you and is read-only.">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                            Read-only
                        </span>
                    }
                    <button type="button" class="pmx-close-btn" @onclick="CloseDetail" title="Close" aria-label="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </header>

            @* Owner banner — only when this entry was shared with the user.
               Surfaces the owner's email so the viewer knows who can change
               or revoke this secret. *@
            @if (sharedWithMe)
            {
                <div class="pmx-shared-banner" role="note">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 00-3-3.87" />
                        <path d="M4 21v-2a4 4 0 013-3.87" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <div class="pmx-shared-banner-text">
                        <span class="pmx-shared-banner-label">Shared by</span>
                        <span class="pmx-shared-banner-email">@s.OwnerEmail</span>
                    </div>
                </div>
            }

            <div class="pmx-detail-body">
                @switch (s.SecretType)
                {
                    case SecretType.Password: @ViewPassword(s); break;
                    case SecretType.Card:     @ViewCard(s);     break;
                    case SecretType.Note:     @ViewNote(s);     break;
                }
            </div>

            @* Share — visible to all plans (free users get 1 share, premium 10,
               business 20 — enforced by MaxAllowedUsersCountToShare in the VM).
               Only hide when the user doesn't own the entry (can't re-share). *@
            @if (!sharedWithMe)
            {
                <div class="pmx-share">
                    <button type="button" class="pmx-share-toggle" @onclick="() => { _showShare = !_showShare; }">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                        </svg>
                        <span>@Texts.PromptSharedWith</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             class="@(_showShare ? "pmx-share-arrow pmx-share-arrow--open" : "pmx-share-arrow")">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                    @if (_showShare)
                    {
                        <div class="pmx-share-body">
                            <AxCrypt.App.Shared.Desktop.Components.Home.SharePasswordComponent />
                            @* <ShareSecretComponent /> *@
                        </div>
                    }
                </div>
            }
        </div>
    };

    /// <summary>
    /// True when the secret was shared *with* the signed-in user — i.e. the
    /// owner email differs from the current identity's email. Owner-side
    /// edit, delete and share controls are suppressed in this case.
    /// </summary>
    private bool IsSharedWithMe(SecretViewModel s)
    {
        string mine = (viewSecretViewModel.UserEmail ?? string.Empty).Trim();
        string owner = (s.OwnerEmail ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(mine) || string.IsNullOrEmpty(owner))
        {
            return false;
        }
        return !string.Equals(owner, mine, StringComparison.OrdinalIgnoreCase);
    }

    private RenderFragment ViewPassword(SecretViewModel s) => __builder =>
    {
        var p = s.Password;
        @ViewField("USERNAME / EMAIL", p.Username, copy: true)
        <div class="pmx-field">
            <label class="pmx-field-label">PASSWORD</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-mono">@(_showValue ? p.SecretValue : Mask(p.SecretValue))</span>
                <button type="button" class="pmx-field-action" @onclick="() => { _showValue = !_showValue; }">@(_showValue ? "Hide" : "Show")</button>
                @if (!string.IsNullOrEmpty(p.SecretValue))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(p.SecretValue)">Copy</button>
                }
            </div>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">WEBSITE</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-link">@(string.IsNullOrEmpty(p.Url) ? "—" : p.Url)</span>
                @if (!string.IsNullOrEmpty(p.Url))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await OpenUrlAsync(p.Url)">Open</button>
                }
            </div>
        </div>
        @ViewDescription(p.SecretDesc)
    };

    private RenderFragment ViewCard(SecretViewModel s) => __builder =>
    {
        var c = s.Card;
        <div class="pmx-field">
            <label class="pmx-field-label">CARD NUMBER</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-mono">@(_showCardNum ? c.CardNumber : MaskCard(c.CardNumber))</span>
                <button type="button" class="pmx-field-action" @onclick="() => { _showCardNum = !_showCardNum; }">@(_showCardNum ? "Hide" : "Show")</button>
                @if (!string.IsNullOrEmpty(c.CardNumber))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(c.CardNumber)">Copy</button>
                }
            </div>
        </div>
        @ViewField("NAME ON CARD", c.NameOnCard, copy: false)
        <div class="pmx-field-grid">
            @ViewField("EXPIRES", c.ExpirationDate, copy: false)
            <div class="pmx-field">
                <label class="pmx-field-label">CVV</label>
                <div class="pmx-field-row">
                    <span class="pmx-field-value pmx-mono">@(_showCvv ? c.SecurityCode : "•••")</span>
                    <button type="button" class="pmx-field-action" @onclick="() => { _showCvv = !_showCvv; }">@(_showCvv ? "Hide" : "Show")</button>
                </div>
            </div>
        </div>
        @ViewDescription(c.SecretDesc)
    };

    private RenderFragment ViewNote(SecretViewModel s) => __builder =>
    {
        var n = s.Note;
        @ViewField("TITLE", n.SecretDesc, copy: false)
        <div class="pmx-field">
            <label class="pmx-field-label">NOTE</label>
            <div class="pmx-field-notes pmx-field-notes--block">@(string.IsNullOrEmpty(n.Note) ? "No content." : n.Note)</div>
            @if (!string.IsNullOrEmpty(n.Note))
            {
                <button type="button" class="pmx-field-action pmx-field-action--standalone"
                        @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(n.Note)">Copy note</button>
            }
        </div>
    };

    private RenderFragment ViewField(string label, string? value, bool copy) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">@label</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value">@(string.IsNullOrEmpty(value) ? "—" : value)</span>
                @if (copy && !string.IsNullOrEmpty(value))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(value)">Copy</button>
                }
            </div>
        </div>
    };

    // Renders the free-text Description field shared by the Password
    // and Card detail views. (It used to be mislabelled "NOTES" — the
    // underlying property is SecretDesc, i.e. the Description.)
    private RenderFragment ViewDescription(string? desc) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">DESCRIPTION</label>
            <div class="pmx-field-notes @(string.IsNullOrEmpty(desc) ? "pmx-field-notes--empty" : "")">
                @(string.IsNullOrEmpty(desc) ? "No description." : desc)
            </div>
        </div>
    };

    // ── Edit render ──────────────────────────────────────────
    private RenderFragment RenderEdit() => __builder =>
    {
        var s = _selected!;
        <div class="pmx-detail">
            <header class="pmx-detail-head">
                <span class="pmx-detail-icon pmx-row-icon--@TypeKey(s.SecretType)">@TypeIcon(s.SecretType)</span>
                <div class="pmx-detail-titles">
                    <h2 class="pmx-detail-title">Edit @TypeName(s.SecretType)</h2>
                    <span class="pmx-detail-sub">Changes encrypt on save</span>
                </div>
                <div class="pmx-detail-actions">
                    <button type="button" class="pmx-btn pmx-btn--ghost" @onclick="CancelEdit">@Texts.ButtonCancelText</button>
                    <button type="button" class="pmx-btn pmx-btn--primary" @onclick="SaveEdit">@Texts.ButtonSaveText</button>
                </div>
            </header>
            <div class="pmx-detail-body">
                @switch (s.SecretType)
                {
                    case SecretType.Password: @FormPassword(_ePwd!);  break;
                    case SecretType.Card:     @FormCard(_eCard!);      break;
                    case SecretType.Note:     @FormNote(_eNote!);      break;
                }
            </div>
        </div>
    };

    // ── Create render ────────────────────────────────────────
    private RenderFragment RenderCreate() => __builder =>
    {
        <div class="pmx-detail">
            <header class="pmx-detail-head">
                <span class="pmx-detail-icon pmx-row-icon--@TypeKey(_createType)">@TypeIcon(_createType)</span>
                <div class="pmx-detail-titles">
                    <h2 class="pmx-detail-title">New @TypeName(_createType)</h2>
                    <span class="pmx-detail-sub">Encrypted end-to-end on save</span>
                </div>
                <div class="pmx-detail-actions">
                    <button type="button" class="pmx-btn pmx-btn--ghost" @onclick="CancelCreate">@Texts.ButtonCancelText</button>
                    <button type="button" class="pmx-btn pmx-btn--primary" @onclick="SaveCreate">@Texts.ButtonSaveText</button>
                </div>
            </header>
            @if (!string.IsNullOrEmpty(newSecretViewModel.ErrorMessage))
            {
                <div class="pmx-error">@newSecretViewModel.ErrorMessage</div>
            }
            <div class="pmx-detail-body">
                @switch (_createType)
                {
                    case SecretType.Password: @FormPassword(newSecretViewModel.Secret.Password); break;
                    case SecretType.Card:     @FormCard(newSecretViewModel.Secret.Card);         break;
                    case SecretType.Note:     @FormNote(newSecretViewModel.Secret.Note);         break;
                }
            </div>
        </div>
    };

    // ── Editable form fragments (shared by Edit + Create) ────
    private RenderFragment FormPassword(SecretPasswordViewModel p) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.DescriptionLabel</label>
            @* Description is a roomy multi-line textarea — gives space for a
               meaningful note about the login, not just a short tag. *@
            <textarea class="pmx-textarea pmx-textarea--tall" rows="4"
                      placeholder="e.g. Gmail — work account, recovery email is …"
                      @bind="p.SecretDesc" @bind:event="oninput"></textarea>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.UserNamePrompt</label>
            <input class="pmx-input" type="text" placeholder="name@example.com"
                   @bind="p.Username" @bind:event="oninput" />
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.PassphrasePrompt</label>
            <div class="pmx-input-row">
                <input class="pmx-input" type="text" placeholder="••••••••"
                       @bind="p.SecretValue" @bind:event="oninput" />
                <button type="button" class="pmx-suggest-btn"
                        title="@Texts.ButtonSuggestText"
                        @onclick="() => SuggestPasswordFor(p)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 2v6h-6"/>
                        <path d="M3 12a9 9 0 0115-6.7L21 8"/>
                        <path d="M3 22v-6h6"/>
                        <path d="M21 12a9 9 0 01-15 6.7L3 16"/>
                    </svg>
                    <span>@Texts.ButtonSuggestText</span>
                </button>
            </div>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.PasswordUrlPrompt</label>
            <input class="pmx-input" type="text" placeholder="www.example.com"
                   @bind="p.Url" @bind:event="oninput" />
        </div>
    };

    /// <summary>
    /// Fills the password field with a strong suggestion from the
    /// existing SecretsApiHelper — same generator the legacy New/Edit
    /// password screens used. Works for both Create and Edit because
    /// it mutates the SecretPasswordViewModel passed in.
    /// </summary>
    private async Task SuggestPasswordFor(SecretPasswordViewModel p)
    {
        try
        {
            p.SecretValue = await SecretsApiHelper.SuggestPasswordAsync();
        }
        catch
        {
            // Suggestion service unreachable — leave the field as-is so
            // the user can still type a password manually.
        }
        StateHasChanged();
    }

    private RenderFragment FormCard(SecretCardViewModel c) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.DescriptionLabel</label>
            @* Roomy multi-line description — consistent with the
               Password and Note forms. *@
            <textarea class="pmx-textarea pmx-textarea--tall" rows="4"
                      placeholder="e.g. Visa — personal card, billing address on file"
                      @bind="c.SecretDesc" @bind:event="oninput"></textarea>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.CardNumberPrompt</label>
            <input class="pmx-input" type="text" maxlength="19" placeholder="XXXX XXXX XXXX XXXX"
                   @bind="c.CardNumber" @bind:event="oninput"
                   onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.NameOnCardPrompt</label>
            <input class="pmx-input" type="text" placeholder="Name and Surname"
                   @bind="c.NameOnCard" @bind:event="oninput" />
        </div>
        <div class="pmx-field-grid">
            <div class="pmx-field">
                <label class="pmx-field-label">@Texts.ExpirationDatePrompt</label>
                <input class="pmx-input" type="text" maxlength="7" placeholder="MM/YYYY"
                       value="@c.ExpirationDate"
                       @oninput="(e) => c.OnExpirationDateInput(e)"
                       onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
            </div>
            <div class="pmx-field">
                <label class="pmx-field-label">@Texts.SecurityCodePrompt</label>
                <input class="pmx-input" type="text" maxlength="3" placeholder="000"
                       @bind="c.SecurityCode" @bind:event="oninput"
                       onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
            </div>
        </div>
    };

    private RenderFragment FormNote(SecretNoteViewModel n) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.DescriptionLabel</label>
            @* Roomy multi-line description — consistent with the
               Password and Card forms. *@
            <textarea class="pmx-textarea pmx-textarea--tall" rows="4"
                      placeholder="e.g. WiFi login — home router, recovery codes"
                      @bind="n.SecretDesc" @bind:event="oninput"></textarea>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">@Texts.NoteLabel</label>
            <textarea class="pmx-textarea" rows="9" placeholder="Type your secure note…"
                      @bind="n.Note" @bind:event="oninput"></textarea>
        </div>
    };

    // ── Helpers ──────────────────────────────────────────────
    private static string TypeKey(SecretType t) => t switch
    {
        SecretType.Card => "card",
        SecretType.Note => "note",
        _               => "password",
    };

    private string TypeName(SecretType t) => t switch
    {
        SecretType.Card => Texts.CardPrompt,
        SecretType.Note => Texts.NoteLabel,
        _               => Texts.PassphrasePrompt,
    };

    private static string DisplayTitle(SecretViewModel s)
    {
        string title = s.SecretType switch
        {
            SecretType.Card => s.Card?.SecretDesc ?? "",
            SecretType.Note => s.Note?.SecretDesc ?? "",
            _               => s.Password?.SecretDesc ?? "",
        };
        return string.IsNullOrWhiteSpace(title) ? "(Untitled)" : title;
    }

    private static string DisplaySubtitle(SecretViewModel s) => s.SecretType switch
    {
        SecretType.Password => DomainOrUser(s.Password),
        SecretType.Card     => MaskCard(s.Card?.CardNumber),
        SecretType.Note     => "Secure note",
        _                   => "",
    };

    private static string DomainOrUser(SecretPasswordViewModel? p)
    {
        if (p == null) return "";
        if (!string.IsNullOrWhiteSpace(p.Url))
        {
            string clean = p.Url.Replace("https://", "").Replace("http://", "").Replace("www.", "");
            int slash = clean.IndexOf('/');
            return slash > 0 ? clean.Substring(0, slash) : clean;
        }
        return p.Username ?? "";
    }

    private static string Mask(string? value)
        => string.IsNullOrEmpty(value) ? "—" : new string('•', Math.Min(value.Length, 16));

    private static string MaskCard(string? cardNumber)
    {
        if (string.IsNullOrWhiteSpace(cardNumber)) return "—";
        string t = cardNumber.Replace(" ", "").Trim();
        return t.Length < 4 ? "•••• " + t : "•••• " + t.Substring(t.Length - 4);
    }

    private RenderFragment TypeIcon(SecretType t) => __builder =>
    {
        switch (t)
        {
            case SecretType.Card:
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
                break;
            case SecretType.Note:
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
                break;
            default:
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                break;
        }
    };
}

