@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.Data
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using AxCrypt.Cryptor.Model
@using Microsoft.Maui.Devices

@inject NavigationManager navigationManager
@inject SecretService secretService
@inject SecretsListViewModel secretsListViewModel
@inject IJSRuntime jsRunTime

@{
    int MaxSharedWithToShow = 4;
}

<div class="row">
    <div class="medium-12 columns page-title-container">
        <h1 class="page-title">
            @Texts.PromptPasswordManager
        </h1>
    </div>
</div>
<div class="max-height">
    <div id="content-index" class="medium-12 columns">
        <div class="">
            <div style="display:flex; justify-content:flex-start; gap:10px; width:100%; align-items:center;">
                <div class="tabcontent" style="width: 80%;">
                    <input id="secrets-keyword" type="text" @bind="@secretsListViewModel.Keyword" placeholder="@Texts.SearchPasswordPlaceHolder" @oninput="secretsListViewModel.OnInputChanged" />
                </div>
                <div class="action-button-list">
                    <div class="dropdown">
                        <div class="action-button" @onclick="secretsListViewModel.UpgradeFreeUser">
                            <img class="" src="images/password-create-icon.svg" alt="img" />
                        </div>
                        @if (secretsListViewModel.HasPaidSubscription)
                        {
                            <div class="password-create-dropdown-content">
                                <dl>
                                    <dd>
                                        <NavLink href="AddPassword">
                                            <img class="secrets-type-icon-desktop passwords-icon" src="" alt="passwords-icon" /> <span>@Texts.PassphrasePrompt</span>
                                        </NavLink>
                                    </dd>
                                    <dd>
                                        <NavLink href="AddCard">
                                            <img class="secrets-type-icon-desktop cards-icon" src="" alt="cards-icon" /> <span>@Texts.CardPrompt</span>
                                        </NavLink>
                                    </dd>
                                    <dd style="border-bottom:none;">
                                        <NavLink href="AddNote">
                                            <img class="secrets-type-icon-desktop notes-icon" src="" alt="secrets-type-icon-desktop" /> <span>@Texts.NoteContentPrompt</span>
                                        </NavLink>
                                    </dd>
                                </dl>
                            </div>
                        }
                    </div>
                    <div class="dropdown">
                        <div class="action-button">
                            <img src="images/password-export-icon.svg" alt="img">
                        </div>
                        <div class="dropdown-content">
                            <a style="color:#69a051" @onclick="@(async () => await secretsListViewModel.ExportFile("TXT"))">TXT</a>
                            <a style="color:#69a051" @onclick="@(async () => await secretsListViewModel.ExportFile("XML"))">XML</a>
                        </div>
                    </div>
                    @if (currentDevice == DeviceIdiom.Tablet)
                    {
                        <div class="dropdown">
                            <div class="action-button">
                                <img src="images/exportup.svg" alt="img">
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div style="margin: 10px 0px 30px;" class="tab">
                <div id="tab-header">
                    <a class="tablinks @(secretsListViewModel.Filter == SecretFilterOption.All ? "active" : "")"
                       @onclick="() => SetFilter(SecretFilterOption.All)">
                        @secretsListViewModel.SortOptionAllText
                    </a>
                    <hr style="display:none;" class="@(secretsListViewModel.Filter == SecretFilterOption.All ? "tab-selected" : "")">
                </div>
                <div id="tab-header">
                    <a class="tablinks @(secretsListViewModel.Filter == SecretFilterOption.Recently ? "active" : "")"
                       @onclick="() => SetFilter(SecretFilterOption.Recently)">
                        @secretsListViewModel.SortOptionRecentText
                    </a>                   
                    <hr style="display:none;" class="@(secretsListViewModel.Filter == SecretFilterOption.Recently ? "tab-selected" : "")">
                </div>
                <div id="tab-header">
                    <a class="tablinks @(secretsListViewModel.Filter == SecretFilterOption.Shared ? "active" : "")"
                       @onclick="() => SetFilter(SecretFilterOption.Shared)">
                        @secretsListViewModel.SortOptionSharedText
                    </a>
                    <hr style="display:none;" class="@(secretsListViewModel.Filter == SecretFilterOption.Shared ? "tab-selected" : "")">
                </div>
            </div>
            <div id="search-secrets-list">
                <div style="gap:10px; display:flex;align-items: center; margin-bottom:5px;">
                    @{
                        if (secretsListViewModel.Filter != SecretFilterOption.Recently && secretsListViewModel.Filter != SecretFilterOption.Shared)
                        {
                            <div style="top:5px">
                                <input id="secret-type-filter-hidden" name="SecretsTypeFilter" type="hidden" value="Password"> <span class="filter-text">@Texts.SecretsSortOrderLabel</span>
                            </div>
                            <div>
                                <select id="secretsSortOrderOptions" name="SecretsSortOrder" @onchange="async (e) => await secretsListViewModel.SortSecrets(e)"
                                        style="width:110px; height: 31px; padding: 3px; border-radius: 4px; margin: 0%">
                                    <option value="@nameof(SecretsSortOrder.ByDate)">@Texts.InvoiceDateHeadline</option>
                                    <option value="@nameof(SecretsSortOrder.ByContent)">@Texts.SecretsSortOrderOptionByContent</option>
                                </select>
                            </div>
                            <div class="filter-section">
                                <div class="dropdown">
                                    <img class="filter-image text-padding" src="" alt="filter-img">
                                    <a class="filter-text text-padding" href="javascript:void(0)">@Texts.FilterText</a>
                                    <div class="password-filter-dropdown-content">
                                        <ul class="filter-section-desktop">
                                            <li>
                                                <label style="border-top:none;">
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.SecretsAllItems
                                                           checked="@IsSelected(SecretsFilter.All)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.All)" />
                                                    <img class="secrets-type-icon-desktop secret-icon" src="" alt="secret-icon">
                                                    <span>@Texts.SecretsAllItems</span>
                                                </label>
                                            </li>
                                            <li>
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.PassphrasePrompt
                                                           checked="@IsSelected(SecretsFilter.Password)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Password)" />
                                                    <img class="secrets-type-icon-desktop passwords-icon" src="" alt="passwords-icon">
                                                    <span> @Texts.PassphrasePrompt</span>
                                                </label>
                                            </li>
                                            <li>
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.CardPrompt
                                                           checked="@IsSelected(SecretsFilter.Card)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Card)" />
                                                    <img class="secrets-type-icon-desktop cards-icon" src="" alt="cards-icon">
                                                    <span>@Texts.CardPrompt</span>
                                                </label>
                                            </li>
                                            <li style="border-bottom:none;">
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.NoteLabel
                                                           checked="@IsSelected(SecretsFilter.Note)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Note)" />
                                                    <img class="secrets-type-icon-desktop notes-icon" src="" alt="notes-icon">
                                                    <span>@Texts.NoteLabel</span>
                                                </label>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="parent-container">
        <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
        @if (secretsListViewModel.FilteredSecrets.Any())
        {
            <div class="row">
                <ul class="clean secrets-list" style="list-style: none !important; margin:2% 0%">
                    @foreach (SecretViewModel secret in secretsListViewModel.FilteredSecrets)
                    {
                        <li class="list-box" @onclick="() => NavigateToSecretView(secret.ToClientModel(secret.SecretGuid))">
                            <div class="password-box">
                                @if (secret.SharedWith != null && secret.SharedWith.Any())
                                {
                                    <img class="password-key-share-icon" src="/images/IcoMultipleUsers.svg" alt="" @onmouseover="() => ShowPopup(secret.SecretGuid)" @onmouseout="HidePopup">
                                }
                                <div>
                                    @switch (secret.SecretType)
                                    {
                                        case SecretType.Card:
                                            <img class="secrets-type-icon card-icon" src="" alt="secret-type-icon">

                                            <br />
                                            <label class="password-title">@secret.Card.SecretDesc</label>
                                            <span class="secret-title"></span>
                                            break;

                                        case SecretType.Password:
                                            <img class="secrets-type-icon password-icon" src="" alt="secret-type-icon">

                                            <br />
                                            <label class="password-title">@secret.Password.SecretDesc</label>
                                            <span class="secret-title"></span>
                                            break;

                                        case SecretType.Note:
                                            <img class="secrets-type-icon note-icon" src="" alt="secret-type-icon">

                                            <br />
                                            <label class="password-title">@secret.Note.SecretDesc</label>
                                            <span class="secret-title"></span>
                                            break;
                                    }

                                </div>
                                @if (secretsListViewModel.Filter != SecretFilterOption.None && secret.SharedWith != null && secret.SharedWith.Any())
                                {
                                    <div class="list-box">
                                        <div class="sharedwith-box" style="position: absolute; @(hoveredSecretId == secret.SecretGuid ? "display: block;" : "display: none;")">
                                            <div>
                                                <span style="color:white;">
                                                    <strong>@Texts.PromptSharedWith:</strong>
                                                </span>
                                                <ul>
                                                    @foreach (SecretSharedUserViewModel user in secret.SharedWith.Take(MaxSharedWithToShow))
                                                    {
                                                        <li style="display:flex; align-items:center;">
                                                            <img class="" src="/images/default/AxCrypt_Icon.svg" alt="img">
                                                            <div class="shr-txt-ovflw">
                                                                <span class="shared-text">@user.UserEmail</span><br>
                                                            </div>
                                                        </li>
                                                    }
                                                    @if (secret.SharedWith.Count() > MaxSharedWithToShow)
                                                    {
                                                        <li style="color: #fff; position: relative;top: -10px;">.....</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>

            </div>
        }
        else
        {
            <div class="text-center" style="padding-top: 30px;">
                <span class="empty-view-heading">Let`s start our journey!</span><br />
                <span>Add and secure your first password.</span><br />
                <img class="empty-passmngr-img" alt="default file img" />
            </div>
        }
    </div>
</div>

@code {
    private DeviceIdiom currentDevice;

    private Guid? hoveredSecretId;

    private void ShowPopup(Guid secretId)
    {
        hoveredSecretId = secretId;
    }

    private void HidePopup()
    {
        hoveredSecretId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        currentDevice = DeviceInfo.Idiom;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await secretsListViewModel.FindSecrets();
            UpdateUIState();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task popupId()
    {
        await jsRunTime.InvokeVoidAsync("popupId");
    }

    private void NavigateToSecretView(SecretClientModel secret)
    {
        secretService.SetCurrentSecret(new SecretViewModel(secret));
        string url = secret.Type switch
        {
            AxCrypt.Api.Model.Secret.SecretType.Card => "/viewcard",
            AxCrypt.Api.Model.Secret.SecretType.Password => "/viewpassword",
            AxCrypt.Api.Model.Secret.SecretType.Note => "/viewnote",
            _ => string.Empty
        };
        if (!string.IsNullOrEmpty(url))
        {
            navigationManager.NavigateTo(url);
        }
    }

    private bool IsSelected(SecretsFilter filter)
    {
        return secretsListViewModel.SelectedFilter == filter;
    }

    private async Task SetFilter(SecretFilterOption selectedFilter)
    {
        secretsListViewModel.Filter = selectedFilter;

        switch (selectedFilter)
        {
            case SecretFilterOption.All:
            case SecretFilterOption.Recently:
                await secretsListViewModel.FilterSecretsBy(selectedFilter);
                break;
            case SecretFilterOption.Shared:
                await secretsListViewModel.FilterSharedSecrets(selectedFilter);
                break;
        }
        UpdateUIState();
    }

    private async Task UpdateFilteredSecrets()
    {
        await secretsListViewModel.ApplyFilterOnSecrets();
        UpdateUIState();
    }

    void UpdateUIState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}