@* Password Manager — master-detail layout.
   Left pane: list with scope/search/type filters and export.
   Right pane: delegates to PmDetailView (View), PmDetailForm (Create/Edit), or empty state. *@
@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Desktop.Components.PasswordManager
@using AxCrypt.App.Shared.Desktop.Components.Shared
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve

@inject SecretService secretService
@inject SecretsListViewModel secretsListViewModel
@inject NewSecretViewModel newSecretViewModel
@inject EditSecretViewModel editSecretViewModel
@inject ViewSecretViewModel viewSecretViewModel
@inject IStatusAlertService StatusAlertService
@inject PaidFeaturegateService paidFeaturegateService

<div class="pmx-shell">

    <FreePlanLimitBar Feature="AxCrypt.App.Entitlement.Contracts.FeatureKey.PasswordEntry" />

    <div class="pmx-split">

        @* ── Left pane ────────────────────────────────────────── *@
        <aside class="pmx-list-pane">

            @* Scope tabs: "All" = own secrets, "Shared with me" = secrets shared by others. *@
            <div class="pmx-scope" role="tablist">
                <button type="button" class="pmx-scope-tab @(!_scopeShared ? "pmx-scope-tab--active" : "")"
                        @onclick="() => SetScope(false)">All</button>
                <button type="button" class="pmx-scope-tab @(_scopeShared ? "pmx-scope-tab--active" : "")"
                        @onclick="() => SetScope(true)">Shared with me</button>

                @* Export — own scope only; export is over personal secrets. *@
                @if (!_scopeShared)
                {
                    <div class="pmx-export">
                        <button type="button" class="pmx-icon-btn" @onclick="ToggleExportMenu" title="Export / download">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        </button>
                        @if (_showExportMenu)
                        {
                            <div class="pmx-menu-backdrop" @onclick="() => _showExportMenu = false"></div>
                            <div class="pmx-export-menu" role="menu">
                                <p class="pmx-export-head">Download all entries</p>
                                <button type="button" class="pmx-export-item" role="menuitem" @onclick='() => ExportAs("TXT")'>
                                    <span class="pmx-export-ext">.txt</span>
                                    <span>Plain text file</span>
                                </button>
                                <button type="button" class="pmx-export-item" role="menuitem" @onclick='() => ExportAs("XML")'>
                                    <span class="pmx-export-ext">.xml</span>
                                    <span>XML file</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pmx-toolbar">
                <div class="pmx-search">
                    <svg class="pmx-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" class="pmx-search-input"
                           @bind="secretsListViewModel.Keyword"
                           @oninput="secretsListViewModel.OnInputChanged"
                           placeholder="@Texts.SearchPasswordPlaceHolder" />
                </div>
                <button type="button" class="pmx-add-btn" @onclick="OnAddNewClick" title="Add new">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>New</span>
                </button>
            </div>

            <div class="pmx-tabs" role="tablist">
                <button type="button" class="pmx-tab @(_typeFilter == null ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(null)">All</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Password ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Password)">@Texts.PassphrasePrompt</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Note ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Note)">@Texts.NoteLabel</button>
                <button type="button" class="pmx-tab @(_typeFilter == SecretType.Card ? "pmx-tab--active" : "")"
                        @onclick="() => SetTypeFilter(SecretType.Card)">@Texts.CardPrompt</button>
            </div>

            <div class="pmx-list-scroll">
                @if (!_saving)
                {
                    <ProcessIndicatorComponent />
                }

                @{
                    var rows = VisibleSecrets();
                }
                @if (!rows.Any())
                {
                    <div class="pmx-list-empty">
                        @if (_scopeShared)
                        {
                            <p class="pmx-list-empty-title">Nothing shared with you yet</p>
                            <p class="pmx-list-empty-sub">Passwords other people share with you will show up here.</p>
                        }
                        else
                        {
                            <p class="pmx-list-empty-title">@Texts.LetsStartOurJourneyText</p>
                            <p class="pmx-list-empty-sub">@Texts.AddFirstPasswordText</p>
                        }
                    </div>
                }
                else
                {
                    <ul class="pmx-list" role="list">
                        @foreach (SecretViewModel s in rows)
                        {
                            bool isSel = _selected?.SecretGuid == s.SecretGuid && _mode != PmMode.Create;
                            <li class="pmx-row @(isSel ? "pmx-row--selected" : "")"
                                tabindex="0" role="button"
                                @onclick="() => SelectSecret(s)"
                                @onkeydown="@(e => { if (e.Key == "Enter") SelectSecret(s); })">
                                <span class="pmx-row-icon pmx-row-icon--@PmHelpers.TypeKey(s.SecretType)">
                                    <PmTypeIcon Type="s.SecretType" />
                                </span>
                                <span class="pmx-row-text">
                                    <span class="pmx-row-title">@PmHelpers.DisplayTitle(s)</span>
                                    <span class="pmx-row-sub">@PmHelpers.DisplaySubtitle(s)</span>
                                </span>
                                @if (s.SharedWith != null && s.SharedWith.Any())
                                {
                                    <span class="pmx-row-shared" title="Shared">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                            <circle cx="9" cy="7" r="4"/>
                                            <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                                        </svg>
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </aside>

        @* ── Right pane ───────────────────────────────────────── *@
        <section class="pmx-detail-pane">
            @switch (_mode)
            {
                case PmMode.Empty:
                    <div class="pmx-detail-empty">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="pmx-detail-empty-icon">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <h3 class="pmx-detail-empty-title">Select an item to view</h3>
                        <p class="pmx-detail-empty-sub">Choose a password, card, or note on the left — or add a new one.</p>
                    </div>
                    break;

                case PmMode.View:
                    <PmDetailView Secret="_selected!"
                                  IsPaid="IsPaid"
                                  IsSharedWithMe="IsSharedWithMe(_selected!)"
                                  ScopeShared="_scopeShared"
                                  OnEdit="StartEdit"
                                  OnDelete="DeleteSelected"
                                  OnClose="CloseDetail"
                                  OnOpenUrl="OpenUrlAsync" />
                    break;

                case PmMode.Edit:
                    <PmDetailForm SecretType="_selected!.SecretType"
                                  IsEdit="true"
                                  Password="_ePwd!"
                                  Card="_eCard!"
                                  Note="_eNote!"
                                  OnSave="SaveEdit"
                                  OnCancel="CancelEdit"
                                  OnSuggestPassword="SuggestPasswordFor" />
                    break;

                case PmMode.Create:
                    <PmDetailForm SecretType="_createType"
                                  IsEdit="false"
                                  Password="newSecretViewModel.Secret.Password"
                                  Card="newSecretViewModel.Secret.Card"
                                  Note="newSecretViewModel.Secret.Note"
                                  ErrorMessage="@newSecretViewModel.ErrorMessage"
                                  OnSave="SaveCreate"
                                  OnCancel="CancelCreate"
                                  OnSuggestPassword="SuggestPasswordFor" />
                    break;
            }

            @* Saving/deleting overlay — scoped to the detail pane. *@
            @if (_saving)
            {
                <div class="pmx-save-overlay">
                    <AxLoader Mode="LoaderMode.Body" Message="@_savingMessage" />
                </div>
            }
        </section>
    </div>

    @* Add-new type picker *@
    @if (_showTypePicker)
    {
        <div class="pmx-picker-backdrop" @onclick="() => _showTypePicker = false">
            <div class="pmx-picker" @onclick:stopPropagation>
                <button type="button" class="pmx-picker-close" title="@Texts.ButtonCancelText"
                        @onclick="() => _showTypePicker = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                        <line x1="6" y1="6" x2="18" y2="18"/>
                        <line x1="18" y1="6" x2="6" y2="18"/>
                    </svg>
                </button>
                <h3 class="pmx-picker-title">What would you like to add?</h3>
                <div class="pmx-picker-grid">
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Password)">
                        <span class="pmx-picker-icon pmx-row-icon--password"><PmTypeIcon Type="SecretType.Password" /></span>
                        <span class="pmx-picker-label">@Texts.PassphrasePrompt</span>
                        <span class="pmx-picker-desc">Login with username + URL</span>
                    </button>
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Card)">
                        <span class="pmx-picker-icon pmx-row-icon--card"><PmTypeIcon Type="SecretType.Card" /></span>
                        <span class="pmx-picker-label">@Texts.CardPrompt</span>
                        <span class="pmx-picker-desc">Card number, holder, CVV</span>
                    </button>
                    <button type="button" class="pmx-picker-card" @onclick="() => BeginCreate(SecretType.Note)">
                        <span class="pmx-picker-icon pmx-row-icon--note"><PmTypeIcon Type="SecretType.Note" /></span>
                        <span class="pmx-picker-label">@Texts.NoteLabel</span>
                        <span class="pmx-picker-desc">Free-form secure note</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum PmMode { Empty, View, Edit, Create }

    private PmMode _mode = PmMode.Empty;
    private SecretViewModel? _selected;
    private SecretType? _typeFilter;
    private bool _scopeShared;
    private SecretType _createType = SecretType.Password;
    private bool _showTypePicker;
    private bool _showExportMenu;
    private bool _saving;
    private string _savingMessage = "Saving…";

    // Edit working copies — passed by reference to PmDetailForm so mutations are visible here on save.
    private SecretPasswordViewModel? _ePwd;
    private SecretCardViewModel?     _eCard;
    private SecretNoteViewModel?     _eNote;

    private bool IsPaid => viewSecretViewModel.HasPaidSubscription;

    // ── Lifecycle ─────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await secretsListViewModel.UpdateFreeUserSubscriptionAsync();
        try { viewSecretViewModel.InitializeUserSubscription(); } catch { }
        try
        {
            viewSecretViewModel.UserEmail =
                AxCrypt.Core.Resolve.KnownIdentities?.DefaultEncryptionIdentity?.UserEmail?.Address ?? string.Empty;
        }
        catch { viewSecretViewModel.UserEmail = string.Empty; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await secretsListViewModel.FindSecrets();
            await InvokeAsync(StateHasChanged);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // ── List ──────────────────────────────────────────────────────

    private IEnumerable<SecretViewModel> VisibleSecrets()
    {
        IEnumerable<SecretViewModel> src = secretsListViewModel.FilteredSecrets != null?secretsListViewModel.FilteredSecrets: new List<SecretViewModel>();
        if (_typeFilter.HasValue)
            src = src.Where(s => s.SecretType == _typeFilter.Value);
        return src.ToList();
    }

    private void SetTypeFilter(SecretType? t)
    {
        _typeFilter = t;
        StateHasChanged();
    }

    private async Task SetScope(bool shared)
    {
        if (_scopeShared == shared) return;

        _scopeShared = shared;
        _showExportMenu = false;
        _selected = null;
        _mode = PmMode.Empty;
        _typeFilter = null;

        if (shared)
            await secretsListViewModel.FilterSharedSecrets(SecretFilterOption.Shared);
        else
            await secretsListViewModel.FilterSecretsBy(SecretFilterOption.All);

        StateHasChanged();
    }

    private void SelectSecret(SecretViewModel s)
    {
        _selected = s;
        secretService.SetCurrentSecret(s);
        viewSecretViewModel.Secret = s;
        _mode = PmMode.View;
        StateHasChanged();
    }

    // ── Export ────────────────────────────────────────────────────

    private void ToggleExportMenu()
    {
        _showExportMenu = !_showExportMenu;
        StateHasChanged();
    }

    private async Task ExportAs(string fileType)
    {
        _showExportMenu = false;
        await secretsListViewModel.ExportFile(fileType);
    }

    // ── Create ────────────────────────────────────────────────────

    private async Task OnAddNewClick()
    {
        try { await ViewModelHelper.CheckFreeUserSecretsCountasync(); } catch { }

        if (!ViewModelHelper.CanAddNewSecret())
        {
            ShowPasswordLimitGate();
            return;
        }

        _showTypePicker = true;
        StateHasChanged();
    }

    private void ShowPasswordLimitGate()
    {
        paidFeaturegateService.ShowPaidGate(
            "Password Manager",
            "You've reached the free password limit. Upgrade to keep adding unlimited passwords, cards, and secure notes.",
            new[] { "Unlimited password entries", "Save cards and secure notes", "Share secrets securely", Texts.PrioritySupportTitle });
    }

    private void BeginCreate(SecretType type)
    {
        _showTypePicker = false;
        _createType = type;
        _selected = null;

        secretService.SecretType = type;
        newSecretViewModel.Secret = new SecretViewModel(
            type,
            new SecretPasswordViewModel(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
            new SecretCardViewModel(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty),
            new SecretNoteViewModel(string.Empty, string.Empty),
            new List<SecretSharedUserViewModel>());
        newSecretViewModel.ErrorMessage = string.Empty;

        _mode = PmMode.Create;
        StateHasChanged();
    }

    private async Task SaveCreate()
    {
        _savingMessage = "Saving…";
        _saving = true;
        StateHasChanged();
        try
        {
            bool ok = await newSecretViewModel.SaveSecretAsync();
            if (ok)
            {
                StatusAlertService.Success(Texts.NewSecretSuccess);
                _scopeShared = false;
                secretsListViewModel.SelectedSecretListFilter = SecretFilterOption.All;
                secretsListViewModel.InvalidateCache();
                await secretsListViewModel.FindSecrets();
                _mode = PmMode.Empty;
                _selected = null;
            }
        }
        finally
        {
            _saving = false;
        }
        StateHasChanged();
    }

    private void CancelCreate()
    {
        _mode = _selected != null ? PmMode.View : PmMode.Empty;
        StateHasChanged();
    }

    // ── Edit ──────────────────────────────────────────────────────

    private void StartEdit()
    {
        if (_selected == null || !IsPaid) return;

        switch (_selected.SecretType)
        {
            case SecretType.Password:
                var p = _selected.Password;
                _ePwd = new SecretPasswordViewModel(p.Title, p.Url, p.Username, p.SecretDesc, p.SecretValue);
                break;
            case SecretType.Card:
                var c = _selected.Card;
                _eCard = new SecretCardViewModel(c.CardNumber, c.SecretDesc ?? string.Empty, c.NameOnCard, c.SecurityCode, c.ExpirationDate);
                break;
            case SecretType.Note:
                var n = _selected.Note;
                _eNote = new SecretNoteViewModel(n.SecretDesc, n.Note);
                break;
        }

        _mode = PmMode.Edit;
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (_selected == null) return;

        var temp = new SecretViewModel(
            _selected.SecretType,
            _ePwd  ?? _selected.Password,
            _eCard ?? _selected.Card,
            _eNote ?? _selected.Note,
            _selected.SharedWith ?? new List<SecretSharedUserViewModel>());
        temp.SecretGuid = _selected.SecretGuid;

        editSecretViewModel.Secret = temp;
        bool ok = await editSecretViewModel.SaveSecretAsync();
        if (ok)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            if (_ePwd  != null) _selected.Password = _ePwd;
            if (_eCard != null) _selected.Card     = _eCard;
            if (_eNote != null) _selected.Note     = _eNote;
            secretService.SetCurrentSecret(_selected);
            _ePwd = null; _eCard = null; _eNote = null;
            _mode = PmMode.View;
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _ePwd = null; _eCard = null; _eNote = null;
        _mode = PmMode.View;
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _selected = null;
        _mode = PmMode.Empty;
        StateHasChanged();
    }

    // ── Delete ────────────────────────────────────────────────────

    private async Task DeleteSelected()
    {
        if (_selected == null || !IsPaid) return;

        PopupButtons answer = await New<IPopup>().ShowAsync(
            PopupButtons.OkCancel, Texts.AlertText, Texts.DeleteSecretText, AxCrypt.Common.DoNotShowAgainOptions.None);
        if (answer != PopupButtons.Ok) return;

        _savingMessage = "Deleting…";
        _saving = true;
        StateHasChanged();
        try
        {
            viewSecretViewModel.Secret = _selected;
            bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
            if (deleted)
            {
                StatusAlertService.Success(Texts.SecretDeletedText);
                secretsListViewModel.InvalidateCache();
                if (_scopeShared)
                    await secretsListViewModel.FilterSharedSecrets(SecretFilterOption.Shared);
                else
                    await secretsListViewModel.FindSecrets();
                _selected = null;
                _mode = PmMode.Empty;
            }
            else
            {
                StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
            }
        }
        finally
        {
            _saving = false;
        }
        StateHasChanged();
    }

    // ── Helpers ───────────────────────────────────────────────────

    // True when the secret was shared with the signed-in user — owner email differs from the current user.
    private bool IsSharedWithMe(SecretViewModel s)
    {
        string mine  = (viewSecretViewModel.UserEmail ?? string.Empty).Trim();
        string owner = (s.OwnerEmail ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(mine) || string.IsNullOrEmpty(owner)) return false;
        return !string.Equals(owner, mine, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenUrlAsync(string url)
    {
        string normalized = url.StartsWith("http") ? url : "https://" + url;
        if (!Uri.TryCreate(normalized, UriKind.Absolute, out var uri)) return;
        try { await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(uri); } catch { }
    }

    // Fills a password field with a server-suggested value — works for both Create and Edit.
    private async Task SuggestPasswordFor(SecretPasswordViewModel p)
    {
        try { p.SecretValue = await SecretsApiHelper.SuggestPasswordAsync(); } catch { }
        StateHasChanged();
    }
}

