@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content

@inject RecentFoldersViewModel RecentFoldersViewModel
@inject ActionsViewModel? homeActionModel
@inject FileDropService FileDropService
@inject IJSRuntime JSRuntime

@implements IDisposable

<div class="home-index @(DropZoneActive ? "home-index--dropping" : "")">
    @if (DropZoneActive)
    {
        <div class="rf-drop-hint rf-drop-hint--folders">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>
            <span>Drop folders here to secure</span>
        </div>
    }

    <div class="page-content-body-section">
        <AxCrypt.App.Shared.Desktop.Components.HomePage.CleanupActionRow IsCleanUpRequired=@homeActionModel!.AreFoldersPending ActionFor="Folders"/>
        
        <div style="padding: 10px 0px 15px;">
            <label class="text-style font-bold">@Texts.RecentFoldersText</label>
        </div>
        <div>

            @if (RecentFoldersViewModel.RecentFoldersList.Any())
            {
                <div class="fle-nme" style="padding-bottom: 20px;">
                    <label class="font-high">@Texts.SecretsSortOrderLabel</label>
                    <select id="FoldersSortOrderOptions" name="FoldersSortOrder" @onchange="RecentFoldersViewModel.HandleSortChange"
                            style="width:110px; height: 31px; padding: 3px; border-radius: 4px; margin: 0%">
                        <option value="Date">@Texts.InvoiceDateHeadline</option>
                        <option value="Content">@Texts.SecretsSortOrderOptionByContent</option>
                    </select>
                </div>
            }

            <div class="hgt-ovflw" style="display: flex; flex-wrap: wrap;">
                @if (!RecentFoldersViewModel.HasNoSubscription)
                {
                    <div class="rcnt-fld-bx fld-dflt-cl add-fldr" @onclick="async (ss) => await RecentFoldersViewModel.AddSecuredFolder(ss)"><img class="add-fldr-img" src="" /><br /><label class="fle-nme">@Texts.AddOrDragFolderText</label></div>
                }
                @if (!RecentFoldersViewModel.RecentFoldersList.Any())
                {
                    <div class="text-center" style="padding-top: 20px;">
                        <span class="empty-view-heading">@Texts.LetsStartOurJourneyText</span><br />
                        <span class="fle-nme">@Texts.AddFirstFolderText</span><br />
                        <img class="empty-rcnt-fld-img" alt="default folder img" />
                    </div>
                }
                else
                {
                    @foreach (string folder in RecentFoldersViewModel.RecentFoldersList)
                    {
                        string folderWithoutTrailingSlash = folder.TrimEnd('\\');
                        <div title="@folderWithoutTrailingSlash" class="rcnt-fld-bx fld-dflt-cl recent-folder-action-cls fle-nme" style="white-space: nowrap" @ondblclick="(arg) => RecentFoldersViewModel.HandleDoubleClick(arg, folder)"
                             @oncontextmenu="(e) => RecentFoldersViewModel.SecuredContextMenu(e, folder)">
                            <img class="fldr-img" src="" /><br /><label title="@folderWithoutTrailingSlash">@GetBeforeLastFolderName(folderWithoutTrailingSlash)</label>
                            <span style="font-size:8px; display: block; padding-top: 0px;">@folderWithoutTrailingSlash</span>
                        </div>
                    }
                }
                @* <div class="rcnt-fld-bx tmpr-img whte-clr fld-tem-cl" @onmouseover="ShowTempPopup" @onmouseout="HideTempPopup">
                <img class="" src="images/default/IcoFldrwhte.svg" /><br /><label>Netflix</label>
                @if (isTempHovered && currentDevice == DeviceIdiom.Desktop)
                {
                <div class="hover-popup text-center">
                <span style="color:white;">
                Folder is temporary <strong>decrypted!</strong>
                </span><br />
                <img class="" src="/images/default/IcoOpnScrd.svg" alt="IcoOpnScrd" />
                </div>
                }
                </div>
                <div class="rcnt-fld-bx fld-ntfnd-cl grey-clr" @onmouseover="ShwNotfndPop" @onmouseout="HdeNotfndPop">
                <img class="" src="images/default/IcoFldrGry.svg" /><br /><label>Videos</label>
                @if (isNtFundHovered && currentDevice == DeviceIdiom.Desktop)
                {
                <div class="hover-popup text-center">
                <span style="color:white;">
                Path is not  <strong>found!</strong>
                </span><br />
                <img class="" src="images/default/Icolstcnnct.svg" />
                </div>
                }
                </div> *@
            </div>

            <div id="securedContextMenu" class="hide-model-popup home-context-menu" style="display: none;position:fixed;">
                <dl class="font-medium fle-nme" style="margin-bottom: 5px;">
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.ShareKey)">@Texts.ShareKeysToolStripMenuItemText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.DecryptPermanently)">@Texts.MenuDecryptPermanentlyText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.DecryptTemporarily)">@Texts.MenuDecryptTemporarilyText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.RemoveFromListButKeepSecured)">@Texts.RemoveRecentFileToolStripMenuItemText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.ShowInExplorer)">@Texts.MenuOpenExplorerHereText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.AddSecuredFolder)">@Texts.AddSecureFolderMenuItemText</dd>
                    <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.FolderSettings)">@Texts.FolderSettingsText</dd>
                </dl>
            </div>

        </div>
    </div>
</div>

<AxCrypt.App.Shared.Desktop.Components.PopupDialog.FolderSettingsDialog />

@code {
    private bool DropZoneActive { get; set; }

    // Held on the instance so we can unsubscribe on Dispose.
    private Action<IList<string>>? _onFoldersDroppedHandler;

    protected override async Task OnInitializedAsync()
    {
        RecentFoldersViewModel.Initialize();

        RecentFoldersViewModel.OnUpdateViewState += UpdateStateChanged;
        RecentFoldersViewModel.LogOnViewModel.OnUIStateChanged += UpdateStateChanged;

        FileDropService.ResetOnDropped();
        _onFoldersDroppedHandler = async (folders) =>
        {
            DropZoneActive = false;
            await HandleDroppedFolders(folders);
            await InvokeAsync(StateHasChanged);
        };
        FileDropService.OnFoldersDropped += _onFoldersDroppedHandler;
        FileDropService.OnFilesDraggedOver += HandleDraggedOverFiles;
        FileDropService.OnFilesDragLeave += HandleDragLeave;

        await base.OnInitializedAsync();
    }
    private void HandleDraggedOverFiles()
    {
        DropZoneActive = true;
        UpdateStateChanged();
    }

    private void HandleDragLeave()
    {
        DropZoneActive = false;
        UpdateStateChanged();
    }

    public void Dispose()
    {
        if (_onFoldersDroppedHandler != null)
        {
            FileDropService.OnFoldersDropped -= _onFoldersDroppedHandler;
        }
        RecentFoldersViewModel.OnUpdateViewState -= UpdateStateChanged;
        RecentFoldersViewModel.LogOnViewModel.OnUIStateChanged -= UpdateStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private void UpdateRecentFoldersList(bool updateFolders)
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    string GetBeforeLastFolderName(string path)
    {
        string[] parts = path.TrimEnd(Path.DirectorySeparatorChar).Split(Path.DirectorySeparatorChar);
        //return parts.Length >= 2 ? $"{parts[^2]}{Path.DirectorySeparatorChar}{parts[^1]}" : path;
        return parts.Length >= 1 ? parts[^1] : path;
    }

    private async Task HandleDroppedFolders(IList<string> folders)
    {
        await RecentFoldersViewModel.EncryptDroppedFolders(folders);
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}