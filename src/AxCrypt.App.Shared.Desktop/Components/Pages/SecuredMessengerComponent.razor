@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

@inject ManageSecMsgrViewModel SecMsgrViewModel

<div class="secured-messenger">
    @* Free-tier message quota — hides for Premium / Business. *@
    <AxCrypt.App.Shared.Desktop.Components.Shared.FreePlanLimitBar
        Feature="AxCrypt.App.Entitlement.Contracts.FeatureKey.SecuredMessage" />

    <div class="row page-content-body-section">
        <div class="medium-12 columns filter-tab-wrapper" id="sec-msg-search-section">
            <EditForm Model="SecMsgrViewModel.Messenger" OnValidSubmit="SearchList" id="search-msg-form">
                <input type="hidden" name="SecMessengerFilterTab" @bind="SecMsgrViewModel.Messenger.SecMessengerFilterTab" id="sec-messenger-filter-tab" />
                <InputText @bind-Value="SecMsgrViewModel.Messenger.Keyword"
                id="messenger-keyword"
                placeholder=@Texts.PromptXecretsSearchText
                class="sec-msg-search"
                tabindex="1" />

                @* Advanced-filter toggle. Kept as a real button with the
                   id homepopup.js looks for; the inline SVG replaces the
                   old <img src=""> that rendered as a broken icon. *@
                <button type="button" class="filter-trigger" title="@Texts.SearchText"
                        id="advanced-filter-popup-button-action" @onclick="OnApplyFilter">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                    </svg>
                </button>
                <div class="filter-popup model-popup" id="advanced-filter-popup">
                    <label>@Texts.FromText</label>
                    <InputText @bind-Value="SecMsgrViewModel.Messenger.UserName"
                    placeholder="@Texts.BusinessSubscriptionEmailPlaceholder"
                    type="email"
                    style="width: 50%;"
                    name="from"
                    id="" />
                    <br />
                    <label>@Texts.ToText</label>
                    <InputText @bind-Value="SecMsgrViewModel.Messenger.ReceiverName"
                    placeholder="@Texts.BusinessSubscriptionEmailPlaceholder"
                    type="email"
                    style="width: 50%;"
                    name="to"
                    id="" />
                    <div>
                        <label>@Texts.DateFromText</label>
                        <InputDate @bind-Value="SecMsgrViewModel.Messenger.StartDate" style="width: 23%; color:#000;" name="date-from" />
                        <span class="font-high" style="padding: 10px;">@Texts.ToText1</span>
                        <InputDate @bind-Value="SecMsgrViewModel.Messenger.EndDate" style="width: 23%; color: #000;" name="date-to" />
                    </div>
                    <div style="display: flex; float: right; padding-top: 20px;">
                        <button type="reset" class="button border btn-large font-medium" style="margin-right: 30px;" @onclick="()=> ClearAllFilters()">@Texts.ClearAllText</button>
                        <button type="submit" class="button success btn-large font-medium" id="apply-search-filter">@Texts.ApplyLabel</button>
                    </div>
                </div>
                <button type="submit" id="message-search-btn" class="button success msg-search-btn" title="@Texts.SearchText">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                </button>
                @if (appliedFilters.Any() == true)
                {
                    <div class="searched-filters">
                        @foreach (FilterItem filter in appliedFilters)
                        {
                            <div class="filter-items">
                                <label>@filter.Label</label>
                                <div class="slct-filt-box">
                                    <span>@filter.Value</span>
                                </div>
                            </div>
                        }
                        <img class="close-img" @onclick="ClearAllFilters" />
                    </div>
                }
            </EditForm>

        </div>
        <div class="medium-12 columns">
            @* Filter tabs — Inbox / Sent / Unread.
               Previous markup used `id="tab-header"` three times (invalid),
               wrapped each tab in its own div, and carried hidden <hr>
               elements that did nothing. Replaced with a flat <nav role="tablist">
               of three buttons so the layout is one strip and selection
               state is driven by a single `.smx-filter-tab--active` class. *@
            <nav class="smx-filter-tabs" role="tablist" aria-label="Message filter">
                <button type="button"
                        class="smx-filter-tab @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Inbox ? "smx-filter-tab--active" : "")"
                        role="tab"
                        aria-selected="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Inbox)"
                        @onclick="() => SetActiveTab(SecureMsgrFilterTab.Inbox, Guid.Empty)"
                        id="inbox-tab">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
                        <path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z" />
                    </svg>
                    <span>@Texts.InboxText</span>
                </button>
                <button type="button"
                        class="smx-filter-tab @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Sent ? "smx-filter-tab--active" : "")"
                        role="tab"
                        aria-selected="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Sent)"
                        @onclick="() => SetActiveTab(SecureMsgrFilterTab.Sent, Guid.Empty)"
                        id="sent-tab">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    <span>@Texts.SentText</span>
                </button>
                <button type="button"
                        class="smx-filter-tab @(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Unread ? "smx-filter-tab--active" : "")"
                        role="tab"
                        aria-selected="@(SecMsgrViewModel.Messenger.SecMessengerFilterTab == SecureMsgrFilterTab.Unread)"
                        @onclick="() => SetActiveTab(SecureMsgrFilterTab.Unread, Guid.Empty)"
                        id="unread-tab">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <circle cx="12" cy="12" r="3" fill="currentColor" />
                    </svg>
                    <span>@Texts.UnReadText</span>
                </button>
            </nav>
            <div id="search-message-list" class="parent-container">
                <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.Body />
            </div>
        </div>
    </div>
</div>

<style>
    /* Messenger filter strip — one flat row of three pill-style buttons
       sharing a soft underline. Replaces the old 3-div / 3-hr layout
       that produced inconsistent spacing and duplicate IDs. */
    .smx-filter-tabs {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .smx-filter-tab {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        border: none;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        border-radius: 8px 8px 0 0;
        transition: color .12s, background .12s;
    }

    .smx-filter-tab svg {
        flex-shrink: 0;
        opacity: .75;
        transition: opacity .12s;
    }

    .smx-filter-tab:hover {
        color: #111827;
        background: rgba(72, 119, 44, .06);
    }

    .smx-filter-tab:hover svg {
        opacity: 1;
    }

    .smx-filter-tab--active {
        color: #48772C;
    }

    .smx-filter-tab--active svg {
        opacity: 1;
    }

    /* Active-tab underline — drawn as a thicker bar that sits flush with
       the bottom border so the tab feels anchored to the list below. */
    .smx-filter-tab--active::after {
        content: "";
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: -1px;
        height: 2.5px;
        background: #48772C;
        border-radius: 2px;
    }

    html[data-theme="dark"] .smx-filter-tabs {
        border-bottom-color: #2A3340;
    }

    html[data-theme="dark"] .smx-filter-tab {
        color: #B5BCC7;
    }

    html[data-theme="dark"] .smx-filter-tab:hover {
        color: #E8ECF1;
        background: rgba(127, 204, 92, .12);
    }

    html[data-theme="dark"] .smx-filter-tab--active {
        color: #B8E89A;
    }

    html[data-theme="dark"] .smx-filter-tab--active::after {
        background: #7FCC5C;
    }

    /* Tighten the wrapper around the list so the new filter strip and
       list pane sit flush together — the old `parent-container` margin
       added an unwanted gap below the tabs. */
    #search-message-list.parent-container {
        margin-top: 0;
        padding-top: 0;
    }
</style>

@code {
    private SecureMsgrFilterTab activeTab = SecureMsgrFilterTab.Inbox;

    protected override void OnInitialized()
    {
        SecMsgrViewModel.OnUpdateViewState += UpdatePageState;
        SecMsgrViewModel.NewSecMsgrViewModel.OnTabUpdateViewState += async (SecureMsgrFilterTab selectedtab) => await UpdateTabState(selectedtab);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (New<AxCrypt.Common.AxCryptOnlineState>().IsOffline)
        {
            //await New<Core.UI.IPopup>().ShowAsync(Core.UI.PopupButtons.Ok, Texts.MessageErrorTitle, Texts.NoInternetErrorMessage);
        }

        if (firstRender)
        {
            await SetActiveTab(activeTab, Guid.Empty);
        }
    }

    private async Task SetActiveTab(SecureMsgrFilterTab securedMessengerFilterTab, Guid parentId)
    {
        SecMsgrViewModel.NewSecMsgrViewModel.ParentId = parentId;
        activeTab = securedMessengerFilterTab;
        await SecMsgrViewModel.SetSelectedTabActive(securedMessengerFilterTab);
    }

    private async Task SearchList()
    {
        if (New<AxCrypt.Common.AxCryptOnlineState>().IsOffline)
        {
            return;
        }

        ApplyFilters();

        using (ProcessIndicator progress = new ProcessIndicator())
        {
            SecMsgrViewModel.Messenger.Messages = new List<Core.SecuredMessenger.SecuredMessage>();
            SecMsgrViewModel.UpdateViewState();

            await SecMsgrViewModel.SearchList(SecMsgrViewModel.Messenger, activeTab);
            SecMsgrViewModel.UpdateViewState();
        }
    }

    private List<FilterItem> appliedFilters = new();

    private void ApplyFilters()
    {
        appliedFilters.Clear();

        if (!string.IsNullOrWhiteSpace(SecMsgrViewModel.Messenger.UserName))
        {
            appliedFilters.Add(new FilterItem(Texts.FromText, SecMsgrViewModel.Messenger.UserName));
        }

        if (!string.IsNullOrWhiteSpace(SecMsgrViewModel.Messenger.ReceiverName))
        {
            appliedFilters.Add(new FilterItem(Texts.ToText, SecMsgrViewModel.Messenger.ReceiverName));
        }

        if (SecMsgrViewModel.Messenger.StartDate != DateTime.MinValue)
        {
            appliedFilters.Add(new FilterItem(Texts.DateFromText, SecMsgrViewModel.Messenger.StartDate.ToShortDateString()));
        }

        if (SecMsgrViewModel.Messenger.EndDate != DateTime.MinValue)
        {
            appliedFilters.Add(new FilterItem(Texts.ToText1, SecMsgrViewModel.Messenger.EndDate.ToShortDateString()));
        }
    }

    private void OnApplyFilter()
    {
        const int _defaultSearchFilerDays = 7;

        if (SecMsgrViewModel.Messenger.StartDate == DateTime.MinValue)
        {
            SecMsgrViewModel.Messenger.StartDate = New<Abstractions.INow>().Utc.AddDays(-_defaultSearchFilerDays);
        }

        if (SecMsgrViewModel.Messenger.EndDate == DateTime.MinValue)
        {
            SecMsgrViewModel.Messenger.EndDate = New<Abstractions.INow>().Utc;
        }

        SecMsgrViewModel.Messenger.Keyword = string.Empty;
    }

    private async Task ClearAllFilters()
    {
        appliedFilters.Clear();
        SecMsgrViewModel.Messenger.UserName = "";
        SecMsgrViewModel.Messenger.ReceiverName = "";
        SecMsgrViewModel.Messenger.StartDate = DateTime.MinValue;
        SecMsgrViewModel.Messenger.EndDate = DateTime.MinValue;
        await SetActiveTab(activeTab, Guid.Empty);
    }

    private class FilterItem
    {
        public string Label { get; set; }
        public string Value { get; set; }

        public FilterItem(string label, string value)
        {
            Label = label;
            Value = value;
        }
    }

    private async Task UpdateTabState(SecureMsgrFilterTab securedMessengerFilterTab)
    {
        await SetActiveTab(securedMessengerFilterTab, SecMsgrViewModel.NewSecMsgrViewModel.ParentId);

        await InvokeAsync(() =>
        {
            SecMsgrViewModel.SelectedMessageId = Guid.Empty;
            StateHasChanged(); // Refresh UI
        });
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            SecMsgrViewModel.SelectedMessageId = Guid.Empty;
            StateHasChanged(); // Refresh UI
        });
    }
}