@using AxCrypt.Content

<div class="row">
    <div class="medium-12 columns page-title-container">
        <h1 class="page-title">
            @Texts.TextEncryptionLinkLabel
        </h1>
    </div>
</div>

<div class="action-tabs">
    <div id="encrypt-tab" class="act-tab @(TabIndex == 1 ? "active" : "")">
        <img class="tabicon encrypt-ico" alt="encrypt-icon" />
        <a href="javascript:void(0);" @onclick="() => SetActiveTab(1)">@Texts.TextEncryptionSideMenuHead1</a>
    </div>
    <div id="decrypt-tab" class="act-tab @(TabIndex == 2 ? "active" : "")">
        <img class="tabicon decrypt-ico" alt="decrypt-icon" />
        <a href="javascript:void(0);" @onclick="() => SetActiveTab(2)">@Texts.TextEncryptionSideMenuHead3</a>
    </div>
</div>

<div class="parent-container" style="margin-top:20px;min-height:50vh;height: 77vh;overflow-y: auto;">
    @if (TabIndex == 1)
    {
        <AxCrypt.App.Shared.Desktop.Components.TextEncryption._TextEncryption />
    }
    else if (TabIndex == 2)
    {
        <AxCrypt.App.Shared.Desktop.Components.TextEncryption._TextDecryption />
    }
</div>

@code {
    public int TabIndex { get; set; }

    protected override void OnInitialized()
    {
        TabIndex = 1;
        base.OnInitialized();
    }

    private void SetActiveTab(int tabIndex)
    {
        TabIndex = tabIndex;
    }
}
