<div class="row">
    <div class="medium-12 columns page-title-container">
        <h1 class="page-title">
            Text Encryption
        </h1>
    </div>
</div>

<div class="action-tabs">
    <div id="encrypt-tab" class="act-tab @(TabIndex == 1 ? "active" : "")">
        <img class="tabicon encrypt-ico" alt="encrypt-icon" />
        <a href="javascript:void(0);" @onclick="() => SetActiveTab(1)">Encrypt Text</a>
    </div>
    <div id="decrypt-tab" class="act-tab @(TabIndex == 2 ? "active" : "")">
        <img class="tabicon decrypt-ico" alt="decrypt-icon" />
        <a href="javascript:void(0);" @onclick="() => SetActiveTab(2)">Decrypt Text</a>
    </div>
</div>

@if (TabIndex == 1)
{
    <div style="margin-top:20px;">
        <AxCrypt.App.Shared.Desktop.Components.TextEncryption._TextEncryption />
    </div>
}
else if (TabIndex == 2)
{
    <div style="margin-top:20px;">
        <AxCrypt.App.Shared.Desktop.Components.TextEncryption._TextDecryption />
    </div>
}

@code {
    public int TabIndex { get; set; }

    protected override void OnInitialized()
    {
        TabIndex = 1;
        base.OnInitialized();
    }

    private void SetActiveTab(int tabIndex)
    {
        TabIndex = tabIndex;
    }
}
