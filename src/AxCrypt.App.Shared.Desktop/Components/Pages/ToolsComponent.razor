@using AxCrypt.Api.Model
@using AxCrypt.App.Entitlement.Services
@using AxCrypt.App.Shared.Desktop.Models;
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Desktop.ViewModels.Home
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Models
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using static AxCrypt.Abstractions.TypeResolve

@inject NavigationManager Navigation
@inject ProfileViewModel? ProfileViewModel
@inject AppSettingsViewModel appSettingsViewModel
@inject PaidFeaturegateService paidFeaturegateService
@inject SubActionViewModel subActionModel
@inject AxCrypt.App.Shared.ViewModels.LogOnViewModel LogOnViewModel
@implements IDisposable

<div class="tools-shell">

    <!-- ═══════════════ PAGE HEADER ═══════════════ -->
    <div class="tools-header">
        <div class="tools-header-right">
            <div class="tools-search-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input @bind="SearchQuery" @bind:event="oninput" placeholder="Search tools..." class="tools-search-input" />
            </div>
        </div>
    </div>

    <!-- ═══════════════ ACTIVE TOOL PANEL ═══════════════ -->
    @*     @if (ActiveTool != null)
    {
        <div class="tool-panel">
            <div class="tool-panel-header">
                <div class="tool-panel-title-row">
                    <span class="tool-panel-icon @ActiveTool.IconBg">
                        @((MarkupString)ActiveTool.IconSvg)
                    </span>
                    <div>
                        <h2 class="tool-panel-name">@ActiveTool.Name</h2>
                        <p class="tool-panel-desc">@ActiveTool.Description</p>
                    </div>
                </div>
                <button class="tool-panel-close" @onclick="() => ActiveTool = null">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <!-- ── Secure Delete ── -->
            @if (ActiveTool.Id == "secure-delete")
            {
                <div class="tool-body">
                    <div class="tool-warning-banner">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        This operation is <strong>permanent and irreversible</strong>. Files are overwritten with random data before deletion.
                    </div>
                    <div class="tool-drop-zone @(IsDragging ? "tool-drop-zone--active" : "")"
                         @ondragover:preventDefault="true"
                         @ondragover="() => IsDragging = true"
                         @ondragleave="() => IsDragging = false"
                         @ondrop="OnFileDrop">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <polyline points="16 16 12 12 8 16" />
                            <line x1="12" y1="12" x2="12" y2="21" />
                            <path d="M20.39 18.39A5 5 0 0018 9h-1.26A8 8 0 103 16.3" />
                        </svg>
                        <p class="drop-label">Drop files here or <button class="drop-browse" @onclick="BrowseFiles">browse</button></p>
                        <p class="drop-sub">All file types supported · Overwrites @SelectedPassCount passes times before deletion</p>
                    </div>
                    <div class="tool-option-row">
                        <label class="tool-option-label">Overwrite passes</label>
                        <div class="pass-selector">
                            @foreach (var p in new[] { 1, 3, 7, 35 })
                            {
                                <button class="pass-btn @(SelectedPassCount == p ? "pass-btn--active" : "")"
                                        @onclick="() => SelectedPassCount = p">
                                    @p
                                </button>
                            }
                        </div>
                    </div>
                    <button class="tool-action-btn tool-action-btn--danger" disabled="@(!ToolFilesQueued)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2" />
                        </svg>
                        Securely Delete @(ToolFilesQueued ? "Files" : "(no files selected)")
                    </button>
                </div>
            }

            <!-- ── Anonymous Rename ── -->
            @if (ActiveTool.Id == "anon-rename")
            {
                <div class="tool-body">
                    <p class="tool-body-intro">Replace original filenames with random identifiers so file contents cannot be guessed from their names.</p>
                    <div class="tool-field-group">
                        <label class="tool-field-label">Rename pattern</label>
                        <div class="tool-radio-row">
                            @foreach (var p in RenamePatterns)
                            {
                                <label class="tool-radio-chip @(SelectedRenamePattern == p.Value ? "tool-radio-chip--active" : "")">
                                    <input type="radio" name="rp" value="@p.Value"
                                           checked="@(SelectedRenamePattern == p.Value)"
                                           @onchange="() => SelectedRenamePattern = p.Value" />
                                    @p.Label
                                </label>
                            }
                        </div>
                        <p class="tool-field-hint">Example output: <code>@RenameExample</code></p>
                    </div>
                    <div class="tool-drop-zone">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                        </svg>
                        <p class="drop-label">Select files to rename</p>
                    </div>
                    <div class="tool-checkbox-row">
                        <input type="checkbox" id="keep-ext" @bind="KeepExtension" />
                        <label for="keep-ext">Keep original file extension</label>
                    </div>
                    <button class="tool-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                        </svg>
                        Apply Anonymous Rename
                    </button>
                </div>
            }

            <!-- ── Restore Rename ── -->
            @if (ActiveTool.Id == "restore-rename")
            {
                <div class="tool-body">
                    <p class="tool-body-intro">Restore previously anonymized filenames back to their original names using the stored rename map.</p>
                    <div class="tool-drop-zone">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                            <polyline points="1 4 1 10 7 10" />
                            <path d="M3.51 15a9 9 0 102.13-9.36L1 10" />
                        </svg>
                        <p class="drop-label">Drop anonymized files or folder here</p>
                    </div>
                    <div class="tool-info-box">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        Rename map is stored encrypted in your vault. Ensure your vault is unlocked before proceeding.
                    </div>
                    <button class="tool-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="1 4 1 10 7 10" />
                            <path d="M3.51 15a9 9 0 102.13-9.36L1 10" />
                        </svg>
                        Restore Original Names
                    </button>
                </div>
            }

            <!-- ── Upgrade AES ── -->
            @if (ActiveTool.Id == "upgrade-aes")
            {
                <div class="tool-body">
                    <div class="tool-info-box tool-info-box--blue">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                        </svg>
                        AES-256 provides twice the key length of AES-128, making brute-force attacks computationally infeasible.
                    </div>
                    <div class="aes-progress-area">
                        <div class="aes-stat"><span class="aes-stat-num">@Aes128Count</span><span class="aes-stat-label">AES-128 files found</span></div>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
                        <div class="aes-stat"><span class="aes-stat-num">@Aes128Count</span><span class="aes-stat-label">Will be upgraded</span></div>
                    </div>
                    <button class="tool-action-btn tool-action-btn--scan" @onclick="ScanAesFiles">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        Scan for AES-128 Files First
                    </button>
                    <button class="tool-action-btn" disabled="@(Aes128Count == 0)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10" />
                            <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" />
                        </svg>
                        Upgrade All to AES-256
                    </button>
                </div>
            }

            <!-- ── Find Files ── -->
            @if (ActiveTool.Id == "find-files")
            {
                <div class="tool-body">
                    <p class="tool-body-intro">Scan your drives to discover all files encrypted with AxCrypt.</p>
                    <div class="tool-field-group">
                        <label class="tool-field-label">Search location</label>
                        <div class="tool-path-row">
                            <input type="text" class="tool-text-input" @bind="FindPath" placeholder="C:\ or select a folder..." />
                            <button class="tool-browse-btn">Browse</button>
                        </div>
                    </div>
                    <div class="tool-checkbox-row">
                        <input type="checkbox" id="recurse" @bind="FindRecurse" />
                        <label for="recurse">Include sub-folders</label>
                    </div>
                    <div class="tool-checkbox-row">
                        <input type="checkbox" id="cloud" @bind="FindCloud" />
                        <label for="cloud">Also scan connected cloud drives</label>
                    </div>
                    <button class="tool-action-btn @(IsFinding ? "tool-action-btn--loading" : "")" @onclick="StartFind">
                        @if (IsFinding)
                        {
                            <span class="spinner"></span>
                            <span>Scanning... @FindCount files found</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                            <span>Find Encrypted Files</span>
                        }
                    </button>
                    @if (FindResults.Any())
                    {
                        <div class="find-results">
                            <div class="find-results-header">
                                Found <strong>@FindResults.Count</strong> encrypted files
                                <button class="find-export-btn">Export list</button>
                            </div>
                            @foreach (var r in FindResults)
                            {
                                <div class="find-result-row">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                        <polyline points="14 2 14 8 20 8" />
                                    </svg>
                                    <span class="find-result-path">@r</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- ── Verify File ── -->
            @if (ActiveTool.Id == "verify-file")
            {
                <div class="tool-body">
                    <p class="tool-body-intro">Check whether a file is a valid AxCrypt-encrypted file and inspect its encryption metadata.</p>
                    <div class="tool-drop-zone @(VerifyResult != null ? "tool-drop-zone--done" : "")">
                        @if (VerifyResult == null)
                        {
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                            </svg>
                            <p class="drop-label">Drop a file here to verify</p>
                        }
                        else
                        {
                            <div class="verify-result @(VerifyResult.IsValid ? "verify-result--ok" : "verify-result--fail")">
                                @if (VerifyResult.IsValid)
                                {
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="10" fill="#22c55e" />
                                        <polyline points="8 12 11 15 16 9" stroke="white" stroke-width="2.5" fill="none" />
                                    </svg>
                                    <span class="verify-label">Valid AxCrypt File</span>
                                }
                                else
                                {
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="12" r="10" fill="#ef4444" />
                                        <line x1="15" y1="9" x2="9" y2="15" stroke="white" stroke-width="2.5" />
                                        <line x1="9" y1="9" x2="15" y2="15" stroke="white" stroke-width="2.5" />
                                    </svg>
                                    <span class="verify-label">Not an AxCrypt File</span>
                                }
                            </div>
                            @if (VerifyResult.IsValid)
                            {
                                <div class="verify-meta">
                                    <div class="verify-meta-row"><span>Filename</span><span>@VerifyResult.FileName</span></div>
                                    <div class="verify-meta-row"><span>Algorithm</span><span>@VerifyResult.Algorithm</span></div>
                                    <div class="verify-meta-row"><span>Version</span><span>@VerifyResult.Version</span></div>
                                    <div class="verify-meta-row"><span>Encrypted</span><span>@VerifyResult.EncryptedDate</span></div>
                                </div>
                            }
                        }
                    </div>
                    <button class="tool-action-btn" @onclick="SimulateVerify">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                            <polyline points="9 12 11 14 15 10" />
                        </svg>
                        Verify File
                    </button>
                </div>
            }

            <!-- ── Invite Friend ── -->
            @if (ActiveTool.Id == "invite")
            {
                <div class="tool-body">
                    <p class="tool-body-intro">Invite a friend or colleague to SecureApp. They'll receive a secure onboarding link.</p>
                    <div class="tool-field-group">
                        <label class="tool-field-label">Email address</label>
                        <input type="email" class="tool-text-input" @bind="InviteEmail" placeholder="colleague@company.com" />
                    </div>
                    <div class="tool-field-group">
                        <label class="tool-field-label">Personal message (optional)</label>
                        <textarea class="tool-textarea" @bind="InviteMessage" placeholder="Hey! I've been using SecureApp to protect my files..."></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(InviteStatus))
                    {
                        <div class="tool-success-banner">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="10" fill="#22c55e" />
                                <polyline points="8 12 11 15 16 9" stroke="white" stroke-width="2" fill="none" />
                            </svg>
                            @InviteStatus
                        </div>
                    }
                    <button class="tool-action-btn" @onclick="SendInvite">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13" />
                            <polygon points="22 2 15 22 11 13 2 9 22 2" />
                        </svg>
                        Send Invite
                    </button>
                </div>
            }
        </div>
    }

     *@
    <!-- ═══════════════ TOOL GRID ═══════════════ -->
    @foreach (ToolGroup group in FilteredGroups)
    {
        <div class="tools-group">
            <div class="tools-group-header">
                <h3 class="tools-group-name">@group.Name</h3>
                <span class="tools-group-count">@group.Tools.Count tools</span>
            </div>
            <div class="tools-grid">
                @foreach (ToolItem tool in group.Tools)
                {
                    <button class="tool-card @(ActiveTool?.Id == tool.Id ? "tool-card--active" : "") @(tool.IsDanger ? "tool-card--danger" : "")"
                            @onclick="async (e) => await SelectTool(e, tool)">
                        <div class="tc-header">
                            <span class="tc-icon @tool.IconBg">
                                <img src="" class="@tool.IconSvg" title="@tool.IconSvg" />
                            </span>
                            @if (tool.IsBeta)
                            {
                                <span class="tc-badge tc-badge--beta">Beta</span>
                            }
                            @if (tool.IsNew)
                            {
                                <span class="tc-badge tc-badge--new">New</span>
                            }
                            @if (tool.IsDanger)
                            {
                                <span class="tc-badge tc-badge--danger">Irreversible</span>
                            }
                        </div>
                        <h4 class="tc-name">@tool.Name</h4>
                        <p class="tc-desc">@tool.Description</p>
                        <div class="tc-footer">
                            <span class="tc-open">Open tool</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6" />
                            </svg>
                        </div>
                    </button>
                }
            </div>
        </div>
    }

    @if (!FilteredGroups.Any())
    {
        <div class="tools-empty">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <p>No tools match "<strong>@SearchQuery</strong>"</p>
        </div>
    }
</div>

<div class="key-mngnt-Popup model-popup sub-pop1" style="display:none;" id="key-management-popup">
    <div class="font-medium left-align" id="key-management-popup">
        <dd class="act-clr @ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="() => ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ImportSomeonesSharingKey)">@Texts.ImportSomeonesPublicSharingKeyText</dd>
        <dd class="act-clr @ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="() => ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ExportMySharingKey)">@Texts.ExportSharingKeyToolStripMenuItemText</dd>
        <dd class="act-clr @ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="() => ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ExportAxCryptIDAndSharingKeyPair)">@Texts.ExportMyPrivateKeyToolStripMenuItemText</dd>
    </div>
</div>

@if (appSettingsViewModel.ShowOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
                @if (!string.IsNullOrEmpty(appSettingsViewModel!.ErrorMessage))
                {
                    <div class="error-message">@appSettingsViewModel.ErrorMessage</div>
                }
                <div class="input-group">
                    <label for="restApiUrl">@Texts.DialogDebugOptionsRestApiUrlPrompt</label>
                    <input type="text" id="restApiUrl" class="form-control" @bind="@appSettingsViewModel.RestApiBaseUrlInput" style="text-indent: 0px;" />
