    // ── Find Files state ────────────────────────
    private string FindPath { get; set; } = @"C:\";
    private bool FindRecurse { get; set; } = true;
    private bool FindCloud { get; set; } = false;
    private bool IsFinding { get; set; }
    private int FindCount { get; set; }
    private List<string> FindResults { get; set; } = new();
    private async void StartFind()
    {
        IsFinding = true; FindCount = 0; FindResults.Clear(); StateHasChanged();
        await Task.Delay(1200);
        FindResults = new() { };
        FindCount = FindResults.Count; IsFinding = false; StateHasChanged();
    }

    // ── Invite state ────────────────────────────
    private string InviteEmail { get; set; } = string.Empty;
    private string InviteMessage { get; set; } = string.Empty;
    private string InviteStatus { get; set; } = string.Empty;

    private async void SendInvite()
    {
        if (string.IsNullOrWhiteSpace(InviteEmail)) return;
        await Task.Delay(600);
        InviteStatus = $"Invite sent to {InviteEmail} successfully!";
        InviteEmail = string.Empty; StateHasChanged();
    }

    private async Task SelectTool(EventArgs e, ToolItem tool)
    {
        //ActiveTool = ActiveTool?.Id == tool.Id ? null : tool;
        InviteStatus = string.Empty;

        switch (tool.Id)
        {
            case "invite":
                if (!appSettingsViewModel.EnableInviteFriend || !await New<UserEntitlementService>().UserHasCapability(LimitedCapability.KeySharing, LogOnViewModel.SubscriptionLevel))
                {
                    paidFeaturegateService.ShowPaidGate(Texts.InviteUserToolStripMenuItemText, "Send a secure onboarding invite to colleagues or friends with offline key sharing support.", new[] { "Secure user invites", "Offline key sharing", "Easy encrypted onboarding", "End-to-end protection" });
                    return;
                }

                appSettingsViewModel.OpenInviteUser(e);
                break;

            case "debug-check-version":
                appSettingsViewModel.CheckAxCryptVersionAsync();
                break;

            case "debug-options":
                appSettingsViewModel.OpenOptions();
                break;

            case "debug-logging":
                appSettingsViewModel.OnOpenLogViewerClicked(Utility.LogType.Debug);
                break;

            case "debug-manageaxcryptid":
                await appSettingsViewModel.OpenManageAxCryptID();
                break;

            case "debug-trybrokenfile":
                appSettingsViewModel.OpenBrokenFiles();
                break;

            case "debug-verifyfiletool":
                appSettingsViewModel.VerifyAxCryptFiles();
                break;

            case "debug-checktools":
                appSettingsViewModel.AxCryptFileFormatCheck();
                break;

            case "debug-reportsnapshot":
                appSettingsViewModel.OpenReportAsync();
                break;

            case "upgrade-tool":
                @if (!subActionModel.EnableEncryptionUpgrade)
                {
                    paidFeaturegateService.ShowPaidGate(Texts.UpgradeLegacyFilesMenuItemText, "Upgrade AES-128 encrypted files to AES-256 when opened.", new[] { "Upgrade files to AES-256", "Migrate older encryption", "Latest security standard", "Stronger file protection" });
                    return;
                }

                subActionModel.EncryptionUpgrade(e);
                break;

            case "anon-rename":
                if (!subActionModel.EnableRandomRename)
                {
                    paidFeaturegateService.ShowPaidGate(Texts.AnonymousRenameMenuText, "Rename files with random names to help protect your privacy.",
                        new[]
                        {
                            "Hide original file names",
                            "Improve file privacy",
                            "Rename files securely",
                            "Unlock advanced privacy features"
                        });
                    return;
                }

                subActionModel.RandomRenameAsync(e);
                break;

            case "secure-delete":
                if (!subActionModel.EnableSecureWipeFiles)
                {
                    paidFeaturegateService.ShowPaidGate(Texts.SecureDeleteToolStripMenuItemText, "Permanently delete files so they cannot be recovered.",
                        new[]
                        {
                            "Permanent file deletion",
                            "Prevent file recovery",
                            "Protect sensitive information",
                            "Unlock advanced security tools"
                        });
                    return;
                }

                subActionModel.SecureWipeFiles(e);
                break;

            case "restore-rename":
                if (!appSettingsViewModel.EnableRestoreRename)
                {
                    paidFeaturegateService.ShowPaidGate(Texts.RestoreAnonymousNamesMenuText, "Upgrade to unlock more features.", new[] { "Restore original file names", "Manage anonymous encrypted files",  "Protect file identity securely", "Unlock advanced privacy features"});
                    return;
                }

                appSettingsViewModel.RestoreRename(e);
                break;

            case "import-public-key":
                await ProfileViewModel!.HandleImportAndExportKeys(KeyManagement.ImportSomeonesSharingKey);
                break;

            case "export-axcryptid-public-key":
                await ProfileViewModel!.HandleImportAndExportKeys(KeyManagement.ExportAxCryptIDAndSharingKeyPair);
                break;

            case "export-public-key":
                await ProfileViewModel!.HandleImportAndExportKeys(KeyManagement.ExportMySharingKey);
                break;

            case "activity-logs":
                ProfileViewModel!.OnOpenLogViewerClicked(Utility.LogType.FileActivity);
                break;

            case "find-files":
                if (!appSettingsViewModel.EnableFindFilesMenuOption)
                {
                    paidFeaturegateService.ShowPaidGate(Texts.FindFileFeatureTitle, "Upgrade to unlock more features.", new[] { "Unlimited files", "Priority support", "Advanced algorithms" });
                    return;
                }

                Navigation.NavigateTo("/findfiles");
                break;

            default:
                break;
        }
    }

    private IEnumerable<ToolGroup> FilteredGroups
    {
        get
        {
            return string.IsNullOrWhiteSpace(SearchQuery)
                ? ActiveToolGroups
                : ActiveToolGroups
                    .Select(g => new ToolGroup
                    {
                        Name = g.Name,
                        Tools = g.Tools.Where(t =>
                            t.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                            t.Description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).ToList()
                    })
                    .Where(g => g.Tools.Any());
        }
    }

    // ── Tool Data ───────────────────────────────

    private IEnumerable<ToolGroup> ActiveToolGroups
    {
        get
        {
            return ToolGroups.Where(tg => tg.IsEnable)
                .Select(g => new ToolGroup
                {
                    Name = g.Name,
                    Tools = g.Tools.Where(t => t.IsEnable).ToList()
                })
                .Where(g => g.Tools.Any());
        }
    }

