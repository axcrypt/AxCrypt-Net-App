                <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                <label for="userEmail">@appSettingsViewModel.EmailLabel</label>
                <input type="text" id="timeout" class="form-control" readonly value="Timestamp: @appSettingsViewModel.CreatedTime">
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-large" @onclick="(e) => appSettingsViewModel.ChangePassphraseButton_Click(e)" style="width: max-content; max-width: 165px;">
                    @Texts.ChangePassphraseDialogTitle
                </button>
                <button class="button font-medium success btn-large" @onclick="appSettingsViewModel.CloseManageAxCryptID">@Texts.ButtonCloseText</button>
            </div>
        </div>
    </div>
}

<AxCrypt.App.Shared.Desktop.Components.PopupDialog.InvitePopup />
<AxCrypt.App.Shared.Desktop.Components.PopupDialog.ConfirmWipeDialog />

@code {
    private string SearchQuery { get; set; } = string.Empty;
    private ToolItem? ActiveTool { get; set; }

    /// <summary>
    /// Optional deep-link target supplied from the <c>?tool=</c> query string
    /// by the Tools page. Lets global search open a specific tool directly.
    /// </summary>
    [Parameter] public string? Tool { get; set; }

    // Guards OnParametersSet so a deep-linked tool runs its action exactly
    // once — not on every re-render.
    private string? _activatedTool;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        appSettingsViewModel.Initialized();
        // Toggling Find Files / User Activities / Debug Mode in the
        // Advanced Options popup needs to flip Tools-page row state
        // immediately. Listen for the app-wide UI tick.
        LogOnViewModel.OnUIStateChanged += OnAppUiStateChanged;
    }

    private void OnAppUiStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LogOnViewModel.OnUIStateChanged -= OnAppUiStateChanged;
    }
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (string.IsNullOrWhiteSpace(Tool) || Tool == _activatedTool)
        {
            return;
        }

        _activatedTool = Tool;

        ToolItem? target = ToolGroups
            .SelectMany(g => g.Tools)
            .FirstOrDefault(t => t.Id == Tool);

        if (target != null)
        {
            await SelectTool(new Microsoft.AspNetCore.Components.Web.MouseEventArgs(), target);
        }
    }

    // ── Secure Delete state ─────────────────────
    private bool IsDragging { get; set; }
    private bool ToolFilesQueued { get; set; }
    private int SelectedPassCount { get; set; } = 3;
    private void BrowseFiles() { ToolFilesQueued = true; }
    private void OnFileDrop() { IsDragging = false; ToolFilesQueued = true; }

    // ── Anonymous Rename state ──────────────────
    private string SelectedRenamePattern { get; set; } = "uuid";
    private bool KeepExtension { get; set; } = true;
    private string RenameExample => SelectedRenamePattern switch
    {
        "uuid" => "3f7a-b21c-9e84.xlsx",
