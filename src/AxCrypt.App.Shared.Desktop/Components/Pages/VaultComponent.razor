@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve;

@inject VaultViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject FileDropService FileDropService
@inject AppSettingsViewModel AppSettingsViewModel

<div class="vlt-header">
    <a href="/" class="vault-back-link"><img class="Ico-LeftArrow" />@Texts.BackToHomeText</a>
</div>

<div class="vlt-body" @onclick="async () => await HideContextMenu()">
    <div class="vlt-title-action">
        <div class="page-title" style="margin-bottom:0;">
            <h1>@Texts.VaultText</h1>
        </div>
        <div style="display:flex; gap:20px;">
            <button class="vault-share-key-btn" style="min-width: 125px;text-align: center;" @onclick="async (e) => await ViewModel.VaultFolderKeySharing()">
                <img class="shrks-act" style="max-height: 20px;" alt="vault_share_icon">
                <span class="font-medium">@Texts.ShareKeysToolStripMenuItemText</span>
            </button>
            <button class="button success border" style="min-width: 125px;text-align: center;" @onclick="(e) => AppSettingsViewModel.ToggleVaultSettings()">
                <img class="" src="/images/vltsett.svg" alt="vault_settings_icon">
                <span class="font-medium grey-clr">@Texts.VaultSettingsTitle</span>
            </button>
        </div>
    </div>

    <div class="vlt-search-add">
        <div class="vlt-search">
            <input id="searchKeyword"
                   name="searchKeyword"
                   type="text"
                   @bind="searchText"
                   @oninput="async (eargs) => await OnSearchChanged(eargs)"
                   placeholder="Search" />

            <div class="search-btn"
                 alt="search" @onclick="() => ViewModel.FilterVaultFiles(searchText)">
                <img class="ico-vault-search" alt="search-icon" />
            </div>
        </div>

        <div class="vlt-add dropdown">
            <div class="action-button-vault">
                <input class="vlt-btn-add" type="button" value="@Texts.AddPromptText" />
            </div>
            <div class="dropdown-content" style="margin-top: 50px;">
                <a style="color:#69a051" @onclick="() => ViewModel.AddVaultFiles()">@Texts.FileFilterFileTypeFiles</a>
                <a style="color:#69a051" @onclick="() => ViewModel.AddVaultFolder()">@Texts.ColumnFolderHeader</a>
            </div>
        </div>

    </div>
    <div class="vlt-content-area" style="position: relative; overflow-x: hidden; overflow-y: auto;">
        @if (ViewModel.VaultItemList.Any())
        {
            <div class="vlt-list-folder">
                <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
                <div class="vlt-header-bar">
                    @if (isListView)
                    {
                        <div class="div-list-header">
                            <span>@Texts.NameLabel</span>
                            <span>@Texts.FileSizeColumnHeaderText</span>
                            <span>@Texts.LastModifiedTimeColumnHeaderText</span>
                        </div>
                    }
                    else
                    {
                        <div class="div-grid-header">
                            <span>@Texts.NameLabel</span>
                        </div>
                    }

                    <div class="display-type">
                        <img style="background: rgba(0, 0, 0, 0); filter: brightness(0);" class="@((isListView ? "selected" : "")) Ico-List"
                             @onclick="() => SetView(true)"
                             alt="List View" />

                        <img class="@((!isListView ? "selected" : "")) Ico-Grid"
                             @onclick="() => SetView(false)"
                             alt="Grid View" />

                    </div>
                </div>
                <div class="@(isListView ? "list-view-div" : "grid-view-div") @(ViewModel.isfileselected ? "prev-grid" : "")" @onclick="async () => await HideContextMenu()" @oncontextmenu="@(async e => await ShowContextMenu(e, "", "", "create"))">
                    <ul class="vlt-file-list @(isListView ? "list-view" : "grid-view")">
                        @foreach (VaultItem file in ViewModel.VaultItemList)
                        {
                            string filename = System.IO.Path.GetFileName(file.Filepath);
                            <li class="file-list-item  @(ViewModel.SelectedFilePath == file.Filepath ? "selected" : "")" @ondblclick="() => OnItemDoubleClick(file)"
                                @oncontextmenu="@(async e => await ShowContextMenu(e, filename, file.Filepath, file.FileType))" @oncontextmenu:stopPropagation
                                @onclick="async () => await SelectFile(file.FileType, filename, file.Filepath, file.Size)">
                                <div class="file-details">
                                    <span class="file-img-det">
                                        <img alt="File Icon" class="list-file-icon @(file.FileType == "folder" ? "Icon-folder" : "Icon-file")" />
                                        <span class="file-name">@((MarkupString)HighlightMatch(filename))</span>
                                    </span>
                                    @if (isListView)
                                    {
                                        <span>@file.Size</span>
                                        <span>@file.ModifiedDate</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    @if (!isListView && ViewModel.isfileselected)
                    {
                        <div class="detail-section" @oncontextmenu:stopPropagation>
                            @if (ViewModel.IsFolder)
                            {
                                <img alt="Preview" class="detail-image Icon-folder" />
                                <span class="detail-label">@Texts.ColumnFolderHeader @Texts.NameLabel</span>
                            }
                            else
                            {
                                <img alt="Preview" class="detail-image Icon-file" />
                                <span class="detail-label">@Texts.FilePropertiesFileNameToolStripMenuItem</span>
                                
                            }
                            <span class="fil-fol-detail">@ViewModel.SelectedFile</span>
                            @if (!ViewModel.IsFolder)
                            {
                                <span class="detail-label">@Texts.FileSizeColumnHeaderText</span>
                                <span class="fil-fol-detail">@ViewModel.SelectedFileSize</span>
                            }
                            <span class="detail-label">@Texts.PathText</span>
                            <span class="fil-fol-detail">@ViewModel.SelectedFilePath</span>
                        </div>
                    }
                </div>


                @if (contextMenuType == "file" && !String.IsNullOrEmpty(ViewModel.SelectedFilePath))
                {
                    <div class="context-menu-action" style="position:absolute; top:@(contextMenuY)px; left:@(contextMenuX)px;">
                        <span class="menu-item" @onclick='() => ViewModel.PrepareFileActionAsync("Open")'>@Texts.RecentFilesOpenToolStripMenuItemText</span>
                        <span class="menu-item" @onclick="async () => await ViewModel.DecryptVaultFileAsync()">@Texts.DecryptToolStripMenuItemText</span>
                        <span class="menu-item" @onclick='() => ViewModel.PrepareFileActionAsync("Reveal")'>@Texts.ShowInFolderText</span>
                        <span class="menu-item" @onclick='() => ViewModel.PrepareFileActionAsync("RenameAnonymously")'>@Texts.AnonymousRenameMenuText</span>
                        <span class="menu-item" @onclick='() => ViewModel.PrepareFileActionAsync("RenameOriginal")'>@Texts.RestoreAnonymousNamesMenuText</span>
                    </div>
                }
                else if (contextMenuType == "folder")
                {
                    <div class="context-menu-action" style="position: absolute; top:@(contextMenuY)px; left:@(contextMenuX)px;">
                        <span class="menu-item" @onclick="async () => await ViewModel.DecryptVaultfolder()">@Texts.DecryptToolStripMenuItemText</span>
                        <span class="menu-item" @onclick='() => ViewModel.FolderActionReveal()'>@Texts.ShowInFolderText</span>
                        <span class="menu-item" @onclick="() => CreateNewFolder(ViewModel.SelectedFilePath)">@Texts.CreateNewFolderText</span>
                    </div>
                }
                else if (contextMenuType == "create")
                {
                    <div class="context-menu-action" style="position: absolute; top:@(contextMenuY)px; left:@(contextMenuX)px;">
                        <span class="menu-item" @onclick="() => CreateNewFolder(ViewModel.CurrentFolder)">@Texts.CreateNewFolderText</span>
                        <span class="menu-item" @onclick="() => ViewModel.AddVaultFolder()">@Texts.AddNewFolderText</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="vlt-empty">
                @if (ViewModel.IsProcessing)
                {
                    <img class="vlt-img-process" title="Vault process" />
                }
                else
                {
                    <img class="vlt-img-empty" title="Emtpy Vault" />
                    <p>@Texts.VaultDrogDropText</p>
                }
            </div>
        }
        <div class="vlt-footer">
            <nav class="breadcrumb">
                @if (ViewModel.VaultBreadCrumb.Count > 4)
                {
                    <span class="breadcrumb-part">
                        .../
                    </span>
                    <span class="separator"><img class="icon-next-arrow" /><img class="icon-dltfold" /> </span>
                }

                @foreach ((string name, string path) in ViewModel.VaultBreadCrumb.TakeLast(4))
                {
                    <span class="breadcrumb-part" title="@path" @onclick="() => Openfolder(path)">
                        @name
                    </span>

                    @if (path != ViewModel.VaultBreadCrumb.Last().Path)
                    {
                        <span class="separator"><img class="icon-next-arrow" /><img class="icon-dltfold" /> </span>
                    }
                }
            </nav>
        </div>


    </div>
    <script>
        window.scrollToFirstMatch = function () {
            const el = document.getElementById("firstMatch");
            if (el) {
                el.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        };

        window.getElementRect = (selector) => {
            const el = document.querySelector(selector);
            if (!el) return null;

            const rect = el.getBoundingClientRect();
            return {
                top: rect.top,
                left: rect.left,
                bottom: rect.bottom,
                height: rect.height,
                width: rect.width,
                scrollTop: el.scrollTop,
                scrollLeft: el.scrollLeft
            };
        };

        window.getWindowHeight = () => window.innerHeight;
    </script>

</div>


@if (ViewModel.CreateNewFolder)
{
    <div id="vault-settings-modalDialog" class="vault-body modalDialog">
        <div class="">
            <span class="vault-question">@Texts.FolderNameLabel</span>
            <div class="vault-new-folder">
                <input class="input1" type="text" id="text-box" maxlength="50" name="" @bind-value="ViewModel.SelectedSubFolderPath">
                <span>@ViewModel.ErrorMessage</span>
            </div>
            <div style="text-align:center;margin:20px;">
                <input type="button" class="input2 onbutton-confirm" id="fbox" value="Confirm" name="" @onclick="async () => await ViewModel.CreateVaultFolder(ViewModel.ParentFolderPath)" />
                <input type="button" class="input1 onbuttom-cancel" id="sbox" value="Cancel" name="" @onclick="() => CloseCreateNewFolderPopUp()" />
            </div>
        </div>
    </div>
}

<AxCrypt.App.Shared.Desktop.Components.Home.ShareKeyComponent />

@code {
    private bool isListView { get; set; } = true;
    private double contextMenuX { get; set; }
    private double contextMenuY { get; set; }
    private string flipContextMenu { get; set; } = "top left";
    private string flipTransform { get; set; } = "translateY(0)";
    private double contextMenuHeight { get; set; } = 210;
    private double contextMenuWidth { get; set; } = 180;

    private string searchText = string.Empty;
    private string contextMenuType = "";

    protected override void OnInitialized()
    {
        ViewModel.OnUpdateViewState += async () => await UpdateUIState();
        ViewModel.InitialUpdate();
        ViewModel.LoadVaultItems();

        FileDropService.ResetOnDropped();
        FileDropService.OnFoldersDropped += async (folders) => await HandleDroppedFolders(folders);
        FileDropService.OnFilesDropped += async (files) => await HandleDroppedFiles(files);

        base.OnInitialized();
    }

    private void SetView(bool listView)
    {
        isListView = listView;
        ViewModel.isfileselected = false;
        contextMenuType = "";
    }

    private void Openfolder(string folderpath)
    {
        ViewModel.CurrentFolder = folderpath;
        ViewModel.LoadVaultItems();
    }

    private async Task ShowContextMenu(MouseEventArgs e, string fileName, string filePath, string selectedFolder)
    {
        ElementRect container = await JSRuntime.InvokeAsync<ElementRect>("getElementRect", ".vlt-content-area");

        contextMenuX = e.ClientX - container.Left + container.ScrollLeft;
        contextMenuY = e.ClientY - container.Top + container.ScrollTop;

        if (contextMenuX + contextMenuWidth > container.Width)
        {
            contextMenuX = container.Width - contextMenuWidth - 10;
        }

        double maxVisibleHeight = container.Height - 40;
        if (contextMenuY + contextMenuHeight > maxVisibleHeight)
        {
            contextMenuY = maxVisibleHeight - contextMenuHeight - 10;
        }

        contextMenuX = Math.Max(0, contextMenuX);
        contextMenuY = Math.Max(0, contextMenuY);

        contextMenuType = selectedFolder;

        if (selectedFolder == "create")
            return;

        flipContextMenu = "top left";
        flipTransform = "translateY(0)";

        if (selectedFolder != "create" && contextMenuY + contextMenuHeight > container.Height)
        {
            flipContextMenu = "bottom left";
            flipTransform = $"translateY(-{contextMenuHeight}px)";
        }

        ViewModel.SelectedFile = fileName;
        ViewModel.SelectedFilePath = filePath;
        await UpdateUIState();
    }

    private async Task SelectFile(string Type, string fileName, string filePath, string fileSize)
    {
        ViewModel.SelectedFile = fileName;
        ViewModel.SelectedFilePath = filePath;
        ViewModel.IsFolder = Type == "folder" ? true : false;
        ViewModel.SelectedFileSize = fileSize;
        ViewModel.isfileselected = true;
        await HideContextMenu();
    }

    private async Task HideContextMenu()
    {
        contextMenuType = "";
        await UpdateUIState();
    }

    private string HighlightMatch(string input)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return System.Net.WebUtility.HtmlEncode(input);

        string pattern = System.Text.RegularExpressions.Regex.Escape(searchText);
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        int matchCount = 0;
        string highlighted = regex.Replace(System.Net.WebUtility.HtmlEncode(input), match =>
        {
            matchCount++;
            string spanId = matchCount == 1 ? "id='firstMatch'" : "";
            return $"<span class=\"highlight\" {spanId}>{match.Value}</span>";
        });

        return highlighted;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        try
        {
            searchText = e.Value?.ToString() ?? "";
            await Task.Yield();
            await JSRuntime.InvokeVoidAsync("scrollToFirstMatch");
        }
        catch (Exception ex)
        {
            await New<IPopup>().ShowAsync(PopupButtons.Ok, Texts.MessageErrorTitle, ex.Message);
        }
    }

    async Task UpdateUIState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task HandleDroppedFolders(IList<string> folders)
    {
        PopupButtons click = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, Texts.WarningTitle, Texts.VaultWarningsFolderWillBeRemoved, DoNotShowAgainOptions.VaultDragDropWarning);
        if (click == PopupButtons.Cancel)
        {
            return;
        }

        await ViewModel.EncryptDroppedFolders(folders);
    }

    private async Task HandleDroppedFiles(IEnumerable<string> files)
    {
        PopupButtons click = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, Texts.WarningTitle, Texts.VaultWarningsFileWillBeRemoved, DoNotShowAgainOptions.VaultDragDropWarning);
        if (click == PopupButtons.Cancel)
        {
            return;
        }
        await ViewModel.EncryptDroppedFile(files);
    }

    private async Task OnItemDoubleClick(VaultItem file)
    {
        if (file.FileType == "folder")
        {
            Openfolder(file.Filepath);
            return;
        }

        string filename = System.IO.Path.GetFileName(file.Filepath);
        await SelectFile(file.FileType, filename, file.Filepath, file.Size!);
        await ViewModel.PrepareFileActionAsync("Open");
    }

    private void CreateNewFolder(string folderPath)
    {
        if (string.IsNullOrEmpty(folderPath))
            return;

        ViewModel.ErrorMessage = "";
        ViewModel.CreateNewFolder = true;
        ViewModel.ParentFolderPath = folderPath;
    }

    private void CloseCreateNewFolderPopUp()
    {
        ViewModel.CreateNewFolder = false;
        ViewModel.SelectedSubFolderPath = "";
    }

    public class ElementRect
    {
        public double Top { get; set; }
        public double Left { get; set; }
        public double Bottom { get; set; }
        public double Height { get; set; }
        public double Width { get; set; }
        public double ScrollTop { get; set; }
        public double ScrollLeft { get; set; }
    }
}
