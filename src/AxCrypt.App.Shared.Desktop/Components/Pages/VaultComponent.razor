@implements IDisposable
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core.IO
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve;

@inject VaultViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject FileDropService FileDropService
@inject AppSettingsViewModel AppSettingsViewModel

@if (!ViewModel.IsVaultConfigured)
{
    <div class="page-content-body-section vlt-body">
        <div class="vlt-empty vlt-empty--not-configured">
            <img class="vlt-img-empty" title="Empty Vault" />
            <p>No folder has been configured as a Vault. Please configure Vault folder and try again.</p>
            <button class="vlt-action-button vlt-action-button--secondary"
                    @onclick="(e) => AppSettingsViewModel.ToggleVaultSettings()">
                <img class="vlt-icon" alt="vault_icon">
                <span>@Texts.VaultSettingsTitle</span>
            </button>
        </div>
    </div>
}
else
{
    <div class="page-content-body-section vlt-body">

        @* ── Compact toolbar: search + add + share + settings ── *@
        <div class="vlt-toolbar">

            @* Search *@
            <div class="vlt-search">
                <svg class="vlt-search-icon" width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input id="searchKeyword" name="searchKeyword" type="text"
                       class="vlt-search-input"
                       @bind="searchText"
                       @oninput="async eargs => await OnSearchChanged(eargs)"
                       placeholder="@Texts.SearchText" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <button type="button" class="vlt-search-clear"
                            @onclick="() => { searchText = string.Empty; ViewModel.FilterVaultFiles(string.Empty); }">×</button>
                }
            </div>

            @* Add dropdown *@
            <div class="vlt-add @(isAddMenuOpen ? "vlt-add--open" : "")" @onclick:stopPropagation="true">
                <button class="vlt-tb-btn vlt-tb-btn--primary" type="button"
                        aria-haspopup="menu" aria-expanded="@isAddMenuOpen"
                        @onclick="ToggleAddMenu">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    @Texts.AddPromptText
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" aria-hidden="true"
                         class="vlt-tb-caret @(isAddMenuOpen ? "vlt-tb-caret--open" : "")">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                @if (isAddMenuOpen)
                {
                    <div class="vlt-add-menu" role="menu" @onclick:stopPropagation="true">
                        <button type="button" role="menuitem" @onclick="AddVaultFiles">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            @Texts.FileFilterFileTypeFiles
                        </button>
                        <button type="button" role="menuitem" @onclick="AddVaultFolder">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
                            </svg>
                            @Texts.ColumnFolderHeader
                        </button>
                    </div>
                }
            </div>

            @* Share Keys *@
            <button class="vlt-tb-btn vault-share-key-btn"
                    @onclick="async e => await ViewModel.VaultFolderKeySharing()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="7.5" cy="15.5" r="3.5"/>
                    <path d="M10 13l10-10"/>
                    <path d="M17 6l3 3"/>
                    <path d="M14 9l3 3"/>
                </svg>
                @Texts.ShareKeysToolStripMenuItemText
            </button>

            @* Settings icon button *@
            <button class="vlt-tb-btn vlt-tb-btn--icon"
                    title="@Texts.VaultSettingsTitle"
                    aria-label="@Texts.VaultSettingsTitle"
                    @onclick="e => AppSettingsViewModel.ToggleVaultSettings()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
            </button>

        </div>

        <div class="vlt-main">
            <div class="vlt-content-area @(DropZoneActive ? "recent-files-card--dropping" : "")">
                @if (DropZoneActive)
                {
                    <div class="rf-drop-hint">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                        <span>Drop files/folders here to encrypt</span>
                    </div>
                }
                @if (ViewModel.VaultItemList.Any())
                {
                    <div class="vlt-list-folder">
                        <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
                        <div class="vlt-header-bar">
                            @if (isListView)
                            {
                                <div class="div-list-header">
                                    <span></span>
                                    <span>@Texts.NameLabel</span>
                                    <span>@Texts.FileSizeColumnHeaderText</span>
                                    <span>@Texts.LastModifiedTimeColumnHeaderText</span>
                                    <span class="vlt-actions-head" aria-hidden="true"></span>
                                </div>
                            }
                            else
                            {
                                <div class="div-grid-header">
                                    <span>@Texts.NameLabel</span>
                                </div>
                            }

                            <div class="display-type" aria-label="Vault view mode">
                                <img class="@((isListView ? "selected" : "")) Ico-List" @onclick="() => SetView(true)"
                                     alt="List View" />

                                <img class="@((!isListView ? "selected" : "")) Ico-Grid" @onclick="() => SetView(false)"
                                     alt="Grid View" />

                            </div>
                        </div>
                        <div class="@(isListView ? "list-view-div" : "grid-view-div")"
                             @onclick="async () => await CloseMenus()">
                            <ul class="vlt-file-list @(isListView ? "list-view" : "grid-view")">
                                @foreach (VaultItem file in ViewModel.VaultItemList)
                                {
                                    string filename = System.IO.Path.GetFileName(file.Filepath);
                                    bool isChecked = _selectedPaths.Contains(file.Filepath);
                                    <li class="file-list-item @(ViewModel.SelectedFilePath == file.Filepath ? "selected" : "") @(isChecked ? "vlt-row--checked" : "")"
                                        @ondblclick="() => OnItemDoubleClick(file)"
                                        @oncontextmenu="async () => await SelectFile(file.FileType, filename, file.Filepath, file.Size)"
                                        @oncontextmenu:preventDefault="true"
                                        @oncontextmenu:stopPropagation
                                        @onclick="async () => await OnRowClick(file, filename)">
                                        <div class="file-details">
                                            @* Checkbox — files only; folders not selectable for batch ops *@
                                            @if (file.FileType != "folder")
                                            {
                                                <input type="checkbox"
                                                       class="vlt-row-check"
                                                       checked="@isChecked"
                                                       @onchange="() => ToggleSelection(file.Filepath)"
                                                       @onclick:stopPropagation="true" />
                                            }
                                            else
                                            {
                                                <span class="vlt-row-check vlt-row-check--hidden"></span>
                                            }
                                            <span class="file-img-det">
                                                <img alt="File Icon"
                                                     class="list-file-icon @(file.FileType == "folder" ? "Icon-folder" : "Icon-file")" />
                                                <span class="file-name">@((MarkupString)HighlightMatch(filename))</span>
                                            </span>
                                            @if (isListView)
                                            {
                                                <span>@file.Size</span>
                                                <span>@file.ModifiedDate</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>


                    </div>
                }
                else
                {
                    <div class="vlt-empty">
                        @if (ViewModel.IsProcessing)
                        {
                            <img class="vlt-img-process" title="Vault process" />
                        }
                        else
                        {
                            <img class="vlt-img-empty" title="Empty Vault" />
                            <p>@Texts.VaultDrogDropText</p>
                        }
                    </div>
                }
                <div class="vlt-footer">
                    <nav class="breadcrumb">
                        @if (ViewModel.VaultBreadCrumb.Count > 4)
                        {
                            <span class="breadcrumb-part">
                                .../
                            </span>
                            <span class="separator"><img class="icon-next-arrow" /><img class="icon-dltfold" /> </span>
                        }

                        @foreach ((string name, string path) in ViewModel.VaultBreadCrumb.TakeLast(4))
                        {
                            <span class="breadcrumb-part" title="@path" @onclick="() => Openfolder(path)">
                                @name
                            </span>

                            @if (path != ViewModel.VaultBreadCrumb.Last().Path)
                            {
                                <span class="separator"><img class="icon-next-arrow" /><img class="icon-dltfold" /> </span>
                            }
                        }
                    </nav>
                </div>

                @* ── Action bar ──────────────────────────────────────────────── *@
                @if (_selectedPaths.Any())
                {
                    @* Multi-select (checkbox) — batch actions *@
                    <div class="cbp-actionbar vlt-actionbar" role="region" aria-label="Bulk actions">
                        <span class="cbp-actionbar-count">@_selectedPaths.Count selected</span>
                        <button type="button" class="cbp-btn cbp-btn--ghost"
                                @onclick="ClearVaultSelection">
                            @Texts.ClearButtonText
                        </button>
                        <span class="cbp-actionbar-spacer"></span>
                        <button type="button" class="cbp-btn cbp-btn--ghost"
                                @onclick="async () => await BatchRenameAsync()">
                            @Texts.AnonymousRenameMenuText
                        </button>
                        <button type="button" class="cbp-btn cbp-btn--ghost"
                                @onclick="async () => await BatchRestoreRenameAsync()">
                            @Texts.RestoreAnonymousNamesMenuText
                        </button>
                        <button type="button" class="cbp-btn cbp-btn--primary"
                                @onclick="async () => await BatchDecryptAsync()">
                            @Texts.DecryptToolStripMenuItemText
                        </button>
                    </div>
                }
                else if (ViewModel.isfileselected && !string.IsNullOrEmpty(ViewModel.SelectedFilePath))
                {
                    @* Single file or folder selected (click / right-click) *@
                    <div class="cbp-actionbar vlt-actionbar" role="region" aria-label="File actions">
                        <span class="cbp-actionbar-file" title="@ViewModel.SelectedFilePath">
                            @ViewModel.SelectedFile
                        </span>
                        <span class="cbp-actionbar-spacer"></span>
                        @if (!ViewModel.IsFolder)
                        {
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick='async () => await RunFileAction("Open")'>
                                @Texts.RecentFilesOpenToolStripMenuItemText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick="async () => await DecryptVaultFile()">
                                @Texts.DecryptToolStripMenuItemText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick='async () => await RunFileAction("Reveal")'>
                                @Texts.ShowInFolderText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick='async () => await RunFileAction("RenameAnonymously")'>
                                @Texts.AnonymousRenameMenuText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--primary"
                                    @onclick='async () => await RunFileAction("RenameOriginal")'>
                                @Texts.RestoreAnonymousNamesMenuText
                            </button>
                        }
                        else
                        {
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick="async () => await DecryptVaultFolder()">
                                @Texts.DecryptToolStripMenuItemText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--ghost"
                                    @onclick="async () => await RevealVaultFolder()">
                                @Texts.ShowInFolderText
                            </button>
                            <button type="button" class="cbp-btn cbp-btn--primary"
                                    @onclick="async () => await CreateNewFolderFromMenu(ViewModel.SelectedFilePath)">
                                @Texts.CreateNewFolderText
                            </button>
                        }
                    </div>
                }
                else
                {
                    @* Nothing selected *@
                    <div class="cbp-actionbar cbp-actionbar--idle vlt-actionbar">
                        <span class="cbp-actionbar-hint">@Texts.VaultDrogDropText</span>
                    </div>
                }


            </div>
        </div>
        <script>
                window.scrollToFirstMatch = function () {
                    const el = document.getElementById("firstMatch");
                    if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
                };
        </script>

    </div>

    @if (ViewModel.CreateNewFolder)
    {
        <div id="vault-settings-modalDialog" class="vault-body modalDialog">
            <div class="">
                <span class="vault-question">@Texts.FolderNameLabel</span>
                <div class="vault-new-folder">
                    <input class="input1" type="text" id="text-box" maxlength="50" name=""
                           @bind-value="ViewModel.SelectedSubFolderPath">
                    <span>@ViewModel.ErrorMessage</span>
                </div>
                <div style="text-align:center;margin:20px;">
                    <input type="button" class="input2 onbutton-confirm" id="fbox" value="Confirm" name=""
                           @onclick="async () => await ViewModel.CreateVaultFolder(ViewModel.ParentFolderPath)" />
                    <input type="button" class="input1 onbuttom-cancel" id="sbox" value="Cancel" name=""
                           @onclick="() => CloseCreateNewFolderPopUp()" />
                </div>
            </div>
        </div>
    }

    <AxCrypt.App.Shared.Desktop.Components.Home.ShareKeyComponent />

}
@code {
    private bool isListView { get; set; } = true;
    private bool DropZoneActive { get; set; }

    // ── Multi-select state (mirrors cbp SelectedFiles pattern) ──────
    private readonly HashSet<string> _selectedPaths = new();

    private void ToggleSelection(string filepath)
    {
        if (!_selectedPaths.Remove(filepath))
            _selectedPaths.Add(filepath);
    }

    private void ClearVaultSelection()
    {
        _selectedPaths.Clear();
        StateHasChanged();
    }

    private async Task BatchDecryptAsync()
    {
        await ViewModel.BatchDecryptVaultFilesAsync(_selectedPaths.ToList());
        ClearVaultSelection();
    }

    private async Task BatchRenameAsync()
    {
        // Reveal the first selected file — revealing multiple Explorer
        // windows for each would be disruptive.
        string? first = _selectedPaths.FirstOrDefault();
        if (first != null)
        {
            ViewModel.SelectedFilePath = first;
            ViewModel.SelectedFile = System.IO.Path.GetFileName(first);
            await ViewModel.PrepareFileActionAsync("RenameAnonymously");
        }
        ClearVaultSelection();
    }

    private async Task BatchRestoreRenameAsync()
    {
        if (_selectedPaths.Any())
        {
            ViewModel.SelectedFilePath = _selectedPaths.First();
            ViewModel.SelectedFile = System.IO.Path.GetFileName(_selectedPaths.First());
            await ViewModel.PrepareFileActionAsync("RenameOriginal");
        }

        ClearVaultSelection();
    }
    private bool isAddMenuOpen { get; set; }
    private string searchText = string.Empty;

    // Stored delegate references for clean removal in Dispose(). All
    // backing events are Action variants (Action, Action<IList<string>>),
    // so the field types match them exactly — we fire-and-forget the
    // async handlers inside the lambdas. Each Handle*() method awaits
    // its own UI marshalling so the discarded Task is safe.
    private Action? _onUpdateViewState;
    private Action<IList<string>>? _onFoldersDropped;
    private Action<IList<string>>? _onFilesDropped;
    private Action? _onFilesDraggedOver;
    private Action? _onFilesDragLeave;

    protected override async Task OnInitializedAsync()
    {
        _onUpdateViewState = () => _ = UpdateUIState();
        ViewModel.OnUpdateViewState += _onUpdateViewState;

        await ValidateVaultPath();

        FileDropService.ResetOnDropped();
        _onFoldersDropped   = (folders) => _ = HandleDroppedFolders(folders);
        _onFilesDropped     = (files)   => _ = HandleDroppedFiles(files);
        _onFilesDraggedOver = () => _ = HandleDraggedOverFiles();
        _onFilesDragLeave   = () => _ = HandleDragLeave();

        FileDropService.OnFoldersDropped  += _onFoldersDropped;
        FileDropService.OnFilesDropped    += _onFilesDropped;
        FileDropService.OnFilesDraggedOver += _onFilesDraggedOver;
        FileDropService.OnFilesDragLeave  += _onFilesDragLeave;

        base.OnInitialized();
    }

    public void Dispose()
    {
        if (_onUpdateViewState != null)
        {
            ViewModel.OnUpdateViewState -= _onUpdateViewState;
            _onUpdateViewState = null;
        }
        if (_onFoldersDropped != null) { FileDropService.OnFoldersDropped -= _onFoldersDropped; _onFoldersDropped = null; }
        if (_onFilesDropped != null)   { FileDropService.OnFilesDropped   -= _onFilesDropped;   _onFilesDropped = null; }
        if (_onFilesDraggedOver != null) { FileDropService.OnFilesDraggedOver -= _onFilesDraggedOver; _onFilesDraggedOver = null; }
        if (_onFilesDragLeave != null)   { FileDropService.OnFilesDragLeave   -= _onFilesDragLeave;   _onFilesDragLeave = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (!New<IDataContainer>(ViewModel.CurrentFolder.Normalize()).IsAvailable)
        {
            ViewModel.VaultItemList = new List<VaultItem>();

            await New<IPopup>().ShowAsync(PopupButtons.Ok, Texts.MessageErrorTitle, "Your vault folder is currently unavailable. <br/><br/>It may have been moved or deleted. Please check the folder location or choose a different vault.");
            return;
        }

        if (firstRender)
        {
            ViewModel.CurrentFolder = ViewModel.VaultBasePath;
            ViewModel.LoadVaultItems();
        }
    }

    private void SetView(bool listView)
    {
        isListView = listView;
        ViewModel.isfileselected = false;
        isAddMenuOpen = false;
        _selectedPaths.Clear();
    }

    private void Openfolder(string folderpath)
    {
        ViewModel.CurrentFolder = folderpath;
        ViewModel.LoadVaultItems();
    }

    private async Task OnRowClick(VaultItem file, string filename)
    {
        await SelectFile(file.FileType, filename, file.Filepath, file.Size);
        if (file.FileType != "folder")
            ToggleSelection(file.Filepath);
    }

    private async Task SelectFile(string Type, string fileName, string filePath, string fileSize)
    {
        ViewModel.SelectedFile = fileName;
        ViewModel.SelectedFilePath = filePath;
        ViewModel.IsFolder = Type == "folder";
        ViewModel.SelectedFileSize = fileSize;
        ViewModel.isfileselected = true;
        isAddMenuOpen = false;
        await UpdateUIState();
    }

    private async Task CloseMenus()
    {
        isAddMenuOpen = false;
        await UpdateUIState();
    }

    private void ToggleAddMenu()
    {
        isAddMenuOpen = !isAddMenuOpen;
    }

    private async Task AddVaultFiles()
    {
        isAddMenuOpen = false;
        ViewModel.AddVaultFiles();
        await UpdateUIState();
    }

    private async Task AddVaultFolder()
    {
        isAddMenuOpen = false;
        ViewModel.AddVaultFolder();
        await UpdateUIState();
    }

    private async Task RunFileAction(string action)
    {
        await ViewModel.PrepareFileActionAsync(action);
        await UpdateUIState();
    }

    private async Task DecryptVaultFile()
    {
        await ViewModel.DecryptVaultFileAsync();
        await UpdateUIState();
    }

    private async Task DecryptVaultFolder()
    {
        await ViewModel.DecryptVaultfolder();
        await UpdateUIState();
    }

    private async Task RevealVaultFolder()
    {
        ViewModel.FolderActionReveal();
        await UpdateUIState();
    }

    private async Task CreateNewFolderFromMenu(string folderPath)
    {
        CreateNewFolder(folderPath);
        await UpdateUIState();
    }

    private string HighlightMatch(string input)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return System.Net.WebUtility.HtmlEncode(input);

        string pattern = System.Text.RegularExpressions.Regex.Escape(searchText);
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern,
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        int matchCount = 0;
        string highlighted = regex.Replace(System.Net.WebUtility.HtmlEncode(input), match =>
        {
            matchCount++;
            string spanId = matchCount == 1 ? "id='firstMatch'" : "";
            return $"<span class=\"highlight\" {spanId}>{match.Value}</span>";
        });

        return highlighted;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        try
        {
            searchText = e.Value?.ToString() ?? "";
            await Task.Yield();
            await JSRuntime.InvokeVoidAsync("scrollToFirstMatch");
        }
        catch (Exception ex)
        {
            await New<IPopup>().ShowAsync(PopupButtons.Ok, Texts.MessageErrorTitle, ex.Message);
        }
    }

    async Task UpdateUIState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    // ═══════════════════════════════════════════
    //  Drop zone
    //
    //  FileDropService raises these events from the JS interop /
    //  drag-drop pipeline thread, not the renderer's
    //  SynchronizationContext. Every handler that touches DropZoneActive
    //  (a UI-bound flag the markup reads to swap classes) marshals onto
    //  the SC first via InvokeAsync. Without this the renderer could
    //  read a torn value or throw "current thread is not associated
    //  with the Dispatcher" on the StateHasChanged that follows.
    // ═══════════════════════════════════════════
    private async Task HandleDroppedFiles(IList<string> files)
    {
        await InvokeAsync(() =>
        {
            DropZoneActive = false;
            StateHasChanged();
        });

        if (!ViewModel.IsVaultConfigured)
        {
            return;
        }

        PopupButtons click = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, Texts.WarningTitle,
        Texts.VaultWarningsFileWillBeRemoved, DoNotShowAgainOptions.VaultDragDropWarning);
        if (click == PopupButtons.Cancel)
        {
            return;
        }
        await ViewModel.EncryptDroppedFile(files);
    }

    private async Task HandleDroppedFolders(IList<string> folders)
    {
        await InvokeAsync(() =>
        {
            DropZoneActive = false;
            StateHasChanged();
        });

        if (!ViewModel.IsVaultConfigured)
        {
            return;
        }

        PopupButtons click = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, Texts.WarningTitle,
        Texts.VaultWarningsFolderWillBeRemoved, DoNotShowAgainOptions.VaultDragDropWarning);

        if (click == PopupButtons.Cancel)
        {
            return;
        }

        await ViewModel.EncryptDroppedFolders(folders);
    }

    private async Task HandleDraggedOverFiles()
    {
        await InvokeAsync(() =>
        {
            DropZoneActive = true;
            StateHasChanged();
        });
    }

    private async Task HandleDragLeave()
    {
        await InvokeAsync(() =>
        {
            DropZoneActive = false;
            StateHasChanged();
        });
    }

    private async Task OnItemDoubleClick(VaultItem file)
    {
        if (file.FileType == "folder")
        {
            Openfolder(file.Filepath);
            return;
        }

        string filename = System.IO.Path.GetFileName(file.Filepath);
        await SelectFile(file.FileType, filename, file.Filepath, file.Size!);
        await ViewModel.PrepareFileActionAsync("Open");
    }

    private void CreateNewFolder(string folderPath)
    {
        if (string.IsNullOrEmpty(folderPath))
            return;

        ViewModel.ErrorMessage = "";
        ViewModel.CreateNewFolder = true;
        ViewModel.ParentFolderPath = folderPath;
    }

    private void CloseCreateNewFolderPopUp()
    {
        ViewModel.CreateNewFolder = false;
        ViewModel.SelectedSubFolderPath = "";
    }

    public async Task<bool> ValidateVaultPath()
    {
        if (string.IsNullOrEmpty(ViewModel.VaultBasePath))
        {
            AppSettingsViewModel.ToggleVaultSettings();
            return false;
        }

        if (!ViewModel.IsVaultConfigured)
        {
            PopupButtons result = await New<IPopup>().ShowAsync(
                PopupButtons.Ok,
                Texts.WarningTitle,
                Texts.VaultMisConfigured
            );

            if (result == PopupButtons.Ok)
                AppSettingsViewModel.ToggleVaultSettings();

            return false;
        }

        return true;
    }

}
