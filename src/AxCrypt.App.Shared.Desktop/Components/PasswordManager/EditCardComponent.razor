@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop
@using System.Globalization
@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.App.Shared.Utility

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject IJSRuntime jsRuntime

<div class="page-content-body-section">

    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    <div class="pm-form-shell">

        <div class="pm-form-header">
            <NavLink class="pm-form-back" href="viewcard" title="Cancel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </NavLink>
            <div class="pm-form-titles">
                <h2 class="pm-form-title">@Texts.EditCardTitle</h2>
                <p class="pm-form-sub">Update card details. Encrypts on save.</p>
            </div>
            <span class="pm-type-badge pm-type-badge--card" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
            </span>
        </div>

        <EditForm Model="@CardViewModel" OnValidSubmit="SavePassword">
            <DataAnnotationsValidator />

            <div class="pm-form-body">

                <div class="pm-form-row">
                    <label for="ec-desc">@Texts.DescriptionLabel</label>
                    <input id="ec-desc"
                           type="text"
                           class="pm-form-input"
                           maxlength="100000"
                           @bind="@CardViewModel.SecretDesc" />
                    <ValidationMessage For="@(() => CardViewModel.SecretDesc)" />
                </div>

                <div class="pm-form-row">
                    <label for="ec-number">@Texts.CardNumberPrompt</label>
                    <input id="ec-number"
                           type="text"
                           class="pm-form-input"
                           maxlength="19"
                           minlength="12"
                           @bind="@CardViewModel.CardNumber"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                    <ValidationMessage For="@(() => CardViewModel.CardNumber)" />
                </div>

                <div class="pm-form-row">
                    <label for="ec-name">@Texts.NameOnCardPrompt</label>
                    <input id="ec-name"
                           type="text"
                           class="pm-form-input"
                           @bind="@CardViewModel.NameOnCard" />
                    <ValidationMessage For="@(() => CardViewModel.NameOnCard)" />
                </div>

                <div class="pm-form-row">
                    <label for="ec-exp">@Texts.ExpirationDatePrompt</label>
                    <input id="ec-exp"
                           type="text"
                           class="pm-form-input"
                           placeholder="MM/YYYY"
                           @bind="@CardViewModel.ExpirationDate"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           @oninput="(e) => CardViewModel.OnExpirationDateInput(e)" />
                    <ValidationMessage For="@(() => CardViewModel.ExpirationDate)" />
                    @if (!string.IsNullOrEmpty(CardViewModel.ExpirationDateError))
                    {
                        <div style="color:#dc2626; font-weight:600; font-size:11.5px;">@CardViewModel.ExpirationDateError</div>
                    }
                </div>

                <div class="pm-form-row">
                    <label for="ec-cvv">@Texts.SecurityCodePrompt</label>
                    <input id="ec-cvv"
                           type="text"
                           class="pm-form-input"
                           maxlength="3"
                           @bind="@CardViewModel.SecurityCode"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           oninput="this.value = this.value.replace(/\D/g, '').substring(0, 3)" />
                    <ValidationMessage For="@(() => CardViewModel.SecurityCode)" />
                </div>
            </div>

            <div class="pm-form-footer">
                <NavLink href="viewcard" class="pm-btn pm-btn--ghost">
                    @Texts.ButtonCancelText
                </NavLink>
                <button type="submit" class="pm-btn pm-btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @Texts.ButtonSaveText
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    SecretCardViewModel? CardViewModel;

    protected override void OnInitialized()
    {
        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
            return;
        }

        SecretCardViewModel currentCardModel = secretService.CurrentSecret!.Card;
        CardViewModel = new SecretCardViewModel(currentCardModel.CardNumber, currentCardModel.SecretDesc!, currentCardModel.NameOnCard, currentCardModel.SecurityCode, currentCardModel.ExpirationDate);
        editSecretViewModel.Secret.SecretGuid = secretService.CurrentSecret!.SecretGuid;
    }

    private async Task OnAfterRenderAsync()
    {
        await jsRuntime.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        if (!CardViewModel.ValidateExpirationDate())
        {
            return;
        }

        editSecretViewModel.Secret.Card = CardViewModel;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            secretService.CurrentSecret!.Card = CardViewModel!;
            navigationManager.NavigateTo("/viewcard");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
    }
}
