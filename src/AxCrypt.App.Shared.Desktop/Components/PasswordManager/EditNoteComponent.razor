@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject IJSRuntime jsRuntime

<div class="page-content-body-section">

    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    <div class="pm-form-shell">

        <div class="pm-form-header">
            <NavLink class="pm-form-back" href="viewnote" title="Cancel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </NavLink>
            <div class="pm-form-titles">
                <h2 class="pm-form-title">@Texts.EditNoteTitle</h2>
                <p class="pm-form-sub">Update your secure note. Encrypts on save.</p>
            </div>
            <span class="pm-type-badge pm-type-badge--note" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </span>
        </div>

        <EditForm Model="@NoteViewModel" OnValidSubmit="SavePassword">
            <DataAnnotationsValidator />

            <div class="pm-form-body">

                <div class="pm-form-row">
                    <label for="en-desc">@Texts.DescriptionLabel</label>
                    <input id="en-desc"
                           type="text"
                           class="pm-form-input"
                           maxlength="100000"
                           @bind="@NoteViewModel.SecretDesc" />
                    <ValidationMessage For="@(() => NoteViewModel.SecretDesc)" />
                </div>

                <div class="pm-form-row">
                    <label for="en-body">@Texts.NoteLabel</label>
                    <textarea id="en-body"
                              rows="9"
                              maxlength="100000"
                              class="pm-form-textarea"
                              @bind="@NoteViewModel.Note"></textarea>
                    <ValidationMessage For="@(() => NoteViewModel.Note)" />
                </div>
            </div>

            <div class="pm-form-footer">
                <NavLink href="viewnote" class="pm-btn pm-btn--ghost">
                    @Texts.ButtonCancelText
                </NavLink>
                <button type="submit" class="pm-btn pm-btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @Texts.ButtonSaveText
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    SecretNoteViewModel NoteViewModel;

    protected override void OnInitialized()
    {
        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
            return;
        }

        NoteViewModel = new SecretNoteViewModel(secretService.CurrentSecret.Note.SecretDesc, secretService.CurrentSecret.Note.Note);
        editSecretViewModel.Secret.SecretGuid = secretService.CurrentSecret!.SecretGuid;
    }

    private async Task OnAfterRenderAsync()
    {
        await jsRuntime.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        editSecretViewModel.Secret.Note = NoteViewModel;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            secretService.CurrentSecret.Note = NoteViewModel;
            navigationManager.NavigateTo("/viewnote");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
    }
}
