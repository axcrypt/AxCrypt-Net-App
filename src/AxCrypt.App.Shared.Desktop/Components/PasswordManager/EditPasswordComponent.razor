@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IJSRuntime js

@*
    Edit Password — uses the shared .pm-form-* chrome that View and
    New also use. Same panel shell, fields are editable inputs.
*@

<div class="page-content-body-section">

    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    <div class="pm-form-shell">

        <div class="pm-form-header">
            <NavLink class="pm-form-back" href="viewpassword" title="Cancel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </NavLink>
            <div class="pm-form-titles">
                <h2 class="pm-form-title">@Texts.EditPasswordTitle</h2>
                <p class="pm-form-sub">Update your saved login. Changes encrypt on save.</p>
            </div>
            <span class="pm-type-badge pm-type-badge--password" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </span>
        </div>

        <EditForm Model="@PasswordViewModel" OnValidSubmit="SavePassword">
            <DataAnnotationsValidator />

            <div class="pm-form-body">

                <div class="pm-form-row">
                    <label for="ep-desc">@Texts.DescriptionLabel</label>
                    <input id="ep-desc"
                           class="pm-form-input"
                           type="text"
                           maxlength="100000"
                           @bind="@PasswordViewModel.SecretDesc" />
                    <ValidationMessage For="@(() => PasswordViewModel.SecretDesc)" />
                </div>

                <div class="pm-form-row">
                    <label for="ep-url">@Texts.PasswordUrlPrompt</label>
                    <input id="ep-url"
                           class="pm-form-input"
                           type="text"
                           @bind-value="@PasswordViewModel.Url" />
                    <ValidationMessage For="@(() => PasswordViewModel.Url)" />
                </div>

                <div class="pm-form-row">
                    <label for="ep-username">@Texts.UserNamePrompt</label>
                    <input id="ep-username"
                           class="pm-form-input"
                           type="text"
                           maxlength="100000"
                           @bind-value="@PasswordViewModel.Username" />
                    <ValidationMessage For="@(() => PasswordViewModel.Username)" />
                </div>

                <div class="pm-form-row pm-form-row--password">
                    <label for="ep-secret">@Texts.SecurityPasswordText</label>
                    <div class="pm-form-input-wrap">
                        <input id="ep-secret"
                               class="pm-form-input"
                               type="text"
                               maxlength="1000"
                               @bind-value="@PasswordViewModel.SecretValue" />
                        <button type="button"
                                class="pm-form-input-action"
                                title="@Texts.SecretsCopytoClipboard"
                                style="right: 38px;"
                                @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(PasswordViewModel.SecretValue)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="9" y="9" width="13" height="13" rx="2"/>
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                            </svg>
                        </button>
                        <button type="button"
                                class="pm-form-input-action"
                                title="@Texts.ButtonSuggestText"
                                @onclick="SuggestPasswordAsync">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 2v6h-6"/>
                                <path d="M3 12a9 9 0 0115-6.7L21 8"/>
                                <path d="M3 22v-6h6"/>
                                <path d="M21 12a9 9 0 01-15 6.7L3 16"/>
                            </svg>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => PasswordViewModel.SecretValue)" />
                    @if (!string.IsNullOrEmpty(CopyToClipboardUtility.CopiedInfoText))
                    {
                        <span style="color:#48772C; font-size:11.5px; font-weight:600;">@CopyToClipboardUtility.CopiedInfoText</span>
                    }
                </div>
            </div>

            <div class="pm-form-footer">
                <NavLink href="viewpassword" class="pm-btn pm-btn--ghost">
                    @Texts.ButtonCancelText
                </NavLink>
                <button type="submit" class="pm-btn pm-btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @Texts.ButtonSaveText
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    SecretPasswordViewModel? PasswordViewModel;

    protected override void OnInitialized()
    {
        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
            return;
        }

        SecretPasswordViewModel currentPwdModel = secretService.CurrentSecret.Password;
        PasswordViewModel = new SecretPasswordViewModel(currentPwdModel.Title, currentPwdModel.Url, currentPwdModel.Username, currentPwdModel.SecretDesc, currentPwdModel.SecretValue);
        editSecretViewModel.Secret.SecretGuid = secretService.CurrentSecret!.SecretGuid;
    }

    private async Task OnAfterRenderAsync()
    {
        await js.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        if (PasswordViewModel == null) return;

        editSecretViewModel.Secret.Password = PasswordViewModel;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            secretService.CurrentSecret.Password = PasswordViewModel;
            navigationManager.NavigateTo("/viewpassword");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
    }

    public async Task SuggestPasswordAsync()
    {
        PasswordViewModel.SecretValue = await SecretsApiHelper.SuggestPasswordAsync();
    }
}
