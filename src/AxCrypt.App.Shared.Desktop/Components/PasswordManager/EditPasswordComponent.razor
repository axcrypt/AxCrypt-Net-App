@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility

@inject IJSRuntime js

<div style="width: 100%;" class="page-max-height parent-container">
    <div class="page-heading">
        <h3 style="background-position:center;" class="password-creation">
            @Texts.EditPasswordTitle
        </h3>
    </div>
    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
    <EditForm Model="@PasswordViewModel" OnValidSubmit="SavePassword">
        <DataAnnotationsValidator />
        <ul class="clean-up sub-head-clr" style=" list-style:none">
            <li>
                <label for="Password_Url">@Texts.PasswordUrlPrompt:</label><br />
                <input style="color:#494949;" @bind-value="@PasswordViewModel.Url" type="text">
                <ValidationMessage For="@(() => PasswordViewModel.Url)" />
            </li>
            <li>
                <label for="Password_SecretDesc">@Texts.DescriptionLabel:</label><br />
                <textarea id="pwd-desc-inp" style="color:#494949;" maxlength="100000" @bind="@PasswordViewModel.SecretDesc"></textarea>
                <ValidationMessage For="@(() => PasswordViewModel.SecretDesc)" />
            </li>
            <li class="list-row">
                <div class="list-width">
                    <label for="Password_Username">@Texts.UserNamePrompt:</label><br />
                    <input id="pwd-username-inp" style="color:#494949;" maxlength="100000" type="text" @bind-value="@PasswordViewModel.Username">
                    <ValidationMessage For="@(() => PasswordViewModel.Username)" />
                </div>
                <div class="list-width">
                    <label for="password_secretvalue">@Texts.SecurityPasswordText:</label><br />
                    <div style="display:flex; position: relative;">
                        <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                        <input class="passwordInput" style="color:#494949;" maxlength="1000" type="text" @bind-value="@PasswordViewModel.SecretValue" />
                        <div style="right: 0px;" id="suggest-new-password-actn-btn-dsktp" title="@Texts.ButtonSuggestText" @onclick="SuggestPasswordAsync">
                            <img class="suggest-password" src="" alt="suggest-img">
                        </div>
                        <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 46px; cursor: pointer;" class="copy-to-clipbrd" @onclick="async ()=> await CopyToClipboardUtility.CopyToClipboard(PasswordViewModel.SecretValue)">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>
                        <ValidationMessage For="@(() => PasswordViewModel.SecretValue)" />
                    </div>
                    <span id="copiedMessage" style="color: green; font-weight: bold;">@CopyToClipboardUtility.CopiedInfoText</span>
                </div>
            </li>
            <li>
                <div class="btn-sec-new-edit">
                    <button type="submit" class="button btn-extra-small success">@Texts.ButtonSaveText</button>
                    <NavLink href="viewpassword">
                        <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                    </NavLink>
                </div>
            </li>
        </ul>
    </EditForm>
</div>
@code {
    SecretPasswordViewModel? PasswordViewModel;
    protected override void OnInitialized()
    {
        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
            return;
        }

        SecretPasswordViewModel currentPwdModel = secretService.CurrentSecret.Password;
        PasswordViewModel = new SecretPasswordViewModel(currentPwdModel.Title, currentPwdModel.Url, currentPwdModel.Username, currentPwdModel.SecretDesc, currentPwdModel.SecretValue);
        editSecretViewModel.Secret.SecretGuid = secretService.CurrentSecret!.SecretGuid;
    }

    private async Task OnAfterRenderAsync()
    {
        await js.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        if (PasswordViewModel == null)
        {
            return;
        }

        editSecretViewModel.Secret.Password = PasswordViewModel;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success(Texts.NewPasswordUpdatedText);
            secretService.CurrentSecret.Password = PasswordViewModel;
            navigationManager.NavigateTo("/viewpassword");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        PasswordViewModel.SecretDesc = args?.Value?.ToString();
    }

    public async Task SuggestPasswordAsync()
    {
        PasswordViewModel.SecretValue = await SecretsApiHelper.SuggestPasswordAsync();
    }
}