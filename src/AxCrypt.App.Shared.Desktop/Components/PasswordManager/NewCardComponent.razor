@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager;
@inject NewSecretViewModel newSecretViewModel
@inject SecretService secretService

<div class="page-max-height" style="width: 100%;">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.AddCardTitle
        </h3>
    </div>
    <div class="parent-container">
        <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
        <EditForm Model="@newSecretViewModel.Secret.Card" OnValidSubmit="SavePassword" @ref="editForm">
            <DataAnnotationsValidator />
            <div class="row">
                <ul class="clean-up sub-head-clr" style=" list-style:none ">
                    <li>
                        <label for="Card_CardNumber">@Texts.CardNumberPrompt</label>
                        <input maxlength="19" minlength="12" style="color:#494949 !important;" placeholder="XXXX XXXX XXXX XXXX"
                               @bind="newSecretViewModel.Secret.Card.CardNumber" type="text"
                               class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.CardNumber)))"
                               onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                        <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.CardNumber)" />
                    </li>
                    <li>
                        <label for="Card_SecretDesc">@Texts.DescriptionLabel:</label>
                        <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important;" placeholder="example"
                                  @bind="newSecretViewModel.Secret.Card.SecretDesc"
                                  class="@(GetInputClass(nameof(newSecretViewModel.Secret.Card.SecretDesc)))"></textarea>
                        <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.SecretDesc)" />
                    </li>
                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_NameOnCard">@Texts.NameOnCardPrompt</label>
                            <input type="text" style="color:#494949 !important;" placeholder="Name and Surname"
                                   @bind="newSecretViewModel.Secret.Card.NameOnCard"
                                   class="@(GetInputClass(nameof(newSecretViewModel.Secret.Card.NameOnCard)))" />
                            <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.NameOnCard)" />
                        </div>
                        <div class="list-width">
                            <label for="Card_SecurityCode">@Texts.SecurityCodePrompt:</label><br />
                            <div style="display:flex">
                                <input id="Card_SecurityCode" maxlength="3" placeholder="000" @bind="newSecretViewModel.Secret.Card.SecurityCode"
                                       type="password"
                                       class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.SecurityCode)))"
                                       onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                       oninput="this.value = this.value.replace(/\D/g, '').substring(0, 3)" />
                                <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.SecurityCode)" />
                            </div>
                        </div>
                    </li>
                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_ExpirationDate">@Texts.ExpirationDatePrompt:</label>
                            <input id="Card_ExpirationDate" maxlength="7" placeholder="MM/YYYY" @bind="newSecretViewModel.Secret.Card.ExpirationDate"
                                   type="text"
                                   class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.ExpirationDate)))"
                                   onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                   oninput="this.value = this.value.replace(/\D/g, '').substring(0, 6).replace(/(\d{2})(\d{2})/, '$1/$2')" />
                            <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.ExpirationDate)" />
                        </div>
                    </li>
                    <li>
                        <div class="btn-sec-new-edit">
                            <button type="submit" class="button btn-extra-small success">@Texts.ButtonSaveText</button>
                            <NavLink href="passwordManager">
                                <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                            </NavLink>
                        </div>
                    </li>
                </ul>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private EditForm? editForm;

    private string GetInputClass(string propertyName)
    {
        FieldIdentifier fieldIdentifier = new FieldIdentifier(newSecretViewModel.Secret.Card, propertyName);
        bool isFieldValid = editForm.EditContext.GetValidationMessages(fieldIdentifier).Any();

        return isFieldValid ? "input-error" : string.Empty;
    }

    protected override void OnInitialized()
    {
        secretService.SecretType = SecretType.Card;
        newSecretViewModel = new NewSecretViewModel(secretService);
    }

    private async Task SavePassword()
    {
        bool success = await newSecretViewModel.SaveSecretAsync();
        if (success)
        {
            StatusAlertService.Success("Your new Card entry has been saved.");
            navigationManager.NavigateTo("/passwordManager");
            return;
        }

        StatusAlertService.Error(newSecretViewModel.ErrorMessage);
    }
}