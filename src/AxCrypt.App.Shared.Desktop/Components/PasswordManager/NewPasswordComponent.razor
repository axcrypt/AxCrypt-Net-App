@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject NewSecretViewModel newSecretViewModel
@inject SecretService secretService
@inject IJSRuntime JSRuntime

@*
    New Password — create flow.

    Form chrome lives in the shared .pm-form-* selectors so the
    Add Password / Add Card / Add Note screens all share the same
    panel design. View / Edit reuse the same selectors.
*@

<div class="page-content-body-section">

    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    <div class="pm-form-shell">

        @* ── Header ─────────────────────────────────────── *@
        <div class="pm-form-header">
            <NavLink class="pm-form-back" href="passwordManager" title="Back to passwords">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </NavLink>
            <div class="pm-form-titles">
                <h2 class="pm-form-title">@Texts.AddPasswordTitle</h2>
                <p class="pm-form-sub">Store a new login. Encrypted end-to-end on save.</p>
            </div>
            <span class="pm-type-badge pm-type-badge--password" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </span>
        </div>

        @* ── Body ───────────────────────────────────────── *@
        <EditForm Model="@newSecretViewModel.Secret.Password" OnValidSubmit="SavePassword" @ref="editForm">
            <DataAnnotationsValidator />

            <div class="pm-form-body">

                <div class="pm-form-row">
                    <label for="Password_SecretDesc">@Texts.DescriptionLabel</label>
                    <input id="Password_SecretDesc"
                           type="text"
                           class="pm-form-input @GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretDesc))"
                           placeholder="e.g. Gmail — work"
                           maxlength="100000"
                           @bind="@newSecretViewModel.Secret.Password.SecretDesc" />
                    <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretDesc)" />
                </div>

                <div class="pm-form-row">
                    <label for="Password_Url">@Texts.PasswordUrlPrompt</label>
                    <input id="Password_Url"
                           type="text"
                           class="pm-form-input @GetInputClass(nameof(newSecretViewModel.Secret.Password.Url))"
                           placeholder="www.example.com"
                           @bind="newSecretViewModel.Secret.Password.Url" />
                </div>

                <div class="pm-form-row">
                    <label for="Password_Username">@Texts.UserNamePrompt</label>
                    <input id="Password_Username"
                           type="text"
                           class="pm-form-input @GetInputClass(nameof(newSecretViewModel.Secret.Password.Username))"
                           placeholder="name@example.com"
                           maxlength="100000"
                           @bind="newSecretViewModel.Secret.Password.Username" />
                </div>

                <div class="pm-form-row pm-form-row--password">
                    <label for="Password_SecretValue">@Texts.PassphrasePrompt</label>
                    <div class="pm-form-input-wrap">
                        <input id="Password_SecretValue"
                               type="text"
                               class="pm-form-input @GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretValue))"
                               placeholder="123IUoow$!99"
                               maxlength="1000"
                               @bind="newSecretViewModel.Secret.Password.SecretValue"
                               @bind:event="oninput" />
                        <button type="button"
                                class="pm-form-input-action"
                                title="@Texts.ButtonSuggestText"
                                @onclick="newSecretViewModel.SuggestPasswordAsync">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 2v6h-6"/>
                                <path d="M3 12a9 9 0 0115-6.7L21 8"/>
                                <path d="M3 22v-6h6"/>
                                <path d="M21 12a9 9 0 01-15 6.7L3 16"/>
                            </svg>
                        </button>
                    </div>
                    <AxCrypt.App.Shared.Desktop.Components.Shared.PasswordStrengthMeterComponent
                        InputValue="@newSecretViewModel.Secret.Password.SecretValue" />
                    <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretValue)" />
                </div>
            </div>

            @* ── Footer ─────────────────────────────────── *@
            <div class="pm-form-footer">
                <NavLink href="passwordManager" class="pm-btn pm-btn--ghost">
                    @Texts.ButtonCancelText
                </NavLink>
                <button type="submit" class="pm-btn pm-btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    @Texts.ButtonSaveText
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    private EditForm editForm;

    private string GetInputClass(string propertyName)
    {
        FieldIdentifier fieldIdentifier = new FieldIdentifier(newSecretViewModel.Secret.Password, propertyName);
        bool isFieldValid = editForm.EditContext.GetValidationMessages(fieldIdentifier).Any();

        return isFieldValid ? "input-error" : string.Empty;
    }

    protected override void OnInitialized()
    {
        secretService.SecretType = SecretType.Password;
        newSecretViewModel = new NewSecretViewModel(secretService);
    }

    private async Task SavePassword()
    {
        bool success = await newSecretViewModel.SaveSecretAsync();
        if (success)
        {
            StatusAlertService.Success(@Texts.NewSecretSuccess);
            navigationManager.NavigateTo("/passwordManager");
            return;
        }

        StatusAlertService.Error(newSecretViewModel.ErrorMessage);
    }
}
