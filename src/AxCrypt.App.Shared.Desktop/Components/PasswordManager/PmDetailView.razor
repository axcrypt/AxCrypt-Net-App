@* Detail pane — View mode. Displays a single secret's fields with copy/show/hide actions and the share panel.
   Resets visibility flags automatically when the displayed secret changes. *@
@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.Content

@inject CopyToClipboardUtility CopyToClipboardUtility

<div class="pmx-detail">
    <header class="pmx-detail-head">
        <span class="pmx-detail-icon pmx-row-icon--@PmHelpers.TypeKey(Secret.SecretType)">
            <PmTypeIcon Type="Secret.SecretType" />
        </span>
        <div class="pmx-detail-titles">
            <h2 class="pmx-detail-title">@PmHelpers.DisplayTitle(Secret)</h2>
            <span class="pmx-detail-sub">@PmHelpers.DisplaySubtitle(Secret)</span>
        </div>
        <div class="pmx-detail-actions">
            @* Action rules: Free → none; Paid+own → Edit+Delete; Paid+shared → Delete only. *@
            @if (IsPaid && !IsSharedWithMe && !ScopeShared)
            {
                <button type="button" class="pmx-btn pmx-btn--ghost" @onclick="OnEdit">Edit</button>
                <button type="button" class="pmx-btn pmx-btn--danger" @onclick="OnDelete">Delete</button>
            }
            else if (IsSharedWithMe || ScopeShared)
            {
                @if (IsPaid)
                {
                    <button type="button" class="pmx-btn pmx-btn--danger" @onclick="OnDelete">Delete</button>
                }
                <span class="pmx-readonly-pill" title="This entry was shared with you and is read-only.">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                    </svg>
                    Read-only
                </span>
            }
            <button type="button" class="pmx-close-btn" @onclick="OnClose" title="Close" aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
    </header>

    @if (IsSharedWithMe || ScopeShared)
    {
        <div class="pmx-shared-banner" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 00-3-3.87" />
                <path d="M4 21v-2a4 4 0 013-3.87" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            <div class="pmx-shared-banner-text">
                <span class="pmx-shared-banner-label">Shared by</span>
                <span class="pmx-shared-banner-email">@(string.IsNullOrEmpty(Secret.OwnerEmail) ? "—" : Secret.OwnerEmail)</span>
            </div>
        </div>
    }

    <div class="pmx-detail-body">
        @switch (Secret.SecretType)
        {
            case SecretType.Password: @ViewPassword(); break;
            case SecretType.Card:     @ViewCard();     break;
            case SecretType.Note:     @ViewNote();     break;
        }
    </div>

    @* Share panel — hidden for shared-with-me entries since you can't re-share what you don't own. *@
    @if (!IsSharedWithMe && !ScopeShared)
    {
        <div class="pmx-share">
            <button type="button" class="pmx-share-toggle" @onclick="() => _showShare = !_showShare">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                </svg>
                <span>@Texts.PromptSharedWith</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                     class="@(_showShare ? "pmx-share-arrow pmx-share-arrow--open" : "pmx-share-arrow")">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>
            @if (_showShare)
            {
                <div class="pmx-share-body">
                    <AxCrypt.App.Shared.Desktop.Components.Home.SharePasswordComponent />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SecretViewModel Secret { get; set; } = null!;
    [Parameter] public bool IsPaid { get; set; }
    [Parameter] public bool IsSharedWithMe { get; set; }
    [Parameter] public bool ScopeShared { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenUrl { get; set; }

    // Visibility toggles — local to view mode, reset when the displayed secret changes.
    private bool _showValue;
    private bool _showCardNum;
    private bool _showCvv;
    private bool _showShare;
    private Guid? _prevGuid;

    protected override void OnParametersSet()
    {
        if (_prevGuid != Secret.SecretGuid)
        {
            _showValue = _showCardNum = _showCvv = _showShare = false;
            _prevGuid = Secret.SecretGuid;
        }
    }

    // ── Type-specific field renderers ────────────────────────────

    private RenderFragment ViewPassword() => __builder =>
    {
        var p = Secret.Password;
        @ViewField("USERNAME / EMAIL", p.Username, copy: true)
        <div class="pmx-field">
            <label class="pmx-field-label">PASSWORD</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-mono">@(_showValue ? p.SecretValue : PmHelpers.Mask(p.SecretValue))</span>
                <button type="button" class="pmx-field-action" @onclick="() => _showValue = !_showValue">@(_showValue ? "Hide" : "Show")</button>
                @if (!string.IsNullOrEmpty(p.SecretValue))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(p.SecretValue)">Copy</button>
                }
            </div>
        </div>
        <div class="pmx-field">
            <label class="pmx-field-label">WEBSITE</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-link">@(string.IsNullOrEmpty(p.Url) ? "—" : p.Url)</span>
                @if (!string.IsNullOrEmpty(p.Url))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await OnOpenUrl.InvokeAsync(p.Url)">Open</button>
                }
            </div>
        </div>
        @ViewDescription(p.SecretDesc)
    };

    private RenderFragment ViewCard() => __builder =>
    {
        var c = Secret.Card;
        <div class="pmx-field">
            <label class="pmx-field-label">CARD NUMBER</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value pmx-mono">@(_showCardNum ? c.CardNumber : PmHelpers.MaskCard(c.CardNumber))</span>
                <button type="button" class="pmx-field-action" @onclick="() => _showCardNum = !_showCardNum">@(_showCardNum ? "Hide" : "Show")</button>
                @if (!string.IsNullOrEmpty(c.CardNumber))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(c.CardNumber)">Copy</button>
                }
            </div>
        </div>
        @ViewField("NAME ON CARD", c.NameOnCard, copy: false)
        <div class="pmx-field-grid">
            @ViewField("EXPIRES", c.ExpirationDate, copy: false)
            <div class="pmx-field">
                <label class="pmx-field-label">CVV</label>
                <div class="pmx-field-row">
                    <span class="pmx-field-value pmx-mono">@(_showCvv ? c.SecurityCode : "•••")</span>
                    <button type="button" class="pmx-field-action" @onclick="() => _showCvv = !_showCvv">@(_showCvv ? "Hide" : "Show")</button>
                </div>
            </div>
        </div>
        @ViewDescription(c.SecretDesc)
    };

    private RenderFragment ViewNote() => __builder =>
    {
        var n = Secret.Note;
        @ViewField("TITLE", n.SecretDesc, copy: false)
        <div class="pmx-field">
            <label class="pmx-field-label">NOTE</label>
            <div class="pmx-field-notes pmx-field-notes--block">@(string.IsNullOrEmpty(n.Note) ? "No content." : n.Note)</div>
            @if (!string.IsNullOrEmpty(n.Note))
            {
                <button type="button" class="pmx-field-action pmx-field-action--standalone"
                        @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(n.Note)">Copy note</button>
            }
        </div>
    };

    // Generic labelled field row — optional copy button.
    private RenderFragment ViewField(string label, string? value, bool copy) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">@label</label>
            <div class="pmx-field-row">
                <span class="pmx-field-value">@(string.IsNullOrEmpty(value) ? "—" : value)</span>
                @if (copy && !string.IsNullOrEmpty(value))
                {
                    <button type="button" class="pmx-field-action" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(value)">Copy</button>
                }
            </div>
        </div>
    };

    // Shared description block used by Password and Card views.
    private RenderFragment ViewDescription(string? desc) => __builder =>
    {
        <div class="pmx-field">
            <label class="pmx-field-label">DESCRIPTION</label>
            <div class="pmx-field-notes @(string.IsNullOrEmpty(desc) ? "pmx-field-notes--empty" : "")">
                @(string.IsNullOrEmpty(desc) ? "No description." : desc)
            </div>
        </div>
    };
}
