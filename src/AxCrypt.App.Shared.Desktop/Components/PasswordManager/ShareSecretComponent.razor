@using AxCrypt.App.Entitlement.Services
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve;

@inject ViewSecretViewModel viewSecretViewModel
@inject IStatusAlertService StatusAlertService
@inject SecretService secretService
@inject IJSRuntime JSRuntime

@if (!IsSharedView)
{
    @if (!string.IsNullOrEmpty(shareSecretViewModel!.ErrorMessage))
    {
        <div class="error-message">@shareSecretViewModel.ErrorMessage</div>
    }

    @* Old collapsible "Shared with" header removed — the section header is
       now provided once by the .pmx-share-toggle in PasswordManagerComponent.
       The container below stays expanded (it is visible by default; the
       legacy toggleClass() JS only added the .hidden class). *@
    <div id="container" class="container">
        @if (viewSecretViewModel.HasBusinessSubscription)
        {
            <p class="bus-info sub-head-clr">
                @Texts.GroupInfoText <b> @Texts.GroupFeatureText </b> @Texts.YetText <a style="color:#FFC50D;text-decoration:underline;" @onclick="viewSecretViewModel.GoToLearmoreLink"> @Texts.LearnMoreLinkLabel </a> @Texts.GroupInfoText1 <a style="color:#FFC50D;text-decoration:underline;" @onclick="viewSecretViewModel.GoToCreateGroupLink"> @Texts.CreateGroupInfoTexts </a>
            </p>
        }
        else
        {
            <p>@Texts.ShareSecretInformationText</p>
        }
        <form id="temp-add-share-user" @onsubmit="ApplyShare">
            <div class="sharewith-box" style="padding: 20px; ">
                <div style="margin:auto;flex-wrap:wrap; justify-content:space-around; width:100%; gap: 5px;" class="row">
                    <div class="small-8">
                        <input type="text" id="new-member-email" @ref="inputRef" @bind="@shareSecretViewModel.SecretSharingUserEmail" name="memberEmail" placeholder="someone@email.example" @oninput="SuggestUsers" @onfocus="ShowSuggestions" @onkeydown="async (e) => await HandleKeyDown(e)" style="width: 100%; height: 40px; border-radius:5px ">
                        @if (shareSecretViewModel.ShowUserSuggestion && shareSecretViewModel.SuggestedUnSharedUsers.Any())
                        {
                            <ul class="share-suggestion-list hide-popup-modal" id="share-secret-suggestion-popup">
                                @foreach (SecretSharedUserViewModel suggestion in shareSecretViewModel.SuggestedUnSharedUsers)
                                {
                                    <li @onclick="() => shareSecretViewModel.SelectSuggestion(suggestion.GroupName, suggestion.UserEmail.Address!)" style="margin-top: 5px;">
                                        @if (!string.IsNullOrEmpty(suggestion.GroupName))
                                        {
                                            <span>@suggestion.GroupName</span>
                                            <img src="images/business/IcoGrp.svg" alt="Group Icon" style="float: right;margin: 4px 10px;" />
                                        }
                                        else
                                        {
                                            <span>@suggestion.UserEmail</span>
                                            <img class="contact-icon" src="" alt="Individual Icon" style="float: right;margin: 4px 10px;" />
                                        }
                                        <hr style="margin:0.5rem 0;" />
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="medium-2 columns">
                        <select style="height: 35px;border-radius:5px;width: 100%;" id="shareVisibilityOptions" name="Visibility" title="Visibility" @bind="shareSecretViewModel.VisibilityType">
                            @foreach (SecretShareVisibility visibility in Enum.GetValues(typeof(SecretShareVisibility)))
                            {
                                <option value="@visibility">@visibility</option>
                            }
                        </select>
                    </div>
                    <div class="medium-1 columns">
                        <input style="margin: 5px 0 15px;width: 100%;float: right;padding-left:0;padding-right:0;" id="Add-Share-Users" type="button" class="button active btn-small " @onclick="async () => await shareSecretViewModel.AddUserToSharedListAsync()" value="Add" />
                    </div>
                </div>
                <div class="" style="position: relative; display: flow;">
                    <h3 class="select-files font-bold">@Texts.AddedUsersAccessText (<span id="userCount">@shareSecretViewModel.ShareSecretUserList?.Count()</span>)</h3>
                    @if (shareSecretViewModel.ShareSecretUserList!.Any())
                    {
                        <div class="row">
                            <div class="file-box-desktop scroll-container" id="sharedUserList" style="margin-right:0px">
                                @foreach (SecretSharedUserViewModel user in shareSecretViewModel.ShareSecretUserList!)
                                {
                                    <dl>
                                        <dd class="list-bgrnd">
                                            <img class="@user.ImageSource" style="float:left;" src="@SharedUserImageSource(user.ImageSource)" alt="img">
                                            <div style="display:inline-block; ">
                                                <span class="shared-text">@user.DisplayText</span><br />
                                                <span style="padding-left:15px; display: block;" class="share-visibility">@user.Visibility</span>
                                            </div>
                                            <img class="menu-image" src="/images/Group160.svg" alt="img" @onclick="() => shareSecretViewModel.UpdatedSelectedUser(user)" style="float:right;">
                                            <hr style="width:100%;">
                                        </dd>
                                    </dl>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="file-box-desktop file-box-empty scroll-container" id="sharedUserList" style="margin-right:0px; margin-right:5px;"></div>
                    }
                    @if (shareSecretViewModel.CanContextMenuOpened)
                    {
                        <div class="hide-model-popup context-menu">
                            <dl>
                                <dd>
                                    <img class="unshare-icon" src="/images/IcoUnShare.svg" alt="" />
                                    <span @onclick="shareSecretViewModel.RemoveSelectedSharedUser">@Texts.UnSharePromptText</span>
                                </dd>
                            </dl>
                        </div>
                    }
                </div>
            </div>
            @if (!shareSecretViewModel.EnableApplyButton)
            {
                <div style="margin-left: 0px !important;">
                    <input type="button" class="button success btn-extra-small" value="Apply" />
                </div>
            }
            else
            {
                <div style="margin-left: 0px !important;">
                    <input type="button" class="button success btn-extra-small" @onclick="ApplyShare" value="Apply" />
                </div>
            }
        </form>
    </div>
}

@code {
    bool IsSharedView { get; set; }
    private ElementReference inputRef;

    ShareSecretViewModel? shareSecretViewModel;

    protected override void OnInitialized()
    {
        shareSecretViewModel = new ShareSecretViewModel(secretService);
        shareSecretViewModel.OnUpdateViewState += UpdateStateChanged;

        IsSharedView = secretService.CurrentSecret?.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail;
        if (IsSharedView)
        {
            Task.Run(async () => await viewSecretViewModel.UpdateSecretByVisibility());
        }
    }

    private async Task OnAfterRenderAsync()
    {
        if (IsSharedView)
        {
            await JSRuntime.InvokeVoidAsync("toggleClass");
        }
    }

    private async Task ApplyShare()
    {
        bool isShared = false;
        if (shareSecretViewModel!.EnableApplyButton)
        {
            isShared = await shareSecretViewModel.ApplyShareSecret();
        }

        if (isShared)
        {
            await New<UserEntitlementService>().InsertUserUsageCount(LimitedCapability.ShareSecret, New<AccountStatusViewModel>().SubscriptionLevel);
            StatusAlertService.Success(Texts.ShareSecretSuccess);
            shareSecretViewModel!.EnableApplyButton = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(shareSecretViewModel!.SecretSharingUserEmail))
        {
            await shareSecretViewModel.AddUserToSharedListAsync();
        }

        return;
    }

    string SharedUserImageSource(string imageSource)
    {
        return imageSource == "contact-icon" ? "" : "/images/default/AxCrypt_Icon.svg";
    }

    private async Task ShowSuggestions()
    {
        if (!string.IsNullOrEmpty(shareSecretViewModel!.SecretSharingUserEmail))
        {
            shareSecretViewModel.PerformSearch(shareSecretViewModel.SecretSharingUserEmail);
        }
        else
        {
            shareSecretViewModel.ShowUnSharedUsersSuggestionPopup();
        }

        await JSRuntime.InvokeVoidAsync("registerOutsideClick", inputRef, "share-secret-suggestion-popup", DotNetObjectReference.Create(this));
    }

    private async Task SuggestUsers(ChangeEventArgs e)
    {
        await ShowSuggestions();
        shareSecretViewModel!.PerformSearch(e.Value?.ToString()!.ToLower() ?? string.Empty);
    }

    [JSInvokable]
    public void HideSuggestions()
    {
        shareSecretViewModel!.HideUnSharedUsersSuggestionPopup();
        UpdateStateChanged();
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
