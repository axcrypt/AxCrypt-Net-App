@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility

@inject IJSRuntime JSRuntime

<div class="page-max-height">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.ViewCardTitle
        </h3>
    </div>
    <form>
        <div class="row parent-container">
            <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
            <ul class="clean-up sub-head-clr" style=" list-style:none">
                <li>
                    <label for="Card_CardNumber">@Texts.CardNumberPrompt</label>
                    <div style="position: relative;">
                        <input id="cardNumberInput" maxlength="19" minlength="12" style="color:#494949; background-color:#E2E2E2" value="@GetValue(isCardNumberVisible, secretService.CurrentSecret.Card.CardNumber)" readonly="readonly" type="text" @onclick="ShowCardNumber">
                        <div id="cp-card-number-clipbrd" style="position: absolute; right: 10px; top:2px;cursor: pointer;" class="copy-to-clipbrd" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(secretService.CurrentSecret.Card.CardNumber)">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>
                    </div>
                </li>
                <li>
                    <label for="Card_SecretDesc">@Texts.DescriptionLabel</label>
                    <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Card.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea>
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Card_NameOnCard">@Texts.NameOnCardPrompt</label>
                        <input type="text" style="color:#494949; background-color:#E2E2E2" @bind-value="@secretService.CurrentSecret.Card.NameOnCard" readonly="readonly">
                    </div>
                    <div class="list-width">
                        <label for="Card_SecurityCode">@Texts.SecurityCodePrompt:</label><br />
                        <div style="display:flex; position: relative;">
                            <input id="securityCodeInput" maxlength="1000" style="color:#494949; background-color:#E2E2E2" value="@GetValue(isSecurityCodeVisible, secretService.CurrentSecret.Card.SecurityCode)" readonly="readonly" type="text" @onclick="ShowSecurityCode">
                            <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(secretService.CurrentSecret.Card.SecurityCode)">
                                <img class="clipbrd" src="" alt="copy-clp-brd">
                            </div>
                        </div>
                    </div>
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Card_ExpirationDate">@Texts.ExpirationDatePrompt</label>
                        <input id="card-exp-date-inp" style="color:#494949; background-color:#E2E2E2" @bind-value="@secretService.CurrentSecret.Card.ExpirationDate" type="text" readonly="readonly">
                    </div>
                </li>
                <span id="copiedMessage" style="color: green; font-weight: bold;">@CopyToClipboardUtility.CopiedInfoText</span>
                @if (secretService.CurrentSecret.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail)
                {

                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_ExpirationDate">@Texts.OwnerEmailText</label>
                            <input id="card-exp-date-inp" style="color:#494949; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.OwnerEmail" type="text" readonly="readonly">
                        </div>
                    </li>
                }
                <li>
                    <div class="center-column" style="gap: 20px;">
                        <div>
                            <NavLink href="passwordManager">
                                <input type="submit" class="button cancel btn-extra-small" value="Back" />
                            </NavLink>
                        </div>
                        <div>
                            @if (viewSecretViewModel.HasPaidSubscription)
                            {
                                <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                            }
                            @if (viewSecretViewModel.HasPaidSubscription && secretService.CurrentSecret.OwnerEmail == viewSecretViewModel.UserEmail)
                            {
                                <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="NavigateToEdit" style="margin-left:20px;" />
                            }
                        </div>
                    </div>
                </li>
            </ul>
            <ShareSecretComponent />
        </div>
    </form>
</div>
@code {
    ShareSecretViewModel? shareSecretViewModel;

    protected override void OnInitialized()
    {
        viewSecretViewModel.UserEmail = Resolve.KnownIdentities.DefaultEncryptionIdentity.UserEmail.Address;

        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }

        viewSecretViewModel.Secret = secretService.CurrentSecret!;
        shareSecretViewModel = new ShareSecretViewModel(secretService);
        shareSecretViewModel.OnUpdateViewState += UpdateStateChanged;
    }

    private void NavigateToEdit()
    {
        if (secretService.CurrentSecret != null)
        {
            string url = secretService.CurrentSecret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Card => $"/editcard"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigationManager.NavigateTo(url);
            }
        }
    }

    private async Task DeleteSecret()
    {
        PopupButtons selectedButton = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, Texts.AlertText, Texts.DeleteSecretText, Common.DoNotShowAgainOptions.None);
        bool isConfirmed = selectedButton == PopupButtons.Ok;

        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
        ShowDeleteStatus(deleted);

        navigationManager.NavigateTo("/passwordManager");
    }

    private void ShowDeleteStatus(bool deleted)
    {
        if (deleted)
        {
            StatusAlertService.Success(Texts.SecretDeletedText);
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }
    }

    private async Task HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret!.Card.SecretDesc = args?.Value?.ToString();
    }

    private bool isCardNumberVisible = false;
    private bool isSecurityCodeVisible = false;

    private string GetValue(bool isVisible, string value)
    {
        return isVisible ? value : Texts.ClickToShowText;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "cardNumberInput");
            await JSRuntime.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "securityCodeInput");
        }
    }

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "cardNumberInput" && isCardNumberVisible)
        {
            isCardNumberVisible = false;
        }
        else if (fieldId == "securityCodeInput" && isSecurityCodeVisible)
        {
            isSecurityCodeVisible = false;
        }
        StateHasChanged();
    }

    private void ShowCardNumber()
    {
        VisibleReadOnlySecret("cardNumberInput", true);
    }

    private void ShowSecurityCode()
    {
        VisibleReadOnlySecret("securityCodeInput", true);
    }

    private void VisibleReadOnlySecret(string fieldId, bool isVisible)
    {
        if (fieldId == "cardNumberInput")
        {
            isCardNumberVisible = isVisible;
        }
        else if (fieldId == "securityCodeInput")
        {
            isSecurityCodeVisible = isVisible;
        }
        StateHasChanged();
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}