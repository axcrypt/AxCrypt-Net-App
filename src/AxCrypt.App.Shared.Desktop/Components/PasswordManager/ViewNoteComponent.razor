@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using AxCrypt.App.Shared.Desktop.Code
@using static AxCrypt.Abstractions.TypeResolve

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IJSRuntime jsRuntime

<style>
    .description {
        display: -webkit-box;
        -webkit-line-clamp: 3; /* Show only 3 lines */
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* Expand when clicked */
    #toggle-desc:checked ~ .description {
        -webkit-line-clamp: unset;
        overflow: visible;
    }

    /* Button styling */
    .toggle-btn {
        cursor: pointer;
        color: red;
        font-weight: 500;
        display: inline-block;
        margin-top: 6px;
        margin: 0% 40% auto;
    }

        .toggle-btn::after {
            content: "View More";
        }

    #toggle-desc:checked ~ .toggle-btn::after {
        content: "View Less";
    }

</style>
<div class="page-max-height1">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.ViewNoteTitle
        </h3>
    </div>
    <form>
        <div class="row parent-container">
            <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
            <ul class="clean-up sub-head-clr" style=" list-style:none">
                <li>
                    <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                    @* <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Note.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea> *@
                    <div class="description-box">
                        <input type="checkbox" id="toggle-desc" hidden>
                        <p class="description">
                            Dark mode has become one of the most popular design trends in modern digital interfaces.
                            It uses a dark background with light-colored text to reduce overall screen brightness.
                            Many users prefer dark mode because it feels easier on the eyes, especially at night.
                            It can help minimize glare in low-light environments and create a more comfortable viewing experience.
                            Dark mode is commonly available in operating systems, websites, and mobile applications.
                            Platforms like Android and iOS offer built-in dark themes across their systems.
                            Social media apps such as Instagram and Twitter also support dark mode for user convenience.
                            Beyond comfort, dark mode can help save battery life on devices with OLED or AMOLED screens.
                            Designers often choose dark themes to create a modern and elegant appearance.
                            However, dark mode may not be ideal for every situation, especially in bright sunlight.
                            Some users find light mode better for reading long texts during the day.
                            Accessibility considerations are important when designing dark interfaces.
                            Proper contrast between text and background ensures readability for all users.
                            Overall, dark mode has transformed the way people interact with digital technology.
                        </p>
                        <label for="toggle-desc" class="toggle-btn"></label>
                    </div>
                </li>
                <li>
                    <label for="Note_Note">@Texts.NoteLabel</label>
                    <div style="display:flex; position: relative;">
                        <textarea id="noteInput" type="text" class="secret-note-section" cols="20" maxlength="100000" style="color:#494949; background-color:#E2E2E2" value="@GetValue(isNoteVisible, secretService.CurrentSecret.Note.Note)" readonly="readonly" @onclick="()=> VisibleReadOnlySecret(true)"></textarea>
                       
                        <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="async ()=> await CopyToClipboardUtility.CopyToClipboard(secretService.CurrentSecret!.Note.Note)">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>
                    </div>
                    <span id="copiedMessage" style="color: green; font-weight: bold;">@CopyToClipboardUtility.CopiedInfoText</span>
                </li>
                @if (secretService.CurrentSecret.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail)
                {

                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_ExpirationDate">@Texts.OwnerEmailText</label>
                            <input id="card-exp-date-inp" style="color:#494949; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.OwnerEmail" type="text" readonly="readonly">
                        </div>
                    </li>
                }
                <li>
                    <div class="center-column" style="gap: 20px;">
                        <div>
                            <NavLink href="passwordManager">
                                <input type="submit" class="button cancel btn-extra-small" value="Back" />
                            </NavLink>
                        </div>
                        <div>
                            @if (viewSecretViewModel.HasPaidSubscription)
                            {
                                <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                            }
                            @if (viewSecretViewModel.HasPaidSubscription && secretService.CurrentSecret.OwnerEmail == viewSecretViewModel.UserEmail)
                            {
                                <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="NavigateToEdit" style="margin-left:20px;" />
                            }
                        </div>
                    </div>
                </li>
            </ul>
            <ShareSecretComponent />
        </div>
    </form>
</div>
@code {
    ShareSecretViewModel? shareSecretViewModel;

    protected override void OnInitialized()
    {
        viewSecretViewModel.UserEmail = Core.Resolve.KnownIdentities.DefaultEncryptionIdentity.UserEmail.Address;

        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }

        viewSecretViewModel.Secret = secretService.CurrentSecret!;
        shareSecretViewModel = new ShareSecretViewModel(secretService);
        shareSecretViewModel.OnUpdateViewState += UpdateStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "noteInput");
        }
    }

    private async Task DeleteSecret()
    {
        PopupButtons selectedButton = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, @Texts.AlertText, @Texts.DeleteSecretText, Common.DoNotShowAgainOptions.None);
        bool isConfirmed = selectedButton == PopupButtons.Ok;

        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
        ShowDeleteStatus(deleted);

        navigationManager.NavigateTo("/passwordManager");
    }

    private void ShowDeleteStatus(bool deleted)
    {
        if (deleted)
        {
            StatusAlertService.Success(@Texts.SecretDeletedText);
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret!.Note.SecretDesc = args?.Value?.ToString();
    }

    private void NavigateToEdit()
    {
        SecretViewModel secret = secretService.CurrentSecret!;
        if (secret != null)
        {
            string url = secret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Note => $"/editnote"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigationManager.NavigateTo(url);
            }
        }
    }

    private bool isNoteVisible = false;

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "noteInput" && isNoteVisible)
        {
            isNoteVisible = false;
        }
        StateHasChanged();
    }

    private void VisibleReadOnlySecret(bool isVisible)
    {
        isNoteVisible = isVisible;
        StateHasChanged();
    }

    private string GetValue(bool isVisible, string value)
    {
        return isVisible ? value : Texts.ClickToShowText;
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}