@using AxCrypt.App.Shared.ViewModels.Secret
@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Models.Secret
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using static AxCrypt.Abstractions.TypeResolve
@using Microsoft.Maui.ApplicationModel;

@inject IStatusAlertService StatusAlertService
@inject NavigationManager navigation
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IJSRuntime js

@*
    View Password — read-only detail panel.

    Uses the shared .pm-form-* chrome plus .pm-form-display rows for
    read-only values with inline copy / show-password micro-buttons.
*@

<div class="page-content-body-section">

    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    <div class="pm-form-shell">

        <div class="pm-form-header">
            <NavLink class="pm-form-back" href="passwordManager" title="Back to passwords">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </NavLink>
            <div class="pm-form-titles">
                <h2 class="pm-form-title">@(secretService.CurrentSecret?.Password?.SecretDesc ?? Texts.ViewPasswordTitle)</h2>
                <p class="pm-form-sub">@Texts.PassphrasePrompt</p>
            </div>
            <span class="pm-type-badge pm-type-badge--password" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </span>
        </div>

        <div class="pm-form-body">

            <div class="pm-form-row">
                <label>@Texts.PasswordUrlPrompt</label>
                @if (IsValidUrl(secretService.CurrentSecret!.Password.Url))
                {
                    <div class="pm-form-display">
                        <button type="button"
                                class="pm-form-display-value"
                                style="background:none; border:none; padding:0; cursor:pointer; color:#1d4ed8; text-decoration:underline; text-align:left;"
                                @onclick="() => OpenUrlAsync(secretService.CurrentSecret.Password.Url)">
                            @secretService.CurrentSecret.Password.Url
                        </button>
                    </div>
                }
                else
                {
                    <div class="pm-form-display">
                        <span class="pm-form-display-value">@(string.IsNullOrEmpty(secretService.CurrentSecret.Password.Url) ? "—" : secretService.CurrentSecret.Password.Url)</span>
                    </div>
                }
            </div>

            <div class="pm-form-row">
                <label>@Texts.UserNamePrompt</label>
                <div class="pm-form-display">
                    <span class="pm-form-display-value">@(string.IsNullOrEmpty(secretService.CurrentSecret.Password.Username) ? "—" : secretService.CurrentSecret.Password.Username)</span>
                    @if (!string.IsNullOrEmpty(secretService.CurrentSecret.Password.Username))
                    {
                        <div class="pm-form-display-actions">
                            <button type="button"
                                    class="pm-form-mini-btn"
                                    title="@Texts.SecretsCopytoClipboard"
                                    @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(secretService.CurrentSecret!.Password.Username)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="pm-form-row">
                <label>@Texts.PassphrasePrompt</label>
                <div class="pm-form-display">
                    <span id="passwordInput"
                          class="pm-form-display-value"
                          style="font-family: 'Courier New', monospace; cursor: pointer;"
                          @onclick="() => VisibleReadOnlySecret(true)">
                        @viewSecretViewModel.GetValue(isPasswordVisible, secretService.CurrentSecret.Password.SecretValue)
                    </span>
                    <div class="pm-form-display-actions">
                        <button type="button"
                                class="pm-form-mini-btn"
                                title="@(isPasswordVisible ? "Hide" : "Show")"
                                @onclick="() => VisibleReadOnlySecret(!isPasswordVisible)">
                            @if (isPasswordVisible)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                        <button type="button"
                                class="pm-form-mini-btn"
                                title="@Texts.SecretsCopytoClipboard"
                                @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(secretService.CurrentSecret!.Password.SecretValue)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="9" y="9" width="13" height="13" rx="2"/>
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                            </svg>
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(CopyToClipboardUtility.CopiedInfoText))
                {
                    <span style="color: #48772C; font-size: 11.5px; font-weight: 600;">@CopyToClipboardUtility.CopiedInfoText</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(secretService.CurrentSecret.Password.SecretDesc))
            {
                <div class="pm-form-row">
                    <label>@Texts.DescriptionLabel</label>
                    <div class="pm-form-display">
                        <span class="pm-form-display-value">@secretService.CurrentSecret.Password.SecretDesc</span>
                    </div>
                </div>
            }

            @if (secretService.CurrentSecret.SharedWith != null
                 && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail)
            {
                <div class="pm-form-row">
                    <label>@Texts.OwnerEmailText</label>
                    <div class="pm-form-display">
                        <span class="pm-form-display-value">@secretService.CurrentSecret.OwnerEmail</span>
                    </div>
                </div>
            }
        </div>

        <div class="pm-form-footer">
            @if (viewSecretViewModel.HasPaidSubscription)
            {
                <button type="button" class="pm-btn pm-btn--danger" @onclick="async () => await DeleteSecret()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-2 14a2 2 0 01-2 2H9a2 2 0 01-2-2L5 6"/>
                    </svg>
                    @Texts.ButtonDeleteText
                </button>
            }
            @if (viewSecretViewModel.HasPaidSubscription
                 && secretService.CurrentSecret.OwnerEmail == viewSecretViewModel.UserEmail)
            {
                <button type="button" class="pm-btn pm-btn--primary" @onclick="NavigateToEdit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.12 2.12 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                    Edit
                </button>
            }
        </div>

        <ShareSecretComponent />
    </div>
</div>

@code {
    bool isPasswordVisible = false;
    ShareSecretViewModel? shareSecretViewModel;

    protected override void OnInitialized()
    {
        viewSecretViewModel.UserEmail = Core.Resolve.KnownIdentities.DefaultEncryptionIdentity.UserEmail.Address;

        if (secretService.CurrentSecret == null)
        {
            navigation.NavigateTo("/error");
        }

        viewSecretViewModel.Secret = secretService.CurrentSecret!;
        shareSecretViewModel = new ShareSecretViewModel(secretService);
        shareSecretViewModel.OnUpdateViewState += UpdateStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "passwordInput");
        }
    }

    private async Task DeleteSecret()
    {
        PopupButtons selectedButton = await New<IPopup>().ShowAsync(PopupButtons.OkCancel, @Texts.AlertText, @Texts.DeleteSecretText, Common.DoNotShowAgainOptions.None);
        bool isConfirmed = selectedButton == PopupButtons.Ok;

        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.TryDeleteSecretAsync();
        ShowDeleteStatus(deleted);

        navigation.NavigateTo("/passwordManager");
    }

    private void ShowDeleteStatus(bool deleted)
    {
        if (deleted)
        {
            StatusAlertService.Success(@Texts.SecretDeletedText);
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }
    }

    private void NavigateToEdit()
    {
        SecretViewModel secret = secretService.CurrentSecret!;
        if (secret != null)
        {
            string url = secret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Password => $"/editpassword"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigation.NavigateTo(url);
            }
        }
    }

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "passwordInput" && isPasswordVisible)
        {
            isPasswordVisible = false;
        }
        StateHasChanged();
    }

    private void VisibleReadOnlySecret(bool isVisible)
    {
        isPasswordVisible = isVisible;
        StateHasChanged();
    }

    void UpdateStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private bool IsValidUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;

        string pattern = @"^(https?:\/\/|www\.)[\w\-]+(\.[\w\-]+)+([\/\w\-\.~:?#\[\]@!$&'()*+,;=%]*)?$";
        return Regex.IsMatch(url, pattern, RegexOptions.IgnoreCase);
    }

    private async Task OpenUrlAsync(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return;
        }

        await Launcher.Default.OpenAsync(uri);
    }
}
