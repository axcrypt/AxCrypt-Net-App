@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject AboutViewModel AboutViewModel
@inject LogOnViewModel LogOnViewModel

@if (IsVisible)
{
    <div class="abt-axc-sec">
        <div id="modal-dialog2" class="modalDialog" style="display: block;">
            <div class="abt-axc text-center">
                <div class="close-img" @onclick="CloseDialog"></div>
                <div style="display:flex; align-items:center; gap: 4%;">
                    <div style="padding: 5% 3%;"><img src="images/default/axcrypt_icon_text.svg" alt="AxCrypt-icon" /></div>
                    <div style="text-align: left; word-break:break-word;">
                        <h3 class="txt-clr">@AboutViewModel.ProductName</h3>
                        <h4 style="font-size:18px">@Texts.FileEncryptionEasyText</h4>

                        <label class="txt-clr">Version:</label>
                        <span class="font-bold sub-head-clr">@AboutViewModel.Version</span> <br />

                        <label class="txt-clr">@AxCrypt.Content.Texts.PromptSubscription:</label>
                        <span style="font-weight:500;font-size:15px;">@AboutViewModel.SubscriptionStatusAndExpiration</span>
                        <br />

                        <label class="txt-clr">@AxCrypt.Content.Texts.AboutUsLinkLabel:</label>
                        <a class="font-small sub-head-clr" style="font-size: 12px;" @onclick="OpenAboutPage">https://www.axcrypt.net/information/axcrypt/</a> <br />

                        <span class="grey-clr" style="font-size:13px;">@AboutViewModel.Copyright</span>
                        <br />

                        <label class="highlight-text">
                            @((MarkupString)(string.Format(Texts.AxCryptAboutDescription1)))
                        </label>
                        <br />

                        <span style="font-size: 12px;">@Texts.AxCryptAboutDescription2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        LogOnViewModel.AboutDialog.OnDialogVisibilityChanged += UpdateDialogState;
        base.OnInitialized();
    }

    void UpdateDialogState(bool canShowDialog)
    {
        InvokeAsync(() =>
        {
            AboutViewModel = new AboutViewModel();
            IsVisible = canShowDialog;
            StateHasChanged();
        });
    }

    void CloseDialog()
    {
        LogOnViewModel.AboutDialog.Close();
    }


    public void OpenAboutPage()
    {
        Core.BrowseUtility.RedirectTo("https://www.axcrypt.net/information/axcrypt/");
    }
}