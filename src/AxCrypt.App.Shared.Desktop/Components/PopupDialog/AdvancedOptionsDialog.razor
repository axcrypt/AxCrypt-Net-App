@implements IDisposable
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.Content

@inject AdvancedOptionsViewModel viewModel

@if (IsVisible)
{
    <div class="axd-backdrop" @onclick="() => viewModel.CancelButton_Click(null!)">
        <div class="axd-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="axd-cfg-title"
             @onclick:stopPropagation>

            @* ── Header ─────────────────────────────────────────── *@
            <header class="axd-header">
                <div class="axd-header-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14" />
                        <path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07" />
                    </svg>
                </div>
                <div class="axd-header-text">
                    <h2 id="axd-cfg-title" class="axd-title">@Texts.ApplicationConfigurationText</h2>
                    <p class="axd-sub">Manage local file paths used by AxCrypt</p>
                </div>
                <button type="button" class="axd-close"
                        @onclick="() => viewModel.CancelButton_Click(null!)"
                        aria-label="Close">×</button>
            </header>

            @* ── Body ─────────────────────────────────────────── *@
            <div class="axd-body">

                @* Config path — read-only *@
                <div class="axd-field">
                    <div class="axd-field-label-row">
                        <label class="axd-label" for="cfg-path">@Texts.ApplicationConfigurationPathText</label>
                        <span class="axd-tooltip-wrap" tabindex="0">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            <span class="axd-tooltip" role="tooltip">@Texts.ApplicationConfigurationSettingsText</span>
                        </span>
                    </div>
                    <input id="cfg-path" type="text"
                           class="axd-input axd-input--readonly"
                           @bind="viewModel.AppConfigPath"
                           readonly="readonly" aria-readonly="true" />
                </div>

                @* Temp path — editable + browse *@
                <div class="axd-field">
                    <div class="axd-field-label-row">
                        <label class="axd-label" for="tmp-path">@Texts.TemporaryFilePathText</label>
                        <span class="axd-tooltip-wrap" tabindex="0">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            <span class="axd-tooltip" role="tooltip">@Texts.TemporarilyStoresText</span>
                        </span>
                    </div>
                    <div class="axd-path-row">
                        <input id="tmp-path" type="text" class="axd-input"
                               @bind="viewModel.TempConfigPath"
                               @oninput="(e) => viewModel.BrowseButton_click(e)" />
                        <button type="button" class="axd-btn axd-btn--ghost"
                                @onclick="(e) => viewModel.BrowseButton_click(e)">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" />
                            </svg>
                            @Texts.BrowseText
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
                {
                    <div class="axd-error" role="alert">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@viewModel.ErrorMessage</span>
                    </div>
                }
            </div>

            @* ── Footer ───────────────────────────────────────── *@
            <footer class="axd-footer">
                <button type="button" class="axd-btn axd-btn--ghost"
                        @onclick="(e) => viewModel.CancelButton_Click(e)">@Texts.ButtonCancelText</button>
                <button type="button" class="axd-btn axd-btn--primary"
                        @onclick="(e) => viewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
            </footer>
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; }

    protected override void OnInitialized()
    {
        viewModel.Initialize();
        viewModel.OnUpdateViewState += UpdateState;
        viewModel.LogOnViewModel.AdvancedOptionsDialog.OnDialogVisibilityChanged += UpdateAdvancedOptionsState;
        base.OnInitialized();
    }

    public void Dispose()
    {
        viewModel.OnUpdateViewState -= UpdateState;
        viewModel.LogOnViewModel.AdvancedOptionsDialog.OnDialogVisibilityChanged -= UpdateAdvancedOptionsState;
    }

    void UpdateAdvancedOptionsState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
