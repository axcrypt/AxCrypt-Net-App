@using AxCrypt.App.Shared.Desktop.ViewModels.Main
@using AxCrypt.Content

@inject AdvancedOptionsViewModel viewModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog">
        <div style="text-align: left;">
            <div class="modal-header text-center" style="display:block; font-weight:600;">
                <span>@Texts.ApplicationConfigurationText</span>
            </div>
            <div class="modal-body">
                <div style="padding-bottom: 15px;">
                    <label>@Texts.ApplicationConfigurationPathText</label>
                    <span class="info-tooltip" style="margin:0px 2px -2px 4px;">
                        <img src="/images/default/IcoInfOld.svg" alt="info"/>
                        <span class="tooltip-text">
                            @Texts.ApplicationConfigurationSettingsText
                        </span>
                    </span><br />
                    <input type="path" @bind="viewModel.AppConfigPath" readonly="readonly" style="width:100%;" />
                </div>
                <label>@Texts.TemporaryFilePathText</label>
                <span class="info-tooltip" style="margin:0px 2px -2px 4px;">
                    <img src="/images/default/IcoInfOld.svg" alt="info" />
                    <span class="tooltip-text">
                        @Texts.TemporarilyStoresText
                    </span>
                </span>
                <div class="center-column">
                    <input type="path" @bind="viewModel.TempConfigPath" @oninput="(e)=> viewModel.BrowseButton_click(e)" style="width:75%;" />
                    <button class="button font-medium success btn-small" @onclick="(e)=> viewModel.BrowseButton_click(e)">@Texts.BrowseText</button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-small" @onclick="(e)=> viewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
                <button class="btn-small font-medium button cancel" @onclick="(e)=> viewModel.CancelButton_Click(e)">@Texts.ButtonCancelText</button>
            </div>
            @if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
            {
                <div class="error-message"> @viewModel.ErrorMessage</div>
            }
        </div>
    </div>
}
<style>
    .info-tooltip {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }

        .info-tooltip img {
            width: 16px;
            height: 16px;
        }

    .tooltip-text {
        visibility: hidden;
        width: 260px;
        background-color: #333;
        color: #fff;
        text-align: left;
        padding: 8px;
        border-radius: 5px;
        position: absolute;
        z-index: 10;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%);
        white-space: normal;
        line-height: 1.4;
        font-size: 13px;
        box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.3);
    }

    .info-tooltip:hover .tooltip-text {
        visibility: visible;
    }
</style>
@code {
    private bool IsVisible { get; set; }

    protected override void OnInitialized()
    {
        viewModel.Initialize();
        viewModel.OnUpdateViewState += UpdateState;
        viewModel.LogOnViewModel.AdvancedOptionsDialog.OnDialogVisibilityChanged += UpdateAdvancedOptionsState;
        base.OnInitialized();
    }

    void UpdateAdvancedOptionsState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
