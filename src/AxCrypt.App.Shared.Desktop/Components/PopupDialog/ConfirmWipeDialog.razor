@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject ConfirmWipeDialogViewModel ConfirmWipeDialogViewModel

@if (IsVisible)
{
    <div class="axd-backdrop">
        <div class="axd-modal">

            <div class="axd-header">
                <div class="axd-header-icon" style="background: rgba(239,68,68,.10); color: #dc2626;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2" />
                    </svg>
                </div>
                <div class="axd-header-text">
                    <p class="axd-title">@Texts.McInfMenuWipe</p>
                    <p class="axd-sub">@Texts.PromptLabelText</p>
                </div>
                <button class="axd-close" @onclick="Button_CancelClicked" aria-label="Close">&times;</button>
            </div>

            <div class="axd-body">
                <div class="tool-warning-banner">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    This operation is <strong>&nbsp;permanent and irreversible</strong>. Files are overwritten with random data before deletion.
                </div>

                <label class="tool-checkbox-row">
                    <input id="dothisforallfiles" type="checkbox" @bind="ConfirmWipeDialogViewModel.OptedCheckAllFiles" />
                    @Texts.ConfirmAllCheckBoxText
                </label>
            </div>

            <div class="axd-footer">
                <button class="axd-btn axd-btn--ghost" @onclick="Button_CancelClicked">@Texts.ButtonCancelText</button>
                <button class="axd-btn axd-btn--ghost" @onclick="Button_NoClicked">@Texts.NoLabel</button>
                <button class="axd-btn axd-btn--danger" @onclick="Button_YesClicked">@Texts.YesLabel</button>
            </div>

        </div>
    </div>
}
@code {
    bool IsVisible = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ConfirmWipeDialogViewModel.ConfirmWipeDialog.OnDialogVisibilityChanged += UpdateConfirmPopDialogState;
    }

    public void Button_YesClicked()
    {
        ConfirmWipeDialogViewModel.OptedNo = false;
        ConfirmWipeDialogViewModel.OptedCancel = false;
        ConfirmWipeDialogViewModel.OptedYes = true;
    }

    public void Button_NoClicked()
    {
        ConfirmWipeDialogViewModel.OptedCancel = false;
        ConfirmWipeDialogViewModel.OptedYes = false;
        ConfirmWipeDialogViewModel.OptedNo = true;
    }

    public void Button_CancelClicked()
    {
        ConfirmWipeDialogViewModel.OptedYes = false;
        ConfirmWipeDialogViewModel.OptedNo = false;
        ConfirmWipeDialogViewModel.OptedCancel = true;
    }

    void UpdateConfirmPopDialogState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged(); // Refresh UI
        });
    }
}