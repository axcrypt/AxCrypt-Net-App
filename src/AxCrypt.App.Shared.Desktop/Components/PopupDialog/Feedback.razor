@using AxCrypt.App.Shared.ViewModels.Feedback
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content

@inject FeedbackViewModel FeedbackViewModel

@if (IsVisible)
{
    <div id="modal-dialog3" class="modalDialog fdbck-popup" style="display: block;">
        <div class="text-center">
            <div class="close-img" @onclick="Close"></div>
            <img class="fdbck-img" src="" alt="feedback-img" />
            <p class="bold-highlight sub-head-clr"> @((MarkupString)(string.Format(Texts.FeedbackText)))</p>
            @if (!string.IsNullOrEmpty(FeedbackViewModel.ErrorMessage))
            {
                <div class="error-message">@FeedbackViewModel.ErrorMessage</div>
            }
            <div>
                <div class="flex-start" style="min-height:32px;">
                    @foreach (FeedbackSubject subject in FeedbackViewModel.AllSubject)
                    {
                        <button class="button btn-small @(subject == FeedbackViewModel.SelectedSubject ? "highlighted font-medium" : "")" style="margin-bottom: 0px;"
                                @onclick="() => FeedbackViewModel.SelectSubject(subject)">
                            @subject.ToString()
                        </button>
                    }
                </div>

                <div class="align-items" style="gap: 4%;">
                    <textarea id="userInput" @bind="FeedbackViewModel.UserInput" rows="5" cols="30" style="margin-top: 0px;"></textarea>
                </div>
                <input type="button" @onclick="FeedbackViewModel.HandleFormSubmit" class="button success btn-medium font-medium" value="Submit" style="margin-right: 15px; padding: 6px 0px;" />
                <input type="button" @onclick="Close" class="button border btn-medium font-medium" value="Cancel" style="" />
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        FeedbackViewModel.LogOnViewModel.FeedbackDialog.OnDialogVisibilityChanged += UpdateDialogState;
    }

    void UpdateDialogState(bool canShowDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowDialog;
            StateHasChanged();
        });
    }

    void Close()
    {
        FeedbackViewModel.UserInput = "";
        FeedbackViewModel.ErrorMessage = "";
        FeedbackViewModel.LogOnViewModel.FeedbackDialog.Close();
    }
}
