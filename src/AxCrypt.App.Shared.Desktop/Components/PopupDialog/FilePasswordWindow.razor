@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject UserFilePasswordViewModel filePasswordWindow

@implements IDisposable

@if (filePasswordWindow.ViewModel != null && filePasswordWindow.IsWindowActive)
{
    <div class="fpw-overlay">
        <div class="fpw-modal">
            <div class="fpw-header">
                <div class="fpw-icon">🔐</div>
                <div class="fpw-header-text">
                    <div class="fpw-title">@Texts.DialogFilePasswordTitle</div>
                </div>
            </div>
            <div class="fpw-file"><img src="images/IcoRecDefault.svg" alt="" /> @filePasswordWindow.ViewModel?.FileName</div>
            <div class="fpw-body">
                @* Description copy depends on session state:
                   • signed in     → just "Enter the password to decrypt this file."
                   • not signed in → also mentions that a matching password signs them in.
                   Old condition was backwards (used UserSettings.UserEmail, which can
                   linger after sign-out). IsLoggedOn is the authoritative source. *@
                <p class="axx-desc">
                    @if (filePasswordWindow.LogOnViewModel?.IsLoggedOn == true)
                    {
                        @:Enter the password to decrypt this file.
                    }
                    else
                    {
                        @:Enter the password to decrypt this file. If it matches your account password, you'll also be signed in.
                    }
                </p>
                <div class="fpw-group">
                    <label>@Texts.PassphrasePrompt</label>
                    <div class="fpw-password-wrap" style="position:relative; display:inline-block; width:100%;">
                        <i class="@PasswordIconClass" @onclick="TogglePassword"></i>
                        <input class="fpw-input pswd-img" type="@(filePasswordWindow.ViewModel!.ShowPassword ? "text" : "password")" @bind="filePasswordWindow.ViewModel.PasswordText" 
                            @bind:event="oninput" placeholder="@Texts.FilePasswordHereText" @onkeydown="HandleKeyDown" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(filePasswordWindow.ErrorMessage))
                {
                    <div class="fpw-error">
                        @filePasswordWindow.ErrorMessage
                    </div>
                }
            </div>
            <div class="fpw-footer">
                <button class="fpw-btn cancel" @onclick="filePasswordWindow.CancelButton_Click"> @Texts.ButtonCancelText </button>
                <button class="fpw-btn confirm" @onclick="filePasswordWindow.OkButton_Click" disabled="@(IsOkDisabled)"> @Texts.ButtonOkText </button>
            </div>
        </div>
    </div>
}

<style>
    /* The FilePasswordWindow renders inside its own dedicated MAUI
       Window (FilePasswordWindowService.cs). That OS window is sized
       to match the modal (480x420), so the scrim no longer needs to
       cover a big page — it just fills the small window. Keep a thin
       transparent border so the rounded corners on the modal still
       read against the OS frame. */
    .fpw-overlay {
        position: fixed;
        inset: 0;
        background: #f6f8f5; /* matches the rest of the dialog chrome */
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        padding: 0;
        z-index: 1000;
    }

    /* Fills the OS window — the window itself is the modal frame now.
       border-radius lives on the OS frame, so we just keep clean
       internal edges. */
    .fpw-modal {
        width: 100%;
        height: 100%;
        background: #fff;
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .fpw-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid #eee;
        flex-shrink: 0;
        background-color: #48772C;
    }

    .fpw-header-text {
        text-align: center;
    }

    .fpw-icon {
        width: 32px;
        height: 32px;
        background: #eaf3de;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 16px;
    }

    .fpw-title {
        font-size: 16px;
        font-weight: 600;
        color: white;
    }

    /* Filename row — kept short so a long path doesn't blow up the
       modal height; the long-word break is still active. */
    .fpw-file {
        font-size: 13px;
        color: #444;
        word-break: break-all;
        font-weight: 600;
        margin: 12px 18px 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .fpw-file img {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .fpw-body {
        padding: 12px 18px 8px;
        overflow-y: auto;
    }

    .axx-body {
        padding: 20px 24px;
    }

    .axx-desc {
        font-size: 13px;
        color: #666;
        line-height: 1.5;
        margin: 0 0 16px;
    }

    .fpw-group {
        margin-bottom: 14px;
    }

        .fpw-group label {
            font-size: 12px;
            color: #666;
            margin-bottom: 4px;
            display: block;
        }

    .fpw-input {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .fpw-password-wrap {
        position: relative;
    }

    .fpw-eye {
        position: absolute;
        right: 8px;
        top: 6px;
        border: none;
        background: none;
        cursor: pointer;
    }

    .fpw-error {
        margin-top: 8px;
        padding: 8px;
        border-radius: 6px;
        background: #fdecea;
        color: #c00;
        font-size: 15px;
        font-weight: 600;
    }

    .fpw-footer {
        display: flex;
        gap: 10px;
        padding: 12px 18px 16px;
        flex-shrink: 0;
    }

    .fpw-btn {
        flex: 1;
        height: 38px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

        .fpw-btn.cancel {
            background: #f1f1f1;
            border: 1px solid #ccc;
        }

        .fpw-btn.confirm {
            background: #48772C;
            color: white;
            border: none;
        }

            .fpw-btn.confirm:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

    .fpw-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid #cbd5e1;
        border-top-color: white;
        border-radius: 50%;
        animation: fpw-spin 0.7s linear infinite;
    }

    @@keyframes fpw-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .fpw-note {
        background: #f5f5f5;
        border-radius: 6px;
        padding: 10px;
        font-size: 12px;
        color: #666;
        margin-bottom: 14px;
    }

    .fpw-success {
        margin-top: 10px;
        padding: 10px;
        border-radius: 6px;
        background: #eaf3de;
        color: #3b6d11;
        font-size: 13px;
    }

</style>

@code {
    public bool IsVisible { get; set; }
    public bool ShowPassword { get; set; }
    public string? Password { get; set; }
    public string? File { get; set; }
    private bool isReadOnly { get; set; }
    private const string _title = "AxCrypt file encryption";
    protected override void OnInitialized()
    {
        filePasswordWindow.LogOnViewModel = AxCrypt.App.Shared.Helpers.AxCServiceProviderExtension.LogOnViewModel;

        filePasswordWindow.UserEmail = !string.IsNullOrEmpty(AxCrypt.Core.Resolve.UserSettings.UserEmail) ? AxCrypt.Core.Resolve.UserSettings.UserEmail : "";

        // Always start with the password obscured. The underlying
        // FilePasswordViewModel can leak ShowPassword=true across
        // opens (the property is bound in the service for visibility
        // events), so we explicitly reset both the inner VM flag and
        // the local eye-icon flag every time this Razor component
        // mounts — which is once per OS window the service opens.
        isPasswordVisible = false;
        if (filePasswordWindow.ViewModel != null)
        {
            filePasswordWindow.ViewModel.ShowPassword = false;
        }

        // Handlers held in fields so Dispose can detach them. The
        // file-password window opens repeatedly; subscribing anonymous
        // lambdas straight to += on these long-lived view-models would
        // leave a dangling reference behind on every open.
        _onUpdateViewState = async () => await UpdateStateAsync();
        filePasswordWindow.OnUpdateViewState += _onUpdateViewState;
        filePasswordWindow.LogOnViewModel.OnUpdateViewState += _onUpdateViewState;
        base.OnInitialized();
    }

    public void Dispose()
    {
        if (_onUpdateViewState != null)
        {
            filePasswordWindow.OnUpdateViewState -= _onUpdateViewState;
            if (filePasswordWindow.LogOnViewModel != null)
            {
                filePasswordWindow.LogOnViewModel.OnUpdateViewState -= _onUpdateViewState;
            }
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    // Held for unsubscription in Dispose (see OnInitialized).
    private Action? _onUpdateViewState;

    private bool isPasswordVisible = false;

    private string PasswordInputType => isPasswordVisible ? "text" : "password";

    private string PasswordIconClass => isPasswordVisible ? "fa-eye-slash" : "fa-eye";

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        filePasswordWindow.ViewModel!.ShowPassword = !filePasswordWindow.ViewModel!.ShowPassword;
    }

    bool IsOkDisabled => string.IsNullOrWhiteSpace(filePasswordWindow?.ViewModel?.PasswordText);

    private void OnPasswordChanged(ChangeEventArgs e)
    {
        filePasswordWindow.ViewModel.PasswordText = e.Value?.ToString();
        filePasswordWindow.ErrorMessage = "";
    }

    void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsOkDisabled)
        {
            filePasswordWindow.OkButton_Click(null!);
        }
        else if (e.Key == "Escape")
        {
            filePasswordWindow.CancelButton_Click(null!);
        }
    }

    private void HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            filePasswordWindow.OkButton_Click(null!);
        }
    }

    async Task UpdateStateAsync(bool isVisible = false)
    {
        if (filePasswordWindow.ViewModel != null)
        {
            await InvokeAsync(() =>
            {
                StateHasChanged();
            });
        }
    }
}