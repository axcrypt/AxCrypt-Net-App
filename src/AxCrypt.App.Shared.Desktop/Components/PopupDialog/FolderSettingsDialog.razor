@using AxCrypt.App.Shared.ViewModels;
@using AxCrypt.Content;
@using AxCrypt.App.Shared.Utility;

@inject FolderSettingsViewModel FolderSettingsViewModel

@if (IsVisible)
{
    <div class="modalDialog folderSettings-popup" style="display: block;">
        <div id="folderSettings">
            <h3 class="font-bold text-center folderSettings-title dk-shre">@Texts.FolderSettingsTitle</h3>
            <div class="folderSettings-content">
                <div class="image-container">
                    <img src="/images/SecuredFolderHeaderTitle.svg" />
                </div>
                @if (FolderSettingsViewModel.SelectedFilesOrFolders != null && FolderSettingsViewModel.SelectedFilesOrFolders.Any())
                {
                    <div class="center-column fle-exton-img" >
                        @foreach (string file in FolderSettingsViewModel.SelectedFilesOrFolders)
                        {
                            string selectedFileName = GetIconForFile(file);
                            <div class="selected-file" style="width: 100% !important;">
                                <img class="@Icon" src="/images/default/AxCrypt_Icon.svg" alt="File Icon" />
                                <span class="fle-nme" style="margin: 2px 0px;width:100%;" title="@selectedFileName">@selectedFileName</span>
                            </div>
                        }
                    </div>
                }
                <div class="dk-shre">
                    <span class="font-bold">@Texts.PathText</span>
                </div>
                <div>
                    @if (!string.IsNullOrEmpty(FolderSettingsViewModel.ErrorMessage))
                    {
                        <div class="error-message">@FolderSettingsViewModel.ErrorMessage</div>
                    }
                    <div class="add-txt-field" style="width: 100%;">
                        <input type="text" id="folderPath-inp" @bind="@FolderSettingsViewModel.FoldersInput" disabled class="" style="width: 84%;margin: 0px;" />
                        <input type="button" class="button border btn-small" value="@Texts.BrowseText" @onclick="async (ss) => await FolderSettingsViewModel.SelectIgnoreFolder(ss)" style="width: 20%;float: right; margin-right: 10px;" />
                        <input type="button" class="button active btn-small" value="@Texts.AddPromptText" style="width: 15%;float: right;" @onclick="(ss) => FolderSettingsViewModel.AddIgnoredFolder()" />
                    </div>
                    <span>@Texts.ExcludedFoldersText</span>
                    @if (FolderSettingsViewModel.IgnoredFoldersList != null && FolderSettingsViewModel.IgnoredFoldersList.Any())
                    {
                        <div class="user-list-bx share-list scroll-container " id="foldersList" style="margin-right:0px; min-height: 100px; height: 0px;">
                            @foreach (String folderPath in FolderSettingsViewModel.IgnoredFoldersList!)
                            {
                                <dl>
                                    <dd class="file-bgrnd" >
                                        <div style="display:inline-block;">
                                            <span class="shared-text">@folderPath</span><br>
                                        </div>
                                        <span class="removeCmd" style="float:right;" @onclick="() => FolderSettingsViewModel.RemoveFolder(folderPath)">@Texts.RemoveText</span>
                                        <hr style="width: 100%;">
                                    </dd>
                                </dl>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="file-box empty-list scroll-container" id="foldersList" style="margin-right:0px; min-height: 100px; height: 50px;"></div>
                    }
                    <div>
                        <img class="@Icon" src="/images/default/notifications/IcoInfo.svg" alt="File Icon" />
                        <span style="font-size: 12px;">@Texts.ExcludedFolderNotificationText</span>
                    </div>
                </div>
                <div id="folderSetting" class="folderSettings-ft" style="margin: 10px 0px; float:right;">
                    <input type="button" @onclick="Close" class="button border btn-small" value="@Texts.ButtonCancelText" style="margin-right: 10px;" />
                    <input type="button" class="button btn-small active" @onclick="() => FolderSettingsViewModel.ApplyFolderSettings()"
                           value="@Texts.ApplyLabel" style="padding: 6px 0px;" disabled="@(!FolderSettingsViewModel.HasFolderChanges)" />
                </div>
            </div>
        </div>
    </div>
}
@code {

    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        FolderSettingsViewModel.LogOnViewModel.FolderSettingsDialog.OnDialogVisibilityChanged += UpdateDialogStateChnged;
        FolderSettingsViewModel.LogOnViewModel.OnUIStateChanged += UpdateDialogStateChnged;
    }
    void UpdateDialogStateChnged(bool canShowDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowDialog;
            StateHasChanged();
        });
    }

    void UpdateDialogStateChnged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    void Close()
    {
        FolderSettingsViewModel.PageResult = Utility.DialogResult.Cancel;
        UpdateDialogStateChnged();
    }

    private string? Icon { get; set; }
    private string GetIconForFile(string file)
    {
        string fileName = File.Exists(file) ? Path.GetFileName(file) : Directory.Exists(file) ? new DirectoryInfo(file).FullName : string.Empty;

        if (string.IsNullOrEmpty(fileName))
        {
            Icon = string.Empty;
            return string.Empty;
        }

        Icon = fileName.GetIcon();
        return fileName;
    }
}
