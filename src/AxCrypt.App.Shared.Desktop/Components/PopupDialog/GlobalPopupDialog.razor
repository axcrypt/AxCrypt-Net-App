@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core.UI

@using static AxCrypt.Abstractions.TypeResolve

@inject GlobalDialogViewModel versionViewModel

@implements IDisposable

@if (IsVisible)
{
    <div class="axd-backdrop" @onclick="OnBackdropClick">
        <div class="axd-modal axd-modal--narrow"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="gdlg-title"
             @onclick:stopPropagation>

            @* ── Header ──────────────────────────────────────────── *@
            <header class="axd-header">
                <div class="axd-header-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <div class="axd-header-text">
                    <h2 id="gdlg-title" class="axd-title">
                        @versionViewModel.LogOnViewModel!.GlobalViewModel!.Title
                    </h2>
                </div>
                <button type="button" class="axd-close"
                        @onclick="OnBackdropClick"
                        aria-label="Close">×</button>
            </header>

            @* ── Body ────────────────────────────────────────────── *@
            <div class="axd-body gdlg-body">

                @* Message (may contain HTML markup) *@
                <div class="gdlg-message">
                    @((MarkupString)versionViewModel.LogOnViewModel.GlobalViewModel.MessageText!)
                </div>

                @* Don't-show-again checkbox (only when the dialog supports it) *@
                @if (versionViewModel.LogOnViewModel.GlobalViewModel.DontShowAgainOptions != DoNotShowAgainOptions.None)
                {
                    <label class="gdlg-dontshow">
                        <input type="checkbox"
                               class="gdlg-dontshow-check"
                               checked="@versionViewModel.IsCheckboxDontShowThisAgain"
                               @onchange="ToggleCheckbox" />
                        <span>@Texts.DontShowAgainCheckBoxText</span>
                    </label>
                }

            </div>

            @* ── Footer ──────────────────────────────────────────── *@
            <footer class="axd-footer">
                @if (versionViewModel.LogOnViewModel.PopupButtons.Contains(PopupButtons.Cancel))
                {
                    <button type="button" class="axd-btn axd-btn--ghost"
                            @onclick="Button_CancelClicked">
                        @Texts.ButtonCancelText
                    </button>
                }
                @if (versionViewModel.LogOnViewModel.PopupButtons.Contains(PopupButtons.Ok))
                {
                    <button type="button" class="axd-btn axd-btn--primary"
                            @onclick="Button_OkClicked">
                        @Texts.ButtonOkText
                    </button>
                }
            </footer>

        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        versionViewModel.LogOnViewModel!.GlobalPopupDialog.OnDialogVisibilityChanged += UpdateUpgradeVersionDialogState;
    }

    public void Dispose()
    {
        versionViewModel.LogOnViewModel!.GlobalPopupDialog.OnDialogVisibilityChanged -= UpdateUpgradeVersionDialogState;
    }

    private void ToggleCheckbox(ChangeEventArgs e)
    {
        versionViewModel.IsCheckboxDontShowThisAgain = (bool)e.Value!;
    }

    private void UpdateUpgradeVersionDialogState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    private void Button_OkClicked(MouseEventArgs e) =>
        versionViewModel.Button_OkClicked();

    private void Button_CancelClicked(MouseEventArgs e) =>
        versionViewModel.Button_CancelClicked();

    /// <summary>
    /// Backdrop click dismisses with Cancel if that button is present,
    /// otherwise falls through to Ok — preserving each dialog's intent.
    /// </summary>
    private void OnBackdropClick()
    {
        if (versionViewModel.LogOnViewModel!.PopupButtons.Contains(PopupButtons.Cancel))
            versionViewModel.Button_CancelClicked();
        else
            versionViewModel.Button_OkClicked();
    }
}
