@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core.UI

@using static AxCrypt.Abstractions.TypeResolve

@inject GlobalDialogViewModel versionViewModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog">
        <div class="invite-popup">
            <div class="modal-header">
                <label for="title" class="modal-title">@versionViewModel.LogOnViewModel!.GlobalViewModel!.Title</label>
            </div>
            <div class="modal-body">
                <div class="label-text-1">
                    <p style="">@((MarkupString)versionViewModel.LogOnViewModel.GlobalViewModel.MessageText!)</p>
                </div>
                <div class="modal-footer">
                    @if (versionViewModel.LogOnViewModel.PopupButtons.Contains(PopupButtons.Ok))
                    {
                        <button class="button font-medium success btn-small" @onclick="Button_OkClicked"> @Texts.ButtonOkText </button>
                    }

                    @if (versionViewModel.LogOnViewModel.PopupButtons.Contains(PopupButtons.Cancel))
                    {
                        <button class="btn-small font-medium button cancel" @onclick="Button_CancelClicked"> @Texts.ButtonCancelText </button>
                    }
                </div>
                @if (versionViewModel.LogOnViewModel.GlobalViewModel.DontShowAgainOptions != DoNotShowAgainOptions.None)
                {
                    <div>
                        <label> <input class="check-box" type="checkbox" @onchange="(e)=> ToggleCheckbox(e)" checked="@versionViewModel.IsCheckboxDontShowThisAgain" />@Texts.DontShowAgainCheckBoxText</label>
                    </div>
                }
            </div>
        </div>
    </div>
}
<style>
    .label-text-1 {
        font-size: 14px;
        white-space: pre-wrap;
        text-align: left;
        max-height: 350px;
        overflow-y: auto;
        margin-bottom: 20px;
    }
</style>
@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        versionViewModel.LogOnViewModel!.GlobalPopupDialog.OnDialogVisibilityChanged += UpdateUpgradeVersionDialogState;
    }

    private void ToggleCheckbox(ChangeEventArgs e)
    {
        versionViewModel.IsCheckboxDontShowThisAgain = (bool)e.Value!;
    }

    void UpdateUpgradeVersionDialogState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    private void Button_OkClicked(MouseEventArgs e)
    {
        versionViewModel.Button_OkClicked();
    } 
    
    private void Button_CancelClicked(MouseEventArgs e)
    {
        versionViewModel.Button_CancelClicked();
    }
}