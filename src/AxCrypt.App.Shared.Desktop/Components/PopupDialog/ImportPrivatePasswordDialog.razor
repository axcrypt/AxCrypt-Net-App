@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content

@inject ImportPrivateKeyViewModel viewModel

@if (IsVisible)
{
    <div class="modalDialog">
        <div class="modal-content">
            <h3 style="text-align:center;color:#198754; margin-bottom:20px;font-weight:800;">@Texts.DialogImportPrivateAxCryptIdTitle</h3>

            <div class="add-txt-field" style="width: 100%; display: inline-flex; align-items: baseline;gap:10px;">
                <label style="text-align:center;">@Texts.DialogImportPrivateAxCryptIdAccessIdPrompt : </label>
                <input type="email" style="width:55%" @bind="viewModel.PrivateKeyFileName" @oninput="viewModel.ClearErrorProviders" />
                <button class="button font-medium success btn-large" style="width:18%;padding:9px;" @onclick=" viewModel.BrowsePrivateKeyFile">@Texts.BrowseText</button>
            </div>

            <div style="width: 100%; display: inline-flex; align-items: baseline;gap:10px;">
                <label>@Texts.PassphrasePrompt : </label>
                <input type="@(viewModel.ShowPassPhrase ? "text" : "password")" style="width:78%;" @bind-value="viewModel.PasswordText" @oninput="viewModel.ClearErrorProviders" />
            </div>
            <div>
                <input type="checkbox" @bind="@viewModel.ShowPassPhrase" />
                <span class="grey-clr font-medium" @onchange="@ToggleShowPassword">@Texts.ShowPasswordOptionPrompt</span>
            </div>
            <div class="button-group" style="width: 100%; float: right; padding-top: 15px; gap: 10px; display: flex; justify-content: center;">
                <button class="button font-medium success btn-large" @onclick="(e) => viewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
                <button class="btn-large font-medium button cancel" @onclick="Cancel">@Texts.ButtonCancelText</button>
            </div>

            @if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
            {
                <div class="error">@viewModel.ErrorMessage</div>
            }
        </div>
    </div>
}

<style>
    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
        display: none;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 10px;
    }

    .error {
        color: red;
    }
</style>

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        viewModel.ImportPrivateKeyDialog.OnDialogVisibilityChanged += UpdateImportPrivateKeyState;
    }

    private void ToggleShowPassword(ChangeEventArgs e)
    {
        viewModel.ShowPassPhrase = (bool)e.Value;
    }

    void UpdateImportPrivateKeyState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    private void Cancel()
    {
        viewModel.ImportPrivateKeyDialog.Close();
        viewModel.ErrorMessage = "";
        viewModel.PrivateKeyFileName = "";
        viewModel.PasswordText = "";
    }
}
