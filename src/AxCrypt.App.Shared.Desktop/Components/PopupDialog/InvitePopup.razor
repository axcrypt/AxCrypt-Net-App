@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content

@inject InviteViewModel InviteViewModel

@if (IsVisible)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div>
                <div class="close-img" @onclick="ClosePopup"></div>
                <div class="center-column">
                    <div>
                        <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" />
                        <br /><br />
                        <span class="text-center font-bold" style="font-size: 20px;">
                            @Texts.InviteFriendAxCryptText
                        </span>
                    </div>
                    <div class="invite-text">
                        <span class="grey-clr">@Texts.DialogInviteUserPromptLabelText</span><br />
                        @if (InviteViewModel.InviteUserDisabled)
                        {
                            <input type="text" id="inviteFriend" name="inviteFriend" placeholder=@Texts.FriendsEmailText @bind-value="@InviteViewModel.InvitedUser" disabled="disabled">
                        }
                        else
                        {
                            <input type="text" id="inviteFriend" name="inviteFriend" placeholder=@Texts.FriendsEmailText @bind-value="@InviteViewModel.InvitedUser">
                        }
                        @if (!string.IsNullOrEmpty(InviteViewModel.ErrorMessage))
                        {
                            <div class="error-message">@InviteViewModel.ErrorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="button font-medium success btn-large" @onclick="()=> InviteViewModel.InviteFriend()">@Texts.Invite!</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        InviteViewModel.LogOnViewModel.InviteDialog.OnDialogVisibilityChanged += UpdateInviteDialogState;
    }

    private void UpdateInviteDialogState(bool canShowInviteDialog)
    {
        InvokeAsync(() =>
        {
            InviteViewModel.Initialize();
            IsVisible = canShowInviteDialog;
            StateHasChanged(); // Refresh UI
        });
    }

    private void ClosePopup()
    {
        InviteViewModel.Initialize();
        InviteViewModel.LogOnViewModel.InviteDialog.Close();
    }
}