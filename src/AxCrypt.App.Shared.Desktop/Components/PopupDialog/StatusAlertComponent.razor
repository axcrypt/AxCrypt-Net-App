@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content

@inject IStatusAlertService StatusAlertService

@if (IsVisible)
{
    <div class="medium-11 columns">
        <div data-alert class="alert-box @NotificationStyleClass radius">
            <span style="white-space: break-spaces;">@Body</span>
            <a class="clse-img" style="float: right; color:white; cursor: pointer;" @onclick="ClosePopup">X</a>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        StatusAlertService.OnPopupVisibilityChanged += UpdatePopupVisibility;
    }

    private void UpdatePopupVisibility(bool isVisible)
    {
        IsVisible = isVisible;
        Body = StatusAlertService.Alert;

        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private void ClosePopup()
    {
        StatusAlertService.Hide();
    }

    public bool IsVisible { get; set; }

    public string? NotificationStyleClass => StatusAlertService.Type switch
    {
        AlertNotificationType.Success => Texts.SuccessText,
        AlertNotificationType.Warning => Texts.AlertText,
        _ => Texts.AlertText
    };

    [Parameter]
    public string? Body { get; set; }
}
