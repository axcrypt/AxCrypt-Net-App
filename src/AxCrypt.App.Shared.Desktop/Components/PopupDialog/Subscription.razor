@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

@* ── Subscription upsell panel ─────────────────────────────────────────
   Replaces the old table-layout, broken-image, inline-style cards.
   Two side-by-side pricing cards: Premium (green) + Business (dark).
   Mobile-app download row sits below, using inline SVGs instead of
   empty <img> tags. All view-model hooks preserved 1:1.
*@
<div class="sub-panel">

    @* ── Plan cards ──────────────────────────────────────────────── *@
    <div class="sub-cards">

        @* Premium *@
        <div class="sub-card sub-card--premium">
            <div class="sub-card-header">
                <div class="sub-card-badge" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l2.39 5.46L20 8l-4.5 3.45L17 17l-5-2.7L7 17l1.5-5.55L4 8l5.61-.54L12 2z"/>
                    </svg>
                </div>
                <div>
                    <div class="sub-card-name">@Texts.PremiumAccountLabel</div>
                    <div class="sub-card-for">@Texts.ForIndividualsLabel</div>
                </div>
            </div>

            <ul class="sub-feat-list" aria-label="Premium features">
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z"/></svg>
                    @Texts.PricingFeatureListAES256
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
                    @Texts.PricingFeatureListSecuredFolders
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="3.5"/><path d="M10 13l10-10"/><path d="M17 6l3 3"/><path d="M14 9l3 3"/></svg>
                    @Texts.PricingFeatureListKeySharing
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/></svg>
                    Secure Cloud
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    @Texts.PricingFeatureListMobileApps
                </li>
            </ul>

            <button class="sub-cta sub-cta--premium" @onclick="OpenPremiumPage">
                @Texts.UpgradeNowText
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
        </div>

        @* Business *@
        <div class="sub-card sub-card--business">
            <div class="sub-card-header">
                <div class="sub-card-badge" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>
                    </svg>
                </div>
                <div>
                    <div class="sub-card-name">@Texts.BusinessAccountLabel</div>
                    <div class="sub-card-for">@Texts.ForOrganisationsLabel</div>
                </div>
            </div>

            <ul class="sub-feat-list" aria-label="Business features">
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"/><circle cx="17" cy="6" r="2"/><path d="M21 21v-2a4 4 0 00-3-3.86"/></svg>
                    @Texts.PricingFeatureListProfessionalUse
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    @Texts.PricingFeatureListBusinessPrioritySupport
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    @Texts.PricingFeatureListBusinessAdmin
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    @Texts.MasterKeyTitle
                </li>
                <li class="sub-feat-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    @Texts.PricingFeatureListMobileApps
                </li>
            </ul>

            <button class="sub-cta sub-cta--business" @onclick="OpenBusinessPage">
                Upgrade now
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
        </div>
    </div>

    @* ── Mobile app download row ──────────────────────────────────── *@
    <div class="sub-apps" aria-label="Download mobile apps">
        <button class="sub-app-btn" @onclick="DownloadAndroidApp" title="Get it on Google Play">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3l18 9-18 9V3z"/>
            </svg>
            <span>Google Play</span>
        </button>
        <button class="sub-app-btn" @onclick="DownloadiOsApp" title="Download on the App Store">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/>
                <path d="M12 8v4l3 3"/>
            </svg>
            <span>App Store</span>
        </button>
    </div>
</div>


@code{
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    public void OpenBusinessPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}HomeUser/Login?eff=1&reqFrom=Business");
    }

    public void OpenPremiumPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}HomeUser/Login?eff=1&reqFrom=Premium");
    }

    public void DownloadAndroidApp()
    {
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://play.google.com/store/apps/details?id=net.axcrypt.axcrypt2x"));
    }

    public void DownloadiOsApp()
    {
        New<Abstractions.IBrowser>().OpenUri(new Uri("https://apps.apple.com/us/app/axcrypt-file-encryption-new/id6746769422"));
    }
}