@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content

@inject SuggestionViewModel viewModel

<div class="suggestion">
    <div class="sugg-popup @(viewModel.showSugPopup ? "active" : "")">
        <span @onclick="viewModel.DownloadMobileAppLink">@((MarkupString)(string.Format(Texts.MobileApplicationText)))</span>
        <img class="close-img" @onclick="viewModel.ClosePopup" style="right: -10px; top: -10px;" />
        <div class="dwnld-sec" style="margin: 18px 0px 20px;">
            <img class="appstre-img" src="" alt="hand-img" @onclick="viewModel.DownloadiOsApp" />
            <img class="gglplay-img " src="" alt="hand-img" @onclick="viewModel.DownloadAndroidApp" />
        </div>
        <div>
            <span>@((MarkupString)(string.Format(Texts.PasswordGeneratorText)))</span><br />
            <img class="pwdgnrt-img" src="" alt="hand-img" /><br />
            <div style="display:flex; gap: 5px;">
                <button class="button success learn-btn" @onclick="viewModel.PasswordGeneratorLink" style="margin-right: 20px; background-color: #48772c;">
                    <span>@Texts.TryNowLabel</span>
                </button>
                <button class="button learn-btn" style="color: #48772c; background-color: #fff;" @onclick="viewModel.LearnMore">
                    <span>@Texts.LearnMoreLinkLabel</span>
                </button>
            </div>
        </div>
    </div>
</div>
@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        viewModel.showSugPopup = true;
    }
}