@implements IDisposable
@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.User
@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.Content

@inject SwitchUserViewModel SwitchUserViewModel
@inject NavigationManager navigationManager
@inject PopupService popupService

@if (popupService.SwitchUserPopupOpen)
{
    <div class="SwitchUser-backdrop">
        <div class="SwitchUser-popup" role="dialog" aria-modal="true" aria-labelledby="switch-user-title">
            <div class="popup-image-paragraph">
                <span class="switch-user-hero">
                    <img class="popup-image" src="images/prfls_1.svg" alt="Switch user">
                </span>
                <h2 id="switch-user-title" class="switch-user-title">@Texts.SwitchUserButtonText</h2>
                <span class="popup-paragraph">@((MarkupString)string.Format(Texts.SwitchUserPopupText))</span>
            </div>
            <div class="switch-user-list">
                @{
                    IEnumerable<UserProfile> validUserProfiles = SwitchUserViewModel.UserProfilesList.Where(up => up.UserEmail != "");
                    int validProfileCount = validUserProfiles.Count();
                }
                @for (int i = 0; i < validProfileCount; i++)
                {
                    UserProfile email = validUserProfiles.ElementAt(i);
                    <div class="popup-select-emails @(email.Active ? "active" : "")">
                        <button class="switch-user-profile"
                                type="button"
                                @onclick="@(() => SelectEmail(email.UserEmail, email.SubsType))">
                            <img class="Switchuser @ActiveEmailIcon(email.SubsType) @(email.Active ? "active" : "")" alt="@email.SubsType" />
                            <span class="select-email">@email.UserEmail</span>
                        </button>
                        @if (email.Active)
                        {
                            <button class="switch-user-state switch-user-state--active"
                                    type="button"
                                    title="Selected profile"
                                    @onclick="() => SwitchUserViewModel.SwitchUser(email.UserEmail)">&#10003;</button>
                        }
                        else
                        {
                            <button class="switch-user-state switch-user-state--remove"
                                    type="button"
                                    title="Remove user profile"
                                    @onclick="() => SwitchUserViewModel.RemoveUserProfileAsync(email.UserEmail)">&#x2715;</button>
                        }
                    </div>
                }

                @if (validProfileCount < SwitchUserViewModel.MaxUserProfileLimit)
                {
                    <button class="popup-select-emails popup-select-emails--add"
                            type="button"
                            @onclick="async () => await SwitchUserViewModel.OnNewEmail_Clicked()">
                        <span class="switch-user-add-icon">
                            <img src="images/Icon-4.svg" alt="" />
                        </span>
                        <span class="select-email">@Texts.AddNewEmailText</span>
                    </button>
                }
            </div>
            <div class="switch-user-action-section">
                <button class="switch-user-action-btn confirm" type="button" @onclick="async () => await ConfirmSwitchUserAsync()">Confirm</button>
                <button class="switch-user-action-btn cancel" type="button" @onclick="popupService.ToggleSwitchUserPopupOpen">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; }
    // OnUpdateViewState / OnChange are `event Action?` on the VM and the
    // PopupService — not `event Func<Task>?` — so the field types must be
    // Action too. Bridge the sync handler to an async UpdateState() with
    // a fire-and-forget InvokeAsync inside the lambda so the event signature
    // stays Action while we still get UI thread marshalling.
    private Action? _onUpdateViewState;
    private Action? _onPopupChange;

    public void Dispose()
    {
        if (_onUpdateViewState != null)
        {
            SwitchUserViewModel.OnUpdateViewState -= _onUpdateViewState;
            _onUpdateViewState = null;
        }
        if (_onPopupChange != null)
        {
            popupService.OnChange -= _onPopupChange;
            _onPopupChange = null;
        }
    }

    protected override void OnInitialized()
    {
        SwitchUserViewModel.InitializeUserProfiles();

        UserProfile? userProfile = SwitchUserViewModel.UserProfilesList.FirstOrDefault(ue => ue.Active);
        if (userProfile != null)
        {
            SwitchUserViewModel.SelectedProfileUserEmail = userProfile.UserEmail;
            SelectEmail(SwitchUserViewModel.SelectedProfileUserEmail, userProfile.SubsType);
        }

        // UpdateState() already marshals to the UI dispatcher via its
        // own InvokeAsync(StateHasChanged) call, so the Action lambdas
        // just kick it off and discard the returned Task — the Action
        // signature can't await it.
        _onUpdateViewState = () => _ = UpdateState();
        _onPopupChange     = () => _ = UpdateState();
        SwitchUserViewModel.OnUpdateViewState += _onUpdateViewState;
        popupService.OnChange += _onPopupChange;

        //SwitchUserViewModel.LogOnViewModel.SwitchUserDialog.OnDialogVisibilityChanged += async (isVisible) => await UpdateAdvancedOptionsState(isVisible);

        base.OnInitialized();
    }

    private async Task ConfirmSwitchUserAsync(){
        await SwitchUserViewModel.OnConfirm_Clicked();
        popupService.ToggleSwitchUserPopupOpen();
    }

    private void SelectEmail(string userEmail, string subsType)
    {
        SwitchUserViewModel.SwitchUser(userEmail);
    }

    string ActiveEmailIcon(string subscription)
    {
        return "user-avatar";
        // string imageClass = string.Empty;
        // switch (subscription)
        // {
        //     case "Premium":
        //         return imageClass = "premium-sw-icon";
        //     case "Premium-email":
        //         return imageClass = "premium-sw-icons";
        //     case "Business":
        //         return imageClass = "business-sw-icon";
        //     case "PasswordManager":
        //         return imageClass = "password-em-icon";

        //     case "Free":
        //         return imageClass = "free-em-icon";

        //     default:
        //         break;
        // }

        // return imageClass;
    }

    async Task UpdateAdvancedOptionsState(bool isVisible)
    {
        IsVisible = isVisible;
        await UpdateState();
    }

    async Task UpdateState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
