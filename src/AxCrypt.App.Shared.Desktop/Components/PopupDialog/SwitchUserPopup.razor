@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.User
@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.Content

@inject SwitchUserViewModel SwitchUserViewModel
@inject NavigationManager navigationManager

@if (IsVisible)
{
    <div class="SwitchUser-popup">
        <div class="popup-image-paragraph">
            <img class="popup-image" src="images/prfls_1.svg" alt="Switch user" style="display:block; margin:30px auto 16px auto;">
            <span class="popup-paragraph" style="font-size:14px;">@((MarkupString)string.Format(Texts.SwitchUserPopupText))</span>
        </div>
        <div style="max-height: 220px;min-height: 100px;overflow-y:auto;margin: 0 30px;">
            @{
                IEnumerable<UserProfile> validUserProfiles = SwitchUserViewModel.UserProfilesList.Where(up => up.UserEmail != "");
                int validProfileCount = validUserProfiles.Count();
            }
            @for (int i = 0; i < validProfileCount; i++)
            {
                UserProfile email = validUserProfiles.ElementAt(i);
                <div class="popup-select-emails @(email.Active ? "active" : "")">
                    <div @onclick="@(() => SelectEmail(email.UserEmail, email.SubsType))" style="display: inline-block;">
                        <img class="Switchuser @ActiveEmailIcon(email.SubsType) @(email.Active ? "active" : "")" alt="@email.SubsType" />
                        <span class="select-email">@email.UserEmail</span>
                    </div>
                    @if (email.Active)
                    {
                        <span title="Remove user profile" style="color:green;float: right;font-weight: 800;" @onclick="() => SwitchUserViewModel.SwitchUser(email.UserEmail)">&#10003;</span>
                    }
                    else
                    {
                        <span title="Remove user profile" style="color:red;float: right;font-weight: 800;" @onclick="() => SwitchUserViewModel.RemoveUserProfileAsync(email.UserEmail)">&#x2715</span>
                    }
                </div>
            }

            @if (validProfileCount < SwitchUserViewModel.MaxUserProfileLimit)
            {
                <div class="popup-select-emails" style="margin-top: 6px;" @onclick="async () => await SwitchUserViewModel.OnNewEmail_Clicked()">
                    <img class="" src="images/Icon-4.svg" alt="" />
                    <span class="select-email">@Texts.AddNewEmailText</span>
                </div>
            }
        </div>
        <div class="switch-user-action-section">
            <input class="switch-user-action-btn confirm" type="button" value="Confirm" @onclick="async () => await SwitchUserViewModel.OnConfirm_Clicked()" />
            <input class="switch-user-action-btn cancel" type="button" value="Cancel" @onclick="SwitchUserViewModel.OnCancel_Clicked" />
        </div>
    </div>
}

@code {
    private bool IsVisible { get; set; }

    protected override void OnInitialized()
    {
        SwitchUserViewModel.InitializeUserProfiles();

        UserProfile? userProfile = SwitchUserViewModel.UserProfilesList.FirstOrDefault(ue => ue.Active);
        if (userProfile != null)
        {
            SwitchUserViewModel.SelectedProfileUserEmail = userProfile.UserEmail;
            SelectEmail(SwitchUserViewModel.SelectedProfileUserEmail, userProfile.SubsType);
        }

        SwitchUserViewModel.OnUpdateViewState += async () => await UpdateState();
        SwitchUserViewModel.LogOnViewModel.SwitchUserDialog.OnDialogVisibilityChanged += async (isVisible) => await UpdateAdvancedOptionsState(isVisible);

        base.OnInitialized();
    }

    private void SelectEmail(string userEmail, string subsType)
    {
        SwitchUserViewModel.SwitchUser(userEmail);
    }

    string ActiveEmailIcon(string subscription)
    {
        return "user-avatar";
        // string imageClass = string.Empty;
