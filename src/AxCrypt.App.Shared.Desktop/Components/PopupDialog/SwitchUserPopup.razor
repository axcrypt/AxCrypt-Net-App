        //     case "PasswordManager":
        //         return imageClass = "password-em-icon";

        //     case "Free":
        //         return imageClass = "free-em-icon";

        //     default:
        //         break;
        // }

        // return imageClass;
    }

    async Task UpdateAdvancedOptionsState(bool isVisible)
    {
        IsVisible = isVisible;
        await UpdateState();
    }

    async Task UpdateState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}