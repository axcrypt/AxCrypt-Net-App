@implements IDisposable
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject UpgradeSubscriptionViewModel upgradeModel

@if (IsVisible)
{
    <div class="axd-backdrop" @onclick="ClosePopup">
        <div class="axd-modal tug-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tug-title"
             @onclick:stopPropagation>

            <button type="button" class="axd-close tug-close" @onclick="ClosePopup" aria-label="Close">×</button>

            @* ── Hero ─────────────────────────────────────────── *@
            <div class="tug-hero">
                <h2 id="tug-title" class="tug-title">@((MarkupString)Texts.TryUpgradePlanTitle2)</h2>
                <p class="tug-sub">@((MarkupString)string.Format(Texts.TryUpgradePlanSubTitleText1, Texts.FreeTrial + ","))</p>
            </div>

            @* ── Feature grid ─────────────────────────────────── *@
            <div class="tug-body">
                <div class="tug-grid">
                    <div class="tug-feat">
                        <span class="tug-feat-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z"/>
                            </svg>
                        </span>
                        <span>@Texts.TryUpgradePlanFeatureText1</span>
                    </div>
                    <div class="tug-feat">
                        <span class="tug-feat-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/>
                            </svg>
                        </span>
                        <span>@Texts.TryUpgradePlanFeatureText2</span>
                    </div>
                    <div class="tug-feat">
                        <span class="tug-feat-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="7.5" cy="15.5" r="3.5"/>
                                <path d="M10 13l10-10"/><path d="M17 6l3 3"/><path d="M14 9l3 3"/>
                            </svg>
                        </span>
                        <span>@Texts.HipaaBenefitsSubHeading2</span>
                    </div>
                    <div class="tug-feat">
                        <span class="tug-feat-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4"/>
                            </svg>
                        </span>
                        <span>@Texts.PricingFeatureListPasswordManagement</span>
                    </div>
                    <div class="tug-feat">
                        <span class="tug-feat-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>
                            </svg>
                        </span>
                        <span>@Texts.TryUpgradePlanFeatureText5</span>
                    </div>
                    <div class="tug-feat tug-feat--more">
                        <button type="button" class="tug-more-link" @onclick="upgradeModel.OpenPricingPage">
                            @Texts.AndMoreText →
                        </button>
                    </div>
                </div>

                <p class="tug-no-charge">@Texts.TryUpgradePlanNoChargesText</p>

                @* ── Plan choice buttons ───────────────────────── *@
                <div class="tug-choices">
                    <button class="tug-choice tug-choice--premium" @onclick="OpenPremiumPage">
                        <span class="tug-choice-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2l2.39 5.46L20 8l-4.5 3.45L17 17l-5-2.7L7 17l1.5-5.55L4 8l5.61-.54L12 2z"/>
                            </svg>
                        </span>
                        <span class="tug-choice-label">@Texts.TryPremiumHeading</span>
                        <span class="tug-choice-sub">For individuals</span>
                    </button>
                    <button class="tug-choice tug-choice--business" @onclick="OpenBusinessPage">
                        <span class="tug-choice-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>
                            </svg>
                        </span>
                        <span class="tug-choice-label">@Texts.TryBusinessHeading</span>
                        <span class="tug-choice-sub">For organisations</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        upgradeModel.TrySubscriptionDialog.OnDialogVisibilityChanged += UpdateUpgradeDialogState;
    }

    public void Dispose()
    {
        upgradeModel.TrySubscriptionDialog.OnDialogVisibilityChanged -= UpdateUpgradeDialogState;
    }

    public void OpenBusinessPage()
    {
        upgradeModel.OpenBusinessPage();
        ClosePopup();
    }

    public void OpenPremiumPage()
    {
        upgradeModel.OpenPremiumPage();
        ClosePopup();
    }

    private void UpdateUpgradeDialogState(bool canShowUpgradeDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowUpgradeDialog;
            StateHasChanged(); // Refresh UI
        });
    }

    private void ClosePopup()
    {
        upgradeModel.TrySubscriptionDialog.Close();
    }
}