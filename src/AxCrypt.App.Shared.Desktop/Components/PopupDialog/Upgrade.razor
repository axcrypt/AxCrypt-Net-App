@using AxCrypt.App.Shared.ViewModels
@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.Abstractions;
@using AxCrypt.Content;
@using System.Web
@inject LogOnViewModel LogOnModel

@if (IsVisible)
{
    <div id="modal-dialog5" class="modalDialog">
        <div id="UpgradePopup" class="upg-popup text-center">
            <div class="close-img" @onclick="ClosePopup"></div>
            <div>
                <img class="AES256-img" src="" alt="premium-icon" /><br />
                <p style="padding-top:15px;">
                    <strong>@Texts.StrongerProtectionText</strong>
                </p>
                <p>
                    @((MarkupString)Texts.UnlockFeatures)
                </p>
                <div class="center-column" style="padding-top:15px;">
                    <button class="btn-large font-medium grn-bg whte-clr" @onclick="OpenPremiumPage">
                        @Texts.UpgradePromptText
                    </button>
                    <button class="btn-large font-medium button blck-bg whte-clr" @onclick="OpenBusinessPage" style="width: 160px;">
                        @Texts.CreateBusinessText
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LogOnModel.UpgradeDialog.OnDialogVisibilityChanged += UpdateUpgradeDialogState;
    }

    public void OpenBusinessPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}HomeUser/Login?eff=1&reqFrom=Business");
        ClosePopup();
    }

    public void OpenPremiumPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}HomeUser/Login?eff=1&reqFrom=Premium");
        ClosePopup();
    }

    private void UpdateUpgradeDialogState(bool canShowUpgradeDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowUpgradeDialog;
            StateHasChanged(); // Refresh UI
        });
    }

    private void ClosePopup()
    {
        LogOnModel.UpgradeDialog.Close();
    }
}