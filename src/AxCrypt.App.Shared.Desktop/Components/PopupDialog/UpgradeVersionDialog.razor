@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Utility
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content
@using AxCrypt.Core.UI

@inject LogOnViewModel LogOnViewModel

@if (IsVisible)
{
    <div class="upd-backdrop" @onclick="Button_CancelClicked">
        <div class="upd-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="upd-title"
             @onclick:stopPropagation>

            @* ── Close ───────────────────────────────────────── *@
            <button type="button" class="upd-close" @onclick="Button_CancelClicked" aria-label="Dismiss">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>

            @* ── Icon ────────────────────────────────────────── *@
            <div class="upd-icon-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8" />
                    <line x1="4" y1="20" x2="21" y2="3" />
                    <polyline points="21 16 21 21 16 21" />
                    <line x1="15" y1="15" x2="21" y2="21" />
                </svg>
            </div>

            @* ── Badge ───────────────────────────────────────── *@
            <span class="upd-badge">Update available</span>

            @* ── Title & body ────────────────────────────────── *@
            <h2 id="upd-title" class="upd-title">
                @LogOnViewModel.UpgradeVersionViewModel!.Title
            </h2>

            @if (LogOnViewModel.UpgradeVersionViewModel.AvailablePopupButtons!.Length > 1)
            {
                <p class="upd-body">@Texts.UpgradeVersionDialogText</p>

                <div class="upd-actions">
                    <button type="button" class="upd-btn upd-btn--ghost" @onclick="Button_CancelClicked">
                        @Texts.UpgradeVersionDialogText2
                    </button>
                    <button type="button" class="upd-btn upd-btn--primary" @onclick="Button_OkClicked">
                        @Texts.UpgradeVersionDialogText1
                    </button>
                </div>
            }
            else
            {
                <div class="upd-actions upd-actions--center">
                    <button type="button" class="upd-btn upd-btn--primary" @onclick="Button_OkClicked">
                        @Texts.ButtonOkText
                    </button>
                </div>
            }

        </div>
    </div>
}

<style>
    /* ── Backdrop ─────────────────────────────────────────────── */
    .upd-backdrop {
        position: fixed;
        inset: 0;
        z-index: 800;
        background: rgba(15, 23, 42, .55);
        backdrop-filter: blur(3px);
        display: grid;
        place-items: center;
        padding: 24px;
        animation: updBackdropIn .15s ease-out;
    }

    @@keyframes updBackdropIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    /* ── Card ─────────────────────────────────────────────────── */
    .upd-card {
        position: relative;
        width: 100%;
        max-width: 380px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 28px 72px rgba(0, 0, 0, .22);
        padding: 36px 28px 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-align: center;
        animation: updCardIn .22s cubic-bezier(.4, 0, .2, 1);
    }

    @@keyframes updCardIn {
        from { opacity: 0; transform: translateY(10px) scale(.97); }
        to   { opacity: 1; transform: translateY(0)    scale(1);   }
    }

    /* ── Close button ─────────────────────────────────────────── */
    .upd-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        border-radius: 7px;
        color: #9ca3af;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background .13s, color .13s;
    }
    .upd-close:hover { background: #f3f4f6; color: #374151; }

    /* ── Icon circle ──────────────────────────────────────────── */
    .upd-icon-wrap {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(72, 119, 44, .10);
        color: #48772C;
        display: grid;
        place-items: center;
        margin-bottom: 4px;
    }

    /* ── Badge ────────────────────────────────────────────────── */
    .upd-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        background: rgba(72, 119, 44, .10);
        color: #2f5618;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    /* ── Title ────────────────────────────────────────────────── */
    .upd-title {
        margin: 2px 0 0;
        font-size: 18px;
        font-weight: 800;
        color: #111827;
        line-height: 1.3;
    }

    /* ── Body copy ────────────────────────────────────────────── */
    .upd-body {
        margin: 0;
        font-size: 13.5px;
        color: #6b7280;
        line-height: 1.6;
        max-width: 300px;
    }

    /* ── Action row ───────────────────────────────────────────── */
    .upd-actions {
        display: flex;
        gap: 10px;
        width: 100%;
        margin-top: 8px;
    }

    .upd-actions--center { justify-content: center; }

    /* ── Buttons ──────────────────────────────────────────────── */
    .upd-btn {
        flex: 1;
        height: 42px;
        border-radius: 11px;
        font-size: 13.5px;
        font-weight: 700;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .upd-btn--primary {
        background: #48772C;
        color: #fff;
        border-color: #48772C;
    }
    .upd-btn--primary:hover { background: #3f6826; border-color: #3f6826; }

    .upd-btn--ghost {
        background: #fff;
        color: #374151;
        border-color: #d1d5db;
    }
    .upd-btn--ghost:hover { background: #f9fafb; border-color: #9ca3af; }

    /* ── Dark theme ───────────────────────────────────────────── */
    html[data-theme="dark"] .upd-card {
        background: #1c2530;
        box-shadow: 0 28px 72px rgba(0, 0, 0, .55);
    }

    html[data-theme="dark"] .upd-close {
        color: #7a8494;
    }
    html[data-theme="dark"] .upd-close:hover {
        background: #232e3b;
        color: #e8ecf1;
    }

    html[data-theme="dark"] .upd-icon-wrap {
        background: rgba(127, 204, 92, .15);
        color: #b8e89a;
    }

    html[data-theme="dark"] .upd-badge {
        background: rgba(127, 204, 92, .14);
        color: #b8e89a;
    }

    html[data-theme="dark"] .upd-title { color: #f3f4f6; }
    html[data-theme="dark"] .upd-body  { color: #b5bcc7; }

    html[data-theme="dark"] .upd-btn--primary {
        background: #7fcc5c;
        color: #0f1a07;
        border-color: #7fcc5c;
    }
    html[data-theme="dark"] .upd-btn--primary:hover {
        background: #9be076;
        border-color: #9be076;
    }

    html[data-theme="dark"] .upd-btn--ghost {
        background: #1c2530;
        color: #e8ecf1;
        border-color: #3a4554;
    }
    html[data-theme="dark"] .upd-btn--ghost:hover {
        background: #232e3b;
        border-color: #7a8494;
    }
</style>

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        LogOnViewModel!.UpgradeVersionDialog.OnDialogVisibilityChanged += UpdateUpgradeDialogState;
    }

    public void Button_OkClicked()
    {
        LogOnViewModel!.UpgradeVersionDialog.Close();
        LogOnViewModel!.UpgradeVersionViewModel!.SelectedButton = PopupButtons.Ok;
        LogOnViewModel!.UpgradeVersionViewModel.PopupResult = DialogResult.OK;
    }

    public void Button_CancelClicked()
    {
        LogOnViewModel!.UpgradeVersionDialog.Close();
        LogOnViewModel!.UpgradeVersionViewModel!.SelectedButton = PopupButtons.Cancel;
        LogOnViewModel!.UpgradeVersionViewModel.PopupResult = DialogResult.Cancel;
    }

    private void UpdateUpgradeDialogState(bool canShowUpgradeDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowUpgradeDialog;
            StateHasChanged();
        });
    }
}
