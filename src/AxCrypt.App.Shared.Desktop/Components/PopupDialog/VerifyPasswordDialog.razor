@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content

@inject VerifyPasswordViewModel verifyViewModel

@implements IDisposable

@if (IsVisible)
{
    <div class="axd-backdrop" @onclick="verifyViewModel.CancelButton_Click">
        <div class="axd-modal axd-modal--narrow"
             role="dialog"
             aria-modal="true"
             aria-labelledby="vp-title"
             @onclick:stopPropagation>

            @* ── Header ──────────────────────────────────────────── *@
            <header class="axd-header">
                <div class="axd-header-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                </div>
                <div class="axd-header-text">
                    <h2 id="vp-title" class="axd-title">@Texts.SignInVerificationTitle</h2>
                    @if (!string.IsNullOrEmpty(verifyViewModel.VerifyInstructionText))
                    {
                        <p class="axd-sub">@verifyViewModel.VerifyInstructionText</p>
                    }
                </div>
                <button type="button" class="axd-close"
                        @onclick="verifyViewModel.CancelButton_Click"
                        aria-label="Close">×</button>
            </header>

            @* ── Body ────────────────────────────────────────────── *@
            <div class="axd-body">

                <div class="axd-field">
                    <div class="axd-field-label-row">
                        <label class="axd-label" for="vp-password">
                            @Texts.VerifyPasswordPrompt
                        </label>
                    </div>
                    <div class="lp-input-wrap">
                        <input type="@(verifyViewModel.ShowPassphrase ? "text" : "password")"
                               id="vp-password"
                               class="axd-input lp-input--password"
                               placeholder="@Texts.TypeYourPasswordText"
                               @bind-value="@verifyViewModel.PassphraseText"
                               @oninput="OnInputValidate"
                               autocomplete="current-password" />
                        <button type="button"
                                class="lp-eye"
                                tabindex="-1"
                                @onclick="() => verifyViewModel.ShowPassphrase = !verifyViewModel.ShowPassphrase"
                                aria-label="@(verifyViewModel.ShowPassphrase ? "Hide password" : "Show password")">
                            @if (verifyViewModel.ShowPassphrase)
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            }
                            else
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(verifyViewModel.ErrorMessage))
                {
                    <div class="axd-error" role="alert">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span>@verifyViewModel.ErrorMessage</span>
                    </div>
                }

            </div>

            @* ── Footer ──────────────────────────────────────────── *@
            <footer class="axd-footer">
                <button type="button" class="axd-btn axd-btn--ghost"
                        @onclick="verifyViewModel.CancelButton_Click">
                    @Texts.ButtonCancelText
                </button>
                <button type="button" class="axd-btn axd-btn--primary"
                        @onclick="verifyViewModel.ButtonOk_Click">
                    @Texts.ButtonOkText
                </button>
            </footer>

        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        verifyViewModel.LogOnViewModel.VerifyPasswordDialog.OnDialogVisibilityChanged += UpdateConformDialogState;
    }

    public void Dispose()
    {
        verifyViewModel.LogOnViewModel.VerifyPasswordDialog.OnDialogVisibilityChanged -= UpdateConformDialogState;
    }

    private void UpdateConformDialogState(bool canShowConformDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowConformDialog;
            StateHasChanged();
        });
    }

    void OnInputValidate(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value?.ToString()))
        {
            verifyViewModel.ErrorMessage = "";
        }
    }
}
