@* LEGACY — DO NOT USE
   Superseded by ConversionDialog.razor + ConversionDialogConfig.ForBusiness().
No longer mounted in MainLayout — safe to delete once all references are confirmed gone.
*@
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject UpgradeSubscriptionViewModel upgradeModel
@inject NavigationManager navigationManager
@implements IDisposable

@*
    BusinessSubscriptionDialog — the single dedicated conversion
    popup for accounts whose UserService.SignUpFrom resolves to
    Business.

    Why split this out of TryNow / Upgrade:
      Business admins respond to a totally different value pitch
      than a free-tier consumer (audit log, MFA enforcement, group
      management, HIPAA/SOC compliance) — bundling them into a
      tier-switched branch of the consumer dialog was diluting both
      messages. UpgradeSubscriptionViewModel now routes
      Business-originated users straight here, and the generic
      TryNow / Upgrade dialogs handle None / Free / Premium.

    Reuses the .cnv-* design system so the look stays cohesive with
    the other sign-in nudge popups — just with the .cnv-tier--business
    accent (dark gradient) and copy / cards swapped for the
    enterprise audience.

    CTA navigates to /upgradePage where the plan grid (already
    filtered by SignUpFrom) shows Business tiers.
*@

@if (IsVisible)
{
    <div class="cnv-backdrop" @onclick="ClosePopup">
        <div class="cnv-modal cnv-tier--business"
             role="dialog"
             aria-modal="true"
             aria-labelledby="biz-upgrade-title"
             @onclick:stopPropagation>

            <button type="button" class="cnv-close" @onclick="ClosePopup" aria-label="Close">×</button>

            <div class="cnv-hero">
                <div class="cnv-hero-sparkle" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18" />
                        <path d="M5 21V7l8-4v18" />
                        <path d="M19 21V11l-6-4" />
                        <line x1="9" y1="9"  x2="9"  y2="9.01" />
                        <line x1="9" y1="12" x2="9"  y2="12.01" />
                        <line x1="9" y1="15" x2="9"  y2="15.01" />
                        <line x1="9" y1="18" x2="9"  y2="18.01" />
                    </svg>
                </div>
                <span class="cnv-hero-badge">For your whole team</span>
            </div>

            <div class="cnv-body">
                <h2 id="biz-upgrade-title" class="cnv-title">
                    Bring AxCrypt Business back to the team
                </h2>
                <p class="cnv-sub">
                    Restore admin controls, audit trail and key sharing
                    across every seat — security your IT lead can sign off on.
                </p>

                <div class="cnv-grid">
                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                                <polyline points="9 12 11 14 15 10" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Compliance-ready</span>
                            <span class="cnv-card-desc">HIPAA, GDPR, NIS 2 — audit-grade AES-256.</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="7" r="3" />
                                <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                                <circle cx="17" cy="6" r="2" />
                                <path d="M21 21v-2a4 4 0 00-3-3.86" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Group management</span>
                            <span class="cnv-card-desc">Add seats, set roles, revoke keys instantly.</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Master Key Recovery</span>
                            <span class="cnv-card-desc">Prevent data loss with organization-wide recovery access.</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Audit log</span>
                            <span class="cnv-card-desc">Every encrypt, share and access — timestamped.</span>
                        </div>
                    </div>
                </div>

                <button class="cnv-cta" @onclick="OpenUpgradePage">
                    <span>Renew Business plan</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>

                <p class="cnv-risk">Per-seat pricing • Cancel anytime</p>

                <div class="cnv-trust" aria-label="Compliance">
                    <span>AES-256</span>
                    <span class="cnv-trust-dot"></span>
                    <span>HIPAA</span>
                    <span class="cnv-trust-dot"></span>
                    <span>NIS 2</span>
                    <span class="cnv-trust-dot"></span>
                    <span>GDPR</span>
                </div>

                <button class="cnv-dismiss" @onclick="ClosePopup">@Texts.ButtonNotNow</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        upgradeModel.BusinessSubscriptionDialog.OnDialogVisibilityChanged += UpdateDialogState;
    }

    public void Dispose()
    {
        upgradeModel.BusinessSubscriptionDialog.OnDialogVisibilityChanged -= UpdateDialogState;
    }

    /// <summary>
    /// Single in-app funnel destination, same pattern as TryNow / Upgrade
    /// dialogs. /upgradePage's plan grid filters by SignUpFrom, so a
    /// Business-originated user lands directly on the Business tiers.
    /// </summary>
    private void OpenUpgradePage()
    {
        ClosePopup();
        navigationManager.NavigateTo("/upgradePage");
    }

    private void UpdateDialogState(bool canShow)
    {
        IsVisible = canShow;
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private void ClosePopup()
    {
        upgradeModel.BusinessSubscriptionDialog.Close();
    }
}
