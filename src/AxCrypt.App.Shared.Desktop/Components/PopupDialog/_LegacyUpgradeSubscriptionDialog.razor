@* LEGACY — DO NOT USE
   Superseded by ConversionDialog.razor + ConversionDialogConfig.ForUpgrade().
No longer mounted in MainLayout — safe to delete once all references are confirmed gone.
*@
@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject UpgradeSubscriptionViewModel upgradeModel
@inject NavigationManager navigationManager
@implements IDisposable

@*
    UpgradeSubscriptionDialog — sign-in nudge for users no longer
    eligible for a free trial (trial used) and for lapsed Premium /
    Business subscribers.

    Mirrors the conversion-focused TryNow layout (hero banner + 2x2
    value grid + single CTA + trust row + dismiss) so the two dialogs
    feel like one product, with different copy:
      • TryNow → "free trial available"
      • Upgrade → "subscribe / renew"

    Hero badge changes to the price anchor ("from $X / month") instead
    of a free-trial badge. Headline + sub-head pivot to renewal /
    subscription language. Same SignUpFrom-driven tier theming
    (None/Free/Premium/Business) controls accent color and copy
    selection, and the CTA always navigates to the in-app
    /upgradePage so the plan grid finishes the conversion in-app.
*@

@if (IsVisible)
{
    <div class="cnv-backdrop" @onclick="ClosePopup">
        <div class="cnv-modal @TierCssClass"
             role="dialog"
             aria-modal="true"
             aria-labelledby="upgrade-title"
             @onclick:stopPropagation>

            <button type="button" class="cnv-close" @onclick="ClosePopup" aria-label="Close">×</button>

            <div class="cnv-hero">
                <div class="cnv-hero-sparkle" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                        <polyline points="13 8 10 13 14 13 11 17" />
                    </svg>
                </div>
                <span class="cnv-hero-badge">@HeroBadge</span>
            </div>

            <div class="cnv-body">
                <h2 id="upgrade-title" class="cnv-title">@Headline</h2>
                <p class="cnv-sub">@Subhead</p>

                <div class="cnv-grid">
                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L4 6v6c0 5 3.5 10 8 11.35C16.5 22 20 17 20 12V6L12 2z" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">AES-256 everywhere</span>
                            <span class="cnv-card-desc">@Texts.TryUpgradePlanFeatureText1</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Cloud-ready</span>
                            <span class="cnv-card-desc">@Texts.TryUpgradePlanFeatureText2</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="7" r="3" />
                                <path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                                <path d="M17 11l2 2 4-4" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">Share keys safely</span>
                            <span class="cnv-card-desc">@Texts.HipaaBenefitsSubHeading2</span>
                        </div>
                    </div>

                    <div class="cnv-card">
                        <div class="cnv-card-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                        </div>
                        <div class="cnv-card-text">
                            <span class="cnv-card-title">@FourthCardTitle</span>
                            <span class="cnv-card-desc">@FourthCardDesc</span>
                        </div>
                    </div>
                </div>

                <button class="cnv-cta" @onclick="OpenUpgradePage">
                    <span>@CtaLabel</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>

                <p class="cnv-risk">Monthly or yearly • Cancel anytime</p>

                <div class="cnv-trust" aria-label="Compliance">
                    <span>AES-256</span>
                    <span class="cnv-trust-dot"></span>
                    <span>HIPAA</span>
                    <span class="cnv-trust-dot"></span>
                    <span>GDPR</span>
                </div>

                <button class="cnv-dismiss" @onclick="ClosePopup">@Texts.ButtonNotNow</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    private SignUpFrom _signUpFrom = SignUpFrom.None;

    // Business is handled by the dedicated BusinessSubscriptionDialog —
    // UpgradeSubscriptionViewModel routes SignUpFrom == Business there
    // before this popup ever opens, so we only need Premium / generic
    // variants here.
    private string TierCssClass => _signUpFrom switch
    {
        SignUpFrom.Premium  => "cnv-tier--premium",
        _                   => "cnv-tier--generic",
    };

    private string HeroBadge => _signUpFrom switch
    {
        SignUpFrom.Premium  => "Premium plan",
        _                   => "Plans from $5/month",
    };

    private string Headline => _signUpFrom switch
    {
        SignUpFrom.Premium  => "Pick up your Premium plan",
        _                   => "Unlock the full AxCrypt",
    };

    private string Subhead => _signUpFrom switch
    {
        SignUpFrom.Premium  => "Your encrypted files, vault and shared keys are waiting.",
        _                   => "Encryption, key sharing, secured vault and password manager — for the price of a coffee.",
    };

    private string CtaLabel => _signUpFrom switch
    {
        SignUpFrom.Premium  => "Renew Premium",
        _                   => Texts.UpgradePromptText,
    };

    // Fourth card swaps per tier:
    //   None/Free → Password Manager (broad appeal)
    //   Premium   → Vault (premium-exclusive)
    private string FourthCardTitle => _signUpFrom switch
    {
        SignUpFrom.Premium  => "Secured Vault",
        _                   => "Password Manager",
    };

    private string FourthCardDesc => _signUpFrom switch
    {
        SignUpFrom.Premium  => "A dedicated, auto-encrypted folder for sensitive files.",
        _                   => Texts.PricingFeatureListPasswordManagement,
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        upgradeModel.UpgradeSubscriptionDialog.OnDialogVisibilityChanged += UpdateUpgradeDialogState;
    }

    public void Dispose()
    {
        upgradeModel.UpgradeSubscriptionDialog.OnDialogVisibilityChanged -= UpdateUpgradeDialogState;
    }

    private void OpenUpgradePage()
    {
        ClosePopup();
        navigationManager.NavigateTo("/upgradePage");
    }

    private void UpdateUpgradeDialogState(bool canShowUpgradeDialog)
    {
        IsVisible = canShowUpgradeDialog;
        if (IsVisible)
        {
            _signUpFrom = AxCServiceProviderExtension.GetService<UserService>().SignUpFrom;
        }

        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private void ClosePopup()
    {
        upgradeModel.UpgradeSubscriptionDialog.Close();
    }
}
