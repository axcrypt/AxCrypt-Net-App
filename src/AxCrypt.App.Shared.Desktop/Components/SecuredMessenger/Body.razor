@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content;
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Api.Extension

@inject ManageSecMsgrViewModel ManageSecMgrViewModel

@{
    string activeClass = ManageSecMgrViewModel.AnySelected ? "active-btn" : "";
}

<div class="row">
    <div class="medium-5 all-msg" style="padding: 0;">
        <div class="center-column">
            <button class="button fnt-high" style="text-align: left; height: 44px;">
                @if (ManageSecMgrViewModel.isMultiCheckboxVisible || ManageSecMgrViewModel.AnySelected)
                {
                    <input type="checkbox" class="multi-chckbx" title="Select All" checked="@ManageSecMgrViewModel.SelectAllMessages" bind-checked="@ManageSecMgrViewModel.SelectAllMessages" @onchange="ManageSecMgrViewModel.ToggleAllMessages" />
                }
                <span class="mutli-slct-btn">@TabTitleText</span>
                <img class="select-option" src="/images/default/IcoSelect.svg" style="height: 14px;" alt="delete-img" title="Select" @onclick="@ManageSecMgrViewModel.ToggleMultiCheckbox" />
                <div class="slct-actions @activeClass">
                    <img class="multi-dlt" src="" alt="Delete" title="Delete" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("delete"))" />
                    @if (SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent)
                    {
                        <img class="multi-read" src="" alt="Mark Read" title="Read" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("read"))" />
                        <img class="multi-unread" src="" alt="Mark Unread" title="Unread" @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("unread"))" />
                    }
                </div>
            </button>
            <button class="button success new-btn fnt-small" id="create-new-message" @onclick="()=>{ ManageSecMgrViewModel.ComposeNewMessage(); }">
                New Message
            </button>
        </div>
        <div id="all-message-list" class="message-list-section">
            <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.MessagesList />
        </div>
        <a href="javascript:void(0);" id="load-more-btn" @onclick="()=>EnableLoadMoreAction(ManageSecMgrViewModel.Messenger.PageNumber)" class="loadMoreActionlnk"> Load More </a>
    </div>
    <div class="medium-7 columns flex-direction" style="padding:2px 8px; height:auto; max-height:520px; overflow-y:auto;">
        @if ((ManageSecMgrViewModel.Messenger == null || !ManageSecMgrViewModel.Messenger.ChildMessages.Any()) && !ManageSecMgrViewModel.ShowLoadingWheel && !ManageSecMgrViewModel.NewSecMsgrViewModel.IsVisible)
        {
            <div class="text-center empty-sec">
                <span class="fnt-medium deflt-txt-clr">Select an item to read</span><br />
                <span class="fnt-medium grey-clr">No items selected</span><br />
                <img class="inbox-img" src="" alt="inbox-img" />
            </div>
        }
        <div>
            @if (ManageSecMgrViewModel.ShowLoadingWheel)
            {
                <div class="view-section messager-loading" id="messenger-loading-section">
                    <span>@Texts.LoadingText</span>
                </div>
            }
            <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.New />
            <div id="viewer-messenger-section">
                <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.View />
            </div>
        </div>
    </div>
</div>

<EditForm Model="ManageSecMgrViewModel" id="loadmore-button-click">
    <input type="hidden" id="pagenumber-id-hidden" name="pageNumber" value="@ManageSecMgrViewModel.Messenger.PageNumber" />
    <input type="hidden" id="sec-messenger-filter-tab" name="secMessengerFilterTab" value="@SecMessengerFilterTab" />
</EditForm>

@code {

    public SecureMsgrFilterTab SecMessengerFilterTab { get; set; }

    protected override void OnInitialized()
    {
        SecMessengerFilterTab = ManageSecMgrViewModel.Messenger.SecMessengerFilterTab;
        ManageSecMgrViewModel.NewSecMsgrViewModel.IsVisible = false;
        ManageSecMgrViewModel.ShowLoadingWheel = false;

        ManageSecMgrViewModel.OnUpdateViewState += UpdateState;
        ManageSecMgrViewModel.NewSecMsgrViewModel.OnTabUpdateViewState += async (selectedTab) => await UpdateTabState(selectedTab);

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }

    private string TabTitleText
    {
        get
        {
            switch (SecMessengerFilterTab)
            {
                case SecureMsgrFilterTab.Inbox:
                    return "Inbox";
                case SecureMsgrFilterTab.Sent:
                    return "Sent";
                case SecureMsgrFilterTab.Unread:
                    return "Unread";
                default:
                    return "";
            }
        }
    }

    public async Task<bool> EnableLoadMoreAction(int pageNumberCount)
    {
        pageNumberCount += 1;
        SecuredMessengerModel messengerModel = await ManageSecMgrViewModel.LoadMore(pageNumberCount, ManageSecMgrViewModel.Messenger.SecMessengerFilterTab);
        if (ManageSecMgrViewModel.Messenger.Messages != null && messengerModel != null && messengerModel!.Messages.Any())
        {
            ManageSecMgrViewModel.Messenger.Messages = ManageSecMgrViewModel.Messenger.Messages.Concat(messengerModel!.Messages).ToList();
            ManageSecMgrViewModel.UpdateViewState();
            return true;
        }
        return false;
    }


    private async Task UpdateTabState(SecureMsgrFilterTab securedMessengerFilterTab)
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    void UpdateState()
    {
        SecMessengerFilterTab = ManageSecMgrViewModel.Messenger.SecMessengerFilterTab;
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}