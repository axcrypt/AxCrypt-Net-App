@implements IDisposable
@using AxCrypt.Api.SecuredMessenger
@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content;
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Api.Extension

@inject ManageSecMsgrViewModel ManageSecMgrViewModel
@inject IFeatureUsageProvider usage
@inject PaidFeaturegateService paidFeaturegateService

@{
    string activeClass = ManageSecMgrViewModel.AnySelected ? "active-btn" : "";
}

<div class="row smx-body">
    <div class="all-msg" style="padding: 0;">
        @* List-pane header. Bulk-action chip appears only when items are selected. *@
        <div class="center-column smx-list-header">
            <div class="smx-list-header-title">
                <input type="checkbox"
                       class="multi-chckbx"
                       title="Select all"
                       checked="@ManageSecMgrViewModel.SelectAllMessages"
                       @onchange="ManageSecMgrViewModel.ToggleAllMessages" />
                <span class="mutli-slct-btn">@TabTitleText</span>
                <img class="select-option" src="/images/default/IcoSelect.svg"
                     style="height: 14px;" alt="Select" title="Toggle selection mode"
                     @onclick="@ManageSecMgrViewModel.ToggleMultiCheckbox" />
            </div>

            <span class="smx-list-header-spacer"></span>

            @if (ManageSecMgrViewModel.AnySelected)
            {
                <div class="smx-list-header-actions smx-list-header-actions--active" aria-label="Bulk actions">
                    <button type="button" class="smx-bulk-btn smx-bulk-btn--danger" title="Delete"
                            @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("delete"))">
                        <img class="multi-dlt" src="" alt="Delete" />
                    </button>
                    @if (SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent)
                    {
                        <button type="button" class="smx-bulk-btn" title="Mark as read"
                                @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("read"))">
                            <img class="multi-read" src="" alt="Read" />
                        </button>
                        <button type="button" class="smx-bulk-btn" title="Mark as unread"
                                @onclick="@(() => ManageSecMgrViewModel.MultiActionAsync("unread"))">
                            <img class="multi-unread" src="" alt="Unread" />
                        </button>
                    }
                </div>
            }

            <button class="button success fnt-small smx-new-btn"
                    id="create-new-message"
                    title="Compose new secured message"
                    @onclick="OnComposeNewMessage">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <span class="smx-new-btn-label">@Texts.NewMessageText</span>
            </button>
        </div>
        <div id="all-message-list" class="message-list-section">
            <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.MessagesList />
        </div>
        <a href="javascript:void(0);" id="load-more-btn" @onclick="()=>EnableLoadMoreAction(ManageSecMgrViewModel.Messenger.PageNumber)" class="loadMoreActionlnk"> @Texts.LoadMoreText </a>
    </div>
    <div class="flex-direction smx-reader">
        @if ((ManageSecMgrViewModel.Messenger == null || !ManageSecMgrViewModel.Messenger.ChildMessages.Any()) && !ManageSecMgrViewModel.ShowLoadingWheel && !ManageSecMgrViewModel.NewSecMsgrViewModel.IsVisible)
        {
            <div class="smx-empty">
                <svg class="smx-empty-icon" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="M22 7l-10 6L2 7" />
                </svg>
                <span class="smx-empty-title">@Texts.SelectItemReadText</span>
                <span class="smx-empty-sub">@Texts.NoItemsSelectedText</span>
            </div>
        }
        else
        {
            @* The read/compose content fills the pane (smx-reader-content
               is flex:1) so a selected message expands like the Password
               Manager detail pane instead of sitting collapsed. *@
            <div class="smx-reader-content">
                @if (ManageSecMgrViewModel.ShowLoadingWheel)
                {
                    <div class="view-section messager-loading" id="messenger-loading-section">
                        <span>@Texts.LoadingText</span>
                    </div>
                }
                <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.New />
                <div id="viewer-messenger-section">
                    <AxCrypt.App.Shared.Desktop.Components.SecuredMessenger.View />
                </div>
            </div>
        }
    </div>
</div>


<EditForm Model="ManageSecMgrViewModel" id="loadmore-button-click">
    <input type="hidden" id="pagenumber-id-hidden" name="pageNumber" value="@ManageSecMgrViewModel.Messenger.PageNumber" />
    <input type="hidden" id="sec-messenger-filter-tab" name="secMessengerFilterTab" value="@SecMessengerFilterTab" />
</EditForm>

@code {

    public SecureMsgrFilterTab SecMessengerFilterTab { get; set; }

    private Action<SecureMsgrFilterTab>? _onTabUpdateViewState;

    protected override void OnInitialized()
    {
        SecMessengerFilterTab = ManageSecMgrViewModel.Messenger.SecMessengerFilterTab;
        ManageSecMgrViewModel.NewSecMsgrViewModel.IsVisible = false;
        ManageSecMgrViewModel.ShowLoadingWheel = false;

        _onTabUpdateViewState = async (selectedTab) => await UpdateTabState(selectedTab);
        ManageSecMgrViewModel.OnUpdateViewState += UpdateState;
        ManageSecMgrViewModel.NewSecMsgrViewModel.OnTabUpdateViewState += _onTabUpdateViewState;
        ManageSecMgrViewModel.NewSecMsgrViewModel.OnUpdateViewState += UpdateState;

        base.OnInitialized();
    }

    public void Dispose()
    {
        ManageSecMgrViewModel.OnUpdateViewState -= UpdateState;
        ManageSecMgrViewModel.NewSecMsgrViewModel.OnUpdateViewState -= UpdateState;
        if (_onTabUpdateViewState != null)
        {
            ManageSecMgrViewModel.NewSecMsgrViewModel.OnTabUpdateViewState -= _onTabUpdateViewState;
            _onTabUpdateViewState = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }

    private string TabTitleText
    {
        get
        {
            switch (SecMessengerFilterTab)
            {
                case SecureMsgrFilterTab.Inbox:
                    return "Inbox";
                case SecureMsgrFilterTab.Sent:
                    return "Sent";
                case SecureMsgrFilterTab.Unread:
                    return "Unread";
                default:
                    return "";
            }
        }
    }

    public async Task<bool> EnableLoadMoreAction(int pageNumberCount)
    {
        pageNumberCount += 1;
        SecuredMessengerModel messengerModel = await ManageSecMgrViewModel.LoadMore(pageNumberCount, ManageSecMgrViewModel.Messenger.SecMessengerFilterTab);
        if (ManageSecMgrViewModel.Messenger.Messages != null && messengerModel != null && messengerModel!.Messages.Any())
        {
            ManageSecMgrViewModel.Messenger.Messages = ManageSecMgrViewModel.Messenger.Messages.Concat(messengerModel!.Messages).ToList();
            ManageSecMgrViewModel.UpdateViewState();
            return true;
        }
        return false;
    }

    private void OnComposeNewMessage()
    {
        if (usage.GetUsage(FeatureKey.SecuredMessage).IsExhausted)
        {
            ShowMessageLimitGate();
            return;
        }

        ManageSecMgrViewModel.ComposeNewMessage();
    }

    private void ShowMessageLimitGate()
    {
        paidFeaturegateService.ShowPaidGate(
            Texts.NewMessageText,
            "You've reached the free secured message limit. Upgrade to keep sending encrypted messages without limits.",
            new[] { "Unlimited secured messages", "Send to more recipients", "Encrypted message history", Texts.PrioritySupportTitle });
    }

    private async Task UpdateTabState(SecureMsgrFilterTab securedMessengerFilterTab)
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    void UpdateState()
    {
        SecMessengerFilterTab = ManageSecMgrViewModel.Messenger.SecMessengerFilterTab;
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
