@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Core.UI
@using AxCrypt.Content

@using static AxCrypt.Abstractions.TypeResolve;

@inject ManageSecMsgrViewModel ManageSecMgrViewModel

@if (Model.Message?.TheMessage != null && Model.Message.TheMessage.Any())
{
    DateTime read = Model.Message.ReceiverList.LastOrDefault(sec => sec.User == currentUser) == null ? DateTime.MinValue : Model.Message.ReceiverList.LastOrDefault(sec => sec.User == currentUser).Read;
    string messageToListText = Model.Message.Username;
    IEnumerable<string> messageToList = new List<string>();
    if (SecMessengerFilterTab == AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent)
    {
        messageToList = Model.Message.ReceiverList.Select(re => re.User);

        if (messageToList.Count() > 0)
        {
            messageToListText = string.Join(", ", messageToList.Take(Utility.MaxReceiversToDisplay));
        }

        read = DateTime.MinValue;
    }
    bool isUnread = SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent
                    && read == DateTime.MinValue;

    Guid messageSelectionId = Model.ParentId == Guid.Empty ? Model.Id : Model.ParentId;
    bool isActive = Model.IsSelected || ManageSecMgrViewModel.SelectedMessageId == messageSelectionId;
    bool selectMode = Model.IsSelected || ManageSecMgrViewModel.isMultiCheckboxVisible;
    string initials = messageToListText.Length >= 2
        ? messageToListText.Substring(0, 2).ToUpper()
        : messageToListText.ToUpper();
    int extraReceivers = messageToList.Count() - Utility.MaxReceiversToDisplay;

    @* Conversation row — avatar / correspondent / expiry meta / time,
       in the style of a modern secure-messaging app. All view-model
       wiring (open thread, multi-select) is preserved 1:1. *@
    <div id="unread-message-@messageSelectionId"
         class="smx-msg-row @(isUnread ? "smx-msg-row--unread" : "") @(isActive ? "smx-msg-row--active" : "")"
         data-id="@Model.Id" data-parent="@Model.ParentId"
         @onclick="async (e) => await ManageSecMgrViewModel.ViewMessageReplies(messageSelectionId, SecMessengerFilterTab)">

        <div class="smx-msg-avatar">
            @if (selectMode)
            {
                <input type="checkbox" class="smx-msg-check"
                       checked="@Model.IsSelected"
                       @onclick:stopPropagation="true"
                       @onchange="() => ManageSecMgrViewModel.SelectMessagesForActions(Model)"
                       data-id="@messageSelectionId" />
            }
            else
            {
                <span class="smx-msg-initials">@initials</span>
            }
        </div>

        <div class="smx-msg-main">
            <div class="smx-msg-top">
                <span class="smx-msg-name" title="@messageToListText">@messageToListText</span>
                @if (extraReceivers > 0)
                {
                    <span class="smx-msg-more">+@extraReceivers</span>
                }
                <span class="smx-msg-time">@Utility.ToDateString(Model.CreatedUtc.ToLocalTime())</span>
            </div>
            <div class="smx-msg-bottom">
                <span class="smx-msg-meta">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9" />
                        <polyline points="12 7 12 12 15 14" />
                    </svg>
                    <span>@Texts.VisibleUntilText
                        @(Model.Message.Visibility == AxCrypt.Core.UI.SecureMsgrVisibility.Forever ? "Forever" :
                          Model.Message.Visibility == AxCrypt.Core.UI.SecureMsgrVisibility.Once ? "Once" :
                          Utility.ToDateString(Model.Message.VisibleUntil.ToLocalTime()))</span>
                </span>
                @if (isUnread)
                {
                    <span class="smx-msg-unread-dot" title="Unread"></span>
                }
            </div>
        </div>
    </div>
}

@code {

    [Parameter]
    public AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab SecMessengerFilterTab { get; set; } = new();

    [Parameter]
    public SecuredMessage Model { get; set; } = new();

    string currentUser = "";

    protected override void OnInitialized()
    {
        currentUser = New<KnownIdentities>().DefaultEncryptionIdentity.UserEmail.Address;
        ManageSecMgrViewModel.OnUpdateViewState += UpdateState;

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
    }

    private void OnMessageCheckboxChanged(ChangeEventArgs e)
    {
        UpdateState();
    }


    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}