@using AxCrypt.App.Shared.Desktop.Components.Shared
@implements IDisposable
@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.Content
@using AxCrypt.Core.Runtime
@using static AxCrypt.Abstractions.TypeResolve

@inject NewSecMsgrViewModel newSecMsgrViewModel
@inject IJSRuntime jsRuntime

@*
    Compose pane — responsive.
    Sticky head + sticky foot; body scrolls.
    Recipient + Visibility share one row ≥ 760 px, stack below.
    Styling: /Resources/sass/HomeNew/SecuredMessengerNew.scss (.ncm-*).
*@

@if (newSecMsgrViewModel.IsVisible)
{
    <section class="ncm" id="new-message-section" aria-label="New secured message">

        @* ── Header ─── *@
        <header class="ncm-head">
            <div class="ncm-head-text">
                <h2 class="ncm-title">
                    <svg class="ncm-title-icon" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                    @Texts.NewMessageText
                </h2>
                <p class="ncm-sub">End-to-end encrypted — only your recipients can read this.</p>
            </div>
            <button type="button" class="ncm-x" @onclick="DeleteDraftMessage" title="Discard draft" aria-label="Close">×</button>
        </header>

        @* ── Form ───────────────────────────────── *@
        <div class="ncm-body">

            @* Recipient row — chips + visibility on one line ≥ 760 px. *@
            <div class="ncm-row">
                <div class="ncm-field ncm-field--grow">
                    <label class="ncm-label" for="ncm-to-input">@Texts.ToText</label>
                    <div class="ncm-chips" @onclick="FocusToInput">
                        @foreach (MessengerReceiver receiver in newSecMsgrViewModel.ReceiverList)
                        {
                            <span class="ncm-chip" title="@receiver.EmailAddress">
                                <span class="ncm-chip-text">@receiver.EmailAddress</span>
                                <button type="button"
                                        class="ncm-chip-x"
                                        title="Remove"
                                        @onclick="() => RemoveEmail(receiver.EmailAddress)"
                                        @onclick:stopPropagation="true">×</button>
                            </span>
                        }
                        <input id="ncm-to-input"
                               type="email"
                               class="ncm-chip-input"
                               placeholder="@(newSecMsgrViewModel.ReceiverList.Any() ? "Add another…" : Texts.BusinessSubscriptionEmailPlaceholder)"
                               @ref="_toInputRef"
                               @bind="newSecMsgrViewModel.UserEmail"
                               @bind:event="oninput"
                               @onkeydown="HandleKeyPress" />
                    </div>
                </div>
                <div class="ncm-field ncm-field--visibility">
                    <label class="ncm-label" for="ncm-visibility">@Texts.VisibilityText</label>
                    <div class="ncm-select-wrap">
                        <select id="ncm-visibility"
                                class="ncm-select"
                                @bind="newSecMsgrViewModel.Visibility">
                            @foreach (string visibility in newSecMsgrViewModel.MessageVisibilityList)
                            {
                                <option value="@visibility">@visibility</option>
                            }
                        </select>
                        <svg class="ncm-select-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                </div>
            </div>

            <p class="ncm-hint ncm-recipient-hint">Press <kbd>Enter</kbd> or <kbd>,</kbd> to add each recipient.</p>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="ncm-error" role="alert">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span>@ErrorMessage</span>
                </div>
            }

            @* Message body. *@
            <div class="ncm-field ncm-field--grow ncm-field--message">
                <div class="ncm-message-head">
                    <label class="ncm-label" for="ncm-body">Message</label>
                    <span class="ncm-char-count">@CharCount / 100,000</span>
                </div>
                <textarea id="ncm-body"
                          class="ncm-textarea"
                          maxlength="100000"
                          autofocus
                          placeholder="@Texts.TypeYourMessageHerePlaceHolderText"
                          @bind="newSecMsgrViewModel.EncryptedMessage"
                          @bind:event="oninput"></textarea>
            </div>

            @if (IsBusinessUser())
            {
                <div class="ncm-info">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                    </svg>
@*                     <span>
                        @Texts.GroupInfoText
                        <NavLink @onclick="OpenGroupPage">@Texts.GroupFeatureText</NavLink>
                        @Texts.GroupInfoText2
                        <NavLink @onclick="OpenGroupCreationPage">@Texts.CreateGroupInfoTexts</NavLink>
                    </span> *@
                </div>
            }

            @* Hidden inputs — kept for external JS. *@
            <input type="hidden" id="reply-message-id-hidden" name="messengerId" @bind="newSecMsgrViewModel.ParentId" />
            <input type="hidden" id="new-member-email-hidden" name="ReceiverEmails" @bind="newSecMsgrViewModel.ReceiverEmails" />
        </div>

        @* ── Action bar ──── *@
        <footer class="ncm-foot">
            <span class="ncm-foot-meta">
                @if (newSecMsgrViewModel.ReceiverList.Any())
                {
                    <span class="ncm-foot-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 00-3-3.87" />
                            <path d="M4 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" />
                            <circle cx="9" cy="7" r="4" />
                        </svg>
                        @newSecMsgrViewModel.ReceiverList.Count() recipient@(newSecMsgrViewModel.ReceiverList.Count() == 1 ? "" : "s")
                    </span>
                }
            </span>
            <span class="ncm-foot-spacer"></span>
            <button type="button"
                    class="ncm-btn ncm-btn--ghost"
                    @onclick="DeleteDraftMessage"
                    disabled="@newSecMsgrViewModel.IsSending">
                Discard
            </button>
            <button type="button"
                    class="ncm-btn ncm-btn--primary"
                    @onclick="async () => await SendAsync(newSecMsgrViewModel)"
                    disabled="@(!CanSend)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Send securely
            </button>
        </footer>

        @* ── Sending overlay (popup loader) ──────── *@
        @if (newSecMsgrViewModel.IsSending)
        {
            <div class="ncm-send-popup">
                <div class="ncm-send-popup-card">
                    <AxLoader Mode="LoaderMode.Body" Message="Sending your secured message…" />
                </div>
            </div>
        }
    </section>
}

@*
    All component styling lives in
    /Resources/sass/HomeNew/SecuredMessengerNew.scss (.ncm-*)
    so dark-mode rules sit next to their light-mode peers and
    other engineers find the styling where they expect it.
*@

@code {
    private string ErrorMessage { get; set; } = null!;
    private ElementReference _toInputRef;

    /// <summary>
    /// Computed character count for the message-length hint. Pulled into a
    /// property so the formatter call doesn't pollute the markup.
    /// </summary>
    private string CharCount => (newSecMsgrViewModel.EncryptedMessage?.Length ?? 0).ToString("N0");

    /// <summary>
    /// Gate the Send button — at least one recipient + non-empty body, not
    /// already in flight.
    /// </summary>
    private bool CanSend =>
        !newSecMsgrViewModel.IsSending
        && newSecMsgrViewModel.ReceiverList.Any()
        && !string.IsNullOrWhiteSpace(newSecMsgrViewModel.EncryptedMessage);

    protected override void OnInitialized()
    {
        newSecMsgrViewModel.OnUpdateViewState += UpdateState;
        base.OnInitialized();
    }

    public void Dispose()
    {
        newSecMsgrViewModel.OnUpdateViewState -= UpdateState;
    }

    /// <summary>Click anywhere on the chips row routes focus into the input.</summary>
    private async Task FocusToInput()
    {
        try { await _toInputRef.FocusAsync(); } catch { }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "," || e.Key == "Enter")
        {
            if (!string.IsNullOrWhiteSpace(newSecMsgrViewModel.UserEmail))
            {
                string trimmedEmail = newSecMsgrViewModel.UserEmail.Trim();
                AddEmail(trimmedEmail);
            }
        }
    }

    private void RemoveEmail(string email)
    {
        if (!newSecMsgrViewModel.ReceiverList.Any(su => su.EmailAddress.ToLower() == email.ToLower()))
        {
            return;
        }

        newSecMsgrViewModel.ReceiverList = newSecMsgrViewModel.ReceiverList
            .Where(su => su.EmailAddress.ToLower() != email.ToLower()).ToList();
        newSecMsgrViewModel.ReceiverEmails = string.Join(",", newSecMsgrViewModel.ReceiverList.Select(su => su.EmailAddress));
    }

    private void AddEmail(string email)
    {
        AxCrypt.Core.UI.EmailAddress emailAddress;
        if (!AxCrypt.Core.UI.EmailAddress.TryParse(email, out emailAddress))
        {
            ErrorMessage = Texts.ValidEmailAddressText;
            return;
        }

        if (newSecMsgrViewModel.ReceiverList.Any(su => su.EmailAddress.ToLower() == email.ToLower()))
        {
            ErrorMessage = Texts.EmailAlreadyAddedText.Replace("${0}", email);
            return;
        }

        newSecMsgrViewModel.ReceiverList.Add(new MessengerReceiver { EmailAddress = email, Read = DateTime.MinValue });
        newSecMsgrViewModel.ReceiverEmails = string.Join(",", newSecMsgrViewModel.ReceiverList.Select(su => su.EmailAddress));
        newSecMsgrViewModel.UserEmail = "";
        ErrorMessage = "";
    }

    private async Task SendAsync(NewSecMsgrViewModel newSecMsgrViewModel)
    {
        // If the user typed an address but didn't press Enter, add it as a
        // chip before sending so they don't lose the recipient.
        if (!string.IsNullOrWhiteSpace(newSecMsgrViewModel.UserEmail))
        {
            AddEmail(newSecMsgrViewModel.UserEmail);
        }

        await newSecMsgrViewModel.SentMessageAsync(newSecMsgrViewModel);
    }

    private void DeleteDraftMessage()
    {
        newSecMsgrViewModel.UserEmail = "";
        newSecMsgrViewModel.ReceiverList = new List<MessengerReceiver>();
        newSecMsgrViewModel.ReceiverEmails = "";
        newSecMsgrViewModel.EncryptedMessage = "";
        newSecMsgrViewModel.IsVisible = false;
        newSecMsgrViewModel.UpdateViewState();
    }

    private bool IsBusinessUser()
    {
        return New<LicensePolicy>().Capabilities.Has(LicenseCapability.Business);
    }

    private void OpenGroupCreationPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}Group/Index");
    }

    private void OpenGroupPage()
    {
        Core.BrowseUtility.RedirectTo("https://axcrypt.net/information/group/");
    }

    void UpdateState()
    {
        ErrorMessage = "";
        InvokeAsync(() => StateHasChanged());
    }
}
