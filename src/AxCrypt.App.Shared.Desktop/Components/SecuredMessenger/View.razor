@implements IDisposable
@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.ViewModels.SecuredMessenger
@using AxCrypt.Core.SecuredMessenger
@using AxCrypt.Core.UI
@using AxCrypt.Content
@using AxCrypt.Core
@using static AxCrypt.Abstractions.TypeResolve

@inject ManageSecMsgrViewModel ViewSecMsgrViewModel
@inject IJSRuntime jsRuntime

@*
    Secured Messenger — View message (.smv-* design system).

    Replaces the legacy <table>/floats layout with a flat, modern
    message-card stack. Each card:
       ┌──────────────────────────────────────────────────────────┐
       │ [AV] sender@…                          ⏱ 2h ago  [↩][🗑] │
       │      to: bob@…, carol@…   (+N others)                    │
       │      🕒 Visible until Jan 5  ·  👁 Once                  │   (pills, optional)
       │ ──────────────────────────────────────────────────────── │
       │  <message body — textarea readonly OR loading wheel>     │
       └──────────────────────────────────────────────────────────┘

    Accent color (avatar, reply icon, visibility pills) comes from
    $brand-green which is tier-defined in /sass/<tier>/_homeNewVariables.scss
    — Premium #48772C, Business #000, Free #48772C.
*@

@if (ViewSecMsgrViewModel.Messenger != null
     && ViewSecMsgrViewModel.Messenger.ChildMessages != null
     && ViewSecMsgrViewModel.Messenger.ChildMessages.Any())
{
    <div class="smv-thread">
        @foreach (SecuredMessage messenger in ViewSecMsgrViewModel.Messenger.ChildMessages)
        {
            Guid parentId    = messenger.ParentId == Guid.Empty ? messenger.Id : messenger.ParentId;
            string messageFrom  = messenger.Message.Username;
            IEnumerable<string> messageToList = messenger.Message.ReceiverList.Select(re => re.User);
            string messageToText = string.Join(", ", messageToList);

            // Whose initials show in the avatar — sent → recipient,
            // received → sender. Keeps the leading glyph meaningful when
            // scanning a thread.
            bool isSentTab = ViewSecMsgrViewModel.Messenger.SecMessengerFilterTab
                             == AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent
                             || messageFrom == currentUser;
            string avatarSource = isSentTab ? messageToText : messageFrom;
            string avatar = InitialsOf(avatarSource);

            IList<string> replyUserList = isSentTab
                ? new List<string> { messageFrom }
                : BuildReplyUserList(messageToList, messageFrom);
            string replyReceivers = string.Join(", ", replyUserList);

            bool showDelete =
                (ViewSecMsgrViewModel.Messenger.SecMessengerFilterTab == AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent && messageFrom == currentUser) ||
                (ViewSecMsgrViewModel.Messenger.SecMessengerFilterTab != AxCrypt.Api.SecuredMessenger.SecureMsgrFilterTab.Sent && messageFrom != currentUser);

            bool bodyVisible = !string.IsNullOrEmpty(messenger.Message.TheMessage);
            string bodyToggleStyle = bodyVisible ? "display:block;" : "display:none;";

            <article class="smv-card" id="view-message-box">

                @* ── Header ─────────────────────────────────────── *@
                <header class="smv-card-head"
                        @onclick="async () => await ViewSecuredMessage(messenger.Id, messenger.Message.TheMessage!)">
                    <span class="smv-avatar" aria-hidden="true">@avatar</span>

                    <div class="smv-meta">
                        <div class="smv-meta-row">
                            <span class="smv-label">@Texts.FromText</span>
                            <span class="smv-email" title="@messageFrom">@messageFrom</span>
                        </div>
                        <div class="smv-meta-row">
                            <span class="smv-label">@Texts.ToText</span>
                            <span class="smv-email smv-email--to" title="@messageToText">
                                @string.Join(", ", messageToList.Take(Utility.MaxReceiversToDisplay))
                                @if (messageToList.Count() > Utility.MaxReceiversToDisplay)
                                {
                                    <span class="smv-more">+@(messageToList.Count() - Utility.MaxReceiversToDisplay) others</span>
                                }
                            </span>
                        </div>

                        @if (messenger.Message.VisibleUntil != DateTime.MaxValue
                             || messenger.Message.Visibility == SecureMsgrVisibility.Once)
                        {
                            <div class="smv-pills">
                                @if (messenger.Message.VisibleUntil != DateTime.MaxValue)
                                {
                                    <span class="smv-pill" title="@Utility.ToLocalFullDateString(messenger.Message.VisibleUntil.ToLocalTime())">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <polyline points="12 6 12 12 16 14"/>
                                        </svg>
                                        @Texts.VisibleUntilText
                                        @Utility.ToDateString(messenger.Message.VisibleUntil.ToLocalTime())
                                    </span>
                                }
                                else if (messenger.Message.Visibility == SecureMsgrVisibility.Once)
                                {
                                    <span class="smv-pill smv-pill--once">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                        @Texts.VisibilityText @messenger.Message.Visibility
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="smv-actions" @onclick:stopPropagation="true">
                        <button type="button" class="smv-icon-btn smv-icon-btn--primary"
                                title="Reply"
                                data-id="@messenger.Id"
                                @onclick="() => ViewSecMsgrViewModel.ReplyMessage(messenger.Id, parentId, replyReceivers)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 17 4 12 9 7"/>
                                <path d="M20 18v-2a4 4 0 00-4-4H4"/>
                            </svg>
                        </button>

                        @if (showDelete)
                        {
                            <button type="button" class="smv-icon-btn smv-icon-btn--danger"
                                    title="Delete"
                                    data-id="@messenger.Id"
                                    @onclick="async () => await ViewSecMsgrViewModel.DeleteMessageById(messenger.Id, parentId, ViewSecMsgrViewModel.Messenger.SecMessengerFilterTab)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6"/>
                                    <path d="M19 6l-1.5 14a2 2 0 01-2 2H8.5a2 2 0 01-2-2L5 6"/>
                                    <path d="M10 11v6M14 11v6"/>
                                </svg>
                            </button>
                        }

                        <time class="smv-time"
                              title="@Utility.ToLocalFullDateString(messenger.CreatedUtc)">
                            @Utility.ToDateString(messenger.CreatedUtc.ToLocalTime())
                        </time>
                    </div>
                </header>

                @* ── Body ───────────────────────────────────────── *@
                <div class="smv-body"
                     id="secured-messenger-view-@messenger.Id"
                     style="@bodyToggleStyle">
                    @if (messenger.Message.TheMessage != null && !messenger.ShowLoadingWheel)
                    {
                        <textarea name="encryptedMessage"
                                  id="secured-mess-body"
                                  class="smv-textarea"
                                  maxlength="100000"
                                  @bind="messenger.Message.TheMessage"
                                  readonly autofocus></textarea>
                    }
                </div>

                @if (messenger.ShowLoadingWheel)
                {
                    <div class="smv-body smv-body--loading"
                         id="messenger-view-loading-section-@messenger.Id">
                        <span class="smv-spinner" aria-hidden="true"></span>
                        <span>@Texts.ProgressIndicatorWaitMessage</span>
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    // Deferred: accessing DefaultEncryptionIdentity at field-init time throws
    // if no user is logged in. Read it lazily in OnInitialized() instead.
    string currentUser = "";

    protected override void OnInitialized()
    {
        if (Resolve.KnownIdentities.IsLoggedOn)
        {
            currentUser = New<KnownIdentities>().DefaultEncryptionIdentity.UserEmail.Address;
        }
        ViewSecMsgrViewModel.OnUpdateViewState += UpdatePageState;
    }

    public void Dispose()
    {
        ViewSecMsgrViewModel.OnUpdateViewState -= UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    /// <summary>
    /// Two-char avatar initials. Falls back to "?" so the circle is
    /// never empty (looked broken in the legacy markup).
    /// </summary>
    private static string InitialsOf(string source)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return "?";
        }
        string trimmed = source.Trim();
        return trimmed.Length >= 2
            ? trimmed[..2].ToUpperInvariant()
            : trimmed[..1].ToUpperInvariant();
    }

    /// <summary>
    /// Recipients minus currentUser, then add the sender so a quick
    /// "Reply all" goes to the original sender too. Matches the legacy
    /// flow exactly — extracted into a helper to keep the foreach body
    /// readable.
    /// </summary>
    private IList<string> BuildReplyUserList(IEnumerable<string> recipients, string sender)
    {
        IList<string> list = recipients
            .Where(re => !re.Equals(currentUser))
            .ToList();

        if (!list.Any(ru => ru == sender))
        {
            list.Add(sender);
        }
        return list;
    }

    private async Task ViewSecuredMessage(Guid messageId, string messageContent)
    {
        if (string.IsNullOrEmpty(messageContent))
        {
            await ViewSecMsgrViewModel.ViewMessageById(messageId, messageContent);
            return;
        }

        await jsRuntime.InvokeVoidAsync("ShowHideSecuredMessage", "secured-messenger-view-" + messageId);
    }
}

<script>
    window.ShowHideSecuredMessage = function (id) {
        const el = document.getElementById(id);
        if (!el) return;

        const isHidden = window.getComputedStyle(el).display === "none";
        el.style.display = isHidden ? "block" : "none";
    };
</script>
