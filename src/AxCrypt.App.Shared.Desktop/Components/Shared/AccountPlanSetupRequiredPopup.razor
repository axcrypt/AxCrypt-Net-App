@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content;

@inject AccountSetupViewModel accountSetupModel
@inject UpgradeSubscriptionViewModel upgradeModel

<style>
    #account-setup-required.modalDialog {
        z-index: 99999 !important;
    }
    #account-setup-required.modalDialog > div {
        min-width: 600px !important;
        margin: 4% auto !important;
    }
    .account-complete-plan-popup-container > .center-column > .btn-large {
        padding: 12px !important;
        min-height: 60px !important;
    }

    .account-complete-plan-popup-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
        color: #494949;
        font-size: 16px;
    }

    .account-complete-plan-popup-container .try-upgrade-plan-title {
        font-weight: 600;
    }

    .account-complete-plan-popup-container .try-upgrade-plan-title span, .try-upgrade-plan-subtitle span {
        color: #48772c;
        font-weight: 800;
        line-height: 25px;
    }

    .benefit-item {
        background-color: #e5f7da;
        margin-top : 10px;
    }

    .benefit-item p {
        padding: 6px 15px 0px
    }

    .account-complete-plan-popup-container .more {
        font-weight: bold;
        list-style-type: none;
    }

    .account-complete-plan-popup-container .font-medium {
        font-size: 14px;
    }

    .pricing-link {
        text-decoration: none;
        color: #000;
    }

    .pricing-link:hover {
        text-decoration: underline;
    }

    ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        margin-bottom: 5px;
    }

    li {
        margin-bottom: 2px;
    }

    .trial-btn {
        padding: 14px 18px;
    }

    .btn-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .arrow {
        font-size: 20px;
        font-weight: bold;
    }

    .btn-sub {
        font-size: 13px;
        opacity: 0.9;
    }

    .secondary-text{
        color: #8a8a8a;
        font-weight: normal;
        font-size: 14px;
        margin-left: 4px;
    }

    .feature-title{
        margin-left : 6px;
    }
</style>

@if (IsVisible)
{
    <div id="account-setup-required" class="modalDialog">
        <div id="UpgradePopup" class="upg-popup">
            <div style="margin:12px 12px;" class="account-complete-plan-popup-container">
                <div>
                    <h5 style="text-align:center" class="try-upgrade-plan-title">
                        Encrypt and secure your files in seconds
                    </h5>
                </div>
                <div class="account-setup-description">
                    <label>
                        <span class="secondary-text">Start your </span><strong>free trial</strong><span class="secondary-text"> to unlock encryption secure file sharing with AxCrypt.</span>
                    </label>
                </div>
                <hr />
                <div>
                    <ul>
                        <li>
                            <div>
                                <img src="/images/free/Icoshield.svg" alt="shield" width="44" height="44" />
                                <label class="feature-title"><strong>@Texts.PricingFeatureListAES256</strong></label>
                            </div>
                        </li>
                        <li>
                            <div>
                                <img src="/images/free/IcoFtr$CloEn.svg" alt="folder" width="44" height="44" />
                                <label class="feature-title"><strong>Cloud Security</strong><span class="secondary-text">(Google Drive, OneDrive, Dropbox)</span></label>
                            </div>
                        </li>
                        <li>
                            <div>
                                <img src="/images/free/IcoScrdFleShr.svg" alt="share" width="44" height="44" />
                                <label class="feature-title"><strong>@Texts.PricingFeatureListKeySharing</strong></label>
                            </div>
                        </li>
                        <li>
                            <div>
                                <img src="/images/free/MobileIcon.svg" alt="share" width="44" height="44" />
                                <label class="feature-title"><strong>Mobile Apps</strong><span class="secondary-text">(iOS & Android)</span></label>
                            </div>
                        </li>
                    </ul>
                    <div class="benefit-item">
                        <p>
                            Zero-knowledge encryption. <b>Only you control your files.</b>
                        </p>
                    </div>
                </div>
                <div class="center-column">
                    <button class="btn-large font-medium grn-bg whte-clr trial-btn" style="width:100%;margin-bottom:5px" @onclick="OpenPremiumPage">
                        <div class="btn-content">
                            <div style="text-align: left;">
                                Start free trial — Personal
                                <br />
                                <span class="btn-sub">For individuals securing their own files</span>
                            </div>

                            <span class="arrow">→</span>
                        </div>
                    </button>
                    <button class="btn-large font-medium button blck-bg whte-clr" style="width:100%;margin-bottom:5px" @onclick="OpenBusinessPage">
                        <div class="btn-content">
                            <div style="text-align: left;">
                                Start free trial - Business
                                <br />
                                <span class="btn-sub"> For teams sharing and managing files together</span>
                            </div>
                            <span class="arrow">→</span>
                        </div>
                    </button>
                    <button class="btn-large font-medium button" style="background:none;border:1px solid #48772c;color:#494949;width:100%;margin-bottom:5px" @onclick="async () => await ActivateViewerPlanAsync()">
                        <div class="btn-content">
                            <div style="text-align: left;">
                                Viewer - only for decryption
                                <br />
                                <span class="btn-sub">Open encrpted files shared with you, for free</span>
                            </div>
                            <span class="arrow">→</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        accountSetupModel.OnAccountSetupDialogVisibilityChanged += async (isVisible)=> await UpdateUpgradeDialogState(isVisible);
    }

    public void OpenBusinessPage()
    {
        upgradeModel.OpenBusinessPage();
        accountSetupModel.PopupResult = Utility.DialogResult.OK;
    }

    public void OpenPremiumPage()
    {
        upgradeModel.OpenPremiumPage();
        accountSetupModel.PopupResult = Utility.DialogResult.OK;
    }

    public async Task ActivateViewerPlanAsync()
    {
        await accountSetupModel.SetViewerPlanAsync();
        accountSetupModel.PopupResult = Utility.DialogResult.OK;
    }

    private async Task UpdateUpgradeDialogState(bool canShowUpgradeDialog)
    {
        IsVisible = canShowUpgradeDialog;

        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}