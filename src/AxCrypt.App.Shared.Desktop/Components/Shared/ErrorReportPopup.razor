@using AxCrypt.App.Shared.Services

@inject ErrorReportService ErrorReports
@inject IJSRuntime JS
@implements IDisposable

@*
    Global error popup. Subscribes to ErrorReportService.OnErrorRaised
    and shows the most recent error. Mounted once at app-shell level
    (TopBar) so any thread / any component that calls
    ErrorReports.Report(...) gets a visible popup.

    Self-contained styles below the markup so the popup paints correctly
    even if the SCSS bundle hasn't loaded yet (e.g. on a very early
    boot-time exception).
*@

@if (ErrorReports.IsVisible && ErrorReports.Current is { } err)
{
    <div class="erp-scrim" @onclick="Dismiss">
        <div class="erp-card" @onclick:stopPropagation role="alertdialog" aria-modal="true">

            <div class="erp-head">
                <span class="erp-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                </span>
                <h2 class="erp-title">@err.Title</h2>
                <button type="button" class="erp-x" @onclick="Dismiss" aria-label="Dismiss">×</button>
            </div>

            <p class="erp-msg">@err.Message</p>

            @if (!string.IsNullOrWhiteSpace(err.Context) && err.Context != err.Title)
            {
                <p class="erp-context">While: <strong>@err.Context</strong></p>
            }

            @if (!string.IsNullOrWhiteSpace(err.Detail))
            {
                <button type="button" class="erp-toggle" @onclick="() => _showDetail = !_showDetail">
                    @(_showDetail ? "Hide details" : "Show details")
                </button>

                @if (_showDetail)
                {
                    <pre class="erp-detail" @ref="_detailRef">@err.Detail</pre>
                }
            }

            <div class="erp-foot">
                <span class="erp-ts">@err.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                @if (!string.IsNullOrWhiteSpace(err.Detail))
                {
                    <button type="button" class="erp-btn erp-btn--ghost" @onclick="CopyAsync">Copy</button>
                }
                <button type="button" class="erp-btn erp-btn--primary" @onclick="Dismiss">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showDetail;
    private ElementReference _detailRef;
    private Action<ReportedError>? _onRaised;
    private Action? _onDismissed;

    protected override void OnInitialized()
    {
        _onRaised = _ => InvokeAsync(() =>
        {
            // Fresh error — collapse the details pane so the user sees the
            // headline first; they can expand it themselves.
            _showDetail = false;
            StateHasChanged();
        });
        _onDismissed = () => InvokeAsync(StateHasChanged);

        ErrorReports.OnErrorRaised += _onRaised;
        ErrorReports.OnDismissed += _onDismissed;
    }

    public void Dispose()
    {
        if (_onRaised != null)
        {
            ErrorReports.OnErrorRaised -= _onRaised;
        }
        if (_onDismissed != null)
        {
            ErrorReports.OnDismissed -= _onDismissed;
        }
    }

    private void Dismiss() => ErrorReports.Dismiss();

    private async Task CopyAsync()
    {
        if (ErrorReports.Current is { } current)
        {
            string payload = $"{current.Title}\n{current.Message}\n\n{current.Detail}";
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", payload);
            }
            catch
            {
                // Clipboard may not be available — ignore; the popup still shows the text.
            }
        }
    }
}

<style>
    .erp-scrim {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .erp-card {
        width: 100%;
        max-width: 520px;
        max-height: 80vh;
        overflow: auto;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        padding: 22px 22px 18px;
        animation: erpIn 0.16s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes erpIn {
        from { opacity: 0; transform: translateY(8px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0)   scale(1); }
    }

    .erp-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .erp-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fee2e2;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .erp-title {
        flex: 1;
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }

    .erp-x {
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        font-size: 22px;
        line-height: 1;
        color: #6b7280;
        cursor: pointer;
        border-radius: 6px;
    }

    .erp-x:hover { background: #f3f4f6; color: #111827; }

    .erp-msg {
        margin: 0 0 6px;
        font-size: 14px;
        color: #1f2937;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .erp-context {
        margin: 0 0 8px;
        font-size: 12.5px;
        color: #6b7280;
    }

    .erp-toggle {
        background: none;
        border: none;
        padding: 4px 0;
        font-size: 12.5px;
        font-weight: 600;
        color: #2563eb;
        cursor: pointer;
        margin: 4px 0 8px;
    }

    .erp-toggle:hover { text-decoration: underline; }

    .erp-detail {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11.5px;
        color: #374151;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 10px 12px;
        max-height: 220px;
        overflow: auto;
        white-space: pre;
        line-height: 1.45;
    }

    .erp-foot {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
    }

    .erp-ts {
        flex: 1;
        font-size: 12px;
        color: #9ca3af;
    }

    .erp-btn {
        height: 36px;
        padding: 0 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .erp-btn--ghost {
        background: #fff;
        color: #111827;
        border: 1px solid #d1d5db;
    }

    .erp-btn--ghost:hover {
        background: #f9fafb;
        border-color: #9ca3af;
    }

    .erp-btn--primary {
        background: #48772C;
        color: #fff;
    }

    .erp-btn--primary:hover { background: #3f6826; }

    html[data-theme="dark"] .erp-card {
        background: #1f2937;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    html[data-theme="dark"] .erp-title       { color: #f3f4f6; }
    html[data-theme="dark"] .erp-msg         { color: #e5e7eb; }
    html[data-theme="dark"] .erp-context     { color: #9ca3af; }
    html[data-theme="dark"] .erp-detail      { background: #111827; color: #cbd5e1; border-color: #374151; }
    html[data-theme="dark"] .erp-x:hover     { background: #374151; color: #f3f4f6; }
    html[data-theme="dark"] .erp-btn--ghost  { background: #1f2937; color: #f3f4f6; border-color: #4b5563; }
    html[data-theme="dark"] .erp-btn--ghost:hover { background: #111827; }
</style>
