@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.App.Entitlement.Contracts
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject UserService userService
@inject IFeatureUsageProvider usage
@inject NavigationManager navigationManager

@implements IDisposable

@*
    Free-tier usage bar — reusable across Home (file encryption),
    Secured Messenger (messages sent), and Password Manager (entries
    created). Bind it to a FeatureKey via the [Parameter]:

      <FreePlanLimitBar Feature="FeatureKey.FileEncryption" />

    The bar:
      • Hides for Premium / Business (Limit == -1 → IsUnlimited)
      • Pulls live counts from IFeatureUsageProvider, which works
        in both online and offline modes (offline counters serve
        from cache and are marked stale).
      • Shows a "Stale" indicator when the provider hasn't been able
        to refresh from the API recently.
      • CTA navigates to /upgradePage where the plan list is
        filtered by SignUpFrom.
*@

@*
    Authoritative tier gate FIRST, before we even look at the usage
    snapshot. Reason: IFeatureUsageProvider.GetUsage() returns a
    free-tier default (e.g. 0 / 3) until InitializeAsync completes
    and SetTier() runs. That async window is short, but it's enough
    to flash a "Free 0 / 3" bar on Premium / Business users right
    after sign-in — exactly the bug we're fixing here.

    UserService.IsFreeTier is set SYNCHRONOUSLY by InitializeData()
    during the sign-in handshake (before any component renders), so
    using it as the outer guard means paid users never see the bar
    even during the snapshot-loading tick.
*@
@if (userService.IsFreeTier && Current is { IsUnlimited: false })
{
    <div class="free-limit-bar @(Current.IsExhausted ? "free-limit-bar--maxed" : "")">
        <div class="flb-header">
            <span class="flb-label">
                Free · @Title <strong>@Current.Used / @Current.Limit</strong>
                @if (Current.IsStale)
                {
                    <span class="flb-stale" title="Last synced @Current.LastSyncedUtc.ToLocalTime()">offline</span>
                }
            </span>
            <button class="flb-upgrade"
                    @onclick='() => navigationManager.NavigateTo("/upgradePage")'>
                Upgrade
            </button>
        </div>
        <div class="flb-track">
            <div class="flb-fill @(Current.IsExhausted ? "flb-fill--full" : "")"
                 style="width:@(Current.PercentUsed)%"></div>
        </div>
        <span class="flb-hint">
            @if (Current.IsExhausted)
            {
                <span class="flb-maxed">@MaxedHint</span>
            }
            else
            {
                <span>@Current.Remaining @RemainingHint</span>
            }
        </span>
    </div>
}

@code {
    /// <summary>
    /// Which metered feature this bar tracks. Required — no default,
    /// callers MUST be explicit so each page renders the right counter.
    /// </summary>
    [Parameter] public FeatureKey Feature { get; set; } = FeatureKey.FileEncryption;

    /// <summary>Custom label override. Falls back to a per-feature default.</summary>
    [Parameter] public string? Label { get; set; }

    private FeatureUsage Current => usage.GetUsage(Feature);

    private string Title => string.IsNullOrWhiteSpace(Label) ? DefaultTitle(Feature) : Label!;
    private string RemainingHint => DefaultRemainingHint(Feature);
    private string MaxedHint     => DefaultMaxedHint(Feature);

    protected override async Task OnInitializedAsync()
    {
        usage.OnChange += OnUsageChanged;

        // Subscribe to UserService too so an upgrade / downgrade mid-session
        // flips the bar in/out without waiting for the usage provider to
        // notice. Also covers the case where sign-in lands AFTER the bar
        // mounts (e.g. resumed session) — IsFreeTier was false, then becomes
        // true, and we need to re-render.
        userService.OnChange += OnUsageChanged;

        // Prime the provider lazily — first bar mount triggers the snapshot
        // load. Subsequent mounts hit the in-memory cache.
        // Tier is passed in explicitly so AxCrypt.App.Entitlement doesn't
        // have to reach back into AxCrypt.App.Shared (one-way reference).
        if (usage.IsLoading && !string.IsNullOrWhiteSpace(userService.UserEmail))
        {
            await usage.InitializeAsync(userService.UserEmail, userService.SubscriptionLevel);
        }
        else
        {
            // Already initialized — make sure the provider is on the
            // current tier (e.g. user just upgraded mid-session).
            usage.SetTier(userService.SubscriptionLevel);
        }
    }

    public void Dispose()
    {
        usage.OnChange -= OnUsageChanged;
        userService.OnChange -= OnUsageChanged;
    }

    private void OnUsageChanged() => InvokeAsync(StateHasChanged);

    // ── Per-feature copy ────────────────────────────────────────
    private static string DefaultTitle(FeatureKey f) => f switch
    {
        FeatureKey.FileEncryption => Texts.FreeLimitFileEncryptionLabel,
        FeatureKey.KeyShare => Texts.FreeLimitKeyShareLabel,
        FeatureKey.PasswordEntry => Texts.FreeLimitPasswordEntryLabel,
        FeatureKey.SecuredMessage => Texts.FreeLimitSecuredMessageLabel,
        _                         => "usage",
    };

    private static string DefaultRemainingHint(FeatureKey f) => f switch
    {
        FeatureKey.FileEncryption => Texts.FreeLimitFileEncryptionStatusText,
        FeatureKey.KeyShare => Texts.FreeLimitKeyShareStatusText,
        FeatureKey.PasswordEntry => Texts.FreeLimitPasswordEntryStatusText,
        FeatureKey.SecuredMessage => "messages remaining this month",
        _ => Texts.FreeLimitRemainingStatusText,
    };

    private static string DefaultMaxedHint(FeatureKey f) => f switch
    {
        FeatureKey.FileEncryption => Texts.FreeLimitFileEncryptionReachedText,
        FeatureKey.KeyShare => Texts.FreeLimitKeyShareReachedText,
        FeatureKey.PasswordEntry => Texts.FreeLimitPasswordEntryReachedText,
        FeatureKey.SecuredMessage => Texts.FreeLimitSecuredMessageReachedText,
        _ => Texts.FreeLimitReachedText,
    };
}
