@using AxCrypt.App.Shared.Desktop.Services

@inject PopupService popupService
@inject PaidFeaturegateService paidFeaturegateService
@inject NavigationManager navigationManager

@*
    PaidGateDialog — the single, app-shell-level modal that every
    feature-targeted paid-gate prompt flows into.

    Triggered exclusively via PaidFeaturegateService.ShowPaidGate(...),
    which sets the feature label / description / perks on the service
    and flips popupService.PaidGateOpen → true.

    Tier-targeted via SignUpFrom (resolved on the service):
      pgm-tier--generic   → None / Free → neutral amber
      pgm-tier--premium   → Premium re-activation → green
      pgm-tier--business  → Business re-activation → dark / SOC color

    CTA always navigates to /upgradePage; that page's plan grid then
    filters itself by the same SignUpFrom value, so the funnel ends at
    one consistent destination.

    The component is mounted once at app shell (see MainLayout.razor)
    so any place in the app can pop the gate without re-rendering its
    own copy.
*@

@if (popupService.PaidGateOpen)
{
    <div class="paid-gate-backdrop" @onclick="Close">
        <div class="paid-gate-modal @paidFeaturegateService.TargetCssClass"
             role="dialog"
             aria-modal="true"
             aria-labelledby="paid-gate-title"
             @onclick:stopPropagation>

            <div class="pgm-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" fill="#fbbf24" />
                    <path d="M12 6v6l4 2" stroke="white" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>

            <h3 id="paid-gate-title" class="pgm-title">
                @string.Format(paidFeaturegateService.TargetHeadline, paidFeaturegateService.PaidGateFeature)
            </h3>

            <p class="pgm-desc">@paidFeaturegateService.PaidGateDescription</p>

            @if (paidFeaturegateService.PaidGatePerks is { Length: > 0 })
            {
                <div class="pgm-features">
                    @foreach (string perk in paidFeaturegateService.PaidGatePerks)
                    {
                        <span class="pgm-perk">✓ @perk</span>
                    }
                </div>
            }

            <button class="pgm-upgrade-btn" @onclick="OpenUpgradePage">
                @paidFeaturegateService.TargetCtaLabel
            </button>

            <button class="pgm-cancel" @onclick="Close">Maybe later</button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        // Re-render whenever the popup state flips.
        popupService.OnChange += OnPopupStateChanged;
    }

    public void Dispose()
    {
        popupService.OnChange -= OnPopupStateChanged;
    }

    private void OnPopupStateChanged() => InvokeAsync(StateHasChanged);

    private void Close() => popupService.PaidGateOpen = false;

    private void OpenUpgradePage()
    {
        popupService.PaidGateOpen = false;
        navigationManager.NavigateTo("/upgradePage");
    }
}
