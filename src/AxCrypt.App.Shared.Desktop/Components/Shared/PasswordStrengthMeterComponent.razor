@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.ViewModel

@inject PasswordStrengthMeterViewModel passwordSterngthMeterViewModel

@if (passwordSterngthMeterViewModel.PasswordCandidate != null && passwordSterngthMeterViewModel.PasswordCandidate.Length != 0)
{
    string strengthPercentage = 100 * ((double)passwordSterngthMeterViewModel.PercentStrength / 100) + "%";
    string strengthColor = GetColor(passwordSterngthMeterViewModel.PasswordStrength);

    <div id="password-strength-wrapper" style="margin-top:10px;">
        <div class="medium-7">
            <span style="font-weight: 700;">Password Strength</span> <span style="font-weight: 700; color: @strengthColor; float: right;">@passwordSterngthMeterViewModel.PasswordStrength</span>
            <img src="/images/premium/IcoInfOld.svg" alt="info icon" width="16" height="16" @onmouseover='@(() => ShowPopup("open"))' @onmouseout='@(() => HidePopup())'>

        </div>
        <div class="medium-7" style="height: 8px; background-color: #D9D9D9; border-radius: 64px; margin: 10px 0px;">
            @if (IsHovered && HoveredElement == "open")
            {
                <div class="custom-password-help-hoverpopup" style="background-color:#fff; width: 250px; margin-top:0px;">
                    <div class="txt-clr font-medium " style="">
                        <label>Strong password contains at least</label>
                        <ul style="margin-top: 6px;">
                            <li>8 characters</li>
                            <li>1 lower case letter</li>
                            <li>1 upper case letter</li>
                            <li>1 number</li>
                            <li>1 special character like  </li>
                        </ul>

                    </div>
                </div>
            }
            <div style="height: 8px;width:@strengthPercentage;background-color:@strengthColor;border-radius: 64px;transition: width 0.3s;">
            </div>
        </div>
        <div style="margin: 10px 0px;">
            <span>@passwordSterngthMeterViewModel.StrengthTip</span>
        </div>


    </div>
}

@code {

    [Parameter]
    public string InputValue { get; set; }

    protected override void OnParametersSet()
    {
        passwordSterngthMeterViewModel.PasswordCandidate = InputValue;
        base.OnParametersSet();
    }

    public string HoveredElement { get; set; } = string.Empty;
    public bool IsHovered { get; set; } = false;

    public void ShowPopup(string element)
    {
        IsHovered = true;
        HoveredElement = element;
    }

    public void HidePopup()
    {
        IsHovered = false;
        HoveredElement = string.Empty;
    }

    private string GetColor(PasswordStrength strength)
    {
        switch (strength)
        {
            case PasswordStrength.Unacceptable:
            case PasswordStrength.Bad:
                return "red";

            case PasswordStrength.Weak:
            case PasswordStrength.Average:
                return "orange";

            case PasswordStrength.Strong:
                return "green";

            default:
                return "gray";
        }
    }
}
