@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Services

@inject ProcessIndicatorService ProcessIndicatorService

@*
    Legacy entry point — kept so the ~15 existing `<ProcessIndicatorComponent />`
    call sites continue to work. Internally this just delegates to AxLoader
    (the single brand spinner) and picks the mode from the service's
    FullScreen flag. Update the visual in AxLoader.razor / AxLoader.scss
    and every caller updates with it.
*@

@if (IsVisible)
{
    <AxLoader Mode="@(ProcessIndicatorService.FullScreen ? LoaderMode.FullPage : LoaderMode.Body)"
              Message="@Message" />
}

@code {
    public bool IsVisible { get; set; }
    public string? Title { get; set; }
    public string? Message { get; set; }

    protected override void OnInitialized()
    {
        ProcessIndicatorService.OnProcessIndicatorVisibilityChanged += UpdateIndicatorVisibility;
    }

    private void UpdateIndicatorVisibility(bool isVisible)
    {
        IsVisible = isVisible;
        Title     = ProcessIndicatorService.Title;
        Message   = ProcessIndicatorService.Message;

        InvokeAsync(StateHasChanged);
    }
}
