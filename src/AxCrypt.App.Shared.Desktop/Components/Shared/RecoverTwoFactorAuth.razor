@* @page "/RecoverTwoFactorAuth"

@using AxCrypt.Api.Model
@using AxCrypt.App.Desktop.Data
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@inject TwoFactorAuthVerifyModel TwoFactorModel
@inject IJSRuntime _jsRuntime
@inject NavigationManager _navigationManager

<section class="content">
    <article class="left-section" id="content-wrap" style="margin-top:10%;">
        <div class="tfa-sub-head">
            <h2 style="line-height:45px"><strong>Recover Two Factor Authentication</strong></h2>
        </div>
        <p style="margin: 0 13% 5% 0;">
            If you cannot access your phone enter <strong>one of the 8 backup codes</strong> that were provided when you set up two-step authentication to continue.
        </p>

        <EditForm Model="@TwoFactorModel.Is2FAEnabled"  class="signup-sec">
            <div id="continue-btn" class="verify-code-txt">
                <input type="text" id="backupcode-value" @bind-value="@TwoFactorModel.BackUpCode" class="form-control" placeholder="Backup code" tabindex="2" />
            </div>
            <button class="button success grn-bg whte-clr" style="width:100%; margin: 20px 0 0;" tabindex="3">Log in</button>
            <button @onclick="() => OnCancelClick()" class="button cancel whte-clr" id="backup-code-verify-btn" style="width:100%; margin: 20px 0 30px;" tabindex="3">@Texts.ButtonCancelText</button>
            <p style="text-align:center;" ><strong>Still cannot access?</strong> Contact our <a href="mailto:support@axcrypt.net" class="sprt-code-btn">support!</a></p>
        </EditForm>
    </article>
    <article class="right-section">
        <div class="signin-right-img"></div>
    </article>
</section>


@code {
    private bool IsWideScreen { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    public async Task InitializeScreenPropertiesAsync()
    {
        IsLoading = true;
        try
        {
            IsWideScreen = await Utility.IsWideScreenAsync(_jsRuntime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnCancelClick()
    {
        _navigationManager.NavigateTo("/VerifyTwoFactorAuth");
    }
}
 *@