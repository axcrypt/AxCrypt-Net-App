@using static AxCrypt.Abstractions.TypeResolve
@using AxCrypt.App.Shared.ViewModels
@using Microsoft.Maui.Devices
@using AxCrypt.Content

@inject LogOnViewModel LogOnViewModel

@if (LogOnViewModel!.ShowUpgradeStrongerEncryptionWarning)
{
    <div class="row site-warning" style="@PopupStyle">
        <div class="warning-message alert radius">
            @if (AxCrypt.App.Shared.Helpers.AxCServiceProviderExtension.LogOnViewModel!.License.Has(Core.Runtime.LicenseCapability.Viewer))
            {
                @Texts.StandardEncryptionWarning <strong><a class="grn-clr" href="javascript:void(0);" @onclick="RedirectToPurchasePage">@Texts.StandardEncryptionWarningText1</a></strong>
            }
            else
            {
                <span>@Texts.StandardEncryptionWarningText2 <strong><a class="grn-clr" href="javascript:void(0);" @onclick="RedirectToPurchasePage">@Texts.StandardEncryptionWarningText1</a></strong>.</span>
            }
            @*   <a @onclick="ClosePopup" class="close" style="float: right; color: #fff;">X</a> *@
        </div>
    </div>
}

@code {
    private string PopupStyle = "position:fixed;text-align:center;z-index:10;width:100%;";

    private void ClosePopup()
    {
        PopupStyle = "display: none;";
    }

    private void RedirectToPurchasePage()
    {
        Core.BrowseUtility.RedirectToPurchasePage(New<Core.UI.KnownIdentities>().DefaultEncryptionIdentity.UserEmail.Address, true, "");
    }
}