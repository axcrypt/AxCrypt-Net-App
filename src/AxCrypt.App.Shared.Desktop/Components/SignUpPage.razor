@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.Utility
@using AxCrypt.Content
@using AxCrypt.Core.UI.ViewModel

@inject OnlineSignUpService SignUp
@inject SignUpViewModel SignUpVm
@inject RegisterViewModel Register
@inject PasswordStrengthMeterViewModel StrengthMeter
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@implements IDisposable

<section class="lp-shell">

    @* ── Brand panel (left) ─────────────────────────── *@
    <aside class="lp-brand">
        <div class="lp-brand-bg"></div>
        <img class="lp-brand-key" src="images/axcryptIcon.png" alt="" aria-hidden="true" />

        <div class="lp-brand-inner">
            <div class="lp-brand-mark">
                <img class="lp-brand-logo-img" src="images/axcrypt_text.png" alt="AxCrypt" />
            </div>

            <h1 class="lp-brand-headline">
                Your files.<br />
                Protected everywhere.<br />
                <span class="lp-brand-emphasis">Always.</span>
            </h1>

            <p class="lp-brand-sub">
                Secure files, passwords, and private messages with powerful
                encryption — before they are shared, synced, or stored in the cloud.
            </p>

            <ul class="lp-brand-pills" aria-label="Why AxCrypt">
                <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    AES-256 device encryption
                </li>
                <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    Secure cloud storage &amp; simple sharing
                </li>
                <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    Works across devices
                </li>
                <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    @((MarkupString)Texts.VerifyMFAOffline)
                </li>
            </ul>
        </div>

        <div class="lp-brand-footer">© AxCrypt — File security made easy</div>
    </aside>

    @* ── Form panel (right) ──────────────────────────── *@
    <article class="lp-form sup2-form" id="content-wrap">
        @* sup2-scroll lets the form panel scroll when the window is short *@
        <div class="sup2-scroll">
        <div class="sup2-inner">

            @* ── Step indicator (2 steps) ────────────── *@
            <ol class="sup2-steps" role="list" aria-label="Sign-up progress">
                <li class="sup2-step @(SignUp.Step == SignUpStep.Email ? "sup2-step--active" : "sup2-step--done")">
                    <span class="sup2-step-dot">
                        @if (SignUp.Step != SignUpStep.Email)
                        {
                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.5">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        }
                        else
                        {

                            <span>1</span>
                        }
                    </span>
                    <span class="sup2-step-label">Account</span>
                </li>
                <li class="sup2-step-sep" aria-hidden="true"></li>
                <li class="sup2-step @(SignUp.Step != SignUpStep.Email ? "sup2-step--active" : "")">
                    <span class="sup2-step-dot"><span>2</span></span>
                    <span class="sup2-step-label">Verify &amp; Password</span>
                </li>
            </ol>

            @* ── Error banner (shared across all steps) ─ *@
            @if (!string.IsNullOrEmpty(SignUp.ErrorMessage))
            {
                <div class="lp-error" role="alert">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span>@SignUp.ErrorMessage</span>
                </div>
            }

            @* ══════════════════════════════════════════════════ *@
            @*  STEP 1 — Email + account type                     *@
            @* ══════════════════════════════════════════════════ *@
            @if (SignUp.Step == SignUpStep.Email)
            {
                <div class="sup2-head">
                    <h2 class="lp-title">Create your account</h2>
                    <p class="lp-sub">
                        Enter your email to get started. Already have an account?
                        <button type="button" class="lp-link" style="font-size:inherit;vertical-align:baseline;" @onclick="GoToLogin">Sign in</button>
                    </p>
                </div>

                @* Email first *@
                <div class="lp-field">
                    <div class="lp-field-head">
                        <label for="sup2-email">Email address</label>
                    </div>
                    <input type="email"
                           id="sup2-email"
                           class="lp-input"
                           value="@SignUpVm.Email"
                           @oninput="OnEmailInput"
                           @onkeydown="OnEmailKeyDown"
                           placeholder="@Texts.TypeYourEmailPlaceHolderText"
                           autocomplete="email"
                           tabindex="1" />
                </div>

                @* Account type — card-style radio selector *@
                <div class="sup2-acct-type" role="group" aria-label="Account type">
                    <div class="sup2-acct-label">Account type</div>
                    <div class="sup2-acct-cards">
                        <label class="sup2-acct-card @(!SignUpVm.IsBusinessAccount ? "sup2-acct-card--active" : "")">
                            <input type="radio" name="sup2-acct" class="sup2-acct-radio-input"
                                   checked="@(!SignUpVm.IsBusinessAccount)"
                                   @onchange="() => SignUpVm.IsBusinessAccount = false" />
                            <span class="sup2-acct-dot @(!SignUpVm.IsBusinessAccount ? "sup2-acct-dot--on" : "")"></span>
                            <div class="sup2-acct-text">
                                <span class="sup2-acct-name @(!SignUpVm.IsBusinessAccount ? "sup2-acct-name--active" : "")">Private</span>
                                <span class="sup2-acct-desc">For individuals - secure personal files on any device</span>
                            </div>
                        </label>
                        <label class="sup2-acct-card @(SignUpVm.IsBusinessAccount ? "sup2-acct-card--active" : "")">
                            <input type="radio" name="sup2-acct" class="sup2-acct-radio-input"
                                   checked="@SignUpVm.IsBusinessAccount"
                                   @onchange="() => SignUpVm.IsBusinessAccount = true" />
                            <span class="sup2-acct-dot @(SignUpVm.IsBusinessAccount ? "sup2-acct-dot--on" : "")"></span>
                            <div class="sup2-acct-text">
                                <span class="sup2-acct-name @(SignUpVm.IsBusinessAccount ? "sup2-acct-name--active" : "")">Business</span>
                                <span class="sup2-acct-desc">For organisations &amp; teams - manage and encrypt together</span>
                            </div>
                        </label>
                    </div>
                </div>

                @* Business email suggestion banner *@
                @if (SignUpVm.BusinessEmailSuggested && !SignUpVm.IsBusinessAccount)
                {
                    <div class="sup2-biz-suggest">
                        <div class="sup2-biz-suggest-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="7" width="20" height="14" rx="2" />
                                <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" />
                                <line x1="12" y1="12" x2="12" y2="16" />
                                <line x1="10" y1="14" x2="14" y2="14" />
                            </svg>
                        </div>
                        <div class="sup2-biz-suggest-content">
                            <div class="sup2-biz-suggest-title">Looks like a company email</div>
                            <div class="sup2-biz-suggest-body">AxCrypt Business includes team sharing, user management, and centralised company billing.</div>
                        </div>
                        <button type="button" class="sup2-biz-suggest-btn" @onclick="() => SignUpVm.IsBusinessAccount = true">
                            Switch to Business
                        </button>
                    </div>
                }

                @* Business fields — 2-col inline *@
                @if (SignUpVm.IsBusinessAccount)
                {
                    <div class="sup2-biz-row">
                        <div class="lp-field">
                            <div class="lp-field-head">
                                <label for="sup2-org">Company name</label>
                            </div>
                            <input type="text"
                                   id="sup2-org"
                                   class="lp-input"
                                   @bind-value="SignUpVm.OrganizationName"
                                   @bind-value:event="oninput"
                                   placeholder="Organization Name"
                                   autocomplete="organization"
                                   tabindex="2" />
                        </div>
                        <div class="lp-field">
                            <div class="lp-field-head">
                                <label for="sup2-country">Country</label>
                            </div>
                            @* Same comprehensive country list used on the Plan & Pay business form, instead
                               of this page's own separate, much shorter hardcoded list. *@
                            <select id="sup2-country"
                                    class="lp-input sup2-country-select"
                                    @bind="SignUpVm.Country"
                                    tabindex="3">
                                @foreach ((string ctry, string ctrname) in PlanAndPayViewModel.Countries)
                                {
                                    <option value="@ctry">@ctrname</option>
                                }
                            </select>
                        </div>
                    </div>
                    @* EU VAT — only shown when selected country is eligible *@
                    @if (SignUpVm.IsEuCountry)
                    {
                        <div class="lp-field" style="margin-top:10px">
                            <div class="lp-field-head">
                                <label for="sup2-vat">VAT number <span style="font-weight:400;color:#9ca3af;font-size:0.78rem">(optional)</span></label>
                            </div>
                            <input type="text"
                                   id="sup2-vat"
                                   class="lp-input"
                                   @bind-value="SignUpVm.VatNumber"
                                   @bind-value:event="oninput"
                                   placeholder="e.g. SE123456789001"
                                   tabindex="4" />
                        </div>
                    }
                }

                <button type="button"
                        class="lp-cta sup2-cta @(SignUp.IsBusy ? "lp-submit--loading" : "")"
                        disabled="@SignUp.IsBusy"
                        tabindex="@(SignUpVm.IsBusinessAccount ? 4 : 2)"
                        @onclick="ContinueFromEmailAsync">
                    @if (SignUp.IsBusy)
                    {
                        <span class="lp-cta-spinner" aria-hidden="true"></span>
                        <span>Sending code…</span>
                    }
                    else
                    {
                        <span>Continue</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    }
                </button>
            }

            @* ══════════════════════════════════════════════════ *@
            @*  STEP 2 — Verify email + set password (combined)   *@
            @* ══════════════════════════════════════════════════ *@
            else if (SignUp.Step == SignUpStep.Code || SignUp.Step == SignUpStep.Password)
            {
                @* ── Verify email card ─────────────────────────────────── *@
                <div class="sup2-section-card">
                    <div class="sup2-section-chip">STEP 2 &middot; VERIFY</div>
                    <h2 class="lp-title" style="margin-top:6px;margin-bottom:4px;">Verify your email</h2>
                    <p class="lp-sub" style="margin-bottom:14px;">
                        Enter the 6-digit code sent to <strong style="color:#48772C;font-weight:700;">@SignUp.Email</strong>.
                        @if (!SignUpVm.AllOtpFilled)
                        {
                            <span> Your password setup will appear once the code is complete.</span>
                        }
                    </p>

                    <div class="lp-field-head" style="margin-bottom:4px;">
                        <label style="font-size:0.78rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;">
                            Verification code
                        </label>
                    </div>
                    <div class="sup2-otp-row" id="sup2-otp-row" aria-label="Verification code">
                        @for (int i = 0; i < 6; i++)
                        {
                            int idx = i;
                            <input type="text"
                                   inputmode="numeric"
                                   maxlength="1"
                                   class="sup2-otp-box @(string.IsNullOrEmpty(SignUpVm.OtpDigits[idx]) ? "" : "sup2-otp-box--filled")"
                                   id="sup2-otp-@idx"
                                   value="@SignUpVm.OtpDigits[idx]"
                                   @oninput="e => OnOtpInput(idx, e)"
                                   @onkeydown="e => OnOtpKeyDown(idx, e)"
                                   autocomplete="one-time-code"
                                   tabindex="@(idx + 1)" />
                        }
                    </div>

                    <div class="sup2-otp-footer">
                        @if (SignUp.CanResend())
                        {
                            <button type="button" class="sup2-resend-btn" @onclick="ResendCodeAsync">
                                Resend code
                            </button>
                        }
                        else
                        {
                            <span style="font-size:0.78rem;color:#6b7280;">Didn't receive it?</span>
                            <span class="sup2-resend-cooldown">Resend in @_resendSecondsLeft s</span>
                        }
                    </div>
                </div>

                @* ── Password card — visible only after all OTP digits entered ── *@
                @if (SignUpVm.AllOtpFilled)
                {
                    <div class="sup2-section-card" id="sup2-pw-section">
                        <div class="sup2-section-chip">STEP 2 &middot; PASSWORD</div>
                        <h2 class="lp-title" style="margin-top:6px;margin-bottom:6px;">Set your password</h2>

                        <div class="sup2-pw-grid">
                            @* ── Left: inputs ── *@
                            <div class="sup2-pw-left">
                                <div class="lp-field" style="margin-bottom:10px">
                                    <div class="lp-field-head"><label for="sup2-pw">Password</label></div>
                                    <div class="lp-input-wrap">
                                        <input type="@(SignUpVm.ShowPassword ? "text" : "password")"
                                               id="sup2-pw"
                                               class="lp-input lp-input--password"
                                               @bind-value="SignUpVm.Password"
                                               @bind-value:event="oninput"
                                               placeholder="Create your password"
                                               autocomplete="new-password"
                                               tabindex="7" />
                                        <button type="button" class="lp-eye" tabindex="-1" @onclick="TogglePassword"
                                                aria-label="@(SignUpVm.ShowPassword ? "Hide" : "Show") password">
                                            @if (SignUpVm.ShowPassword)
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24" />
                                                    <line x1="1" y1="1" x2="23" y2="23" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </div>

                                <div class="lp-field">
                                    <div class="lp-field-head"><label for="sup2-pw-confirm">Confirm password</label></div>
                                    <div class="lp-input-wrap">
                                        <input type="@(SignUpVm.ShowConfirmPassword ? "text" : "password")"
                                               id="sup2-pw-confirm"
                                               class="lp-input lp-input--password"
                                               @bind-value="SignUpVm.ConfirmPassword"
                                               @bind-value:event="oninput"
                                               placeholder="Repeat your password"
                                               autocomplete="new-password"
                                               tabindex="8" />
                                        <button type="button" class="lp-eye" tabindex="-1" @onclick="ToggleConfirmPassword"
                                                aria-label="@(SignUpVm.ShowConfirmPassword ? "Hide" : "Show") confirm password">
                                            @if (SignUpVm.ShowConfirmPassword)
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24" />
                                                    <line x1="1" y1="1" x2="23" y2="23" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>

                            @* ── Right: strength + rules ── *@
                            <div class="sup2-pw-right">
                                <div class="sup2-pw-strength-row">
                                    <span class="sup2-pw-strength-lbl">Strength</span>
                                    <span class="sup2-pw-strength-val" style="color:@SignUpVm.PwStrengthColor">@SignUpVm.PwStrengthLabel</span>
                                </div>
                                <div class="sup2-pw-bar-track">
                                    <div class="sup2-pw-bar-fill" style="width:@(SignUpVm.PwStrengthPct)%;background:@SignUpVm.PwStrengthColor;transition:width 0.3s,background 0.3s;"></div>
                                </div>
                                <div class="sup2-pw-rules">
                                    <div class="sup2-pw-rule @(SignUpVm.PwHasLength ? "sup2-pw-rule--ok" : "")">
                                        <span class="sup2-pw-rule-icon"></span>8+ characters
                                    </div>
                                    <div class="sup2-pw-rule @(SignUpVm.PwHasCase ? "sup2-pw-rule--ok" : "")">
                                        <span class="sup2-pw-rule-icon"></span>Upper + lowercase
                                    </div>
                                    <div class="sup2-pw-rule @(SignUpVm.PwHasNumber ? "sup2-pw-rule--ok" : "")">
                                        <span class="sup2-pw-rule-icon"></span>At least one number
                                    </div>
                                    <div class="sup2-pw-rule @(SignUpVm.PwHasSymbol ? "sup2-pw-rule--ok" : "")">
                                        <span class="sup2-pw-rule-icon"></span>At least one symbol
                                    </div>
                                    <div class="sup2-pw-rule @(SignUpVm.PwConfirmMatch ? "sup2-pw-rule--ok" : "")">
                                        <span class="sup2-pw-rule-icon"></span>Passwords match
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(SignUp.ErrorMessage))
                        {
                            <div class="sup2-inline-error" role="alert">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                                <span>@SignUp.ErrorMessage</span>
                            </div>
                        }

                        <button type="button"
                                class="lp-cta sup2-cta @(SignUp.IsBusy || _isSubmitting ? "lp-submit--loading" : "")"
                                disabled="@(SignUp.IsBusy || _isSubmitting)"
                                tabindex="9"
                                @onclick="VerifyAndContinueToPlanAsync">
                            @if (SignUp.IsBusy || _isSubmitting)
                            {
                                <span class="lp-cta-spinner" aria-hidden="true"></span>
                                <span>Setting up…</span>
                            }
                            else
                            {
                                <span>Continue to plan</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                    <polyline points="12 5 19 12 12 19" />
                                </svg>
                            }
                        </button>
                    </div>
                }

                <div class="sup2-back-row">
                    <button type="button" class="sup2-back-btn" @onclick="BackToEmail">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        Back
                    </button>
                </div>
            }

            <p class="lp-legal" style="margin-top:1.5rem;">
                @Texts.AgreeOurText
                <a class="lp-link lp-link--inline" href="https://axcrypt.net/information/privacy-policy/" target="_blank">
                    @Texts.PrivacyPolicyLinkLabel
                </a>
                @Texts.AndText
                <a class="lp-link lp-link--inline" href="https://axcrypt.net/information/terms-of-use/" target="_blank">
                    @Texts.TermsOfUseLinkLabel
                </a>
            </p>

        </div>
        </div>@* sup2-scroll *@
    </article>
</section>

@* ── Loading overlay ─────────────────────────────────── *@
@if (_isSubmitting)
{
    <div class="lp-loading-overlay" role="status" aria-live="polite">
        <div class="lp-loading-card">
            <span class="lp-loading-spinner" aria-hidden="true"></span>
            <span class="lp-loading-msg">Setting up your account…</span>
        </div>
    </div>
}

<script type="text/javascript">
    window.sup2 = {
        focusOtp: function (idx) {
            const el = document.getElementById('sup2-otp-' + idx);
            if (el) { el.focus(); el.select(); }
        },
        focusPassword: function () {
            const el = document.getElementById('sup2-pw');
            if (el) {
                el.closest('#sup2-pw-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                setTimeout(function () { el.focus(); }, 200);
            }
        },
        attachOtpPaste: function (dotNetRef) {
            const row = document.getElementById('sup2-otp-row');
            if (!row) return;

            // ── Paste: distribute digits across all boxes ──────────
            if (row._sup2PasteHandler) {
                row.removeEventListener('paste', row._sup2PasteHandler);
            }
            row._sup2PasteHandler = function (e) {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData('text') || '';
                const digits = text.replace(/\D/g, '').slice(0, 6);
                if (digits.length > 0) {
                    dotNetRef.invokeMethodAsync('HandleOtpPaste', digits);
                }
            };
            row.addEventListener('paste', row._sup2PasteHandler);

            // ── Keydown: block non-numeric keys on every OTP box ───
            const ALLOWED_KEYS = new Set([
                'Backspace', 'Delete', 'Tab', 'Enter',
                'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
                'Home', 'End'
            ]);
            row.querySelectorAll('.sup2-otp-box').forEach(function (box) {
                box.addEventListener('keydown', function (e) {
                    // Always allow Ctrl/Cmd shortcuts (select-all, copy, paste, etc.)
                    if (e.ctrlKey || e.metaKey) return;
                    // Allow navigation / control keys
                    if (ALLOWED_KEYS.has(e.key)) return;
                    // Block anything that is not a single digit character
                    if (!/^[0-9]$/.test(e.key)) e.preventDefault();
                });
            });
        }
    };
</script>

@code {
    // ── Local state ──────────────────────────────────────────────
    private DotNetObjectReference<SignUpPage>? _dotNetRef;
    private bool _otpPasteAttached = false;
    private bool _allOtpFilledPrev = false;

    // ── Component-only state (not persisted across pages) ────────
    private bool _isSubmitting = false;
    private int _resendSecondsLeft = 0;
    private System.Threading.CancellationTokenSource? _cooldownCts;

    // ── Lifecycle ────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        SignUp.Reset();
        SignUpVm.ResetForNewSession(); // clear all form state for a fresh visit
        _isSubmitting = false;
        SignUp.OnChange += OnSignUpChanged;
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool onOtpStep = SignUp.Step == SignUpStep.Code || SignUp.Step == SignUpStep.Password;

        // Attach paste + numeric-only listener once the OTP row is in the DOM
        if (!_otpPasteAttached && onOtpStep)
        {
            _otpPasteAttached = true;
            await JSRuntime.InvokeVoidAsync("sup2.attachOtpPaste", _dotNetRef);
        }
        // Reset when user goes back to step 1
        if (_otpPasteAttached && SignUp.Step == SignUpStep.Email)
        {
            _otpPasteAttached = false;
            _allOtpFilledPrev = false;
        }
        // Auto-scroll and focus the password section the moment it appears
        if (onOtpStep && SignUpVm.AllOtpFilled && !_allOtpFilledPrev)
        {
            _allOtpFilledPrev = true;
            await JSRuntime.InvokeVoidAsync("sup2.focusPassword");
        }
        if (!SignUpVm.AllOtpFilled && _allOtpFilledPrev)
        {
            _allOtpFilledPrev = false;
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public void HandleOtpPaste(string digits)
    {
        for (int i = 0; i < 6; i++)
            SignUpVm.OtpDigits[i] = i < digits.Length ? digits[i].ToString() : string.Empty;
        InvokeAsync(StateHasChanged);
        InvokeAsync(() => FocusOtpBox(Math.Min(digits.Length, 5)));
    }

    public void Dispose()
    {
        SignUp.OnChange -= OnSignUpChanged;
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
        _dotNetRef?.Dispose();
    }

    private void OnSignUpChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // ── Step 1 handlers ─────────────────────────────────────────
    private async Task ContinueFromEmailAsync()
    {
        bool ok = await SignUp.SendCodeAsync(SignUpVm.Email, SignUpVm.IsBusinessAccount);
        if (ok)
        {
            StartCooldownTicker();
            await FocusOtpBox(0);
        }
    }

    private void OnEmailInput(ChangeEventArgs e)
    {
        SignUpVm.Email = e.Value?.ToString() ?? string.Empty;
        int at = SignUpVm.Email.IndexOf('@');
        if (at < 1 || at >= SignUpVm.Email.Length - 1)
        {
            SignUpVm.BusinessEmailSuggested = false;
            return;
        }
        string domain = SignUpVm.Email[(at + 1)..].ToLowerInvariant();
        SignUpVm.BusinessEmailSuggested = domain.Contains('.') && !SignUpVm.IsFreeEmailDomain(domain);
    }

    private async Task OnEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ContinueFromEmailAsync();
    }

    // ── Step 2 handlers ─────────────────────────────────────────
    private void OnOtpInput(int idx, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;

        // Accept a full paste (6 digits) into any box
        string digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length == 6)
        {
            for (int i = 0; i < 6; i++)
                SignUpVm.OtpDigits[i] = digits[i].ToString();
            InvokeAsync(() => FocusOtpBox(5));
            return;
        }

        // Single character — fill this box and advance
        string ch = digits.Length > 0 ? digits[digits.Length - 1].ToString() : string.Empty;
        SignUpVm.OtpDigits[idx] = ch;
        if (!string.IsNullOrEmpty(ch) && idx < 5)
        {
            InvokeAsync(() => FocusOtpBox(idx + 1));
        }
    }

    private async Task OnOtpKeyDown(int idx, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(SignUpVm.OtpDigits[idx]) && idx > 0)
        {
            SignUpVm.OtpDigits[idx - 1] = string.Empty;
            await FocusOtpBox(idx - 1);
        }
        else if (e.Key == "Enter")
        {
            await VerifyCodeAsync();
        }
    }

    private async Task VerifyCodeAsync()
    {
        string code = string.Concat(SignUpVm.OtpDigits);
        await SignUp.VerifyCodeAsync(code);
    }

    private async Task ResendCodeAsync()
    {
        bool ok = await SignUp.ResendCodeAsync();
        if (ok) StartCooldownTicker();
    }

    private void BackToEmail()
    {
        _cooldownCts?.Cancel();
        string savedEmail = SignUpVm.Email;
        SignUpVm.ResetStep2();
        SignUp.Reset();
        SignUpVm.Email = savedEmail; // restore email so step 1 input is pre-filled
    }

    // ── Combined step 2 handler ──────────────────────────────────
    /// <summary>
    /// Single action for the combined Verify + Password step:
    /// 1. Capture + validate password locally.
    /// 2. Verify the OTP — on failure stay on step 2 with inline error, clear OTP boxes.
    /// 3. On success: store credentials, pass business info, navigate to PlanAndPay.
    ///
    /// NOTE: Reset() is NOT called here. PlanAndPay reads SignUp.Email and business info
    /// from the service; Reset() will fire naturally next time SignUpPage is mounted.
    /// </summary>
    private async Task VerifyAndContinueToPlanAsync()
    {
        if (SignUp.IsBusy || _isSubmitting) return;

        string code = string.Concat(SignUpVm.OtpDigits);

        // Validate password locally first
        bool pwOk = SignUp.CapturePassword(SignUpVm.Password, SignUpVm.ConfirmPassword);
        if (!pwOk) return; // error message already set on SignUp

        _isSubmitting = true;
        await InvokeAsync(StateHasChanged);

        Register.CreateAccountModel.UserEmail = SignUp.Email;
        Register.CreateAccountModel.PasswordText = SignUp.Password;

        bool codeOk = await SignUp.VerifyCodeAsync(code);
        if (!codeOk)
        {
            // Stay on step 2 — show inline error, clear OTP boxes so user can re-enter
            SignUpVm.ResetStep2();
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
            await FocusOtpBox(0);
            return;
        }

        Register.ShowSignUp = false;
        Register.DialogResult = DialogResult.OK;

        // Pass business info to PlanAndPay via the shared service
        if (SignUpVm.IsBusinessAccount)
            SignUp.SetBusinessInfo(SignUpVm.OrganizationName, SignUpVm.Country, SignUpVm.VatNumber);
        else
            SignUp.EFF = true;

        _isSubmitting = false;
        // Navigate — do NOT Reset() here; PlanAndPay needs SignUp.Email + business info.
        Navigation.NavigateTo("/planAndPay");
    }

    private void TogglePassword() => SignUpVm.ShowPassword = !SignUpVm.ShowPassword;
    private void ToggleConfirmPassword() => SignUpVm.ShowConfirmPassword = !SignUpVm.ShowConfirmPassword;

    // ── Helpers ──────────────────────────────────────────────────
    private void GoToLogin()
    {
        SignUp.Reset();
        Register.ShowSignUp = false;
        Register.DialogResult = DialogResult.Cancel;
    }

    private async Task FocusOtpBox(int idx)
    {
        await JSRuntime.InvokeVoidAsync("sup2.focusOtp", idx);
    }

    /// <summary>
    /// Ticks every second and updates _resendSecondsLeft so the
    /// "Resend in N s" countdown stays live without a full service event.
    /// </summary>
    private void StartCooldownTicker()
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
        _cooldownCts = new System.Threading.CancellationTokenSource();
        var token = _cooldownCts.Token;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                int left = SignUp.SecondsUntilResend();
                _resendSecondsLeft = left;
                await InvokeAsync(StateHasChanged);
                if (left <= 0) break;
                await Task.Delay(1000, token).ContinueWith(_ => { }); // swallow cancellation
            }
        }, token);
    }
}
