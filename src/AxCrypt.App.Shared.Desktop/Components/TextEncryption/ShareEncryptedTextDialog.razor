@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Desktop.Models
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using static AxCrypt.Abstractions.TypeResolve

@inject TextShareViewModel ShareModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IStatusAlertService _statusAlertService

@*
    Share Encrypted Text dialog — redesigned with the .skd-* (share-key
    dialog) design system.  All @code logic is unchanged; only the
    markup and the inline <style> have been replaced.

    Structure
        skd-backdrop → skd-modal
          skd-header   (lock icon · "Share as link" · ×)
          skd-body
            tsd-tabs   (Anyone | Specific Users)
            [Specific Users] skd-section → input row + recipient list
            tsd-expiry (expires dropdown + tooltip)
            [After share]   tsd-link-callout
          skd-footer   (Cancel | Share)
*@

@if (ShareModel.IsVisible)
{
    <div class="skd-backdrop" @onclick="ShareModel.HideDialog">
        <div class="skd-modal tsd-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tsd-title"
             @onclick:stopPropagation>

            @* ── Header ─────────────────────────────────────── *@
            <header class="skd-header">
                <div class="skd-header-icon tsd-header-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
                    </svg>
                </div>
                <div class="skd-header-text">
                    <h2 id="tsd-title" class="skd-title">@Texts.ShareAsLinkActionText</h2>
                    <p class="skd-sub">Share your encrypted text — set who can access it and for how long.</p>
                </div>
                <button type="button" class="skd-close" @onclick="ShareModel.HideDialog" aria-label="Close">×</button>
            </header>

            <div class="skd-body">

                @* ── Tab switcher ────────────────────────────── *@
                <div class="tsd-tabs" role="tablist">
                    <button type="button"
                            role="tab"
                            class="tsd-tab @(TabIndex == 1 ? "tsd-tab--active" : "")"
                            aria-selected="@(TabIndex == 1)"
                            @onclick="async () => await RefreshUIForTab(1)">
                        @Texts.AnyoneText
                    </button>
                    <button type="button"
                            role="tab"
                            class="tsd-tab @(TabIndex == 2 ? "tsd-tab--active" : "")"
                            aria-selected="@(TabIndex == 2)"
                            @onclick="async () => await RefreshUIForTab(2)">
                        @Texts.SpecificUsersText
                    </button>
                </div>

                @* ── Specific Users panel ────────────────────── *@
                @if (TabIndex == 2)
                {
                    <section class="skd-section">
                        <label class="skd-label">
                            @string.Format(Texts.ChooseUpTo, MaxAllowedUsersToShare)
                        </label>

                        @if (!string.IsNullOrEmpty(ShareModel.ErrorMessage))
                        {
                            <div class="skd-error" role="alert">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="8" x2="12" y2="12"/>
                                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                                <span>@ShareModel.ErrorMessage</span>
                            </div>
                        }

                        @* Email input + Add *@
                        <div class="skd-add-row">
                            <div class="skd-input-wrap">
                                <svg class="skd-input-icon" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"/>
                                    <polyline points="22 6 12 13 2 6"/>
                                </svg>
                                <input type="text"
                                       class="skd-input"
                                       maxlength="150"
                                       placeholder="someone@example.com"
                                       autocomplete="off"
                                       @bind="ShareModel.UserInput"
                                       @onkeydown="OnEmailKeyDown" />
                            </div>
                            <button type="button"
                                    class="skd-btn skd-btn--primary"
                                    @onclick="AddEmail">
                                @Texts.AddPromptText
                            </button>
                        </div>

                        @* Recipient list *@
                        @if (ShareModel.ReceiverList != null && ShareModel.ReceiverList.Any())
                        {
                            <div class="skd-list-head">
                                <h3 class="skd-list-title">
                                    @string.Format(Texts.UsersWithAccessText,
                                        $"({ShareModel.ReceiverList.Count})")
                                </h3>
                            </div>
                            <ul class="skd-recipient-list">
                                @foreach (AxCrypt.Core.UI.EmailAddress receiver in ShareModel.ReceiverList)
                                {
                                    string addr = receiver.Address;
                                    <li class="skd-recipient">
                                        <span class="skd-recipient-avatar" aria-hidden="true">
                                            @InitialOf(addr)
                                        </span>
                                        <span class="skd-recipient-name">@addr</span>
                                        <button type="button"
                                                class="tsd-remove-btn"
                                                aria-label="Remove @addr"
                                                @onclick="() => Remove(addr)"
                                                @onclick:stopPropagation>
                                            <svg width="14" height="14" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2.5"
                                                 stroke-linecap="round" aria-hidden="true">
                                                <line x1="18" y1="6" x2="6" y2="18"/>
                                                <line x1="6" y1="6" x2="18" y2="18"/>
                                            </svg>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="skd-empty">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.6"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"/>
                                    <path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1"/>
                                </svg>
                                <p class="skd-empty-title">No recipients yet</p>
                                <p class="skd-empty-sub">Add an email above to share access.</p>
                            </div>
                        }
                    </section>
                }

                @* ── Expiry row ───────────────────────────────── *@
                <section class="skd-section tsd-expiry-section">
                    <label class="skd-label" for="tsd-expiry">@Texts.ExpireInLabelFirstPart</label>
                    <div class="tsd-expiry-row">
                        <div class="tsd-select-wrap">
                            <select id="tsd-expiry"
                                    class="tsd-select"
                                    @bind="ShareModel.ExpiresInOption">
                                @foreach (KeyValuePair<string, string> opt in ShareModel.ExpiryOptionsList)
                                {
                                    <option value="@opt.Key">@opt.Value</option>
                                }
                            </select>
                            <svg class="tsd-select-caret" width="12" height="12" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </div>

                        @* Info tooltip *@
                        <div class="tsd-info-wrap"
                             @onmouseover='() => ShareModel.ShowPopup("open")'
                             @onmouseout='ShareModel.HidePopup'>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round"
                                 class="tsd-info-icon" aria-label="Expiry information">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="8"/>
                                <line x1="12" y1="12" x2="12" y2="16"/>
                            </svg>
                            @if (ShareModel.IsHovered && ShareModel.HoveredElement == "open")
                            {
                                <div class="tsd-tooltip" role="tooltip">
                                    @Texts.ShareEncryptedTextDialog
                                </div>
                            }
                        </div>
                    </div>
                </section>

                @* ── Shared link callout ─────────────────────── *@
                @if (ShareModel.SharedLink != null)
                {
                    <div class="tsd-link-callout" role="status">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="#16a34a" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <div class="tsd-link-body">
                            <span class="tsd-link-label">Link ready — copy and share it</span>
                            <span class="tsd-link-url">@ShareModel.SharedLink</span>
                        </div>
                        <button type="button"
                                class="tsd-copy-btn @(CopyToClipboardUtility.CopiedInfoText != string.Empty ? "tsd-copy-btn--copied" : "")"
                                title="@Texts.SecretsCopytoClipboard"
                                @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(ShareModel.SharedLink.ToString())">
                            @if (CopyToClipboardUtility.CopiedInfoText != string.Empty)
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Copied!</span>
                            }
                            else
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                                </svg>
                                <span>@Texts.SecretsCopytoClipboard</span>
                            }
                        </button>
                    </div>
                }

            </div>

            @* ── Footer ─────────────────────────────────────── *@
            <footer class="skd-footer">
                <button type="button" class="skd-btn skd-btn--ghost" @onclick="ShareModel.HideDialog">
                    @Texts.ButtonCancelText
                </button>
                <button type="button"
                        class="skd-btn skd-btn--primary"
                        disabled="@ShareModel.IsApplying"
                        @onclick="async () => await ShareModel.ApplyAsync(TabIndex)">
                    @Texts.ShareLabel
                </button>
            </footer>

            @if (ShareModel.IsApplying)
            {
                <div class="tsd-apply-overlay">
                    <AxCrypt.App.Shared.Desktop.Components.Shared.AxLoader Mode="LoaderMode.Body" Message="@Texts.LoadingText" />
                </div>
            }
        </div>
    </div>
}

@* Styles live in AxCrypt.App.Windows/Resources/sass/HomeNew/ShareEncryptedText.scss *@

@code {
    private int MaxAllowedUsersToShare = 0;
    private int TabIndex { get; set; } = 1;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        MaxAllowedUsersToShare = ShareModel.MaxAllowedUsersCountToShare();
        ShareModel.OnUpdateViewState += async () => await UpdateState();
    }

    private async Task UpdateState()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void AddEmail()
    {
        if (New<AxCryptOnlineState>().IsOffline)
        {
            _statusAlertService.Error(Texts.NoInternetErrorMessage);
            return;
        }

        if (string.IsNullOrEmpty(ShareModel.UserInput))
        {
            ShareModel.ErrorMessage = Texts.ValidEmailAddressText;
            return;
        }

        ShareModel.ErrorMessage = "";
        AxCrypt.Core.UI.EmailAddress emailAddress;
        if (!AxCrypt.Core.UI.EmailAddress.TryParse(ShareModel.UserInput, out emailAddress))
        {
            ShareModel.ErrorMessage = Texts.ValidEmailAddressText;
            return;
        }

        if (ShareModel.ReceiverList.Any(su => su == emailAddress))
        {
            ShareModel.ErrorMessage = string.Format(Texts.EmailAlreadyAddedText, emailAddress.Address);
            return;
        }

        int maxUsersCount = ShareModel.MaxAllowedUsersCountToShare();
        if (ShareModel.ReceiverList.Count >= maxUsersCount)
        {
            ShareModel.ErrorMessage = string.Format(Texts.MaxUsersCountText, maxUsersCount);
            return;
        }

        ShareModel.ReceiverList.Add(emailAddress);
        ShareModel.UserInput = "";
    }

    private void Remove(string email)
    {
        AxCrypt.Core.UI.EmailAddress emailAddress = AxCrypt.Core.UI.EmailAddress.Parse(email);
        if (ShareModel.ReceiverList.Any(su => su == emailAddress))
        {
            ShareModel.ReceiverList.Remove(emailAddress);
        }
    }

    private void OnEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddEmail();
    }

    private async Task RefreshUIForTab(int tab)
    {
        TabIndex = tab;
        ShareModel.SharedLink = null;
        ShareModel.ErrorMessage = string.Empty;
        ShareModel.UserInput = string.Empty;
    }

    private static string InitialOf(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "?" : text.Trim()[..1].ToUpperInvariant();
}
