@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Helpers
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.Content
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Common
@using static AxCrypt.Abstractions.TypeResolve

@inject TextShareViewModel ShareModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IStatusAlertService _statusAlertService
<style>
    .popup-small {
        width: 397px !important;
        height: 375px !important;
        margin: auto;
        background: white;
        padding: 10px;
        border-radius: 8px;
    }

    .popup-large {
        width: 397px !important;
        height: 472px !important;
        margin: auto;
        background: white;
        padding: 20px;
        border-radius: 8px;
    }

    .action-btn {
        background-color: #96AD88;
        color: #ffffff;
        border-radius: 4px;
        width: 182px;
        height: 34px;
        font-size: 14px;
        text-align: center;
    }
</style>

@if (ShareModel.IsVisible)
{
    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="@(TabIndex == 1 ? "popup-small" : "popup-large")" style="margin-top:100px; height: fit-content !important;">
            <div class="close-img" @onclick="ShareModel.HideDialog" />

            <h2 style="margin: 10px 0;text-align:center;color:#494949"><b>@Texts.ShareAsLinkActionText</b></h2>

            <div class="action-tabs" style="margin: 20px auto;">
                <div id="anyone-tab" class="act-tab @(TabIndex == 1 ? "active" : "")" @onclick="() => TabIndex = 1">
                    <a href="javascript:void(0);">@Texts.AnyoneText</a>
                </div>
                <div id="spcific-tab" class="act-tab @(TabIndex == 2 ? "active" : "")" @onclick="() => TabIndex = 2">
                    <a href="javascript:void(0);">@Texts.SpecificUsersText</a>
                </div>
            </div>

            <div class="parent-container" style="min-height: fit-content;">
                @if (TabIndex == 2)
                {
                    <h5 style="margin: 10px 0; font-size:16px;">@string.Format(Texts.ChooseUpTo, MaxAllowedUsersToShare)</h5>

                    <div class="email-input-container">
                        @if (!string.IsNullOrEmpty(ShareModel.ErrorMessage))
                        {
                            <div class="error-message" style="padding-bottom: 5px;">@ShareModel.ErrorMessage </div>
                        }

                        <div style="display: flex; justify-content: center;gap: 20px;">
                            <input type="text" maxlength="150" @bind="ShareModel.UserInput" style="width: 90%;" />
                            <button class="button success active" style="width: 75px;height: 40px;" @onclick="AddEmail">
                                @Texts.AddPromptText
                            </button>
                        </div>

                        @if (ShareModel.ReceiverList != null && ShareModel.ReceiverList.Any())
                        {
                            <h3 style="margin: 10px 0; font-size:16px;">@string.Format(Texts.UsersWithAccessText, "(" + ShareModel.ReceiverList.Count + ")")</h3>
                            <table style="display: flex;gap: 10px;flex-wrap: wrap;">
                                @foreach (AxCrypt.Core.UI.EmailAddress receiver in ShareModel.ReceiverList)
                                {
                                    <tr>
                                        <td>
                                            <span class="email-text-list" title="@receiver.Address">@receiver.Address</span>
                                        </td>
                                        <td>
                                            <span class="remove-email" style="padding-left:10px;" @onclick="() => Remove(receiver.Address)">x</span>
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                }

                <div style="display:flex;justify-content:center;align-items: center;max-height: 40px;gap: 10px;margin-top: 15px;">
                    <label style="font-size:16px;">@Texts.ExpireInLabelFirstPart </label>

                    <select style="width:128px;height:32px;font-size:16px;" @bind="ShareModel.ExpiresInOption">
                        @foreach (KeyValuePair<string, string> selectOption in ShareModel.ExpiryOptionsList)
                        {
                            <option value="@selectOption.Key">@selectOption.Value</option>
                        }
                    </select>

                    <div style="position: relative;right:0;">
                        <img src="/images/premium/IcoInfOld.svg" alt="info icon" width="16" height="16" @onmouseover='@(() => ShareModel.ShowPopup("open"))' @onmouseout='@(() => ShareModel.HidePopup())'>
                        @if (ShareModel.IsHovered && ShareModel.HoveredElement == "open")
                        {
                            <div class="custom-password-help-hoverpopup text-center" style="background-color:#fff;right:0;">
                                <span class="txt-clr font-medium">@Texts.ShareEncryptedTextDialog</span>
                            </div>
                        }
                    </div>

                </div>

                <div style="display: flex; gap: 20px;justify-content: center;padding-top: 30px;">
                    <button class="button success btn-large font-medium active" @onclick="async () => await ShareModel.ApplyAsync(TabIndex)">@Texts.ShareLabel</button>
                    <button class="button border btn-large font-medium btn-hide" @onclick="ShareModel.HideDialog">@Texts.ButtonCancelText</button>
                </div>

                @if (ShareModel.SharedLink != null)
                {
                    <div style="display: flex;justify-content: center;padding-top: 15px;">
                        <button class="multi-actn-btn" title="Copy share link to clipboard" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(ShareModel.SharedLink.ToString())">
                            <img class="copy-clipboard-ico" alt="copy to clipboard ico" title="Copy share link to clipboard" width="16" height="16" />
                            @Texts.SecretsCopytoClipboard
                        </button>
                        @if (CopyToClipboardUtility.CopiedInfoText != string.Empty)
                        {
                            <label style="margin: auto 10px;">@CopyToClipboardUtility.CopiedInfoText</label>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {

    private int MaxAllowedUsersToShare = 0;

    private int TabIndex { get; set; } = 1;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        MaxAllowedUsersToShare = ShareModel.MaxAllowedUsersCountToShare();
        ShareModel.OnUpdateViewState += async () => await UpdateState();
    }

    private async Task UpdateState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private void AddEmail()
    {
        if (New<AxCryptOnlineState>().IsOffline)
        {
            _statusAlertService.Error(Texts.NoInternetErrorMessage);
            return;
        }

        if (string.IsNullOrEmpty(ShareModel.UserInput))
        {
            ShareModel.ErrorMessage = Texts.ValidEmailAddressText;
            return;
        }

        ShareModel.ErrorMessage = "";
        AxCrypt.Core.UI.EmailAddress emailAddress;
        if (!AxCrypt.Core.UI.EmailAddress.TryParse(ShareModel.UserInput, out emailAddress))
        {
            ShareModel.ErrorMessage = Texts.ValidEmailAddressText;
            return;
        }

        if (ShareModel.ReceiverList.Any(su => su == emailAddress))
        {
            ShareModel.ErrorMessage = string.Format(Texts.EmailAlreadyAddedText, emailAddress.Address);
            return;
        }

        int maxUsersCount = ShareModel.MaxAllowedUsersCountToShare();
        if (ShareModel.ReceiverList.Count >= maxUsersCount)
        {
            ShareModel.ErrorMessage = string.Format(Texts.MaxUsersCountText, maxUsersCount);
            return;
        }

        ShareModel.ReceiverList.Add(emailAddress);
        ShareModel.UserInput = "";
    }

    private void Remove(string email)
    {
        AxCrypt.Core.UI.EmailAddress emailAddress = AxCrypt.Core.UI.EmailAddress.Parse(email);
        if (ShareModel.ReceiverList.Any(su => su == emailAddress))
        {
            ShareModel.ReceiverList.Remove(emailAddress);
        }
    }

    private async Task CopyToClipBoard(string copyText)
    {
        await CopyToClipboardUtility.CopyToClipboard(copyText);
        _statusAlertService.Error(Texts.NoInternetErrorMessage);
    }
}
