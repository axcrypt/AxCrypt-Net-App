@using AxCrypt.App.Shared.Desktop.Code
@using AxCrypt.App.Shared.Desktop.ViewModels;
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve

@inject TextEncryptionViewModel TextEncryptionViewModel
@inject TextShareViewModel TextShareModel
@inject CopyToClipboardUtility CopyToClipboardUtility
@inject IStatusAlertService _statusAlertService
@inject IJSRuntime JSRuntime

@if (!string.IsNullOrEmpty(TextEncryptionViewModel.ErrorMessage))
{
    <div class="alert alert-danger">@TextEncryptionViewModel.ErrorMessage</div>
}

<div>
    <label style="display: block;">@Texts.InputTextHeading</label>
    <textarea required rows="5" class="entr-txt-box" @bind="TextEncryptionViewModel.InputText" placeholder="@Texts.EnterTextToEncryptPlaceHolder" maxlength="@TextEncryptionViewModel.MaxAllowedCharators" @oninput="ValidateLength"></textarea>

    <div id="custom-pwd-section">
        <label>
            <input class="che-box" type="checkbox" id="userchoice" @onclick=TextEncryptionViewModel.ShowHideCustomPassword checked="@TextEncryptionViewModel.IsCustomPasswordMode" />
            <span>@Texts.UseCustomPasswordHead</span>
        </label>
        <img src="/images/premium/IcoInfOld.svg" alt="info icon" width="16" height="16" @onmouseover='@(() => TextEncryptionViewModel.ShowPopup("open"))' @onmouseout='@(() => TextEncryptionViewModel.HidePopup())'>

        @if (TextEncryptionViewModel.IsHovered && TextEncryptionViewModel.HoveredElement == "open")
        {
            <div class="custom-password-help-hoverpopup text-center" style="background-color:#fff;">
                <span class="txt-clr font-medium">@Texts.UseCustomPasswordHead1</span>
            </div>
        }
        @if (TextEncryptionViewModel.IsCustomPasswordMode)
        {
            <br />
            <label>@Texts.PassphrasePrompt:</label>

            <div class="password-container">
                <i class="@TextEncryptionViewModel.PasswordIconClass" style="top:40% !important;" @onclick="TextEncryptionViewModel.TogglePassword"></i>
                <input type="@TextEncryptionViewModel.PasswordInputType" id="passwordbox" min="8" @bind="TextEncryptionViewModel.Password" @bind:event="oninput">
            </div>
            <AxCrypt.App.Shared.Desktop.Components.Shared.PasswordStrengthMeterComponent InputValue="@TextEncryptionViewModel.Password" />
        }
    </div>

    <div class="encryp-and-reset-btn">
        <button class="button success btn-large font-medium active" @onclick="async () => await TextEncryptionViewModel.EncryptText()">@Texts.EncryptLabelText</button>
        <button class="button border btn-large font-medium btn-hide" @onclick=TextEncryptionViewModel.ResetBtn>@Texts.ResetLabelText</button>
    </div>
</div>

<div>
    <label style="display: block;">@Texts.EncryptedTextHead</label>
    <textarea class="encrypt-txt-box" rows="7" @bind="TextEncryptionViewModel.EncryptedText" placeholder="@Texts.EncryptedTextAppearsHerePlaceHolder" readonly></textarea>
</div>

<div class="multi-btn">
    <button class="multi-actn-btn" @onclick="async () => await CopyToClipboardUtility.CopyToClipboard(TextEncryptionViewModel.EncryptedText)">
        <img class="copy-clipboard-ico" alt="copy to clipboard ico" title="Copy encrypted text to clipboard" width="16" height="16" />
        @Texts.SecretsCopytoClipboard
    </button>

    <button class="multi-actn-btn" @onclick=TextEncryptionViewModel.ExportTextAsync>
        <img class="download-ico" alt="download ico" title="Download encrypted text as txt file" width="16" height="16" />
        @Texts.DownloadAsTxtButton
    </button>

    <button class="multi-actn-btn" @onclick=TextEncryptionViewModel.EncryptSendEmailBtn>
        <img class="email-ico" alt="email ico" title="Compose a new email with encrypted text" width="16" height="16" />
        @Texts.SendViaEmailButton
    </button>

    <button class="multi-actn-btn" @onclick=ShowShareTextDialog>
        <img class="sharelink-ico" alt="share as link ico" title="Share encrypted text as link" width="16" height="16" />
        Share as Link
    </button>
</div>

<AxCrypt.App.Shared.Desktop.Components.TextEncryption._ShareEncryptedTextDialog />

<div>
    <span id="copiedMessage" style="color: #48772C; font-weight: bold;">@CopyToClipboardUtility.CopiedInfoText</span>
</div>

@code {
    protected override void OnInitialized()
    {
        TextEncryptionViewModel.Initialize();
        TextEncryptionViewModel.SelectedTap = "TextEncryption";
        TextEncryptionViewModel.ResetBtn();
        base.OnInitialized();
    }

    private async Task DownloadEncryptedText()
    {
        if (string.IsNullOrWhiteSpace(TextEncryptionViewModel.EncryptedText))
            return;

        string? textContent = TextEncryptionViewModel.EncryptedText;
        byte[]? bytes = System.Text.Encoding.UTF8.GetBytes(textContent);

        string? fileName = "EncryptedText.txt";

        await using MemoryStream? stream = new MemoryStream(bytes);
        using DotNetStreamReference? streamRef = new Microsoft.JSInterop.DotNetStreamReference(stream);

        await JSRuntime.InvokeVoidAsync(identifier: "downloadFileFromStream", fileName, streamRef);
    }

    private bool IsValid = true;

    private void ValidateLength(ChangeEventArgs e)
    {
        TextEncryptionViewModel.InputText = e.Value?.ToString() ?? "";

        if (TextEncryptionViewModel.InputText.Length > TextEncryptionViewModel.MaxAllowedCharators)
        {
            TextEncryptionViewModel.ErrorMessage = string.Format(Texts.MaximumCharactersNotification, TextEncryptionViewModel.MaxAllowedCharators);
        }
    }

    private void ShowShareTextDialog()
    {
        if (New<AxCryptOnlineState>().IsOffline)
        {
            _statusAlertService.Error(Texts.NoInternetErrorMessage);
            return;
        }

        TextShareModel.EncryptedText = TextEncryptionViewModel.EncryptedText;
        TextShareModel.Passphrase = new Passphrase(TextEncryptionViewModel.Password ?? "");
        TextShareModel.ReceiverList = new List<EmailAddress>();
        TextShareModel.SharedLink = null;
        TextShareModel.ShowDialog();
    }
}