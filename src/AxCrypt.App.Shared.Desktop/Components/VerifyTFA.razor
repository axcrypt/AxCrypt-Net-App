@using AxCrypt.Abstractions
@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.Content
@using AxCrypt.App.Shared.Utility
@using static AxCrypt.Abstractions.TypeResolve

@inject IJSRuntime JSRuntime
@inject TwoFactorAuthViewModel TwoFactorModel
@inject NavigationManager NavigationManager

<section class="content">
    <article class="left-section" id="content-wrap" style="margin-top:10%;">
        <span class="tfa-sub-head">Two-factor verification</span>
        <p style="margin-top: 16px;">Your account is protected with <span class="two-fa-text">2FA.</span></p>
        <p style="margin: 0 6% 0 0;">To finish signing in, enter the 6-digit code generated by your authentication app.</p>

        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" class="signup-sec">
            <DataAnnotationsValidator />
            <div class="verify-code-txt">
                <input type="tel" inputmode="numeric" pattern="[0-9]*" id="verify-code-txtbox" class="form-control @(IsOtpInvalid ? "input-invalid" : "")"
                       placeholder="Verification code" maxlength="6" @ref="OtpInputRef" @bind="TwoFactorModel.OneTimePassword"
                       @oninput="ValidateCode" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                <ValidationMessage style="font-size: 13px;color: #f00;display: block;position: relative;font-weight: 700;" For="@(() => TwoFactorModel.OneTimePassword)" />
            </div>

            @if (!string.IsNullOrEmpty(TwoFactorModel.ErrorMessage))
            {
                <div class="error-message">@TwoFactorModel.ErrorMessage</div>
            }

            <button type="submit" class="button success grn-bg whte-clr" style="width:100%; margin:20px 0 0;" disabled="@(!IsCodeValid())">Login</button>
            <button type="button" @onclick="OnCancelClick" class="button cancel whte-clr" style="width:100%; margin:20px 0 30px;">@Texts.ButtonCancelText</button>

            <div class="text-center" style="margin-top:2rem;">
                <p><strong>Don't have your phone?</strong></p>
                <p>Use a <a href="" @onclick="RedirectToMyRecoverTwoFactorPage" class="recry-code-btn"> recovery code </a> to access your account.</p>
                @* <p>Or <a href="https://account.axcrypt.net/en/Home/RecoverTwoFactor" class="recry-code-btn">enter an email to get OTP </a> to access your account.</p> *@
            </div>
        </EditForm>

    </article>
    <article class="right-section">
        <div class="signin-right-img"></div>
    </article>
</section>

<script type="text/javascript">
    window.verifyFunctions = {
        focusElement: function (id) {
            const element = document.getElementById(id);
            element.focus();
        }
    }
</script>

@code {
    private bool IsWideScreen { get; set; }
    private ElementReference OtpInputRef;
    private EditContext? editContext;

    private bool IsCodeValid() => TwoFactorModel.OneTimePassword?.Length == 6 && TwoFactorModel.OneTimePassword.All(char.IsDigit);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        TwoFactorModel.OnUpdateViewState += UpdatePageState;
        editContext = new EditContext(TwoFactorModel);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await JSRuntime.InvokeVoidAsync("verifyFunctions.focusElement", "verify-code-txtbox");
    }

    public void RedirectToMyRecoverTwoFactorPage()
    {
        Core.BrowseUtility.RedirectToAccountWebUrl("{0}Home/RecoverTwoFactor");
    }

    private bool IsOtpInvalid;

    private async void ValidateCode(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? "";
        if (value!.Length == 6 && value.All(char.IsDigit) && editContext is not null)
        {
            bool isValid = editContext.Validate();
            if (!isValid)
            {
                return;
            }

            TwoFactorModel.OneTimePassword = value;
            await HandleValidSubmit();
        }
    }

    private async Task HandleValidSubmit()
    {
        TwoFactorModel.ErrorMessage = null;
        await TwoFactorModel.TwoFactorVerifiedTaskAsync(TwoFactorModel.OneTimePassword!);
    }

    private void OnCancelClick()
    {
        TwoFactorModel.OneTimePassword = "";
        TwoFactorModel.ErrorMessage = "";
        TwoFactorModel.PageResult = DialogResult.Cancel;
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}
