@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Services.Interface

@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LogOnViewModel LogOnViewModel
@inject ICssService CssService

<link href="css/login.min.css" rel="stylesheet" />

@if (SubscriptionLevel != null)
{
    <link href="css/@SubscriptionLevel/sidemenu.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/index.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/site.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/topmenu.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/notification.min.css" rel="stylesheet" />

    <link href="css/@SubscriptionLevel/newsecret.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/secretlist.min.css" rel="stylesheet" />
    <link href="css/@SubscriptionLevel/support.min.css" rel="stylesheet" />
}

<div class="page" dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (PageRendering)
    {
        <main>
            <div class="secrets-loading-overlay">
                <div class="loading-content">
                    <img src="/images/default/Loading_560x560.gif" alt="Loading..." />
                    <span style="color:black ">Preparing AxCrypt...</span>
                </div>
            </div>
        </main>
    }
    else
    {
        @if (LogOnViewModel.IsLoggedOn && !CanShowSignInPage)
        {
            <div class="sidebar">
                @if (!Utility.IsMainMenuHidden)
                {
                    <img class="hide-icon" src="" alt="image hide" @onclick="()=> Utility.ToggleMainMenu()" />
                    <NavMenu />
                }
                else
                {
                    <div class="" style="width:100px;overflow:hidden; ">
                        <img class="expbd-icon" src="" alt="image hide" @onclick="()=> Utility.ToggleMainMenu()" />
                        <NavMenu />
                    </div>
                }
            </div>
        }

        <main>
            @if (LogOnViewModel.IsLoggedOn && !CanShowSignInPage)
            {
                <div class="top-menu-section">
                    <AxCrypt.App.Windows.Components.Pages.Main.TopMenu />
                </div>

                <div class="body-content-section">
                    @Body
                </div>

                <AxCrypt.App.Windows.Components.Pages.PopupDialog.InvitePopup />
                <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.ImportPrivatePasswordDialog />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.RenewSubscriptionDialog />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.CreateNewAccountDialog />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.FilePasswordDialog />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.VerifyAccountDialog />
                <AxCrypt.App.Windows.Components.Pages.PopupDialog.VerifyPasswordDialog />
                <AxCrypt.App.Windows.Components.Pages.Shared.ShareKey />
                <AxCrypt.App.Windows.Components.Pages.About />
                <AxCrypt.App.Windows.Components.Pages.Feedback />
                <AxCrypt.App.Components.Pages.StatusAlertComponent />
            }
            else
            {
                <div id="body-section">
                    @Body
                </div>
            }

            <AxCrypt.App.Components.Pages.ProcessIndicatorComponent />
        </main>
    }
</div>

@code {
    private bool PageRendering { get; set; } = true;
    private bool CanShowSignInPage { get; set; }
    private string? SubscriptionLevel { get; set; }

    protected override void OnInitialized()
    {
        InitiateDelayToRenderPage();
        CanShowSignInPage = LogOnViewModel.IsVisible;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdateSignInPageState;
        LogOnViewModel.OnSubscriptionChanged += UpdateSubscriptionState;
        SubscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        base.OnInitialized();
    }

    private void UpdateSignInPageState(bool canShowSignInPage)
    {
        CanShowSignInPage = canShowSignInPage;
        UpdateUIState();

        // InvokeAsync(() =>
        // {
        //     CanShowSignInPage = canShowSignInPage;
        //     StateHasChanged(); // Refresh UI
        // });
    }

    private async void UpdateSubscriptionState()
    {
        SubscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        await AddCssAsync(SubscriptionLevel);
        UpdateUIState();

        // InvokeAsync(async () =>
        // {
        //     SubscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        //     await AddCssAsync(SubscriptionLevel);
        //     StateHasChanged(); // Refresh UI
        // });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
    }

    private async void InitiateDelayToRenderPage()
    {
        await Task.Delay(4000);
        PageRendering = false;
        UpdateUIState();
    }

    private void UpdateUIState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    async Task AddCssAsync(string subscriptionLevel)
    {
        string[] list = CssService.ApplySubscriptionCssAsync(subscriptionLevel);
        foreach (string cssFile in list)
        {
            await JS.InvokeVoidAsync("addCssFile", cssFile);
        }
    }
}
