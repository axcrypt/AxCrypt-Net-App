@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models

@using static AxCrypt.Abstractions.TypeResolve;

@inherits LayoutComponentBase
@inject IJSRuntime JS

<link href="css/@SubscriptionLevel.ToString().ToLower()/sidemenu.min.css" rel="preload" as="style" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/site.min.css" rel="preload" as="style" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/index.min.css" rel="preload" as="style" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/topmenu.min.css" rel="stylesheet" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/support.min.css" rel="stylesheet" importance="high" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/notification.min.css" rel="stylesheet" importance="high" />
<link href="css/login.min.css" rel="stylesheet" />

<div class="page" dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (!IsLoading)
    {
        <div class="">
            @if (!Utility.IsMainMenuHidden)
            {
                <img class="hide-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                <NavMenu />
            }
            else
            {
                <div class="" style="width:100px;overflow:hidden; ">
                    <img class="expbd-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                    <NavMenu />
                </div>
            }
        </div>
        <main>
            <div>
                <AxCrypt.App.Windows.Components.Pages.Main.TopMenu />
            </div>

            @Body

            <div>
                <AxCrypt.App.Components.Pages.ProcessIndicatorComponent />
                <AxCrypt.App.Components.Pages.StatusAlertComponent />
            </div>
        </main>
    }
    else
    {
        <p>Loading...</p>
    }
</div>

@code {
    private SubscriptionLevel SubscriptionLevel { get; set; }
    bool IsLoading { get; set; }
    private string UserEmail { get; set; }

    protected override void OnInitialized()
    {
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        UserEmail = New<AccountStatusViewModel>().UserEmail;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                //IsWideScreen = await Utility.IsWideScreenAsync(JS);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error determining screen width: {ex.Message}");
            }
            finally
            {
                await AddCssFiles();
                IsLoading = false;
                SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
                StateHasChanged();
            }
        }
    }

    private async Task AddCssFiles()
    {
        string cssBasePath = $"css/{SubscriptionLevel.ToString().ToLower()}/";

        await JS.InvokeVoidAsync("addCssFile", $"{cssBasePath}sidemenu.min.css");
        await JS.InvokeVoidAsync("addCssFile", $"{cssBasePath}index.min.css");
        await JS.InvokeVoidAsync("addCssFile", $"{cssBasePath}site.min.css");
        await JS.InvokeVoidAsync("addCssFile", $"{cssBasePath}topmenu.min.css");
        await JS.InvokeVoidAsync("addCssFile", $"{cssBasePath}notification.min.css");
    }
}
