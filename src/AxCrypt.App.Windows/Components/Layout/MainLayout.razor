@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels

@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LogOnViewModel LogOnViewModel
@inject ICssService CssService
@inject NavigationManager navigationManager

@{
    string arabic = Core.Resolve.UserSettings.CultureName == "ar" ? "arabic-class" : "";
}

<div class="page @arabic" dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")" @onclick="async (e) => await LogOnViewModel.AxCryptMainForm_ClickAsync(e)" @onmousemove="async (e) => await LogOnViewModel.AxCryptMainForm_ClickAsync(e)">
    @if (PageRendering)
    {
        <main>
            <div class="secrets-loading-overlay">
                <div class="loading-content">
                    <img src="/images/default/Loading_560x560.gif" alt="Loading..." />
                    <span style="color:black ">Preparing AxCrypt...</span>
                </div>
            </div>
        </main>
    }
    else
    {
        @if (LogOnViewModel.IsLoggedOn && !CanShowSignInPage)
        {
            <div>
                <AxCrypt.App.Shared.Desktop.Components.Shared.StandardEncryptionWarning />
            </div>
        }
        <div style="display: contents;">
            @if (LogOnViewModel.IsLoggedOn && !CanShowSignInPage)
            {
                <div class="sidebar">
                    @if (!Utility.IsMainMenuHidden)
                    {
                        <img class="hide-icon" src="" alt="image hide" @onclick="()=> Utility.ToggleMainMenu()" />
                        <NavMenu />
                    }
                    else
                    {
                        <div class="" style="width:100px;overflow:hidden; ">
                            <img class="expbd-icon" src="" alt="image hide" @onclick="()=> Utility.ToggleMainMenu()" />
                            <NavMenu />
                        </div>
                    }
                </div>
            }

            <main>
                @if (LogOnViewModel.IsLoggedOn && !CanShowSignInPage)
                {
                    <AxCrypt.App.Shared.Desktop.Components.Main.HeaderComponent />

                    <div class="body-content-section">
                        @Body
                    </div>

                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.StatusAlertComponent />

                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.InvitePopup />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.Upgrade />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.ImportPrivatePasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.RenewSubscriptionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.FilePasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyAccountDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyPasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.Home.ShareKeyComponent />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.About />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.Feedback />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.AdvancedOptionsDialog />
                }
                else
                {
                    <div id="body-section">
                        @Body
                    </div>
                }
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.GlobalPopupDialog />

            </main>
        </div>
    }
</div>

@code {
    private bool PageRendering { get; set; } = true;
    private bool CanShowSignInPage { get; set; }
    private string? SubscriptionLevel { get; set; }

    protected async override Task OnInitializedAsync()
    {
        InitiateDelayToRenderPage();
        CanShowSignInPage = LogOnViewModel.IsVisible;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdateSignInPageState;
        LogOnViewModel.OnTFADialogVisibilityChanged += UpdateSignInPageState;
        LogOnViewModel.OnSubscriptionChanged += UpdateSubscriptionState;
        SubscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        await AddCssAsync(SubscriptionLevel);
        UpdateSubscriptionState();

        base.OnInitialized();
    }

    private void UpdateSignInPageState(bool canShowSignInPage)
    {
        CanShowSignInPage = canShowSignInPage;
        string currentURi = navigationManager.Uri;
        if (CanShowSignInPage && currentURi.Replace(navigationManager.BaseUri, "") != "")
        {
            navigationManager.NavigateTo("/", true);
            return;
        }

        UpdateUIState();
    }

    private async void UpdateSubscriptionState()
    {
        if (SubscriptionLevel == LogOnViewModel.SubscriptionLevel.ToString().ToLower())
        {
            //UpdateUIState();
            return;
        }

        SubscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        if (LogOnViewModel.IsLoggedOn)
        {
            await AddCssAsync(SubscriptionLevel);
        }
        string currentURi = navigationManager.Uri;
        if (!LogOnViewModel.IsLoggedOn && currentURi.Replace(navigationManager.BaseUri, "") != "")
        {
            navigationManager.NavigateTo("/", true);
            return;
        }
        UpdateUIState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
    }

    private async void InitiateDelayToRenderPage()
    {
        await Task.Delay(1000);
        PageRendering = false;
        UpdateUIState();
    }

    private async void UpdateUIState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    async Task AddCssAsync(string subscriptionLevel)
    {
        IList<KeyValuePair<string, string>> cssFileList = CssService.ApplySubscriptionCssAsync(subscriptionLevel);
        foreach (KeyValuePair<string, string> cssFile in cssFileList)
        {
            await JS.InvokeVoidAsync("addCssFile", cssFile.Key, cssFile.Value);
        }
    }
}
