@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Data
@inherits LayoutComponentBase

<link href="css/@subscriptionLevel.ToString().ToLower()/sidemenu.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/site.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/index.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/topmenu.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/support.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel.ToString().ToLower()/notification.min.css" rel="stylesheet" importance="high" />
<link href="css/login.min.css" rel="stylesheet" />

<div class="page" dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (!IsLoading)
    {
        <div class="sidebar">
            @if (!Utility.IsMainMenuHidden)
            {
                <img class="hide-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                <NavMenu />
            }
            else if (Utility.IsMainMenuHidden)
            {
                <div class="" style="width:100px;overflow:hidden; ">
                    <img class="expbd-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                    <NavMenu />
                </div>
            }
        </div>
        <main>
            <div>
                <AxCrypt.App.Windows.Components.Pages.TopMenu />
            </div>
            @Body
        </main>
    }
    else
    {
        <p>Loading...</p>
    }
</div>

@code {
    private SubscriptionLevel subscriptionLevel;
    //bool IsWideScreen { get; set; }
    bool IsLoading { get; set; }

    protected override void OnInitialized()
    {
        subscriptionLevel = SubscriptionLevel.Premium;
        base.OnInitialized();
    }
}
