@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.Services
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LogOnViewModel LogOnViewModel
@inject ICssService CssService
@inject NavigationManager navigationManager
@inject ImportPrivateKeyViewModel ImportViewModel
@inject PopupService popupService
@inject IFilePasswordWindowService FilePasswordWindowService
@* PaidFeaturegateService is no longer injected here — the paid-gate
   modal now lives entirely inside its own component
   (Components/Shared/PaidGateDialog.razor) which injects the service
   on its own. *@

@{
    string arabic = Core.Resolve.UserSettings.CultureName == "ar" ? "arabic-class" : "";
}

<div class="@arabic" dir="@(Core.Resolve.UserSettings.CultureName == "ar" ? "rtl" : "ltr")" @onclick="(e) => LogOnViewModel.AxCryptMainForm_Click(e)" @onmousemove="(e) => LogOnViewModel.AxCryptMainForm_Click(e)">
    @if (PageRendering || (LogOnViewModel.IsLoggedOn && PageStyleRendering))
    {
        @* Boot loader — uses the same AxLoader visual the rest of
           the app shows, so the brand experience is consistent
           from cold start through to in-app waits. *@
        <main>
            <AxCrypt.App.Shared.Desktop.Components.Shared.AxLoader
                Mode="AxCrypt.App.Shared.Desktop.Models.LoaderMode.FullPage"
                Message="@Texts.PreparingAxCryptText" />
        </main>
    }
    else
    {
        <div class="app-shell @(Utility.IsMainMenuHidden ? "sidebar-collapsed" : "")" @onclick="CloseContextMenu">
            @if (CanShowSigedInContent)
            {
                <AxCrypt.App.Shared.Desktop.Components.HomePage.SideBar />

                @* string sideMenuCollapsedStyle = Utility.IsMainMenuHidden ? "sid-mnu-colpsd" : "";

                <div class="@sideMenuCollapsedStyle side-menu" style="max-width:400px;">
                    @if (!Utility.IsMainMenuHidden)
                    {
                        <div style="position: relative;top: 120px;margin-left: auto;">
                            <img class="hide-icon" style="position: relative;z-index:1;width: 30px;margin-left: -15px;" src="" alt="image hide" @onclick="() => Utility.ToggleMainMenu()">
                        </div>
                        <NavMenu />
                        <AxCrypt.App.Shared.Desktop.Components.HomePage.SideBar />

                    }
                    else
                    {
                        <div class="" style="width:100px;overflow:hidden;top: 120px;">
                            <img class="expbd-icon" style="z-index:1;" src="" alt="image hide" @onclick="() => Utility.ToggleMainMenu()" />

                            <NavMenu />
                            <AxCrypt.App.Shared.Desktop.Components.HomePage.SideBar />

                        </div>
                    }
                </div> *@


                <!-- Click-outside backdrop for profile menu -->
                @if (popupService.AnyPopupOpen)
                {
                    <div class="global-backdrop" @onclick="popupService.CloseAllPopups"></div>
                }
            }

            <main class="main-content">
                @if (CanShowSigedInContent)
                {
                    @* <AxCrypt.App.Shared.Desktop.Components.Main.HeaderComponent /> *@
                    <AxCrypt.App.Shared.Desktop.Components.HomePage.TopBar />

                    @Body
                    @* string sideMenuCollapsedbodyStyle = Utility.IsMainMenuHidden ? "sid-mnu-colpsd-body" : "";
                    <div class="body-content-section @sideMenuCollapsedbodyStyle">
                        @Body
                    </div> *@

                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.StatusAlertComponent />

                    @* Single component handles TryNow / Upgrade / Business
                       conversion popups — replaces the three separate files.
                       Copy and feature-card definitions live in ConversionDialogConfig.cs. *@
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.ConversionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.TryUpgradeDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.RenewSubscriptionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyAccountDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyPasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.UserPromptDialog />
                }
                else
                {
                    <div id="body-section">
                        @Body
                    </div>
                }

                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.GlobalPopupDialog />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.UpgradeVersionDialog />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.About />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.ImportPrivatePasswordDialog />
                <AxCrypt.App.Shared.Desktop.Components.Shared.AccountPlanSetupRequiredPopup />
                @* Feature-gate popup (small modal for locked features) *@
                <AxCrypt.App.Shared.Desktop.Components.Shared.PaidGateDialog />
            </main>
        </div>
    }
</div>

@code {
    private bool PageRendering { get; set; } = true;

    private bool PageStyleRendering { get; set; } = true;

    private bool CanShowSignInPage { get; set; }

    // Tracks whether the user has been signed in at any point this session.
    // Distinguishes a sign-out (was signed in → now signed out) from a
    // pre-login signup flow so we redirect to login after sign-out even
    // when the current page is /upgradePage or /planAndPay.
    private bool _wasSignedIn = false;

    protected async override Task OnInitializedAsync()
    {
        await InitiateDelayToRenderPage();
        CanShowSignInPage = LogOnViewModel.IsVisible;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdateSignInPageState;
        ImportViewModel.ImportPrivateKeyDialog.OnDialogVisibilityChanged += UpdateUIState;
        LogOnViewModel.OnMFADialogVisibilityChanged += UpdateSignInPageState;
        LogOnViewModel.OnSubscriptionChanged += async () => await UpdateSubscriptionState();

        if (LogOnViewModel.IsLoggedOn)
        {
            await AddCssAsync();
        }

        await InitializeTheme();

        base.OnInitialized();
    }

    private void UpdateSignInPageState(bool canShowSignInPage)
    {
        // If currently logged in, record that we have been signed in this session.
        if (LogOnViewModel.IsLoggedOn) _wasSignedIn = true;

        CanShowSignInPage = canShowSignInPage;
        string currentURi = navigationManager.Uri;

        // Only force-reload to the root when we're actually entering the
        // sign-in screen AND the user is NOT logged on. The old version
        // fired on EVERY OnLogOnDialogVisibilityChanged event, which
        // includes the case where the FilePasswordWindow (a separate
        // MAUI window) flips the visibility flag while the main window
        // user is already signed in — causing a full reload of the home
        // page mid-decrypt. The reload also re-triggers
        // MainViewModel.DownloadVersion → AvailableVersionDialog, which
        // is the "update available popup pops up unexpectedly" symptom.
        string currentPath = currentURi.Replace(navigationManager.BaseUri, "").TrimStart('/');
        bool atRoot = currentPath == "";
        // Allow /upgradePage and /planAndPay to stay visible during the pre-login
        // signup flow (user has never signed in this session). After an explicit
        // sign-out (_wasSignedIn == true), always navigate back to login.
        bool atUpgradePage = (currentPath == "upgradePage" || currentPath == "planAndPay") && !_wasSignedIn;
        if (CanShowSignInPage && !LogOnViewModel.IsLoggedOn && !atRoot && !atUpgradePage && !FilePasswordWindowService.ShouldSuppressMainWindowReload)
        {
            navigationManager.NavigateTo("/", true);
            return;
        }

        UpdateUIState();
    }

    private async Task UpdateSubscriptionState()
    {
        if (LogOnViewModel.IsLoggedOn)
        {
            _wasSignedIn = true;
            await AddCssAsync();
        }

        string currentURi = navigationManager.Uri;
        string subPath = currentURi.Replace(navigationManager.BaseUri, "").TrimStart('/');
        // Allow /upgradePage and /planAndPay to remain during the pre-login signup flow.
        // After a sign-out (_wasSignedIn == true), treat upgrade pages like any other page.
        bool atUpgradePage = (subPath == "upgradePage" || subPath == "planAndPay") && !_wasSignedIn;
        if (!LogOnViewModel.IsLoggedOn && subPath != "" && !atUpgradePage && !FilePasswordWindowService.ShouldSuppressMainWindowReload)
        {
            navigationManager.NavigateTo("/", true);
            return;
        }

        UpdateUIState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
    }

    private async Task InitiateDelayToRenderPage()
    {
        // The previous Task.Delay(1000) was a defensive hack that gated
        // the entire signed-in shell for a full second. Profiling showed
        // nothing depended on that delay — the real readiness signal is
        // CanShowSigedInContent (LogOnViewModel.IsLoggedOn &&
        // !CanShowSignInPage && !PageStyleRendering), which already
        // gates the actual home UI. Drop the 1000ms blocker and let the
        // shell render as soon as Blazor is ready. The AxLoader keeps
        // showing until CSS finishes applying, so the user still sees
        // a polished waiting state — just for the time we actually need.
        //
        // Tiny yield instead of a blocking delay so other async startup
        // work (CSS load, theme init) gets a chance to run before we
        // flip the flag.
        await Task.Yield();
        PageRendering = false;
        UpdateUIState();
    }

    private async void UpdateUIState(bool isVisible = false)
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task AddCssAsync()
    {
        string subscriptionLevel = SubscriptionLevel;
        string cssBasePath = subscriptionLevel switch
        {
            "business" => "business",
            "premium" => "premium",
            "passwordmanager" => "free",
            "free" => "free",
            _ => "free"
        };

        bool loaded = await JS.InvokeAsync<bool>("addCssFile", cssBasePath, "appstylebundle.min.css");
        if (loaded)
        {
            while (!await JS.InvokeAsync<bool>("isCssApplied", "css/" + cssBasePath, "appstylebundle.min.css"))
            {
                await Task.Delay(100); // Short delay to check periodically
            }
            PageStyleRendering = false;
            UpdateUIState();
        }
    }

    private async Task InitializeTheme()
    {
        string savedTheme = Core.Resolve.UserSettings.DarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("setTheme", savedTheme);
    }

    private string SubscriptionLevel
    {
        get
        {
            return LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        }
    }

    public bool CanShowSigedInContent
    {
        get
        {
            return LogOnViewModel.IsLoggedOn && !CanShowSignInPage && !PageStyleRendering;
        }
    }

    private void CloseContextMenu() => popupService.ContextMenuOpen = false;
}
