@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services.Interface
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LogOnViewModel LogOnViewModel
@inject ICssService CssService
@inject NavigationManager navigationManager
@inject ImportPrivateKeyViewModel ImportViewModel

@{
    string arabic = Core.Resolve.UserSettings.CultureName == "ar" ? "arabic-class" : "";
}

<div class="page @arabic" dir="@(Core.Resolve.UserSettings.CultureName == "ar" ? "rtl" : "ltr")" @onclick="async (e) => await LogOnViewModel.AxCryptMainForm_ClickAsync(e)" @onmousemove="async (e) => await LogOnViewModel.AxCryptMainForm_ClickAsync(e)">
    @if (PageRendering || (LogOnViewModel.IsLoggedOn && PageStyleRendering))
    {
        <main>
            <div class="secrets-loading-overlay">
                <div class="loading-content">
                    <img src="/images/default/Loading_560x560.gif" alt="Loading..." />
                    <span style="color:black ">@Texts.PreparingAxCryptText</span>
                </div>
            </div>
        </main>
    }
    else
    {
        @if (CanShowSigedInContent)
        {
            <div>
                <AxCrypt.App.Shared.Desktop.Components.Shared.StandardEncryptionWarning />
            </div>
        }
        <div style="display: contents;">
            @if (CanShowSigedInContent)
            {
                string sideMenuCollapsedStyle = Utility.IsMainMenuHidden ? "sid-mnu-colpsd" : "";

                <div class="@sideMenuCollapsedStyle side-menu" style="max-width:400px;">
                    @if (!Utility.IsMainMenuHidden)
                    {
                        <div style="position: relative;top: 120px;margin-left: auto;">
                            <img class="hide-icon" style="position: relative;z-index:1;width: 30px;margin-left: -15px;" src="" alt="image hide" @onclick="() => Utility.ToggleMainMenu()">
                        </div>
                        <NavMenu />
                    }
                    else
                    {
                        <div class="" style="width:100px;overflow:hidden;top: 120px;">
                            <img class="expbd-icon" style="z-index:1;" src="" alt="image hide" @onclick="() => Utility.ToggleMainMenu()" />

                            <NavMenu />
                        </div>
                    }
                </div>
            }

            <main style="display: flex;flex-flow: column;height: 100%;">
                @if (CanShowSigedInContent)
                {
                    <AxCrypt.App.Shared.Desktop.Components.Main.HeaderComponent />

                    string sideMenuCollapsedbodyStyle = Utility.IsMainMenuHidden ? "sid-mnu-colpsd-body" : "";
                    <div class="body-content-section @sideMenuCollapsedbodyStyle">
                        @Body
                    </div>

                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.StatusAlertComponent />

                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.TryNowSubscriptionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.TryUpgradeDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.UpgradeSubscriptionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.RenewSubscriptionDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.FilePasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyAccountDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.VerifyPasswordDialog />
                    <AxCrypt.App.Shared.Desktop.Components.PopupDialog.UserPromptDialog />

                    @if (LogOnViewModel.IsLoggedOn && LogOnViewModel.SubscriptionLevel == Api.Model.SubscriptionLevel.Free)
                    {
                        <AxCrypt.App.Shared.Desktop.Components.Shared.PaidPlanRequiredPopup />
                    }
                }
                else
                {
                    <div id="body-section">
                        @Body
                    </div>
                }

                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.GlobalPopupDialog />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.UpgradeVersionDialog />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.About />
                <AxCrypt.App.Shared.Desktop.Components.PopupDialog.ImportPrivatePasswordDialog />
                <AxCrypt.App.Shared.Desktop.Components.Shared.AccountPlanSetupRequiredPopup />
            </main>
        </div>
    }
</div>

@code {
    private bool PageRendering { get; set; } = true;

    private bool PageStyleRendering { get; set; } = true;

    private bool CanShowSignInPage { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await InitiateDelayToRenderPage();
        CanShowSignInPage = LogOnViewModel.IsVisible;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdateSignInPageState;
        ImportViewModel.ImportPrivateKeyDialog.OnDialogVisibilityChanged += UpdateUIState;
        LogOnViewModel.OnMFADialogVisibilityChanged += UpdateSignInPageState;
        LogOnViewModel.OnSubscriptionChanged += async () => await UpdateSubscriptionState();

        if (LogOnViewModel.IsLoggedOn)
        {
            await AddCssAsync();
        }

        await InitializeTheme();

        base.OnInitialized();
    }

    private void UpdateSignInPageState(bool canShowSignInPage)
    {
        CanShowSignInPage = canShowSignInPage;
        string currentURi = navigationManager.Uri;
        if (CanShowSignInPage && currentURi.Replace(navigationManager.BaseUri, "") != "")
        {
            navigationManager.NavigateTo("/", true);
            return;
        }

        UpdateUIState();
    }

    private async Task UpdateSubscriptionState()
    {
        if (LogOnViewModel.IsLoggedOn)
        {
            await AddCssAsync();
        }

        string currentURi = navigationManager.Uri;
        if (!LogOnViewModel.IsLoggedOn && currentURi.Replace(navigationManager.BaseUri, "") != "")
        {
            navigationManager.NavigateTo("/", true);
            return;
        }

        UpdateUIState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
    }

    private async Task InitiateDelayToRenderPage()
    {
        await Task.Delay(1000);
        PageRendering = false;
        UpdateUIState();
    }

    private async void UpdateUIState(bool isVisible = false)
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private async Task AddCssAsync()
    {
        string subscriptionLevel = SubscriptionLevel;
        string cssBasePath = subscriptionLevel switch
        {
            "business" => "business",
            "premium" => "premium",
            "passwordmanager" => "free",
            "free" => "free",
            _ => "free"
        };

        bool loaded = await JS.InvokeAsync<bool>("addCssFile", cssBasePath, "appstylebundle.min.css");
        if (loaded)
        {
            while (!await JS.InvokeAsync<bool>("isCssApplied", "css/" + cssBasePath, "appstylebundle.min.css"))
            {
                await Task.Delay(100); // Short delay to check periodically
            }
            PageStyleRendering = false;
            UpdateUIState();
        }
    }

    private async Task InitializeTheme()
    {
        string savedTheme = Core.Resolve.UserSettings.DarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("setTheme", savedTheme);
    }

    private string SubscriptionLevel
    {
        get
        {
            return LogOnViewModel.SubscriptionLevel.ToString().ToLower();
        }
    }

    public bool CanShowSigedInContent
    {
        get
        {
            return LogOnViewModel.IsLoggedOn && !CanShowSignInPage && !PageStyleRendering;
        }
    }
}
