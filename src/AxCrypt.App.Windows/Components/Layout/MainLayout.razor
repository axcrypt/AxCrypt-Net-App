@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.Services

@using static AxCrypt.Abstractions.TypeResolve;

@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LogOnViewModel LogOnViewModel

<link href="css/login.min.css" rel="stylesheet" />

@{
    string subscriptionLevel = LogOnViewModel.SubscriptionLevel.ToString().ToLower();
}

<link href="css/@subscriptionLevel/sidemenu.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel/index.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel/site.min.css" rel="preload" as="style" importance="high" />
<link href="css/@subscriptionLevel/topmenu.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel/notification.min.css" rel="stylesheet" importance="high" />

<link href="css/@subscriptionLevel/newsecret.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel/secretlist.min.css" rel="stylesheet" importance="high" />
<link href="css/@subscriptionLevel/support.min.css" rel="stylesheet" importance="high" />


<div class="page" dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (!CanShowSignInPage)
    {
        <div class="">
            @if (!Utility.IsMainMenuHidden)
            {
                <img class="hide-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                <NavMenu />
            }
            else
            {
                <div class="" style="width:100px;overflow:hidden; ">
                    <img class="expbd-icon" src="" alt="image hide" @onclick="Utility.ToggleMainMenu" />
                    <NavMenu />
                </div>
            }
        </div>
    }

    <main>
        @if (!CanShowSignInPage)
        {
            <div>
                <AxCrypt.App.Windows.Components.Pages.Main.TopMenu />
            </div>
        }

        @Body

        <div>
            <AxCrypt.App.Components.Pages.ProcessIndicatorComponent />
            <AxCrypt.App.Components.Pages.StatusAlertComponent />
        </div>
    </main>
</div>



@code {
    // bool IsLoading { get; set; }

    private bool CanShowSignInPage { get; set; }

    protected override void OnInitialized()
    {
        CanShowSignInPage = LogOnViewModel.IsVisible;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdateSignInPageState;
        base.OnInitialized();
    }

    private void UpdateSignInPageState(bool canShowSignInPage)
    {
         InvokeAsync(() =>
         {
            CanShowSignInPage = canShowSignInPage;
            StateHasChanged(); // Refresh UI
        });
    }

