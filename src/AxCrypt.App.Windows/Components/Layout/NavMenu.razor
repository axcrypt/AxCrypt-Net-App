@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.Content
@using static AxCrypt.Abstractions.TypeResolve

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AxCrypt</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link one" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link two" href="securedfolders">
                <span class="oi scrdfldr" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.EncryptedFoldersToolStripMenuItemText</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link three" href="passwordManager">
                <span class="oi scrts" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.Introduction2MailText16</span>
            </NavLink>
        </div>
        @* <div class="nav-item px-3">
        <NavLink class="nav-link">
        <span class="oi scrdmssngr" aria-hidden="true"></span> <span class="nav-text">Secured messenger</span>
        </NavLink>
        </div> *@
        <div class="nav-item px-3">
            <NavLink class="nav-link four" href="notification">
                <span class="oi notifctn" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.PromptNotificationsText</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link five" href="SupportIndex">
                <span class="oi suprt" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.PrioritySupportTitle</span>
            </NavLink>
        </div>
        <div class="abt-sec">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" @onclick="FeedbackPopup">
                    <span class="oi fdbck" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.SendFeedbackTitle</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" @onclick="AboutPopup">
                    <span class="oi info" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.AboutAxcryptLinkLabel</span>
                </NavLink>
            </div>
        </div>
          <div>
            <AxCrypt.App.Windows.Components.Pages.Shared.ProgressBar />
        </div>
    </nav>
</div>
<div>
    @if (aboutPopup)
    {
        <AxCrypt.App.Windows.Components.Pages.Sidemenu.About />
    }
</div>
<div>
    @if (feedbackPopup)
    {
        <AxCrypt.App.Windows.Components.Pages.Sidemenu.Feedback />
    }
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private bool isSideMenuHide = false;
    private bool aboutPopup = false;
    private SubscriptionLevel SubscriptionLevel { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        base.OnAfterRender(firstRender);
    }

    private void ToggleSideMenu()
    {
        isSideMenuHide = !isSideMenuHide;
    }

    private void AboutPopup()
    {
        aboutPopup = !aboutPopup;
    }

    private bool feedbackPopup = false;
    private void FeedbackPopup()
    {
        feedbackPopup = !feedbackPopup;
    }
}