@using AxCrypt.App.Shared.Desktop.Data
@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Services
@using AxCrypt.App.Shared.ViewModels
@using AxCrypt.Content

@inject LogOnViewModel LogOnViewModel
@inject NavigationManager navigationManager
@inject FileDropService FileDropService

<div class="sidebar" style=" display: flex; flex-direction: column; overflow: hidden;height:100%;">
    <div style="flex-shrink: 0;">
        <div class="navbar">
            <div class="container-fluid">
                @if (!Utility.IsMainMenuHidden)
                {
                    <a href=""> <img class="sidemenu-axc-logo" src="" alt="AxCrypt_Icon" /></a>
                }
                else
                {
                    <a href=""> <img class="sidemenu-axc-no-text-logo" src="" alt="AxCrypt_Icon" /></a>
                }
            </div>
        </div>
    </div>

    @{
        string sideMenuCollapsedStyle = Utility.IsMainMenuHidden ? "sid-mnu-colpsd" : "";
    }
    <div style="flex: 1; overflow-y: auto; min-height: 0;" class="@sideMenuCollapsedStyle">
        <nav class="flex-column" style="margin-top: 30px;">
            <div id="help-home" class="nav-item px-3">
                <NavLink class="nav-link one" href="/" ActiveClass="active" Match="NavLinkMatch.All">
                    <span class="oi account" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.HomeLinkLabel</span>
                </NavLink>
            </div>
            <div id="help-secured-folders" class="nav-item px-3">
                <NavLink class="nav-link two" href="securedfolders">
                    <span class="oi scrdfldr" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.EncryptedFoldersToolStripMenuItemText</span>
                    <img class="nav-subs-upg" src="" alt="paid_required_img" title="@Texts.PremiumFeatureToolTipText" style="position:relative;" />
                </NavLink>
            </div>
            @if (LogOnViewModel.UserHas(Core.Runtime.LicenseCapability.PasswordManagement))
            {
                <div id="help-pswd-mngr" class="nav-item px-3">
                    <NavLink class="@($"nav-link two {GetClassByActiveTab("passwordManager")}")" href="passwordManager">
                        <span class="oi scrts" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.PasswordManagerLinkLabel</span>
                    </NavLink>
                </div>
            }
            else
            {
                <div id="help-pswd-mngr" class="nav-item px-3">
                    <NavLink class="@($"nav-link three {GetClassByActiveTab("passwordManager")}")" href="passwordManager">
                        <span class="oi scrts" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.PasswordManagerLinkLabel</span>
                        <img class="nav-subs-upg" src="" alt="paid_required_img" title="@Texts.PremiumFeatureToolTipText" style="position:relative;" />
                    </NavLink>
                </div>
            }
            <div id="help-scrd-mssngr" class="nav-item px-3">
                <NavLink class="nav-link three" href="securedmessenger">
                    <span class="oi scrdmssngr" aria-hidden="true"></span> <span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.SecuredMessengerLinkLabel</span>
                    <img class="nav-subs-upg" src="" alt="paid_required_img" title="@Texts.PremiumFeatureToolTipText" style="position:relative;" />
                </NavLink>
            </div>
            @if (LogOnViewModel.UserHas(Core.Runtime.LicenseCapability.TextEncryptionPremium))
            {
                <div id="help-txt-encyptn" class="nav-item px-3">
                    <NavLink class="nav-link four" href="textencryption">
                        <img class="nav-subs-upg" src="" alt="paid_required_img">
                        <span class="oi txtencrpt" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.TextEncryptionLinkLabel</span>
                    </NavLink>
                </div>
            }
            else
            {
                <div id="help-txt-encyptn" class="nav-item px-3">
                    <NavLink class="@($"nav-link four {GetClassByActiveTab("textencryption")}")" href="javascript:void(0)" @onclick="UpgradeDialog">
                        <span class="oi txtencrpt" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.TextEncryptionLinkLabel</span>
                        <img class="nav-subs-upg" src="" alt="paid_required_img" title="@Texts.PremiumFeatureToolTipText" style="position:relative;" />
                    </NavLink>
                </div>
            }

            <div id="help-nofify" class="nav-item px-3">
                <NavLink class="nav-link five" href="notification">
                    <span class="oi notifctn" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.PromptNotificationsText</span>
                </NavLink>
            </div>
            <div id="help-support" class="nav-item px-3">
                <NavLink class="nav-link six" href="SupportIndex">
                    <span class="oi suprt" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@LogOnViewModel.SupportPageTitle</span>
                </NavLink>
            </div>

            <div class="prgrs-bar-sec nav-item">
                <AxCrypt.App.Shared.Desktop.Components.Shared.ProgressBar />
            </div>

            <div class="abt-sec nav-item px-3" style="max-width: 400px;">
                <div id="help-feedback">
                    <NavLink class="@($"nav-link {GetClassByActiveTab("FeedbackPopup")}")" @onclick="FeedbackPopup">
                        <span class="oi fdbck" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.SendFeedbackTitle</span>
                    </NavLink>
                </div>
                <div id="help-about">
                    <NavLink class="@($"nav-link {GetClassByActiveTab("AboutPopup")}")" @onclick="AboutPopup">
                        <span class="oi info" aria-hidden="true"></span><span class="nav-text" hidden="@Utility.IsMainMenuHidden">@Texts.AboutAxcryptLinkLabel</span>
                    </NavLink>
                </div>
            </div>
        </nav>
    </div>
</div>
<AxCrypt.App.Shared.Desktop.Components.PopupDialog.Feedback />

@code {

    string TabActive = "";

    string VisitedUrl = "";

    string[] SecretNavUrls = new[]
    {
        "/editpassword",
        "/editnote",
        "/editcard",
        "/viewcard",
        "/viewnote",
        "/viewpassword",
        "/AddCard",
        "/AddNote",
        "/AddPassword"
    };

    protected override void OnInitialized()
    {
        FileDropService.CurrentPage = navigationManager.Uri.Replace(navigationManager.BaseUri, "/");
        navigationManager.LocationChanged += OnLocationChanged;
        LogOnViewModel.AboutDialog.OnDialogVisibilityChanged += UpdateUIState;
        LogOnViewModel.FeedbackDialog.OnDialogVisibilityChanged += UpdateUIState;
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            base.OnAfterRender(firstRender);
        }
    }

    private void OnLocationChanged(object? obj, LocationChangedEventArgs args)
    {
        UpdateActiveTabByNavigation();
        UpdateUIState(true);
    }

    private void UpdateActiveTabByNavigation()
    {
        TabActive = "";
        if (SecretNavUrls.Contains(navigationManager.Uri.Replace(navigationManager.BaseUri, "/")))
        {
            TabActive = "passwordManager";
            return;
        }

        FileDropService.CurrentPage = navigationManager.Uri.Replace(navigationManager.BaseUri, "/");
    }

    private void AboutPopup()
    {
        TabActive = "AboutPopup";
        FileDropService.CurrentPage = TabActive;
        LogOnViewModel.AboutDialog.Show();
    }

    private void FeedbackPopup()
    {
        TabActive = "FeedbackPopup";
        FileDropService.CurrentPage = TabActive;
        LogOnViewModel.FeedbackDialog.Show();
    }

    private string GetClassByActiveTab(string activeTab)
    {
        return TabActive == activeTab ? "active" : "";
    }

    private void UpgradeDialog()
    {
        LogOnViewModel.UpgradeDialog.Show();
    }

    void UpdateUIState(bool result)
    {
        if (!result)
        {
            TabActive = "";
            UpdateActiveTabByNavigation();
        }

        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}