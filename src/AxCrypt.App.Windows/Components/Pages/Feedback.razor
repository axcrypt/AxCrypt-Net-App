@page "/feedback"

@using AxCrypt.Abstractions
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels.Feedback
@using AxCrypt.Content
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.Service
@using AxCrypt.Core.UI
@using static AxCrypt.Abstractions.TypeResolve

@inject FeedbackViewModel FeedbackViewModel

<div id="modal-dialog3" class="modalDialog fdbck-popup" style="display: block;">
    <div class="text-center">
        <div class="close-img" onclick="closeModalDialog('modal-dialog3')"></div>
        <img class="fdbck-img" src="feedback-img" />
        <p class="bold-highlight">Please let us know if you experience any <span>difficulties</span> with AxCrypt, have <span>questions, ideas or praises</span> to share! </p>
        <form id="feedback-form" @onsubmit="FeedbackViewModel.HandleFormSubmit">
            <div class="flex-start" style="margin-bottom: -12px;">
                @foreach (FeedbackSubject subject in FeedbackViewModel.AllSubject)
                {
                    <button class="button btn-small @(subject == FeedbackViewModel.SelectedSubject ? "highlighted font-medium" : "")"
                            @onclick="() => FeedbackViewModel.SelectSubject(subject)">
                        @subject.ToString()
                    </button>
                }
            </div>

            <div class="align-items" style="gap: 4%;">
                <textarea id="userInput" @bind="FeedbackViewModel.UserInput" rows="5" cols="30"></textarea>
            </div>
            <input type="submit" id="submit-button" class="button success btn-medium font-medium" value="Submit" style="margin-right: 15px; padding: 6px 0px;" />
            <input type="button" onclick="closeModalDialog('modal-dialog3')" class="button border btn-medium font-medium" value="Cancel" style="" />
        </form>
    </div>
</div>
@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}
