@page "/file-password-dialog"

@implements IDisposable

<div class="password-dialog">
    <label for="password">Enter Password:</label>
    <input id="password" type="@passwordInputType" @bind="passwordText" @oninput="ClearError" />

    <input id="showPassword" type="checkbox" @bind="showPassword" @bind:after="TogglePasswordVisibility" />
    <label for="showPassword">Show Password</label>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">@errorMessage</div>
    }

    <div class="button-group">
        <button @onclick="OnOkButtonClick">OK</button>
        <button @onclick="OnCancelButtonClick">Cancel</button>
    </div>
</div>

@code {
    private string passwordText;
    private bool showPassword;
    private string errorMessage;
    private string passwordInputType = "password";

    [Parameter]
    public bool ShowFilePasswordPopup { get; set; }

    [Parameter]
    public string FileName { get; set; }

    [Parameter]
    public string FilePassword { get; set; }

    [Parameter]
    public EventCallback<string> OnPasswordSubmitted { get; set; }

    [Parameter]
    public EventCallback OnDialogCancelled { get; set; }

    public Func<string, Task> RequestPasswordAsync { get; set; }

    private string? fileNameForPassword;
    private TaskCompletionSource<string> tcs;
    private string passphrase = string.Empty;

    protected override void OnInitialized()
    {
        RequestPasswordAsync = async (fileName) =>
        {
            fileNameForPassword = fileName;
            await OpenAsync();
            await GetPasswordAsync();
        };
    }

    public async Task OpenAsync()
    {
        passphrase = string.Empty;
        tcs = new TaskCompletionSource<string>();
        StateHasChanged();
        await tcs.Task;
    }

    public async Task<string> GetPasswordAsync()
    {
        tcs = new TaskCompletionSource<string>();
        StateHasChanged();
        return await tcs.Task;
    }

    private void TogglePasswordVisibility()
    {
        passwordInputType = showPassword ? "text" : "password";
    }

    private void ClearError(ChangeEventArgs e)
    {
        errorMessage = string.Empty;
    }

    private async Task OnOkButtonClick()
    {
        if (string.IsNullOrWhiteSpace(passwordText))
        {
            errorMessage = "Password cannot be empty.";
            return;
        }

        bool isValidPassword = await ValidatePasswordAsync(passwordText);
        if (!isValidPassword)
        {
            errorMessage = "Invalid password.";
            return;
        }

        if (OnPasswordSubmitted.HasDelegate)
        {
            await OnPasswordSubmitted.InvokeAsync(passwordText);
        }
    }

    private Task<bool> ValidatePasswordAsync(string password)
    {
        return Task.FromResult(password == "password123");
    }

    private async Task OnCancelButtonClick()
    {
        if (OnDialogCancelled.HasDelegate)
        {
            await OnDialogCancelled.InvokeAsync();
        }
    }

    public void Dispose()
    {
    }
}