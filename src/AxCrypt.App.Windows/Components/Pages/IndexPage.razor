@page "/"

@using AxCrypt.App.Shared.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.App.Shared.ViewModels

@inject LogOnViewModel LogOnViewModel
@inject RegisterViewModel Register
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<div dir="@(Core.Resolve.UserSettings.CultureName == "ar" ? "rtl" : "ltr")">
    <AxCrypt.App.Shared.Desktop.Components.Shared.ProcessIndicatorComponent />

    @* Mount the global error popup at the shell level so it's available
       even when no page is signed in (e.g. exception during sign-in /
       MFA / boot). TopBar mounts it again post-sign-in — that's
       harmless: the popup hosts a singleton service, and one of the
       instances will be in view for any given screen. *@
    <AxCrypt.App.Shared.Desktop.Components.Shared.ErrorReportPopup />

    @if (LogOnViewModel.IsVisible)
    {
        <AxCrypt.App.Shared.Desktop.Components.LoginPageNew />
    }
    else if (!LogOnViewModel.IsVisible && LogOnViewModel.IsMfaEnabled)
    {
        @* MFA screen takes over directly after sign-in. The sign-in
           ProcessIndicator started in LogOnViewModel.InitiateProgressIndicator()
           is still showing — dispose it here so the MFA form isn't covered
           by the full-page loader. *@
        LogOnViewModel.ProcessIndicator?.Dispose();

        <AxCrypt.App.Shared.Desktop.Components.VerifyMFA />
    }
    else if (ShowSignUp)
    {
        <AxCrypt.App.Shared.Desktop.Components.RegisterPage />
    }
    else if (LogOnViewModel.IsLoggedOn)
    {
       @*  <AxCrypt.App.Shared.Desktop.Components.Pages.HomePage /> *@
        <AxCrypt.App.Shared.Desktop.Components.Pages.NewHomePage />
    }
    else
    {
        LogOnViewModel.ProcessIndicator?.Dispose();

        @* Post sign-in transition. Uses the branded AxLoader (FullPage)
           instead of the heavy 560x560 Loading GIF, so the wait right
           after sign-in matches the boot loader and every in-app loader. *@
        <AxCrypt.App.Shared.Desktop.Components.Shared.AxLoader
            Mode="AxCrypt.App.Shared.Desktop.Components.Shared.LoaderMode.FullPage"
            Message="@AxCrypt.Content.Texts.ProgressIndicatorWaitMessage" />
    }

</div>

@code {
    public bool ShowSignUp { get; set; }

    protected override void OnInitialized()
    {
        ShowSignUp = Register.ShowSignUp;
        base.OnInitialized();
        Register.OnVisibilityOfUserSignUpChanged += async (bool isVisible) => await UpdateSignUpPageVisibility(isVisible);
        LogOnViewModel.OnLogOnDialogVisibilityChanged += async (bool isVisible) => await UpdatePageState(isVisible);
        LogOnViewModel.OnMFADialogVisibilityChanged += async (bool isVisible) => await UpdatePageState(isVisible);
    }

    private async Task UpdatePageState(bool isShow = false)
    {
        await UpdatePageState();
    }

    private async Task UpdatePageState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private async Task UpdateSignUpPageVisibility(bool showSignUp)
    {
        ShowSignUp = showSignUp;
        await UpdatePageState();
    }
}
