@using AxCrypt.Api.Model
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Core.UI
@using AxCrypt.Core.Extensions
@using static AxCrypt.Abstractions.TypeResolve

@inject InviteViewModel InviteViewModel

@{
    DeviceIdiom currentDevice = Utility.GetCurrentDeviceIdiom();
}

<div id="modal-dialog1" class="modalDialog" style="display: block;">
    <div class="invite-popup text-center">
        <div>
            <div class="close-img" onclick="closeModalDialog('modal-dialog1')"></div>
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <span class="text-center font-bold" style="font-size: 20px;">
                        Invite your friend to AxCrypt!
                    </span>
                </div>
                <div class="invite-text">
                    <span class="grey-clr">Enter user email whom you want to invite:</span><br />
                    <input type="text" id="inviteFriend" name="inviteFriend" placeholder="Type your friend's email here" @bind-value="@InviteViewModel.InvitedUser" @onfocus="InviteViewModel.OnInputFocus">
                    @if (!string.IsNullOrEmpty(InviteViewModel.ErrorMessage))
                    {
                        <div class="error-message" style="color:red;">@InviteViewModel.ErrorMessage</div>
                    }
                </div>
                <div>
                    <button class="button font-medium success btn-large" @onclick="()=> InviteViewModel.InviteFriend()">Invite!</button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (InviteViewModel.IsSuccess)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <span class="text-center font-bold" style="font-size: 20px;"> Your friend @InviteViewModel.InvitedUser is invited successfully! </span>
                </div>
                <button class="button font-medium success btn-large" @onclick="InviteViewModel.CloseSuccessPopup"> OK</button>
            </div>
        </div>
    </div>
}
<style>
    .error-message {
        color: red;
        margin-top: 5px;
    }
</style>
@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}