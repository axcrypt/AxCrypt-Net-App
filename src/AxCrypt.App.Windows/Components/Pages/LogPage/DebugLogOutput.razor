@page "/debuglog"
@using AxCrypt.Core
@using Microsoft.Extensions.Logging

@inject NavigationManager NavigationManager
@inject ILogger<DebugLogOutput> Logger

<div class="log-console" @onclick="CloseConsole">
    <div class="log-content" @onclick:stopPropagation>
        <h3>Debug Log Viewer</h3>
        <pre>@_logText</pre>
        <button @onclick="CloseLogViewer">Close</button>
    </div>
</div>

<style>
    .log-console {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .log-content {
        background: white;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        width: 80%;
        max-height: 80%;
        overflow-y: auto;
    }
</style>

@code {

    private string _logText = string.Empty;

    protected override void OnInitialized()
    {
        AttachLogListener();
    }

    private void AttachLogListener()
    {
        Resolve.Log.Logged += (sender, args) =>
        {
            string formatted = $"{DateTime.UtcNow:o} {args.Message}";
            _logText += formatted + "\n";
            InvokeAsync(StateHasChanged);
        };
    }

    [Parameter]
    public EventCallback OnClose { get; set; }

    public void CloseConsole()
    {
        OnClose.InvokeAsync(null);
        _logText = string.Empty;
    }

    private void CloseLogViewer()
    {
        NavigationManager.NavigateTo("/mainpage");
    }
}
