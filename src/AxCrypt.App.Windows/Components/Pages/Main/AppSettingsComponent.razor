@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@using static AxCrypt.Abstractions.TypeResolve

@inject NavigationManager navigation

@inject AppSettingsViewModel appSettingsViewModel
@inject AdvancedOptionsViewModel viewModel

<div class="desk-stngs-popup manage-acc-sec model-popup font-medium hide-model-popup">
    <span class="font-bold">@Texts.SettingsPageTitle</span>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoEye.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsHideRecentFilesToolStripMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="appSettingsViewModel.HideRecentFiles" @onclick="appSettingsViewModel.ToggleHideRecentFiles" />
                <span class="slider round">
                    @if (appSettingsViewModel.HideRecentFiles)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoEye.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsConvertMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="appSettingsViewModel.AutoUpgradeToAES256" @onclick="appSettingsViewModel.ToggleEncryptionUpgradeMode">
                <span class="slider round">
                    @if (appSettingsViewModel.AutoUpgradeToAES256)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoOffln1.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsIncludeSubfoldersToolStripMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="appSettingsViewModel.IncludeSubfolders" @onclick="async(e)=> appSettingsViewModel.ToggleIncludeSubfolders(e)">
                <span class="slider round">
                    @if (appSettingsViewModel.IncludeSubfolders)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <div class="key-section">
        <NavLink @attributes="appSettingsViewModel.NavLinkAttributes1()" @onclick="appSettingsViewModel.InactSgnOutPopup">
            <img class="sgn-out-img" src="images/default/IcoSngOut.svg" alt="go-back-img" />
            <span>@Texts.IdleSignOutToolStripMenuItemText</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> appSettingsViewModel.RestoreRename(e)">
            <img class="" src="images/default/IcoRstr.svg" alt="go-back-img" />
            <span>Restore to original</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> appSettingsViewModel.ToggleAdvancedOption()">
            <img class="" src="images/default/IcoRstr.svg" alt="go-back-img" />
            <span>Advanced Option</span>
        </NavLink>
    </div>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoOffln1.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.AlwaysOffline</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="appSettingsViewModel.AlwaysOffline" @onclick="(e)=> appSettingsViewModel.ToggleAlwaysOffline(e)">
                <span class="slider round">
                    @if (appSettingsViewModel.AlwaysOffline)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <div class="key-section">
        <NavLink @attributes="appSettingsViewModel.NavLinkAttributes3()" @onclick="appSettingsViewModel.FileEncryptionProperty">
            <img class="encrypt-file-prop-img" src="images/default/IcoFltr.svg" alt="encrypt-file-prop" />
            <span>Encryption File Properties</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> appSettingsViewModel.InviteUser(e)">
            <img class="" src="images/default/IcoInvtFrnd1.svg" alt="go-back-img" />
            <span>@Texts.InviteUserToolStripMenuItemText</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="debug" @attributes="appSettingsViewModel.NavLinkAttributes2()" @onclick="appSettingsViewModel.ToggleDebugPopup">
            <img class="dbg-img" src="images/default/IcoDbg.svg" alt="go-back-img" />
            <span>@Texts.DebugToolStripMenuItemText</span>
        </NavLink>
    </div>
</div>
@if (appSettingsViewModel.InactSgnOut)
{
    <div class="model-popup sub-pop1 hide-model-popup">
        <div id="inactivity">
            <form id="inactivityForm">
                @foreach (int timeout in appSettingsViewModel.InactivityTimeoutOptions)
                {
                    <input type="radio" id="timeout-@timeout"
                           name="inactivity"
                           value="@timeout"
                           checked="@(timeout == appSettingsViewModel.InactivitySignOut)"
                           @onclick="(e) => appSettingsViewModel.OnInactivityContextMenu(timeout, e)" />
                    <label for="timeout-@timeout">@((timeout == 0) ? "Disable" : $"{timeout} minutes")</label>
                    <br />
                }
            </form>
        </div>
    </div>
}
@if (appSettingsViewModel.FileEncryptionProperties)
{
    <div class="model-popup sub-pop1 hide-model-popup encrypt-pop">
        <div id="date-modified-toggle">
            <dl>
                <dd class="center-column">
                    <div>
                        <img class="" src="images/default/Icodate.svg" alt="date-img" />
                        <span class="font-medium grey-clr">
                            Date Modified
                        </span>
                    </div>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@appSettingsViewModel.IsDateModifiedOn" @onclick="(e)=> appSettingsViewModel.FilePropertiesDateModified(e)">

                            <span class="slider round">
                                @if (appSettingsViewModel.IsDateModifiedOn)
                                {
                                    <span class="on-off-text on-text">ON</span>
                                    <span class="on-off-text off-text" style="display:none;">OFF</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">ON</span>
                                    <span class="on-off-text off-text">OFF</span>
                                }
                            </span>
                        </label>
                    </div>
                </dd>
            </dl>
            <dl>
                <dd>
                    <img class="" src="images/default/IcoBtnEdit.svg" alt="btn-file-img" />
                    <span class="font-medium grey-clr">
                        File Name
                    </span>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@appSettingsViewModel.IsFileNameOn" @onclick="(e) => appSettingsViewModel.FilePropertiesFileName(e)">

                            <span class="slider round">
                                @if (appSettingsViewModel.IsFileNameOn)
                                {
                                    <span class="on-off-text on-text">ON</span>
                                    <span class="on-off-text off-text" style="display:none;">OFF</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">ON</span>
                                    <span class="on-off-text off-text">OFF</span>
                                }
                            </span>
                        </label>
                    </div>
                </dd>
            </dl>
        </div>
    </div>
}
@if (appSettingsViewModel.DebugPopup)
{
    <div class="model-popup sub-pop2 font-medium hide-model-popup">
        <div class="manage-acc-sec">
            <NavLink class="nav-link" @onclick="appSettingsViewModel.CheckAxCryptVersionAsync">
                <img class="" src="images/default/IcoChckVrsn.svg" alt="go-back-img" />
                <span>Check version now</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="appSettingsViewModel.OpenOptions">
                <img class="" src="images/default/IcoExtrFtrs1.svg" alt="go-back-img" />
                <span>Options</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="appSettingsViewModel.OnOpenLogViewerClicked">
                <img class="" src="images/default/IcoLgng.svg" alt="go-back-img" />
                <span>Logging</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="appSettingsViewModel.OpenManageAxCryptID">
                <img class="" src="images/default/IcoUsers.svg" alt="go-back-img" />
                <span>Manage AxCrypt ID</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> appSettingsViewModel.OpenBrokenFiles()">
                <img class="" src="images/default/IcoBrkFl.svg" alt="go-back-img" />
                <span>Try broken file</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> appSettingsViewModel.VerifyAxCryptFiles()">
                <img class="" src="images/default/IcoChckVrsn1.svg" alt="go-back-img" />
                <span>Check and verify file </span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> appSettingsViewModel.AxCryptFileFormatCheck()">
                <img class="" src="images/default/Frame1.svg" alt="go-back-img" />
                <span>Check file</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="appSettingsViewModel.OpenReportAsync">
                <img class="" src="images/default/XMLID_601.svg" alt="go-back-img" />
                <span>Open error report snapshot</span>
            </NavLink>
        </div>
    </div>
}

@if (appSettingsViewModel.InvitePopup)
{
    <AxCrypt.App.Windows.Components.Pages.PopupDialog.InvitePopup />
}
@if (appSettingsViewModel.ShowVersion)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div tyle="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                        @if (string.Compare(appSettingsViewModel.LatestVersion, appSettingsViewModel.CurrentVersion) > 0)
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">A new version is available!</span>

                            <br />
                            @* <span class="text-center font-bold" style="font-size: 15px;"> Latest Version : @LatestVersion </span> *@
                        }
                        else
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">You are up to date!</span>
                        }
                    </div>
                </div>
                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    @if (string.Compare(appSettingsViewModel.LatestVersion, appSettingsViewModel.CurrentVersion) > 0)
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> RedirectToDownload()">Update</button>
                    }
                    else
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> appSettingsViewModel.CloseSuccessPopup()">OK</button>
                    }
                    <button class="button font-medium success btn-large" @onclick="()=>appSettingsViewModel.CloseSuccessPopup()">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (appSettingsViewModel.ShowOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
                <div class="input-group">
                    <label for="restApiUrl">Rest Api Url:</label>
                    <input type="text" id="restApiUrl" class="form-control email-img" @bind="@appSettingsViewModel.RestApiBaseUrl" />
                </div>
                <div class="input-group">
                    <label for="timeout">@Texts.DialogDebugOptionsRestApiTimeoutPrompt</label>
                    <input type="text" id="timeout" class="form-control email-img" @bind="@appSettingsViewModel.TimeoutTimeSpan" />
                </div>

                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <button class="button font-medium success btn-large" @onclick="(e)=> appSettingsViewModel.SetOptionsToolStripMenuItem_Click(e)">OK</button>
                    <button class="button font-medium success btn-large" @onclick="appSettingsViewModel.CloseOptions">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (appSettingsViewModel.ShowManageAxCryptID)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <label for="title">Manage AxCrypt ID</label>
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
            </div>
            <div>
                <label for="userEmail">@appSettingsViewModel.EmailLabel</label>
            </div>
            <div class="input-group">
                <div>
                    <textarea id="timeout" style="position:center;" class="form-control email-img" rows="4" cols="60" readonly>Timestamp: @appSettingsViewModel.CreatedTime </textarea>
                </div>
            </div>
            <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                <button class="button font-medium success btn-large" @onclick="(e)=>appSettingsViewModel.ChangePassphraseButton_Click(e)">Change Password</button>
                <button class="button font-medium success btn-large" @onclick="appSettingsViewModel.CloseManageAxCryptID">Close</button>
            </div>
        </div>
    </div>
}

@if (appSettingsViewModel.ShowAdvancedOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div>
                <label>Application Config Path</label>
                <input type="path" @bind="viewModel.AppConfigPath" />
            </div>

            <div>
                <label>Temp File Path</label>
                <input type="text" @bind="viewModel._tempConfigPath" />
                <button @onclick="(e) => viewModel.BrowseButton_click(e)">Browse</button>
            </div>
            <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                <button @onclick="(e)=> viewModel.ButtonOk_Click(e)">OK</button>
                <button @onclick="appSettingsViewModel.ToggleAdvancedOption">Cancel</button>
            </div>
        </div>
    </div>
}

<style>
    .input-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .input-group label {
            min-width: 120px;
            margin-right: 10px;
        }

        .input-group input {
            flex-grow: 1;
        }
</style>

@code {
    protected override void OnInitialized()
    {
        appSettingsViewModel.Initialized();
        viewModel.Initialize();
        base.OnInitialized();
    }

    private void RedirectToDownload()
    {
        navigation.NavigateTo(appSettingsViewModel.DownloadVersion.ToString());
        appSettingsViewModel.ShowVersion = !appSettingsViewModel.ShowVersion;
    }

    [Parameter]
    public EventCallback CloseSettingsPopup { get; set; }
}
