@page "/"

@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Shared.Utility.View
@using AxCrypt.App.Shared.ViewModels

@inject LogOnViewModel LogOnViewModel
@inject RegisterViewModel Register
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<div dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    <AxCrypt.App.Desktop.Components.Shared.ProcessIndicatorComponent />

    @if (LogOnViewModel.IsVisible)
    {
        <AxCrypt.App.Desktop.Components.LoginPage />
    }
    else if (ShowSignUp)
    {
        <AxCrypt.App.Desktop.Components.RegisterPage />
    }
    else if (LogOnViewModel.IsLoggedOn)
    {
        <AxCrypt.App.Desktop.Components.Pages.HomePage />
    }

</div>

@code {
    public bool ShowSignUp { get; set; }

    protected override void OnInitialized()
    {
        using (ProcessIndicator processIndicator = new ProcessIndicator())
        {
            ShowSignUp = Register.ShowSignUp;
            base.OnInitialized();
            Register.OnVisibilityOfUserSignUpChanged += UpdateSignUpPageVisibility;
            LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdatePageState;
        }
    }

    private void UpdatePageState(bool isShow = false)
    {
        UpdatePageState();
    }

    private async void UpdatePageState()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private void UpdateSignUpPageVisibility(bool showSignUp)
    {
        ShowSignUp = showSignUp;
        UpdatePageState();
    }
}
