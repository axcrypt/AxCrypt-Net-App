@page "/"

@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.Services
@using AxCrypt.Common

@using static AxCrypt.Abstractions.TypeResolve;

@inject LogOnViewModel LogOnViewModel
@inject HomeUserService HomeUserService
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<div dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (LogOnViewModel.IsVisible)
    {
        @if (ShowSignUp)
        {
            <AxCrypt.App.Windows.Components.Pages.Register />
        }
        else
        {
            <AxCrypt.App.Windows.Components.Pages.LoginPage />
        }
    }
    else if (LogOnViewModel.IsLoggedOn)
    {
        <HomePage />
    }

</div>


@code {
    private bool IsLoading { get; set; }
    private bool IsWideScreen { get; set; }

    public bool ShowSignUp { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);

                if (New<AxCryptOnlineState>().IsOffline)
                {
                    navigation.NavigateTo("/register");
                }


            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error determining screen width: {ex.Message}");
            }
            finally
            {
                IsLoading = false;
                //StateHasChanged();
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        HomeUserService.OnVisibilityOfUserSignUpChanged += UpdateSignUpPageVisibility;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdatePageState;
        LogOnViewModel.OnSubscriptionChanged += UpdatePageState;
    }

    private void UpdatePageState(bool isShow = false)
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
    
    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private void UpdateSignUpPageVisibility(bool showSignUp)
    {
        ShowSignUp = showSignUp;
        UpdatePageState(); // Refresh UI
    }
}
