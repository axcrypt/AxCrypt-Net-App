@page "/"

@using AxCrypt.Abstractions
@using AxCrypt.Api.Model;
@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.App.Windows.Services
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Common;
@using AxCrypt.Content
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.Service
@using AxCrypt.Core.Session
@using AxCrypt.Core.UI
@using Microsoft.Maui.Devices;
@using static AxCrypt.Abstractions.TypeResolve;

@inject LogOnViewModel LogOnViewModel
@inject HomeUserService HomeUserService
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

@{
    DeviceIdiom currentDevice = Utility.GetCurrentDeviceIdiom();
}

<div dir="@(Core.Resolve.UserSettings.CultureName == "ar"? "rtl":"ltr")">
    @if (LogOnViewModel.IsVisible)
    {
        @if (ShowSignUp)
        {
            <AxCrypt.App.Windows.Components.Pages.PopupDialog.Register />
        }
        else
        {
            <AxCrypt.App.Windows.Components.Pages.Login.LoginPage />
        }
    }
    else
    {
        <HomePage />
    }
</div>


@code {
    private bool IsLoading { get; set; }
    private bool IsWideScreen { get; set; }

    public bool ShowSignUp { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);

                if (New<AxCryptOnlineState>().IsOffline)
                {
                    navigation.NavigateTo("/register");
                }


            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error determining screen width: {ex.Message}");
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    protected override void OnInitialized()
    {
        HomeUserService.OnVisibilityOfUserSignUpChanged += UpdateSignUpPageVisibility;
        LogOnViewModel.OnLogOnDialogVisibilityChanged += UpdatePageState;
        base.OnInitialized();
    }

    private void UpdatePageState(bool canShowSignInPage = true)
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }

    private void UpdateSignUpPageVisibility(bool showSignUp)
    {
        ShowSignUp = showSignUp;
        UpdatePageState(); // Refresh UI
    }
}
