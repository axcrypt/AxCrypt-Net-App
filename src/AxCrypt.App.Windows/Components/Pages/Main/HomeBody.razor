@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.App.Components.ViewModels
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.App.Windows.Services
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.Extensions
@using AxCrypt.Core.IO
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.Service
@using AxCrypt.Core.Session
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.ViewModel
@using Microsoft.AspNetCore.Components.Forms
@using System.Collections.ObjectModel

@using static AxCrypt.Abstractions.TypeResolve
@inject HomeBodyViewModel viewModel
@inject IJSRuntime jsRunTime

<div class="home-body" style="margin-top: 15px;">
    <div style="display:block; margin-bottom: 25px;">
        <label class="fle-nme fnt-sze">Actions</label>
        <div class="" style="display:flex;">
            <div class="act-box" @onclick="(()=>viewModel.ExecuteSelectFilesCommand(AxCrypt.Core.UI.FileSelectionType.Open, viewModel.SelectedRecentFiles))" @onmouseover='@( () => viewModel.ShowPopup("open") )' @onmouseout="viewModel.HidePopup">
                <img class="act-img opnscrd-act" src="" alt="opnscrd-img" />
                <span class="text-size">@Texts.McInfMenuOpen</span>
                @if (viewModel.isHovered && viewModel.hoveredElement == "open")
                {
                    <div class="home-hover text-center" style="background-color:#fff;">
                        <span class="txt-clr font-medium">Click to open a secured files</span>
                    </div>
                }
            </div>
            <div class="act-box" @onclick="(()=>viewModel.ExecuteSelectFilesCommand(AxCrypt.Core.UI.FileSelectionType.Encrypt, viewModel.SelectedRecentFiles))" @onmouseover='@( () => viewModel.ShowPopup("secure") )' @onmouseout="viewModel.HidePopup">
                <img class="act-img scr-act" src="" alt="scr-img" />
                <span class="text-size">@Texts.EncryptToolStripMenuItemText</span>
                @if (viewModel.isHovered && viewModel.hoveredElement == "secure")
                {
                    <div class="home-hover text-center" style="background-color:#fff;">
                        <span class="txt-clr font-medium">Click to securely encrypt files</span>
                    </div>
                }
            </div>
            <div class="act-box" @onmouseover='@( () => viewModel.ShowPopup("stop") )' @onmouseout="viewModel.HidePopup" @onclick="(()=>viewModel.ExecuteSelectFilesCommand(AxCrypt.Core.UI.FileSelectionType.Decrypt, viewModel.SelectedRecentFiles))">
                <img class="act-img stpscr-act" src="" alt="stpscr-img" />
                <span class="text-size">Stop</span>
                @if (viewModel.isHovered && viewModel.hoveredElement == "stop")
                {
                    <div class="home-hover text-center" style="background-color:#fff;">
                        <span class="txt-clr font-medium">Click to stop securing files.</span>
                    </div>
                }
            </div>
            @if (viewModel.SubscriptionLevel == SubscriptionLevel.Free)
            {
                <div class="popup-container">
                    <div class="hover-trigger" @onmouseover='@( () => viewModel.ShowPopup("share") )'>
                        <div class="act-box shre-box" style="background-color:#D9D9D9;">
                            <img class="act-img vwr-shrks-act" src="" alt="shrks-img" /><span class="text-size">Share</span>
                        </div>
                    </div>

                    @if (viewModel.isHovered && viewModel.hoveredElement == "share")
                    {
                        <div class="popup-section">
                            <div class="free-color" id="upgrade-sec" style="padding:10px; text-align:center; border-radius:5px;">
                                <span style="color:white;">
                                    Upgrade to access this <strong>feature!</strong>
                                </span>
                                <button class="upgrd-btn font-medium btn-medium" @onclick="() => viewModel.UpgradeToShare = Utility.ToggleUpgradePopup(viewModel.UpgradeToShare)">Upgrade</button>
                            </div>
                        </div>
                    }
                    @if (viewModel.UpgradeToShare)
                    {
                        <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
                    }
                </div>
            }
            else
            {
                <div class="act-box" @onclick="async(e)=> viewModel.ShareKeysAsync(e)" @onmouseover='@( () => viewModel.ShowPopup("share") )' @onmouseout="viewModel.HidePopup">
                    <img class="act-img shrks-act" src="" alt="shrks-img" />
                    <span class="text-size">Share</span>
                    @if (viewModel.isHovered && viewModel.hoveredElement == "share")
                    {
                        <div class="home-hover text-center" style="background-color:#fff;">
                            <span class="txt-clr font-medium">Click to share access with your colleagues.</span>
                        </div>
                    }
                </div>
            }

            @* @if (Utility.IsMainMenuHidden && SubscriptionLevel == SubscriptionLevel.Premium)
            {
            <div class="act-box"><img class="act-img new-mssg" src="" alt="scr-img" /><span class="text-size">New message</span></div>
            } *@
            @if (viewModel.SubscriptionLevel == SubscriptionLevel.Business)
            {
                <div class="act-box" @onmouseover='@( () => viewModel.ShowPopup("master key") )' @onmouseout="viewModel.HidePopup" @onclick="viewModel.RedirectToAccountSite">
                    <img class="act-img mtrkey-act" src="" alt="mtrkey-img" /><span class="text-size">@Texts.MasterKeyTitle</span>
                    @if (viewModel.isHovered && viewModel.hoveredElement == "master key")
                    {
                        <div class="home-hover text-center" style="background-color:#fff;">
                            <span class="txt-clr font-medium">Go to Masterkey</span>
                        </div>
                    }
                </div>
                @if (Utility.IsMainMenuHidden)
                {
                    <div class="act-box" @onmouseover='@( () => viewModel.ShowPopup("create groups") )' @onmouseout="viewModel.HidePopup" @onclick="viewModel.RedirectToAccountSite">
                        <img class="act-img grp-act" src="" alt="grp-img" /><span class="text-size">Create groups</span>
                        @if (viewModel.isHovered && viewModel.hoveredElement == "create groups")
                        {
                            <div class="home-hover text-center" style="background-color:#fff;">
                                <span class="txt-clr font-medium">Go to Groups</span>
                            </div>
                        }
                    </div>
                }
            }
            @if (viewModel.isFilesPending)
            {
                <div class="act-box" style="background: var(--col-hglhgt, #FFDA00);" @onmouseover='@( () => viewModel.ShowPopup("clean") )' @onmouseout="viewModel.HidePopup" @onclick="(e) => viewModel.CloseAndRemoveOpenFilesButton_Click(e)">
                    <img class="act-img cln-act" src="" alt="cln-img" /><span class="text-size" style="color:black;">Clean</span>
                    @if (viewModel.isHovered && viewModel.hoveredElement == "clean")
                    {
                        <div class="home-hover text-center" style="background-color:#fff;">
                            <span class="txt-clr font-medium">Click to encrypt any opened files or new files in Secured Folders, but ensure they are not in use first.</span>
                        </div>
                    }
                </div>
            }
            @if (Utility.IsMainMenuHidden && viewModel.SubscriptionLevel == SubscriptionLevel.Free)
            {
                <div class="info-box" style="margin-top:17px; padding: 7px 5px;">
                    <table>
                        <tbody>
                            <tr>
                                <td rowspan="2"><img class="icosrv" src="" alt="grp-img" /></td>
                                <td class="info-txt">Tell us what you think</td>
                            </tr>
                            <tr>
                                <td class="gt-stred-txt">Submit now <img class="arwrgt-img" /></td>
                            </tr>
                            <tr>
                                <td rowspan="2"><img class="icoidea" src="" alt="grp-img" /></td>
                                <td class="info-txt">Watch our video  to</td>
                            </tr>
                            <tr>
                                <td class="gt-stred-txt">Get started <img class="arwrgt-img" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div>
        @if (viewModel.SubscriptionLevel == SubscriptionLevel.Premium)
        {
            <div style="display: block;">
                <div style="display:flex; min-width: 331px;">
                    <label class="fle-nme fnt-sze">Subscriptions</label><img class="ico-hidden" src="" @onclick="ToggleSection" alt="hand-img" id="toggleImageClosed" /><img class="ico-eye" src="" @onclick="ToggleSection" alt="hand-img" style="display: none;" id="toggleImageOpen" />
                </div>
                <div id="mySection" style="display: none; padding-top:8px;">
                    <div class="sub-box" style="background-color: #48772C;">
                        <div style="padding: 10px 20px; line-height:14px;">
                            <span class="subs-plan" style="line-height:10px;">Premium</span>
                            <img class="plan-prm-icon" src="" alt="premium-icon" />
                            <br />
                            <span class="sub-text">For someone else</span>
                        </div>
                        <button @onclick="viewModel.BuyForSomeoneElseLink" class="buy-button"> Buy</button>
                    </div>
                    <div class="sub-box" style="background-color: #000000; margin-left:15px;">
                        <div style="padding: 10px 20px; line-height:12px;">
                            <span class="subs-plan" style="line-height:10px;">Business</span>
                            <img class="plan-bus-icon" src="" alt="premium-icon" />
                            <br />
                            <span class="sub-text">For organisations</span>

                        </div>
                        <button @onclick="viewModel.ChangeSubscriptionToBusinessLink" class="buy-button"> Change</button>
                    </div>
                </div>
            </div>
        }
        else if (viewModel.SubscriptionLevel == SubscriptionLevel.Business)
        {
            <div>
                <label class="fle-nme fnt-sze" style="padding-bottom:20px;">Active subscriptions</label>
                <div class="actv-subs align-items">
                    <div class="battery">
                        <div class="battery-head"> </div>
                        <div class="battery-body" id="battery-body">
                            <div class="charge-level">
                                <span style="text-align: center; margin:auto auto;"> @viewModel.MembersCount/<span style="font-weight:bold;">@viewModel.TotalMembers</span></span>
                            </div>
                        </div>
                    </div>
                    <div style="margin-left:5px;">
                        <button class="subs-btn" style="background-color: rgba(73, 73, 73, 0.50); margin-bottom: 5px;" @onclick="viewModel.RedirectToAccountWebUrl">Renew<img class="rnw-btn" src="" alt="img" /></button>
                        <button class="subs-btn" style="background-color: #000;" @onclick="()=> BrowseUtility.RedirectToAccountWebUrl(Texts.LinkToBusinessTopupPage)">Add users<img class="add-usr" src="" alt="img" /></button>
                    </div>
                </div>
            </div>
        }
        else if (viewModel.SubscriptionLevel == SubscriptionLevel.Free)
        {
            <div class="upgrd-box free-color">
                <img class="img-upgrdpl" src="" alt="" />
                <div>
                    <label class="unlck-txt">
                        Unlock our amazing <span>features</span> developed to <span>empower your security!</span>
                    </label>
                    <button class="upgrd-btn font-medium btn-large" @onclick="() => viewModel.UpgradePopup = Utility.ToggleUpgradePopup(viewModel.UpgradePopup)" style="height: 37px;"> Upgrade now</button>
                </div>
            </div>
            @if (viewModel.UpgradePopup)
            {
                <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
            }
        }
    </div>
</div>
@if (viewModel.ShowSharePopup)
{
    <div class="modalDialog sharekey-popup" id="sharekey">
        <AxCrypt.App.Windows.Components.Pages.Shared.ShareKey SelectedFilesOrFoldersList=@viewModel.SelectedShareKeyFiles IsFolder="false" OnClose="viewModel.CloseSharePopup" />
    </div>
}
<div class="mre-act-sec">
    @if (viewModel.SubscriptionLevel != SubscriptionLevel.Free)
    {
        <div style="display:block;">
            <label class="fle-nme fnt-sze">Cloud services</label>
            <div style="display: flex;">
                @foreach (KnownFolder knownFolder in viewModel._knownFoldersViewModel.KnownFolders)
                {
                    <div>
                        <button @onclick="() => viewModel.OnCloudServiceButtonClick(knownFolder)"
                                class="assets-box"
                                style="background-color:@(knownFolder.Enabled ? _ENABLEDTOOLSTRIPBACKCOLOR : viewModel.DisabledBackColor)">
                            <img class="icon @viewModel.GetIconClass(knownFolder.DisplayName)" src="" alt="@knownFolder.DisplayName" />
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    <div class="medium-9" style="display:block;">
        <label class="fle-nme fnt-sze">More actions</label>
        <div style="display: flex; gap: 2%;">
            @if (viewModel.SubscriptionLevel != SubscriptionLevel.Free)
            {
                <div class="mre-actn-box" @onclick="(e)=> viewModel.RandomRenameAsync(e)">
                    <img class="ico-eye-sml" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.AnonymousRenameMenuText</span>
                </div>
                <div class="mre-actn-box" @onclick="(e)=> viewModel.SecureWipeFiles(e)">
                    <img class="ico-dlt" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.SecureDeleteToolStripMenuItemText</span>
                </div>
                <div class="mre-actn-box" @onclick="viewModel.UpgradeTo256">
                    <img class="ico-apikey" src="" alt="hand-img" />
                    <span class="text-size text-style">@Texts.UpgradeLegacyFilesMenuItemText</span>
                </div>
                <div class="mre-actn-box fade-clr" style="border:dotted;">
                    <span class="text-size text-style">Add action to the Home</span>
                </div>
            }
            else
            {
                <div class="mre-actn-box atn-bgclr" @onclick="viewModel.AlwaysOfflineForFreeUser">
                    <img class="ico-offln" src="" alt="hand-img" />
                    <span class="text-size text-style">Always offline</span>
                </div>
                <div class="mre-actn-box atn-bgclr" @onclick="viewModel.OpenPopup">
                    <img class="ico-invtfrd" src="" alt="hand-img" />
                    <span class="text-size text-style">Invite friend</span>
                </div>
                <div class="mre-actn-box atn-bgclr" @onclick="() => viewModel.UpgradeToEncrypt = Utility.ToggleUpgradePopup(viewModel.UpgradeToEncrypt)">
                    <img class="ico-apikey" src="" alt="hand-img" />
                    <span class="text-size text-style">Upgrade files to AES-256</span>
                </div>
                @if (viewModel.UpgradeToEncrypt)
                {
                    <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
                }
            }
        </div>
    </div>
    @if (viewModel.shareKey)
    {
        <div class="modalDialog sharekey-popup" id="sharekey">
            <AxCrypt.App.Windows.Components.Pages.Shared.ShareKey SelectedFilesOrFoldersList="viewModel.SelectedShareKeyFiles" OnClose="viewModel.CloseSharePopup" />
        </div>
    }
    @if (viewModel.ShowInvitePopup)
    {
        <AxCrypt.App.Windows.Components.Pages.PopupDialog.InvitePopup />
    }

    @if (viewModel.showUpgradePopup)
    {
        <div class="modalDialog" id="upgrade-popup">
            <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
        </div>
    }
</div>
<div>
    @if (Utility.IsMainMenuHidden)
    {
        @if (viewModel.SubscriptionLevel != SubscriptionLevel.Free)
        {
            <AxCrypt.App.Windows.Components.Pages.PopupDialog.Suggestion />
        }
        else
        {
            <AxCrypt.App.Windows.Components.Pages.PopupDialog.Subscription />
        }
    }
</div>
@code {
    public const string _ENABLEDTOOLSTRIPBACKCOLOR = "#FFFFFF";

    protected override void OnInitialized()
    {
        viewModel.Initialized();
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            viewModel.isFilesPending = viewModel.AreFilesPending();
            this.viewModel.SelectingFiles += viewModel.HandleSelectingFiles;
        }

        base.OnAfterRender(firstRender);
    }


    public async Task ToggleSection()
    {
        try
        {
            await jsRunTime.InvokeVoidAsync("toggleSection", "mySection", "toggleImageClosed", "toggleImageOpen");
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message, ex);
        }
    }

}
