@using AxCrypt.Api.Model
@using AxCrypt.App.Desktop.Utility.View
@using AxCrypt.App.Desktop.ViewModels
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content
@using AxCrypt.Core.UI

@using static AxCrypt.Abstractions.TypeResolve

@inject RecentFilesViewModel RecentFilesViewModel



<AxCrypt.App.Desktop.Components.Home.HeaderComponent />
<HomeActionsComponent />
<AxCrypt.App.Windows.Components.Pages.Home.RecentFilesView />

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RecentFilesViewModel.OnUpdateViewState += UpdatePageState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
        try
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            //IsLoading = false;
        }
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}