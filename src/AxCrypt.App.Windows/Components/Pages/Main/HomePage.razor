@page "/mainpage"

@using AxCrypt.Abstractions
@using AxCrypt.Abstractions.Rest
@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Utility.View
@using AxCrypt.App.Components.ViewModels
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content
@using AxCrypt.Common
@using AxCrypt.Core
@using AxCrypt.Core.Extensions
@using AxCrypt.Core.IO
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.Session
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.ViewModel
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Newtonsoft.Json;
@using System.Windows;
@using System.Globalization;
@using System.Resources;
@using Microsoft.AspNetCore.Components.Forms
@using System.Collections.ObjectModel

@using static AxCrypt.Abstractions.TypeResolve
@inject RecentFilesViewModel RecentFilesViewModel
@inject AppSettingsViewModel SettingsViewModel
@inject IJSRuntime JSRuntime

@{
    int MaxAvatarsToShow = 4;
}

<div class="home-index">
    <div>
        <div class="hm-page-title head-sec">
            <h1 class="fle-nme">@Texts.WelcomeBackTitle</h1>
            <img class="home-title" src="" alt="hand-img" />
        </div>
    </div>
    <HomeActionsComponent SelectedRecentFiles="RecentFilesViewModel.SelectedFiles" />
    <div>
        <div style="padding: 10px 0px;">
            <label class="text-style">@Texts.RecentFilesTabPageText</label>
        </div>
        <div class="file-max-hgt">
            @if (RecentFilesViewModel.RecentFilesList.Any())
            {
                <table class="rcnt-fle-tbl" style="width:100%;">
                    <thead style="user-select: none;">
                        <tr>
                            <th style="width:3%;"><input class="check-box" type="checkbox" @onchange="(e)=> RecentFilesViewModel.ToggleAllCheckboxes(e)" checked="@RecentFilesViewModel.IsHeaderCheckboxChecked" /></th>
                            <th style="width:23%;" @onclick="RecentFilesViewModel.SortByName">@Texts.NameLabel<img class="arw-img" src="" alt="" /></th>
                            <th @onclick="RecentFilesViewModel.SortBySize" style="width:11%;">@Texts.FileSizeColumnHeaderText<img class="arw-img" src="" alt="" /></th>
                            <th style="width:11%;">@Texts.CryptoNameText</th>
                            <th @onclick="RecentFilesViewModel.SortByDateModified" style="width:18%;">@Texts.LastModifiedTimeColumnHeaderText<img class="arw-img" src="" alt="" /></th>
                            <th style="width:13%;">@Texts.PromptSharedWith</th>
                            @if (RecentFilesViewModel.SubscriptionLevel != SubscriptionLevel.Free)
                            {
                                <th class="scrd-sec">@Texts.EncryptedPathColumnHeaderText</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="row-sec">
                        @if (!IsLoading)
                        {
                            @if (SettingsViewModel.HideRecentFiles)
                            {
                                <tr><td colspan="7" style="padding: 20px 30px;"><span class="grey-clr">@Texts.HideRecentFilesListTabToolTipText</span></td></tr>
                            }
                            else if (RecentFilesViewModel.RecentFilesList.Any())
                            {
                                @for (int i = 0; i < RecentFilesViewModel.RecentFilesList.Count; i++)
                                {
                                    FileDetails fileDetails = RecentFilesViewModel.RecentFilesList[i];
                                    <tr class="context-menu-target @(RecentFilesViewModel.SelectedFiles.Contains(fileDetails) ? "selected" : "")"
                                        @onmousedown="(e) => RecentFilesViewModel.HandleFileClick(e, fileDetails)"
                                        @oncontextmenu="e => RecentFilesViewModel.HandleContextMenu(e, fileDetails)"
                                        @ondblclick="(e) => RecentFilesViewModel.OpenSecuredRecentFiles(e, new List<FileDetails> { fileDetails })">
                                        <td> <input class="check-box" type="checkbox" @onchange="(e) => RecentFilesViewModel.SelectSingleFile(e, fileDetails)" checked="@RecentFilesViewModel.IsHeaderCheckboxChecked" /> </td>
                                        @{
                                            string imagefileSourceClass = !string.IsNullOrEmpty(fileDetails.FileExt) ? fileDetails.FileExt : "file-ext-def-icon";
                                        }
                                        <td class="fle-exton-img" style="display: flex; align-items: center;">
                                            <img height="32" class="@imagefileSourceClass" src="" alt="file-image" />
                                            <span class="fle-nme">@fileDetails.FileName</span>
                                        </td>
                                        <td>@fileDetails.FileSize</td>
                                        <td>@fileDetails.Algorithm</td>
                                        <td>@fileDetails.LastModifiedDate</td>
                                        <td>
                                            @if (fileDetails.SharedWith.Any())
                                            {
                                                <div style="display:flex;">
                                                    @foreach (string sharedWith in fileDetails.SharedWith.Take(MaxAvatarsToShow))
                                                    {
                                                        <div class="info-prple">@sharedWith.Substring(0, 2).ToUpper()</div>
                                                    }

                                                    @if (fileDetails.SharedWith.Count() > MaxAvatarsToShow)
                                                    {
                                                        <div class="info-prple bdr-clr">+@((fileDetails.SharedWith.Count()) - MaxAvatarsToShow)</div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        @if (RecentFilesViewModel.SubscriptionLevel != SubscriptionLevel.Free)
                                        {
                                            <td class="scrd-sec" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;">@fileDetails.FilePath</td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center">
                    <span class="empty-view-heading">Let`s start our journey!</span><br />
                    <span>Add and secure your first file.</span><br />
                    <img class="empty-rcnt-fle-img" alt="default file img" />
                </div>
            }

        </div>
        <div id="homeContextMenu" class="hide-model-popup home-context-menu" style="display: none;">
            <dl class="font-medium" style="margin-bottom: 5px;">
                <dd @onclick="(e)=> RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.OpenSecured)">@Texts.McInfMenuOpen</dd>
                <dd @onclick="(e)=> RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.RemoveFromListButKeepSecured)">@Texts.RemoveRecentFileToolStripMenuItemText</dd>
                <dd @onclick="(e)=> RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.StopSecureAndRemoveFromList)">@Texts.DecryptAndRemoveFromListToolStripMenuItemText</dd>
                @if (RecentFilesViewModel.SubscriptionLevel == SubscriptionLevel.Free)
                {
                    <dd class="grey-clr">@Texts.ShareKeysToolStripMenuItemText</dd>
                }
                else
                {
                    <dd @onclick="async (e)=>await RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.ShareKey)">@Texts.ShareKeysToolStripMenuItemText</dd>
                }
                <dd @onclick="async (e)=> await RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.ShowInFolder)">@Texts.ShowInFolderText</dd>
                @if (RecentFilesViewModel.SubscriptionLevel == SubscriptionLevel.Free)
                {
                    <dd class="grey-clr">@Texts.RestoreAnonymousNamesMenuText</dd>
                }
                else
                {
                    <dd @onclick="(e)=> RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.RenameToOriginal)">@Texts.RestoreAnonymousNamesMenuText</dd>
                }
                @*<dd @onclick="UpdateAutoRenewalStatus">@Texts.ClearRecentFilesToolStripMenuItemText</dd>*@
                <dd @onclick="(e)=> RecentFilesViewModel.OnContextMenuAction(e, SecuredFilesContextMenu.ClearRecentFiles)">@Texts.ClearRecentFilesToolStripMenuItemText</dd>
            </dl>
        </div>
    </div>
    @if (RecentFilesViewModel.ShowSharePopup)
    {
        <div class="modalDialog sharekey-popup" id="sharekey">
            <AxCrypt.App.Windows.Components.Pages.Shared.ShareKey SelectedFilesOrFoldersList="RecentFilesViewModel.SelectedShareKeyFiles" IsFolder="false" OnClose="RecentFilesViewModel.ClosePopup" />
        </div>
    }
    @if (RecentFilesViewModel.ShowInvitePopup)
    {
        <AxCrypt.App.Windows.Components.Pages.PopupDialog.InvitePopup />
    }

    @if (RecentFilesViewModel.showUpgradePopup)
    {
        <Upgrade />
    }
</div>

@code {
    private bool IsLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        RecentFilesViewModel.OnInitializedAsync();
        RecentFilesViewModel.OnRecentFilesStateChanged += UpdatePopupVisibility;
    }

    private void UpdatePopupVisibility()
    {
        StateHasChanged(); // Refresh UI
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            RecentFilesViewModel.RecentFilesList = new ObservableCollection<FileDetails>(await RecentFilesViewModel.LoadRecentFiles());
        }
        try
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}