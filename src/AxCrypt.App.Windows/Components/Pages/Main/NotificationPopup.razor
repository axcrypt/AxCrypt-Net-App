@using AxCrypt.App.Components.Models.Notification
@using AxCrypt.App.Components.Services
@using AxCrypt.Content

@inject NotificationViewModel model
@inject UserNotificationService service

<div class="notification-popup hide-model-popup" id="notify-popup">
    <label class="notif-popup-title">Notifications</label>
    @*<a id="noticlear" class="noticlearall font-medium">Clear all</a>*@
    @if (model.Notifications.Count() > 0)
    {
        <table class="notifi-popup" style="padding:10px;">
            @foreach (NotificationItemViewModel notification in model.Notifications.Take(5))
            {
                string imageSourceClass = !string.IsNullOrEmpty(notification.EventType) ? notification.EventType : "notif-def-icon";
                string notifyTitle = notification.PushNotify ? notification.PushNotif_Title : notification.Content;
                <tr>
                    <td class="notifi-img" style="width: 7%; padding: 12px !important;">
                        <img class="@imageSourceClass" src="" alt="ico-@notification.EventType" />
                    </td>
                    <td style="width: 80%; padding: 12px 5px !important;">
                        <label class="font-medium">@notification.Content</label>
                        <br /><span class="grey-clr">@notification.CreatedDate</span>
                    </td>
                    @* <td class="@UnreadBg"><img height="8" class="unrd-img" src="" alt="ico-reset" /></td> *@
                </tr>
            }
        </table>
        <div>
            <NavLink class="notifipopup-show" href="notification" id="noti">@Texts.ViewAllText</NavLink>
        </div>
    }
    else
    {
        <div>
            <span style="width: 160px; display: block; margin: 0 auto;">@Texts.NoNotificationsText</span>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        model = service.NotificationModel;
    }
}