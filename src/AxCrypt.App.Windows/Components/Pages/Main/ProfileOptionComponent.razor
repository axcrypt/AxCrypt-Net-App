@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Common
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.UI

@using static AxCrypt.Abstractions.TypeResolve

@inject ProfileViewModel? ProfileViewModel

<div class="desk-acnt-popup model-popup hide-model-popup" id="" style="">
    <span class="font-bold">Account</span>
    <div class="acc-subs">
        <div class="accnt-prfl">
            <h3 class="txt-clr">
                @if (!string.IsNullOrEmpty(ProfileViewModel.Account?.UserEmail) && ProfileViewModel.Account.UserEmail.Length >= 2)
                {
                    @ProfileViewModel.Account.UserEmail.Substring(0, 2).ToUpper()
                }
                else
                {
                    <span></span>
                }
            </h3>
        </div>

        <h3 class="subs-txt txt-clr">@ProfileViewModel?.Account?.SubscriptionLevel</h3>
        <div>
            <div style="text-align:left;">
                <img class="" src="images/default/IcoMssg.svg" alt="go-back-img" />
                <span class="grey-clr font-high text-overlfow">@ProfileViewModel?.Account?.UserEmail</span>
            </div>
            @if (ProfileViewModel?.Account?.SubscriptionLevel != SubscriptionLevel.Free)
            {
                <div style="text-align:left;">
                    <img class="" src="images/default/IcoClndr.svg" alt="go-back-img" />
                    <span class="grey-clr font-high" style="padding-left: 5px;">expire in <span class="txt-clr">@ProfileViewModel?.Account?.DaysLeft</span></span>
                </div>
                <a class="can-subs" @onclick="ProfileViewModel.CancelSubscription">Cancel subscription</a>
            }
            else
            {
                <button class="font-bold acnt-upg" style=" width: 154px;height: 37px;" @onclick="ProfileViewModel.UpgradeSubscription"> Upgrade now</button>
            }
        </div>
    </div>
    <div class="manage-acc-sec font-medium">
        <div class="key-section">
            <NavLink @attributes="ProfileViewModel.NavLinkAttributes()" @onclick="ProfileViewModel.ToggleKMPopup">
                <img class="kym-sec" src="images/default/IcoKMngmnt.svg" alt="go-back-img" />
                <span>@Texts.KeyManagementToolStripMenuItemText</span>
                <img class="next-arrow" />
            </NavLink>
        </div>
        <div class="key-section">
            <NavLink class="@DisablePasswordChange()" @onclick="(e) => ProfileViewModel.ChangePassphraseMenuItem_Click(e)">
                <img class="" src="images/default/IcoRstPsswrd.svg" alt="go-back-img" />
                <span>Password change</span>
            </NavLink>
        </div>
        <div class="key-section">
            <NavLink class="@DisablePasswordReset()"
                     @onclick="(e) => ProfileViewModel.PasswordReset_Click(e)">
                <img class="" src="images/default/IcoRstPsswrd.svg" alt="go-back-img" />
                <span>Password Reset</span>
            </NavLink>
        </div>
        <div class="key-section">
            <NavLink class="nav-link" @onclick="()=> ProfileViewModel.ClearAllSettingsAndRestartAsync()">
                <img class="" src="images/default/IcoClrSttngs.svg" alt="go-back-img" />
                <span>@Texts.OptionsClearAllSettingsAndExitToolStripMenuItemText</span>
            </NavLink>
        </div>
        <div class="key-section">
            <NavLink class="nav-link next-arrow" @onclick="ProfileViewModel.ToggleSubsDtlsPopup">
                <img class="" src="images/default/IcoSubsDetails.svg" alt="go-back-img" />
                <span>@Texts.SubscriptionDetailsTitle</span>
            </NavLink>
        </div>
        <NavLink class="nav-link" @onclick="ProfileViewModel.RedirectToMyAxCryptIDPage">
            <span>@Texts.DebugManageAccountToolStripMenuItemText</span>
            <img class="mng-accnt" src="" alt="go-back-img" style="float:right" />
        </NavLink>
        <NavLink class="nav-link" @onclick="ProfileViewModel.ViewHelpMenuItemClick">
            <span>@Texts.HelpToolStripMenuItemText</span>
            <img class="mng-accnt" src="" alt="go-back-img" style="float:right" />
        </NavLink>
        <NavLink class="nav-link" href="">
            <span class="log-out-clr font-medium" @onclick="()=> ProfileViewModel.SignOut()">@Texts.LogOffText</span>
        </NavLink>
        <NavLink class="nav-link" @onclick="(e)=> ProfileViewModel.ExitMenuItem_Click(e)">
            <span class="font-medium">@Texts.ExitToolStripMenuItemText</span>
        </NavLink>
    </div>
</div>
@if (ProfileViewModel.keyMPopup)
{
    <div class="key-mngnt-Popup model-popup sub-pop1 hide-model-popup" id="">
        <div class="font-medium left-align">
            <dd class="@ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="()=>ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ImportSomeonesSharingKey)">Import Someone`s Public Sharing Key</dd>
            <dd class="@ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="()=>ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ExportMySharingKey)">Export My Public Sharing Key</dd>
            <dd class="@ProfileViewModel.GetDisabledClass(ProfileViewModel.Account.IsLoggedOn)" @onclick="@(async() => {  await ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ImportAxCryptID); })">Import AxCrypt ID with sharing and access keys</dd>
            <dd class="@ProfileViewModel.GetDisabledClass(!ProfileViewModel.Account.IsLoggedOn)" @onclick="()=>ProfileViewModel.HandleImportAndExportKeys(KeyManagement.ExportAxCryptIDAndSharingKeyPair)">Export AxCrypt ID Secret and Sharing Key Pair</dd>
            <dd class="@ProfileViewModel.GetDisabledClass(ProfileViewModel.Account.IsLoggedOn)" @onclick="@(async() => { await ProfileViewModel.HandleImportAndExportKeys(KeyManagement.CreateAxCryptID); })">Create AxCrypt ID</dd>
        </div>
    </div>
}
@if (ProfileViewModel.SubsDtlsPopup)
{
    <div class="subs-dtls-popup model-popup sub-pop2 hide-model-popup" id="">
        <div class="close-img" @onclick="ProfileViewModel.ToggleSubsDtlsPopup"></div>
        <div class="center-column" style="padding:0;">
            <div>
                <img class="ico-user-dk" src="" alt="Ico-user" />
            </div>
            <div>
                <span class="txt-clr">Subscription:</span>
                <span class="font-bold">@ProfileViewModel.Account.SubscriptionLevel.ToString()</span><br />
                @if (ProfileViewModel.Account.SubscriptionLevel == SubscriptionLevel.Business)
                {
                    <span class="txt-clr">Company:</span>
                    <span class="font-bold">AxCrypt</span> <br />
                }
                @if (ProfileViewModel.Account.SubscriptionLevel != SubscriptionLevel.Free)
                {
                    <span class="txt-clr">Type:</span>
                    <span class="font-bold">@ProfileViewModel.Account.Subscription</span> <br />
                }
                <span class="txt-clr">Valid until:</span>
                <span class="font-bold">@ProfileViewModel.ValidFormatted</span>
            </div>
        </div>
    </div>
}

<style>
    .nav-link-pass.disabled,
    .nav-link-pass.disabled:hover,
    .nav-link-pass.disabled.active {
        pointer-events: none;
        background-color: transparent;
        color: gray !important;
        text-decoration: none;
    }

    .key-section a.disabled.active {
        background-color: transparent;
    }

</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ProfileViewModel.InitializeAsync();

        await base.OnInitializedAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            base.OnAfterRender(firstRender);
            //StateHasChanged();
        }
    }

    [Parameter]
    public EventCallback ClosePopup { get; set; }

    public void OnOptionClicked()
    {
        ClosePopup.InvokeAsync(null);
    }

    private string DisablePasswordReset()
    {
        bool isPasswordReset = !ProfileViewModel.Account.IsLoggedOn && !string.IsNullOrEmpty(New<UserSettings>().UserEmail);
        return isPasswordReset ? "nav-link" : "nav-link disabled";
    }

    private string DisablePasswordChange()
    {
        bool isPasswordChange = New<AxCryptOnlineState>().IsOnline;
        return isPasswordChange ? "nav-link" : "nav-link disabled";
    }

    void UpdateState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }
}
