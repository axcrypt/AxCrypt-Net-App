@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@using static AxCrypt.Abstractions.TypeResolve

@inject NavigationManager navigation

@inject SettingsViewModel settingsViewModel
@inject AdvancedOptionsViewModel viewModel

<div class="desk-stngs-popup manage-acc-sec model-popup font-medium hide-model-popup">
    <span class="font-bold">@Texts.SettingsPageTitle</span>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoEye.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsHideRecentFilesToolStripMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="settingsViewModel.HideRecentFiles" @onclick="settingsViewModel.ToggleHideRecentFiles" />
                <span class="slider round">
                    @if (settingsViewModel.HideRecentFiles)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoEye.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsConvertMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="settingsViewModel.AutoUpgradeToAES256" @onclick="settingsViewModel.ToggleAutoUpgradeMode">
                <span class="slider round">
                    @if (settingsViewModel.AutoUpgradeToAES256)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoOffln1.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.OptionsIncludeSubfoldersToolStripMenuItemText</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="settingsViewModel.IncludeSubfolders" @onclick="async(e)=> settingsViewModel.ToggleIncludeSubfolders(e)">
                <span class="slider round">
                    @if (settingsViewModel.IncludeSubfolders)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <div class="key-section">
        <NavLink @attributes="settingsViewModel.NavLinkAttributes1()" @onclick="settingsViewModel.InactSgnOutPopup">
            <img class="sgn-out-img" src="images/default/IcoSngOut.svg" alt="go-back-img" />
            <span>@Texts.IdleSignOutToolStripMenuItemText</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> settingsViewModel.RestoreRename(e)">
            <img class="" src="images/default/IcoRstr.svg" alt="go-back-img" />
            <span>Restore to original</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> settingsViewModel.ToggleAdvancedOption()">
            <img class="" src="images/default/IcoRstr.svg" alt="go-back-img" />
            <span>Advanced Option</span>
        </NavLink>
    </div>
    <NavLink class="nav-link center-column">
        <div>
            <img class="" src="images/default/IcoOffln1.svg" alt="go-back-img" />
            <span class="grey-clr">@Texts.AlwaysOffline</span>
        </div>
        <div style="float:right; padding-left:15px;">
            <label class="toggle">
                <input type="checkbox" @bind="settingsViewModel.AlwaysOffline" @onclick="(e)=> settingsViewModel.ToggleAlwaysOffline(e)">
                <span class="slider round">
                    @if (settingsViewModel.AlwaysOffline)
                    {
                        <span class="on-off-text on-text">ON</span>
                        <span class="on-off-text off-text" style="display:none;">OFF</span>
                    }
                    else
                    {
                        <span class="on-off-text on-text" style="display:none;">ON</span>
                        <span class="on-off-text off-text">OFF</span>
                    }
                </span>
            </label>
        </div>
    </NavLink>
    <div class="key-section">
        <NavLink @attributes="settingsViewModel.NavLinkAttributes3()" @onclick="settingsViewModel.FileEncryptionProperty">
            <img class="encrypt-file-prop-img" src="images/default/IcoFltr.svg" alt="encrypt-file-prop" />
            <span>Encryption File Properties</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="nav-link" @onclick="(e)=> settingsViewModel.InviteUser(e)">
            <img class="" src="images/default/IcoInvtFrnd1.svg" alt="go-back-img" />
            <span>@Texts.InviteUserToolStripMenuItemText</span>
        </NavLink>
    </div>
    <div class="key-section">
        <NavLink class="debug" @attributes="settingsViewModel.NavLinkAttributes2()" @onclick="settingsViewModel.ToggleDebugPopup">
            <img class="dbg-img" src="images/default/IcoDbg.svg" alt="go-back-img" />
            <span>@Texts.DebugToolStripMenuItemText</span>
        </NavLink>
    </div>
</div>
@if (settingsViewModel.InactSgnOut)
{
    <div class="model-popup sub-pop1 hide-model-popup">
        <div id="inactivity">
            <form id="inactivityForm">
                <input type="radio" id="disable" name="inactivity" value="0" @onclick="()=> settingsViewModel.OnInactivityContextMenu(0)" checked=@settingsViewModel.IsChecked(0)>
                <label for="disable">Disable</label><br />
                <input type="radio" id="minutes1" name="inactivity" value="5" @onclick="()=> settingsViewModel.OnInactivityContextMenu(5)" checked=@settingsViewModel.IsChecked(5)>
                <label for="minutes1">5 minutes</label><br />
                <input type="radio" id="minutes2" name="inactivity" value="15" @onclick="()=> settingsViewModel.OnInactivityContextMenu(15)" checked=@settingsViewModel.IsChecked(15)>
                <label for="minutes2">15 minutes</label><br />
                <input type="radio" id="minutes3" name="inactivity" value="30" @onclick="()=> settingsViewModel.OnInactivityContextMenu(30)" checked=@settingsViewModel.IsChecked(30)>
                <label for="minutes3">30 minutes</label><br />
                <input type="radio" id="minutes4" name="inactivity" value="60" @onclick="()=> settingsViewModel.OnInactivityContextMenu(60)" checked=@settingsViewModel.IsChecked(60)>
                <label for="minutes4">60 minutes</label>
            </form>
        </div>
    </div>
}
@if (settingsViewModel.FileEncryptionProperties)
{
    <div class="model-popup sub-pop1 hide-model-popup encrypt-pop">
        <div id="date-modified-toggle">
            <dl>
                <dd class="center-column">
                    <div>
                        <img class="" src="images/default/Icodate.svg" alt="date-img" />
                        <span class="font-medium grey-clr">
                            Date Modified
                        </span>
                    </div>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@settingsViewModel.IsDateModifiedOn" @onclick="(e)=> settingsViewModel.FilePropertiesDateModified(e)">

                            <span class="slider round">
                                @if (settingsViewModel.IsDateModifiedOn)
                                {
                                    <span class="on-off-text on-text">ON</span>
                                    <span class="on-off-text off-text" style="display:none;">OFF</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">ON</span>
                                    <span class="on-off-text off-text">OFF</span>
                                }
                            </span>
                        </label>
                    </div>
                </dd>
            </dl>
            <dl>
                <dd>
                    <img class="" src="images/default/IcoBtnEdit.svg" alt="btn-file-img" />
                    <span class="font-medium grey-clr">
                        File Name
                    </span>
                    <div style="float:right; padding-left:15px;">
                        <label class="toggle">
                            <input type="checkbox" @bind="@settingsViewModel.IsFileNameOn" @onclick="(e) => settingsViewModel.FilePropertiesFileName(e)">

                            <span class="slider round">
                                @if (settingsViewModel.IsFileNameOn)
                                {
                                    <span class="on-off-text on-text">ON</span>
                                    <span class="on-off-text off-text" style="display:none;">OFF</span>
                                }
                                else
                                {
                                    <span class="on-off-text on-text" style="display:none;">ON</span>
                                    <span class="on-off-text off-text">OFF</span>
                                }
                            </span>
                        </label>
                    </div>
                </dd>
            </dl>
        </div>
    </div>
}
@if (settingsViewModel.DebugPopup)
{
    <div class="model-popup sub-pop2 font-medium hide-model-popup">
        <div class="manage-acc-sec">
            <NavLink class="nav-link" @onclick="settingsViewModel.CheckAxCryptVersionAsync">
                <img class="" src="images/default/IcoChckVrsn.svg" alt="go-back-img" />
                <span>Check version now</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="settingsViewModel.OpenOptions">
                <img class="" src="images/default/IcoExtrFtrs1.svg" alt="go-back-img" />
                <span>Options</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="settingsViewModel.OnOpenLogViewerClicked">
                <img class="" src="images/default/IcoLgng.svg" alt="go-back-img" />
                <span>Logging</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="settingsViewModel.OpenManageAxCryptID">
                <img class="" src="images/default/IcoUsers.svg" alt="go-back-img" />
                <span>Manage AxCrypt ID</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> settingsViewModel.OpenBrokenFiles()">
                <img class="" src="images/default/IcoBrkFl.svg" alt="go-back-img" />
                <span>Try broken file</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> settingsViewModel.VerifyAxCryptFiles()">
                <img class="" src="images/default/IcoChckVrsn1.svg" alt="go-back-img" />
                <span>Check and verify file </span>
            </NavLink>
            <NavLink class="nav-link" @onclick="async ()=> settingsViewModel.AxCryptFileFormatCheck()">
                <img class="" src="images/default/Frame1.svg" alt="go-back-img" />
                <span>Check file</span>
            </NavLink>
            <NavLink class="nav-link" @onclick="settingsViewModel.OpenReportAsync">
                <img class="" src="images/default/XMLID_601.svg" alt="go-back-img" />
                <span>Open error report snapshot</span>
            </NavLink>
        </div>
    </div>
}

@if (settingsViewModel.InvitePopup)
{
    <AxCrypt.App.Windows.Components.Pages.PopupDialog.InvitePopup />
}
@if (settingsViewModel.ShowVersion)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div tyle="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                    <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                        @if (string.Compare(settingsViewModel.LatestVersion, settingsViewModel.CurrentVersion) > 0)
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">A new version is available!</span>

                            <br />
                            @* <span class="text-center font-bold" style="font-size: 15px;"> Latest Version : @LatestVersion </span> *@
                        }
                        else
                        {
                            <span class="text-center" style="font-size: 20px; color: green;">You are up to date!</span>
                        }
                    </div>
                </div>
                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    @if (string.Compare(settingsViewModel.LatestVersion, settingsViewModel.CurrentVersion) > 0)
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> RedirectToDownload()">Update</button>
                    }
                    else
                    {
                        <button class="button font-medium success btn-large" @onclick="()=> settingsViewModel.CloseSuccessPopup()">OK</button>
                    }
                    <button class="button font-medium success btn-large" @onclick="()=>settingsViewModel.CloseSuccessPopup()">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (settingsViewModel.ShowOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
                <div class="input-group">
                    <label for="restApiUrl">Rest Api Url:</label>
                    <input type="text" id="restApiUrl" class="form-control email-img" @bind="@settingsViewModel.RestApiBaseUrl" />
                </div>
                <div class="input-group">
                    <label for="timeout">@Texts.DialogDebugOptionsRestApiTimeoutPrompt</label>
                    <input type="text" id="timeout" class="form-control email-img" @bind="@settingsViewModel.TimeoutTimeSpan" />
                </div>

                <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                    <button class="button font-medium success btn-large" @onclick="(e)=> settingsViewModel.SetOptionsToolStripMenuItem_Click(e)">OK</button>
                    <button class="button font-medium success btn-large" @onclick="settingsViewModel.CloseOptions">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (settingsViewModel.ShowManageAxCryptID)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <label for="title">Manage AxCrypt ID</label>
            <div class="center-column">
                <div>
                    <img src="images/default/ImgInvFrnds.svg" alt="ImgInvFrnds-img" style="height: 100%;" /><br /><br />
                </div>
            </div>
            <div>
                <label for="userEmail">@settingsViewModel._emailLabel</label>
            </div>
            <div class="input-group">
                <div>
                    <textarea id="timeout" style="position:center;" class="form-control email-img" rows="4" cols="60" readonly>Timestamp: @settingsViewModel.CreatedTime </textarea>
                </div>
            </div>
            <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                <button class="button font-medium success btn-large" @onclick="(e)=>settingsViewModel.ChangePassphraseButton_Click(e)">Change Password</button>
                <button class="button font-medium success btn-large" @onclick="settingsViewModel.CloseManageAxCryptID">Close</button>
            </div>
        </div>
    </div>
}

@if (settingsViewModel.ShowAdvancedOptions)
{
    <div id="modal-dialog1" class="modalDialog" style="display: block;">
        <div class="invite-popup text-center">
            <div>
                <label>Application Config Path</label>
                <input type="path" @bind="viewModel.AppConfigPath" />
            </div>

            <div>
                <label>Temp File Path</label>
                <input type="text" @bind="viewModel._tempConfigPath" />
                <button @onclick="(e) => viewModel.BrowseButton_click(e)">Browse</button>
            </div>
            <div style="display: flex; justify-content: center; gap: 20px; margin-top: 20px;">
                <button @onclick="(e)=> viewModel.ButtonOk_Click(e)">OK</button>
                <button @onclick="settingsViewModel.ToggleAdvancedOption">Cancel</button>
            </div>
        </div>
    </div>
}

<style>
    .input-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

        .input-group label {
            min-width: 120px;
            margin-right: 10px;
        }

        .input-group input {
            flex-grow: 1;
        }
</style>

@code {
    protected override void OnInitialized()
    {
        settingsViewModel.Initialized();
        viewModel.Initialize();
        base.OnInitialized();
    }

    private void RedirectToDownload()
    {
        navigation.NavigateTo(settingsViewModel.DownloadVersion.ToString());
        settingsViewModel.ShowVersion = !settingsViewModel.ShowVersion;
    }

    [Parameter]
    public EventCallback CloseSettingsPopup { get; set; }
}
