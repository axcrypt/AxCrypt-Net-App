@page "/notification"

@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Notification
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Utility.View
@using AxCrypt.Content
@using AxCrypt.Api.Model;
@using System.Collections.ObjectModel

@inject NavigationManager navigation
@inject UserNotificationService notificationService

<link href="css/login.min.css" rel="stylesheet" />

<div id="content-index" class="medium-12 columns">
    <div class="head-sec">
        <div class="row">
            <div class="medium-12 columns">
                <h1 class="page-title">
                    @Texts.PromptNotificationsText
                </h1>
            </div>
        </div>
    </div>
</div>

@if (!model.Notifications.Any())
{
    <div class="text-center" style="margin: 10% auto;">
        <span class="empty-view-heading">There is no any notifications.</span><br />
        <img class="empty-notify-img" alt="default notification img" />
    </div>
}
else
{
    <div class="medium-12 columns" style="max-height: 635px;overflow-y: scroll;">
        <table class="notification-table curved-table">
            <thead class="notify-pg-tbl-head">
                <tr class="notification-text">
                    @* <th style="width: 5%;"></th> *@
                    <th style="width: 50%;">Activity</th>
                    <th style="width:25%;" @onclick="SortByDate">
                        Date
                        <img class="notifiarrow" src="@(model.DateSortDirection == SortDirection.Ascending ? "/images/up-arrow.png" : "/images/down-arrow.png")" />
                    </th>
                    <th style="width:15%;">Status</th>
                    <th style="width: 5%;"></th>
                </tr>
            </thead>

            <AxCrypt.App.Windows.Components.Pages.Shared.LoadingComponent IsLoading="@model.Loading" />

            <tbody id="notilist" class="notify-pg-tbl-body">
                @if (!model.Loading)
                {
                    @foreach (NotificationItemViewModel notification in model.Notifications)
                    {
                        <tr>
                            @*  <td><img class="notification-unread-button" src="" alt=""></td> *@
                            <td>
                                @if (notification.PushNotify)
                                {
                                    <strong>@notification.PushNotif_Title</strong>
                                    <br />
                                    <span style="font-size:11px;">@notification.Content</span>
                                }
                                else
                                {
                                    @notification.Content
                                }
                            </td>
                            @{
                                string imageSourceClass = !string.IsNullOrEmpty(notification.EventType) ? notification.EventType : "notif-def-icon";
                            }
                            <td>@notification.CreatedDate </td>
                            <td class="notifi-img">
                                <img height="24" class="@imageSourceClass" src="" alt="ico-@notification.EventType" />
                            </td>
                            <td>
                                @if (!notification.PushNotify)
                                {
                                    <input class="deletebin" src="" alt="delete" style="border-style: hidden; background-color: transparent !important;" value="" @onclick="async () => await DeleteNotification(notification.Id)" />
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private NotificationViewModel model;
    private Progress<LoadingModel> _progress;

    protected override async Task OnInitializedAsync()
    {
        model = notificationService.NotificationModel;
        _progress = new Progress<LoadingModel>(p =>
        {
            model.Loading = p.IsLoading;
            InvokeAsync(StateHasChanged);
        });

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        // {
        //     model.Loading = p.IsLoading;
        //     InvokeAsync(StateHasChanged);
        // });
        if (firstRender)
        {
            await notificationService.LoadNotificationListAsync(_progress);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task SortByDate()
    {
        // Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        // {
        //     model.Loading = p.IsLoading;
        //     InvokeAsync(StateHasChanged);
        // });

        await notificationService.SortNotificationsByDate(model.DateSortDirection, _progress);
        model.DateSortDirection = model.DateSortDirection == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending;
    }

    private async Task DeleteNotification(long id)
    {
        await notificationService.DeleteSecretAsync(id);
        navigation.NavigateTo("/notification", true);
    }
}

