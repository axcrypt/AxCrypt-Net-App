@page ﻿"/AddCard"

@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Models;
@using AxCrypt.Api.Model;
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.App.Windows.Models
@using AxCrypt.App.Windows.Services
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content;
@using static AxCrypt.Abstractions.TypeResolve;

@inject NavigationManager navigationManager;
@inject NewSecretViewModel newSecretViewModel
@inject SecretServiceUtility secretServiceUtility
@inject AlertNotification alertNotification

<link href="css/@subscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@subscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@subscriptionLevel.ToString().ToLower()/site.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px;">
    <div class="page-heading">
            <h3 class="password-creation">
                Add Card
            </h3>    
    </div>
     <LoadingComponent IsLoading="@newSecretViewModel.Loading" />
    <div>
        @if(!newSecretViewModel.Loading)
        {
               <EditForm Model="@newSecretViewModel.Secret.Card" OnValidSubmit="SavePassword" @ref="editForm">
        <DataAnnotationsValidator />
        <div class="row">
            <ul class="clean-up" style=" list-style:none ">
        <li>
            <label for="Card_CardNumber">@Texts.CardNumberPrompt</label>
            <input maxlength="19" minlength="12" style="color:#494949 !important;" placeholder="XXXX XXXX XXXX XXXX" 
                   @bind="newSecretViewModel.Secret.Card.CardNumber" type="text" 
                   class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.CardNumber)))"
                   onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
            <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.CardNumber)" />
        </li>
        <li>
            <label for="Card_SecretDesc">@Texts.DescriptionLabel:</label>
            <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important;" placeholder="example" 
                      @bind="newSecretViewModel.Secret.Card.SecretDesc" 
                      class="@(GetInputClass(nameof(newSecretViewModel.Secret.Card.SecretDesc)))"></textarea>
            <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.SecretDesc)" />
        </li>
        <li class="list-row">
            <div class="list-width">
                <label for="Card_NameOnCard">@Texts.NameOnCardPrompt</label>
                <input type="text" style="color:#494949 !important;" placeholder="Name and Surname" 
                       @bind="newSecretViewModel.Secret.Card.NameOnCard"
                       class="@(GetInputClass(nameof(newSecretViewModel.Secret.Card.NameOnCard)))" />
                <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.NameOnCard)" />
            </div>
            <div class="list-width">
                <label for="Card_SecurityCode">Security code:</label><br />
                <div style="display:flex">
                    <input id="Card_SecurityCode" maxlength="3" placeholder="000" @bind="newSecretViewModel.Secret.Card.SecurityCode"
                           type="password" 
                           class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.SecurityCode)))"
                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                           oninput="this.value = this.value.replace(/\D/g, '').substring(0, 3)" />
                    <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.SecurityCode)" />
                </div>
            </div>
        </li>
        <li class="list-row">
            <div class="list-width">
                <label for="Card_ExpirationDate">Expiration date:</label>
                <input id="Card_ExpirationDate" maxlength="7" placeholder="MM/YYYY" @bind="newSecretViewModel.Secret.Card.ExpirationDate"
                       type="text" 
                       class="form-control @(GetInputClass(nameof(newSecretViewModel.Secret.Card.ExpirationDate)))"
                       onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                       oninput="this.value = this.value.replace(/\D/g, '').substring(0, 6).replace(/(\d{2})(\d{2})/, '$1/$2')" />
                <ValidationMessage For="@(() => newSecretViewModel.Secret.Card.ExpirationDate)" />
            </div>
        </li>

                <li>
                    <div style=" gap:20px; ">
                        <button type="submit" class="button btn-extra-small success" >Save</button>
                        <NavLink href="passwordManager">
                            <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                        </NavLink>
                    </div>
                </li>
            </ul>
        </div>
     @if (alertNotification.IsNotificationVisible)
        {
            <div class="medium-11 columns">
                <div data-alert class="alert-box @alertNotification.NotificationClass radius">
                    <span style="white-space: break-spaces;">@alertNotification.NotificationMessage</span>
                    <a class="clse-img" style="float: right; color:white; cursor: pointer;" @onclick="alertNotification.HideNotification">X</a>
                </div>
            </div>
        }
    </EditForm>
        }
    </div>
   
</div>
@code {
    private SubscriptionLevel subscriptionLevel;

    private EditForm editForm;

    private string GetInputClass(string propertyName)
    {
        FieldIdentifier fieldIdentifier = new FieldIdentifier(newSecretViewModel.Secret.Card, propertyName);
        bool isFieldValid = editForm.EditContext.GetValidationMessages(fieldIdentifier).Any();

        return isFieldValid ? "input-error" : string.Empty; 
    }

    protected override void OnInitialized()
    {
        subscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        newSecretViewModel.Secret.Card.CardNumber = "";
        newSecretViewModel.Secret.Card.SecretDesc = "";
        newSecretViewModel.Secret.Card.NameOnCard = "";
        newSecretViewModel.Secret.Card.SecurityCode = "";
        newSecretViewModel = new NewSecretViewModel(secretServiceUtility);
         alertNotification.OnNotificationChanged += StateHasChanged;
    }

    private async Task SavePassword()
    {
         Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
       {
           newSecretViewModel.Loading = p.IsLoading;
           InvokeAsync(StateHasChanged);
       });
        bool success = await newSecretViewModel.SaveSecretAsync(progress);
         if (success)
        {
            alertNotification.ShowNotification("Your new Card entry has been saved.", NotificationType.Success);
             navigationManager.NavigateTo("/passwordManager", true);
        }
        else
        {
            alertNotification.ShowNotification(newSecretViewModel.ErrorMessage, NotificationType.Warning);
        }
    }
}