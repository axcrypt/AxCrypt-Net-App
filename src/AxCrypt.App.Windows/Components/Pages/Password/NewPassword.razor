@page "/AddPassword"

@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.App.Windows.Models
@using AxCrypt.App.Windows.Services
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Core.Secrets
@using AxCrypt.Cryptor.Model
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Models;
@using AxCrypt.Api.Model;
@using AxCrypt.Content;
@using static AxCrypt.Abstractions.TypeResolve;
@using System.Collections.Specialized
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject NavigationManager navigationManager
@inject NewSecretViewModel newSecretViewModel
@inject SecretServiceUtility secretServiceUtility
@inject IJSRuntime JSRuntime

<link href="css/@SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/site.min.css" rel="stylesheet" />
<link href="css/login.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px;">
    <div class="page-heading">
        <h3 class="password-creation">
            Add Password
        </h3>
    </div>
    <AxCrypt.App.Windows.Components.Pages.Shared.LoadingComponent IsLoading="@newSecretViewModel.Loading" />
    <div>
        @if (!newSecretViewModel.Loading)
        {
            <EditForm Model="@newSecretViewModel.Secret.Password" OnValidSubmit="SavePassword" @ref="editForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <ul class="clean-up" style="list-style:none">
                        <li>
                            <label for="Password_Url">@Texts.PasswordUrlPrompt</label><br />
                            <input placeholder="www.example.com"
                                   @bind="newSecretViewModel.Secret.Password.Url"
                                   type="text"
                                   class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.Url))">
                        </li>
                        <li>
                            <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                            <textarea id="pwd-desc-inp"
                                      placeholder="example" maxlength="100000"
                                      @bind="@newSecretViewModel.Secret.Password.SecretDesc" rows="2"
                                      class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretDesc))"></textarea>
                            <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretDesc)" />
                        </li>
                        <li class="list-row">
                            <div class="list-width">
                                <label for="Password_Username">@Texts.UserNamePrompt</label><br />
                                <input id="pwd-username-inp" placeholder="name@example.com" maxlength="100000"
                                       @bind="newSecretViewModel.Secret.Password.Username"
                                       type="text"
                                       class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.Username))">
                            </div>
                            <div class="list-width">
                                <label for="password_secretvalue">@Texts.PassphrasePrompt</label><br />
                                <div style="display:flex; justify-content:flex-end;">
                                    <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                                    <input placeholder="123IUoow$!99" maxlength="1000"
                                           @bind="newSecretViewModel.Secret.Password.SecretValue"
                                           type="text"
                                           class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretValue))">
                                    <div id="suggest-new-password-actn-btn-dsktp" title="@Texts.ButtonSuggestText" @onclick="newSecretViewModel.SuggestPasswordAsync">
                                        <img class="suggest-password" src="" alt="suggest-img">
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretValue)" />
                            </div>
                        </li>
                        <li>
                            <div>
                                <button type="submit" class="button btn-extra-small success">Save</button>
                                <NavLink href="passwordManager">
                                    <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                                </NavLink>
                            </div>
                        </li>
                    </ul>
                </div>
                @if (newSecretViewModel.AlertNotification.IsNotificationVisible)
                {
                    <div class="medium-11 columns">
                        <div data-alert class="alert-box @newSecretViewModel.AlertNotification.NotificationClass radius">
                            <span style="white-space: break-spaces;">@newSecretViewModel.AlertNotification.NotificationMessage</span>
                            <a class="clse-img" style="float: right; color:white; cursor: pointer;" @onclick="newSecretViewModel.AlertNotification.HideNotification">X</a>
                        </div>
                    </div>
                }
            </EditForm>
        }
    </div>


</div>
@code {
    private SubscriptionLevel SubscriptionLevel { get; set; }

    private EditForm editForm;

    private string GetInputClass(string propertyName)
    {
        FieldIdentifier fieldIdentifier = new FieldIdentifier(newSecretViewModel.Secret.Password, propertyName);
        bool isFieldValid = editForm.EditContext.GetValidationMessages(fieldIdentifier).Any();

        return isFieldValid ? "input-error" : string.Empty;
    }


    protected override void OnInitialized()
    {
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        newSecretViewModel.Secret.Password.Url = "";
        newSecretViewModel.Secret.Password.SecretDesc = "";
        newSecretViewModel.Secret.Password.Username = "";
        newSecretViewModel.Secret.Password.SecretValue = "";

        newSecretViewModel = new NewSecretViewModel(secretServiceUtility);
        newSecretViewModel.AlertNotification.OnNotificationChanged += StateHasChanged;
    }

    private async Task SavePassword()
    {
        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
       {
           newSecretViewModel.Loading = p.IsLoading;
           InvokeAsync(StateHasChanged);
       });

        bool success = await newSecretViewModel.SaveSecretAsync(progress);
        if (success)
        {
            newSecretViewModel.AlertNotification.ShowNotification("Your new password entry has been saved.", NotificationType.Success);
            navigationManager.NavigateTo("/passwordManager", true);
            return;
        }

        newSecretViewModel.AlertNotification.ShowNotification(newSecretViewModel.ErrorMessage, NotificationType.Warning);
    }
}