@page "/AddPassword"

@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.Content

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject NewSecretViewModel newSecretViewModel
@inject SecretService secretService
@inject LogOnViewModel LogOnViewModel
@inject IJSRuntime JSRuntime

<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/site.min.css" rel="stylesheet" />

<link href="css/login.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px;">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.AddPasswordTitle
        </h3>
    </div>
    <div>
        <EditForm Model="@newSecretViewModel.Secret.Password" OnValidSubmit="SavePassword" @ref="editForm">
            <DataAnnotationsValidator />
            <div class="row">
                <ul class="clean-up" style="list-style:none">
                    <li>
                        <label for="Password_Url">@Texts.PasswordUrlPrompt</label><br />
                        <input placeholder="www.example.com"
                               @bind="newSecretViewModel.Secret.Password.Url"
                               type="text"
                               class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.Url))">
                    </li>
                    <li>
                        <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                        <textarea id="pwd-desc-inp"
                                  placeholder="example" maxlength="100000"
                                  @bind="@newSecretViewModel.Secret.Password.SecretDesc" rows="2"
                                  class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretDesc))"></textarea>
                        <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretDesc)" />
                    </li>
                    <li class="list-row">
                        <div class="list-width">
                            <label for="Password_Username">@Texts.UserNamePrompt</label><br />
                            <input id="pwd-username-inp" placeholder="name@example.com" maxlength="100000"
                                   @bind="newSecretViewModel.Secret.Password.Username"
                                   type="text"
                                   class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.Username))">
                        </div>
                        <div class="list-width">
                            <label for="password_secretvalue">@Texts.PassphrasePrompt</label><br />
                            <div style="display:flex; justify-content:flex-end;">
                                <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                                <input placeholder="123IUoow$!99" maxlength="1000"
                                       @bind="newSecretViewModel.Secret.Password.SecretValue"
                                       type="text"
                                       class="@GetInputClass(nameof(newSecretViewModel.Secret.Password.SecretValue))">
                                <div id="suggest-new-password-actn-btn-dsktp" title="@Texts.ButtonSuggestText" @onclick="newSecretViewModel.SuggestPasswordAsync">
                                    <img class="suggest-password" src="" alt="suggest-img">
                                </div>
                            </div>
                            <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.SecretValue)" />
                        </div>
                    </li>
                    <li>
                        <div>
                            <button type="submit" class="button btn-extra-small success">@Texts.ButtonSaveText</button>
                            <NavLink href="passwordManager">
                                <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                            </NavLink>
                        </div>
                    </li>
                </ul>
            </div>
        </EditForm>
    </div>
</div>

@code {

    private EditForm editForm;

    private string GetInputClass(string propertyName)
    {
        FieldIdentifier fieldIdentifier = new FieldIdentifier(newSecretViewModel.Secret.Password, propertyName);
        bool isFieldValid = editForm.EditContext.GetValidationMessages(fieldIdentifier).Any();

        return isFieldValid ? "input-error" : string.Empty;
    }

    protected override void OnInitialized()
    {
        secretService.SecretType = SecretType.Password;
        newSecretViewModel = new NewSecretViewModel(secretService);
    }

    private async Task SavePassword()
    {
        bool success = await newSecretViewModel.SaveSecretAsync();
        if (success)
        {
            StatusAlertService.Success(@Texts.NewSecretSuccess);
            navigationManager.NavigateTo("/passwordManager");
            return;
        }

        StatusAlertService.Error(newSecretViewModel.ErrorMessage);
    }
}