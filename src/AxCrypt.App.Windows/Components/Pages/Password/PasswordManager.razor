@page "/passwordManager"

@using AxCrypt.Api.Model.Secret
@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.App.Components.Password
@using AxCrypt.App.Windows.Helpers
@using AxCrypt.Core.Session
@using AxCrypt.Core.UI
@using AxCrypt.App.Windows.Models
@using AxCrypt.App.Windows.Services
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Common
@using AxCrypt.Core.Crypto
@using AxCrypt.Core.Runtime
@using AxCrypt.Core.Secrets
@using AxCrypt.Core.Service
@using AxCrypt.Api.Model;
@using AxCrypt.Content;
@using System.Collections.ObjectModel
@using AxCrypt.Cryptor.Model
@using Microsoft.JSInterop
@using static AxCrypt.Abstractions.TypeResolve;
@inject SecretsClientModel secretsClientModel;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject SecretServiceUtility secretTypeService ;
@inject SecretsListViewModel secretsListViewModel
@inject IExportKeyManagementFile exportFileService
@inject NewSecretViewModel newSecretViewModel;
@inject ManageSecretViewModel manageSecretViewModel
@inject AlertNotification alertNotification
@inject IJSRuntime jsRunTime

<link href="css/login.min.css" rel="stylesheet" />

@{
    var currentDevice = GetCurrentDeviceIdiom();
    int MaxSharedWithToShow = 4;
}

<div class="medium-12 columns">
    <h1 class="page-title">
        @Texts.Introduction2MailText16
        <img class="passwordmngr-logo" src="" />
    </h1>
</div>
<div class="max-height">
    <div id="content-index" class="medium-12 columns">
        <div class="">
            <div style="display:flex; justify-content:flex-start; gap:10px; width:100%; align-items:center;">
                <div class="tabcontent" style="width: 80%;">
                    <input id="secrets-keyword" type="text" @bind="@secretsListViewModel.Keyword" placeholder="@Texts.SearchPasswordPlaceHolder" @oninput="OnInputChanged" />
                </div>
                <div class="action-button-list">
                    <div class="dropdown">
                        <div class="action-button">
                            <img class="" src="images/password-create-icon.svg" alt="img" />
                        </div>
                        <div class="password-create-dropdown-content">
                            <dl>
                                <dd>
                                    <NavLink href="AddPassword" @onclick="() =>SetSecretType(SecretType.Password)">
                                        <img class="secrets-type-icon-desktop passwords-icon" src="" alt="passwords-icon" /> <span>@Texts.PassphrasePrompt</span>
                                    </NavLink>
                                </dd>
                                <dd>
                                    <NavLink href="AddCard" @onclick="() => SetSecretType(SecretType.Card)">
                                        <img class="secrets-type-icon-desktop cards-icon" src="" alt="cards-icon" /> <span>@Texts.CardPrompt</span>
                                    </NavLink>
                                </dd>
                                <dd style="border-bottom:none;">
                                    <NavLink href="AddNote" @onclick="() => SetSecretType(SecretType.Note)">
                                        <img class="secrets-type-icon-desktop notes-icon" src="" alt="secrets-type-icon-desktop" /> <span>@Texts.NoteContentPrompt</span>
                                    </NavLink>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <div class="dropdown">
                        <div class="action-button">
                            <img src="images/password-export-icon.svg" alt="img">
                        </div>
                        <div class="dropdown-content">
                            <a style="color:#69a051" @onclick="@(async () => await ExportFile("TXT"))">TXT</a>
                            <a style="color:#69a051" @onclick="@(async () => await ExportFile("XML"))">XML</a>
                        </div>
                    </div>
                    @if (currentDevice == DeviceIdiom.Tablet)
                    {
                        <div class="dropdown">
                            <div class="action-button">
                                <img src="images/exportup.svg" alt="img">
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (alertNotification.IsNotificationVisible)
            {
                <div class="medium-11 columns">
                    <div data-alert class="alert-box @alertNotification.NotificationClass radius">
                        <span style="white-space: break-spaces;">@alertNotification.NotificationMessage</span>
                        <a class="clse-img" style="float: right; color:white; cursor: pointer;" @onclick="HideNotification">X</a>
                    </div>
                </div>
            }
            <div style="width:58%; margin:10px 0px;" class="tab medium-9 columns">
                <a class="tablinks @(filter == SecretFilterOption.All ? "active" : "")"
                   @onclick="() => SetFilter(SecretFilterOption.All)">
                    @secretsListViewModel.SortOptionAllText
                </a>
                <a class="tablinks @(filter == SecretFilterOption.Recently ? "active" : "")"
                   @onclick="() => SetFilter(SecretFilterOption.Recently)">
                    @secretsListViewModel.SortOptionRecentText
                </a>
                <a class="tablinks @(filter == SecretFilterOption.Shared ? "active" : "")"
                   @onclick="() => SetFilter(SecretFilterOption.Shared)">
                    @secretsListViewModel.SortOptionSharedText
                </a>
            </div>
            <div id="search-secrets-list">
                <div style="gap:10px; display: flex; align-items: center;">
                    @{
                        if (filter != SecretFilterOption.Recently && filter != SecretFilterOption.Shared)
                        {
                            <div style="top:5px">
                                <input id="secret-type-filter-hidden" name="SecretsTypeFilter" type="hidden" value="Password"> <span class="filter-text">@Texts.SecretsSortOrderLabel</span>
                            </div>
                            <div>
                                <select id="secretsSortOrderOptions" name="SecretsSortOrder" @onchange="async (e) => await SortSecrets(e)"
                                        style="width:110px; height: 31px; padding: 3px; border-radius: 4px; margin: 0%">
                                    <option value="Date">@Texts.InvoiceDateHeadline</option>
                                    <option value="ByContent">@Texts.SecretsSortOrderOptionByContent</option>
                                </select>
                            </div>
                            <div class="filter-section">
                                <div class="dropdown">
                                    <img class="filter-image text-padding" src="" alt="filter-img">
                                    <a class="filter-text text-padding" href="javascript:void(0)"> Filter</a>
                                    <div class="password-filter-dropdown-content">
                                        <ul class="filter-section-desktop">
                                            <li style="padding:4px 6px;">
                                                <label style="border-top:none;">
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.SecretsAllItems
                                                           checked="@IsSelected(SecretsFilter.All)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.All)" />
                                                    <img class="secrets-type-icon-desktop secret-icon" src="" alt="secret-icon">
                                                    <span>@Texts.SecretsAllItems</span>
                                                </label>
                                            </li>
                                            <li style="padding:4px 6px;">
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.PassphrasePrompt
                                                           checked="@IsSelected(SecretsFilter.Password)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Password)" />
                                                    <img class="secrets-type-icon-desktop passwords-icon" src="" alt="passwords-icon">
                                                    <span> @Texts.PassphrasePrompt</span>
                                                </label>
                                            </li>
                                            <li style="padding:2px 6px;">
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.CardPrompt
                                                           checked="@IsSelected(SecretsFilter.Card)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Card)" />
                                                    <img class="secrets-type-icon-desktop cards-icon" src="" alt="cards-icon">
                                                    <span>@Texts.CardPrompt</span>
                                                </label>
                                            </li>
                                            <li style="border-bottom:none; padding:2px 6px;">
                                                <label>
                                                    <input type="radio" id="Password" name="SecretsTypeFilter" value=@Texts.NoteLabel
                                                           checked="@IsSelected(SecretsFilter.Note)" @onclick="() => secretsListViewModel.FilterSecretsBy(SecretsFilter.Note)" />
                                                    <img class="secrets-type-icon-desktop notes-icon" src="" alt="notes-icon">
                                                    <span>@Texts.NoteLabel</span>
                                                </label>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <LoadingComponent IsLoading="@secretsListViewModel.Loading" />
    <div>
        @if (!secretsListViewModel.Loading)
        {
            @if (secretsListViewModel.FilteredSecrets.Any())
            {
                <div class="row">

                    <ul class="clean secrets-list" style="list-style: none !important; margin:2% 0%">
                        @foreach (SecretViewModel secret in secretsListViewModel.FilteredSecrets.Take(itemsToShow))
                        {
                            <li class="list-box" @onclick="async () => await NavigateToSecretView(secret.ToClientModel(secret.SecretGuid))">
                                <div class="password-box">
                                    @if (secret.SharedWith != null && secret.SharedWith.Any())
                                    {
                                        <img class="password-key-share-icon" src="/images/IcoMultipleUsers.svg" alt="" @onmouseover="() => ShowPopup(secret.SecretGuid)" @onmouseout="HidePopup">
                                    }
                                    <div>
                                        @switch (secret.SecretType)
                                        {
                                            case SecretType.Card:
                                                <img class="secrets-type-icon card-icon" src="path-to-your-card-icon.svg" alt="secret-type-icon">

                                                <br />
                                                <label class="password-title">@secret.Card.SecretDesc</label>
                                                <span class="secret-title"></span>
                                                break;

                                            case SecretType.Password:
                                                <img class="secrets-type-icon password-icon" src="path-to-your-password-icon.svg" alt="secret-type-icon">

                                                <br />
                                                <label class="password-title">@secret.Password.SecretDesc</label>
                                                <span class="secret-title"></span>
                                                break;

                                            case SecretType.Note:
                                                <img class="secrets-type-icon note-icon" src="path-to-your-note-icon.svg" alt="secret-type-icon">

                                                <br />
                                                <label class="password-title">@secret.Note.SecretDesc</label>
                                                <span class="secret-title"></span>
                                                break;
                                        }

                                    </div>
                                    @if (filter != SecretFilterOption.Shared && secret.SharedWith != null && secret.SharedWith.Any())
                                    {
                                        <div class="list-box">
                                            <div class="sharedwith-box" style="@(hoveredSecretId == secret.SecretGuid ? "display: block;" : "display: none;")">
                                                <div class="free-color" id="upgrade-sec">
                                                    <span style="color:white;">
                                                        <strong>Shared With:</strong>
                                                    </span>
                                                    <ul>
                                                        @foreach (SecretSharedUserViewModel user in secret.SharedWith.Take(MaxSharedWithToShow))
                                                        {
                                                            <li style="display:flex; align-items:center;">
                                                                <img class="axcrypt-icons" src="/images/default/AxCrypt_Icon.svg" alt="img">
                                                                <div class="shr-txt-ovflw">
                                                                    <span class="shared-text">@user.UserEmail</span><br>
                                                                </div>
                                                            </li>
                                                        }
                                                        @if (secret.SharedWith.Count() > MaxSharedWithToShow)
                                                        {
                                                            <li style="color: #fff; position: relative;top: -10px;">.....</li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                </div>
                <div style="text-align:center;">
                    @if (IsShowMoreVisible)
                    {
                        <a @onclick="ShowMore"><img class="show-mre-icon" /></a>
                    }
                    @if (IsShowLessVisible)
                    {
                        <a @onclick="ShowLess"><img class="show-mre-icon down" /></a>
                    }
                </div>
            }
            else
            {
                <div class="text-center" style="padding-top: 30px;">
                    <span class="empty-view-heading">Let`s start our journey!</span><br />
                    <span>Add and secure your first password.</span><br />
                    <img class="empty-passmngr-img" alt="default file img" />
                </div>
            }
        }
    </div>
</div>



@code {

    private int itemsToShow = 16;
    private int incrementValue = 8;

    private bool IsShowMoreVisible => itemsToShow < secretsListViewModel.FilteredSecrets.Count;
    private bool IsShowLessVisible => itemsToShow > incrementValue;
    private string notificationMessage;
    private bool isNotificationVisible;

    private void ShowMore()
    {
        itemsToShow = Math.Min(itemsToShow + incrementValue, secretsListViewModel.FilteredSecrets.Count);
    }
    private void ShowLess()
    {
        itemsToShow = Math.Max(itemsToShow - incrementValue, incrementValue);
    }
    private async Task OnInputChanged(ChangeEventArgs e)
    {
        secretsListViewModel.Keyword = e.Value.ToString();
        await secretsListViewModel.ApplyFilterOnSecrets();
    }


    private Guid? hoveredSecretId;

    private void ShowPopup(Guid secretId)
    {
        hoveredSecretId = secretId;
    }

    private void HidePopup()
    {
        hoveredSecretId = null;
    }
    private SubscriptionLevel SubscriptionLevel { get; set; }
    private DeviceIdiom currentDevice;
    public ObservableCollection<SecretViewModel> passwordList { get; set; } = new ObservableCollection<SecretViewModel>();
    private SecretsFilter selectedFilter = SecretsFilter.All;

    public SecretFilterOption filter { get; set; } = SecretFilterOption.All;

    protected override async Task OnInitializedAsync()
    {
        currentDevice = GetCurrentDeviceIdiom();
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        {
            secretsListViewModel.Loading = p.IsLoading;
            InvokeAsync(StateHasChanged);
        });
        await secretsListViewModel.FindSecrets(forceReload: true, progress);
        StateHasChanged();
        alertNotification.OnNotificationChanged += StateHasChanged;
    }

    private DeviceIdiom GetCurrentDeviceIdiom()
    {
        return DeviceInfo.Idiom;
    }
    private async Task popupId()
    {
        await jsRunTime.InvokeVoidAsync("popupId");
    }

    private async Task NavigateToSecretView(SecretClientModel secret)
    {
        SecretViewModel secretViewModel = new SecretViewModel(secret);

        secretService.SetCurrentSecret(secretViewModel);
        manageSecretViewModel.SetSecretsForShare(new SecretViewModel(secret));
        ShareSecretViewModel shareViewModel = new ShareSecretViewModel(secretService);
        string url = secret.Type switch
        {
            AxCrypt.Api.Model.Secret.SecretType.Card => "/viewcard",
            AxCrypt.Api.Model.Secret.SecretType.Password => "/viewpassword",
            AxCrypt.Api.Model.Secret.SecretType.Note => "/viewnote",
            _ => string.Empty
        };
        if (!string.IsNullOrEmpty(url))
        {
            navigationManager.NavigateTo(url);
        }
    }
    private void SetSecretType(SecretType type)
    {
        secretTypeService.CurrentSecretType = type;
    }

    private bool IsSelected(SecretsFilter filter)
    {
        return selectedFilter == filter;
    }

    private SecretsSortOrder selectedSortOrder { get; set; } = SecretsSortOrder.None;

    private async Task SortSecrets(ChangeEventArgs e)
    {
        if (Enum.TryParse<SecretsSortOrder>(e.Value.ToString(), out var sortOrder))
        {
            selectedSortOrder = sortOrder;
        }

        await secretsListViewModel.SortSecretsBy(selectedSortOrder);
    }

    private async Task SetFilter(SecretFilterOption selectedFilter)
    {
        filter = selectedFilter;

        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        {
            secretsListViewModel.Loading = p.IsLoading;
            InvokeAsync(StateHasChanged);
        });
        switch (selectedFilter)
        {
            case SecretFilterOption.All:
            case SecretFilterOption.Recently:
                await secretsListViewModel.FilterSecretsBy(selectedFilter, progress);
                break;
            case SecretFilterOption.Shared:
                await secretsListViewModel.FilterSharedSecrets(selectedFilter, progress);
                break;
        }
        secretsListViewModel.OnTabOpened();
        StateHasChanged();
    }

    private async Task UpdateFilteredSecrets()
    {
        await secretsListViewModel.ApplyFilterOnSecrets();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && secretTypeService.SaveSuccess)
        {
            secretTypeService.SaveSuccess = false;
            StateHasChanged();
        }
    }
    private void HideNotification()
    {
        alertNotification.HideNotification();
    }
    private void CloseNotification()
    {
        isNotificationVisible = false;
        StateHasChanged();
    }
    public void Dispose()
    {
        alertNotification.OnNotificationChanged -= StateHasChanged;
    }
    private void CloseAlert()
    {
        secretTypeService.SaveSuccess = false;
    }
    private async Task ExportFile(string fileType)
    {
        bool saveResult = false;

        switch (fileType)
        {
            case "TXT":
                saveResult = await secretsListViewModel.ExportTextAsync();
                break;
            case "XML":
                saveResult = await secretsListViewModel.ExportXml();
                break;
            default:
                alertNotification.ShowNotification("Unsupported file type.", NotificationType.Warning);
                return;
        }

        if (saveResult)
        {
            alertNotification.ShowNotification("Your file has been successfully downloaded!", NotificationType.Success);
        }
        else
        {
            alertNotification.ShowNotification("Failed to download the file. Please check your internet connection and try again.", NotificationType.Warning);
        }
    }
}