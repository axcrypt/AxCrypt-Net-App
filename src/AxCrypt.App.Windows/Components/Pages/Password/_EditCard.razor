@page "/editcard"

@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop
@using static AxCrypt.Abstractions.TypeResolve;

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject IJSRuntime jsRuntime

<link href="css/@editSecretViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@editSecretViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px;">
    <div class="page-heading">
        <h3 class="password-creation">
            Edit Card
        </h3>
    </div>
    <AxCrypt.App.Windows.Components.Pages.Shared.LoadingComponent IsLoading="@editSecretViewModel.Loading" />
    <EditForm Model="@secretService.CurrentSecret.Card" OnValidSubmit="SavePassword">
        <DataAnnotationsValidator />
        @if (!editSecretViewModel.Loading)
        {
            <div class="row">

                <ul class="clean-up" style=" list-style:none">
                    <li>
                        <label for="Card_CardNumber">@Texts.CardNumberPrompt</label>
                        <input maxlength="19" minlength="12" style="color:#494949 !important;" @bind="@secretService.CurrentSecret.Card.CardNumber" type="text"
                               onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                        <ValidationMessage For="@(() => secretService.CurrentSecret.Card.CardNumber)" />
                    </li>
                    <li>
                        <label for="Card_SecretDesc">@Texts.DescriptionLabel:</label>
                        <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important;" @bind="@secretService.CurrentSecret.Card.SecretDesc"></textarea>
                        <ValidationMessage For="@(() => secretService.CurrentSecret.Card.SecretDesc)" />
                    </li>
                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_NameOnCard">@Texts.NameOnCardPrompt</label>
                            <input type="text" style="color:#494949 !important;" @bind="@secretService.CurrentSecret.Card.NameOnCard">
                            <ValidationMessage For="@(() => secretService.CurrentSecret.Card.NameOnCard)" />
                        </div>
                        <div class="list-width">
                            <label for="Card_SecurityCode">Security code:</label><br />
                            <div style="display:flex">
                                <input maxlength="1000" style="color:#494949 !important;" @bind="@secretService.CurrentSecret.Card.SecurityCode" name="Card.SecurityCode" type="text"
                                       onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                       oninput="this.value = this.value.replace(/\D/g, '').substring(0, 3)">
                                <ValidationMessage For="@(() => secretService.CurrentSecret.Card.SecurityCode)" />
                            </div>
                        </div>
                    </li>
                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_ExpirationDate">@Texts.ExpirationDatePrompt</label>
                            <input id="card-exp-date-inp" style="color:#494949 !important; " @bind="@secretService.CurrentSecret.Card.ExpirationDate"
                                   type="text" class="form-control"
                                   onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                   oninput="this.value = this.value.replace(/\D/g, '').substring(0, 6).replace(/(\d{2})(\d{2})/, '$1/$2')">
                            <ValidationMessage For="@(() => secretService.CurrentSecret.Card.ExpirationDate)" />
                        </div>
                    </li>
                    <li>
                        <div>
                            <button type="submit" class="button btn-extra-small success">Save</button>
                            <NavLink href="passwordManager">
                                <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                            </NavLink>
                        </div>
                    </li>
                </ul>
            </div>
        }
    </EditForm>
</div>

@code {
    public SecretCardViewModel CardModel { get; set; }
    private SecretViewModel? CurrentSecret { get; set; }
    bool isAxCryptUser = true;

    protected override void OnInitialized()
    {
        editSecretViewModel.SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        CurrentSecret = secretService.GetCurrentSecret();
        if (CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }
    }

    private async Task OnAfterRenderAsync()
    {
        await jsRuntime.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        {
            editSecretViewModel.Loading = p.IsLoading;
            InvokeAsync(StateHasChanged);
        });

        editSecretViewModel.Secret = secretService.CurrentSecret;
        bool saveResult = await editSecretViewModel.SaveSecretAsync(progress);
        if (saveResult)
        {
            StatusAlertService.Success("Your new password entry has been Updated!.");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }

        navigationManager.NavigateTo("/passwordManager");
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        CardModel.SecretDesc = args?.Value?.ToString();
    }

    bool contextMenu = false;

    void contextMenuPopup()
    {
        contextMenu = !contextMenu;
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}