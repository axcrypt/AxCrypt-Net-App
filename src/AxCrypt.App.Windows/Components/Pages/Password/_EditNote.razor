@page ﻿"/editnote"

@using AxCrypt.App.Desktop.Helpers
@using AxCrypt.App.Desktop.Models
@using AxCrypt.App.Desktop.Models.Secret
@using AxCrypt.App.Desktop.Services.Interface
@using AxCrypt.Content
@using Microsoft.JSInterop

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject LogOnViewModel LogOnViewModel

@inject IJSRuntime jsRuntime

<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px;">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.EditNoteTitle
        </h3>
    </div>
   <EditForm Model="@secretService.CurrentSecret.Note" OnValidSubmit="SavePassword">
        <DataAnnotationsValidator />
            <div class="row">
                <ul class="clean-up" style=" list-style:none">
                <li>
                    <label for="Password_SecretDesc">@Texts.DescriptionLabel:</label><br />
                    <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important;"  @bind="@secretService.CurrentSecret.Note.SecretDesc"></textarea>
                     <ValidationMessage For="@(() => secretService.CurrentSecret.Note.SecretDesc)" />
                </li>
                <li>
                    <label for="Note_Note">@Texts.NoteLabel:</label>
                    <textarea type="text" class="secret-note-bgnd" cols="20" maxlength="100000" style="color:#494949 !important;"  @bind="@secretService.CurrentSecret.Note.Note" ></textarea>
                <ValidationMessage For="@(() => secretService.CurrentSecret.Note.Note)" />
                </li>
                <li>
                <div>
                    <button type="submit" class="button btn-extra-small success" >@Texts.ButtonSaveText</button>
                    <NavLink href="passwordManager">
                        <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                    </NavLink>
                </div>
            </li>
            </ul>
        </div>
    </EditForm>
</div>
@code {
    bool isAxCryptUser = true;

    protected override void OnInitialized()
    {
        editSecretViewModel.SubscriptionLevel = LogOnViewModel.SubscriptionLevel;

        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }
    }

    private async Task OnAfterRenderAsync()
    {
        await jsRuntime.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        editSecretViewModel.Secret = secretService.CurrentSecret;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success("Your new password entry has been Updated!.");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }

        navigationManager.NavigateTo("/passwordManager");
    }

    bool contextMenu = false;

    void contextMenuPopup()
    {
        contextMenu = !contextMenu;
    }
  
    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }

    private async Task HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret.Note.SecretDesc = args.Value.ToString();
    }
   
}