@page "/editpassword"

@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core.Crypto.Asymmetric
@using AxCrypt.Core.Secrets
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.ViewModel
@using AxCrypt.Cryptor.Model
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Services
@using Microsoft.JSInterop
@using static AxCrypt.Abstractions.TypeResolve;

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject EditSecretViewModel editSecretViewModel
@inject NewSecretViewModel newSecretViewModel
@inject IJSRuntime js

<link href="css/@editSecretViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@editSecretViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />

<div style="width: 85%; margin-top: 80px; ">
    <div class="page-heading">
        <h3 style="background-position:center;" class="password-creation">
            Edit Password
        </h3>
    </div>
    <EditForm Model="@secretService.CurrentSecret.Password" OnValidSubmit="SavePassword">
        <DataAnnotationsValidator />
        @if (!editSecretViewModel.Loading)
        {
            <ul class="clean-up" style=" list-style:none">
                <li>
                    <label for="Password_Url">URL:</label><br />
                    <input style="color:#494949 !important;" @bind-value="@secretService.CurrentSecret.Password.Url" type="text">
                    <ValidationMessage For="@(() => newSecretViewModel.Secret.Password.Url)" />
                </li>
                <li>
                    <label for="Password_SecretDesc">Description:</label><br />
                    <textarea id="pwd-desc-inp" style="color:#494949 !important;" maxlength="100000" @bind="@secretService.CurrentSecret.Password.SecretDesc"></textarea>
                    <ValidationMessage For="@(() => secretService.CurrentSecret.Password.SecretDesc)" />
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Password_Username">Username:</label><br />
                        <input id="pwd-username-inp" style="color:#494949 !important;" maxlength="100000" type="text" @bind-value="@secretService.CurrentSecret.Password.Username">
                        <ValidationMessage For="@(() => secretService.CurrentSecret.Password.Username)" />
                    </div>
                    <div class="list-width">
                        <label for="password_secretvalue">Password:</label><br />
                        <div style="display:flex; position: relative;">
                            <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                            <input class="passwordInput" style="color:#494949 !important;" maxlength="1000" type="text" @bind-value="@secretService.CurrentSecret.Password.SecretValue">
                            <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="CopyToClipboard">
                                <img class="clipbrd" src="" alt="copy-clp-brd">
                            </div>
                            <ValidationMessage For="@(() => secretService.CurrentSecret.Password.SecretValue)" />
                        </div>
                    </div>
                </li>
                <li>
                    <div>
                        <button type="submit" class="button btn-extra-small success">Save</button>
                        <NavLink href="passwordManager">
                            <input type="reset" class="button btn-extra-small cancel" value="@Texts.ButtonCancelText" style="margin-left: 20px;" />
                        </NavLink>
                    </div>
                </li>
            </ul>
        }

    </EditForm>
</div>
@code {
    public SecretPasswordViewModel? PasswordModel { get; set; }
    private SecretViewModel? CurrentSecret { get; set; }

    protected override void OnInitialized()
    {
        editSecretViewModel.SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        CurrentSecret = secretService.GetCurrentSecret();
        if (CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }
    }

    private async Task OnAfterRenderAsync()
    {
        await js.InvokeVoidAsync("toggleClass");
    }

    private async Task SavePassword()
    {
        editSecretViewModel.Secret = secretService.CurrentSecret;
        bool saveResult = await editSecretViewModel.SaveSecretAsync();
        if (saveResult)
        {
            StatusAlertService.Success("Your new password entry has been Updated!.");
        }
        else
        {
            StatusAlertService.Error(editSecretViewModel.ErrorMessage);
        }

        navigationManager.NavigateTo("/passwordManager");
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        PasswordModel.SecretDesc = args?.Value?.ToString();
    }

    private async Task CopyToClipboard()
    {
        string password = secretService.CurrentSecret.Password.SecretValue;
        await js.InvokeVoidAsync("copyToClipboard", password);
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}