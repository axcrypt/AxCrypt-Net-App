@page "/viewcard"

@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core
@using AxCrypt.Core.UI

@inject IStatusAlertService StatusAlertService;
@inject NavigationManager navigationManager
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject ShareSecretViewModel shareSecretViewModel
@inject LogOnViewModel LogOnViewModel
@inject IJSRuntime JSRuntime

<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/sharesecret.min.css" rel="stylesheet" />

<div style="margin-top: 80px;" class="page-max-height">
    <div class="page-heading">
        <h3 class="password-creation">
            @Texts.ViewCardTitle
        </h3>
    </div>
    <form>
        <div class="row">
            <ul class="clean-up" style=" list-style:none">
                <li>
                    <label for="Card_CardNumber">@Texts.CardNumberPrompt</label>
                    <div style="position: relative;">
                        <input id="cardNumberInput" maxlength="19" minlength="12" style="color:#494949 !important; background-color:#E2E2E2" value="@GetValue(isCardNumberVisible, secretService.CurrentSecret.Card.CardNumber)" readonly="readonly" type="text" @onclick="() => ToggleVisibility(ref isCardNumberVisible)">
                        <div id="cp-card-number-clipbrd" style="position: absolute; right: 10px; top:2px;cursor: pointer;" class="copy-to-clipbrd" @onclick="() => CopyToClipboard(secretService.CurrentSecret.Card.CardNumber)">
                            <img class="clipbrd" src="" alt="copy-clp-brd">
                        </div>
                    </div>
                </li>
                <li>
                    <label for="Card_SecretDesc">@Texts.DescriptionLabel</label>
                    <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Card.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea>
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Card_NameOnCard">@Texts.NameOnCardPrompt</label>
                        <input type="text" style="color:#494949 !important; background-color:#E2E2E2" @bind-value="@secretService.CurrentSecret.Card.NameOnCard" readonly="readonly">
                    </div>
                    <div class="list-width">
                        <label for="Card_SecurityCode">@Texts.SecurityCodePrompt:</label><br />
                        <div style="display:flex; position: relative;">
                            <input id="securityCodeInput" maxlength="1000" style="color:#494949 !important; background-color:#E2E2E2" value="@GetValue(isSecurityCodeVisible, secretService.CurrentSecret.Card.SecurityCode)" readonly="readonly" type="text" @onclick="() => ToggleVisibility(ref isSecurityCodeVisible)">
                            <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="() => CopyToClipboard(secretService.CurrentSecret.Card.SecurityCode)">
                                <img class="clipbrd" src="" alt="copy-clp-brd">
                            </div>
                        </div>
                    </div>
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Card_ExpirationDate">@Texts.ExpirationDatePrompt</label>
                        <input id="card-exp-date-inp" style="color:#494949 !important; background-color:#E2E2E2" @bind-value="@secretService.CurrentSecret.Card.ExpirationDate" type="text" readonly="readonly">
                    </div>
                </li>
                <li>
                    <div style="display:flex; justify-content:space-around; width:100%;">
                        <div style="display:flex; justify-content:flex-start; gap:20px; width:100%;">
                            <div>
                                <NavLink href="passwordManager">
                                    <input type="submit" class="button cancel btn-extra-small" value="Back" />
                                </NavLink>
                            </div>
                            <div>
                                <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                            </div>
                        </div>
                        @if (!IsSharedView)
                        {
                            <div>
                                <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="NavigateToEdit" />
                            </div>
                        }
                    </div>
                </li>
            </ul>
            @if (!IsSharedView)
            {
                <div onclick="toggleClass()" class="sharetext-arrow">
                    <div class="sharewith-row" id="sharewith-expnd-collps">
                        <span class="url-text">@Texts.PromptSharedWith</span>
                        <img id="rotateImg" class="share-box share-image" src="/images/Vector.svg" alt="">
                    </div>
                </div>
                <div id="container" class="container">
                    <form id="temp-add-share-user">
                        <div class="sharewith-box" style="padding: 20px; ">
                            <div style="margin:auto; justify-content:flex-start; flex-wrap:wrap; justify-content:space-around; width:100% " class="row">
                                <div class="small-8 columns">
                                    <input type="text" id="new-member-email" name="memberEmail" placeholder="someone@email.example" @onclick="showSyncPopup" @bind="@shareSecretViewModel.SecretSharingUserEmail" style="width: 100%; height: 40px; border-radius:5px ">
                                </div>
                                <div class="small-2">
                                    <select style="height: 35px; border-radius:5px" id="shareVisibilityOptions" name="Visibility" title="Visibility" @bind="shareSecretViewModel.VisibilityType">
                                        @foreach (SecretShareVisibility visibility in Enum.GetValues(typeof(SecretShareVisibility)))
                                        {
                                            <option value="@visibility">@visibility</option>
                                        }
                                    </select>
                                </div>
                                <div class="small-2 columns">
                                    <input style=" margin-top:4%; width: 90px; margin-left: 20px;" id="Add-Share-Users" type="button" class="button active btn-small " @onclick="shareSecretViewModel.AddUserToSharedListAsync" value="Add" />
                                </div>
                            </div>
                            <div class="">
                                <h3 class="select-files font-bold">Added users with access (<span id="userCount">@shareSecretViewModel.Secret.SharedWith?.Count()</span>)</h3>
                                @if (shareSecretViewModel.Secret.SharedWith.Any())
                                {
                                    <div class="row">
                                        <div class="file-box-desktop scroll-container" id="sharedUserList" style="margin-bottom:0px; margin-right:5px;">
                                            @foreach (SecretSharedUserViewModel user in shareSecretViewModel.Secret.SharedWith)
                                            {
                                                <dl>
                                                    <dd class="list-bgrnd">
                                                        @if (isAxCryptUser)
                                                        {
                                                            <img class="axcrypt-icons" style="float:left; margin-top:5px;" src="/images/default/AxCrypt_Icon.svg" alt="img">
                                                        }
                                                        else
                                                        {
                                                            <img class="contact-icon" style="float:left;" src="" alt="img">
                                                        }
                                                        <div style="display:inline-block; ">
                                                            <span class="shared-text">@user.UserEmail</span><br />
                                                            <span style="padding-left:8px; display: block;" class="share-visibility">@user.Visibility</span>
                                                        </div>
                                                        <img class="menu-image" src="/images/Group160.svg" alt="img" @onclick="() => shareSecretViewModel.UpdatedSelectedUser(user)">
                                                        <hr style="width:100%;">
                                                    </dd>
                                                </dl>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="file-box-desktop file-box-empty scroll-container" id="sharedUserList" style="margin-right:0px; margin-right:5px;"></div>
                                }
                                @if (shareSecretViewModel.CanContextMenuOpened)
                                {
                                    <div class="hide-model-popup context-menu">
                                        <dl>
                                            <dd>
                                                <img class="unshare-icon" src="/images/IcoUnShare.svg" alt="" />
                                                <span @onclick="shareSecretViewModel.RemoveSelectedSharedUser">Unshare</span>
                                            </dd>
                                        </dl>
                                    </div>
                                }
                            </div>
                        </div>
                        <div style="margin-left: 0px !important;">
                            <input type="submit" class="button success btn-extra-small" @onclick="ApplyShare" value="Apply" />
                        </div>
                    </form>
                </div>
            }
        </div>
    </form>
</div>

@code {
    bool IsSharedView { get; set; }
    bool isAxCryptUser = true;

    protected override void OnInitialized()
    {
        viewSecretViewModel.UserEmail = Resolve.KnownIdentities.DefaultEncryptionIdentity.UserEmail.Address;

        if (secretService.CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }

        IsSharedView = secretService.CurrentSecret?.SharedWith != null && secretService.CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail;
    }

    private async Task OnAfterRenderAsync()
    {
        await JSRuntime.InvokeVoidAsync("toggleClass");
    }

    private void NavigateToEdit()
    {
        if (secretService.CurrentSecret != null)
        {
            string url = secretService.CurrentSecret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Card => $"/editcard"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigationManager.NavigateTo(url);
            }
        }
    }

    private async Task DeleteSecret()
    {
        bool isConfirmed = await Application.Current.MainPage.DisplayAlert("Alert!", "Are You sure want to delete this secret.", Texts.ButtonOkText, Texts.ButtonCancelText);
        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.DeleteSecretAsync();
        if (deleted)
        {
            StatusAlertService.Success("Your secret has been deleted!.");
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }

        navigationManager.NavigateTo("/passwordManager");
    }

    private async Task HandleOnChange(ChangeEventArgs args)
    {
        secretService.CurrentSecret.Card.SecretDesc = args?.Value?.ToString();
    }

    private async Task ApplyShare()
    {
        await shareSecretViewModel.ApplyShareSecret();
        navigationManager.NavigateTo("/passwordManager");
    }

    private bool isCardNumberVisible = false;
    private bool isSecurityCodeVisible = false;

    private string GetValue(bool isVisible, string value)
    {
        return isVisible ? value : "**click to show**";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "cardNumberInput");
            await JSRuntime.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "securityCodeInput");
        }
    }

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "cardNumberInput" && isCardNumberVisible)
        {
            isCardNumberVisible = false;
        }
        else if (fieldId == "securityCodeInput" && isSecurityCodeVisible)
        {
            isSecurityCodeVisible = false;
        }
        StateHasChanged();
    }

    private void ToggleVisibility(ref bool isVisible)
    {
        isVisible = !isVisible;
        StateHasChanged();
    }

    private async Task CopyToClipboard(string value)
    {
        await JSRuntime.InvokeVoidAsync("copyToClipboard", value);
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}