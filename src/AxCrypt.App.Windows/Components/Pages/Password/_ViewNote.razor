@page ﻿"/viewnote"

@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Helpers
@using AxCrypt.Content
@using AxCrypt.Core.UI
@using AxCrypt.Cryptor.Model
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.App.Components.Services
@using Microsoft.JSInterop
@using static AxCrypt.Abstractions.TypeResolve;
@inject NavigationManager navigationManager
@inject SecretsClientModel secretsClientModel
@inject SecretService secretService
@inject ViewSecretViewModel viewSecretViewModel
@inject ShareSecretViewModel shareSecretViewModel
@inject AlertNotification alertNotification
@inject IJSRuntime jsRuntime

<link href="css/@SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@SubscriptionLevel.ToString().ToLower()/sharesecret.min.css" rel="stylesheet" />

<div style="margin-top: 80px;" class="page-max-height">
    <div class="page-heading">
        <h3 class="password-creation">
            View Note
        </h3>
    </div>
     <LoadingComponent IsLoading="@viewSecretViewModel.Loading" />
    <form>
        <div class="row">
        @if (!viewSecretViewModel.Loading)
            { 
            <ul class="clean-up" style=" list-style:none">
                <li>
                    <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                    <textarea id="pwd-desc-inp" maxlength="100000" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Note.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea>
                </li>
                <li>
                    <label for="Note_Note">@Texts.NoteLabel</label>
                    <textarea type="text" class="secret-note-bgnd" cols="20" maxlength="100000" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Note.Note" readonly="readonly"></textarea>
                </li>
                @if (secretService.CurrentSecret.SharedWith != null && secretService.CurrentSecret.OwnerEmail != UserEmail)
                {

                    <li class="list-row">
                        <div class="list-width">
                            <label for="Card_ExpirationDate">Owner Email:</label>
                            <input id="card-exp-date-inp" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.OwnerEmail" type="text" readonly="readonly">
                        </div>
                    </li>
                }
                <li>
                    <div style="display:flex; justify-content:space-around; width:100%;">
                        <div style="display:flex; justify-content:flex-start; gap:20px; width:100%;">
                            <div>
                                <NavLink href="passwordManager">
                                    <input type="submit" class="button cancel btn-extra-small" value="Back" />
                                </NavLink>
                            </div>
                             <div>
                                <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                            </div> 
                        </div>
                        @if (!IsSharedView)
                        {
                            <div>
                                <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="async () => await NavigateToEdit()" />
                            </div>
                        }
                    </div>
                </li>
            </ul>
             @if (!IsSharedView)
             {
            <div onclick="toggleClass()" class="sharetext-arrow">
                <div class="sharewith-row" id="sharewith-expnd-collps">
                    <span class="url-text">@Texts.PromptSharedWith</span>
                    <img id="rotateImg" class="share-box share-image" src="/images/Vector.svg" alt="">
                </div>
            </div>
            <div id="container" class="container">
                <form id="temp-add-share-user">
                    <div class="sharewith-box" style="padding: 20px; ">
                        <div style="margin:auto; justify-content:flex-start; flex-wrap:wrap; justify-content:space-around; width:100% " class="row">
                            <div class="small-8 columns">
                                <input type="text" id="new-member-email" name="memberEmail" placeholder="someone@email.example" @onclick="showSyncPopup" @bind="@shareSecretViewModel.SecretSharingUserEmail" style="width: 100%; height: 40px; border-radius:5px ">
                            </div>
                            <div class="small-2">
                                <select style="height: 35px; border-radius:5px" id="shareVisibilityOptions" name="Visibility" title="Visibility" @bind="shareSecretViewModel.VisibilityType">
                                    @foreach (SecretShareVisibility visibility in Enum.GetValues(typeof(SecretShareVisibility)))
                                {
                                    <option value="@visibility">@visibility</option>
                                }
                                </select>
                            </div>
                           <div class="small-2 columns">
                            <input style=" margin-top:4%; width: 90px; margin-left: 20px;" id="Add-Share-Users" type="button" class="button active btn-small " @onclick= "shareSecretViewModel.AddUserToSharedListAsync" value="Add" />
                        </div>
                        </div>
                        <div class="">
                            <h3 class="select-files font-bold">Added users with access (<span id="userCount">1</span>)</h3>
                             @if (secretService.CurrentSecret.SharedWith.Any())
                            {
                                <div class="row">
                                    <div class="file-box-desktop scroll-container" id="sharedUserList" style="margin-bottom:0px; margin-right:5px;">
                                       @foreach (SecretSharedUserViewModel user in secretService.CurrentSecret.SharedWith)
                                        {
                                        <dl>
                                        <dd class="list-bgrnd">
                                            @if (isAxCryptUser)
                                            {
                                                <img class="axcrypt-icons" style="float:left; margin-top:5px;" src="/images/default/AxCrypt_Icon.svg" alt="img">
                                            }
                                            else
                                            {
                                                <img class="contact-icon" style="float:left;" src="" alt="img">
                                            }
                                            <div style="display:inline-block; ">
                                                <span class="shared-text">@user.UserEmail</span><br />
                                                <span style="padding-left:8px; display: block;" class="share-visibility">@user.Visibility</span>
                                            </div>
                                            <img class="menu-image" src="/images/Group160.svg" alt="img" @onclick="() => shareSecretViewModel.UpdatedSelectedUser(user)">
                                            <hr style="width:100%;">
                                        </dd>
                                    </dl>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="file-box-desktop file-box-empty scroll-container" id="sharedUserList" style="margin-right:0px; margin-right:5px;"></div>
                            }
                            @if (shareSecretViewModel.CanContextMenuOpened)
                        {
                            <div class="hide-model-popup context-menu">
                                <dl>
                                    <dd>
                                        <img class="unshare-icon" src="/images/IcoUnShare.svg" alt="" />
                                        <span @onclick="shareSecretViewModel.RemoveSelectedSharedUser">@Texts.UnSharePromptText</span>
                                    </dd>
                                </dl>
                            </div>
                        }
                        </div>
                    </div>
                    <div style="margin-left: 0px !important;">
                    <input type="submit" class="button success btn-extra-small" @onclick="ApplyShare" value="Apply" disabled="@(!shareSecretViewModel.EnableApplyButton)" />
                </div>
                </form>
            </div>
            }
            }
        </div>
    </form>
</div>
@code {
    private SubscriptionLevel SubscriptionLevel { get; set; }
    public SecretCardViewModel NoteModel { get; set; }
    private SecretViewModel CurrentSecret { get; set; }
    bool IsSharedView { get; set; }

    bool isAxCryptUser = true;

    private async Task OnAfterRenderAsync()
    {
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        try
        {
            await jsRuntime.InvokeVoidAsync("toggleClass");
        }
        catch (Exception ex)
        {
            throw new Exception(ex.Message);
        }
    }

    private async Task DeleteSecret()
    {
        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
          {
              viewSecretViewModel.Loading = p.IsLoading;
              InvokeAsync(StateHasChanged);
          });
        SecretViewModel secret = secretService.CurrentSecret;
        bool isConfirmed = await Application.Current.MainPage.DisplayAlert("Alert!", "Are You sure want to delete this secret.", Texts.ButtonOkText, Texts.ButtonCancelText);
        if (!isConfirmed)
        {
            return;
        }
        bool deleted =await viewSecretViewModel.DeleteSecretAsync(progress);
        if (deleted)
        {
            alertNotification.ShowNotification("Your secret has been deleted!.", NotificationType.Success);
        }
        else
        {
            alertNotification.ShowNotification(viewSecretViewModel.ErrorMessage, NotificationType.Warning);
        }
        navigationManager.NavigateTo("/passwordManager", true);
    }

    private async Task HandleOnChange(ChangeEventArgs args)
    {
        NoteModel.SecretDesc = args.Value.ToString();
    }

    string UserEmail = "yosufkani@axcrypt.net";

    protected override void OnInitialized()
    {
        SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        CurrentSecret = secretService.GetCurrentSecret();
        if (CurrentSecret == null)
        {
            navigationManager.NavigateTo("/error");
        }
        IsSharedView = CurrentSecret.SharedWith != null && CurrentSecret.OwnerEmail != UserEmail;
    }
    private async Task NavigateToEdit()
    {
        SecretViewModel secret = secretService.CurrentSecret;
        if (secret != null)
        {
            string url = secret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Note => $"/editnote"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigationManager.NavigateTo(url);
            }
        }
    }
    private async Task ApplyShare()
    {
        await shareSecretViewModel.ApplyShareSecret();
        navigationManager.NavigateTo("/passwordManager");
    }
    //sync popup
    bool isFirstClick = true;
    bool SyncPopup { get; set; }
    void openSyncPopup()
    {
        SyncPopup = true;
    }
    void closeSyncPopup()
    {
        SyncPopup = false;
    }
    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}