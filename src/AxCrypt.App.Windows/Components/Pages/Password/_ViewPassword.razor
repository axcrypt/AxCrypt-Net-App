@page "/viewpassword"

@using AxCrypt.App.Components.Helpers
@using AxCrypt.App.Components.Services.Interface
@using AxCrypt.Content
@using AxCrypt.Core.Crypto.Asymmetric
@using AxCrypt.Core.Secrets
@using AxCrypt.Core.UI
@using AxCrypt.Core.UI.ViewModel
@using AxCrypt.Cryptor.Model
@using AxCrypt.App.Components.Models
@using AxCrypt.App.Components.Models.Secret
@using AxCrypt.Api.Model
@using AxCrypt.App.Components.Services
@using Microsoft.JSInterop
@using static AxCrypt.Abstractions.TypeResolve;

@inject IStatusAlertService StatusAlertService
@inject NavigationManager navigation
@inject SecretService secretService
@inject ShareSecretViewModel shareSecretViewModel
@inject ViewSecretViewModel viewSecretViewModel
@inject IJSRuntime js

<link href="css/@viewSecretViewModel.SubscriptionLevel.ToString().ToLower()/secretlist.min.css" rel="stylesheet" />
<link href="css/@viewSecretViewModel.SubscriptionLevel.ToString().ToLower()/newsecret.min.css" rel="stylesheet" />
<link href="css/@viewSecretViewModel.SubscriptionLevel.ToString().ToLower()/sharesecret.min.css" rel="stylesheet" />

<div style="margin-top: 80px;" class="page-max-height">
    <div class="page-heading">
        <h3 style="background-position:center;" class="password-creation">
            View Password
        </h3>
    </div>
    <AxCrypt.App.Windows.Components.Pages.Shared.LoadingComponent IsLoading="@viewSecretViewModel.Loading" />
    <div class="row">
        @if (!viewSecretViewModel.Loading)
        {
            <ul class="clean-up" style=" list-style:none">
                <li>
                    <label for="Password_Url">@Texts.PasswordUrlPrompt</label><br />
                    <input id="pwd-url-inp" type="text" style="color:#494949 !important; background-color:#E2E2E2" @bind="@secretService.CurrentSecret.Password.Url" readonly="readonly">
                </li>
                <li>
                    <label for="Password_SecretDesc">@Texts.DescriptionLabel</label><br />
                    <textarea id="pwd-desc-inp" style="color:#494949 !important; background-color:#E2E2E2" maxlength="100000" @bind="@secretService.CurrentSecret.Password.SecretDesc" @bind:event="HandleOnChange" readonly="readonly"></textarea>
                </li>
                <li class="list-row">
                    <div class="list-width">
                        <label for="Password_Username">@Texts.UserNamePrompt</label><br />
                        <input id="pwd-username-inp" style="color:#494949 !important; background-color:#E2E2E2" maxlength="100000" type="text" @bind="@secretService.CurrentSecret.Password.Username" readonly="readonly">
                    </div>
                    <div class="list-width">
                        <label for="password_secretvalue">@Texts.PassphrasePrompt</label><br />
                        <div style="display:flex; position: relative;">
                            <div id="cp-sec-pwd-clipbrd" title="@Texts.SecretsCopytoClipboard" class=""></div>
                            <input id="passwordInput" style="color:#494949 !important; background-color:#E2E2E2" maxlength="1000" type="text" value="@viewSecretViewModel.GetValue(isPasswordVisible,secretService.CurrentSecret.Password.SecretValue)" readonly="readonly" @onclick="() => ToggleVisibility(ref isPasswordVisible)">
                            <div id="cp-sec-pwd-clipbrd" style="position: absolute; right: 10px; cursor: pointer;" class="copy-to-clipbrd" @onclick="CopyToClipboard">
                                <img class="clipbrd" src="" alt="copy-clp-brd">
                            </div>
                        </div>
                    </div>
                </li>
                <li>
                    <div style="display:flex; justify-content:space-around; width:100%;">
                        <div style="display:flex; justify-content:flex-start; gap:20px; width:100%;">
                            <div>
                                <NavLink href="passwordManager">
                                    <input type="submit" class="button cancel btn-extra-small" value="Back" />
                                </NavLink>
                            </div>
                            <div>
                                <input id="secret-delete" type="button" class="button btn-extra-small alert" value="@Texts.ButtonDeleteText" @onclick="async () => await DeleteSecret()" />
                            </div>
                        </div>
                        @if (!IsSharedView)
                        {
                            <div>
                                <input id="secret-edit" type="button" class="button success btn-extra-small" value="Edit" @onclick="NavigateToEdit" />
                            </div>
                        }
                    </div>
                </li>
            </ul>
            @if (!IsSharedView)
            {
                <div onclick="toggleClass()" class="sharetext-arrow">
                    <div class="sharewith-row" id="sharewith-expnd-collps">
                        <span class="url-text">@Texts.PromptSharedWith</span>
                        <img id="rotateImg" class="share-box share-image" src="/images/Vector.svg" alt="">
                    </div>
                </div>
                <div id="container" class="container">
                    <form id="temp-add-share-user">
                        <div class="sharewith-box" style="padding: 20px; ">
                            <div style="margin:auto; justify-content:flex-start; flex-wrap:wrap; justify-content:space-around; width:100% " class="row">
                                <div class="small-8 columns">
                                    <input type="text" id="new-member-email" name="memberEmail" placeholder="someone@email.example" @onclick="showSyncPopup" @bind="@shareSecretViewModel.SecretSharingUserEmail" style="width: 100%; height: 40px; border-radius:5px ">
                                </div>
                                <div class="small-2">
                                    <select style="height: 35px; border-radius:5px" id="shareVisibilityOptions" name="Visibility" title="Visibility" @bind="shareSecretViewModel.VisibilityType">
                                        @foreach (SecretShareVisibility visibility in Enum.GetValues(typeof(SecretShareVisibility)))
                                        {
                                            <option value="@visibility">@visibility</option>
                                        }
                                    </select>
                                </div>
                                <div class="small-2 columns">
                                    <input style=" margin-top:4%; width: 90px; margin-left: 20px;" id="Add-Share-Users" type="button" class="button active btn-small " @onclick="shareSecretViewModel.AddUserToSharedListAsync" value="Add" />
                                </div>
                            </div>
                            <div class="">
                                <h3 class="select-files font-bold">Added users with access (<span id="userCount">@secretService.CurrentSecret.SharedWith?.Count()</span>)</h3>
                                @if (secretService.CurrentSecret.SharedWith.Any())
                                {
                                    <div class="file-box-desktop scroll-container" id="sharedUserList" style="margin-bottom:0px; margin-right:5px;">
                                        @foreach (SecretSharedUserViewModel user in secretService.CurrentSecret.SharedWith)
                                        {
                                            <dl>
                                                <dd class="list-bgrnd">
                                                    @if (isAxCryptUser)
                                                    {
                                                        <img class="axcrypt-icons" style="float:left; margin-top:5px;" src="/images/default/AxCrypt_Icon.svg" alt="img">
                                                    }
                                                    else
                                                    {
                                                        <img class="contact-icon" style="float:left;" src="" alt="img">
                                                    }
                                                    <div style="display:inline-block; ">
                                                        <span class="shared-text">@user.UserEmail</span><br />
                                                        <span style="padding-left:8px; display: block;" class="share-visibility">@user.Visibility</span>
                                                    </div>
                                                    <img class="menu-image" src="/images/Group160.svg" alt="img" @onclick="() => shareSecretViewModel.UpdatedSelectedUser(user)">
                                                    <hr style="width:100%;">
                                                </dd>
                                            </dl>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="file-box-desktop file-box-empty scroll-container" id="sharedUserList" style="margin-right:0px; margin-right:5px;"></div>
                                }
                                @if (shareSecretViewModel.CanContextMenuOpened)
                                {
                                    <div class="hide-model-popup context-menu">
                                        <dl>
                                            <dd>
                                                <img class="unshare-icon" src="/images/IcoUnShare.svg" alt="" />
                                                <span @onclick="shareSecretViewModel.RemoveSelectedSharedUser">@Texts.UnSharePromptText</span>
                                            </dd>
                                        </dl>
                                    </div>
                                }
                            </div>
                        </div>
                        <div style="margin-left: 0px !important;">
                            <input type="submit" class="button success btn-extra-small" @onclick="ApplyShare" value="Apply" />
                        </div>
                    </form>
                </div>
            }
        }
    </div>
</div>
@code {
    public SecretPasswordViewModel PasswordModel { get; set; } = SecretPasswordViewModel.Empty;
    private SecretViewModel? CurrentSecret { get; set; }
    bool IsSharedView { get; set; }
    bool isPasswordVisible = false;
    bool isAxCryptUser = true;

    protected override void OnInitialized()
    {
        viewSecretViewModel.SubscriptionLevel = New<AccountStatusViewModel>().SubscriptionLevel;
        viewSecretViewModel.UserEmail = New<AccountStatusViewModel>().UserEmail;
        CurrentSecret = secretService.GetCurrentSecret();
        if (CurrentSecret == null)
        {
            navigation.NavigateTo("/error");
        }

        IsSharedView = CurrentSecret?.SharedWith != null && CurrentSecret.OwnerEmail != viewSecretViewModel.UserEmail;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("toggleClass");

            await js.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "passwordInput");
        }
    }

    private async Task DeleteSecret()
    {
        Progress<LoadingModel> progress = new Progress<LoadingModel>(p =>
        {
            viewSecretViewModel.Loading = p.IsLoading;
            InvokeAsync(StateHasChanged);
        });

        SecretViewModel secret = secretService.CurrentSecret;
        bool isConfirmed = await Application.Current.MainPage.DisplayAlert("Alert!", "Are You sure want to delete this secret.", Texts.ButtonOkText, Texts.ButtonCancelText);
        if (!isConfirmed)
        {
            return;
        }

        bool deleted = await viewSecretViewModel.DeleteSecretAsync(progress);
        if (deleted)
        {
            StatusAlertService.Success("Your secret has been deleted!.");
        }
        else
        {
            StatusAlertService.Error(viewSecretViewModel.ErrorMessage);
        }

        navigation.NavigateTo("/passwordManager", true);
    }

    private void HandleOnChange(ChangeEventArgs args)
    {
        PasswordModel.SecretDesc = args?.Value?.ToString();
    }

    private void NavigateToEdit()
    {
        SecretViewModel secret = secretService.CurrentSecret;
        if (secret != null)
        {
            string url = secret.SecretType switch
            {
                AxCrypt.Api.Model.Secret.SecretType.Password => $"/editpassword"
            };
            if (!string.IsNullOrEmpty(url))
            {
                navigation.NavigateTo(url);
            }
        }
    }

    private async Task CopyToClipboard()
    {
        string password = secretService.CurrentSecret.Password.SecretValue;
        await js.InvokeVoidAsync("copyToClipboard", password);
    }

    private async Task ApplyShare()
    {
        await shareSecretViewModel.ApplyShareSecret();
        navigation.NavigateTo("/passwordManager");
    }

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         await js.InvokeVoidAsync("addClickListenerOutside", DotNetObjectReference.Create(this), "passwordInput");
    //     }
    // }

    [JSInvokable]
    public void HideField(string fieldId)
    {
        if (fieldId == "passwordInput" && isPasswordVisible)
        {
            isPasswordVisible = false;
        }
        StateHasChanged();
    }

    private void ToggleVisibility(ref bool isVisible)
    {
        isVisible = !isVisible;
        StateHasChanged();
    }

    bool isFirstClick = true;
    bool SyncPopup { get; set; }

    void openSyncPopup()
    {
        SyncPopup = true;
    }

    void closeSyncPopup()
    {
        SyncPopup = false;
    }

    void showSyncPopup()
    {
        if (isFirstClick)
        {
            openSyncPopup();
            isFirstClick = false;
        }
    }
}