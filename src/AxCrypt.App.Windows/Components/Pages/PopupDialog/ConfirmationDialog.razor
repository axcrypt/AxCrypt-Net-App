@using AxCrypt.App.Components.Models

@inject LogOnViewModel LogOnModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog" style="display: block;">
        <div>
            <div class="close-img" onclick="closeModalDialog('modal-dialog6')"></div>
            <div>
                <div class="modal-header text-center">
                    <span>Changing options may be dangerous. Only do this if you are sure you understand what this option does.</span>
                </div>
                <div class="modal-body">
                    <div>
                        <label>Verify password:</label>
                        <input type="password" class="form-control pswd-img" placeholder="Type your password one more time" />
                    </div>
                    <div>
                        <input type="checkbox" />
                        <span class="grey-clr font-medium">Show password</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button success btn-small">Ok</button>
                <button class="button cancel btn-small" onclick="closeModalDialog('modal-dialog6')">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        //LogOnModel.ConformDialog.OnDialogVisibilityChanged += UpdateConformDialogState;
    }

    private void UpdateConformDialogState(bool canShowConformDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowConformDialog;
            StateHasChanged(); // Refresh UI
        });
    }

    private void ClosePopup()
    {
        //LogOnModel.ConformDialog.Close();
    }
}