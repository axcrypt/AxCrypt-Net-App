@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@inject LogOnViewModel logOnModel
@inject CreateNewAccountDialogViewModel accountViewModel

@if (IsVisible)
{
    <div class="modal">
        <div class="modal-content">
            <h3>@Texts.TitleCreateAxCryptIdTitle</h3>

            <div>
                <label>@Texts.PromptEmailText</label>
                <input type="email" @bind="accountViewModel.UserEmail" @oninput="accountViewModel.ClearErrorProviders" />
            </div>

            <div>
                <label>@Texts.PassphrasePrompt</label>
                <input type="password" @bind="accountViewModel.PassphraseText" @oninput="accountViewModel.ClearErrorProviders" />
                <PasswordStrengthMeter Password="accountViewModel.PassphraseText" />
                <input type="checkbox" @onchange="(e)=>ToggleShowPassword(e)" />
            </div>

            <div>
                <label>@Texts.VerifyPasswordPrompt</label>
                <input type="password" @bind="accountViewModel.VerifyPassPhraseText" @oninput="accountViewModel.ClearErrorProviders" />
            </div>

            <div>
                <button style="background-color:limegreen" @onclick="accountViewModel.ButtonOk_Click" disabled="@accountViewModel.IsCreating">@Texts.ButtonOkText</button>
                <button @onclick="Cancel">@Texts.ButtonCancelText</button>
                <button style="background-color:limegreen; border-color:black" @onclick="accountViewModel.HelpButton_Click">@Texts.HelpToolStripMenuItemText</button>
            </div>

            @if (!string.IsNullOrEmpty(accountViewModel.ErrorMessage))
            {
                <div class="error">@accountViewModel.ErrorMessage</div>
            }
        </div>
    </div>
}

<style>
    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
        display: none;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 10px;
    }

    .error {
        color: red;
    }
</style>

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        logOnModel.CreateNewAccountDialog.OnDialogVisibilityChanged += UpdateCreateNewAccountState;
        base.OnInitialized();
    }

    void ToggleShowPassword(ChangeEventArgs e)
    {
        accountViewModel.ShowPassword = (bool)e.Value;
    }

    void UpdateCreateNewAccountState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void Cancel()
    {
        logOnModel.CreateNewAccountDialog.Close();
    }
}