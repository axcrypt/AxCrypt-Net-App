@using AxCrypt.Content
<div class="modal" style="display:@(IsOpen ? "block" : "none")">
    <div class="modal-content">
        <h3>@Texts.TitleCreateAxCryptIdTitle</h3>

        <div>
            <label>@Texts.PromptEmailText</label>
            <input type="email" @bind="UserEmail" @oninput="ClearErrorProviders" />
        </div>

        <div>
            <label>@Texts.PassphrasePrompt</label>
            <input type="password" @bind="PasswordText" @oninput="ClearErrorProviders" />
            <PasswordStrengthMeter Password="PasswordText" />
            <input type="checkbox" @onchange="ToggleShowPassword" />
        </div>

        <div>
            <label>@Texts.VerifyPasswordPrompt</label>
            <input type="password" @bind="Verification" @oninput="ClearErrorProviders" />
        </div>

        <div>
            <button style="background-color:limegreen" @onclick="OnOkClick" disabled="@IsCreating">@Texts.ButtonOkText</button>
            <button @onclick="Cancel">@Texts.ButtonCancelText</button>
            <button style="background-color:limegreen; border-color:black" @onclick="Help">@Texts.HelpToolStripMenuItemText</button>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error">@ErrorMessage</div>
        }
    </div>
</div>

<style>
    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
        display: none;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 10px;
    }

    .error {
        color: red;
    }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    private string PasswordText { get; set; }
    private string Verification { get; set; }
    private string UserEmail { get; set; }
    private bool ShowPassword { get; set; }
    private string ErrorMessage { get; set; }
    private bool IsCreating { get; set; }

    private void ClearErrorProviders()
    {
        ErrorMessage = string.Empty;
    }

    private void ToggleShowPassword(ChangeEventArgs e)
    {
        ShowPassword = (bool)e.Value;
    }

    private async Task OnOkClick()
    {
        if (IsCreating || !ValidateInputs())
        {
            return;
        }

        IsCreating = true;

        if (/* Account creation successful */ true)
        {
            await OnClose.InvokeAsync(false);
        }
        else
        {
            ErrorMessage = Texts.FailedPrivateImport;
            IsCreating = false;
        }
    }

    private bool ValidateInputs()
    {
        bool isValid = true;

        if (string.IsNullOrEmpty(PasswordText))
        {
            ErrorMessage = Texts.PasswordPolicyViolation;
            isValid = false;
        }

        if (string.IsNullOrEmpty(Verification) || PasswordText != Verification)
        {
            ErrorMessage = Texts.PassphraseVerificationMismatch;
            isValid = false;
        }

        if (string.IsNullOrEmpty(UserEmail))
        {
            ErrorMessage = Texts.BadEmail;
            isValid = false;
        }

        return isValid;
    }

    private async Task Cancel()
    {
        await OnClose.InvokeAsync(false);
    }

    private void Help()
    {
        
    }
}