@using AxCrypt.App.Shared.Models
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@inject FilePasswordDialogViewModel filePassword

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog">
        <div style="text-align: left;">
            <div class="modal-header text-center" style="display:block; font-weight:600;">
                <span>@Texts.DialogFilePasswordTitle</span>
            </div>
            <div class="modal-body">
                <div style="padding-bottom: 15px;">
                    <label for="password">@Texts.PromptFileText :</label><br />
                    <span class="grey-clr">@filePassword.ViewModel.FileName</span>
                </div>
                <div>
                    <label>@Texts.PassphrasePrompt :</label>
                    <input type="@(filePassword.ViewModel.ShowPassword ? "text" : "password")" class="form-control pswd-img" @bind-value="@filePassword.ViewModel.PasswordText" placeholder="Enter your file password here" />
                </div>
                @*                 <div>
            <label>@Texts.MoreButtonText</label>
            @if (!filePassword.IsShowMoreVisible)
            {
            <input type="file" class="form-control pswd-img" @bind-value="@filePassword.ViewModel.KeyFileName" placeholder="Select your key file here" />
            }
            </div> *@
                <div>
                    <input type="checkbox" @bind="@filePassword.ViewModel.ShowPassword" />
                    <span class="grey-clr font-medium" @onchange="@ToggleShowPassword">@Texts.ShowPasswordOptionPrompt</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button font-medium success btn-small" @onclick="filePassword.OkButton_Click">@Texts.ButtonOkText</button>
                <button class="btn-small font-medium button cancel" @onclick="Cancel">@Texts.ButtonCancelText</button>
            </div>
            @if (!string.IsNullOrEmpty(filePassword.ErrorMessage))
            {
                <div class="error-message">@filePassword.ErrorMessage</div>
            }
        </div>
    </div>
}

@code {

    private bool IsVisible { get; set; }

    protected override void OnInitialized()
    {
        filePassword.FilePasswordDialog.OnDialogVisibilityChanged += UpdateFilePasswordState;
        base.OnInitialized();
    }

    void UpdateFilePasswordState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void ToggleShowPassword(ChangeEventArgs e)
    {
        filePassword.ViewModel!.ShowPassword = (bool)e.Value!;
    }

    void Cancel()
    {
        filePassword.FilePasswordDialog.Close();
    }

}