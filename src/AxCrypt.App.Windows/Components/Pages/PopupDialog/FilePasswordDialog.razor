@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels

@inject LogOnViewModel logOnViewModel
@inject FilePasswordDialogViewModel filePasswordViewModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog">
        <div style="text-align: left;">
            <label for="password">File Name:</label>
            <label>@filePasswordViewModel.FileName</label><br />
            <label for="password">
                Enter Password: <input id="password" type="@passwordInputType" @bind="filePasswordViewModel.PassPhrase" @oninput="filePasswordViewModel.ClearErrorProviders" />
            </label> <br />

            <div class="button-group center-column" style="margin-top: 10px;">
                <label for="showPassword">
                    <input id="showPassword" type="checkbox" checked="@filePasswordViewModel.ShowPassPhrase" @onchange="(e)=>ToggleShowPassword(e)" /> Show Password
                </label>
                <button class="button font-medium success btn-large" @onclick="filePasswordViewModel.OkButton_Click">OK</button>
                <button class="btn-large font-medium button cancel" @onclick="Cancel">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(filePasswordViewModel.ErrorMessage))
            {
                <div class="error-message">@filePasswordViewModel.ErrorMessage</div>
            }
        </div>
    </div>
}

@code {
    private bool IsVisible;
    private string passwordInputType;

    protected override void OnInitialized()
    {
        logOnViewModel.FilePasswordDialog.OnDialogVisibilityChanged += UpdateFilePasswordState;
        base.OnInitialized();
    }

    void UpdateFilePasswordState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void ToggleShowPassword(ChangeEventArgs e)
    {
        filePasswordViewModel.ShowPassPhrase = (bool)e.Value;
    }

    void Cancel()
    {
        logOnViewModel.FilePasswordDialog.Close();
    }
}