@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels

@inject LogOnViewModel logOnViewModel
@inject FilePasswordDialogViewModel filePasswordViewModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog">
        <div>
            <div class="close-img" @onclick="Cancel"></div>
            <div class="modal-header text-center">

                <label for="password">File Name:</label>
                <label>@filePasswordViewModel.ViewModel.FileName</label>

                <label for="password">Enter Password:</label>
                <input id="password" type="@passwordInputType" @bind="filePasswordViewModel.PassPhrase" @oninput="filePasswordViewModel.ClearErrorProviders" />

                <input id="showPassword" type="checkbox" checked="@filePasswordViewModel.ShowPassPhrase" @onchange="(e)=>ToggleShowPassword(e)" />
                <label for="showPassword">Show Password</label>

                @if (!string.IsNullOrEmpty(filePasswordViewModel.ErrorMessage))
                {
                    <div class="error-message">@filePasswordViewModel.ErrorMessage</div>
                }

                <div class="button-group">
                    <button @onclick="filePasswordViewModel.OkButton_Click">OK</button>
                    <button @onclick="Cancel">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;
    private string passwordInputType;

    protected override void OnInitialized()
    {
        logOnViewModel.FilePasswordDialog.OnDialogVisibilityChanged += UpdateFilePasswordState;
        base.OnInitialized();
    }

    void UpdateFilePasswordState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    void ToggleShowPassword(ChangeEventArgs e)
    {
        filePasswordViewModel.ShowPassPhrase = (bool)e.Value;
    }

    void Cancel()
    {
        logOnViewModel.FilePasswordDialog.Close();
    }
}