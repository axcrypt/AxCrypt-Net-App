@using AxCrypt.Content
@using Microsoft.AspNetCore.Components

@inject NavigationManager Navigation

<div class="modal" style="display:@(IsOpen ? "block" : "none")">
    <div class="modal-content">
        <h3>@Texts.DialogImportPrivateAxCryptIdTitle</h3>

        <div>
            <label>@Texts.DialogImportPrivateAxCryptIdAccessIdPrompt</label>
            <input type="text" @bind="PrivateKeyFileName" @oninput="ClearErrorProviders" />
            <button @onclick="BrowsePrivateKeyFile">@Texts.ButtonEllipsisText</button>
        </div>

        <div>
            <label>@Texts.PassphrasePrompt</label>
            <input type="password" @bind="PasswordText" @oninput="ClearErrorProviders" />
        </div>

        <div>
            <button style="background-color:limegreen" @onclick="OnOkClick">@Texts.ButtonOkText</button>
            <button @onclick="Cancel">@Texts.ButtonCancelText</button>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error">@ErrorMessage</div>
        }
    </div>
</div>

<style>
    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
        display: none;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 10px;
    }

    .error {
        color: red;
    }
</style>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    private string? PrivateKeyFileName { get; set; }
    private string? PasswordText { get; set; }
    private bool ShowPassword { get; set; }
    private string? ErrorMessage { get; set; }

    private void ClearErrorProviders()
    {
        ErrorMessage = string.Empty;
    }

    private void ToggleShowPassword(ChangeEventArgs e)
    {
        ShowPassword = (bool)e.Value;
    }

    private async Task BrowsePrivateKeyFile()
    {
        FileResult fileResult = await FilePicker.Default.PickAsync();
        if (fileResult != null)
        {
            PrivateKeyFileName = fileResult.FullPath;
        }
    }

    private async void OnOkClick()
    {
        if (!ValidateInputs())
        {
            return;
        }

        if (true)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            ErrorMessage = Texts.FailedPrivateImport;
        }
    }

    private bool ValidateInputs()
    {
        bool isValid = true;

        if (string.IsNullOrEmpty(PasswordText))
        {
            ErrorMessage = Texts.WrongPassphrase;
            isValid = false;
        }

        if (string.IsNullOrEmpty(PrivateKeyFileName))
        {
            ErrorMessage = Texts.FileNotFound;
            isValid = false;
        }

        return isValid;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/mainpage");
    }
}
