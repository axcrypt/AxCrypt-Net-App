@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content
@using Microsoft.AspNetCore.Components

@inject NavigationManager Navigation
@inject ImportPrivateKeyViewModel viewModel
@inject LogOnViewModel logOnViewModel

@if (IsVisible)
{
    <div class="modal">
        <div class="modal-content">
            <h3>@Texts.DialogImportPrivateAxCryptIdTitle</h3>

            <div>
                <label>@Texts.DialogImportPrivateAxCryptIdAccessIdPrompt</label>
                <input type="text" @bind="viewModel.PrivateKeyFileName" @oninput="viewModel.ClearErrorProviders" />
                <button @onclick="viewModel.BrowsePrivateKeyFile">@Texts.ButtonEllipsisText</button>
            </div>

            <div>
                <label>@Texts.PassphrasePrompt</label>
                <input type="password" @bind="viewModel.PasswordText" @oninput="viewModel.ClearErrorProviders" />
            </div>

            <div>
                <button style="background-color:limegreen" @onclick="(e)=>viewModel.ButtonOk_Click(e)">@Texts.ButtonOkText</button>
                <button @onclick="Cancel">@Texts.ButtonCancelText</button>
            </div>

            @if (!string.IsNullOrEmpty(viewModel.ErrorMessage))
            {
                <div class="error">@viewModel.ErrorMessage</div>
            }
        </div>
    </div>
}

<style>
    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
        display: none;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 10px;
    }

    .error {
        color: red;
    }
</style>

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        logOnViewModel.ImportPrivatePasswordDialog.OnDialogVisibilityChanged += UpdateImportPrivateKeyState;
    }

    private void ToggleShowPassword(ChangeEventArgs e)
    {
        viewModel.ShowPassPhrase = (bool)e.Value;
    }

    void UpdateImportPrivateKeyState(bool isVisible)
    {
        InvokeAsync(() =>
        {
            IsVisible = isVisible;
            StateHasChanged();
        });
    }

    private void Cancel()
    {
        logOnViewModel.ImportPrivatePasswordDialog.Close();
    }
}
