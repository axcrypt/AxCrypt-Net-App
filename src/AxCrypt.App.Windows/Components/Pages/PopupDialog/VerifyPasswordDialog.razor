@using AxCrypt.App.Components.Models
@using AxCrypt.App.Windows.ViewModels
@using AxCrypt.Content

@inject VerifyPasswordViewModel verifyViewModel

@if (IsVisible)
{
    <div id="modal-dialog6" class="modalDialog" style="display: block;">
        <div>
            <div class="close-img" @onclick="ClosePopup"></div>
            <div>
                <div class="modal-header text-center">
                    <span>@Texts.SignInVerificationTitle</span>
                </div>
                <div><span>@verifyViewModel.VerifyInstructionText</span></div>
                <div class="modal-body">
                    <div>
                        <label class="text-center">Do not forget this password!</label>
                    </div>
                    <div>
                        <label>@Texts.VerifyPasswordPrompt:</label>
                        <input type="password" class="form-control pswd-img" placeholder="Type your password one more time" @bind-value="@verifyViewModel.PassphraseText" />
                    </div>
                    <div>
                        <input type="checkbox" checked="@verifyViewModel.ShowPassphrase" @onchange="ToggleShowPassword" />
                        <span class="grey-clr font-medium">@Texts.ShowPasswordOptionPrompt</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="button success btn-small" @onclick="verifyViewModel.ButtonOk_Click">@Texts.ButtonOkText</button>
                <button class="button cancel btn-small" @onclick="ClosePopup">@Texts.ButtonCancelText</button>
            </div>
        </div>
    </div>
}

@code {
    private bool IsVisible;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        verifyViewModel.LogOnViewModel.VerifyPasswordDialog.OnDialogVisibilityChanged += UpdateConformDialogState;
    }

    private void UpdateConformDialogState(bool canShowConformDialog)
    {
        InvokeAsync(() =>
        {
            IsVisible = canShowConformDialog;
            StateHasChanged(); // Refresh UI
        });
    }

    void ToggleShowPassword(ChangeEventArgs e)
    {
        verifyViewModel.ShowPassphrase = (bool)e.Value;
    }

    private void ClosePopup()
    {
        verifyViewModel.DialogResult = AxCrypt.App.Components.Utility.DialogResult.Cancel;
        verifyViewModel.VerifyInstructionText = "";

        verifyViewModel.LogOnViewModel.VerifyPasswordDialog.Close();
    }
}