@using AxCrypt.App.Windows.Helpers

<PageTitle>Progress Bar</PageTitle>

@if (Utility.IsMainMenuHidden)
{
    <div class="progress-circle-sec">
        <span @onclick="StartProgress">Click</span>
        <div class="progress-wrapper">
            <svg class="progress-circle" width="64" height="64" viewBox="0 0 64 64">
                <circle class="progress-background" cx="32" cy="32" r="28" />
                <circle class="progress-value" cx="32" cy="32" r="28"
                        style="stroke-dasharray: 175.8; stroke-dashoffset:@(175.8 - (ProgressValue * 1.758))" />
            </svg>
            <div class="progress-text">@ProgressValue%</div>
        </div>
    </div>
}
else
{
    <div class="progres-sec">
        <div class="fist-rw">
            <div class="" @onclick="StartProgress"><span class="progres-fle-txt">Index.cshtml</span></div>
            <div>
                <span>@ProgressValue%</span>
            </div>
        </div>
        <div class="progress-container">
            <div class="progress-bubble-start" style="left:@ProgressValue%;"></div>
            <div class="progress-bar" style="width:@ProgressValue%"></div>
            <div class="progress-bubble-end"></div>
        </div>
    </div>
}

@code {
    private int ProgressValue = 0;

    private async Task StartProgress()
    {
        ProgressValue = 0;
        while (ProgressValue < 100)
        {
            await Task.Delay(100);
            ProgressValue += 5;
            StateHasChanged();
        }
    }
}