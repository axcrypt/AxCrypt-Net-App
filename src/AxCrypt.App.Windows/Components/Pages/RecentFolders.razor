    }
    </div>
    <div class="rcnt-fld-bx fld-ntfnd-cl grey-clr" @onmouseover="ShwNotfndPop" @onmouseout="HdeNotfndPop">
    <img class="" src="images/default/IcoFldrGry.svg" /><br /><label>Videos</label>
    @if (isNtFundHovered && currentDevice == DeviceIdiom.Desktop)
    {
    <div class="hover-popup text-center">
    <span style="color:white;">
    Path is not  <strong>found!</strong>
    </span><br />
    <img class="" src="images/default/Icolstcnnct.svg" />
    </div>
    }
    </div> *@
</div>

<div id="securedContextMenu" class="hide-model-popup home-context-menu" style="display: none;">
    <dl class="font-medium" style="margin-bottom: 5px;">
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.ShareKey)">Share Keys</dd>
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.DecryptPermanently)">Decrypt Permanently </dd>
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.DecryptTemporarily)">Decrypt Temporarily </dd>
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.RemoveFromListButKeepSecured)">Remove from list but keep secured</dd>
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.ShowInExplorer)">Open Explore Here</dd>
        <dd @onclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.AddSecuredFolder)">Add Secured Folder</dd>
    </dl>
</div>

@if (RecentFoldersViewModel.showPopup)
{
    <div class="modalDialog sharekey-popup" id="sharekey">
        <AxCrypt.App.Windows.Components.Pages.Shared.ShareKey SelectedFilesOrFoldersList=@RecentFoldersViewModel.SelectedShareKeyFolders IsFolder="true" OnClose="RecentFoldersViewModel.ClosePopup" />
    </div>
}

@if (RecentFoldersViewModel.showUpgradePopup)
{
    <div class="modalDialog" id="upgrade-popup">
        <AxCrypt.App.Windows.Components.Pages.Main.Upgrade />
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await RecentFoldersViewModel.InitializeAsync();
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RecentFoldersViewModel.InitializeAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}