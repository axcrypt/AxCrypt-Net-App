@inject RecentFoldersViewModel RecentFoldersViewModel

@{
    DeviceIdiom currentDevice = Utility.GetCurrentDeviceIdiom();
}

<link href="css/@RecentFoldersViewModel.SubscriptionLevel.ToString().ToLower()/index.css" rel="stylesheet" />
<link href="css/login.min.css" rel="stylesheet" />

<div @onclick="RecentFoldersViewModel.SortByDate">
    <label class="font-medium">Sort by: <span class="txt-clr">Date</span></label>
    <img class="arw-img" src="" alt="arrow-image" />
    <img class="date-drpdwn" src="" alt="arrow-image" />
</div>

<div class="rcnt-fld-sec hgt-ovflw">
    @if (currentDevice != DeviceIdiom.Phone && RecentFoldersViewModel.SubscriptionLevel != SubscriptionLevel.Free)
    {
        <div class="rcnt-fld-bx fld-dflt-cl add-fldr" @onclick="(ss) => RecentFoldersViewModel.AddSecuredFolder(ss)"><img class="add-fldr-img" src="" /><br /><label>Add or Drag Folder</label></div>
    }
    @if (!RecentFoldersViewModel.RecentFoldersList.Any())
    {
        <div class="text-center" style="padding-top: 20px;">
            <span class="empty-view-heading">Let`s start our journey!</span><br />
            <span>Add and secure your first folder.</span><br />
            <img class="empty-rcnt-fld-img" alt="default folder img" />
        </div>
    }
    else
    {
        @foreach (string folder in RecentFoldersViewModel.RecentFoldersList)
        {
            string folderWithoutTrailingSlash = folder.TrimEnd('\\');
            <div class="rcnt-fld-bx fld-dflt-cl" @onmousedown="(e) => RecentFoldersViewModel.HandleFileClick(e)"
                 @ondblclick="(arg) => RecentFoldersViewModel.OnContextMenuAction(arg, SecuredFolderContextMenu.ShowInExplorer)"
                 @oncontextmenu="e => RecentFoldersViewModel.SecuredContextMenu(e, folder)">
                <img class="fldr-img" src="" /><br /><label>@Path.GetFileName(folderWithoutTrailingSlash)</label>
            </div>
        }
    }
