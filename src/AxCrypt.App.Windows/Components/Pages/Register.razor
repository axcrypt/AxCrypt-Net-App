@page "/register"

@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models

@using static AxCrypt.Abstractions.TypeResolve;

@inject LogOnViewModel LogOnViewModel
@inject IJSRuntime JSRuntime

<link href="css/@LogOnViewModel.SubscriptionLevel.ToString().ToLower()/site.min.css" rel="stylesheet" />

@if (!IsLoading)
{
    @if (IsWideScreen)
    {
        <AxCrypt.App.Windows.Components.Pages.PopupDialog.RegisterPage />
    }
}
else
{
    <p>Loading...</p>
}

@code {
    bool IsWideScreen { get; set; }
    bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsWideScreen = await Utility.IsWideScreenAsync(JSRuntime);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error determining screen width: {ex.Message}");
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }
}

