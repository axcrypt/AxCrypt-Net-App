@using AxCrypt.Content

@if (IsLoading)
{
    <div class="secrets-loading-content">
        <div class="loading-content">
            <img src="" alt="Loading..." />
            <span>@Texts.ProgressIndicatorWaitMessage</span>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsLoading { get; set; } = false;
}
