@page "/SupportIndex"

@using AxCrypt.Api.Model
@using AxCrypt.App.Components.ViewModels
@using AxCrypt.App.Components.Data
@using AxCrypt.App.Components.Models
@using AxCrypt.Content

@inject SupportViewModel SupportViewModel
@inject LogOnViewModel LogOnModel

@inject IJSRuntime _jsRuntime
@inject NavigationManager _navigationManager

<div class="mb-sec">
    <NavLink class="mb-title flex-start" href="mainpagemobile" style="align-items: center;">
        <img class="back-btn" src="" alt="go-back-img" />
        <span class="goback-text">@Texts.PromptSupport</span>
    </NavLink>
</div>

@if (LogOnModel.SubscriptionLevel == SubscriptionLevel.Free)
{
    <div>
        <h2 class="page-title">@Texts.PromptSupport</h2>

        <div class="label-text free-sec" style="text-align:center;">
            <label>Sorry,</label>
            <p class="SupWarngText">@((MarkupString)(string.Format(Texts.FreeSupportInfo, Texts.LinkToFeedbackWebPage)))</p>
            <img class="support-image" src="" alt="support-img" />
        </div>
    </div>
}
else
{
    <div id="content-index" class="medium-12 columns support">
        <div class="">
            <h1 class="page-title">
                @LogOnModel.SupportPageTitle
            </h1>
            <p class="hide-txt">@SupportViewModel.Model.PageDescription</p>
        </div>
        <div>
            <div class="label-text">
                <label>@Texts.SupportBodyPrompt</label>
            </div>
            <div style="display:flex; padding:8px 0px;">
                <a style="text-decoration:none;" href="https://axcrypt.net/information/guides/get-started/">
                    <div class="link-box">
                        <img class="idea-img" src="" alt="idea-img" />
                        <div style="padding: 5px 0px; line-height: 16px;">
                            <span class="lable-txt">@Texts.SupportGetStartedVideoText</span><br />
                            <span class="link-txt">@SupportViewModel.Model.LinkLabel</span>
                            <img class="arrow-img" src="" alt="arrow-img" />
                        </div>
                    </div>
                </a>
                <a style="text-decoration:none;" href="https://axcrypt.net/information/faq/">
                    <div class="link-box" style="margin-left: 35px;">
                        <img class="faq-img" src="" alt="faq-img" />
                        <div style="padding: 5px 0px; line-height: 16px;">
                            <span class="lable-txt">Let`s check our</span><br />
                            <span class="link-txt">FAQ Page</span>
                            <img class="arrow-img" src="" alt="arrow-img" />
                        </div>
                    </div>
                </a>
            </div>
            <div style="padding-top:30px;">
                <span class="desc-txt">Or describe your problem here:</span>
            </div>
            <div>
                <textarea class="sup-text-blur" style="border-radius: 16px; min-height: 300px; width: 100%; padding:20px;" placeholder="@Texts.SupportBodyPlaceholderText" @bind="SupportViewModel.Model.Body" tabindex=1>
                    </textarea>
            </div>
            <div class="btn-sec">
                <input type="reset" class="button border btn-large font-medium btn-hide" value="@Texts.ButtonCancelText" />
                <input type="submit" class="button success btn-large font-medium" value="@Texts.ButtonSendText" @onclick="SubmitSupportAsync" />
            </div>
        </div>
    </div>
}

@code {
    private bool IsWideScreen { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    public async Task InitializeScreenPropertiesAsync()
    {
        IsLoading = true;
        try
        {
            IsWideScreen = await Utility.IsWideScreenAsync(_jsRuntime);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error determining screen width: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async void SubmitSupportAsync()
    {
        await SupportViewModel.SubmitSupportAsync();

        await InvokeAsync(() => StateHasChanged());
    }
}