@page "/tools"

<AxCrypt.App.Shared.Desktop.Components.Pages.ToolsComponent Tool="@Tool" />

@code {
    // Deep-link support: global search navigates to /tools?tool=<id> so the
    // Tools page can open a specific tool straight away. The query value is
    // forwarded to ToolsComponent, which activates the matching tool.
    [Parameter]
    [SupplyParameterFromQuery(Name = "tool")]
    public string? Tool { get; set; }
}
