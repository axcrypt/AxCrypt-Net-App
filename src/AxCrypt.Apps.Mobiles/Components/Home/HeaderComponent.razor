@using AxCrypt.Content;

<div class="home-index">
    <div class="hm-page-title head-sec">
        <h1 class="fle-nme">@Texts.WelcomeBackTitle</h1>
        <img class="home-title" src="" alt="hand-img" />
    </div>

    <div class="top-menu-section">
        <AxCrypt.App.Windows.Components.Pages.Main.TopMenu />
    </div>
</div>

@code {

    protected override OnInitialized()
    {
        ViewModel.LogOnViewModel.OnUIStateChanged += UpdatePageState;
    }

    private void UpdatePageState()
    {
        InvokeAsync(() =>
        {
            StateHasChanged(); // Refresh UI
        });
    }
}