<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <Target Name="CustomAfterBuildTarget" BeforeTargets="Build">
  </Target>
	
	<PropertyGroup>
		<_AxCryptMajor>3</_AxCryptMajor>
		<AxMinorVersion Condition=" '$(AxMinorVersion)' == '' ">1</AxMinorVersion>
		<AxBuildNumber Condition=" '$(AxBuildNumber)' == '' ">1</AxBuildNumber>
		<FinalAppVersion>$(_AxCryptMajor).$(AxMinorVersion).$(AxBuildNumber).0</FinalAppVersion>
		
		<_AxCanonicalAssemblyName>AxCrypt.App.Windows</_AxCanonicalAssemblyName>
		<_AxCanonicalName>AxCrypt</_AxCanonicalName>
		<_AppDefaultPlatform>x64</_AppDefaultPlatform>
		<_AxMergedBaseFileName>$(_AxCanonicalAssemblyName)_$(FinalAppVersion)_$(_AppDefaultPlatform)</_AxMergedBaseFileName>
		<AppOutputPath>$(AppxPackageDir)$(_AxCanonicalAssemblyName)_$(FinalAppVersion)_Test\</AppOutputPath>
		<PackageCertificateThumbprint>B3E2D8EB3B9AC1E60F5B2D581F9A2B1D1372701C</PackageCertificateThumbprint>
		<_AxTimeStampUrl>http://time.certum.pl</_AxTimeStampUrl>
	</PropertyGroup>

	<Target Name="_AxSetVersionedFileName">
		<PropertyGroup Condition=" '$(AxBuildNumber)' != '' ">
			<_AxVersionedDefaultFileName>$(AppOutputPath)$(_AxMergedBaseFileName).msix</_AxVersionedDefaultFileName>
			<!--<_AxVersionedFileName>$(_AxCanonicalAssemblyName)_$(FinalAppVersion)_$(_AppDefaultPlatform).msix</_AxVersionedFileName>-->
			<_AxVersionedFileName>$(_AxCanonicalName)-$(FinalAppVersion).msix</_AxVersionedFileName>
		</PropertyGroup>
	</Target>
	<Target Name="_AxCopyToVersionedFileName"
		Inputs="$(_AxVersionedDefaultFileName)"
		Outputs="$(AppOutputPath)$(_AxVersionedFileName)"
		Condition=" '$(_AxVersionedFileName)' != '' ">
		<Copy SourceFiles="$(_AxVersionedDefaultFileName)"
			  DestinationFiles="$(AppOutputPath)$(_AxVersionedFileName)"
			  SkipUnchangedFiles="true" />
		<ItemGroup>
			<FileWrites Include="$(AppOutputPath)$(_AxVersionedFileName)" />
		</ItemGroup>
	</Target>

	<Target Name="RestoreManifest">
		<Message Importance="high" Text="Updating Package.appxmanifest version to $(FinalAppVersion)" />

		<XmlPoke
			XmlInputPath="$(AppxManifestFile)"
			Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
			Value="$(FinalAppVersion)" />
	</Target>

	<Target Name="_AxSetRevisionAndCopyToVersionedFileName" AfterTargets="_GenerateAppxPackageFile"
			DependsOnTargets="_AxSetVersionedFileName;_AxCopyToVersionedFileName"
			Condition=" '$(Configuration)' == 'Release'">
	</Target>

	<!-- 🔐 Signing target -->
	<Target Name="SignMSIXAfterPublish" AfterTargets="_GenerateAppxPackageFile">
		<Exec Command='&quot;$(MSBuildThisFileDirectory)signtool.exe&quot; sign /sha1 $(PackageCertificateThumbprint) /fd sha256 /td sha256 /tr &quot;$(_AxTimeStampUrl)&quot; &quot;$(_AxVersionedDefaultFileName)&quot;'
				Condition=" '$(PackageCertificateThumbprint)' != '' "/>
		<Exec Command='&quot;$(MSBuildThisFileDirectory)signtool.exe&quot; sign /sha1 $(PackageCertificateThumbprint) /fd sha256 /td sha256 /tr &quot;$(_AxTimeStampUrl)&quot; &quot;$(AppOutputPath)$(_AxVersionedFileName)&quot;'
			  Condition=" '$(PackageCertificateThumbprint)' != '' "/>
	</Target>
</Project>
